        2
      ],
      "gemara_segment_ids": [
        2,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב הרא\"ש ז\"ל פרש\"י האי ושוין שלא",
      "segment_ids": [
