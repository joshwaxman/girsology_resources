      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יקטמנו אקיסם קאי וכן משמע דאבוס של",
      "segment_ids": [
