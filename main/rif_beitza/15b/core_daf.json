  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ריחיא או אגב דיקלא אבל במשחזת <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>לא דרש",
