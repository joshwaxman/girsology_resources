    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הן דאינו יכול לפוחתו ביו\"ט",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואסח דעתיה מינייהו דכיון דלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוי פחיתתו איסורא דאורייתא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדמוקמינן לה באוירא דלבני",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאו מוקצה הוא: <b>ר\"מ אומר אף</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>פוחת לכתחלה ונוטל.</b> דכיון",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמדרבנן בעלמא הוא דאסור לפי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו אלא סודר לבנים בלא טיט",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא מיתסר אלא משו' טלטול",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום שמחת יו\"ט התירו כך",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרש\"י ז\"ל והקשה עליו הרמב\"ן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל לת\"ק דלא שרי לפחות אמאי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא מיתסרי פירות משום מוקצה",
      "segment_ids": [
