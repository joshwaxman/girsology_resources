      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג דליכא אלא איסורא דרבנן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והא סוכה רעועה מוקצה מחמת",
      "segment_ids": [
