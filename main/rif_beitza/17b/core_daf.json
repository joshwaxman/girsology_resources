        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין מבקעין כלל א\"ר יהודה אמר שמואל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסורי מיחסרא והכי קתני אין מבקעין עצים",
