      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא סותר על מנת לבנות וכן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי (שבת מב:) במעות שעל הכר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[שם קמב:] ומטה שיש עליה מעות",
