  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "מחלון לחלון וב\"ה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מתירין בש\"א לא יטול",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא א\"כ נענע בו מבעוד יום ובה\"א עומד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואומר זה וזה אני נוטל: <b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף ט:)\" data-bavli-daf=\"9b\" data-bavli-index=\"0\"></span>תניא א\"ר",
      "segment_ids": [
