      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרקע ונידוש תחתיה ונעשה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקומו נמוך אבל אינו מזיז עפר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממקומו לעשות חריץ:",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סליקו להו פרק יום טוב <b>אין</b>",
      "segment_ids": [
