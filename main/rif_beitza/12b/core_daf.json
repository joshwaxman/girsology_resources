        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושין חבורה ושלש מחלוקות בדבר תנא קמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סבר לה כר' שמעון דאמר דבר שאין מתכוין",
