        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין מתכוין אסור וגזרי קרצוף אטו קירוד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבא אמר רב נחמן הלכה כר\"ש שהרי רבי",
