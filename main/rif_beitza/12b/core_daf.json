      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכל שכן קרצוף דלא עביד חבורה ור' יהודה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סבר דבר שאין מתכוין אסור <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>וקירוד דקא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עביד חבורה אסור וקרצוף דלא עביד חבורה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שרי ורבנן סברי לה כר' יהודה דאמר דבר",
