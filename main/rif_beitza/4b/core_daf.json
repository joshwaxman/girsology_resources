      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ביו\"ט בהמה חיה ועוף ונתערב דמן זה בזה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אסור לכסותן ביום טוב ואפי' שחט בעפר",
      "segment_ids": [
