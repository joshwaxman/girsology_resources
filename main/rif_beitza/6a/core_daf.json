    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלים שיש בהן צורך ליום קצת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכדכתיבנא מותר להוציאן וקרוב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה לחלק ולומר שכיון שרוב",
