      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולפיכך אמרו בירושל' גבי עור",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמלח הכא ומלח הכא עד דמלח",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כוליה לפי שההפסד בא לו מחמת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יו\"ט ולא מחמת פשיעתו: <b>מתני'</b>",
      "segment_ids": [
        3,
