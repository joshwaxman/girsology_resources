  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> ור\"י אוסר אפילו לטלטלו לצורך גופו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולצורך מקומו וכן כתב הטור בשם הרא\"ש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ופליג: <b>לשון ריא\"ז</b> אבל לאחר שקצב עליו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשר אסור לטלטלו אפילו לישב עליו לפי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא כלי ואדם קפיד עליו ומייחד לו מקום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואסור לטלטלו בין בשבת בין ביום טוב:",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לשון ריא\"ז ב</b> ואם רצה למלוח בשר עליהן",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באויר בתוך ידו בענין שאינו נוגע בהן יש",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתירין כיון שאין כאן הוכחה שעושה בשביל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החלבים שיש לתלות שבשביל הבשר הוא עושה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ויש אוסרים מדלא שרי אלא למלוח ע\"ג העור",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מכלל דע\"ג החלבים אסור בכל ענין משום",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבמליחה מועטת סגי להו ואפילו במליחה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לצלי הוי בהו כעבוד והכי מסתבר: <b>ג לשון</b>",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        3,
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> היו להן ציר באמצע אם היו של בעלי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
