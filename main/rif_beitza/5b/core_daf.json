      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לטייל לשמחת יו\"ט ואינו יכול להניח קטן",
      "segment_ids": [
