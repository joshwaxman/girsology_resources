      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אין מסלקין את התריסין ביו\"ט.</b>",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש בגמרא תריסי חנויות שהן",
      "segment_ids": [
