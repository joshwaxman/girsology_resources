      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בתחלת השבת אין בהם משום מוקצה שהדבר זה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גמרו בידי אדם הוא ואין בו משוה מוקצה:",
      "segment_ids": [
