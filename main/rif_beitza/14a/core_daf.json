      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וירדו עליהם גשמים ונתלחלחו ואח\"כ זרחה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עליהם החמה ונתייבשו ודוקא במידי דאכילה",
