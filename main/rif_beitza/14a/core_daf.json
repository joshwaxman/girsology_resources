      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב הרא\"ש גרסינן בגמרא בעי מיניה הלל",
      "segment_ids": [
