      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרותחות בין השמשות אף על פי [שהן]",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רותחין יותר מדאי ואינן ראויות לאכילה",
      "segment_ids": [
