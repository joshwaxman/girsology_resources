  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א לשון ריא\"ז</b> ואפילו כזית מבית שחיטתה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא אוכל בלא הפשט וניתוח שאין חוששין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בה לטרפה שרוב הבהמות כשרות הן ואם יש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו שהות להפשיט ולנתח אל יאכל בלי הפשט",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונתוח שנראה דרך רעבתנות ופעמים טרפה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והרי עלתה בידו שגגה ולא התירו בה אלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השחיטה שמא תמות ותפסד אבל להפשיטה לא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התירו אלא לצורך יו\"ט וכן ביאר מז\"ה: <b>ב</b>",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        3,
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לשון ריא\"ז</b> בכור שנולד ביום טוב ומומו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עמו אין רואין אותו ביום טוב ואם עבר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וראהו מותר לשוחטו ביום טוב שהרי בין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השמשות מוכן היה שהיה ראוי לשחוט את אמו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והוא מוכן במעי אמו וכן כל מוקצה שהיה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ראוי בתחלת השבת כגון גרוגרות וצמוקים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיבשו מערב יום טוב או מערב שבת ואתר כך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נפלו עליהם גשמים בשבת וביום טוב ונפסלו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואחר כך זרחה חמה עליהן ויבשו הרי אלו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותרין שאין מוקצה לתצי שבת הואיל והן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ראויים בתחלת השבת מוקצה שיבש מערב שבת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואין הבעלים יודעין בו הרי זה מותר בשבת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אף על פי שלא הזמינוה מערב שבת ואם לא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יבש מערב שבת אף על פי שהזמינוה מערב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבת ואמרו כשיבש מחר נאכל ממנו אין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הזמנתם מועלת כלום שאין הדבר ידוע",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שעתידין להתייבש מחר והרי הוא כמזמין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבנים לאכילה. היה בתחלת השבת יבש ואינו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יבש יש שאוכלין אותו ויש שאין אוכלין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותו אם הזמינו מערב שבת הרי זה מותר",
      "segment_ids": [
