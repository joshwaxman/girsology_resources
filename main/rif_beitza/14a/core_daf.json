      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמים כגון גרוגרות שנתייבשו מערב שבת",
      "segment_ids": [
