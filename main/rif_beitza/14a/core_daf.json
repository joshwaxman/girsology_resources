      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהרי גלה דעתו שהוא ראוי לו ואם לא",
      "segment_ids": [
