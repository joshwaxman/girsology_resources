      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין מוקצה לחצי שבת ומסתבר כלישנא בתרא",
      "segment_ids": [
