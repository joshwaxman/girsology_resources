      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הזמינו מערב שבת אסור שהרי הוא בחזקת",
      "segment_ids": [
