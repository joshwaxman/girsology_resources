      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בארזים ואשוחים דמודו בהו ר\"ש כיון",
      "segment_ids": [
