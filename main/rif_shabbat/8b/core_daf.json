      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 20b:5\" data-ror-ocr=\"במה מדליקין. לעשות פתילה כל הני\">מולש\"א בלעז: במה מדליקין - לעשות</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 20b:5\" data-ror-ocr=\"במה מדליקין. לעשות פתילה כל הני\">פתילה כל הני</i> <i class=\"ror-line\" data-ror-i=\"20\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 20b:5\" data-ror-ocr=\"דמתני׳ מפרש בגמ׳: ולא בזפת.\">דמתני' מפרש בגמרא: לא</i>"
