      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 18b:4\" data-ror-ocr=\"לא אסרו אלא משוס חתייה האי קדרה\">לא אסירא אלא משום חתייה: האי קדר'</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 18b:4\" data-ror-ocr=\"חייתא שפיר דמי להשהותה מבעוד יום\">חייתא שפיר דמי - להשהותה לכתחלה מבעוד</i>"
