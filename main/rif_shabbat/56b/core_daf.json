      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מי הוה פטור אבל אסור או חייב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חטאת: <b>משום בורר.</b> ומפרשי'",
