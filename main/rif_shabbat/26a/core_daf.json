      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 57a:8\" data-ror-ocr=\"שהוא אריג לא גזרו. לצאת בו בשבת ללא\">חציצה</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 57a:9\" data-ror-ocr=\"ליטלן מראשן כשרוחצות בחמין אלמא עיילו\">ליטלן מראשן כשהן רוחצות</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 57a:9\" data-ror-ocr=\"ליטלן מראשן כשרוחצות בחמין אלמא עיילו\">בחמין אלמא עיילי</i> <i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Shabbat 57a:9\" data-ror-ocr=\"בהו מיא (ל) בהנאח רחיצה ב) ו כ ״ ש לעני!\">בהו מיא <i class=\"ror-talmud-only\" data-ror-chars=\"10\" data-ror-talmud=\"שפיר אפילו להנאת\">°</i> רחיצה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Shabbat 57a:9\" data-ror-ocr=\"בהו מיא (ל) בהנאח רחיצה ב) ו כ ״ ש לעני!\">וכיון שכן לענין</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 57a:9\" data-ror-ocr=\"טבילה לא צריכה להתירו ומותר לצאת בהן\">טבילה נמי לא צריכין</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 57a:9\" data-ror-ocr=\"טבילה לא צריכה להתירו ומותר לצאת בהן\">להתירן ומותר לצאת בהן</i> <i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Shabbat 57a:9\" data-ror-ocr=\"בשבת: דנוניפן. שנטנפו הנך ת י ט בטיט.\"><i class=\"ror-talmud-only\" data-ror-chars=\"46\" data-ror-talmud=\"מתרמי טבילה לא שרו להו לא משום חציצה ולא משום קפידא: דמיטנפי\">°</i> - שנטנפו הנך</i>"
      },
