      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרו אין בנין וסתירה בכלים ה\"מ בשאינו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנין וסתירה אבל אם הוא בנין שלם או",
