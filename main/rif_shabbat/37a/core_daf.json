      ],
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לדברי רש\"י דס\"ל בפ' כלל גדול דף ע\"ה",
