        "text": "<i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:3\" data-ror-ocr=\"אין ס פ ק לשבת זו לפשיטא לן להיום לא\">דהיום לא</i> <i class=\"ror-line\" data-ror-i=\"16\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:3\" data-ror-ocr=\"ימות אלא ס פ ק שאס לא יעשו לו היוס\">ימות אלא ספק שאם לא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"16\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:3\" data-ror-ocr=\"ימות אלא ס פ ק שאס לא יעשו לו היוס\">יעשו לו היום</i> <i class=\"ror-line\" data-ror-i=\"17\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:3\" data-ror-ocr=\"שמא ימות לשבת הבאה והיט למי כגון\">שמא ימות לשבת הבאה:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"17\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:3\" data-ror-ocr=\"שמא ימות לשבת הבאה והיט למי כגון\">והיכי דמי כגון דאמדוה</i> <i class=\"ror-line\" data-ror-i=\"18\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:4\" data-ror-ocr=\"לאמלוהו רופאים לעשות לו הלפואה ח׳\">- רופאים</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"18\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:4\" data-ror-ocr=\"לאמלוהו רופאים לעשות לו הלפואה ח׳\">לעשות לו הרפואה שמנה</i> <i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Yoma 84b:4\" data-ror-ocr=\"ימים: להברוהו. לחיצה: שיבריא. שמא\">ימים:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Yoma 84b:4\" data-ror-ocr=\"ימים: להברוהו. לחיצה: שיבריא. שמא\">להברותו - רחיצה שמא</i> <i class=\"ror-line\" data-ror-i=\"20\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:5\" data-ror-ocr=\"יבריא מאליו: על פי נשים. אם צשיס\">יבריא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"20\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:5\" data-ror-ocr=\"יבריא מאליו: על פי נשים. אם צשיס\">מאיליו: על פי נשים - אם נשים</i> <i class=\"ror-line\" data-ror-i=\"21\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yoma 84b:6\" data-ror-ocr=\"או כוחיס אומרים צריך אין מחללין על\">או</i>"
      },
