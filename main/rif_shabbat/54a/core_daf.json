    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטבילין אותו כלומר עד שיטיף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאלמלא אין לו תקנה לעולם",
      "segment_ids": [
