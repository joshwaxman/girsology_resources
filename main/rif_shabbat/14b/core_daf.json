  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> לפרש\"י ומיי' פ\"ו מהל' עירובין אע\"פ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שספק חשיכה ספק אינו חשיכה אין מערבין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ערובי תחומין לכתחלה מיהו אם עירב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בדיעבד הוי עירובו עירוב ולדברי התוס'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והרא\"ש בין לכתחלה בין בדיעבד לא הוי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עירובו עירוב וטעמייהו מבוארים שם באורך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואפי' קבל עליו תוספת שבת כתב הר\"ר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמרי' שיכולין לערב ויש אוסרין אם קבל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עליו תוספת שבת: <b>לשון ריא\"ז</b> וכן מערבין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בין השמשות עירובי חצירות אבל לא עירובי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תחומין: <b>ב</b> וכתב מיי' ואם עירב בה\"ש הוי",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עירוב: <b>ג</b> לפי גי' רבינו ומיי' מותר",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        4,
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להטמין בה\"ש אפי' בדבר המוסיף הבל ולפי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גי' רש\"י והרא\"ש והראב\"ד אינו מותר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להטמין בין השמשות אלא בדבר שאינו מוסיף",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הבל וראיותיהם הם באורך בהר\"ן: <b>לשון</b>",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> וכן טומנין בחמין אף על פי שאסור",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להטמין אחר חשיכה אפי' בדבר שאינו מוסיף",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הבל: <b>ד</b> רא\"ם מפרש דבה\"ש הוי קודם שיתחיל",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החמה לשקוע דהיינו בשעה שמכירים העולם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שרוצה ליכנס בעובי הרקיע שהוא מעט קודם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שקיעת החמה לרבה ג' רבעי מיל ולרב יוסף",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ב' שלישי מיל אבל שקיעת החמה עצמה עד",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זמן יציאת שלשה כוכבים שהוא מהלך ה'",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מילין הוי לילה גמור מדאורייתא ולפירוש",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"ת והרמב\"ן משעה שמתחלת החמה לשקוע עד",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדי מהלך ג' מילין ורביע מיל הוי יום",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וזהו תוספת שבת ויה\"כ בתחלתו ומזה הזמן",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עד צאת הכוכבים שהוא סוף השקיעה הוי בין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השמשות כי הם מפרשין משתשקע שר\"ל לאחר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שקיעת החמה וכן פי' סמג עשין ל\"ב וי\"מ",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבה\"ש מתחיל משעה שהחמה שוקעת שאיננה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נראית עוד והולך עד כדי מהלך ג' רבעי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיל ולאחר מכאן הוי לילה גמור ואין זה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נכון כי בפ\"ק דמסכת ברכות פסקינן דעד",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צאת הכוכבים מיקרי יום והרי\"ף ומיי'",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואשר\"י לא פירשו דעתן בזה: <b>לשון ריא\"ז</b>",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "איזהו בין השמשות ספק הוא ספק כולו יום",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ספק כולו לילה ספק דמקצתו יום ומקצתו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לילה שכח ועשה מלאכה שני בין השמשות",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בע\"ש ובמ\"ש כגון שהיה כותב כל בין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השמשות מתחלתו ועד סופו הרי זה חייב",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חטאת מה נפשך שאם בה\"ש של ע\"ש יום גם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בה\"ש שלמ\"ש יום והרי עשה מלאכה בשבת ואם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "של מ\"ש לילה גם של ע\"ש לילה:",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        7
      ]
    }
  ],
