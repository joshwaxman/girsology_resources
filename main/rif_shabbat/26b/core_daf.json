      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקילין בקשין דוקא במידי דלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיתסר משום כלאים אלא מדרבנן",
      "segment_ids": [
