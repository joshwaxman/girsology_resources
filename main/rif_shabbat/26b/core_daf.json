      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגדי כהונה קשין הן ולהכי שרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התם להציען תחתיו אלא ודאי כי",
      "segment_ids": [
