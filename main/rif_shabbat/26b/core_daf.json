    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדרבנן אבל במידי דמיתסר משום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלאים דאורייתא אפי' קשה נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסור וראיה לדבר מדאמרינן",
