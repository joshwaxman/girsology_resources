      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא היה זוחל בו מתחלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומקומות יש בו שלא נשתנה דינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכמות שהיה אלא הרי הוא כמעין",
      "segment_ids": [
