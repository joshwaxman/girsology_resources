  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מיהו</b> איכא מאן דאמר דכי חיישינן לרבוי נוטפין על הזוחלין דוקא לטבול בהן במקום שלא היתה שם זחילתו של נהר קודם לכן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אבל במקום שהיתה זחילתו מתחלה אע\"פ שעכשיו רבו נוטפין על הזוחלין מותר לטבול בו ומוכח לה מדתנן בפ\"ק דמקואות מעין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמימיו מועטין שרבו עליו מים שאובין שוה למקוה לטהר באשבורן ולמעין להטביל <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>בכל שהוא ומדקתני שוה למקוה לטהר באשבורן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלמא דין מקוה יש בו שאינו מטהר בזוחלין שאין עליו דין מעין אלא הרי הוא כמקוה שצריך אשבורן והדר קתני ולמעין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להטביל <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>בכל שהוא ובודאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדקתני דשוה למעין להטביל <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>בכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא הוא הדין דמטהר בזוחלין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון דתורת מעין עליו וקשיא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רישא אסיפא אלא ודאי הכי קתני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעין זה שרבו עליו המים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאובים מקומות יש בו שתורת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקוה עליהם וצריך אשבורן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו אותם מקומות שהוא זוחל",
      "segment_ids": [
