      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 140b:25\" data-ror-ocr=\"דאית ליה רירי ונמאס והא לקרי לה הכא\">רירי ואימאיס והא דקרי לה הכא</i> <i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 140b:25\" data-ror-ocr=\"פיה יפה והכא פיה רעה כרמסרש ואזיל\">פיה יפה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 140b:25\" data-ror-ocr=\"פיה יפה והכא פיה רעה כרמסרש ואזיל\">והכא פיה רע כדמפרש ואזיל פיה יפה דלית</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 140b:25\" data-ror-ocr=\"יפה רלימ ליה רירי רעה ללא לייק ואכיל\">ליה רירי פיה רע דלא דייק ואכיל</i> <i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 140b:25\" data-ror-ocr=\"שאוכל קוצים וברקנים: מ ת נ י ׳ הקש שעל\">שאוכל</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 140b:25\" data-ror-ocr=\"שאוכל קוצים וברקנים: מ ת נ י ׳ הקש שעל\">קוצים וברקנים: מתני' הקש שעל</i> <i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 141a:3\" data-ror-ocr=\"המעה. וסתמיה להסקה ומוקצה הוא ובא\">המטה -</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 141a:3\" data-ror-ocr=\"המעה. וסתמיה להסקה ומוקצה הוא ובא\">וסתמא להסקה ומוקצה הוא ובא</i> <i class=\"ror-line\" data-ror-i=\"14\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 141a:3\" data-ror-ocr=\"לשכב עליו ומנענע כלי שיהיה צף ורן\">לשכב עליו</i>"
      },
