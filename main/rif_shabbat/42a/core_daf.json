  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "מקפלין את הכלים ומציעין את המטות <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מיום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכפורים לשבת וחלבי שבת קריבין ביום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכפורים ולא של יום הכפורים בשבת ר\"ע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר לא של שבת קריבין ביום הכפורים ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של יום הכפורים קריבין בשבת: <b><big>גמ'</big></b> מקפלים",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הכלים וכו' דבי רבי ינאי אמרו <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>ל\"ש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא באדם אחד אבל בשני בני אדם לא ובאדם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד נמי לא אמרן אלא בחדשים אבל בישנים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא ובחדשים נמי לא אמרן אלא בלבנים אבל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בצבועין לא ולא אמרן אלא שאין לו להחליף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבל יש לו להחליף לא: תאנא של בית רבן",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גמליאל לא היו מקפלין כלי לבן שלהם מפני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיה להם להחליף: אמר רב הונא יש לו",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להחליף יחליף אין לו <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>להחליף ישלשל בגדיו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום שנא' (ישעיהו נ״ח:י״ג) וכבדתו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעשות דרכיך ממצוא חפצך וכבדתו שלא תהא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלבושך של שבת כמלבושך של חול כי הא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבי [יוחנן] קרי למאניה מככדותי: <span class=\"bavli-ref\" data-bavli-ref=\"(דף קיד.)\" data-bavli-daf=\"114a\" data-bavli-index=\"0\"></span>א\"ר",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן מנין לשינוי בגדים מן התורה שנאמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(ויקרא ו׳:ד׳) ופשט את בגדיו ולבש בגדים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחרים ותאנא דבי ר' ישמעאל בגדים שבישל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהם קדרה לרבו אל ימזוג בהן כוס לרבו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי חייא בר אבא אמר רבי יוחנן <i data-commentator=\"Mishneh Torah, Human Dispositions\" data-label=\"⚬\"></i>גנאי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא לתלמיד חכם שיצא במנעלים המטולאים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והא רבי חייא נפיק אמר מר זוטרא בריה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרב נחמן בטלאי על גבי טלאי והני מילי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעילאי <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>אבל בגילדאי לית לן בה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>ובעילאי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "נמי לא אמרן אלא בימות החמה אבל בימות הגשמים לא ואמר רבי חייא בר אבא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אמר ר' יוחנן כל ת\"ח שנמצא רבב על בגדו חייב מיתה שנא' (משלי ח׳:ל״ו) כל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "משנאי אהבו מות אל תיקרי משנאי אלא משניאי רבינא אמר רבד איתמר ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "פליגי הא בלבושא הא בגלימא. פירוש רבב כגון קירא וזיפתא וכיוצא בו",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ופירוש רבד דם יבש וטעמו של דבר כדי שלא יראה כדם נדה ויבא לידי חשד:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "א\"ר יוחנן איזהו ת\"ח <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ג\" data-order=\"3\"></i>שממנין אותו פרנס על הצבור כל ששואלין ממנו דבר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הלכה בכל מקום ואומרה ואפילו במס' כלה א\"ר יוחנן איזהו ת\"ח שבני עירו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מצווין לעשות לו מלאכתו זה שמניח חפציו ועוסק בחפצי שמים למאי נפקא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מיניה למיטרח ליה בריפתא וגרסינן ביומא <span class=\"bavli-ref\" data-bavli-ref=\"(יומא דף עב:)\" data-bavli-daf=\"72b\" data-bavli-scope=\"יומא\" data-bavli-index=\"1\"></span>ר\"י רמי כתיב (דברים י׳:א׳-ב׳)",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ועשית לך ארון עץ וכתיב (שמות כ״ה:י׳) ועשו ארון עצי שטים מכאן לתלמיד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "חכם שבני עירו מצווין לעשות מלאכתו (שמות כ״ה:י׳) מבית ומחוץ תצפנו אמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "רבה כל תלמיד חכם שאין תוכו בברו אינו ת\"ח אביי ואיתימא ר' אבא אמר נקרא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תועבה שנאמר (איוב ט״ו:ט״ז) אף כי נתעב ונאלח <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>אמר רבי שמואל בר נחמני",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "א\"ר יונתן מאי דכתיב (משלי י״ז:ט״ז) למה זה מחיר ביד כסיל <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>וגו' אוי לת\"ח",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שעוסק בתורה ואין בו יראת שמים א\"ר ינאי חבל על דלית ליה ביתא ותרעא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לביתא עביד אמר להו רבא לרבנן במטותא מינייכו לא תירתון תרתי גיהנם א\"ר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "יהושע בן לוי מאי דכתיב (דברים ד׳:מ״ד) וזאת התורה אשר שם משה זכה נעשית",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לו סם חיים לא זכה נעשית לו סם המות <span class=\"bavli-ref\" data-bavli-ref=\"(במכילתין דף קיד.)\" data-bavli-daf=\"114a\" data-bavli-scope=\"במכילתין\" data-bavli-index=\"2\"></span>וא\"ר יוחנן איזהו ת\"ח כל ששואלין",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אותו בדבר הלכה בכל מקום ואומרה ואמרינן למאי הלכתא למנוייה פרנס אי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "במסכתא באתריה ואי בכולי תלמודא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>בריש מתיבתא <span class=\"bavli-ref\" data-bavli-ref=\"(דף קיג.)\" data-bavli-daf=\"113a\" data-bavli-index=\"3\"></span><i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>מעשות דרכיך שלא יהא הלוכך",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "של שבת כהלוכך של חול מאי היא דלא ליפסע פסיעה גסה <span class=\"bavli-ref\" data-bavli-ref=\"(דף קיג:)\" data-bavli-daf=\"113b\" data-bavli-index=\"4\"></span>כדבעיא מיניה רבי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מרבי ישמעאל ברבי יוסי מהו לפסוע פסיעה גסה בשבת אמר ליה וכי בחול מי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "התירו שאני אומר בחול נמי אסור דאמר מר פסיעה גסה נוטלת אחת מחמש מאות",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ממאור עיניו של אדם במאי מהדר לה בקדושא דבי שמשי בעא מיניה רבי מרבי",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ישמעאל ברבי יוסי מהו לאכול אדמה בשבת אמר לו אף בחול אסור מפני שהוא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מלקה <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>אמר רבי אמי כל האוכל מעפרה של בבל כאילו אוכל <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>מבשר אבותיו ויש",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אומרים כאילו אוכל שקצים ורמשים דכתיב (בראשית ז׳:כ״ג) וימח את כל היקום",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "text": "וגו' אמר רבי שמעון בן לקיש למה נקרא שמה שנער שכל מתי מבול ננערו לשם א\"ר יוחנן למה נקרא שמה מצולה שכל",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "text": "מתי מבול נצללו לשם <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>ובודאי שקצים ורמשים דאמרי אתמחויי אתמחו <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>[ואסרי] כיון דמילקא גזרו בה רבנן כי הא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "text": "דההוא גברא דאכל גרגשתא ואכיל תחלי וקדחה ליה תחלי",
      "segment_ids": [
        10
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מיום הכפורים לשבת.</b> כגון אם חל יום הכפורים להיות בערב שבת: <b>קריבין ביום הכפורים.</b> שחל להיות במוצאי שבת: <b>גמ' בשני</b>",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בני אדם.</b> <i data-commentator=\"Hagahot HaBach\" data-label=\"י\" data-order=\"10\"></i>שמקפלין אותם מישבין את קמטיהם ונראין כמתקנין אותן: <b>ישנים.</b> קפולם מתקנן יותר מן החדשים שהחדשים קשין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מאיליהן ואין ממהרים לקמוט: <b>צבועים.</b> קפולם מתקנן יותר מלבנים: <b>יש לו להחליף.</b> בגדים אחרים היום אינו מקפל: <b>יש לו</b>",
      "segment_ids": [
        3,
        4,
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>להחליף.</b> מי שיש לו בגדים לבד מאותן שלובש בחול יחליפם בשבת: <b>ישלשל בגדיו.</b> כלפי מטה שיראו ארוכים והוא מדת עשירים",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיושבין בביתם ואינן צריכים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לסלק בגדיהן מן הארץ בשביל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלאכה וכבוד שבת הוא:",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מכבדותי.</b> שמכבדין בעליהן:",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מנין לשנוי בגדים מן התורה.</b>",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא דרך כבוד לפני המקום:",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דכתיב.</b> ופשט את בגדיו ולבש",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגדים אחרים והוציא את הדשן.",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הזקיקו הכתוב ללבוש בגדים",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחרים פחותים בשעת הוצאת הדשן",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינה עבודה חשובה כדי שלא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימאסו הבגדים החשובין שיעבוד",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהן עבודת אכילה ושתיה כגון",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קטור ונסוך: <b>ותנא דבי רבי</b>",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ישמעאל.</b> בדרשא דהאי קרא:",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בגדים שבשל בהם קדרה לרבו.</b>",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דומיא דהוצאת הדשן: <b>אל ימזוג</b>",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בהן כוס לרבו.</b> לפיכך הוצרך",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ללבוש בגדים פחותים: <b>רבב.</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שומן וחלב: <b>חייב מיתה.</b> שצריך",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להיות הגון וחשוב לכבוד",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תורתו: <b>למשניאי.</b> המשניאים",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותי לפני הבריות והבריות",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומרות אוי להן ללומדי תורה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהן מאוסין ומגונין נמצא זה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משניא התורה: <b>רבד איתמר.</b> רבד",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דם יבש כדאמרינן [דף קכט.]",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ריבדא דכוסילתא: <b>הא בגלימא.</b>",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא מלבוש עליון צריך להזהר",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו מדם יבש שמא יראה ככתם",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נדה ויבא לידי חשד. אבל",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במלבושו שהוא מלבוש תחתון לא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרי' אפשר דלא הוה ליה טלית",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחרת וגרידה ודם מאכולת הוא:",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואפילו במסכת כלה.</b> דלא רגילי",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בה אינשי וזה נתן לבו וגרסה.",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסכת כלה ברייתא היא כלה בלא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכה אסורה לבעלה כנדה: <b>שבני</b>",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עירו מצווין לעשות מלאכתו.</b>",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסמוך מוכחי לה: <b>למטרח ליה</b>",
      "segment_ids": [
        20,
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בריפתיה.</b> דבר שאין יכול הוא",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לטרוח בו וחייו תלויין בו:",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שאין תוכו כברו.</b> שאין כונתו",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טובה כדבריו: <b>חבל על דלית ליה</b>",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ביתא.</b> אוי למי שאין לו בית",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ועושה פתח שיגע לריק ודומה לו",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מי שאין בידו יראת שמים שהיא",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כבית ועושה השער שהוא החכמה:",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תרתי גיהנם.</b> הטורח והעונש אם",
      "segment_ids": [
        24
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא היו נוהגין כשורה: <b>אי</b>",
      "segment_ids": [
        24,
        25
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במסכתא באתריה.</b> אם יודע להשיב",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במסכתא שהוא עוסק בה ממנין",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו פרנס באתריה: <b>ואי בכולי</b>",
      "segment_ids": [
        25,
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תלמודא.</b> דקאי בהאי מסכתא",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומהדר במסכתא אחריתי: <b>דלא</b>",
      "segment_ids": [
        26,
        27
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ליפסע פסיעה גסה.</b> יותר מאמה",
      "segment_ids": [
        27
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסיעה בינונית אמה: <b>בקידושא</b>",
      "segment_ids": [
        27,
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דבי שמשי.</b> כששותה יין של קדוש",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היום בלילי שבתות: <b>מהו לאכול</b>",
      "segment_ids": [
        28,
        29
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אדמה.</b> ארזילה מי גזרינן משום",
      "segment_ids": [
        29
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחיקת רפואה או לא: <b>שהיא</b>",
      "segment_ids": [
        29,
        30
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מלקה.</b> מביאה לידי חולי:",
      "segment_ids": [
        30
      ]
    }
  ],
