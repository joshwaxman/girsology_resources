      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאי אדינייהו אלא לענין תכשיט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומשוי מאי קושיא כי היכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרינן דטבעת שהוא תכשיט",
      "segment_ids": [
