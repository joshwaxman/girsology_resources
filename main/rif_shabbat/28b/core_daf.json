      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באשה פטור אבל אסור וטבעת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא תכשיט לאיש מותר לכתחלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכי נמי נימא דטבעת שהוא משוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאשה חייבת עליה חטאת וטבעת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא משוי לאיש פטור אבל אסור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפי שאין דרך הוצאה שלו בכך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא משמע דסברא דתלמודא הוא",
      "segment_ids": [
