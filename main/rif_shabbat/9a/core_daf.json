      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הר\"ז הלוי: <b>ג</b> רוב הפוסקים מסכימי' דיכול",
      "segment_ids": [
        1,
        2
      ],
