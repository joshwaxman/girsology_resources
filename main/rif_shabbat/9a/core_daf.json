      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תשמיש קדושת מצו' אסור להשתמש לאורה",
      "segment_ids": [
