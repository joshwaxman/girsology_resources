        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הפוסקים הסכימו דל\"ש תשמיש חול ל\"ש",
      "segment_ids": [
