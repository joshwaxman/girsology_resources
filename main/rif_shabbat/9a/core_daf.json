      "text": "ולא לעכוב ומדברי מיי' פ\"ד מהלכות חנוכה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נראה פשוט דלעכוב נאמר וכתב להדיא דאין",
