  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "לחומרא: מפני האורחין <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>ומפני ביטול בית",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המדרש דמצוה נינהו דאמר ר' יוחנן גדולה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכנסת אורחין כהשכמת בית המדרש דקתני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני האורחין ומפני ביטול בית המדרש ורב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דימי אמר יותר מהשכמת בהמ\"ד דקתני מפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האורחין והדר תני ומפני ביטול בהמ\"ד אבל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא במקום מצוה לא אמר רב יהודה אמר רב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדולה הכנסת אורחין מהקבלת פני השכינה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנאמר (בראשית י״ח:ג׳) ויאמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">[צ\"ל</i>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">אדני]</i>ה' אם נא מצאתי חן בעיניך וגו':",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אר\"א בא וראה שלא כמדת הקב\"ה מדת בשר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודם מדת ב\"ו אין הקטן יכול לומר לגדול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המתן לי עד שאבא אצלך ואילו בהקב\"ה כתיב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויאמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">[צ\"ל</i> <i class=\"footnote\">אדני]</i>ה' [וגו'] אל נא תעבור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מעל עבדך: אמר רב יהודה בר שילא אמר רב אסי אמר רבי יוחנן ו' דברים",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כשאדם עושה אותם אוכל פירותיהן בעולם הזה והקרן קיימת לו לעולם הבא אלו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הן הכנסת אורחין ובקור חולים ועיון תפלה והשכמת בית המדרש והמגדל בניו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לתלמוד תורה והדן את חבירו לכף זכות <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכז:)\" data-bavli-daf=\"127b\" data-bavli-index=\"0\"></span>ת\"ר הדן את חבירו לכף זכות דנין",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אותו לכף זכות ומעשה באדם אחד שירד מגליל העליון שהיה נשכר שם ג' שנים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אצל בעל הבית בדרום כיון שהגיע ערב הרגל אמר לו תן לי שכרי ואלך ואפרנס",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "את אשתי ואת בני א\"ל אין לי מעות תן לי בהמה א\"ל אין לי תן לי קרקע א\"ל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אין לי תן לי פירות א\"ל אין לי תן לי כרים וכסתות א\"ל אין לי הפשיל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "טליתו לאחוריו והלך לו בפחי נפש לאחר הרגל נטל בעל הבית שכרו בידו ונטל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עמו משאוי ג' חמורין אחד של מאכל ואחד של משתה ואחד של מיני מגדים והלך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לביתו לאחר שאכלו ושתו נתן לו שכרו (בידו) ואמר לו כשאמרת לי תן לי שכרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואמרתי לך אין לי מעות במה חשדתני אמרתי שמא מצאת פרקמטיא בזול וכשאמרת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לי תן לי בהמה ואמרתי לך אין לי בהמה במה חשדתני אמרתי שמא מושכרות הן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ביד אחרים וכשאמרת לי תן לי קרקע ואמרתי לך אין לי במה חשדתני אמרתי שמא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>מחוכרות הן ביד אחרים וכשאמרת לי תן לי פירות ואמרתי לך אין לי במה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חשדתני אמרתי שמא אינן מעושרות וכשאמרת לי תן לי כרים וכסתות ואמרתי לך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אין לי במה חשדתני אמרתי שמא הקדישתן לשמים אמר לו העבודה כך היה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שהקדשתי כל נכסי לשמים בשביל הורקנוס בני שלא עסק בתורה וכשבאתי אצל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חבירי שבדרום התירו לי את נדרי ואתה כשם שדנתני לכף זכות כך <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>ידין אותך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "המקום לכף זכות: ת\"ר מעשה בחסיד אחד שפדה ריבה אחת בת ישראל וכשבא למלון",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "השכיבה אצל מרגלותיו למחר השכים וטבל ובא ושנה לתלמידיו ואמר להם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כשהשכבתיה אצל מרגלותי במה חשדתוני אמרנו שמא תלמיד אחד יש בינינו שאינו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בדוק לרבי וכשירדתי וטבלתי במה חשדתוני אמרנו שמא מטורח הדרך ראה רבינו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "קרי אמר להם העבודה כך היה וכשם שדנתוני לכף זכות כך ידין המקום אתכם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לכף זכות: ת\"ר פעם אחת הוצרך דבר לחכמים אצל מטרוניתא אחת שכל גדולי",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רומי מצויין אצלה אמרו מי ילך אצלה אמר להם רבי יהושע בן חנניא אני אלך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אצלה הלך אצלה הוא ותלמידיו כיון שהגיע לפתח ביתה חלץ תפליו ברחוק ד'",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אמות ונכנס ונעל הדלת אחריו וכשיצא ירד וטבל ושנה לתלמידיו אמר להם בשעה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שחלצתי תפילין במה חשדתוני אמרנו שמא קסבר רבי אסור ליבנס בדבר שבקדושה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "במקום הטנופת וכשנעלתי הדלת בפניכם ונכנסתי במה חשדתוני אמרנו שמא דבר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מלכות בינו ובינה וכשיצאתי וירדתי וטבלתי ועליתי ושניתי במה חשדתוני",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אמרנו שמא נתזה צנורא מפיה על בגדו של רבי אמר להן העבודה כך היה ואתם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כשם שדנתוני לכף זכות כך ידין אתכם המקום לכף זכות: ולא <i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>את הלוף ולא את",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "החרדל: <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכח.)\" data-bavli-daf=\"128a\" data-bavli-index=\"1\"></span>ת\"ר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מטלטלין את החצב מפני שהוא מאכל לצביים ואת החרדל מפני שהוא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מאכל ליונים ר\"ש בן גמליאל אומר אף מטלטלין שברי זכוכית מפני שהוא מאכל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לנעמיות א\"ל ר' נתן אלא מעתה חבילי זמורות יטלטלו מפני שהן מאכל לפילין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ור\"ש בן גמליאל אמר לך פילין לא שכיחי נעמיות שכיחי: אמר אביי רשב\"ג",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ור\"ש ורבי ישמעאל ור\"ע כולהו סבירא להו שכל ישראל בני מלכים הן רשב\"ג הא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דאמרן רבי שמעון דתנן <span class=\"bavli-ref\" data-bavli-ref=\"(דף קיא.)\" data-bavli-daf=\"111a\" data-bavli-index=\"2\"></span>בני מלכים סכין שמן וורד על <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>גבי מכותיהן רבי שמעון",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אומר כל ישראל בני מלכים הם ר' ישמעאל ור' עקיבא דתניא <span class=\"bavli-ref\" data-bavli-ref=\"(ב&quot;מ דף קיג:)\" data-bavli-daf=\"113b\" data-bavli-scope=\"ב&quot;מ\" data-bavli-index=\"3\"></span>הרי שהיו נושין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בו אלף זוז והיתה לו אצטלא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בס\"י</i> <i class=\"footnote\">בת\"ק</i> <i class=\"footnote\">מנה</i>בת מאה מנה מפשיטין אותו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ומלבישין אותו אצטלא הראויה לו <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ד\" data-order=\"4\"></i>ותאנא דבי רבי ישמעאל רבי [ישמעאל] ור'",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עקיבא אמרו כל ישראל ראוין לאותה אצטלא וקיי\"ל דכל כי האי גוונא שיטה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היא ולית הלכתא כחד מינייהו (ואין מטלטלין את החרדל דקיי\"ל בהא כסתם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "משנה): <b><big>מתני'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכו:)\" data-bavli-daf=\"126b\" data-bavli-index=\"4\"></span>חבילי קש וחבילי עצים וחבילי זרדין אם התקינן למאכל בהמה",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מטלטלין אותם ואם לאו אין מטלטלין אותם <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכח:)\" data-bavli-daf=\"128b\" data-bavli-index=\"5\"></span>כופין את הסל לפני האפרוחים",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שיעלו ושירדו תרנגולת שברחה דוחין אותה עד שתכנס מדדין עגלים וסייחים",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואשה מדדה את בנה אמר רבי יהודה אימתי",
      "segment_ids": [
        9
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואיבעיא</b> לן תו בגמרא הני ד' וה' קופות דקאמרינן בד' וה' אין בטפי לא משום דמעוטי בהלוכא עדיף או דלמא מעוטי במשוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עדיף ומסקנא דמעוטי בהלוכא עדיף: <b>פיסקא</b> מפני האורחים כו' כהשכמת בית המדרש מדמשוי להו מתני' כהדדי: <b>מהשכמת בית</b>",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>המדרש.</b> דתנא דידן אקדמיה ברישא: <b>אל נא תעבור.</b> והניחו והלך לקבל אורחים וסבירא ליה דהאי שם קדש הוא ודלא כמאן דסבירא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ליה בשבועות (דף לה:) דהוא חול: <b>ששה דברים שאדם עושה אותן אוכל פירותיהן בעולם הזה וכו'.</b> מפרשי' בגמרא משום דכל הני",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלל גמילות חסדים והבאת שלום",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבין אדם לחבירו ותלמוד תורה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתנן בהו במס' פאה [פ\"א] דאדם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אוכל פירותיהן בעה\"ז: <b>ועיון</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תפלה.</b> כלומר מכוין בתפלתו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלל ג\"ח כדכתיב (משלי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "י״א:י״ז) גומל נפשו איש חסד:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>השכמת</b> בית המדרש וגידול בנים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתלמוד תורה היינו תלמוד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תורה: <b>דן את חבירו לכף זכות.</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלל הבאת שלום דמתוך שהוא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכריע לזכות ואומר לא חטא לי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בזה אנוס היה או לטובה היה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתכוין יש שלום ביניהם ור'",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוחנן אתא לפרושי דבכלל הנהו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתנן במס' פאה איתנהו להנך ו'",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואיכא נמי כיבוד אב ואם ור'",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוחנן לא פליג עליה: <b>בפחי</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נפש.</b> בדאבון נפש: <b>מוחכרת.</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנותנה לחבירו בכך וכך כורין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשנה: <b>מעשה בחסיד אחד.</b> כל",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היכא דאמרי' מעשה בחסיד אחד",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(ב\"ק דף קג:) או ר' יהודה בן",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בבא או רבי יהודה ברבי אלעאי:",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ריבה.</b> נערה: <b>שאינו בדוק לרבי.</b>",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו מכיר במדותיו לסמוך",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו ולהניחה אצלנו:",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מטרוניתא.</b> נכרית: <b>דבר מלכות.</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וצריך להעלימו: <b>צנורא.</b> רוק",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וגזרו על הנכרים שיהו כזבין",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכל דבריהם: <b>פיסקא</b> ולא את",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלוף ולא החרדל חצב עשב",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמשתרש בעומק כנגדו ואין",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שרשיו מתפשטים ובו תיחם יהושע",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את הארץ: <b>נעמיות.</b> בנות יענה",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודרך מלכים לגדל אותן: <b>כל</b>",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ישראל בני מלכים הם.</b> ומותר",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לסוך על גבי מכותיהן בשבת שמן",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ורד ולא גזרינן משום שחיקת",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סמנין שכן דרך בני מלכים לסוך",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלא מכה הלכך לא מוכחא מילתא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלרפואה קא עביד: <b>ומסיקנא</b>",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמרא [דף קכח.] דאי אית ליה",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נעמיות או פילין אף שברי",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זכוכית וחבילי זמורות מותרין",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לטלטל אלא <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>דר\"ג מפרש טפי ואמר",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאע\"ג דלית לי' נעמיות",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלין שברי זכוכית כיון",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שדרכן של בני מלכים לגדל אותן",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא קיימא לן כותיה דלא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלין דבר שהוא מאכל לחיה",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולעוף כל היכא דליתנהו ברשותו",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא אם כן דרך בני אדם לגדל",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותן והא דתניא ואת החרדל",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שהוא מאכל ליונים פליגא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמתני' דתנן לא את הלוף ולא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את החרדל ואף על פי כן פסקה",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרב אלפסי ז\"ל וכן הרמב\"ם ז\"ל",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ה\" data-order=\"5\"></i>בפ\"ט מהלכות שבת ומשמע דס\"ל",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתנא דמתני' ותנא דברייתא לא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פליגי אהדדי אלא מר כי אתריה",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומר כי אתריה באתריה דתנא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דברייתא היו רגילין לגדל",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יונים ובאתריה דתנא דמתניתין",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא היו רגילים בהם אבל לכ\"ע",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין מטלטלין אלא מה שהוא ראוי",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבהמה חיה ועוף המצוים אצל",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בני אדם: <b>מתני' חבילי קש</b>",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> אם התקינן למאכל בהמה",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלין אותם [ואם לאו אין",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלין אותם] משום דסתמייהו",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהני להסקה קיימי בעינן בהו",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הזמנה:",
      "segment_ids": [
        20
      ]
    }
  ],
