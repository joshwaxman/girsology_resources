  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> דין פמוטות כתבנו לעיל סוף כירה ויש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קושיא בדברי מיי' וגם בדברי הטוא\"ח סי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רע\"ט ובחדושי הארכתי ליישב בס\"ד: <b>ב</b> ואם",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמירה לנכרי שבות גם באיסורי דרבנן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמירה לנכרי שבות לפי' התוס' ומדברי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיי' פ\"ו מהל' שבת משמע דבכ\"מ שיש קצת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חולי או צורך מותר לומר לנכרי לעשות דבר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין איסורו אלא משום שבות ומדברי ר\"ת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משמע דבאיסו' דרבנן ליכא איסור באמיר'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לנכרי ומדברי הטור נראה דס\"ל כתוס'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומדברי מגיד משנה פכ\"ד מהל' שבת משמע",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דלא הותרה אמירה לנכרי אפי' במקום מצוה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא במקום דליכא אלא איסור דרבנן עי'",
