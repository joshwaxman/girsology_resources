      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רה\"ר דעביד בהו איסורא דאוריי' וכ\"כ",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש והטור א\"ח סי' שכ\"ה ולדברי ר\"ת הא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאסרינן להאכיל לבהמתו עשבים שלקט הנכרי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לצורך הישראל היינו דוקא שהוא בענין שלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היה יכול הישראל להעמיד בהמתו ע\"ג אותן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העשבים כגון שהבהמה מעבר הנהר מזה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והעשבים שהביא הנכרי מעבר הנהר מזה דאין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הישראל יכול להעמיד בהמתו ע\"ג אותן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העשבי' אבל אם היו העשבים בענין שהישראל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היה יכול להעמיד בהמתו ע\"ג אותן העשבים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אז אפי' לקטן הנכרי לצורך הישראל שרי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וחביריו חולקין עליו ולדידן שהבורות",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלנו בעומק וא\"א לטפס ולירד בשום ענין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נראה דאפילו לר\"ת וחביריו אם מילא הנכרי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מים לצורך הישראל מבור ברה\"ר והביאן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לרה\"י דרך רה\"ר אסורין מיהו אליבא דכל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלו דלדידן דלית לן רה\"ר רק כרמלית",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וליכא רק איסור דרבנן שאם הנכרי הביא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מים בשביל ישראל דרך כרמלית שהישראל לא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמר לו כלום דשרי לישראל אחר דומיא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דפירות שבאו חוץ לתחום בשביל ישראל זה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמותר לישראל אחר וי\"א דאפי' הביאן דרך",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רה\"ר שרו לישראל אחר וכן בהדלקת הנר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אע\"פ שהן איסורין דאוריי' דבכל האיסורין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמרי' דדבר הנעשה בשביל ישראל זה מותר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לישראל אחר והר\"ן דחה כל אלו הסברות",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עיין בפנים:",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    }
  ],
