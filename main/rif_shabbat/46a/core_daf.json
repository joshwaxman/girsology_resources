      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בטוא\"ח סי' תקפ\"ו: <b>ג</b> ר\"ת כתב דמותר",
