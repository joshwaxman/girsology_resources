        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוה מצי לטפס ולירד (ולעלות) בבור לשתות",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שם נמצא דלא אהנו לו מעשה דנכרי וכ\"ש אם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הביאן הנכרי מנהר שיותר בקל היה יכול",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הישראל לילך לנהר ולשתות ומתוך כך התיר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נמי פת שהכניס הנכרי בשבת מרה\"ר לרה\"י",
