  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב הרא\"ש ורבינו סתם דבריו ולא פי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הא דאסור במזיד אי מיירי מבעו\"י או",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משחשכה ונראה שסמך על זה שכתב אמר רב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ביבי בר אביי הדביק פת בתנור התירו לו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לרדותו קודם שיבא לידי איסור סקילה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכיון דהתירו רדיית הפת שהיא שבות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונגזרה במנין קודם שיבא לידי איסור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סקילה כל שכן החזרת ידו דאפי' שבות ליכא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דהתירו קודם שיבא לידי איסור סקילה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וממילא שמעינן דדוקא מבעוד יום קנסינן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ליה על שלא החזירה קודם שחשכה: <b>ב</b> לפי",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דעת רש\"י ומיי' כל שהוציאה במזיד בין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהוציא ידו מבעוד יום בין שהוציאה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משחשכה אסור להחזירה אפילו לאותה חצר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא קנסוהו שתהא תלויה שם עד שתחשך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולפי' התוס' והרא\"ש והטור ושאר פוסקי'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אם הוציאה מבעוד יום והניחה שם עד הלילה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אסו' (להוציאה) [להחזירה] אפי' לאותה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חצר כיון שאינו יכול לבא לידי חיוב חטאת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אף אם ישליכם מידו אבל אם הוציאה משחשכה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותר להחזירה שמא ישליכם מידו ויבא לידי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חיוב חטאת: <b>לשון ריא\"ז</b> היתה ידו מליאה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פירות והוציאה חוץ לחצרו בשבת למעלה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משלשה והחזירה לאותה חצר שהוא עומד בה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פטור ואפילו אם הוציאה במזיד וכמבואר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות אבל לחצר אחרת שבצדו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אסור להחזירה שנראה שעושה חפציו בשבת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא מטלטל מחצר לחצר דרך רה\"ר:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    }
  ],
