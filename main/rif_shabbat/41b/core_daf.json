  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דקטרי באצטרידא: <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>מפתחי חלוקה וכו':",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותרין לכתחלה: ורצועות מנעל וכו':",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איתמר התיר רצועות מנעל וסנדל תני חדא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייב חטאת ותני חדא פטור אבל אסור ותניא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אידך מותר לכתחלה קשיא מנעל אמנעל קשיא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סנדל אסנדל מנעל אמנעל לא קשיא הא דתני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייב במנעל דאושכפי דמעשה אומן הוא וקשר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של קיימא הוא והא דתני פטור אבל אסור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדרבנן דמעשה הדיוט הוא אלא שהוא קשר של",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קיימא ולפיכך פטור אבל אסור והא דתני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר לכתחלה בדבני מחוזא כגון רצועות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיוצאות מגופו של מנעל וקושרין אותו על",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרגל ועל השוק אחר שנועלין את המנעל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלאו מעשה אומן ולא קשר של קיימא הוא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וסנדל אסנדל לא קשיא הא דתני חייב חטאת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדטייעי דקטרי אושכפי דהוא נמי קשר של",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קיימא <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>כגון האי נמי דקרו ליה השתא תאסמה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעביד ליה לפי מדת איסתויר' <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>דכרעיה וקטר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה קיטרא מעלייתא ואם התירן בשבת חייב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חטאת והאי דקתני פטור אבל אסור בדחומרתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דקטרי אינהו והיכי דמי דחומרתא <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>מיכנפא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולהו רצועות ומעיילן בחומרתא <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>דכי בעי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעיק הדר קטיר מאבראי דחומרתא וכי בעי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מרווח והאי דקתני מותר לכתחלה בסנדל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דנפקי ביה <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>בתרי דזמנין דנפיק ביה האי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומרווח ליה וזמנין דנפיק ביה האי ומעיק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה והאי לאו קשר של קיימא הוא ולפיכך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר לכתחלה <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i><i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>(ערובין ק:) אמר רב אמי בר",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבא אמר רב אשי אסור להלוך על גבי עשבים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשבת שנאמר (משלי י״ט:ב׳) ואץ ברגלים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוטא תני חדא אסור להלוך על גבי עשבים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בשבת ותניא אידך מותר לא קשיא <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>כאן בימות החמה כאן בימות הגשמים איבעית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אימא הא והא בימות הגשמים ולא קשיא הא דאיכא שדאכי והא דליכא שדאכי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואיבעית אימא הא והא דאיכא שדאכי ולא קשיא הא דסאים מסאני והא דלא סאים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מסאני ואיבעית אימא הא והא דסאים מסאני ולא קשיא הא דאית ליה עקוסא והא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דלית ליה עקוסא והשתא <i data-commentator=\"Hagahot HaBach\" data-label=\"ח\" data-order=\"8\"></i>כולהו שריאין (שבת קיב.) ר' ירמיה הוה קא אזיל",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בתריה דרבי אבהו בכרמלית איפסיקא ליה רצועה דסנדליה א\"ל שקול גמי [לח]",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דחזי למיכלא דבהמה וכרוך עילויה אביי הוה קאים קמיה דרב יוסף בחצר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "איפסקא ליה רצועה דסנדליה א\"ל מה איעבד ליה א\"ל שבקיה ומאי שנא מדרבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ירמיה התם לא מינטר הכא מינטר: ר' אליעזר בן יעקב אומר קושרין לפני בהמה",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בשביל שלא תצא ואע\"ג דאית ליה תרי איסורי מהו דתימא <span class=\"bavli-ref\" data-bavli-ref=\"(דף קיג.)\" data-bavli-daf=\"113a\" data-bavli-index=\"0\"></span>חד מינייהו בטולי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בטליה קמשמע לן אמר רב יוסף אמר רב יהודה אמר שמואל הלכה כר\"א בן יעקב:",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "קושרין דלי וכו': א\"ר אבא א\"ר חייא בר אבא אמר רב מביא אדם <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>חבל של גרדי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מתוך ביתו וקושרו בפרה ובאבוס <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ג\" data-order=\"3\"></i><i data-commentator=\"Hagahot HaBach\" data-label=\"ט\" data-order=\"9\"></i>ואמר רב נחמן אמר שמואל <i data-commentator=\"Hagahot HaBach\" data-label=\"י\" data-order=\"10\"></i>אם כלי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i><i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i>קיואי הוא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מותר לטלטלו בשבת ואוקימנא בחבל של גרדי דהיינו כלי קיואי: <b><big>מתני'</big></b> <i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>מקפלין",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "את הכלים אפילו ארבעה וחמשה פעמים ומציעין את המטות מלילי שבת לשבת אבל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לא משבת למוצאי שבת רבי ישמעאל אומר",
      "segment_ids": [
        8
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וקיטרא דקטרי באסתרידא.</b> שכשרוצה להעמיד הספינה קושר רצועה באותה טבעת ומעמידה בה שבוע או שבועיים והוי כעין קשר של",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קיימא: <b>איתמר התיר רצועות מנעל וסנדל וכו' בדאושכפי.</b> בקשר [שהאושכף] עושה כשתוחב הרצועה במנעל וקושר קשר בתוכה שלא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תוכל לצאת והוא קיים לעולם ומעשה אומן הוא: <b>בדרבנן.</b> שכשקושרין אותו סביב לרגליהם אין קושרין אותו בדוחק שפעמים",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שחולצו כשהוא קשור ונועל וכשהוא קשור ומיהו קשר של קיימא לא הוי שבשעת הטיט מתירין אותו וקושר אותו בדוחק שלא ידבק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בטיט וישמט מרגלו כך פרש\"י",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל אבל הרב אלפסי ז\"ל כתב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמעשה הדיוט הוא אלא שהוא קשר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של קיימא ולפיכך פטור אבל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסור: <b>בדבני מחוזא.</b> שהן רחבי",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לב ומקפידין על לבושיהן ועל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נעליהן להיותן מכוונין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקושרין אותן בדוחק וצריך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להתירן ערבית: <b>אסתוירא</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דכרעיה.</b> באשורו אחזה רגלי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(איוב כ״ג:י״א) מתרגמינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באסתויריה אחדת רגלי [והוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העקב שולייתו של רגל]: <b>דנפקו</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ביה בתרי וכו'.</b> דכה\"ג ודאי לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קטרי ביה קשר של קיימא ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קשר אומן כדי שיהא נוח",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להתירו: <b>רבי ירמיה הוה קא אזל</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בתריה דרבי אבהו בכרמלית</b>",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>איפסיק ליה רצועה דסנדליה.</b>",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונפל מרגלו הסנדל שעל ידי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרצועה הוא עומד כי הסנדל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פתוח מעל גביו וצדדיו של עץ",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או של עור שלוק וקשה והרצועות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקשרות על גבי הרגל ומעמידות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו: <b>שקול גמי לח דחזי למאכל</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בהמה.</b> וראוי לטלטל וכרוך עליה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקום רצועה ונועלו עד שתכנס:",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אביי</b> הוה קאי קמיה דרב יוסף",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחצר: <b>שבקיה.</b> במקום שנפל",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מרגליך ולא תטלטלנו בידך",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להצניעו: <b>ומאי שנא מר' ירמיה.</b>",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשרי ר' אבהו לנעלו על ידי",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמי: <b>התם</b> בכרמלית כגון בקעה",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא הוה מינטר וכתב הראב\"ד",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל דהיינו טעמא דשרי משום",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכרמלית דלא מינטר לא מקצי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה איניש אלא דעתיה עלויה",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לטלטוליה על ידי גמי לח אבל",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחצר דמינטר מקצי ליה איניש",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדעתי' עד דמתקן ליה ולא משום",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפסד ממון נגעו בה: <b>תרי</b>",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>איסורי.</b> שני חבלים קושר ברחב",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפתח זה למעלה מזה: <b>חד</b>",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מינייהו בטוליה בטליה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכשיוציא הבהמה לא יתיר אלא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התחתון ויוציאנה בדוחק: <b>מביא</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אדם חבל של גרדי מתוך ביתו</b>",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וקושרו בפרה.</b> ראשו האחד וראשו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השני באבוס ולא חיישינן",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכשיתיר לא יתיר אלא קשר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבראש הפרה ויבטל הקשר שבאבוס",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהא מוכן לכך או יתיר שבאבוס",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויבטל אותו שבפרה ונמצא הא'",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של קיימא אבל בחבל דעלמא שהוא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוכן לכך אמרינן בגמרא שאם",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "היה קשור בפרה קושרו באבוס ואם היה קשור באבוס קושרו בפרה אבל לא יביא חבל מתוך ביתו ויקשרנו בפרה ובאבוס: <b>אם כלי</b>",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>קיואי הוא מותר לטלטלו בשבת.</b> דחזי לתשמיש אחר ולא חשיב ככלי שמלאכתו לאיסור שאין הגרדי מקפיד בכך: <b>מתני' מקפלין את</b>",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הכלים.</b> בגדים כשפושטן מקפלן מפני שמתרככין ומתקמטים כשאינן מקופלים: <b>אפילו ארבעה וחמשה פעמים.</b> כדי לחזור וללבשן בו",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ביום:",
      "segment_ids": [
        17
      ]
    }
  ],
