      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"1\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"אותו חי ע״י הלחק: מדיחי! אותו. ולא\">- ולא</i> <i class=\"ror-line\" data-ror-i=\"2\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"אמרינן זו היא בישולו אבל לא שורץ: חוץ\">אמרי' זהו בישוליה אבל לא שורין:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"2\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"אמרינן זו היא בישולו אבל לא שורץ: חוץ\">חוץ</i> <i class=\"ror-line\" data-ror-i=\"3\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"מן המליח היש!. לג מליח של שנה שעברה:\">מן המליח ישן - דג מליח של שנה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"3\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"מן המליח היש!. לג מליח של שנה שעברה:\">שעברה:</i> <i class=\"ror-line\" data-ror-i=\"4\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"וקולייש האיספגין. לג שאוכלי! אותו מחמס\">וקולייס האיספנין - שם דג</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"4\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"וקולייש האיספגין. לג שאוכלי! אותו מחמס\">שאוכלין אותו מחמת</i> <i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"מלחו על ילי הלמה בחמין והנך אפילו הלחה\">מלחו ע\"י הדחה בחמין</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"מלחו על ילי הלמה בחמין והנך אפילו הלחה\">והנך אפילו הדחה</i> <i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"נמי לא שזהו גמר מלאכמן והוי בישול:\">נמי לא שזהו גמר מלאכתן</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:6\" data-ror-ocr=\"נמי לא שזהו גמר מלאכמן והוי בישול:\">והוי בשול: גמ' כגון</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 145b:7\" data-ror-ocr=\"נמ׳ מאי היא. בא בחמין שחוזרין ושורץ\">מאי - הוי בא בחמין</i>"
