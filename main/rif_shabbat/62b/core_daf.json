      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"2\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 147a:10\" data-ror-ocr=\"זה לרבי אלא שאלו לפניו מהו לצאת כן\">זה לרבי אלא שאלו לפניו מהו לצאת בו</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"3\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 147a:10\" data-ror-ocr=\"ובקש להסיר עד שאמרו לפניו משוס ר׳\">ובקש להתיר עד שאמרו לפניו משום רבי</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"4\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 147a:10\" data-ror-ocr=\"מאיר חייב חטאת ואיהו סבר הואיל ואינה\">מאיר חייב חטאת דאיהו סבר הואיל ואינה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 147a:10\" data-ror-ocr=\"מקופלת על כתיפיי שהרי אחוריה היו צופלין\">מקופלת שהרי אחוריה היו נופלין</i> <i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 147a:10\" data-ror-ocr=\"למטה מכתיפיו אלא שצידיה היו מונחין על\">למטה מן</i>"
      },
      {
