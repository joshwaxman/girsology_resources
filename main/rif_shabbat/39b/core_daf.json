  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "האוחז באמה ומשתין כאילו מביא מבול",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעולם אמר אביי עשאוה כבולשת דתנן (ע\"ז",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ע:) בולשת שנכנסה לעיר בשעת שלום חביות",
