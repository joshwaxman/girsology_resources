    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואיבעית אימא בעתותא דשכינה ואיבעית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אימא שאני רב יהודה דאיכא אימתא דמריה",
