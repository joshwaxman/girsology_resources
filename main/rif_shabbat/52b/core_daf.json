      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ופירש להדיא דהאי ברייתא מיירי בשבת",
      "segment_ids": [
