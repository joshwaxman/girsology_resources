  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> מיי' כתב דבכל יום שיעבור עליו משיגדל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בטל מצות עשה ואינו חייב כרת עד שימות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והוא ערל וכ\"כ סמ\"ג והראב\"ד והטור כתבו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דגם הוא באיסור כרת: <b>ב</b> רבינו ומיי'",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        8,
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וסמ\"ג והרא\"ש והטור כתבו דהיכא שסלק",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ידיו מן המילה שאינו יכול לחזור על",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ציצין שאין מעכבים את המילה והטור יו\"ד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סי' רס\"ו מביא דברי בעל העיטור שכ'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאע\"פ שאינן מעכבים חוזר עליהן ואפי'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פירש ידיו מן המילה ונ\"ל טעמו דס\"ל כיון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דקאמר תלמודא מאן משמע דלית הלכתא הכי.",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומדקאמר תלמודא כאן פי' אינו חוזר משמע",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבחול חוזר אף על ציצין שא\"מ ומן התימה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על מיי' פ\"ב מהל' מילה שכתב גבי דין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מילה שמוהלין בחול שאם פירש וסילק ידיו",
      "segment_ids": [
