      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאסור דבר זה בחול וכן פי' איהו בפי'",
      "segment_ids": [
