      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחרונה והטור יו\"ד סי' רס\"ג נשמר מזה",
      "segment_ids": [
