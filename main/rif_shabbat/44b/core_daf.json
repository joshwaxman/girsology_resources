      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 119a:9\" data-ror-ocr=\"ה׳ לאו שבת קאמר: ונבלהו. אשבת\">ה' לאו אשבת קאי: וכבדתו - אשבת</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 119a:9\" data-ror-ocr=\"מהלר לאי ביום הכפוריס הא כתיב\"><i class=\"ror-printed-only\" data-ror-ocr=\"ביום הכפוריס הא\" data-ror-chars=\"10\">°</i></i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 119a:9\" data-ror-ocr=\"מהלר לאי ביום הכפוריס הא כתיב\">מהדר דאי ביוה\"כ כתיב ביה</i> <i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Shabbat 119a:9\" data-ror-ocr=\"מכובל: להקדים. זמן סעולמ שבת לזמן\">מכובד:</i>"
