  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר פראמי. פירוש פראמי דבר שנותנין על",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפה שלא ינתז ממנו הרוק: גרסינן בפרק",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנודר מן הירק <span class=\"bavli-ref\" data-bavli-ref=\"(דף נה:)\" data-bavli-daf=\"55b\" data-bavli-index=\"0\"></span>תניא יוצאים בשק <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>עבה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>ובסגוס עבה וביריעה ובחמילה מפני הגשמים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרועים יוצאין בשקים ולא הרועים בלבד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרו אלא כל אדם אלא שדברו חכמים בהווה.",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותניא בתוספתא אבל לא בתיבה ולא בקופה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא במחצלת מפני הגשמים. ועוד תניא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתוספתא יוצאין במוך ובספוג שעל גבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המכה ובלבד שלא יכרוך עליהן חוט או",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משיחה. יוצאין בקליפת השום ובקליפת הבצל",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שעל גבי המכה ואם נפל לא יחזיר ואין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צריך לומר שלא יתן לכתחלה בשבת. יוצאין",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באגד שע\"ג המכה וקושרו ומתירו בשבת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אספלנית שפירשה מן האגד מחזירה עם האגד.",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוצאין באספלנית ובמלוגמא וברטיה שעל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גבי המכה ואם נפל לא יחזיר וא\"צ לומר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא יתן לכתחלה בשבת והאי דקתני אם נפל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא יחזיר הוינן בה בגמרא דעירובין <span class=\"bavli-ref\" data-bavli-ref=\"(דף קב.)\" data-bavli-daf=\"102a\" data-bavli-index=\"1\"></span>הלכה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחזירין רטיה בשבת במקדש ותמן ברירנא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לה: <b><big>מתני'</big></b> הבנים יוצאין בקשרים <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>ובני",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלכים בזוגין וכל אדם אלא שדברו חכמים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהווה: <b><big>גמ'</big></b> מאי קשרים אמר אבא מרי אמר",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב נחמיה בר ברוך אמר רב אידי בר אבין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רב יהודה <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>קשרי פאה מאי איריא בנים",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו בנות נמי מאי איריא קטנים אפילו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדולים נמי אלא מאי קשרים כי הא דא\"ר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבין בר חיננא אמר רב חמא בר גוריא בן",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שיש לו געגועין על אביו נוטל רצועה ממנעל של ימין <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>ונותן וקושר לו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בשמאלו: אמר ר' אבין בר רב הונא אמר רב חמא בר גוריא סחופי כסא אטיבורא",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בשבת שפיר דמי. ואמר ר' אבין בר רב הונא אמר רב חמא בר גוריא מותר לסוך",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שמן ומלח בשבת כי הא דרב הונא כי הוה אתי מבי רב ורב מבי רבי חייא ור'",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חייא מבי רבי כי הוו מיבסמי הוו מייתו מילחא ומישחא ושייפא להו לגויתא",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דידייהו <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>ולכרעייהו ואמרי כי היכי דצייל האי מישחא נצייל חמריה דפלניא בר",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "פלניתא: ואמר רבי אבין בר רב הונא אמר רב חמא בר גוריא מותר ליחנק בשבת",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואמר רבי אבין בר רב הונא אמר רב חמא בר גוריא לפופי ינוקא בשבתא שפיר",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דמי: תנו רבנן יוצאין באבן תקומה בשבת משום ר' מאיר אמרו אף במשקל אבן",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תקומה ולא שהפילה אלא שמא תפיל ולא שעיברה אלא שמא תתעברה ותפיל אמר רב",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יימר בר שלמיה משמיה דרב והוא דאיכוין ותקיל <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">מהר\"ם</i> <i class=\"footnote\">מ\"ז</i>לרפואה: <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>(ואמר",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שמואל שמעתי שמציל) אבן מכוונת לא שפחתה ולא הותירה ממשקל אבן תקומה",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כשנשקלה נגדה: והלכה כר' מאיר מדקא מתרצינן אליביה והוא דאיכוין ותקיל",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לרפואה ועוד דאמרינן <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>אמר רב אשי משקל דמשקל מאי מדקא מבעיא ליה משקל",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דמשקל מכלל דכר' מאיר סבירא ליה: <span class=\"bavli-ref\" data-bavli-ref=\"(דף סז.)\" data-bavli-daf=\"67a\" data-bavli-index=\"2\"></span>ובני מלכים בזוגין אוקמה <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בק\"ד</i> <i class=\"footnote\">אבא</i>רבה",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "באריג שבכסותו לדברי הכל: <b><big>מתני'</big></b> יוצאין <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>בביצת החרגול ושן של שועל ומסמר",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הצלוב משום רפואה דברי ר\"מ וחכמים אומרים אף בחול אסור משום דרכי",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "האמורי: <b><big>גמ'</big></b> יוצאין בביצת החרגול דעבדי לשיחלא. פי' רפיון הירך כדתנן",
      "segment_ids": [
        17,
        18,
        19
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<span class=\"bavli-ref\" data-bavli-ref=\"(בכורות דף מ.)\" data-bavli-daf=\"40a\" data-bavli-scope=\"בכורות\" data-bavli-index=\"3\"></span>השחול והכסול אי זהו שחול כל שנשמטה ירכו: ובשן של שועל דעבדי ליה",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לשינתא דחייא למאן דנאים דמיתא למאן דלא נאים: ובמסמר הצלוב דעברי",
      "segment_ids": [
        20,
        21
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לזירפא. פי' זירפא כמו <i data-commentator=\"Hagahot HaBach\" data-label=\"ח\" data-order=\"8\"></i>שריפא וקורין בלשון ערבי אחתרקן ומסמר הצלוב",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מעמידה כדי שלא תוסיף: אביי ורבא דאמרי תרוייהו כל <i data-commentator=\"Tur\" data-label=\"⚬\"></i>דבר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i><sup class=\"footnote-marker\">*</sup><i class=\"footnote\">גי'</i> <i class=\"footnote\">ד\"ת</i> <i class=\"footnote\">שיש</i>",
      "segment_ids": [
        21,
        22
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<i class=\"footnote\">בו</i>שהוא משום רפואה אין בו משום דרכי האמורי הא אין בו משום רפואה יש בו",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "משום דרכי האמורי והתניא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>אילן שמשיר פירותיו סוקרו בסקרא וטוענו באבנים",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "גדולות בשלמא טוענו באבנים גדולות כי היכי דליכחוש חיליה אלא סוקרו",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בסקרא מאי רפואה קא עביד כי היכי דליחזוה אינשי וליבעו עליה רחמי כדתניא",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "(ויקרא י״ג:מ״ה) וטמא טמא יקרא מכאן שצריך להודיע [צערו] לרבים ורבים",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יבקשו עליו רחמים אמר רבינא כמאן תלינן האידנא כובסא בדיקלא כמאן כי האי",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תנא. מאי כובסא כמו נצר כדכתיב (ישעיהו י״א:א׳) ונצר משרשיו יפרה: <b>סליקו</b>",
      "segment_ids": [
        22,
        23,
        24
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<b>להו במה אשה</b>",
      "segment_ids": [
        24
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פירמי.</b> כלי שחוק להבעית הבנים הקטנים: <b>הרועים יוצאין בשקים.</b> מלביש שק שמתכסין בהן בימות הגשמים: <b>אלא כל אדם.</b> דאע\"ג",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלא רגיל ביה: <b>איספלנית.</b> מטלית של בגד שמושחין אותו במשיחה ומשימין אותו על גבי המכה: <b>מתני' בקשרים.</b> מפרש בגמרא:",
      "segment_ids": [
        2,
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ובזוגין.</b> אשקילט\"א של זהב לנוי: <b>גמ' קשרי פאה.</b> שקושרין ממנה קשרים ותולין בצואר לרפואה: <b>מאי איריא בנים.</b> אם איתא",
      "segment_ids": [
        5,
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דרפואת חולים נינהו אפילו בנות נמי: <b>געגועין.</b> מגעגע עליו ואין יכול ליפרד מעליו ורפואה זו לא שייכא בנקבות שאין האב",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחבבן מתחלתן כל כך שיהו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מגעגעות עליו: <b>סחופי כסא.</b> כוס",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש לו הבל כגון שעירה ממנו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חמין וכופהו על הטבור מפני",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחש במעיו ואוחז הכוס את הבשר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומושך את המעיים ומיישבן:",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לסוך שמן.</b> בכפות ידיו ורגליו:",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דרב הונא מבי רב.</b> כשהוא בא",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מביתו של רב שהוא רבו וכן רב",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מבי ר' חייא: <b>מבסמי.</b> שכורין",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואלו מפני שחשובין הן היו",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עושין דבר להפיג יינן:",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לגוויאתא דידייהו.</b> תוך ידיו",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיינו כף: <b>כי היכי דצייל.</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהולך ונעשה צלול כל שעה",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושעה: <b>מותר ליחנק.</b> מי שנפרקה",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוליא של מפרקת צוארו שנפלה",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגרונו תולין אותו בראשו עד",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהא צוארו נפשט ודמי לחניקה:",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לפופי ינוקא.</b> לכרכו בבגדים",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקושרין אותו ברצועה רחבה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומתיישבין פרקי אבריו שהן",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רכין ונשמטין בחבלי הלידה:",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אבן תקומה.</b> אבן ידועה כשהיא",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תלויה על אשה הרה אינה מפלת",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וגם המשקל שכנגד אותהאבן",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תקומה מועיל ומותר לצאת בה",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשבת: <b>ולא שהפילה.</b> ולא תאמר",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא התירו לצאת בה אלא לאשה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיא עלולה להפיל עוברה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהפילה כבר עובר: <b>ולא שעיברה.</b>",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שידוע לה שהיא מעוברת: <b>והוא</b>",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דאיכוין ותקיל.</b> שנמצא מכוון",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החפץ מאליו למשקל האבן: <b>משקל</b>",
      "segment_ids": [
        20,
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשקל מאי ועלתה בתיקו וכל",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תיקו דאיסורא לחומרא: <b>אוקמא</b>",
      "segment_ids": [
        21,
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רבא באריג בכסותו.</b> אבל כל",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היכא דלא ארוג אסור ואפשר",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דטעמא משום דאפי' באיש",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חיישינן למשלף ולאחוויי ודלא",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדברי ר\"ת ז\"ל אי נמי משום",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאיכא למיחש דלמא מחייכי ביה",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואתי למשלף: <b>מתני' יוצאין</b>",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בביצת החרגול ובשן של שועל.</b>",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמרא מפרש למאי עבדי להו:",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>משום דרכי האמורי.</b> וכתיב",
      "segment_ids": [
        24
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובחוקותיהם לא תלכו: <b>גמ'</b>",
      "segment_ids": [
        24,
        25
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לשינתא.</b> יש שנושאו כדי שיישן",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויש שנושאו שלא יישן: <b>דחייא.</b>",
      "segment_ids": [
        25,
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של שועל חי: <b>זירפא.</b> נפח מכה:",
      "segment_ids": [
        26,
        27
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כל דבר שיש בו משום רפואה.</b>",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין לחש בין כל דבר כיון שאנו",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יודעין שהוא מרפא והכי מוכח",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתוס' ואפשר דאף לחשין שאין",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אנו יודעין אם יש בהן משום",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רפואה מותרים מספק ולא אסרו",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא אותם שבדקו ואין מועילין",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכתב הרשב\"א ז\"ל שכן נראה",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שפירשו בתוס' אלא שראיתי",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להר\"ר יונה ז\"ל שחשש בכל קמיע",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו מן המומחה משום דרכי",
      "segment_ids": [
        28
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האמורי: <b>דליכחוש חיליה.</b> ע\"י",
      "segment_ids": [
        28,
        29
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא שמן וכחו רב פירותיו",
      "segment_ids": [
        29
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נושרין: <b>דליחזיוה אינשי.</b>",
      "segment_ids": [
        29,
        30
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולסימנא עבדי ליה לאודועי",
      "segment_ids": [
        30
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמשיר פירותיו: <b>טמא</b> טמא הוא",
      "segment_ids": [
        30,
        31
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו אומר טמא שירחקו מעליו:",
      "segment_ids": [
        31
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כובסא.</b> אשכול תמרים וסימן הוא שמשיר פירותיו: <b>סליקו להו במה אשה כלל גדול.</b> בגמרא [דף סח.] מפרש דמשום הכי קרי ליה",
      "segment_ids": [
        32,
        33
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלל גדול משום דגדול עונשה של שבת משל שביעית:",
      "segment_ids": [
        33
      ]
    }
  ],
