      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוחנן סבירא ליה הכי ורבא נמי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהוא בתרא הכי סבירא ליה ועוד",
