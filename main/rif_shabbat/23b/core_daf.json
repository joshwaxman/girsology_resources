    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון שטמנן שלא כדרך זריעה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל לענין ניטלין בשבת על",
      "segment_ids": [
