        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעמא בריש ביצה גבי ביצה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנולדה בשבת שבת דעלמא תשתרי",
