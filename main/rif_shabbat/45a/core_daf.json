      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 120a:5\" data-ror-ocr=\"לו מבית בראש גגו מביא כלי ומניח\">כלי ומניח</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 120a:5\" data-ror-ocr=\"תחתיה ודרש רב שיזבי לרב חסלא ובלבד\">תחתיה ודרש רב שיזבי לרב</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 120a:5\" data-ror-ocr=\"תחתיה ודרש רב שיזבי לרב חסלא ובלבד\">חסדא ובלבד</i> <i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Shabbat 120a:5\" data-ror-ocr=\"שלא יביא כלי המחזיק יותר מג׳ סעודות.\">שלא יתן כלי המחזיק יותר</i>"
