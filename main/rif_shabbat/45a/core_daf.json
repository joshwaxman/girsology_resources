  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "חצר כאן לחצר אחרת והלכתא כרב הונא: בעי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב הונא בריה דרב יהושע פירש טליתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וקיפל והניח וקיפל והניח מאי כבא להציל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמי או כבא לקפל דמי מדאמר רבא אטעייה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>רב שזבי לרב חסדא ודרש ובלבד שלא יביא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלי מחזיק יותר מג' סעודות ש\"מ כבא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להציל דמי ושפיר דמי: א\"ל ר\"נ בר יצחק",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרבא מאי טעותא א\"ל דתנן ובלבד שלא יביא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלי אחר ויקלוט כלי אחר ויצרף כלי אחר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא דלא אבל בההוא מנא כמה דבעי מציל:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואומר לאחרים בואו והצילו לכם וכו':",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חשבון מאי עבידתיה נימרו ליה מהפקירא קא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זכינא אמר רבא הכא בירא שמים עסקינן דלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ניחא ליה דליתהני מאחרים ובחנם נמי לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ניחא ליה דליטרח וה\"ק אם היו פקחים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דידעי דכי האי גונא לאו שכר שבת הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושין עמו חשבון לאחר השבת: <b><big>מתני'</big></b> ולשם",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא מוציא כל כלי תשמישו ולובש כל מה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהוא יכול ללבוש ועוטף כל מה שהוא יכול",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעטוף ר' יוסי אומר י\"ח כלים וחוזר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולובש ומוציא ואומר לאחרים בואו והצילו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עמי: והלכתא כת\"ק: <b><big>(מתני')</big></b> <i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>ר\"ש בן ננס",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר פורסין עור של גדי ע\"ג שידה תיבה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומגדל שאחז בהן האור מפני שהוא מחרך",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ועושין מחיצה בכל הכלים בין מלאים בין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ריקנים בשביל שלא תעבור הדליקה ר' יוסי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אוסר בכלי חרס חדשים מלאים מים שהן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתבקעין ומכבין את הדליקה מפני שאינן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "יכולין לקבל האור: <b><big>גמ'</big></b> ולית הלכתא כר' יוסי דקסבר גרם כיבוי אסור: <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>אמר",
      "segment_ids": [
        5,
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "רב יהודה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>טלית שאחז בה האור פושטה ומתכסה בה ואם <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>כבתה כבתה וכן ס\"ת שאחז",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בו האור פושטו וקורא בו ואם כבה כבה: <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכ:)\" data-bavli-daf=\"120b\" data-bavli-index=\"0\"></span>ת\"ר <i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>נר שע\"ג טבלא מנער את הטבלא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "והיא נופלת מאליה ואם כבתה כבתה אמרי דבי ר' ינאי לא שנו אלא בשוכח אבל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "במניח נעשה בסיס לדבר האסור ונר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>שאחורי <i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>הדלת <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>אסור לפתוח ולנעול כדרכה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דאביי ורבא דאמרי תרוייהו מודה ר\"ש בפסיק רישיה ולא ימות ואסור לפתוח",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הדלת כנגד המדורה בשבת ואפילו ברוח מצויה: <b><big>מתני'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכא.)\" data-bavli-daf=\"121a\" data-bavli-index=\"1\"></span>נכרי שבא <i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>לכבות אין",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>אומרים לו כבה ואל תכבה מפני",
      "segment_ids": [
        9
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פירש טליתו וקפל והניח.</b> שהביא אוכלין והניח וחזר והביא והניח מאי: <b>כבא להציל דמי.</b> הואיל שבפעם אחת הוציא הכל: <b>או</b>",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כבא לקפל דמי.</b> הואיל וטורח לאסוף ולכנוס: <b>אטעייה רב שיזבי לרב חסדא.</b> עד שדרש לפניו והודה רב חסדא בהא מתני' דאמרן",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לעיל [דף קיד.] נשברה לו חבית בראש גגו מביא כלי ומניח תחתיה ודרש רב שיזבי לרב חסדא. ובלבד שלא יביא כלי שמחזיק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יותר ממזון שלש סעודות והודה לו רב חסדא ומדאמר רבא אטעייה ש\"מ טעות הוא דאפילו מחזיק סעודות הרבה מותר כיון דחד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מנא הוא והאי כמקפל ונותן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלי אחד דמי דהא מעט מעט הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמטפטף בו ש\"מ בחד מנא כבא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להציל דמי: <b>מאי טעותא.</b> מנא לך",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דטעותא הוא בידיה: <b>מדקתני בה</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בברייתא ובלבד שלא יביא כלי</b>",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אחר.</b> ש\"מ כלים טובא הוא דקא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסר אבלבחד שפיר דמי: <b>הלכך</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקטינן דפירס טליתו וקפל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והניח כבא להציל דמי [וש\"ד]",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונראה מדברי רבותינו בעלי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התוס' ז\"ל שאפילו קפל והניח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלים הרבה תוך כלי אחד כבא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להציל דמי ושרי אבל מדברי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רש\"י ז\"ל נראה דדוקא כששופך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מה שבאותן הכלים לתוך כלי אחד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא דשרי אבל במוציא כלים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרבה אע\"פ שהן מקופלין בתוך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלי אחד כבא [לקפל] דמי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואסור: <b>חשבון מאי עבידתיה</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מהפקרא קא זכו.</b> פרש\"י ז\"ל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהכי הוה ליה למתני דאם היו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פקחין יעכבו הכל לעצמן דהא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמר להן בואו והצילו לכם",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר לעצמכם ואין צריך לכך",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאפי' לא אמר להו הכי כיון",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא אינו רשאי להציל הרי הוא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מופקר לכל מידי דהוה אמציל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מזוטו של ים ומשלילותו של נהר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(ב\"מ דף כא:) והא דנקט ואומר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאחרים רבותא נקט שאע\"פ שאומר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להם כן על דעת שיצילו [לו]",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא יעכבו לעצמן שרי: <b>הכא</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בירא שמים עסקינן דלא ניחא</b>",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לי' דליתהני מאחריני.</b> בזכייה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהפקרא דידע דשלא ברצונו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפקירו: <b>ובחנם נמי לא ניחא</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ליה דליטרח.</b> דלאו חסיד הוא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למחול על שלו והכי קאמר וכו'",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר והאי אם היו פקחין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמתניתין לאו פקחין בדין קאמר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליטול את הראוי להם דאם כן",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יעכבו את הכל הוה ליה למתני אלא הכי קאמר הני יראי שמים אי פקחין הן בהלכות שבת דידעי דכה\"ג לאו שכר שבת הוא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמעיקרא לאו אדעתא דאגר פועלים נחתי עושין עמו חשבון ובגמ' מוכח דחסידים אפילו האי אגרא לא שקלי דאע\"ג דלאו שכר שבת",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גמור הוא שהרי לא התנה עמו ומהפקירא קא זכו אפ\"ה חסידים יש להם לוותר משלהם בכל נדנוד עבירה: <b>מתני' ולשם הוא מוציא.</b>",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לחצר המעורבת דתנן לעיל: <b>כל כלי תשמישו.</b> שצריכין לו באותו היום: <b>שמונה עשר כלים.</b> בגמ' מפרש להו: <b>וחוזר ולובש</b>",
      "segment_ids": [
        10,
        11,
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ומוציא.</b> הא דלא שרינן הכי באוכלין ומשקין משום דהתם כיון דבידו הוא מוציא מתוך שאדם בהול על ממונו אי (לא) שרינן",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ליה אתי לכבויי אבל הכא כיון שאין אתה מתירו אלא דרך לבישה רמי אנפשיה ומדכר: <b>וטעמיה</b> דרבי יוסי דאמר דדוקא שמונה",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עשר כלים אבל טפי לא לפי שאין דרך בני אדם ללבוש יותר מאלו ואי לביש טפי ונפיק בהו לרה\"ר הוי משוי ומשום הכי אפילו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לחצר המעורבת אסור משום דכיון דמטריד חיישינן דלמא נפיק בהו לרה\"ר ואפשר דעד כאן לא פליגי רבנן עליה אלא משום דכיון",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאינו מציל אלא ברה\"י לא חיישינן להכי אבל היכא דנפיק בהו לרשות הרבים מודו דאסור משום משוי ולפי זה אסור לצאת",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ברה\"ר במלבושין [הרבה] שאין דרך לישא אותן כאחד: <b>רבי שמעון בן ננס אומר פורסין עור של גדי.</b> לח: <b>מפני שהוא מחרך.</b>",
      "segment_ids": [
        14,
        15,
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כווץ ואינו נשרף ומתוך כך הוא מגין על התיבה: <b>בין מלאין.</b> מים: <b>שאין</b> יכולים לקבל כח חום האור מפני שחדשות הם וקי\"ל",
      "segment_ids": [
        16,
        17,
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כר' שמעון בן ננס דס\"ל דגרם כיבוי שרי ודלא כר' יוסי: <b>גמ' טלית שאחז בה האור פושטה ומתכסה בה ואם כבתה כבתה.</b> יש",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לתמוה על הרב אלפסי ז\"ל דבגמרא הכי גרסינן [דף קכ.] אמר רב יהודה טלית שאחז בה האור נותן עליה מים מצד אחר ואם כבתה",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כבתה ומקשינן עלה מדתניא טלית שאחז בה האור פושטה ומתכסה בה ואם כבתה כבתה כלומר דמשמע דדוקא כה\"ג הוא דשרי אבל",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נותן עליה מים לא ומפרקינן דהוא דאמר כבן ננס דס\"ל דגרם כיבוי שרי וכיון דקי\"ל כרבי שמעון בן ננס משמע דנקטינן טעמא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נמי כרב יהודה והיה לו לרב אלפסי ז\"ל להביאה בהלכותיו. ואפשר שהרב אלפסי ז\"ל מדמה <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i><i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>לההיא דתניא בפ' כירה (דף מז:)",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גבי נותנים כלי תחת הנר לקבל ניצוצות ולא יתן לתוכו מים מפני שהוא מכבה דסברינן התם מעיקרא דדוקא כרבי יוסי אתי אבל",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לרבנן שרי כי היכי דשרו בגרם כיבוי ורב אשי דחי לה התם ואמר (רבא) דבההיא אפילו רבנן מודו מפני שהוא מקרב כיבוי",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר והוי טפי מגורס כיבוי ולפי דעת הרב אלפסי ז\"ל <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>דרב יהודה ס\"ל אליבא דרבי שמעון בן ננס דכי היכי דשרי בגורם",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כיבוי שרי נמי במקרב כיבוי כדהוה סלקא דעתא מעיקרא בסוף פ' כירה ומשו\"ה שרי ליתן מים מצד <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>אחד אע\"פ שהוא מקרב את",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כבויו אבל לדידן דסבירא לן כרב אשי דאע\"ג דגורם שרי מקרב אסור לא קיימא לן כרב יהודה דבכה\"ג <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>דגורס נמי מקרב כיבוי",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מקרי כך תירץ הראב\"ד והרמב\"ן ז\"ל להעמיד דברי הרב אלפסי ז\"ל ויש לזה הוכחה מן הירושלמי ואעפ\"כ כיון דלא אשכחן בגמרא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דילן מאן דפליג עליה דרב יהודה בהדיא מנקט כותיה טפי עדיף ולומר שאף כיוצא בזה אינו אלא גורם ולא מקרב <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>וכן הסכמת",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הרמב\"ן ז\"ל וכן פסק הרמב\"ם ז\"ל בפרק י\"ב מהלכות שבת: <b>תנו רבנן נר שעל גבי הטבלא מנער הטבלא והיא נופלת.</b> פירוש דוקא",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בנר של חלב או של שעוה דאילו בנר של שמן כיון שאי אפשר שלא ישפך מן השמן וקיימא לן (ביצה דף כב.) דהמסתפק מן השמן",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שבנר חייב משום מכבה פסיק רישיה הוא ואסור דהא אי אפשר בלא כיבוי: <b>לא שנו אלא בשוכח.</b> ששכחו מבעוד יום על הטבלא שלא",
      "segment_ids": [
        20,
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מדעת אבל במניח נעשה טבלא בסיס לדבר האסור ואסור לטלטלה כדי לנערה: <b>מתני' נכרי שבא לכבות אין אומרים לו כבה.</b> משום",
      "segment_ids": [
        21,
        22
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דרבנן גזור על האמירה לנכרי משום שבות: <b>ואל תכבה.</b> אין צריך למחות בידו אלא יניחנו ויכבה מפני שאין שביתת נכרי עליהן",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דישראל אין מוזהרין על שביתת הנכרי שאינו עבדו:",
      "segment_ids": [
        23
      ]
    }
  ],
