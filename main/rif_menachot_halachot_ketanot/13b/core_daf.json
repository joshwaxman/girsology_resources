  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "והלכה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>כב\"ה א\"ר אלעזר <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>והלא כל המטיל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תכלת לסדינו בירושלים אינו אלא מן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המתמיהין <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>ומסקנא <span class=\"bavli-ref\" data-bavli-ref=\"(דף מ:)\" data-bavli-daf=\"40b\" data-bavli-index=\"0\"></span>אמר רבה הא מילתא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמריתה אנא קמיה דשמואל ואיתמר משמיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דר' זירא במערבא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>כוותיה משמיה דר' יוסי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גזרה שמא יקרע סדינו בתוך שלש ויתפרנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והתורה אמרה תעשה ולא מן העשוי שרייה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי זירא לסדיניה רבה אמר גזירה נמי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום כסות לילה: <i data-commentator=\"Mishneh Torah, Fringes\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>והאידנא דלית לן תכלת",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רמינן ליה לסדין ציצית ממיניה ושפיר דמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמרי' <span class=\"bavli-ref\" data-bavli-ref=\"(דף לט:)\" data-bavli-daf=\"39b\" data-bavli-index=\"1\"></span>איבעיא להו של פשתן מהו שיפטור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של צמר צמר בפשתים אמר רחמנא הוא דפטור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכיון דתכלת פטרא לבן נמי פטר אבל פשתים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לצמר לא או דילמא (דברים כ״ב:י״א) לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלבש שעטנז צמר ופשתים אמר רחמנא (דברים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כ״ב:י״א-י״ב) גדילים תעשה לך מהם ל\"ש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צמר לפשתים ול\"ש פשתים לצמר ת\"ש דאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רחבה אמר רב יהודה חוטי צמר פוטרין בשל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פשתן וחוטי פשתן פוטרין בשל צמר חוטי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צמר ופשתים פוטרין בכל מקום ואפי'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשירין ופליגא דרב נחמן דאמר שירין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פטורין מן הציצית הא למדת <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>שחוטי פשתן",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פוטרין בטלית של <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">כ\"ה</i> <i class=\"footnote\">בס\"י</i> <i class=\"footnote\">וכ\"ה</i>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">ברא\"ש</i>[פשתן] <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">גי'</i> <i class=\"footnote\">ד\"ת</i>[צמר] ומהא נמי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעי' דחוטי פשתן פוטרין בשל פשתן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמרי' <span class=\"bavli-ref\" data-bavli-ref=\"(דף מ.)\" data-bavli-daf=\"40a\" data-bavli-index=\"2\"></span>א\"ר אלעזר והלא כל המטיל תכלת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לסדינו בירושלים אינו אלא מן המתמיהין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ופרקינן אלא גזרה משום קלא אילן ואקשינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא יהא אלא לבן בעלמא הלא הצמר הלבן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "פוטר בפשתים במצות לבן ופרקינן ה\"מ היכא דליכא מיניה אבל היכא דאיכא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מיניה לא כלומר לא פטרינן ליה בצמר אלא בפשתים דהוה מיניה כדרשב\"ל דאמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רשב\"ל כל מקום שאתה מוצא עשה ולא תעשה אם אתה יכול לקיים את שניהם מוטב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואם לאו יבא עשה וידחה לא תעשה וכיון דאיכא פשתים לפשתים דמקיים עשה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בגויה לא דחינן ליה ללא תעשה ועבדינן צמר לצמר ופשתן לפשתן וחזינן למקצת",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רבואתא דאסרי למרמי חוטי פשתים בטלית של פשתים ואיתלו להו בהא דאמרי'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "סלקא דעתך אמינא כדרבא דרבא רמי כתיב (במדבר טו) הכנף מין כנף וכתיב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "(דברים כ״ב:י״א-י״ב) לא תלבש שעטנז צמר ופשתים יחדו גדילים תעשה לך הא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כיצד צמר ופשתים פוטרין בין במינן בין שלא במינן שאר מינים במינן פוטרין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שלא במינן אין פוטרין וקאמרי מדקאמר <span class=\"bavli-ref\" data-bavli-ref=\"(דף לט:)\" data-bavli-daf=\"39b\" data-bavli-index=\"3\"></span>סלקא דעתך אמינא כדרבא מכלל דלית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הלכתא כרבא דפטר בפשתן אלא צמר בלחוד הוא דפטר וקא אסרי ציצית דכיתנא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בסדינא ומינייהו מאן דמחייב ליה מלקות והני רבואתא דסבירא להו הכי לא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דייקי בשמעתא ולא ידעי מאי קאמרי רבנן <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>ומיהא שמעתא דאסרי ליה לכיתנא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בסדינא מינה גופא גמרינן דעבדינן כיתנא בסדינא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">צ\"ל</i> <i class=\"footnote\">רבי</i> <i class=\"footnote\">וכ\"ה</i> <i class=\"footnote\">בד\"ס</i>דהכי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אמרינן בגמרא סד\"א (<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת</i> <i class=\"footnote\">מוחק</i> <i class=\"footnote\">כל</i> <i class=\"footnote\">זה</i>כדרבא לאו אצמר ופשתים במינן פוטרין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "קיימינן אלא אפוטרין שלא במינן קיימינן <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>דשמע מינה קסבר רבא בשאר מינין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כגון שירין וכלך וכיוצא בהן חייבת בציצית מדאורייתא) <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>כי דוקיא דרבא דאמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רבא",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דציצית חובה הוא לבגד ואפילו אינו לובשה. ולב\"ש נמי אסור לעשות לבן של פשתן ותכלת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "של צמר אלא הלבן והתכלת של צמר ולב\"ה מותר. והא דנקט פלוגתא בסדין דפסיקא ליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מילתא שאין בו ציצית בלא כלאים שעיקר המצוה היא תכלת ותכלת עמרא הוא. משמע לפי'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דסדין חייב במינו וכן פירש בתשובה וכ\"פ רבי' יצחק דר' יהודה ז\"ל. והא דשרא ר'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זירא לסדיניה. תכלת היתה בו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומלאכא דף מא. דאמר לרב קטינא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סדינא בקייטא ציצית מה תהא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליה. אעיקר מצות ציצית קפיד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיינו תכלת. וקשה לפירושו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא דמבעיא לן אי ציצית חובת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גברא הוא או חובת טלית תפשוט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהכא דחובת טלית הוא (ס\"א הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלישנא דב\"ש דנקיט פטורים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דגם) דגם בית הלל לא פליגי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אב\"ש בסברא זו. (ס\"א ועוד)",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונראה דבה\"ג פוסק דחובת גברא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא מדמברכינן להתעטף בציצית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדדייקינן שבת דף כג. גבי נר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חנוכה דהדלקה עושה מצוה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדמברכינן להדליק דאי הנחה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עושה מצוה ה\"ל לברוכי להניח.",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"נ אי חובת טלית הוא ה\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לברוכי לעשות ציצית. ועוד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקשה ר\"ת ז\"ל דבריש יבמות אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו מ\"ד דלא דריש סמוכין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלמא במשנה תורה דרש. ובסדר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רב עמרם חשיב ו' דברים דהלכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כב\"ש והך חדא מינייהו ובכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוכתי קי\"ל דעשה דוחה לא תעשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
