      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והשלימה לד' פסולה משום תעשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא מן העשוי. דג' הראשונות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נעשו שלא כמצותן וכי הדר מתקן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להו אפסול דתעשה ולא מן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העשוי. א\"ר זירא הטיל למוטלת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשירה. פירש\"י שהיה לה ד'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ציציות והטיל לה ארבע (ס\"א ד'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחרים) כשרים בהני בתראי אי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסקינהו לקמאי ואף על גב דהנך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאו לצורך עבדינהו בשעת עשיה",
