        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישמעאל (ס\"א ר\"י הא איכא תנא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבי ר' ישמעאל אחר) אחר דסבר",
      "segment_ids": [
