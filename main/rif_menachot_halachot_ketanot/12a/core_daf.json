    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ציצית אינה צריכה ברכה קסבר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חובת גברא והויא. מצוה",
      "segment_ids": [
