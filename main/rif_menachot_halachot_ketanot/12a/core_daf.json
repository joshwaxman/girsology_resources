        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גורר אדם מטה כסא וספסל ובלבד שלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יתכוין לעשות חריץ: תנו <i data-commentator=\"Mishneh Torah, Fringes\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>רבנן כמה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>חוטין",
      "segment_ids": [
        3,
        4
      ]
