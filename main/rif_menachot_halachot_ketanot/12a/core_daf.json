      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארבע ורב יהודה אמר שלשה בתוך שלש",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומשולשת ארבע אמר רב פפא הלכתא ארבע",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתוך שלש ומשולשת ארבע פירוש ארבעה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוטין בתוך שלש אצבעות בטלית ומשולשת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הציצית ארבע <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>אצבעות למימרא דאיכא שיעורא",
      "segment_ids": [
        5
      ]
    },
