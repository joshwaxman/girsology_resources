    {
      "width": "380px",
      "right": "275px",
      "text": "נותן בית שמאי אומרים ארבעה וב\"ה אומרים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלשה וכמה תהא משולשת ב\"ש אומרים ארבע",
