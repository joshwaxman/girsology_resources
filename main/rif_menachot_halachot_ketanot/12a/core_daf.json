        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צריך לברך משעת עשייתה כמו המילה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שעשייתה גמר מלאכתה וצריך לברך: והלכתא",
