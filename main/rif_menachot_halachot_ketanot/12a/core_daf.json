      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וב\"ה אומרים שלש ושלש שאמרו ב\"ה אחת מד'",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לטפח של כל אדם: אמר רב פפא טפח",
