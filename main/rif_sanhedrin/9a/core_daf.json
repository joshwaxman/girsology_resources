      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דתנן אפי' שנים מזכין או מחייבין וא'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אומר איני יודע יוסיפו הדיינים וכן אם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נסתלק הא' אין יכולין לחתוך השנים את",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הדין וכמו שאמרו בפירקין מיכתב היכי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתבי וכו' ודברים פשוטים הן לענין הדין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וה\"ה לענין פשרה דמאי שנא: ועל השואל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לדיינים שיכתבו לו מאיזה טעם דנוהו השיב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרב דאינן חייבים שאם לא התנו עם הבעל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דין שיכתוב לו טעם הדבר או שיהיה במקום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חשד וכמעשה דרב פפא (דפ\"ק) [דפ\"ה]",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דמציעא דאמר כגון הא ודאי צריך לאודעי:",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ב</b> ועוד השיב על ב\"ד שנתנו זמן לראובן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להביא ראיותיו ועבר הזמן וכשרצו ב\"ד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לפסוק את הדין טען ראובן שנתן זכותו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ללוי ואין פוסקין הדין אלא בפניו ואין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חבין והשיב דכבר ידוע שאין הלכה כרשב\"ג",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לפיכך בין ראובן בין לוי מקבל מתנתו כל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זמן שמביאין ראיה סותרים הדין ולפסוק",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הדין ע\"פ הטענות הראשונות שלא בפני לוי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מסתברא שכל זמן שלוי בעיר או במקום קרוב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שולחין לו אם בא וטען והביא ראיה מיד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שומעין לו ואם לא בא או שבא ואמר תנו לי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זמן אין שומעין לו דלא עדיף מגברא דאתי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחמתיה אלא פוסקין את הדין שלא בפניו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואע\"פ שנחלקו ר' יעקב ורבנן בשלהי שנגח",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ד' וה' גבי שור היוצא ליסקל וקי\"ל דאין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גומרין אלא בפניו דומיא דבעלים אע\"ג",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דלאו בר טענתא הוא משום דגזירת הכתוב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא אבל בממונא דעלמא מה איכפת לן דהא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כל זמן שמביא ראיה סותר הדין הלכך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חותכין דינו היום ושומעין דינו למחר אם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יביא ראיה לסתור את הדין וכן דעת בעל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העיטור וכ\"כ בקבלת העדות: ואפי' אמר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התובע לדיינים הרי עדי לפניכם אלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאינכם רוצים לקבלם מפני שאין מקבלים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עדות שלא בפני בעל דין לכל הפחות קחו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממון הקטנים בידיכם שלא יכלוהו הקטנים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא יהיה להם מה לפרוע לכשיגדילו אין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שומעין לו וכן דעת הרא\"ש והטור ח\"מ סי'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כ\"ח: צ\"ע מאי שנא דהכא אין שומעין לו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומ\"ש דגבי הבא לב\"ד ואמר יש לי עדים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שפלוני חייב לי מעות ומצאתי מממונו וירא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אני שמא יבריח אותו ולא יהיה לי מקום",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לגבות חובי דשומעין לו אם רואין אמתלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בדבריו: ואדרבה היה נראה דכ\"ש הכא גבי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קבלת עדות היה לב\"ד לשמוע לו דהתם אפי'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין לו ראיות ועדים מזומנין שומעין לו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כ\"ש הכא שהעדים לפנינו דהיה לנו לשמוע",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו ואין סברא לומר דדוקא גבי קטנים אין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שומעין לו אבל איניש דעלמא שעדיו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מזומנין אלא שאין הבע\"ד לפנינו שומעין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו דזה אינו דהא כל עצמו דדינו דקטן לא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אתיא אלא מדין אין מקבלין עדות שלא בפני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בע\"ד ולא עדיף הבא מן הדין מן הנדון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וצ\"ע:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    }
