        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהיו מתעצמין בדין ובררו להם י' אנשים",
      "segment_ids": [
