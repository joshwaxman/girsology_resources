        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בנפשיה דחייב אלא מיטרח ואגיר אגירי נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייב: תנו רבנן אחד הרודף אחר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">גי'</i>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">הספרי</i> <i class=\"footnote\">אחד</i> <i class=\"footnote\">חבירו</i> <i class=\"footnote\">[להורגו]</i>עבירה ואחר",
