      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "א' שפסק דין א' שבא לפניו וטעה בו והורה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנתן ממון למי שלא היה לו ראוי מן הדין",
      "segment_ids": [
