    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרי\"ף גבי עובדא דאריסין דבר זיזא דדיין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
