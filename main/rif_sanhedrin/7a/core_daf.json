  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "וחתנו דגיסו דלאו מן אחות אשתו פליגי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאילו בן גיסו שאינו בן אחות אשתו לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צריכא למימר דהא בעל אמו ובעל אחותו",
      "segment_ids": [
