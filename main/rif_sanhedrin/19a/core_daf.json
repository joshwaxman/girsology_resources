  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> מה שכתב רבינו ירוחם בספר אדם וחוה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנתיב א' חלק ד' וז\"ל דכשלא עשה האב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תשובה דהבן נעשה שליח ב\"ד להכותו ולקללו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואמרת מנין לו. דבר זה צ\"ע דהא איתא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בהדיא פרק הנחנקין דאין הבן נעשה שליח",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאב להכותו ולקללו ומשמע שם אפי' לא עשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תשובה וכן פסקו כל הפוסקים ותו יש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להקשות מדידיה אדידיה דלעיל בזה החלק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עצמו גבי בנו מאנוסתו כתב ואפי' לא עשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אביו תשובה ואינו עושה מעשה עמך אפי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחטא חייב על הכאתו ועל קללתו יש בו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "איסור כדאיתא בסנהדרין פ' הנחנקין דאינו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נעשה הבן שליח לאביו לקללו ולהכותו עכ\"ל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וי\"ל דס\"ל לרבי' דההיא אוקימת' דאוקים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רב ששת התם פ' הנחנקין ההוא דבנו חייב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משום שעשה אביו תשובה הויא אוקימתא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מעלייתא ומש\"ה הבן המכה אביו לאחר שעשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תשובה ואינו שליח ב\"ד חייב על הכאתו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומינה אתה שומע דבעיא דבעו מיניה מרב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ששת אם הבן נעשה שליח מיירי כשעשה תשובה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והכרח הוא לומר כן דמיירי הבעיא כשעשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תשובה דהא שמעת ליה לרב ששת דס\"ל דכל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלא עשה תשובה קרי כאן ונשיא בעמך לא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תאור ואפי' בלא שליחות ב\"ד ס\"ל לרב ששת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ופשיטא ליה דיכול להכותו: והא כי אקשי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ליה התם אי הכי בנו נמי כלומר אי הכי",
