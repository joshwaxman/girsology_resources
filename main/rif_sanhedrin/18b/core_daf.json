    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא היה בה כדי <i data-commentator=\"Hagahot HaBach\" data-label=\"מ\" data-order=\"13\"></i>להמית על",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
