      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לכשנגדו: עוד שאלה לו ששאלת האומר",
      "segment_ids": [
