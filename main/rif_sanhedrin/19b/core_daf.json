      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל כל המונע הלכה מפי תלמיד כאילו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גוזלו מנחלת אבותיו שנאמר (דברים לג)",
