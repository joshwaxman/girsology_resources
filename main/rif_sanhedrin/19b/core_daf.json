        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורה צוה לנו משה מורשה קהלת יעקב מורשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היא להן מאבותיהן מששת ימי בראשית אמר",
