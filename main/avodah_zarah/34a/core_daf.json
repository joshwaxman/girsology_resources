  "steinsaltz_sugyot": [
    {
      "id": 144,
      "sentence_id": 5,
      "line_number": 19,
      "label": "א"
    }
  ],
  "tosafot": [
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "<big><b>שֶׁאֵינוֹ.</b></big> תימה נהדרינהו לכבשונות כדאמר פ' דם חטאת בזבחים (דף צו. ושם ד\"ה אלא) גבי כלי חרס של",
      "source_ref": "Tosafot on Avodah Zarah 34a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "870px",
      "right": "",
      "left": "",
      "text": "מקדש ומשני לפי שאין עושין כבשונות בירושלים הא לאו הכי ע\"י החזרה בכבשן יוצא! ואור\"ת דאין זה נחשב יוצא דאדרבה",
      "source_ref": "Tosafot on Avodah Zarah 34a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "כלי אחר חשבינן ופנים חדשות באו לכאן! וא\"ת כיון דחשיב כלי אחר א\"כ תנור וכירים יותץ דאמר רחמנא למה ליהדרינהו בכבשונות!",
      "source_ref": "Tosafot on Avodah Zarah 34a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "ואומר ר' שמשון משנ\"ץ דודאי גבי קדרות של חרס דאין דרכן בהיסק כי מחזיר להו בכבשן שייך למימר אלו אחרים הם אבל תנור וכירים",
      "source_ref": "Tosafot on Avodah Zarah 34a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "שאיסורן בא ע\"י היסק אין יוצא",
      "source_ref": "Tosafot on Avodah Zarah 34a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "בהחזרת אותן לכבשן ולא נקרא כלי",
      "source_ref": "Tosafot on Avodah Zarah 34a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "אחר. <big><b><span class=\"dh-divergent\">ר&quot;ע</span>.</b></big>",
      "source_ref": "Tosafot on Avodah Zarah 34a:2:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "פרש\"י בפרק קמא דתענית (<a href=\"/taanit/11b\">דף יא:</a>)",
      "source_ref": "Tosafot on Avodah Zarah 34a:2:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "דגרס מר עוקבא דחס ושלום שר\"ע",
      "source_ref": "Tosafot on Avodah Zarah 34a:2:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "לא היה מסתפק. ועוד כי היה לו",
      "source_ref": "Tosafot on Avodah Zarah 34a:2:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "לתלמוד להביאה בלשון ברייתא. מיהו",
      "source_ref": "Tosafot on Avodah Zarah 34a:2:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "הא לא קשיא דהרבה מקומות מצינו",
      "source_ref": "Tosafot on Avodah Zarah 34a:2:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "שמזכיר מעשה בר\"ע וכיוצא בו.",
      "source_ref": "Tosafot on Avodah Zarah 34a:2:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "<big><b>מִתְעַנִּין לְשָׁעוֹת.</b></big> פ\"ה כגון שקבל",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "180px",
      "right": "",
      "left": "",
      "text": "עליו תענית משש שעות",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "ולמעלה אכן לא טעם כלום בו' שעות",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "ראשונות אך לא לשם תענית נתכוין.",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "וכן משמע בפ\"ק דתענית (<a href=\"/taanit/11b\">דף יא:</a>)",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "על הך דמייתי התם דקאמר הא",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "דאמרת מתענין לשעות הוא שלא",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "טעם כלום כל אותו היום ופריך",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "הא תענית מעליותא היא ומסיק לא",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "צריכא דאימלך אימלוכי? וצ\"ל דמיירי",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "נמי שקבל עליו מאתמול שאם לא",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "יאכל למחר עד חצי היום יהיה בתענית",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "עד שתחשך דאי לא קבליה כלל הא",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "אמר שמואל בפ\"ק דתענית (<a href=\"/taanit/12a\">דף יב.</a>)",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "כל תענית שלא קבל עליו מבעוד יום",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "לא שמיה תענית ואי יתיב דמי",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "למפוחא דמלי זיקא. ואין לפרש",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "דשמואל אמר למילתיה לענין תפלת",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "תענית אבל לענין תענית אפי'",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "אכל מ\"מ עלתה לו תענית דהא בהא",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "תליא כדמסיק הכא הלכה מתענין",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "",
      "text": "לשעות והמתענה מתפלל תפלת",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "תענית. א\"נ איכא למימר דמיירי נמי בדלא קבלה מאתמול כדמשמע לשון אימלך אימלוכי. והא דבעי שמואל קבלה היינו לכתחלה ואי",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "יתיב דמי למפוחא היינו שאינו מקבל עליו שכר תענית אלא נקרא חוטא על שציער עצמו ומ\"מ נדרו נדר. ובירושלמי דנדרים פ' קונם",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "מפרש מתענין לשעות שאם אכל עד חצי היום יכול הוא לגמור בדעתו להתענות עד הלילה ועלתה לו תענית דקאמר התם ממילתיה",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "דר' יוחנן אמר מתענין לשעות דא\"ר יוחנן הריני בתענית עד דנחסל פירקי עד שתשלם פרשתי ממילתיה דר' יונה אמרה מתענין",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "לשעות דר' יונה הלך לצור ושמע דדמך בריה דרבי יוסי הגלילי אע\"ג דאכל גובנא ושתה מיא אסקיה בצום כל ההוא יומא משמע",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "דחשיב מתענין לשעות אע\"פ שאכל אחרי כן או קודם. והא דפריך בפ\"ק דתענית (שם) אהא דקאמר כל תענית שלא שקעה עליו חמה",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "לאו שמיה תענית מדרבי יוחנן דאמר אהא בתענית עד שאבא לביתי ולא קמשני היינו משום דמתענין לשעות? דבלאו הכי משני שפיר דלא",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "ישתמוטי מבי נשיאה עבד. ומה שאנו נוהגין להתענות עד צאת הכוכבים אע\"ג דאמרי' בפ\"ק דתענית כל תענית שלא שקעה עליו",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "חמה אינו תענית משמע דבשקיעת חמה סגי והוא ה' מילין קודם צאת הכוכבים? לא מחתינן נפשין לספיקא. ועוד דשמא לשון שקעה ר\"ל",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "שקעה לגמרי. ומיהו המתענה בערב שבת אע\"ג דפסקינן בעירובין (<a href=\"/eruvin/41b\">דף מא:</a>) הלכה מתענה ומשלים א\"צ לדקדק להמתין עד צאת הכוכבים.",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "מעשה בא לפני ר\"ת באחד שעשה הרבה תעניות ולא קבלם מאתמול ואר\"ת כי לא הפסיד תעניותיו כי מאחר שהיה בדעתו להתענות היינו",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "גמר בלבו והוי בכלל נדיב לב דאמר דגמר בלבו אע\"פ שלא הוציא בשפתיו. והא דבעו שמואל ור' יוחנן קבלה? היינו לכתחלה. ועוד היה",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "אור\"ת כי אף לא גמר בלבו עד הלילה יכול להתענות ולהתפלל תפלת תענית ויצא ידי נדרו כאילו קבל מאתמול אך לא היה בידו ראייה",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "ברורה על זה. ומיהו מצוה מן המובחר לקבל מבעוד יום בתפלת המנחה. ור\"י היה רגיל כשהיה מתענה באחד בשבת לקבל תעניתו בשבת",
      "source_ref": "Tosafot on Avodah Zarah 34a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "באלהי נצור. <big><b>בַּמֶּה <span class=\"dh-divergent\">שמש</span>.</b></big> פ\"ה דמשה לא נשתמש בבגדי כהונה דכתיב לאהרן אחיך והוא היה זר אצלן.",
      "source_ref": "Tosafot on Avodah Zarah 34a:4:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "וקשה למ\"ד פרק טבול יום בזבחים (<a href=\"/zevachim/101b\">דף קא:</a>) משה רבינו ע\"ה =עליו השלום= כ\"ג היה ונשתמש בכהונה גדולה מ' שנה ולפי זה היה צריך לשאול במה שמש",
      "source_ref": "Tosafot on Avodah Zarah 34a:4:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "כל מ' שנה ולא יוכל להשיב על זה בחלוק לבן שאין בו אימרא דלשון בכהונה גדולה משמע בח' בגדים ככ\"ג. וי\"ל דשבעת ימי המלואים",
      "source_ref": "Tosafot on Avodah Zarah 34a:4:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "דוקא איבעיא שעדיין לא נתקדשו בגדי כהונה כדכתיב והזית על אהרן ועל בגדיו וגו'. וה\"ר יעקב מאורליינ\"ש פירש דאפי' נתקדשו",
      "source_ref": "Tosafot on Avodah Zarah 34a:4:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "מ\"מ כל ז' ימי המלואים שהיה משה מעמיד המשכן ומפרקו היה נחשב כמו במה ואין בגדי כהונה בבמה כדאמר בפ\"ב דזבחים (<a href=\"/zevachim/119b\">דף קיט:</a>).",
      "source_ref": "Tosafot on Avodah Zarah 34a:4:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "ואין להקשות הלא אין חטאת קרב בבמה וחטאת מלואים קרבה שם? דמצינן למימר הוראת שעה היתה כמו שריפתה דלא מצינו חטאת",
      "source_ref": "Tosafot on Avodah Zarah 34a:4:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "יחיד נשרפת אלא זו. <big><b>שֶׁאֵין בּוֹ.</b></big> כמו על הגס ועל האימרא דפ' האורג (<a href=\"/shabbat/105a\">שבת דף קה.</a>) והוא מן הבגד ופעמים שאינו מן הבגד",
      "source_ref": "Tosafot on Avodah Zarah 34a:5:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "כמו אימראות של ארגמן דנגעים. ולפיכך לא היה בו אימרא? לפי שבזה היה ניכר יותר חדש דבעינן שלא נשתמש בו הדיוט ולפיכך",
      "source_ref": "Tosafot on Avodah Zarah 34a:5:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "עשאוהו משונה משאר חלוקים. והר\"ר משה פירש שלא יאמרו אח\"כ כשישמש אהרן שנמצא מום במשה ולכך עשהו בלא אימרא שידעו הכל",
      "source_ref": "Tosafot on Avodah Zarah 34a:5:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "שלא היה דבר המתקיים מה שהיה משמש. וי\"מ אימרא כמו עמרא לפי שבגדי כהונה היו כלאים קאמר שזה לא היה כלאים.",
      "source_ref": "Tosafot on Avodah Zarah 34a:5:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "<big><b>הַחַרְצַנִּים.</b></big> בנזיר פרק ג' מינים (<a href=\"/nazir/34b\">דף לד:</a>) פליגי תנאי איזה נקרא חרצן ואיזה נקרא זג אם הקליפה או הגרעינין? והתרגום מוכיח",
      "source_ref": "Tosafot on Avodah Zarah 34a:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "850px",
      "right": "",
      "left": "",
      "text": "כר' יוסי דאמר זג הוא הקליפה דמתרגמינן מחרצנין ועד זג מפורצנין ועד עיצורין והקליפה החיצונה הנסחטת היא",
      "source_ref": "Tosafot on Avodah Zarah 34a:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "שראויה לעצור. והניח ר' יוסי סימן לדבר במשנה זוג ועינבל כי הזוג הוא מבחוץ והעינבל מקשקש בתוכו וכן פעמון מתרגמינן זגא שהפעמון",
      "source_ref": "Tosafot on Avodah Zarah 34a:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "הוא החיצון שהעינבל בתוכו. וכן סתם התלמוד קורא הפנימי חרצן עד שיזרע חטה ושעורה וחרצן (<a href=\"/chullin/82b\">חולין דף פב:</a>) והגרעינין הוא הזרע.",
      "source_ref": "Tosafot on Avodah Zarah 34a:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "<big><b>דּוּרְדְּיָּא.</b></big> פי' שמרים של עובדי כוכבים. הר\"ר אפרים היה אומר כי מסברא שמרים שנתייבשו בתנור מועיל להם כמו המתנה",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "860px",
      "right": "",
      "left": "",
      "text": "די\"ב חדש ומתוך כך התיר פת של עובדי כוכבים שנחמץ בשמרי יין שנתייבשו בתנור. ור\"ת הקפיד עליו ואמר כי מה שמתיר התלמוד",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "דורדיא לאחר י\"ב חדש היינו לאחר שנתמדו במים כמו שרגילים העולם לעשות כדמוכח פרק המוכר פירות (<a href=\"/bava_batra/96b\">ב&quot;ב צו:</a>) דקתני אחד שמרי",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "יין כו' ומפרש רמא תלתא ואתא ד' כו'. וכן פ' אלו עוברין (<a href=\"/pesachim/42b\">פסחים דף מב:</a>) גבי תמד קאמר הא ברווקא הא בפורצני תמד שעושין משמרים",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "קורא רווקא כי על שם השק שמשימין בו השמרים לתמדן נקרא כן כדאמרי' רווקי דארמאי. וקודם שנתמדו השמרים נקראים בל' התלמוד",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "שמרי' כי ההיא דפ' המפקיד (<a href=\"/bava_metzia/40b\">ב&quot;מ דף מ:</a>) דקאמר (הא) גולפי ושמריא ואחר שנתמדו נקראו דורדיא ואהנהו מיירי הכא להתירן לאחר י\"ב",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "חדשים. דאיכא תרתי לטיבותא שכבר נתבטל טעמם במים וגם עבר עליהם י\"ב חדש וכן פורצני נמי דשרי לאחר י\"ב חדש הם החרצנים לאחר",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "שנתמדו אבל שמרים שלא נתמדו אין שום דבר מועיל להתירן והעיסה שנתחמצה בהם קודם תמודם לעולם אסורה. או בתוך י\"ב חדש אף",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "לאחר תמודם אסורים ואפי' באלף לא בטיל כיון דלטעמא עביד כדאמרינן (פסחים דף מד) הנח לשאור ותבלין דלטעמא עבידי ולא בטלי",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "",
      "left": "",
      "text": "ואין להתיר. וכתב ר\"ת והמורה יורה כבן סורר ומורה ועלי יערה רוח הבורא. ובתוספתא תניא שמרים שיבשו אסורים בהנאה.",
      "source_ref": "Tosafot on Avodah Zarah 34a:7:1",
      "gemara_segment_ids": [
        7
      ]
    }
  ]
}