c":"english+kih","speaker":null,"head":"דְּתַנְיָא: חָבִית","text":"דְּתַנְיָא: חָבִית (שנתגלה) [שֶׁנִּתְגַּלְּתָה], אַף עַל פִּי שֶׁשָּׁתוּ מִמֶּנָּה תִּשְׁעָה וְלֹא מֵתוּ — לֹא יִשְׁתֶּה מִמֶּנָּה עֲשִׂירִי."},{"id":21,"seg":5,"role":"assert.narrative","conf":"med","src":"english","speaker":null,"head":"מַעֲשֶׂה הָיָה","text":"מַעֲשֶׂה הָיָה שֶׁשָּׁתוּ מִמֶּנּוּ תִּשְׁעָה וְלֹא מֵתוּ, וְשָׁתָה עֲשִׂירִי וָמֵת."},{"id":26,"seg":7,"role":"assert.citation","conf":"high","src":"english+hebrew+kih","speaker":null,"head":"תָּנוּ רַבָּנַן:","text":"תָּנוּ רַבָּנַן: מַיִם שֶׁנִּתְגַּלּוּ — הֲרֵי זֶה לֹא יִשְׁפְּכֵם בִּרְשׁוּת הָרַבִּים, וְלֹא יְרַבֵּיץ בָּהֶן אֶת הַבַּיִת, וְלֹא יְגַבֵּל בָּהֶן אֶת הַטִּיט, וְלֹא יַשְׁקֶה מֵהֶן לֹא בְּהֶמְתּוֹ וְלֹא בֶּהֱמַת חֲבֵירוֹ, וְלֹא יִרְחַץ בָּהֶן פָּנָיו יָדָיו וְרַגְלָיו."},{"id":28,"seg":8,"role":"probe.attack.difficulty","conf":"high","src":"english+kih+biur","speaker":null,"head":"אֲחֵרִים הַיְינוּ","text":"אֲחֵרִים הַיְינוּ תַּנָּא קַמָּא!"},{"id":29,"seg":8,"role":"respond.answer","conf":"high","src":"english+kih+biur","speaker":null,"head":"אִיכָּא בֵּינַיְיהוּ","text":"אִיכָּא בֵּינַיְיהוּ גַּב הַיָּד וְגַב הָרֶגֶל וְרוּמָּנֵי דְּאַפֵּי."},{"id":30,"seg":9,"role":"assert.citation","conf":"high","src":"hebrew+kih","speaker":null,"head":"אָמַר מָר:","text":"אָמַר מָר: לֹא יַשְׁקֶה מֵהֶן לֹא בְּהֶמְתּוֹ וְלֹא בֶּהֱמַת חֲבֵירוֹ."},{"id":31,"seg":9,"role":"probe.attack.contradiction","conf":"high","src":"english+hebrew+kih+biur","speaker":null,"head":"וְהָתַנְיָא: אֲבָל","text":"וְהָתַנְיָא: אֲבָל מַשְׁקֵהוּ לְבֶהֱמַת עַצְמוֹ!"},{"id":32,"seg":9,"role":"respond.answer","conf":"high","src":"kih+biur","speaker":null,"head":"כִּי תַּנְיָא","text":"כִּי תַּנְיָא הָהִיא — לְשׁוּנָּרָא."},{"id":33,"seg":9,"role":"probe","conf":"high","src":"english+hebrew+kih+biur","speaker":null,"head":"אִי הָכִי,","text":"אִי הָכִי, דְּחַבְרֵיהּ נָמֵי?"},{"id":34,"seg":9,"role":"respond.answer","conf":"high","src":"english+kih+biur","speaker":null