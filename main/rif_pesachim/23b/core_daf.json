      "left": "",
      "text": "דנפקא לן מקרא וכגון רביעית",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמן לרקיקי נזיר דאיכא דיליף",
