        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפירש\"י ורשב\"ם] נמצא חלק",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העשרים י\"ח חומשי אצבע אח\"כ",
      "segment_ids": [
