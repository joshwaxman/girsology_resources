      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלי מתכות אלמא כלים של אבנים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ככלי מתכות דמיין ולא ככלי",
