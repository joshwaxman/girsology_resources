    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היכי אפשר למימר דלא בשלה ביה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והא ודאי אפי' בשרא [דתורא",
