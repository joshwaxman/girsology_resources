      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנאפית כל צרכה: <b>ב</b> נראה מדברי רבי'",
      "segment_ids": [
