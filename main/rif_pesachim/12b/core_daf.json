      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא שיהיו שאובין כל הלילה מראש ועד סוף",
      "segment_ids": [
