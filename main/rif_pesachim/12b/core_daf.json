      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צורכן והקמח שלהן בא לידי חמוץ ומז\"ה",
      "segment_ids": [
