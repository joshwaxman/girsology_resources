      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתיר וכדברי האוסרין נ\"ל עיקר ולא התירו",
      "segment_ids": [
