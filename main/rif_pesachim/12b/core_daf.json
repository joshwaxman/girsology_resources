      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במחובר בתחלת היום וכל היום ואפשר דדעתו",
      "segment_ids": [
