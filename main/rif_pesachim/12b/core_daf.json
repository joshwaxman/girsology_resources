      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקמחא טור: <b>לשון ריא\"ז</b> ואין מוללין",
      "segment_ids": [
