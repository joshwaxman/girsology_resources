      ],
      "gemara_segment_ids": [
        2,
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דפירוש מים שלנו רוצה לומר שלא יהיו",
      "segment_ids": [
