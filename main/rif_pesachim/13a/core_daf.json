  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> הלכך שכר שעושין באשכנז מחטים ושעורים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חייבים לבערו ומעשה בא' שהעמיד גבינה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחלא דשכרא ואסר ר\"ת להשהותם בפסח כיון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאוקומי מוקים חשיב כמו בעינייהו וכ\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סמ\"ג דאיכא משום בל יראה בשכר שלנו שיש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בו שעורים כזית בכדי אכילת פרס: <b>לשון</b>",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> והשעורים מחמיצין ע\"י תערובת מים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבהם שאם אין בהם מים מי פירות לבדם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינן מחמיצין וכן מבואר בתלמוד של א\"י:",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ב</b> וכתב הטור דדעת רבי' לפסוק כחכמים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין לאו לא בתערובת חמץ ולא בחמץ נוקשה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא איסור דרבנן ולפי זה מותר לערבו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לכתחלה לפני הפסח להשהותו עד לאחר הפסח",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולזה הסכים הרא\"ש ודוקא שאין בתערובות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טעם חמץ כגון כותח וכל אלו שאין נותנין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותו אלא לקיוהא בעלמא אבל אם יש בו טעם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חמץ חייבים עליו דטעם כעיקר דאורייתא:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לשון ריא\"ז</b> ועוברים על כל המינים הללו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בבל יראה ובבל ימצא ולוקין על אכילתן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואין חייבים עליהם כרת ולא חייבה תורה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כרת אלא על האוכל חמץ גמור בעינו ולא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כאלה שהוא ע\"י תערובות אפילו אכל כזית",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מן הכותח לוקה עליו הואיל ויש בו טעם מן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החמץ אע\"פ שרובו היתר מצטרף ההיתר עם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האיסור והרי הוא כאילו הזית כולו אסור",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נתערב החמץ במינו הרי הוא בטל מן התורה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ברוב ההיתר ואין איסורו אלא מדברי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סופרי' והוא שנימוח ואין ניכר החמץ",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעינו אבל אם החמץ ניכר בעינו ואכלו יחד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עם ההיתר מצטרף ההיתר עמו להשלימו לכזית",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחייבו מלקות ולא כרת כמבואר בקונטרס",
