      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עבידנא: אמר אביי הכל מודים בכלאי <span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>הכרם",
