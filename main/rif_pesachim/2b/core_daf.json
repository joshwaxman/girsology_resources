      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחלה אע\"ג דלא מצי מסלק ולפי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה אתי שפיר ודוקא בעיסת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ארנונא שאין לנכרי חלק בה אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למלך יש חק עליה הוא דאמרינן",
