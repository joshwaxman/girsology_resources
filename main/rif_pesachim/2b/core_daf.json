  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וכללא</b> דשמעתא דכל היכא דקביל עליה אחריות אסור בין בנכרי שכבשתו בין בנכרי שלא כבשתו בין בבתים בין בגבולין וכל שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קבל עליו אחריות שרי בכלהו: <b>דבני חילא.</b> החיל של בית המלך ומטילין טורח תיקון מזונותם על בני העיירות: <b>ארנונא.</b> לשון",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מס המלך שנוטל עישור מן הבהמות ומן התבואות ואע\"ג דמצי מסלק ליה בזוזי דכל כמה דלא סלקו ידו שייכא בבהמות וקי\"ל כל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שיד הנכרי באמצע פטורה מן הבכורה דכתיב (במדבר יג) כל בכור בבהמת בני ישראל ולא באחרי': <b>עיסת ארנונא חייב' בחלה.</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואע\"ג דעיסת נכרי פטורה מן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החלה דכתיב עריסותיכם זו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייבת דלית לה קלא והרואה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומר שלו הוא ואוכלה בלא חלה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בהמה אית לה קלא והקשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרשב\"ם ז\"ל היכי אמריי דבהמת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ארנונא פטורה מן הבכורה ואע\"ג",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמצי מסלק ליה בזוזי והא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהדיא תניא בתוספת' דבהמת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ארנונא חייבת בבכורה ואיכא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נוסחי דגרסי בהמת ארנונא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פטורה מן הבכורה והוא דלא מצי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסלק ליה עיסת ארנונא חייבת",
      "segment_ids": [
