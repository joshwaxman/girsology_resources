      "right": "0px",
      "left": "",
      "text": "במס' חלה (פ\"ג מ\"ה) העושה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עיסה עם הנכרי אם אין בשל",
      "segment_ids": [
