      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39a:10\" data-ror-ocr=\"בתחלה נשמעברו בהן ע ״ י שכר שהיו שוכרין\">שוכרין</i> <i class=\"ror-gap\" data-ror-gap=\"3\">⋯</i> <i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39b:12\" data-ror-ocr=\"אותו להחמיץ: לא השרה אה המורסן.\">אותו להחמיץ: לא תשרה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39b:12\" data-ror-ocr=\"אותו להחמיץ: לא השרה אה המורסן.\">המורסן</i> <i class=\"ror-line\" data-ror-i=\"20\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39b:12\" data-ror-ocr=\"לשרף בה בשרה מפני שמחמיצות בשרייתו:\">לשוף בה בשרה מפני שמחמיץ</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"20\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39b:12\" data-ror-ocr=\"לשרף בה בשרה מפני שמחמיצות בשרייתו:\">בשרייתו:</i> <i class=\"ror-line\" data-ror-i=\"21\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39b:12\" data-ror-ocr=\"אבל שפה היא מורהן על בשרה יבש. ואע׳׳ג\">אבל שפה היא - מורסן יבש</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"21\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39b:12\" data-ror-ocr=\"אבל שפה היא מורהן על בשרה יבש. ואע׳׳ג\">בבשרה ואע\"פ</i> <i class=\"ror-line\" data-ror-i=\"22\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39b:12\" data-ror-ocr=\"שמים טופחים על בשרה: לא ילעוס.\">שמים טופחין על בשרה:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"22\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 39b:12\" data-ror-ocr=\"שמים טופחים על בשרה: לא ילעוס.\">לא ילעוס - לא יכוס:</i>"
      }
