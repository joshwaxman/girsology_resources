      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנאפה שתי פעמים ואפילו הכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדם יוצא י\"ח: <b>הילכך נקטינן</b>",
      "segment_ids": [
