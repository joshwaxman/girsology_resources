      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחם אלא האפוי בתנור מעיקרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואסמך ליה אקרא (ויקרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
