  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> ור\"ת פסק כר\"ל משום דסוגיא דשמעתין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כוותיה דקאמר סתמא דתלמודא לא דכ\"ע מעשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אילפס פטורין ועוד דהך סוגיא דיתיב רבה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ורב יוסף אחורי דר' זירא אליבא דר\"ל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיירי דלר' יוחנן לא פטר ליה אלא עשאו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחמה ומיהו נראה דהלכה כר' יוחנן מדלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חשיב לה ביבמות בהדי תלתא מילי דהלכה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כר\"ל וכן פסק בשאלתות דרב אחאי בפ' צו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "את אהרן ועוד נראה דהא דמחייב ר' יוחנן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במעשה אילפס היינו דוקא כשעשאו באילפס",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בלא משקין דומיא דתנור אבל אם בשלו במים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "או טיגנן בשמן מודה ר' יוחנן דלא הוי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחם כדמוכח בירושלמי בפ\"ק דחלה. ועוד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היה אומר רבינו תם דבדבר שבלילתו רכה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פליגי דר' יוחנן סבר אפייתו באילפס עושה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותו לחם ור\"ל סבר דוקא תנור. אבל דבר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבלילתו קשה מודו כ\"ע דמחייב בחלה אפי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סופו לבשלו במים או לטגנו בשמן דמשעת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גילגול אתי חיוב חלה: ועוד היה אומר ר\"ת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל דכי היכי דמחייב בחלה הכי נמי מברך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עליו המוציא לאחר הבישול או לאחר הטיגון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדמוכח בברכות בכיצד מברכין אבל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ורומוזל\"ש שקורין טליירל\"י היה אומר ר\"ת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין מברכין עליו המוציא שאין בה תוריתא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דנהמא אף ע\"פ שנתחייב עיסתה בחלה ורבי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמשון ז\"ל כתב במס' חלה שהלש עיסה גמורה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ודעתו לבשלה במים או לטגנה בשמן פטורה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מן החלה: ורבינו מאיר היה נוהג כשלשין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עיסה בביתו כדי לבשלה במים או לטגנה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשמן היה מצוה לאפות ממנה מעט ועל ידי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כך נתחייבה העיסה כולה בחלה קודם שיקח",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממנה מעט דחיישינן שמא תמלך וגם לא היה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אוכלה בלא המוציא אחר שנתבשלה או נטגנה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וגם לא היה מברך עליו המוציא אלא מברך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על לחם אחר ואח\"כ אכלה: <b>ב לשון ריא\"ז</b>",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכן עיסה הנאפה בחמה אינה קרויה לחם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואין מברכין עליה המוציא ואין יוצאין בה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בפסח ואין אופין עיסה בחמה בפסח שמא תבא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לידי חמוץ כמו שמבואר בתוספתא חררה קטנה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנאפית ע\"ג קרקע לחם עוני הוא ויוצאין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בה משום מצה: <b>ג לשון ריא\"ז</b> סימן לירק מר",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        2,
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיש לו שרף לבן כחלב ופניו מכסיפין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו ירוק הרבה ככרתי יוצאין בו משום",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מרור והוא שראוי למאכל אדם: <b>ד לשון</b>",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> ומז\"ה אומר שיוצאין בהם כמושין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולי נראה שהעלים צריכין שיהיו לחי' ולא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמושים והקלחין אפי' כמושים כמבואר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות והוא בתלמוד של ארץ",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ישראל: <b>ה</b> אם שרו המורסן ושפשפו בו אווז",
      "segment_ids": [
        3,
        4
      ],
      "gemara_segment_ids": [
        6,
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בפסח אסור: <b>לשון ריא\"ז</b> וכן אסור לחלוט",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מורסן לתרנגולין במים רותחין מתקנת",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הגאונים שכך היא איסור הנאה כמו איסור",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אכילה ורבי' משה מתיר ללוש מורסן",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לתרנגולין ומאכילן מיד או נותן לפניהם",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והוא עומד עליהם עד שלא ישהה לפניהם כדי",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הילוך מיל: <b>ו</b> כיון דאין אנו בקיאין אין",
      "segment_ids": [
        4,
        5
      ],
      "gemara_segment_ids": [
