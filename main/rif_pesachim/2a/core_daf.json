      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לומר והלא כבר נאמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">צ\"ל</i> <i class=\"footnote\">לא</i> <i class=\"footnote\">יראה</i> <i class=\"footnote\">לך</i> <i class=\"footnote\">חמץ</i>",
