        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואימא לרבות ליל ארבעה עשר לביעור <span class=\"bavli-ref\" data-bavli-ref=\"(דף ה.)\" data-bavli-daf=\"5a\" data-bavli-index=\"0\"></span>ביום",
      "segment_ids": [
