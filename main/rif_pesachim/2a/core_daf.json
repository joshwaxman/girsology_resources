  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בין בגופיה בין בממוניה תנן התם ר\"מ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר אוכלין כל חמש ושורפין בתחלת שש",
