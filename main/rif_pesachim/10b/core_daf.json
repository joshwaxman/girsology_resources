      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עקיבא אע\"פ שעשה מעשה אי לאו דמסייע ליה",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עובדא דר' יהושע שהוא אמורא ואם אפאו",
      "segment_ids": [
