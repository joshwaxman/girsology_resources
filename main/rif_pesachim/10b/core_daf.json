      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות: <b>ו</b> כתב הרא\"ש ז\"ל ופסק",
      "segment_ids": [
