      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחם וכן הטוא\"ח סי' קס\"ח: <b>לשון ריא\"ז</b>",
