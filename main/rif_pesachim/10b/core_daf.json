        5
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חלוטה ברותחין ואינה קרויה לחם ואין",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יוצאין כמבואר בקונ' הראיות וכן כל מיני",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עיסה בין שבלילתה קשה בין שבלילתה רכה",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהרתיחן במשקין אינן קרוין לחם ואין",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יוצאין בהן בפסח ואינן חייבין בחלה ואין",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מברכין עליהן המוציא כמבואר בקונטרס",
