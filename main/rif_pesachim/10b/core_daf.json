        5
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כחכמים דלעיל לא פסק רב אלפס ז\"ל כר'",
      "segment_ids": [
