      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באילפס בלא משקה פסק כר\"ח דלא הוי לחם",
      "segment_ids": [
