      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 3b:6\" data-ror-ocr=\"שאין צריך למוסקן בכלים מהורים ללא\">למוסקן <i class=\"ror-talmud-only\" data-ror-chars=\"30\" data-ror-talmud=\"בטהרה כדאמר במסכת שבת ביציאות שבת (ד&#x27; יז.)\">°</i> דלא</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 3b:6\" data-ror-ocr=\"חשיב משקה מה שימצא מהם להכשיר\">חשיב מוהל היוצא מהן</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 3b:6\" data-ror-ocr=\"חשיב משקה מה שימצא מהם להכשיר\">להכשיר</i> <i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Pesachim 3b:6\" data-ror-ocr=\"שאין שמן גמור אלא היוצא על ילי הבר\">שאינו שמן גמור אלא היוצא ע\"י</i>"
      },
