      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות: <b>ב</b> בברכת הטוב והמטיב",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רבו הדעות רוב הפוסקים הסכימו דעל שינוי",
      "segment_ids": [
