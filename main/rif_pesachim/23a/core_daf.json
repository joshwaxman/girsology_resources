      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"3\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Pesachim 107b:5\" data-ror-ocr=\"מן המנחה ולמעלה לפי שאינו משביע: בגי\">הואיל</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Pesachim 107b:5\" data-ror-ocr=\"מהן מן המנחה ולמעלה להואיל והוא עוסק בהן\">מן המנחה ולמעלה דהואיל והוא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Pesachim 107b:5\" data-ror-ocr=\"מהן מן המנחה ולמעלה להואיל והוא עוסק בהן\">עסוק בהן</i> <i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Pesachim 107b:5\" data-ror-ocr=\"מצערי ליה אי לא אמל ואי אכיל לא משביעין\">מצער ליה אי לא אכיל ואי</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Pesachim 107b:5\" data-ror-ocr=\"מצערי ליה אי לא אמל ואי אכיל לא משביעין\">אכיל לא משבעו</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Pesachim 107b:5\" data-ror-ocr=\"ליה: גירו לכס גיר. כשאתם טורחים אז\">ליה: נירו לכם ניר -</i>"
      },
