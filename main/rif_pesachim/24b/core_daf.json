  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "סעודה והדין <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>טעמא בתרא טעמא דמסתבר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושפיר דמי למיעבד הכי: <b><big>מתני'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף קיד.)\" data-bavli-daf=\"114a\" data-bavli-index=\"0\"></span><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Leavened and Unleavened Bread\" data-label=\"⚬\"></i>מזגו לו",
      "segment_ids": [
