  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א לשון ריא\"ז</b> ומז\"ה אומר שאף התנור מצרף",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמו הסל ואין אני רואה את דבריו כמבואר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות ושיטת המורה כדברי: נתן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החלות ע\"ג טבלא שאין לה לבזבז ואין לה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בית קבול הרי זה ספק בתלמוד אם מצטרפת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואם לאו לפי שאינן עומדו' בתוך כלי אלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באויר כלי ומספק ראוי לפטור בחלת חו\"ל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהיא מדברי סופרים לפיכך ראוי שיתן כל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החלות של שיעור חלה תוך כלי משפתו ולמטה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדי לצרפן צירוף יפה ולא יעמדו מקצתן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משפתו ולמעלה וכן בס' התרומה: <b>ב</b> ויש",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מהגאונים שכתבו שאף חלת האור יכול לקרות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לה שם ולאפותה אף במקום שאין כהן כיון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דחזיא ליה אם איתיה אמרי' הואיל והלכה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כרבה דאמר הואיל. וכתב הטור ומוטב שלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לקרות לה שם אלא א\"כ יש כהן בעיר לאפוקי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נפשיה מפלוגתא: <b>לשון ריא\"ז</b> וכהן גדול",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שטבל לקריו או כהנת שטבלה לנדתה הרי הן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ככהן קטן כמו שביאר מז\"ה בפסקיו בפרק",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנות כותים ואם אין שם כהן קטן או כהן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שטבל מפרישה לאחר אפייתה כמו שביארנו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכך היא שיטת מז\"ה וכן אם רצה מבטלה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחלת חו\"ל ברוב חלות של היתר והיא מותרת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אפי' לכהן שלא טבל ויש אומרים שהיא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותרת ע\"י ביטול אפי' לישראל וכן נראה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעיני עיקר כמבואר בקונטרס הראיות. ועוד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמרו בחלת חוצה לארץ שאם רצה אוכל והולך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואח\"כ מפריש וכל זה מבואר בפרק עד כמה:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    }
