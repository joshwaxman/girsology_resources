        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שעות ולמעלה אסור ומפרש ר\"ת מסוף ו'",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שעות ולמעלה ומשוה יחד שעות דאורייתא",
