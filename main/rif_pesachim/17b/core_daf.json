  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב הרא\"ש ז\"ל וקשה היאך התיר רבי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בבית שאן בפ\"ק דחולין משום שהעיד על ר\"מ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאכל שם עלה של ירק בלא מעשר מ\"מ בני",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המקום נהגו בו איסור ופירש רבינו נסים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במגילת סתרים דוקא דברים שידוע להן שהן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותרין ונוהגין בהן איסור לפי שרוצים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להחמיר על עצמם אי אתה רשאי להתירן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בפניהם אבל אם נוהגין מחמת טעות שסוברין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא אסור והוא מותר יכול להתירן לפניהם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולפ\"ז ניחא הך עובדא דבית שאן דטעות היה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהיו סבורין שהוא א\"י והכי איתא בהדיא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בירושלמי ר' יוסי בר בון אומר כל דבר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין ידוע בו שהוא מותר והוא טועה ונוהג",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בו איסור נשאל ומתירין לו וכל דבר שידוע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בו שהוא מותר ונוהג בו איסור נשאל ואין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתירין לו כלומר אם בא לחכם לישאל אם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יכול לזלזל במנהג שנהגו בו אבותיו כההיא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבני בישן לא יתיר לו החכם וכן נמי אדם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנהג איסור בדבר המותר לסייג ולפרישות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לא יתיר לו החכם המנהג ההוא ממילא דהוי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמו נדר כדאית' בפ\"ב דנדרים תניא דברים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המותרים ואחרים נהגו בו איסור אי אתה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רשאי להתירן לפניהם משום שנאמר לא יחל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דברו אבל החכם יכול להתיר לו בחרטה כמו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאר דברים ויפתח בחרטה שהוא מתחרט שנהג",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כן לשם נדר והא דאמר הכא דדוקא בכותאי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "או בני מדינה אי אתה רשאי להתירן בפניהם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל שלא בפניהם או בפני ת\"ח אתה רשאי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לנהוג בו היתר קשיא אמאי והאנן תנן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נותנין עליו חומרי מקום שהלך לשם והוי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ליה לאקשויי ממתני' אהך ברייתא כדפריך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לקמן ממתניתין ארבה בר בר חנה דאכל תרבא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאייתרא הלכך צריך לומר שיש חילוק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במנהגים דמתני' איירי במנהג חשוב שנהגו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בני המקום על פי ת\"ח ות\"ח נוהג עמהם אבל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מנהג גרוע של בני המדינה שנהגו מעצמם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבר אחד מותר להתירן שלא בפניהם כגון כל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הני דחשיבי בברייתא רחיצת ב' אחין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ויציאת קורדיקיסין וישיבת ספסלי נכרים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשבת ודאייתרא מנהג חשוב היה ע\"פ ת\"ח: <b>ב</b>",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יש מפרשים דוקא טלה וגדי שראוי לפסח אבל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רש\"י פי' אפי' בשר בהמה לפי שיהיו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סוברי' שהקדישו לדמי פסח ואפילו שחוט",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נמי וכן נזהרים באשכנז כשמולחים בשר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לצורך פסח אין מזכירים עליו שם פסח אלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אומרים בשר זה ליו\"ט. טור:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    }
  ],
