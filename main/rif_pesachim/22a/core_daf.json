      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלישי וי\"א מבדיל והולך כל יום ראשון",
      "segment_ids": [
