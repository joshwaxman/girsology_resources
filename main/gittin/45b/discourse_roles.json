לָא קַשְׁיָא,","text":"לָא קַשְׁיָא, הָא דְּתַנְיָא ״יִשָּׂרֵף״ – רַבִּי אֱלִיעֶזֶר הִיא, דְּאָמַר: סְתָם מַחְשֶׁבֶת גּוֹי לַעֲבוֹדָה זָרָה."}],"agree":"confirmed"},{"id":8,"role":"assert.citation","conf":"med","reviewed":false,"src":"english","spans":[{"seg":5,"from":0,"to":404,"head":"וְהָא דְּתַנְיָא","text":"וְהָא דְּתַנְיָא ״יִגָּנֵז״ – הַאי תַּנָּא הוּא, דְּתָנֵי רַב הַמְנוּנָא בְּרֵיהּ דְּרָבָא מִפַּשְׁרוּנְיָא: סֵפֶר תּוֹרָה, תְּפִלִּין וּמְזוּזוֹת שֶׁכְּתָבָן מִין, וּמָסוֹר, גּוֹי, וְעֶבֶד, אִשָּׁה, וְקָטָן, וְכוּתִי, וְיִשְׂרָאֵל מְשׁוּמָּד – פְּסוּלִין; שֶׁנֶּאֱמַר: ״וּקְשַׁרְתָּם״–״וּכְתַבְתָּם״ – כֹּל שֶׁיֶּשְׁנוֹ בִּקְשִׁירָה יֶשְׁנוֹ בִּכְתִיבָה, וְכֹל שֶׁאֵינוֹ בִּקְשִׁירָה אֵינוֹ בִּכְתִיבָה."}],"speaker":"Rav Hamnuna, son of Rava of Pashronya","marks":{"source":[{"kind":"baraita","cue":"ברייתא"}]}},{"id":11,"role":"probe.question","conf":"high","reviewed":false,"src":"english+biur","spans":[{"seg":7,"from":0,"to":94,"head":"וְרַבָּן שִׁמְעוֹן","text":"וְרַבָּן שִׁמְעוֹן בֶּן גַּמְלִיאֵל – עִיבּוּד לִשְׁמָן בָּעֵי, כְּתִיבָה לִשְׁמָן לָא בָּעֵי?"}],"agree":"confirmed"},{"id":16,"role":"probe.question","conf":"high","reviewed":false,"src":"english+biur","spans":[{"seg":9,"from":54,"to":64,"head":"לְסוֹרוֹ?","text":"לְסוֹרוֹ?"}],"agree":"confirmed"},{"id":19,"role":"assert.citation","conf":"high","reviewed":false,"src":"english+hebrew","spans":[{"seg":10,"from":0,"to":62,"head":"תָּנוּ רַבָּנַן:","text":"תָּנוּ רַבָּנַן: מַעֲלִין בִּדְמֵיהֶן, עַד כְּדֵי טַרְפָּעִיק."}],"marks":{"discourse":[{"kind":"add","cue":"מוסיפים"}]},"agree":"confirmed"},{"id":20,"role":"probe.question","conf":"high","reviewed":false,"src":"english+hebrew","spans":[{"seg":10,"from":62,"to":80,"head":"מַאי טַרְפָּעִיק?","text":"מַאי טַרְפָּעִיק?"}],"agree":"confirmed"},{"id":22,"role":"assert.narrative","conf":"med","reviewed":false,"src":"english","spans":[{"seg":11,"from":0,"to":76,"head":"הָהִיא טַיַּיעְתָּא","text":"הָהִיא טַיַּיעְתָּא דְּאַיְיתַי חַיְיתָא דִתְפִילֵּי לְקַמֵּ