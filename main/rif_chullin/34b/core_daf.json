  },
  "gemara": [
    {
      "width": "377px",
      "right": "275px",
      "text": "<big><strong>משערינן</strong></big>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "377px",
      "text": "ברוטב ובקיפה <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>ובחתיכות <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>(<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מ\"ז</i>ובקדירה ואיכא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>דאמרי במאי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דבלעה קדירה) וירך <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>שנצלה בגיד",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הנשה שלה קיימא לן כשמואל",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דאמר שמואל קולף ואוכל עד",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שמגיע לגיד (דף צו:) אמר רב",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הונא גדי שצלאו <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>בחלבו אסור",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לאכול אפילו מריש אוניה מאי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "טעמא דכיון דחלב מפעפע מיבלע",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "בכוליה גופיה אבל אי כחוש הוא",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "קיימא לן כרבי יוחנן דאמר (דף",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "צז.) קולף ואוכל עד שמגיע",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לחלבו (דף צז:) ההיא <i data-commentator=\"Tur\" data-label=\"⚬\"></i>אטמתא",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דאימלחן בבי דיש גלותא <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>בגיד",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "נשיא רבינא אסר ורב אחא שרי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אתו ושיילוה למר בר רב אשי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אמר להו אבא שרי וכן הלכתא",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אמר רב נחמן גיד הנשה בששים",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ואין גיד מן המנין",
      "segment_ids": [
        0
      ],
      "right": "275px"
    }
  ],
  "rashi": [
    {
      "width": "1010px",
      "text": "<b>א\"ר חנינא כשמשערין משערין ברוטב ובקיפה.",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "</b> קיפה דק דק של בשר ותבלין המתאסף בשולי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "קדרה וגרסינן תו עלה בגמ' ובקדרה אמרי לה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "בקדרה עצמה ואמרי לה במאי דבלעה קדרה והני",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "450px",
      "text": "תרי לישני מפרשי' מאי דאמר בקדרה [ונראה]",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שרבינו שלמה בר יצחקי מפרש דמאן דאמר",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בקדרה עצמה היינו בחרסי הקדרה ומ\"ד במאי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דבלעה קדרה (עצמה) היינו לומר שאם ראינוהו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כשנפל שם קודם שנתמעט דאי משערין אותו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לאחר שנתבשל כמו שנפל שם ואין בהיתר ששים",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בו אומדין כמה בלעה קדרה מן ההיתר שכשנפל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שם היה ההיתר הרבה ונתמעט בבליעת קדרה אבל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בקדרה עצמה לא משערינן וכיון דפליגי לישני",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ואיסורא דאורייתא הוא אזלינן לחומרא ולא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "משערינן בקדרה עצמה ועיקר הדבר כמו שהוא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בא לפנינו משערינן ליה ולא משערינן במאי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דבלעה קדרה מן ההיתר לפי שאף האיסור נבלע",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ונתמעט מכמות שהיה וכדאמרינן לקמן [דף",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "צח.] אטו היתרא בלע איסורא לא בלע זהו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לשונו של רש\"י ז\"ל והוא דוחה לישנא קמא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "משום לישנא בתרא דלחומרא ואח\"כ דחה לישנא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בתרא <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>לפי שאף האיסור נבלע ונתמעט מכמות",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שהיה וכן נראה דעת הרב אלפסי ז\"ל [שהוא]",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הביא לשונות הללו בהלכות <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>ולפי זה נראה שיש",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "טעות סופר בפירש\"י ומיירי בשלא ראינו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "האיסור בשעת נפילתו דבכה\"ג הוא דאיכא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "למימר דכי היכי דאימעוט היתרא אימעוט נמי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "איסורא הא אם ראינו האיסור בשעת נפילתו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ולא נתמעט בשיעור אחד <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>עם ההיתר כגון זה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "משערים ההיתר שנבלע בקדרה ומצטרפין אותו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "למה שבתוכה ומשערינן האיסור כשעת נפילתו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לתוך ההיתר ואיכא למידק כיון שעכשיו אין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ששים בהיתר למה אינו חוזר האיסור לאסור את",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ההיתר שהרי אילו נפל בקדרה אחרת בעינן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ששים כיוצא בו ומ\"ש קדרה זו מקדרה דעלמא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ועוד דתנן במסכת תרומות סאה תרומה שנפלה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "למאה חולין טחנו ופיחתו כשם שפיחתו חולין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כך פיחתה תרומה טעמא דאיכא למימר דפיחתה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "תרומה הא לאו הכי אסור וה\"נ מאי שנא ותירץ",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הרמב\"ן ז\"ל דאם נטל מן ההיתר אה\"נ אבל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כיון שלא נטל ממנו אלא שנתמעט דרך בישול",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הקילו בו ויותר נראין דברי הר\"ם במז\"ל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שכתב בפ' חמשה עשר מהלכות מאכלות אסורות",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דבמאי דבלעה קדירה היינו לומר שמשערים",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "באומד יפה כמה נבלע ועומד בדופני הקדרה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שרואין אותו כאילו הוא בתוך הקדרה אבל מה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שפיחת מחמת האור שכלה ואבד לא וכתב הר\"ר",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אהרן הלוי ז\"ל בפירושי ההלכות והוי יודע",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דכשמשערין ברוטב משערין לכזית ביצה ומחצה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "של רוטב שכן שיעורו שאם יקרוש יעמוד על",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כזית עכ\"ל ונ\"ל שלמדה מדאמרינן במסכת שבת",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בריש פ' המוציא (דף עז.) גבי מתני' דתנן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "המוציא יין כדי מזיגת הכוס וכו' תנא יבש",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בכזית דברי רבי נתן ואמרינן עלה אמר רב",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "יוסף רבי נתן ורבי יוסי ברבי יהודה אמרו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דבר אחד ר' נתן הא דאמרן ר' יוסי ברבי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "יהודה דתנן ר' יהודה אומר ששה דברים מקולי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ב\"ש ומחומרי ב\"ה דם נבלות ב\"ש מטהרין וב\"ה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מטמאין א\"ר יוסי ברבי יהודה אף כשטמאו ב\"ה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לא טמאו אלא בדם רביעית הואיל ויכול לקרוש",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ולעמוד על כזית אלמא המשקין הצלולין כשהן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נקרשים רביעית שלה חוזר לכזית ולפיכך כל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שהאיסור קרוש משערין רביעית רוטב לכזית",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ואע\"ג דעלה דההיא אמרינן א\"ל אביי דילמא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לא היא ע\"כ לא קאמר רבי נתן הכא דכזית בעי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "רביעית אלא ביין דקליש אבל דם דסמיך כזית",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לא בעי רביעית אי נמי ע\"כ לא קאמר ר' יוסי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "התם דכזית סגי ליה ברביעית אלא בדם דסמיך",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אבל יין דקליש כזית הוי יותר מרביעית וכי",
