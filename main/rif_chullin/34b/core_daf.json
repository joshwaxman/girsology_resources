  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א\"ר חנינא כשמשערין משערין ברוטב ובקיפה.</b> קיפה דק דק של בשר ותבלין המתאסף בשולי קדרה וגרסינן תו עלה בגמ' ובקדרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמרי לה בקדרה עצמה ואמרי לה במאי דבלעה קדרה והני תרי לישני מפרשי' מאי דאמר בקדרה [ונראה] שרבינו שלמה בר יצחקי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפרש דמאן דאמר בקדרה עצמה היינו בחרסי הקדרה ומ\"ד במאי דבלעה קדרה (עצמה) היינו לומר שאם ראינוהו כשנפל שם קודם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנתמעט דאי משערין אותו לאחר שנתבשל כמו שנפל שם ואין בהיתר ששים בו אומדין כמה בלעה קדרה מן ההיתר שכשנפל שם היה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההיתר הרבה ונתמעט בבליעת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קדרה אבל בקדרה עצמה לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משערינן וכיון דפליגי לישני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואיסורא דאורייתא הוא אזלינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחומרא ולא משערינן בקדרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמה ועיקר הדבר כמו שהוא בא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפנינו משערינן ליה ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משערינן במאי דבלעה קדרה מן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההיתר לפי שאף האיסור נבלע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונתמעט מכמות שהיה וכדאמרינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקמן [דף צח.] אטו היתרא בלע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איסורא לא בלע זהו לשונו של",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רש\"י ז\"ל והוא דוחה לישנא קמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום לישנא בתרא דלחומרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואח\"כ דחה לישנא בתרא <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>לפי שאף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיסור נבלע ונתמעט מכמות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהיה וכן נראה דעת הרב אלפסי ז\"ל [שהוא] הביא לשונות הללו בהלכות <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>ולפי זה נראה שיש טעות סופר בפירש\"י ומיירי בשלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ראינו האיסור בשעת נפילתו דבכה\"ג הוא דאיכא למימר דכי היכי דאימעוט היתרא אימעוט נמי איסורא הא אם ראינו האיסור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשעת נפילתו ולא נתמעט בשיעור אחד <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>עם ההיתר כגון זה משערים ההיתר שנבלע בקדרה ומצטרפין אותו למה שבתוכה ומשערינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "האיסור כשעת נפילתו לתוך ההיתר ואיכא למידק כיון שעכשיו אין ששים בהיתר למה אינו חוזר האיסור לאסור את ההיתר שהרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אילו נפל בקדרה אחרת בעינן ששים כיוצא בו ומ\"ש קדרה זו מקדרה דעלמא ועוד דתנן במסכת תרומות סאה תרומה שנפלה למאה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חולין טחנו ופיחתו כשם שפיחתו חולין כך פיחתה תרומה טעמא דאיכא למימר דפיחתה תרומה הא לאו הכי אסור וה\"נ מאי שנא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ותירץ הרמב\"ן ז\"ל דאם נטל מן ההיתר אה\"נ אבל כיון שלא נטל ממנו אלא שנתמעט דרך בישול הקילו בו ויותר נראין דברי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הר\"ם במז\"ל שכתב בפ' חמשה עשר מהלכות מאכלות אסורות דבמאי דבלעה קדירה היינו לומר שמשערים באומד יפה כמה נבלע ועומד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בדופני הקדרה שרואין אותו כאילו הוא בתוך הקדרה אבל מה שפיחת מחמת האור שכלה ואבד לא וכתב הר\"ר אהרן הלוי ז\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בפירושי ההלכות והוי יודע דכשמשערין ברוטב משערין לכזית ביצה ומחצה של רוטב שכן שיעורו שאם יקרוש יעמוד על כזית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עכ\"ל ונ\"ל שלמדה מדאמרינן במסכת שבת בריש פ' המוציא (דף עז.) גבי מתני' דתנן המוציא יין כדי מזיגת הכוס וכו' תנא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יבש בכזית דברי רבי נתן ואמרינן עלה אמר רב יוסף רבי נתן ורבי יוסי ברבי יהודה אמרו דבר אחד ר' נתן הא דאמרן ר'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יוסי ברבי יהודה דתנן ר' יהודה אומר ששה דברים מקולי ב\"ש ומחומרי ב\"ה דם נבלות ב\"ש מטהרין וב\"ה מטמאין א\"ר יוסי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ברבי יהודה אף כשטמאו ב\"ה לא טמאו אלא בדם רביעית הואיל ויכול לקרוש ולעמוד על כזית אלמא המשקין הצלולין כשהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נקרשים רביעית שלה חוזר לכזית ולפיכך כל שהאיסור קרוש משערין רביעית רוטב לכזית ואע\"ג דעלה דההיא אמרינן א\"ל אביי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דילמא לא היא ע\"כ לא קאמר רבי נתן הכא דכזית בעי רביעית אלא ביין דקליש אבל דם דסמיך כזית לא בעי רביעית אי נמי ע\"כ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא קאמר ר' יוסי התם דכזית סגי ליה ברביעית אלא בדם דסמיך אבל יין דקליש כזית הוי יותר מרביעית וכי מפיק פחות מכזית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ליחייב דאלמא ס\"ל לאביי שאין כל המשקין שוין לדבר זה אעפ\"כ נראה שסובר הרב ז\"ל דלא שבקינן מאי דפשיטא ליה לרב יוסף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משום ספיקא דאביי ואעפ\"כ אין דבריו נראין לי דכיון דאמרינן משערין ברוטב סתמא משמע דכמות שהוא משערינן אותו שכך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שיערו חכמים שאין לך שנותן טעם יותר מששים אפילו ברוטב שאם לא כן הייט צריכין לחוש ולתת הדבר לשיעורין ולעיין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "באיסור והיתר אם הוא עב או דק: <b>וירך שנצלה עם גיד הנשה קי\"ל כשמואל דאמר קולף ואוכל עד שמגיע לגיד.</b> [ועד שמגיע",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לגיד] דקאמר לאו דוקא דהא צריך לשייר כדי קליפה או כדי נטילת מקום דלא גרע מהא דתנן בפרק כיצד צולין (דף עה:) סכו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשמן של תרומה אם חבורת כהנים יאכלו ואם לא יקלוף את החיצון וגבי רוטב נמי תנן נטף מרוטבו על החרס וחזר אליו יטול",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "את מקומו הילכך ודאי אע\"ג דאמרינן סתמא קולף ואוכל עד שמגיע לגיד כדי קליפה צריך לשייר או כדי נטילת מקום שהוא יותר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מעט מן הקליפה: <b>גדי שצלאו בחלבו.</b> שלא נטל חלב הכליות: <b>אסור לאכול אפילו מריש אוניה.</b> אפילו מריש אזנו שאין שם חלב",
      "segment_ids": [
        1,
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מ\"ט דכיון דחלב מפעפע מיבלע בכוליה גופיה ויש מפרשים דהיינו דוקא כגון שאין בגדי ששים לבטל החלב אבל היכא דאיכא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ששים כיון דמפעפע בטל הוא אבל הרא\"ה ז\"ל כתב דאין חלב מפעפע מתבטל בצלי לעולם דבקדרה הוא שמתבטל מפני שהרוטב מוליך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "האיסור בשוה אבל בצלי שהוא מפעפע מעצמו אפשר שהרבה ממנו מתכנס במקום אחד הילכך אפילו בששים לא בטיל ולפי זה אף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במליחה אין משערין בששים מהאי טעמא ולא משמע הכי לקמן [דף צח.] דאמרינן האי כזיתא דתרבא דנפל לדיקולא דבשרא סבר רב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אשי לשעריה במאי דבלע דיקולא ולכאורה משמע דדיקולא היינו סל שמלחו בו ואפ\"ה משערין בששים ומיהו לדברי רש\"י ז\"ל שפי'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דיקולא קלחת לא קשיא ולא מידי ובגמרא אמרינן דיקולא שצלאה בחלבה קולף ואוכל עד שמגיע לחלבו והיינו משום דקרמא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפסיק. ומהא שמעינן דכלהו קרמי וחוטי דאסירי משום תרבא לא מפעפעי דהא בהך כוליא קרמא ולובן כוליא הות ביה ואפילו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הכי שריוה ואפשר עוד ללמוד מכאן לעוף שצלאו בלא חתיכת ורידין שנוטל החוטין ודיו בכך דקרמא דחוטין מפסיק וכי תימא אם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כן רישא בכבשא אצדדין דאסרינן לעיל [דף צג:] ולא סגי בנטילת חוטין שבקרום המוח אפשר שמתוך שאותן החוטין רכים ודקים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא מפסקי: <b>אבל</b> אי כחוש הוא קי\"ל כרבי יוחנן דאמר קולף ואוכל עד שמגיע לחלבו ודעת המפרשים ז\"ל דבשומן גיד ל\"ש שמן",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ול\"ש כחוש קולף ואוכל עד שמגיע לשמנו דלא אמרו מפעפע אלא בחלב דוקא אבל בשמנו של גיד לא וכן נראה מלשון הגמרא: <b>הנהו</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אטמתא דאימלחן בי ריש גלותא בגידא דנשיא רבינא אסר.</b> דסבר דמליח כמבושל ואסר להו משום שמנו של גיד כל שאין בבשר ס'",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולדברי מי שאומר דלצלי ולמליחה לא משערינן בששים בכל ענין אסר להו: <b>ורב אחא שרי.</b> דס\"ל דמליח הרי הוא כרותח דצלי",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובקליפה או בנטילת מקום סגי וכי תימא וכי הוי כרותח דצלי מאי הוי נימא דמפעפע כדאמרינן לעיל דחלב מפעפע אפילו לצלי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "י\"ל דלא עדיף שומן דגיד הנשה מחלב כחוש דאמרינן לעיל דלא מפעפע וכמו שכתבתי למעלה והרמב\"ן ז\"ל תירץ דבמליחה אפילו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חלב שמן אינו מפעפע ואף על גב דאמרינן דמליח הרי הוא כרותח דצלי היינו לאפוקי מרותח דמבושל אבל להא מילתא גריע מצלי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאע\"ג דחלב בצלי מפעפע במליחה אינו מפעפע והרשב\"א ז\"ל חולק בדבר דכיון דרבינא ס\"ל דמליח כרותח דמבושל דעדיף מצלי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "היכי נימא לדידן דגריע מיניה אלא ודאי משמע דכל דמפעפע בצלי מפעפע במליחה וכדברי הרב רבינו שלמה בן אדרת ז\"ל נ\"ל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מדאמרינן לקמן [דף צח.] ההוא כזיתא דתרבא דנפל לדיקולא דבשרא סבר רב אשי לשעורי במאי דבלע דיקולא ומשמע לכאורה דבשר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא שנמלח בסל וש\"מ דחלב במליחה מפעפע דאי לא למה ליה לשעוריה בקליפה סגי לה: <b>אמר רב נחמן גיד בששים ואין גיד מן</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>המנין.</b> דבעינן ששים להתירא לבר מיניה ולא לבטל גופו של גיד קאמר אם נתערב בין הגידין דגיד הנשה בריה הוא ולא בטיל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כדאמרינן לקמן בפרקין [דף ק.] אלא לבטל פליטתו קאמר ולפליטת גופו של גיד נמי לא צריך ביטול דהא קי\"ל אין בגידין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בנותן טעם ולא משמע דרב נחמן דהוא בתרא ס\"ל יש בגידין בנותן טעם דלא כהלכתא אלא לבטל פליטת שמנו קאמר ושמעינן מהא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דשמנו של גיד אוסר תערובתו שלא כדברי מקצת רבותינו הצרפתים ז\"ל וכמ\"ש למעלה:",
      "segment_ids": [
        7
      ]
    }
  ],
