  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א\"ר חנינא כשמשערין משערין ברוטב ובקיפה.</b> קיפה דק דק של בשר ותבלין המתאסף בשולי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קדרה וגרסינן תו עלה בגמ' ובקדרה אמרי לה בקדרה עצמה ואמרי לה במאי דבלעה קדרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והני תרי לישני מפרשי' מאי דאמר בקדרה [ונראה] שרבינו שלמה בר יצחקי מפרש דמאן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאמר בקדרה עצמה היינו בחרסי הקדרה ומ\"ד במאי דבלעה קדרה (עצמה) היינו לומר שאם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראינוהו כשנפל שם קודם שנתמעט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאי משערין אותו לאחר שנתבשל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמו שנפל שם ואין בהיתר ששים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו אומדין כמה בלעה קדרה מן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההיתר שכשנפל שם היה ההיתר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרבה ונתמעט בבליעת קדרה אבל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקדרה עצמה לא משערינן וכיון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפליגי לישני ואיסורא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאורייתא הוא אזלינן לחומרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא משערינן בקדרה עצמה ועיקר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדבר כמו שהוא בא לפנינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משערינן ליה ולא משערינן במאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבלעה קדרה מן ההיתר לפי שאף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיסור נבלע ונתמעט מכמות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיה וכדאמרינן לקמן [דף צח.]",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אטו היתרא בלע איסורא לא בלע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זהו לשונו של רש\"י ז\"ל והוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דוחה לישנא קמא משום לישנא בתרא דלחומרא ואח\"כ דחה לישנא בתרא <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>לפי שאף האיסור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נבלע ונתמעט מכמות שהיה וכן נראה דעת הרב אלפסי ז\"ל [שהוא] הביא לשונות הללו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהלכות <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>ולפי זה נראה שיש טעות סופר בפירש\"י ומיירי בשלא ראינו האיסור בשעת נפילתו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבכה\"ג הוא דאיכא למימר דכי היכי דאימעוט היתרא אימעוט נמי איסורא הא אם ראינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האיסור בשעת נפילתו ולא נתמעט בשיעור אחד <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>עם ההיתר כגון זה משערים ההיתר שנבלע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בקדרה ומצטרפין אותו למה שבתוכה ומשערינן האיסור כשעת נפילתו לתוך ההיתר ואיכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "למידק כיון שעכשיו אין ששים בהיתר למה אינו חוזר האיסור לאסור את ההיתר שהרי אילו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נפל בקדרה אחרת בעינן ששים כיוצא בו ומ\"ש קדרה זו מקדרה דעלמא ועוד דתנן במסכת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תרומות סאה תרומה שנפלה למאה חולין טחנו ופיחתו כשם שפיחתו חולין כך פיחתה תרומה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טעמא דאיכא למימר דפיחתה תרומה הא לאו הכי אסור וה\"נ מאי שנא ותירץ הרמב\"ן ז\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאם נטל מן ההיתר אה\"נ אבל כיון שלא נטל ממנו אלא שנתמעט דרך בישול הקילו בו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ויותר נראין דברי הר\"ם במז\"ל שכתב בפ' חמשה עשר מהלכות מאכלות אסורות דבמאי דבלעה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קדירה היינו לומר שמשערים באומד יפה כמה נבלע ועומד בדופני הקדרה שרואין אותו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כאילו הוא בתוך הקדרה אבל מה שפיחת מחמת האור שכלה ואבד לא וכתב הר\"ר אהרן הלוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל בפירושי ההלכות והוי יודע דכשמשערין ברוטב משערין לכזית ביצה ומחצה של רוטב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שכן שיעורו שאם יקרוש יעמוד על כזית עכ\"ל ונ\"ל שלמדה מדאמרינן במסכת שבת בריש פ'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המוציא (דף עז.) גבי מתני' דתנן המוציא יין כדי מזיגת הכוס וכו' תנא יבש בכזית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דברי רבי נתן ואמרינן עלה אמר רב יוסף רבי נתן ורבי יוסי ברבי יהודה אמרו דבר אחד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ר' נתן הא דאמרן ר' יוסי ברבי יהודה דתנן ר' יהודה אומר ששה דברים מקולי ב\"ש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומחומרי ב\"ה דם נבלות ב\"ש מטהרין וב\"ה מטמאין א\"ר יוסי ברבי יהודה אף כשטמאו ב\"ה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא טמאו אלא בדם רביעית הואיל ויכול לקרוש ולעמוד על כזית אלמא המשקין הצלולין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כשהן נקרשים רביעית שלה חוזר לכזית ולפיכך כל שהאיסור קרוש משערין רביעית רוטב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לכזית ואע\"ג דעלה דההיא אמרינן א\"ל אביי דילמא לא היא ע\"כ לא קאמר רבי נתן הכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכזית בעי רביעית אלא ביין דקליש אבל דם דסמיך כזית לא בעי רביעית אי נמי ע\"כ לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קאמר ר' יוסי התם דכזית סגי ליה ברביעית אלא בדם דסמיך אבל יין דקליש כזית הוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יותר מרביעית וכי מפיק פחות מכזית ליחייב דאלמא ס\"ל לאביי שאין כל המשקין שוין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לדבר זה אעפ\"כ נראה שסובר הרב ז\"ל דלא שבקינן מאי דפשיטא ליה לרב יוסף משום ספיקא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאביי ואעפ\"כ אין דבריו נראין לי דכיון דאמרינן משערין ברוטב סתמא משמע דכמות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא משערינן אותו שכך שיערו חכמים שאין לך שנותן טעם יותר מששים אפילו ברוטב שאם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא כן הייט צריכין לחוש ולתת הדבר לשיעורין ולעיין באיסור והיתר אם הוא עב או דק:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וירך שנצלה עם גיד הנשה קי\"ל כשמואל דאמר קולף ואוכל עד שמגיע לגיד.</b> [ועד שמגיע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לגיד] דקאמר לאו דוקא דהא צריך לשייר כדי קליפה או כדי נטילת מקום דלא גרע מהא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דתנן בפרק כיצד צולין (דף עה:) סכו בשמן של תרומה אם חבורת כהנים יאכלו ואם לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יקלוף את החיצון וגבי רוטב נמי תנן נטף מרוטבו על החרס וחזר אליו יטול את מקומו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הילכך ודאי אע\"ג דאמרינן סתמא קולף ואוכל עד שמגיע לגיד כדי קליפה צריך לשייר או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדי נטילת מקום שהוא יותר מעט מן הקליפה: <b>גדי שצלאו בחלבו.</b> שלא נטל חלב הכליות:",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אסור לאכול אפילו מריש אוניה.</b> אפילו מריש אזנו שאין שם חלב מ\"ט דכיון דחלב מפעפע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיבלע בכוליה גופיה ויש מפרשים דהיינו דוקא כגון שאין בגדי ששים לבטל החלב אבל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היכא דאיכא ששים כיון דמפעפע בטל הוא אבל הרא\"ה ז\"ל כתב דאין חלב מפעפע מתבטל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בצלי לעולם דבקדרה הוא שמתבטל מפני שהרוטב מוליך האיסור בשוה אבל בצלי שהוא מפעפע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מעצמו אפשר שהרבה ממנו מתכנס במקום אחד הילכך אפילו בששים לא בטיל ולפי זה אף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במליחה אין משערין בששים מהאי טעמא ולא משמע הכי לקמן [דף צח.] דאמרינן האי כזיתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דתרבא דנפל לדיקולא דבשרא סבר רב אשי לשעריה במאי דבלע דיקולא ולכאורה משמע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דדיקולא היינו סל שמלחו בו ואפ\"ה משערין בששים ומיהו לדברי רש\"י ז\"ל שפי' דיקולא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קלחת לא קשיא ולא מידי ובגמרא אמרינן דיקולא שצלאה בחלבה קולף ואוכל עד שמגיע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לחלבו והיינו משום דקרמא מפסיק. ומהא שמעינן דכלהו קרמי וחוטי דאסירי משום תרבא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא מפעפעי דהא בהך כוליא קרמא ולובן כוליא הות ביה ואפילו הכי שריוה ואפשר עוד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ללמוד מכאן לעוף שצלאו בלא חתיכת ורידין שנוטל החוטין ודיו בכך דקרמא דחוטין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מפסיק וכי תימא אם כן רישא בכבשא אצדדין דאסרינן לעיל [דף צג:] ולא סגי בנטילת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חוטין שבקרום המוח אפשר שמתוך שאותן החוטין רכים ודקים לא מפסקי: <b>אבל</b> אי כחוש הוא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קי\"ל כרבי יוחנן דאמר קולף ואוכל עד שמגיע לחלבו ודעת המפרשים ז\"ל דבשומן גיד ל\"ש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמן ול\"ש כחוש קולף ואוכל עד שמגיע לשמנו דלא אמרו מפעפע אלא בחלב דוקא אבל בשמנו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "של גיד לא וכן נראה מלשון הגמרא: <b>הנהו אטמתא דאימלחן בי ריש גלותא בגידא דנשיא</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>רבינא אסר.</b> דסבר דמליח כמבושל ואסר להו משום שמנו של גיד כל שאין בבשר ס' ולדברי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מי שאומר דלצלי ולמליחה לא משערינן בששים בכל ענין אסר להו: <b>ורב אחא שרי.</b> דס\"ל",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמליח הרי הוא כרותח דצלי ובקליפה או בנטילת מקום סגי וכי תימא וכי הוי כרותח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דצלי מאי הוי נימא דמפעפע כדאמרינן לעיל דחלב מפעפע אפילו לצלי י\"ל דלא עדיף שומן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דגיד הנשה מחלב כחוש דאמרינן לעיל דלא מפעפע וכמו שכתבתי למעלה והרמב\"ן ז\"ל תירץ",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבמליחה אפילו חלב שמן אינו מפעפע ואף על גב דאמרינן דמליח הרי הוא כרותח דצלי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היינו לאפוקי מרותח דמבושל אבל להא מילתא גריע מצלי דאע\"ג דחלב בצלי מפעפע במליחה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אינו מפעפע והרשב\"א ז\"ל חולק בדבר דכיון דרבינא ס\"ל דמליח כרותח דמבושל דעדיף",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מצלי היכי נימא לדידן דגריע מיניה אלא ודאי משמע דכל דמפעפע בצלי מפעפע במליחה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכדברי הרב רבינו שלמה בן אדרת ז\"ל נ\"ל מדאמרינן לקמן [דף צח.] ההוא כזיתא דתרבא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דנפל לדיקולא דבשרא סבר רב אשי לשעורי במאי דבלע דיקולא ומשמע לכאורה דבשר הוא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שנמלח בסל וש\"מ דחלב במליחה מפעפע דאי לא למה ליה לשעוריה בקליפה סגי לה: <b>אמר רב</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>נחמן גיד בששים ואין גיד מן המנין.</b> דבעינן ששים להתירא לבר מיניה ולא לבטל גופו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "של גיד קאמר אם נתערב בין הגידין דגיד הנשה בריה הוא ולא בטיל כדאמרינן לקמן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בפרקין [דף ק.] אלא לבטל פליטתו קאמר ולפליטת גופו של גיד נמי לא צריך ביטול דהא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קי\"ל אין בגידין בנותן טעם ולא משמע דרב נחמן דהוא בתרא ס\"ל יש בגידין בנותן טעם",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דלא כהלכתא אלא לבטל פליטת שמנו קאמר ושמעינן מהא דשמנו של גיד אוסר תערובתו שלא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדברי מקצת רבותינו הצרפתים ז\"ל וכמ\"ש למעלה:",
      "segment_ids": [
        7
      ]
    }
  ],
