      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דיכולות לשחוט לכתחלה היכי שיודעות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הלכות שחיטה שפיר וכ\"כ הר\"ן בראיות",
      "segment_ids": [
