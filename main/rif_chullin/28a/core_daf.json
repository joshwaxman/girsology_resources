  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף פא:)\" data-bavli-daf=\"81b\" data-bavli-index=\"0\"></span>השוחט ונמצאת טרפה חייב משום אותו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואת בנו. אבלהשוחט ונתנבלה בידו והנוחר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והמעקר פטור משום אותו ואת בנו: <span class=\"bavli-ref\" data-bavli-ref=\"(דף פב.)\" data-bavli-daf=\"82a\" data-bavli-index=\"1\"></span>שנים",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלקחו פרה ובנה זה שלקח ראשון ישחוט",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשון ואם קדם השני ושחט זכה: השוחט פרה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושני בניה סופג שמונים שחט שני בניה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואח\"כ שחטה סופג ארבעים שחטה ואת בתה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואת בת בתה סופג שמונים שחטה ואת בת בתה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואח\"כ שחט את בתה סופג ארבעים סומכוס",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר משום ר' מאיר סופג שמונים: <b><big>גמ'</big></b> אמר",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב יוסף לענין דינא תנן: תנא אם קדם",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השני זריז ונשכר. זריז דלא עבד איסורא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונשכר דאכיל בשרא: תוספתא הלוקח מבעל",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית הוא קודם לבעל הבית שמתחלה לא לקחו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא על מנת כן: שחט שני בניה ואח\"כ שחטה",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סופג את הארבעים: תניא אותו ואת בנו אין",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לי אלא אותו ובנו בנו ואותו מנין כשהוא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר לא תשחטו הרי כאן שנים הא כיצד אחד",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחט את הפרה ואחד שחט את אמה ואחד שחט",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את בתה שנים האחרונים חייבין: <b><big>מתני'</big></b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<span class=\"bavli-ref\" data-bavli-ref=\"(דף פג.)\" data-bavli-daf=\"83a\" data-bavli-index=\"2\"></span>בארבעה פרקים בשנה המוכר בהמה לחבירו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צדיך להודיעו אמה מכרתי לשחוט בתה מכרתי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשחוט ואלו הן ערב יו\"ט האחרון של חג",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וערב יו\"ט הראשון של פסח וערב עצרת וערב",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ר\"ה וכדברי ר' יוסי הגלילי אף ערב יום הכפורים בגליל אמר ר' יהודה אימתי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בזמן שאין לו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>ריוח אבל יש לו ריוח אינו צריך להודיעו ומודה רבי יהודה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "במוכר את האם לחתן ואת הבת לכלה שהוא צריך להודיעו שהדבר ידוע ששניהן",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שוחטין ביום אחד: <b><big>גמ'</big></b> תנא ואם לא הודיעו הולך ושוחט ואינו נמנע: <b><big>מתני'</big></b>",
      "segment_ids": [
        9,
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "<i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Sales\" data-label=\"⚬\"></i>בד' פרקים אלו משחיטין את הטבח על כרחו שאפילו שור שוה אלף דינר ואין",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ללוקח <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>אלא דינר כופין אותו לשחוט לפיכך אם מת מת ללוקח אבל בשאר ימות",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "השנה אינו כן לפיכך אם מת מת למוכר: <b><big>גמ'</big></b> מת ללוקח והא לא משך ואסיקנא",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "א\"ר <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>אלעא א\"ר יוחנן בארבעה פרקים אלו העמידו דבריהם על דין תורה דאמר ר'",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "יצחק א\"ר יוחנן דבר תורה מעות קונות ומה טעם אמרו משיכה קונה גזרה שמא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "יאמר לו נשרפו חטיך בעלייה לפיכך בארבעה פרקים אלו העמידו דבריהם על דין",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תורה: <b><big>מתני'</big></b> <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>יום אחד האמור באותו ואת בנו היום הולך אחר הלילה את זו דרש",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "רבי שמעון בן זומא נאמר במעשה בראשית (בראשית א) יום אחד ונאמר באותו",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ואת בנו (ויקרא כב) יום אחד מה יום אחד האמור במעשה בראשית היום הולך",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אחר הלילה אף יום אחד האמור באותו ואת בנו היום הולך אחר הלילה: <b>הדרן</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "<b>עלך ואת בנו</b>",
      "segment_ids": [
        14
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מתני' השוחט ונמצאת טרפה חייב באותו ואת בנו.</b> דשחיטה שאינה ראויה שמה שחיטה: <b>ונתנבלה בידו.</b> שלא מדעת: <b>הנוחר והמעקר.</b>",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סימנין מדעת פטור משום דליכא שמיטה כלל ולא דמיא לשחיטת טרפה דהתם שחיטה מעליא איכא ודבר אחר גורם לה ליפסל: <b>שנים</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שלקחו פרה ובנה.</b> ואם שחט אחד מהם יהיה השני אסור לשחוט: <b>זה שלקח ראשון ישחוט ראשון.</b> ושני אסור לו לשחוט: <b>ואם קדם</b>",
      "segment_ids": [
        3,
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>השני זכה.</b> אם קדם השני לשחוט אע\"פ שאין שורת הדין כן שהרי מי שלקח ראשון דינו לשחוט תחלה והשני יאסר <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>אם קדם השני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושחט תחלה זכה ונאסר הלה:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>השוחט פרה ושני בניה סופג</b>",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שמונים.</b> שהרי עובר על כל אחד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלאו דאותו ואת בנו: <b>סופג את</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הארבעים.</b> דאין כאן שחיטת",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איסור אלא אחת ובגמרא יליף",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבנו ואותו נמי חייב: <b>שחטה</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואת בתה ואח\"כ את בת בתה.</b> יש",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כאן שני אותו ואת בנו: <b>שחטה</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואת בת בתה.</b> אין כאן עדיין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איסור: <b>ואח\"כ שחט את בתה.</b> ויש",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשחיטה זו שני איסורין אותו",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואת בנו משום אמה. <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>ואת בנה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואותו משום בתה של זו שכבר",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נשחטה: <b>סופג את הארבעים.</b> דחד",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשה הוא: <b>סומכוס אומר משום</b>",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ר\"מ סופג שמונים.</b> משום שני",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמות אע\"ג דמעשה אחד הוא שהרי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני אמה שנשחטה מתחייב משום",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו ואת בנו ומשום בתה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתחייב משום בנו ואותו ולא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמי לההיא דלעיל דשחט שני",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בניה ואחר כך שחטה דהתם חד",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשה הוא וחד שם הוא דאין",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתחייב על שניהם אלא משום בנו",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואותו אבל הכא חד מעשה ושני",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמות כדכתיבנא: <b>גמ' אמר רב</b>",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יוסף לענין דינא תנן.</b> הא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקתני מתניתין מי שלקח ראשון",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישחוט ראשון לא לענין איסור",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיתר שאם רצה השני לשחוט",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[ראשון והא'] ימתין עד מחר",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר אבל דין הוא אם באו לב\"ד",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבא האחד לשחוט וחבירו אומר",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אני צריך יותר ממך שיאמרו להם",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלוקח הראשון ישחוט ראשון",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שע\"מ כן לקח שאילו לא מכרה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבעה\"ב לשני ועכבה לעצמו היה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלוקת שוחט וכן שנינו בתוס'",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהביא הרי\"ף ז\"ל בסמוך: <b>דלא</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עבד איסורא.</b> שהקדים בעצמו שלא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יבא לידי איסור: <b>נשכר.</b> יש לו",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ריוח ואוכל בשר היום: <b>בנו</b>",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואותו מנין.</b> אם שחט הבת ואח\"כ",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחט האם מנין שהוא חייב: <b>לא</b>",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תשחטו.</b> לשון רבים משמע: <b>הרי כאן שנים.</b> הזהיר את שניהם בין שוחט את האם בין שוחט את הבת ולא משכחת שנים עוברים אלא",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשלש בהמות <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>הא כיצד בת ואם ובת דאי אם ושני בניה למה לי קרא פשיטא מה לי חד מה לי תרי כי היכי דמתחייב אהאי מתחייב",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אהאי ואי בפרה ובתה ובת בתה פשיטא תרוייהו אותו ואת בנו נינהו אלא ע\"כ באחד שוחט פרה והשני את אמה והשלישי את בתה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>אתא לאשמעינן דבבנו ואותו נמי חייב: <b>מתני' בד' פרקים בשנה.</b> דרך ישראל לעשות סעודות והלוקח בהמה אינו לוקח אלא",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לשוחטה מיד ולפיכך המוכר בהמה לחברו ומכר תחלה אמה או בתה בו ביום צריך שיאמר לשני דע לך שהיום מכרתי את אמה לשחוט",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "או בתה מכרתי לשחוט ושמא כבר שחטה: <b>ביו\"ט האחרון של חג.</b> היו מרבין בשמחת רגל מפני שרגל בפני עצמו הוא וחביב עליהם:",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אמר רבי יהודה אימתי בזמן שאין שם ריוח.</b> הפסק בינתים שמכר הראשונה היום אבל אם יש <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>ריוח הפסק בינתים שמכר הראשונה",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אתמול והשניה היום א\"צ להודיע שאני אומר אתמול שחט את הראשונה. ומדברי רש\"י ז\"ל נראה דרבי יהודה אכולהו ארבעה פרקים",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קאי אבל בתוספתא [סוף פ\"ה דחולין] משמע דלא קאי ר' יהודה אלא אערב יוה\"כ בלחוד דאמרינן התם אמר ר' יהודה בד\"א בזמן",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שחל יוה\"כ להיות בשני בשבת אבל אם חל להיות באחד מכל ימות השבוע אין צריך להודיעו מפני שזה יכול לשחוט היום וזה",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למחר. כלומר דכשחל יום הכפורים להיות בשני בשבת אפילו לקח האחד בערב שבת והשני באחד בשבת בידוע ששניהם שוחטין באחד",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשבת שאין אדם מקדים לשחוט מערב שבת אבל כשחל יוה\"כ בשאר ימי השבוע כל שיש ריוח אין צריך להודיע דתלינא שלא ישחטו",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שניהם ביום אחד שעשוי הוא לשחוט ב' ימים קודם. ומדמפליג ביום הכפורים ש\"מ דביו\"ט ליכא לאיפלוגי שכל הלוקח לצורך",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יו\"ט אינו שוחט עד יו\"ט עצמו לכבוד יו\"ט ומיהו אי איקלע יו\"ט בשבת איכא לאיפלוגי ביו\"ט כי היכי דמפלגי ביוה\"כ וכתב",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הרמב\"ן ז\"ל דמ\"ד דבארבעה פרקים הללו המוכר בהמה לחבירו צריך להודיע היינו לומר שאם לא הודיעו הוי המקח טעות שהדבר",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ידוע דלשחטה ביו\"ט הוא לוקחה אבל בשאר הימים אין המוכר צריך להודיע. מיהו הלוקח צריך לשאול. אבל אחרים כתבו שאינו",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צריך לשאול משום דאיכא ספיקי טובא שמא אין לה אם לזו ואם תמצא לומר יש לה ומכרה שמא לא לקחה לשחיטה ואם תמצא לומר",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לשחיטה שמא מכאן ועד עשרה ימים ולזה הדעת אפשר שהמוכר שיודע שמכר צריך להודיע אף בשאר ימות השנה כדי שלא יכשל הלוקח",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על ידו אלא שאם לא הודיע לא הוי מקח טעות: <b>מתני' בד' פרקים אלו משחיטין את הטבח בעל כרחו.</b> כדמפרש ואזיל שאם קבל",
      "segment_ids": [
        21,
        22
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דינר מלוקח ליתן לו בדינר בשר אפי' שור שוה אלף זוז שוחט על כרחו ואע\"פ שאין לוקחין לשאר ובגמ' מפרש טעמא: <b>ואין</b>",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ללוקח <i data-commentator=\"Hagahot HaBach\" data-label=\"ח\" data-order=\"8\"></i>אלא דינר.</b> שנתן לטבח: <b>מת ללוקח.</b> ומפסיד הדינר: <b>אינו כן.</b> דבעי משיכה וכל זמן שלא משך חוזר בו הטבח: <b>גמ' בארבעה</b>",
      "segment_ids": [
        23,
        24,
        25,
        26
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פרקים הללו העמידו דבריהם על דין תורה.</b> שקונין לו מעותיו בלא משיכה: <b>דבר תורה מעות קונות.</b> כיון שנתן לו מעות למוכר",
      "segment_ids": [
        26,
        27
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אין א' מהם יכול לחזור דגמרינן מהקדש דכתיב ונתן הכסף וקם לו ומה טעם אמרו משיכה קונה <i data-commentator=\"Hagahot HaBach\" data-label=\"ט\" data-order=\"9\"></i>דאי מוקמת לה לפירי באחריות",
      "segment_ids": [
        27
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלוקח משנתן המעות אי מתרמיא דליקה בבית המוכר שהפירות שם לא טרח לאצולינהו אבל סתם מושך ממטי להו לביתיה וכאן בד'",
      "segment_ids": [
        27
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פרקים הללו לפי שכל אדם רוצה שיגמר קנינו העמידו דבריהם על דין תורה: <b>מתני' היום הולך אחר הלילה.</b> שאם שחט האם",
      "segment_ids": [
        27,
        28
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משמשכה לא ישחוט הבת כל הלילה וכל היום למחרת אבל שחט האם ביום שוחט הבת בלילה דאין הלילה הולך אחר היום: <b>מה יום</b>",
      "segment_ids": [
        28,
        29
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אחד האמור במעשה בראשית היום הולך אחר הלילה.</b> כדכתיב ויהי ערב ויהי בקר ברישא ערב והדר בקר. ובגמרא אמרינן",
      "segment_ids": [
        29
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאיצטריכא להך דרשא משום דקרא דאותו ואת בנו סמיך לענינא דקדשים דכתיב ירצה לקרבן אשה וסמיך ליה אותו ואת בנו",
      "segment_ids": [
        29
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובקדשים לילה הולכת אחר היום דכתיב ביום קרבנו יאכל וגו' ולא תותירו ממנו עד בוקר אלמא לילה שלאחריו קרוי יום קרבנו",
      "segment_ids": [
        29
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עד הבוקר וסד\"א דבאותו ואת בנו נמי נימא הכי מש\"ה איצטרכינן למגמר ממעשה בראשית: <b>הדרן</b> עלך אותו ואת בנו",
      "segment_ids": [
        29,
        30
      ]
    }
  ],
