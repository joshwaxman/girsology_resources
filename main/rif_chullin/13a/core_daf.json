  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אי קופא לבר.</b> אם הראש העב שלה שהיא נקובה בו יוצא לחלל הבהמה וחודה שקורין פונט\"א לתוך הכבד נקובי נקיב וטרפה דודאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דרך הושט נכנסה תחלה ונקבה הדקין ויצאה ונכנס פיה לכבד שאם דרך הקנה נכנסה לא היה אפשר לה לנקוב דרך קופא: <b>ואי קופא</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לגו.</b> אם ראשה העב נחבא בתוך הכבד וחודה יוצא לתוך חלל הבהמה ודאי סמפונא נקט ואח\"כ נקב חודה את הסמפון ויצא לכבד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וממנו לחוץ. ומקשו הכא ונהי דדרך הקנה נכנסה כיון שחודה יוצא לחוץ היאך כשרה ליחוש שמא בחודה נקבה אחד מן האברים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנקובתן במשהו וכדאמרי' בקוץ",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עד שתנקב לחלל ואפילו בבדיקה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא מתכשרה שרש\"י ז\"ל כתב שם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבי קוץ שיש לחוש עליו שמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניקבו הדקין ובבדיקה אי אפשר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שאין נקב דק ניכר בהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תירץ הרשב\"א ז\"ל שאפשר שלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרו אלא בקוץ שנוקב בכח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מבחוץ ונכנס מדוחק ומש\"ה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוששין שמא עם כניסתו בדוחק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקב אחד מן האברים שנקובתן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במשהו אבל במחט שהוא נכנס",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנחת אין חוששין לכך. וראיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדבר דהא נשתברו מיעוט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צלעותיה כשרה ולא חלקו בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השברים כלפי חוץ או כלפי פצים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא חיישינן שמא ראשי השברים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקבו אחד מן האברים הפנימים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג דבקוץ חיישינן ומן הטעם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכתבנו אבל יש מי שכתב דאילו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוצאה חודה של מחט לחוץ אפי'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרך קנה אתאי טרפה מדאמרינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקוץ עד שתנקב לחלל וכי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן קופא לבר וקופא לגו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלפי בר וכלפי גו קאמרינן:",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אבל בחלישתא ל\"ש קופא לגו</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ול\"ש קופא לבר נקובי נקיב</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואתאי.</b> משום דקלישתא נוקבת גם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כן דרך קופא הילכך כיון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[שאפשר] דדרך ושט אתאי תולין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו וטרפה לפי שדרכו לבלוע ואף",
      "segment_ids": [
