        1,
        2,
        3,
        4,
        5
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כמוכר אלמא אע\"ג דלא פש ליה גביה מידי",
      "segment_ids": [
