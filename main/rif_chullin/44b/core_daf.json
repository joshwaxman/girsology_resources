        1,
        2,
        3,
        4,
        5
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "חסדא כל היכא דמשתרשי ליה כה\"ג חייב וכי",
      "segment_ids": [
