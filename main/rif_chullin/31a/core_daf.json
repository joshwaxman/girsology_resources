    {
      "width": "655px",
      "right": "0px",
      "text": "<i class=\"footnote\">רב</i> <i class=\"footnote\">כהנא</i> <i class=\"footnote\">ואיתימא</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">יהודה</i> <i class=\"footnote\">כו'</i> <i class=\"footnote\">(ג\"א)</i> ואמר אביי ואיתימא רב יהודה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>חמשה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "קרמי הוו תלתא משום תרבא ותרי משום דמא דטחלא ודכפלי ודכוליאתא משום",
