  },
  "gemara": [
    {
      "width": "377px",
      "right": "275px",
      "text": "<big><strong>ואמרינן</strong></big>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "377px",
      "text": "יצחק ושמעון ואושעיא אמרו",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הלכה כרבי יהודה בפרדות",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "והילכתא כר' יהודה דאמר אין",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "חוששין לזרע האב ואיכא מ\"ד אם",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מתברר שהוא אביו ודאי אין",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שוחטין אותו ואת בנו ביום אחד",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דהא אמר שמואל הלכה כחנניא",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ומסתבר דליתא דחנניא: ואותו",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ואת בנו נוהג בבהמה ואינו",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "נוהג בחיה ובעוף דתנו רבנן",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ספרא פרשת אמר פרשתא ח</i>ושור",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ושה שור ולא חיה (<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת מ\"ז</i>שה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ולא עוף) והלא דין הוא ומה אם",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "בהמה שאינה במצות כסוי הדם",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הרי היא במצות אותו ואת בנו",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "חיה שהיא במצות כסוי הדם אינו",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דין שתהא במצות אותו ואת בנו",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ת\"ל שור ולא חיה שה ולא עופות",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "והלא דין הוא ומה אם בהמה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שאינה באם על הבנים הרי היא",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "במצות אותו ואת בנו עוף שהוא",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "באם על הבנים אינו דין שיהא",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "במצות אותו ואת בנו תלמוד",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לומר שה ולא עופות:",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    }
  ],
  "rashi": [
    {
      "width": "1010px",
      "text": "<b>ואמרינן יצחק ושמעון ואושעיא אמרו הלכה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "כר' יהודה בפרדות.</b> בסוף שני דייני גזירו'",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "(דף קיא:) אמרינן הכי. ובגמרא פשטינן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "בעיין דלר' יהודה ספוקי מספקא ליה מדאמר",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "450px",
      "text": "רב הונא בריה דרב יהושע הכל מודים בפרי עם",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "האם שאסור מדמסקינן הכי אע\"ג דבגמרא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אמרינן לעיל מיניה זו דברי רבי יהודה דאמר",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אין חוששין לזרע האב ואפ\"ה פשטי' דכי אמר",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אין חוששין היינו לומר שאין מקילין בכך",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "להתיר כל מיני פרדות אף על פי שאין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אמותיהן שוות ומיהו לחומרא חיישינן לזרע",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "האב ואסרינן פרד עם האם ומסתברא נמי דכי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אמרינן בדרבי אבא קסבר אין חוששין לזרע",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "האב <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>[ה\"נ קאמר קסבר דילמא אין חוששין לזרע",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "האב] ומש\"ה הוה בעי דלידמו כודניאתא להדדי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דאילו הוה פשיטא ליה דחוששין לזרע האב",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כלהו כודניאתא לישרו שבכולן יש צד חמור",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "וצד סוס ואינן כלאים זו בזו אלא ספוקי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מספקא ליה ומש\"ה הוה בעי דלידמו אהדדי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ומיהו משום דלא הוה פשיטא ליה דאין חוששין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לזרע האב לא שרא אלא כודניתא בהדי כודניתא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אבל לא כודניתא בהדי סוסים וחמורים דמינא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דאימייהו לא דדילמא חוששין לזרע האב והוו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כלאים. הילכך לענין הלכה נקיטינן דמספקא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לן אם חוששין לזרע האב או לא דאע\"ג דפסק",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שמואל כחנניא דפשיטא ליה דחוששין לזרע האב",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לא קי\"ל הכי מדאמרי' בפ' שני דייני גזירות",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "יצחק ושמעון ואושעיא אמרו הלכה כר' יהודה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בפרדות וכיון דאסיקנא בגמרא דר' יהודה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ספוקי מספקא ליה וקי\"ל כותיה נקיטינן דפרד",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "עם האם אסור ובעובדא דר' אבא נמי מסקינן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אלמא קסבר אין חוששין לזרע האב ונקיטינן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נמי דאותו ואת בנו נוהג בין בזכרים ובין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בנקבות לחומרא וכן פסק הר\"ם במז\"ל לענין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אותו ואת בנו בפי\"ב מהלכות שחיטה ולענין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כלאים בפרק ט\"ז מהלכות כלאים. ושמעינן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מינה נמי דקי\"ל כרב משרשיא דאמר לעיל בפ'",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בהמה המקשה [דף עה:] לדברי האומר חוששין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לזרע האב בן פקועה הבא על הבהמה מעלייתא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הולד אין לו תקנה דהא אסיקנא דמספקא לן אי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "חוששין לזרע האב או לא והא דאמר רב משרשיא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לדברי האומר חוששין לאו לאפוקי מדרבי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "יהודה קאמר דהא לדידיה נמי חוששין מספיקא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אלא לאפוקי מת\"ק דחנניא קאמר דפשיטא ליה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דאין חוששין לזרע האב כדקאמר בהדיא נוהג",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בנקבות ואינו נוהג בזכרים ולפי זה שלשה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מחלוקות יש בדבר ת\"ק דאותו ואת בנו פשיטא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ליה דאין חוששין לזרע האב וחנניא פשיטא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ליה דחוששין ורבי יהודה מספקא ליה אי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דרשינן קראי כת\"ק או כחנניא ומש\"ה ס\"ל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דחוששין ואין חוששין לחומרא הילכך אותו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ואת בנו נוהג בזכרים ופרד עם האם אסור ובן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "פקועה הבא על בהמה מעלייתא הולד אין לו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "תקנה דדילמא חוששין לזרע האב והנולדים מן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הסוס עם הנולדים מן החמור אסורין דדילמא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אין חוששין לזרע האב ולא נראה כן מדברי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הרי\"ף ז\"ל שהרי דחה דברי חנניא לגמרי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "באותו ואת בנו. לפיכך כתב הרמב\"ן ז\"ל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דליכא הכא אלא שני מחלוקות דת\"ק דחנניא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "רבי יהודה הוא דר' יהודה בעלמא הוא דמספקא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ליה אבל לענין אותו ואת בנו פשיטא ליה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דאין חוששין לזרע האב מדרשא דקראי ומאי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דמספקא ליה לר' יהודה בעלמא היינו טעמא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
