    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישראל מעובד כוכבים ובגמ'",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דייקינן דשלימה אין חתוכה לא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמא ימכרנה לישראל ויהא סבור",
