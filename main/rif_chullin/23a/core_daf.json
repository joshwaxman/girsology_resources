      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרחיך בעינן שיהא שמו חגב דאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא היכי דריש להו לקראי לא",
      "segment_ids": [
