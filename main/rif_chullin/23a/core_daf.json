        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רוב היקפו אמר רב פפא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>הילכך בעינן רוב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארכו ורוב היקפו: ת\"ר אין לו עכשיו",
