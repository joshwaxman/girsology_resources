      "right": "275px",
      "text": "י״א:כ״א) אשר לו כרעים ממעל לרגליו אף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על פי שאין לו עכשיו ועתיד לגדל אחר",
