      "right": "0px",
      "left": "",
      "text": "אלמא תנא דמתניתין בראשו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[ארוך] כתנא דבי רבי ישמעאל",
      "segment_ids": [
