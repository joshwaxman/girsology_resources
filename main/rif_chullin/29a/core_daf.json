      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסחים (דף קא:) חברים שהיו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסובין ועקרו רגליהם לצאת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכו' אבל לא הניחו שם זקן או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חולה כשהם יוצאין טעונין ברכה",
