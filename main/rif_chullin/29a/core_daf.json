        1,
        2,
        3,
        4
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "של ברכה שוה מ' זהובים.</b> מפני שיש בו ד'",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ברכות לכל ברכה עשרה זהובים: <b>וה\"ה למצוה",
