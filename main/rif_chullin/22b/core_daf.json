      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסור ושמואל ואיתימא רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוחנן אמר מותר ורב ורבי",
      "segment_ids": [
