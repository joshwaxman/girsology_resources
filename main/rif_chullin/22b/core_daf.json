      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העולם שרו אע\"פ שלא נתפתחו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עיניהם אבל היכא דלא יצאו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאויר העולם הא אמרינן דאפילו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבנן מודו דאסירי: <b>אמר חזקיה</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מנין לביצת טמאה שאסורה מן</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>התורה שנאמר ואת בת היענה וכי</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בת יש ליענה.</b> והלא מטלת",
