      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בן יעקב אומר אף בחול אסור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפי שלא נתפתחו עיניו אלמא",
      "segment_ids": [
