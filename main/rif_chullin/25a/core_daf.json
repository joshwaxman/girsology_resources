    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משמע בזבחים בפ' טבול יום (דף",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קג:) דתנן התם א\"ר חנינא סגן",
      "segment_ids": [
