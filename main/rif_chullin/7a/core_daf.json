        1,
        2,
        3,
        4,
        5,
        6
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דהואיל ושחיטתן כאחת ועל כרחך אי בשניה",
      "segment_ids": [
