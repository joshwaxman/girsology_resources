        1,
        2,
        3,
        4,
        5,
        6
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "והחיצונה אסורה ואפשר ששתיהן אסורות",
      "segment_ids": [
