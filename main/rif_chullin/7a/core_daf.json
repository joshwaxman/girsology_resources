        1,
        2,
        3,
        4,
        5,
        6
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דרס אף בראשונה נמי דרס שהרי בבת אחת",
      "segment_ids": [
