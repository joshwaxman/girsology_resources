        1,
        2,
        3,
        4,
        5,
        6
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דהיינו שיעור שלשה צוארין כתבו בתוס' שאם",
      "segment_ids": [
