    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מטמאה באהל וא\"ת מעשה דעלי מפרקת בלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רוב בשר הוה זקנה שאני דכתיב (שמואל א",
