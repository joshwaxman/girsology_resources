  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גרסי' בגמ' [דף יט.] הגרים שליש.</b> כלומר שהתחיל לשחוט למעלה ממקום שחיטה: <b>ושחט</b> שליש והגרים שליש רב הונא אמר כשרה רב",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יהודה אמר טרפה רב הונא אמר כשרה כי נפקא חיותא בשחיטה קא נפקא ורב יהודה אמר טרפה בעינן רובא בשחיטה וליכא. שחט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שליש והגרים שליש ושחט שליש רב יהודה אמר כשרה אתו שיילוה לרב הונא אמר להו טרפה. וה\"פ דרב הונא ורב יהודה בהא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פליגי דרב הונא סבר דהגרמה כמקום הראוי לשחיטה וכנשחט שלא בהכשר דמי והוה ליה כחצי הקנה פגום הילכך הכל תלוי בחתיכת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רובו של קנה שאם נגמר בשחיטה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשר ואם נגמר בהגרמה פסולה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומש\"ה מכשיר בהגרים שליש ושחט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שליש והגרים שליש וטריף בשחט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שליש והגרים שליש ושחט שליש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ורב יהודה סבר דהגרמה לאו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמקום שחיטה דמיא אלא כמקום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טרפות וכל זמן שנגרם רוב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסורה לא נגרם רוב אינה אסורה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחמת אותה חתיכה ומיהו כיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלאו מקום שחיטה הוא בעי' רוב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קנה בשחיטה בין בתחלה בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסוף ומש\"ה טריף בהגרים שליש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושחט שליש והגרים שליש ומכשיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשחט שליש והגרים שליש ושחט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שליש: <b>ולענין</b> הלכה הרמב\"ם ז\"ל",
