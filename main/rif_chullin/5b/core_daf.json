        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחיטתו כשרה ורובו של אחר כמוהו ר'",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אומר עד שישחוט את <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>הורידין",
      "segment_ids": [
        6
      ]
    }
