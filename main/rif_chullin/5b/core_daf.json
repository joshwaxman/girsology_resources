    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלכך נקיטינן כחומרי דתרוייהו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולעולם לא מכשרינן עד דאיכא",
      "segment_ids": [
