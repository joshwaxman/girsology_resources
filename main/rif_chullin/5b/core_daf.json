      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרב הונא סבר דהגרמה כמקום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראוי לשחיטה וכנשחט שלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהכשר דמי והוה ליה כחצי הקנה",
      "segment_ids": [
