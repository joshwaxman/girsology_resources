  "gemara": [
    {
      "width": "377px",
      "right": "275px",
      "text": "<big><strong>מתני'</strong></big>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "377px",
      "text": "(דף צו:) (<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת מ\"ז</i>גיד <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>הנשה",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שנתבשל עם הגידין בזמן שמכירו",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בנותן טעם ואם לאו כולם",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אסורים וכן חתיכה של נבלה ושל",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דג טמא: <b><big>גמ'</big></b> וליבטל ברובא (דף",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ק.) שאני גיד דבריה הוא וכן",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "חתיכה הואיל וראויה להתכבד",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לפני האורחים) דרש רבה <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אי' רבה בר בר חנה (ג\"א)</i>בר רב",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הונא חתיכת נבלה וחתיכת דג",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "טמא עד שתתן טעם ברוטב ובקיפה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "<i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>ובחתיכות",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    }
  ],
  "rashi": [
    {
      "width": "1010px",
      "text": "<b>דרש</b> רבה בר רב הונא חתיכת נבלה וחתיכת דג",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "טמא אנה אוסרת עד שתתן טעם ברוטב ובקיפה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "ובחתיכות ומסקינן בגמרא עלה אוקי רב אמורא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "עליה ודרש כיון שנתן טעם בחתיכה חתיכה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "450px",
      "text": "עצמה נעשית נבלה ואוסרת כל החתיכות כולן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מפני שהן מינה א\"ל רב ספרא לאביי מכדי רב",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כמאן אמרה לשמעתיה כרבי יהודה דאמר מין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "במינו לא בטיל למה לי נותן טעם כי לא נתן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "טעם נמי אמר ליה הכא במאי עסקינן שקדם",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "וסלקו רבא אמר אפילו תימא לא קדם וסלקו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הוי מין במינו ודבר אחר וכל מין במינו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ודבר אחר סלק את מינו כמי שאינו ושאינו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מינו רבה עליו ומבטלו והכי פירושה דרבה בר",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ר\"ה ס\"ל דחתיכת נבלה אע\"פ שנתנה טעם",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בחתיכה אחרת שהיתה בצדה קודם שנער את",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הקדרה או שנתן בה הרוטב ולא היה בה ששים",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ונתנה הנבלה טעם בה ונאסרה ואח\"כ נער את",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הקדרה אין אומרים דכיון שנאסרה זו תחלה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נעשה כחתיכת נבלה עצמה ויצטרך ששים לבטל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "את שתיהן דליתא אלא כיון שנער את הקדרה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בסוף הרי נתפשט טעם הנבלה בכל הקדרה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ולפיכך אנו אסור עד שתתן טעם ברוטב ובקיפה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ובחתיכות כלומר שלא יהא בהם ששים [כנגד]",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "חתיכת הנבלה הא אם יש בהם ששים כנגדה אע\"פ",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שאין בהם ששים כנגד חתיכת הנבלה וחתיכת",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ההיתר שנאסרה תחלה משליך חתיכת הנבלה וכל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "השאר מותר אפילו אותה חתיכה שנאסרה תחלה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ורב פליג ואמר דכיון שנתן טעם בחתיכה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ראשונה שוב אין לה היתר שהרי היא כנבלה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "עצמה וקאמר תו שאוסרת כל החתיכות כולן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אפילו יש בהם ששים כדי לבטל את שתיהן מפני",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שהן מינה דס\"ל לרב כרבי יהודה דאמר מין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "במינו לא בטיל ומש\"ה [פריך] רב ספרא דכיון",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דכר' יהודה ס\"ל למה לן שתעשה חתיכה שניה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נבלה תיפוק ליה דחתיכת נבלה עצמה אוסרת כל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "החתיכות מפני שהן מינה דבשלמא אי לא הוה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ס\"ל כרבי יהודה נפקא מינה דניבעי ששים",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בשתיהן אבל כיון דכרבי יהודה ס\"ל מדקאמר",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דאוסרת כל החתיכות מפני שהן מינה למה אנו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "צריכין שתאסר חתיכה שניה תיפוק ליה דחתיכה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ראשונה אוסרת הכל ומפרקינן בשקדם וסלקו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כלומר שסלק האיסור קודם שיתן החתיכות",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "האחרות בקדרה הילכך נתנה טעם בראשונה הרי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "זו חוזרת ואוסרתן דאי לא במאי מיתסרו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ואשמעינן דחתיכה עצמה נעשית נבלה לאסור",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "חברותיה בפליטתה ורבא שני דאפילו תימא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בשלא קדם וסלקו ואפ\"ה לא מתסרי שארה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "חתיכות אלא משום חתיכת היתר קמייתא דכל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מין ומינו כגון נבלה ושחוטה ודבר אחר כגון",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "תבלין ורוטב מיני דהיתר אינו מבטלו לאיסור",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ולא מוסיף על ההיתר אלא סלקהו כמי שאינו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בקדרה זו ונשארו הנבלה והרוטב ונמצאת נבלה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בטלה ברוטב ובקיפה אם יש בהם ששים כנגדה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הילכך נתנה טעם בראשונה תחלה בעוד שלא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ריבה הרוטב עליה ואח\"כ נתן מים וקיפה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בחתיכות נתוספה חתיכה הראשונה עם הנבלה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ואוסרת הכל מפני שהם מינה ולא מצו חתיכות",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לבטולה ואע\"פ שיש בהן יותר מששים והרוטב",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לבדו אין בו כדי לבטל שניהם ואיכא למידק",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הכא כיון דרב כרבי יהודה ס\"ל למה לי שתתן",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "טעם בחתיכה דהא אפילו במשהו נמי מיתסרא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כיון דמין במינו לא בטיל ועוד לאביי דמוקי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לה בשקדם וסלקו למה לי טעמא דחתיכה עצמה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נעשית נבלה אפילו אי לא אמרינן חתיכה עצמה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נעשית נבלה כיון שנאסרה אותה חתיכה אוסרת",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שאר חתיכות בפליטת אותו איסור משום מין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "במינו ונדחקו בפירוק קושיות הללו ול\"נ דכל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שלא נתן טעם בחתיכה אע\"ג דמיתסר' לא חשיב",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "איסורה למימר בה חתיכה עצמה נעשית נבלה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "וכל שאינה נעשית נבלה אינה אוסרת כל",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "החתיכות כולן דאע\"ג דא\"ר יהודה מין במינו",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לא בטיל לא שמעינן ליה הכי כל שטעם אחר של",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
