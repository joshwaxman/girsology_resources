  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף צו:)\" data-bavli-daf=\"96b\" data-bavli-index=\"0\"></span>(<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת</i> <i class=\"footnote\">מ\"ז</i>גיד <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>הנשה שנתבשל עם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הגידין בזמן שמכירו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בנותן טעם ואם לאו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולם אסורים וכן חתיכה של נבלה ושל דג",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טמא: <b><big>גמ'</big></b> וליבטל ברובא <span class=\"bavli-ref\" data-bavli-ref=\"(דף ק.)\" data-bavli-daf=\"100a\" data-bavli-index=\"1\"></span>שאני גיד דבריה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא וכן חתיכה הואיל וראויה להתכבד לפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האורחים) דרש רבה <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">אי'</i> <i class=\"footnote\">רבה</i> <i class=\"footnote\">בר</i> <i class=\"footnote\">בר</i>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">חנה</i> <i class=\"footnote\">(ג\"א)</i>בר רב הונא חתיכת נבלה וחתיכת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דג טמא עד שתתן טעם ברוטב ובקיפה <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>ובחתיכות",
      "segment_ids": [
        1
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דרש</b> רבה בר רב הונא חתיכת נבלה וחתיכת דג טמא אנה אוסרת עד שתתן טעם ברוטב ובקיפה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ובחתיכות ומסקינן בגמרא עלה אוקי רב אמורא עליה ודרש כיון שנתן טעם בחתיכה חתיכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עצמה נעשית נבלה ואוסרת כל החתיכות כולן מפני שהן מינה א\"ל רב ספרא לאביי מכדי רב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כמאן אמרה לשמעתיה כרבי יהודה דאמר מין במינו לא בטיל למה לי נותן טעם כי לא נתן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעם נמי אמר ליה הכא במאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עסקינן שקדם וסלקו רבא אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו תימא לא קדם וסלקו הוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מין במינו ודבר אחר וכל מין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במינו ודבר אחר סלק את מינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמי שאינו ושאינו מינו רבה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו ומבטלו והכי פירושה דרבה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בר ר\"ה ס\"ל דחתיכת נבלה אע\"פ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנתנה טעם בחתיכה אחרת שהיתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בצדה קודם שנער את הקדרה או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנתן בה הרוטב ולא היה בה ששים ונתנה הנבלה טעם בה ונאסרה ואח\"כ נער את הקדרה אין אומרים דכיון שנאסרה זו תחלה נעשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כחתיכת נבלה עצמה ויצטרך ששים לבטל את שתיהן דליתא אלא כיון שנער את הקדרה בסוף הרי נתפשט טעם הנבלה בכל הקדרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולפיכך אנו אסור עד שתתן טעם ברוטב ובקיפה ובחתיכות כלומר שלא יהא בהם ששים [כנגד] חתיכת הנבלה הא אם יש בהם ששים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כנגדה אע\"פ שאין בהם ששים כנגד חתיכת הנבלה וחתיכת ההיתר שנאסרה תחלה משליך חתיכת הנבלה וכל השאר מותר אפילו אותה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חתיכה שנאסרה תחלה ורב פליג ואמר דכיון שנתן טעם בחתיכה ראשונה שוב אין לה היתר שהרי היא כנבלה עצמה וקאמר תו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאוסרת כל החתיכות כולן אפילו יש בהם ששים כדי לבטל את שתיהן מפני שהן מינה דס\"ל לרב כרבי יהודה דאמר מין במינו לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בטיל ומש\"ה [פריך] רב ספרא דכיון דכר' יהודה ס\"ל למה לן שתעשה חתיכה שניה נבלה תיפוק ליה דחתיכת נבלה עצמה אוסרת כל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "החתיכות מפני שהן מינה דבשלמא אי לא הוה ס\"ל כרבי יהודה נפקא מינה דניבעי ששים בשתיהן אבל כיון דכרבי יהודה ס\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מדקאמר דאוסרת כל החתיכות מפני שהן מינה למה אנו צריכין שתאסר חתיכה שניה תיפוק ליה דחתיכה ראשונה אוסרת הכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומפרקינן בשקדם וסלקו כלומר שסלק האיסור קודם שיתן החתיכות האחרות בקדרה הילכך נתנה טעם בראשונה הרי זו חוזרת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואוסרתן דאי לא במאי מיתסרו ואשמעינן דחתיכה עצמה נעשית נבלה לאסור חברותיה בפליטתה ורבא שני דאפילו תימא בשלא קדם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וסלקו ואפ\"ה לא מתסרי שארה חתיכות אלא משום חתיכת היתר קמייתא דכל מין ומינו כגון נבלה ושחוטה ודבר אחר כגון תבלין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ורוטב מיני דהיתר אינו מבטלו לאיסור ולא מוסיף על ההיתר אלא סלקהו כמי שאינו בקדרה זו ונשארו הנבלה והרוטב ונמצאת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נבלה בטלה ברוטב ובקיפה אם יש בהם ששים כנגדה הילכך נתנה טעם בראשונה תחלה בעוד שלא ריבה הרוטב עליה ואח\"כ נתן מים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וקיפה בחתיכות נתוספה חתיכה הראשונה עם הנבלה ואוסרת הכל מפני שהם מינה ולא מצו חתיכות לבטולה ואע\"פ שיש בהן יותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מששים והרוטב לבדו אין בו כדי לבטל שניהם ואיכא למידק הכא כיון דרב כרבי יהודה ס\"ל למה לי שתתן טעם בחתיכה דהא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אפילו במשהו נמי מיתסרא כיון דמין במינו לא בטיל ועוד לאביי דמוקי לה בשקדם וסלקו למה לי טעמא דחתיכה עצמה נעשית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נבלה אפילו אי לא אמרינן חתיכה עצמה נעשית נבלה כיון שנאסרה אותה חתיכה אוסרת שאר חתיכות בפליטת אותו איסור משום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מין במינו ונדחקו בפירוק קושיות הללו ול\"נ דכל שלא נתן טעם בחתיכה אע\"ג דמיתסר' לא חשיב איסורה למימר בה חתיכה עצמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נעשית נבלה וכל שאינה נעשית נבלה אינה אוסרת כל החתיכות כולן דאע\"ג דא\"ר יהודה מין במינו לא בטיל לא שמעינן ליה הכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כל שטעם אחר של היתר מעורב בו. ולענין הלכה במאי דס\"ל לרב כרבי יהודה דאמר מין במינו לא בטיל ודאי לא קי\"ל כותיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דהא קי\"ל [דף צז:] דמין במינו בששים אבל במאי דאמר דחתיכה עצמה נעשית נבלה אע\"פ שנראה מדברי הרב אלפסי ז\"ל דבהא נמי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא קי\"ל כותיה שהרי השמיטה מן ההלכות אינו מחוור דהא אביי ורבא דשקלי וטרו בה משמע דבהא מיהת כותיה ס\"ל ובפ' כל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הבשר גם כן מוכח דקי\"ל דחתיכה עצמה נעשית נבלה כמו שאכתוב שם בס\"ד:",
      "segment_ids": [
        0
      ]
    }
  ],
