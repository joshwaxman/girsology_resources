  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף צו:)\" data-bavli-daf=\"96b\" data-bavli-index=\"0\"></span>(<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת</i> <i class=\"footnote\">מ\"ז</i>גיד <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>הנשה שנתבשל עם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הגידין בזמן שמכירו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בנותן טעם ואם לאו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולם אסורים וכן חתיכה של נבלה ושל דג",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טמא: <b><big>גמ'</big></b> וליבטל ברובא <span class=\"bavli-ref\" data-bavli-ref=\"(דף ק.)\" data-bavli-daf=\"100a\" data-bavli-index=\"1\"></span>שאני גיד דבריה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא וכן חתיכה הואיל וראויה להתכבד לפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האורחים) דרש רבה <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">אי'</i> <i class=\"footnote\">רבה</i> <i class=\"footnote\">בר</i> <i class=\"footnote\">בר</i>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">חנה</i> <i class=\"footnote\">(ג\"א)</i>בר רב הונא חתיכת נבלה וחתיכת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דג טמא עד שתתן טעם ברוטב ובקיפה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>ובחתיכות",
      "segment_ids": [
        1
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דרש</b> רבה בר רב הונא חתיכת נבלה וחתיכת דג טמא אנה אוסרת עד שתתן טעם ברוטב ובקיפה ובחתיכות ומסקינן בגמרא עלה אוקי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רב אמורא עליה ודרש כיון שנתן טעם בחתיכה חתיכה עצמה נעשית נבלה ואוסרת כל החתיכות כולן מפני שהן מינה א\"ל רב ספרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאביי מכדי רב כמאן אמרה לשמעתיה כרבי יהודה דאמר מין במינו לא בטיל למה לי נותן טעם כי לא נתן טעם נמי אמר ליה הכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במאי עסקינן שקדם וסלקו רבא אמר אפילו תימא לא קדם וסלקו הוי מין במינו ודבר אחר וכל מין במינו ודבר אחר סלק את",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מינו כמי שאינו ושאינו מינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבה עליו ומבטלו והכי פירושה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרבה בר ר\"ה ס\"ל דחתיכת נבלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"פ שנתנה טעם בחתיכה אחרת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיתה בצדה קודם שנער את",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקדרה או שנתן בה הרוטב ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה בה ששים ונתנה הנבלה טעם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בה ונאסרה ואח\"כ נער את הקדרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין אומרים דכיון שנאסרה זו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תחלה נעשה כחתיכת נבלה עצמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויצטרך ששים לבטל את שתיהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דליתא אלא כיון שנער את הקדרה בסוף הרי נתפשט טעם הנבלה בכל הקדרה ולפיכך אנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אסור עד שתתן טעם ברוטב ובקיפה ובחתיכות כלומר שלא יהא בהם ששים [כנגד] חתיכת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הנבלה הא אם יש בהם ששים כנגדה אע\"פ שאין בהם ששים כנגד חתיכת הנבלה וחתיכת ההיתר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנאסרה תחלה משליך חתיכת הנבלה וכל השאר מותר אפילו אותה חתיכה שנאסרה תחלה ורב פליג ואמר דכיון שנתן טעם בחתיכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ראשונה שוב אין לה היתר שהרי היא כנבלה עצמה וקאמר תו שאוסרת כל החתיכות כולן אפילו יש בהם ששים כדי לבטל את שתיהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפני שהן מינה דס\"ל לרב כרבי יהודה דאמר מין במינו לא בטיל ומש\"ה [פריך] רב ספרא דכיון דכר' יהודה ס\"ל למה לן שתעשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חתיכה שניה נבלה תיפוק ליה דחתיכת נבלה עצמה אוסרת כל החתיכות מפני שהן מינה דבשלמא אי לא הוה ס\"ל כרבי יהודה נפקא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מינה דניבעי ששים בשתיהן אבל כיון דכרבי יהודה ס\"ל מדקאמר דאוסרת כל החתיכות מפני שהן מינה למה אנו צריכין שתאסר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חתיכה שניה תיפוק ליה דחתיכה ראשונה אוסרת הכל ומפרקינן בשקדם וסלקו כלומר שסלק האיסור קודם שיתן החתיכות האחרות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בקדרה הילכך נתנה טעם בראשונה הרי זו חוזרת ואוסרתן דאי לא במאי מיתסרו ואשמעינן דחתיכה עצמה נעשית נבלה לאסור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חברותיה בפליטתה ורבא שני דאפילו תימא בשלא קדם וסלקו ואפ\"ה לא מתסרי שארה חתיכות אלא משום חתיכת היתר קמייתא דכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מין ומינו כגון נבלה ושחוטה ודבר אחר כגון תבלין ורוטב מיני דהיתר אינו מבטלו לאיסור ולא מוסיף על ההיתר אלא סלקהו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כמי שאינו בקדרה זו ונשארו הנבלה והרוטב ונמצאת נבלה בטלה ברוטב ובקיפה אם יש בהם ששים כנגדה הילכך נתנה טעם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בראשונה תחלה בעוד שלא ריבה הרוטב עליה ואח\"כ נתן מים וקיפה בחתיכות נתוספה חתיכה הראשונה עם הנבלה ואוסרת הכל מפני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהם מינה ולא מצו חתיכות לבטולה ואע\"פ שיש בהן יותר מששים והרוטב לבדו אין בו כדי לבטל שניהם ואיכא למידק הכא כיון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דרב כרבי יהודה ס\"ל למה לי שתתן טעם בחתיכה דהא אפילו במשהו נמי מיתסרא כיון דמין במינו לא בטיל ועוד לאביי דמוקי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לה בשקדם וסלקו למה לי טעמא דחתיכה עצמה נעשית נבלה אפילו אי לא אמרינן חתיכה עצמה נעשית נבלה כיון שנאסרה אותה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חתיכה אוסרת שאר חתיכות בפליטת אותו איסור משום מין במינו ונדחקו בפירוק קושיות הללו ול\"נ דכל שלא נתן טעם בחתיכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אע\"ג דמיתסר' לא חשיב איסורה למימר בה חתיכה עצמה נעשית נבלה וכל שאינה נעשית נבלה אינה אוסרת כל החתיכות כולן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאע\"ג דא\"ר יהודה מין במינו לא בטיל לא שמעינן ליה הכי כל שטעם אחר של היתר מעורב בו. ולענין הלכה במאי דס\"ל לרב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כרבי יהודה דאמר מין במינו לא בטיל ודאי לא קי\"ל כותיה דהא קי\"ל [דף צז:] דמין במינו בששים אבל במאי דאמר דחתיכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עצמה נעשית נבלה אע\"פ שנראה מדברי הרב אלפסי ז\"ל דבהא נמי לא קי\"ל כותיה שהרי השמיטה מן ההלכות אינו מחוור דהא אביי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ורבא דשקלי וטרו בה משמע דבהא מיהת כותיה ס\"ל ובפ' כל הבשר גם כן מוכח דקי\"ל דחתיכה עצמה נעשית נבלה כמו שאכתוב שם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בס\"ד:",
      "segment_ids": [
        0
      ]
    }
  ],
