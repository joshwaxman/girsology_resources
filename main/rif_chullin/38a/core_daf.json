  "rashi": [
    {
      "width": "1010px",
      "text": "<b>מתני' צורר אדם בשר וגבינה.</b> ואין חוששין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "שמא יתן אחד לחברו ויפשע ויאכל כיון שאין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "מכירין זה את זה כדמוקמינן לה בגמ': <b>גמ'",
