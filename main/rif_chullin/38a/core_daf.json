  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מתני' צורר אדם בשר וגבינה.</b> ואין חוששין שמא יתן אחד לחברו ויפשע ויאכל כיון שאין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מכירין זה את זה כדמוקמינן לה בגמ': <b>גמ' אבל מכירין זה את זה אסור.</b> דמתוך שרגילין",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "זה בזה חיישינן שמא יתן לחברו ויאכל בעוד שאוכל את שלו: <b>מפני הרגל עבירה.</b> שמא יבא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאכלו בבשר: <b>ואם טש כל הפת כולה אסורה.</b> שמא יבא לאכלה בחלב: <b>עד שיוסק התנור.</b> וה\"ה",
      "segment_ids": [
        2,
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דסגי בקנוח יפה דאי משום האי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמבלע ביה ליכא למיחש דהוה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה נותן טעם בר נותן טעם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהיתרא ושרי לדברי מי שסובר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דדגים אפילו נתבשלו בקערה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר לאכלם בכותח כמו שיתבאר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בס\"ד [בסי' תתתנו] אלא דמשום",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאורחיה דתנור בהסקה נקט הכי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואכתוב עוד בזה לפנינו בס\"ד:",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומסקינן</b> דאי שני בהו ועבדינהו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כעין תורא שרי דכיון דשנינהו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מידע ידיע ולא אתי למיטעי:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתני' הכחל קורעו ומוציא את</b>",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חלבו.</b> בגמ' מפרש כיצד קורעו:",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לא קרעו אינו עובר עליו.</b>",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ללקות לא על אכילתו ולא על",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשולו דלאו חלב מיקרי ובגמ'",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש אי איכא (למיחש) איסורא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדרבנן אי לא: <b>הלב קורעו</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומוציא את דמו לא קרעו אינו</b>",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עובר עליו.</b> בלאו וכרת משום",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבכריתות [דף כב.] מוקמינן לה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלב עוף דלית ביה כזית מיהו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איסורא איכא והכי איתא בגמ'",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו טעמא משום דדם הכנוס",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתוכו הוה כדם האברים שלא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירש דשרי לפי שכיון שהוא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכונס בתוכו הרי הוא כמונח",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקופסא: <b>המעלה את העוף עם</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הגבינה על השולחן אינו עובר</b>",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עליו בלא תעשה.</b> מפרשינן בגמ'",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינו בא לידי ל\"ת אפילו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשאכלן כאחד וסתמא כר\"ע דס\"ל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבשר עוף בחלב לא מיתסר אלא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדרבנן: <b>גמ' אינו עובר עליו</b>",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומותר.</b> אינו עובר מדאורייתא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומותר מדרבנן משום דאפילו",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכתחלה באכילה לא מיתסר",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאפילו נסחט ממנו ויצא אמרינן",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמ' דחלב שחוטה לא מיתסר אלא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדרבנן והאי כיון דמובלע ולא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירש אפילו איסור דרבנן ליכא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והאי דאמור רבנן קורעו משום",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סרך בשר בחלב הוא דאמור אי",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי כדי שלא ירגיל בחלב שחוטה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמתסר מדרבנן: <b>קיבה שנתבשלה</b>",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בחלבה.</b> קיבה של טלה או עגל",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיונקים והחלב בתוכן: <b>זה כנוס</b>",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במיעיו.</b> משיצא מדדי בהמה חלב",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא וכחל אינו כנוס במיעיו",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא יצא מדדי הבהמה בחייה אלא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מובלע בבשר הוא ולא בא לכלל",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חלב אלא דלכתחלה בעי קריעה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדרבנן: <b>וסובר</b> רש\"י ז\"ל דכי",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן דאינו עובר עליו ומותר",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא בצלי אבל בקדרה [אפילו",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלא בשר] אסור ולפי זה מתני'",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפי' בצלי מתוקמא דאפילו בצלי",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעי קריעה ובצלי דווקא הוא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרינן דאינו עובר עליו",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומותר אבל בקדרה אסור וא\"ה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פליג עליה דרב נחמן דאמר בגמ'",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לילתא דאמרה ליה דבעיא למטעם",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר בחלב ואיהו אהדר ואמר",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זויקו לה כחלי כלומר שיצלו לה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כחל נפוח כמות שהוא בלא קריעה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמו שנכתוב לפנינו בס\"ד וכיון",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דעבד עובדא בהכי משמע",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דנקיטינן כותיה דקי\"ל מעשה רב",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואילו אנן מסקינן כרב דאמרי'",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עלה תנ\"ה וקשיא הלכתא אהלכתא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפיכך נראה דמתניתין לקדרה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפילו הכי אמר רב אינו עובר",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עליו ומותר דכיון דחלב שחוטה מדרבנן כי האי גוונא בדיעבד שרי: <b>והני מילי שבשלו</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לכחל בחלבו בפני עצמו.</b> דהתם הוא דשרי וכדכתיבנא אבל בשלו עם בשר אסור וכו'.",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והיינו טעמא דבפני עצמו שרי ובהדי בשר אסור לפי שכשהוא מבשלו עם חתיכות אחרות",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקבלות טעם ממנו ואדם טועם בהם טעם בשר בחלב ומחלפי בבשר בחלב ומש\"ה אסורות אפילו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בדיעבד וכיון שנאסרו אוסרות הכחל אבל כחל שבישלו בפני עצמו בין שקרעו או לא קרעו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טעמו שוה והדבר ידוע שטעם חלב שבו מעצמו הוא ומש\"ה בדיעבד שרי:",
      "segment_ids": [
        14
      ]
    }
  ],
