        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זכים ולא עכורין וכשהבועה בריאה ונכרת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעבר אחר היה מעשה ובקע רבינו שמואל",
      "segment_ids": [
