  "gemara": [
    {
      "width": "377px",
      "right": "275px",
      "text": "<big><strong>(דף</strong></big>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "377px",
      "text": "מז.) ואמר רבא הני <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>תרתי בועי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דסמיכן להדדי לית להו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בדיקותא",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אלא טרפה חדא ומתחזיא כתרתי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מייתינן סילוא ובזעינן לה אי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שפכי להדדי חדא היא וכשרה ואי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לא תרתי אינון (<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ס\"א",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אינו</i>ואנקב וסריכי להדדי)",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "וטרפה: ואמר רבא <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>חמשה אוני",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אית לה לריאה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>כד נפח לה ואפה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "כלפי גברא [<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">גי' ד\"ת</i>דנפח לה]",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "תלתא מימינא ותרתי משמאלא אי",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "חסיר אי יתיר אי חליף טרפה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ולית הלכתא כרבא ביתיר אלא אי",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "משכחת יתיר כשרה <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">מדברי הר\"ן",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "נראה של\"ג בהרי\"ף וה\"מ עד",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ובני טרפה גם לא גריס ההוא",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ביני וביני וכו' וצ\"ע</i>והני",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מילי דקיימא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>בדרא דאונא אבל",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ביני <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>וביני טריפה והני מילי",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מגווה (דף מז:) אבל מגבה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אפילו כטרפא דאסא טרפה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    }
  ],
  "rashi": [
    {
      "width": "1010px",
      "text": "<b>ואמר רבא הני תרתי בועי דסמיכן להדדי לית",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "להו בדיקותא.</b> פירש\"י ז\"ל דקים ליה לרבא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "שאינן סמוכות אלא מחמת נקב שהיה בריאה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "והעלה הנקב את הבועות הללו סביביו והר\"ם",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "450px",
      "text": "במז\"ל כתב בפ\"ז מהל' שחיטה שהטעם מפני",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שהדבר קרוב הרבה שיש נקבים ביניהם ואין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "להם דרך בדיקה ואף זו אינו מחוור שהרי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אפשר לנקב שתי הבועות זו מכאן וזו מכאן עד",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שתצא כל הליחה שבפנים ואח\"כ נראה אם יש",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ביניהם נקב לפיכך נראה כדברי מי שפירש",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דכיון דסמוכות זו לזו מתוך שכל אחת דוחקת",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "את חברתה סופו של עור הריאה לינקב והרי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "היא כאילו ניקב מעכשיו: <b>חדא <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>דמתחזיא",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כתרתי.</b> ואם אחת היא ונראה כעין סדק",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "באמצעית ונראית כשתים: <b>ובזעינן לה.</b> באחד",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מצידיה: <b>תלתא מימינא.</b> מימין [הריאה] ותרתי",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "משמאלא. והוא לימין הטבח כשהיא תלויה",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ברגליה ובני מעיה כלפי הטבח: <b>אי יתיר",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "טרפה.</b> דסבירא ליה לרבא דכנטול דמי: <b>ולית",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הלכתא כוותיה דרבא ביתרת.</b> אבל בחסיר וחליף",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הילכתא כוותיה דליכא דפליג עליה: <b>וה\"מ",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דיתרת כשרה מקמה.</b> כלומר מגואי א\"נ דקיימן",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בדרא דאוני דהכי אמרינן בגמ': <b>אבל מגבה",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אפי' כטרפא דאסא טרפה.</b> וכתב הר\"ם במז\"ל",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ב\"ח מהל' שחיטה דדוקא כטרפא דאסא טרפה אבל",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "פחות משיעור זה אינה טרפה וכן דעת הרמב\"ן",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ז\"ל הביא ראיה מדגרסינן בפרק מי שמת (דף",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "קמו.) אמר רבא דוקא דינר אבל פחות מדינר",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לא ואקשינן פשיטא אפילו דינר תנן מהו",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דתימא ה\"ה דאפילו פחות מדינר והא דקתני",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דינר אורחא דמילתא קתני קמ\"ל ובפ' היה",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "קורא (דף טו.) נמי גרסינן ואפילו מיל",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ודייקינן מיל הוא דאינו חוזר הא פחות ממיל",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "חוזר אלמא כל שיעורי חכמים כיוצא בזה אע\"ג",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דקתני עלייהו אפילו דוקא נינהו אבל פחות",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מכן לא אבל יש מי שפירש דאפילו פחות מכן",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ואורחא דמילתא נקט:",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    }
  ],
