  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "עד שתפרכס ביד וברגל רבי אליעזר אומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דיה אם זינקה אמר רבי שמעון אף השוחט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בלילה ובשחר עמד ומצא כתלים [מלאים] דם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשרה שזינקה כמדת רבי אליעזר וחכמים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים עד שתפרכס ביד או ברגל או עד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתכשכש בזנבה. אחת בהמה דקה ואחת בהמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גסה. בהמה דקה שפשטה ידה ולא החזירה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פסולה שאינה אלא הוצאת נפש בלבד במה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבדים אמורים שהיתה בחזקת מסוכנת אבל אם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היתה בחזקת בריאה אפילו אין בה אחד מכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הסימנין האלו כשרה: <b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף לז:)\" data-bavli-daf=\"37b\" data-bavli-index=\"0\"></span>היכי דמי מסוכנת",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רב יהודה אמר רב כל שמעמידין אותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואינה עומדת ואפי' היא אוכלת בקעיות רב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הונא בר שלמיא משמיה דרב אמר אפילו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אוכלת קורות: <span class=\"bavli-ref\" data-bavli-ref=\"(דף לח:)\" data-bavli-daf=\"38b\" data-bavli-index=\"1\"></span>אמר רבא הלכתא כי הא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתא דתניא בהמה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>דקה שפשטה ידה ולא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כפפה פסולה במה דברים אמורים ביד אבל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברגל בין שפשטה ולא כפפה בין שכפפה ולא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פשטה כשרה בד\"א בדקה אבל בגסה בין ביד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין ברגל בין שכפפה ולא פשטה בין שפשטה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא כפפה כשרה ועוף אפי' לא ריפדף אלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעינו ולא כשכש אלא בזנבו הרי זה פרכוס:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגרסינן בעבודה זרה בפרקא קמא <span class=\"bavli-ref\" data-bavli-ref=\"(דף טז.)\" data-bavli-daf=\"16a\" data-bavli-index=\"2\"></span>אמר רב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנן בר אבא אמר רב חיה גסה הרי היא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כבהמה דקה לפרכוס: <span class=\"bavli-ref\" data-bavli-ref=\"(דף לח.)\" data-bavli-daf=\"38a\" data-bavli-index=\"3\"></span>אמר רבא פרכוס שאמרו",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בסוף שחיטה: <b><big>מתני'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף לח:)\" data-bavli-daf=\"38b\" data-bavli-index=\"4\"></span><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>השוחט לעובד כוכבים",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחיטתו כשרה ור' אליעזר פוסל אמר רבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אליעזר אפילו שחטה שיאכל העובד כוכבים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחצר הכבד שלה פסולה שמחשבת העובד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כוכבים לעבודת כוכבים אמר רבי יוסי ק\"ו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדברים ומה במקום שהמחשבה פוסלת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במוקדשין אין הכל הולך אלא אחר העובד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקום שאין המחשבה פוסלת בחולין אינו דין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא יהא הכל הולך אלא אחר השוחט: <b><big>גמ'</big></b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<span class=\"bavli-ref\" data-bavli-ref=\"(דף לט:)\" data-bavli-daf=\"39b\" data-bavli-index=\"5\"></span>א\"ר יהודה אמר שמואל הלכה כר' יוסי דסבר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זה מחשב וזה עובד לא אמרי': <b><big>מתני'</big></b> השוחט",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>לשם הרים לשם גבעות לשם ימים לשם נהרות",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשם מדברות שחיטתו פסולה",
      "segment_ids": [
        7
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אם זינקה.</b> כדרך שהבהמות נופחות בגרונם לאחר שחיטה והדם מקלח ומזנק בכח. זינוק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קילוח: <b>השוחט בלילה.</b> בהמה מסוכנת שצריכה פרכוס ולא ידע אי פרכסה אם לאו ולמחר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "השכים ומצא הכותלים של בית שחיטת הצואר מלאים דם כשרה מפני שזינקה. וכמדת ר'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אליעזר. דמכשר לה בזינוק אמרה ר\"ש: <b>אחת בהמה גסה ואחת בהמה דקה.</b> צריכה פרכוס אם",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא מסוכנת: <b>שפשטה ידה.</b> בגמר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחיטה: <b>ולא החזירה פסולה.</b> אם",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היתה מסוכנת לפי שאין זה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרכוס שכן דרכה בצאת נפשה אבל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גסה לאו אורחה בהכי: <b>אפילו</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אין בה אחד מכל הסימנין הללו.</b>",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא זינקה ולא פירכסה: <b>גמ'</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היכי דמי מסוכנת.</b> שהיא צריכה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרכוס: <b>אפילו אוכלת בקעיות.</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר שיש לה כח בשיניה עד",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאוכלת בקעיות דהיינו חתיכות",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של עץ אפ\"ה כיון דאינה עומדת",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסוכנת היא: <b>בהמה דקה שפשטה</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ידה ולא החזירה פסולה.</b> אם היא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסוכנת שדרכה לעשות כן בהוצאת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפש ומוכח בגמ' דהא החזירה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר שהיתה ידה פשוטה וכפפתה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשרה: <b>אבל בגסה וכו'.</b> משום",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דגסה לאו אורחה בהכי וחיותא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא: <b>ריפרף.</b> בציר מכשכש: <b>ולא</b>",
      "segment_ids": [
        9,
        10,
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כשכש אלא בזנבו.</b> הוא הדין",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבהמה דסגי לה בהכי כדתנן",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתני' ואשמעינן הכי בעוף",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרבותא שאפילו עוף שדבר קל",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא לו לכשכש בזנבו הוי פרכוס",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והכי מוכח בגמ': <b>ופרכוס שאמרו</b>",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בסוף שחיטה.</b> למעוטי קודם גמר",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחיטה דלא דכל שאינה עושה כן",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסוף שחיטה בידוע שנשמתה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נטולה ממנה קודם לכן: <b>מתני'</b>",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>השוחט לעובד כוכבים שחיטתו</b>",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כשרה.</b> דלא אמרי' סתם מחשבת",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עובד כוכבים לעבודת כוכבים",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון דלא שמעי' דחשיב: <b>ר'</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אליעזר פוסל.</b> כיון דבהמת עובד",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כוכבים הויא אע\"ג דישראל שחיט",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה מהני בה מחשבת עובד כוכבים",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וסתם מחשבתו לעבודת כוכבים:",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חצר כבד.</b> טרפשא דכבדא אוברי\"ש",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלע\"ז: <b>אמר רבי יוסי ק\"ו.</b> דלא",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהניא ביה מחשבת בעלים אע\"ג",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשמעיניה דחשיב כיון דישראל",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחיט ליה: <b>ומה במקום שמחשבה</b>",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>פוסלת במוקדשין.</b> פרש\"י בגמרא",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "[דף לט.] דה\"ק ומה במקום שהמחשבה פוסלת במוקדשין מעבודה לעבודה בארבע עבודות כגון",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שוחט על מנת לקבל או להוליך או לזרוק או להקטיר בפיסול הרי זה פסול ואפ\"ה אין הכל",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הולך אלא אחר העובד שאין הבעלים פוסלין את הקרבן במחשבתן אלא כהן בלבד כדכתיב",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המקריב אותו לא יחשב וקרי ביה לא יחשב: <b>מקום שאין המחשבה פוסלת בחולין.</b> כלומר",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאין המחשבה פוסלת בחולין בכל ד' עבודות אלו אלא בשתים מהן שהשוחט בהמת חולין",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וחשב עליה לזרוק או להקטיר חלבה לעבודת כוכבים פסולה אבל חשב בשחיטתה לקבל דמה או",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "להוליך דמה לא מיפסלא דהולכה וקבלה לעבודת כוכבים לאו כלום נינהו דבקדשים היינו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טעמא דפסלה מחשבת קבלה והולכה משום דכיון דמצות הזבח נינהו חשיבי מעשה אבל בעבודת",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כוכבים לאו כלום וכיון שכן ק\"ו הוא שלא יהא הכל הולך אלא אחר השוחט. והוי יודע",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דזריקה והקטרה נמי דאמרינן דפסלי בעבודת כוכבים דוקא בשחשב עליה בשעת שחיטה לזרוק",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמה ולהקטיר חלבה לעבודת כוכבים אבל נשחטה כראוי שוב אין הבהמה נפסלת אע\"פ שזרק",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמה או הקטיר חלבה לעבודת כוכבים דאע\"ג דבהמת קדשים מיפסלה בד' עבודות התם היינו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טעמא לפי שכולן מכשירי קרבן הן אבל חולין שכל היתירן אינו תלוי אלא בשחיטה מכיון",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שנשחטו כראוי א\"א שיפסלו וזה שלא כדברי רש\"י ז\"ל: <b>גמ' אמר רב יהודה אמר שמואל</b>",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הלכה כרבי יוסי דאמר זה מחשב וזה עובד לא אמרינן.</b> כלומר כשזה שוחט דהיינו עובד",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אין הבעלים פוסלין שחיטתו בשום מחשבה ודקתני במתני' דהשוחט לעובד כוכבים שחיטתו",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כשרה ה\"ה דאפילו לכתחלה אלא דלא מצי למתני שוחטין לעובד כוכבים דאי הכי הוה משמע",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דלמשרי למשחט לעובד כוכבים הוא דאתא דלית ביה משום לפני עור לא תתן מכשול אבל לא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שתהא שחיטתו כשרה לכך הוצרך לשנות שחיטתו כשרה אבל אין הכי נמי דאפילו לכתחלה:",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מתני השוחט לשם הרים וכו'.</b> מפרש בגמ' שחיטתו פסולה לאסור באכילה אבל בהנאה שריא:",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ורמינן עלה בגמ'[דף מ.] פסולה אין זבחי מתים לא.</b> כלומר לאסור בהנאה כדין תקרובת",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עבודת כוכבים שאסור כמת ומת אסור בהנאה כדנפקא לן בע\"ז (דף כט:) מותמת שם מרים",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וגמר שם שם מעגלה ערופה: <b>ורמינהו</b> השוחט לשם הרים לשם גבעות לשם מדברות לשם נהרות",
      "segment_ids": [
        21,
        22
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לשם ימים לשם חמה לשם כוכבים לשם מזלות לשם מיכאל השר הגדול לשם שלשול קטן. כלומר",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לשם דבר גדול שבכל הבריות או אפילו לשם דבר קטן שבכולן: <b>הרי אלו זבחי מתים.</b>",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומפרקינן הא דאמר להר הא דאמר לגדא דהר. והכי פירושא דמתני' בשוחט לשם הר ומש\"ה",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא מיתסרא בהנאה ולאו במתכוין לעבודת כוכבים דאי הכי אפילו בהנאה מיתסרא אלא",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשוחט לשום רפואה או לשם כשפים ודברי הבאי ומשום מראית העין בלחוד הוא ומתסרא",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "באכילה מפני שנראה כמתכוין לעבודת כוכבים אלא לפי שאין דרכן של עובדי כוכבים",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעבוד הרים וגבעות ומדברות לא החמירו לאסרה בהנאה וברייתא דקתני הרי אלו זבחי",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מתים דמשמע דאפילו בהנאה מתסרא מיתוקמא בדאמר לגדא דהר כלומר לשרו של הר שאפילו",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כששחט לשמו לשם רפואה כיון שדרך העובדי כוכבים לעבדו עשאוהו מדבריהם כתקרובת",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עבודת כוכבים ממש וכן נראה פי' זה מדברי הרמב\"ם ז\"ל בפרק ב' מהלכות שחיטה:",
      "segment_ids": [
        23
      ]
    }
  ],
