        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בכותחא דאלמא כרב ס\"ל ואנן לא איסתבירא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לן אלא כדפסקו קמאי ז\"ל והני ראיות דדחו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהו לפסקא דקמאי אית להו דחיאתא דהא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דר\"ש בן לקיש לא הויא ראיה למידחי להא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלוי ורבא דלוי רביה הוה לגבי רשב\"ל ולא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הויא מימרא דריש לקיש קושיא עליה דלוי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ורבא נמי דהוא בתרא הא לא סבירא ליה הא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דר\"ש בן לקיש וקי\"ל דהלכתא כבתראי הילכך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כד מסלקת להאי מימרא דריש לקיש מהכא קאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב כר\"מ ולוי כרבי יהודה וקי\"ל דר\"מ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ורבי יהודה הלכה כרבי יהודה <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>ולא עוד אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבי יוסי נמי לענין ריחא כרבי יהודה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ס\"ל דלא פליג רבי יוסי עליה דרבי יהודה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא בשעורים מפני שהשעורים שואבות גופו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של יין ולאו ריחא הוא אבל בחטים שאינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שואבות כרבי יהודה ס\"ל דריחא לאו מילתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היא ועוד דהא דתניא אין צולין שני פסחים",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאחד <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>כלוי דייקא ורב הא איצטריך לחסורה",
