        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכד דייקת למימריה דרב משכחת ליה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>דשאיך",
