    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא אמרינן התם (פסחים דף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כו.) מוכרי כסות מוכרין כדרכן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובלבד שלא יכוונו בחמה מפני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החמה ובגשמים מפני הגשמים והא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התם ודאי מטי ליה הנאה אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון דלא מיכוין לה לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חשבינן לה מידי אלא ע\"כ",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פלוגתייהו דאביי ורבא בהנאה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאכילה תליא דאביי סבר ריחא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מילתא כלומר דכשמניח פיו עליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושואף הריח הרי הוא כאילו שתה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנו דריחא מילתא היא וכאכילה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חשיבא הילכך אע\"ג דלא מיכוין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלל אסור דקי\"ל (סנהדרין דף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סב:) המתעסק בחלבים ועריות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב שכבר נהנה ורבא סבר ריחא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאו מילתא היא כלומר דלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חשיבא ליה אכילה הילכך כיון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלא מיכוין שרי: <b>ואיכא מאן</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דפליג בהא מילתא וכו'.</b> הרודה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פת חמה מן התנור: <b>אסור לאכלו</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בכותח.</b> מפני חלב שבו: <b>ביניתא</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דאיטויא בהדי בשרא.</b> בתנור אחד",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאלמא כרב ס\"ל ותו דאמר רב",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשי עלה אפילו באפי נפשה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסירא משום דקשה לדבר אחר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר צרעת אלמא רב אשי מודה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרבא מפרזיקא אלא דמוסיף עלה:",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הילכך כד מסלקת האי מימרא</b>",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דריש לקיש מהכא.</b> ונימא דליתא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדר\"ל אלא אפילו בפת חמה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחבית פתוחה פליגי אשתכח דקאי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רב כר\"מ דאסר ולוי כרבי יהודה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשרי אפילו בפת חמה וחבית",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פתוחה: <b>דלא</b> פליג ר' יוסי עליה",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דר' יהודה אלא בשעורים מפני",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהשעורים שואבות גופו של יין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולאו ריחא הוא אבל חטים שאין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שואבות כר' יהודה סבירא ליה.",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולישנייהו הכי מוכח דהא ר\"מ",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסיר ולא מפרש טעמא כלל ור'",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יוסי איצטריך לפרושי טעמא אלמא ס\"ל דריחא לאו מילתא היא ושעורים שאני מפני שהן",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שואבות: <b>ועוד דהא דתניא אין צולין שני פסחים כאחד כלוי דייקא.</b> דקתני עלה מפני",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "התערובות ודייקא ההיא מתני' דמפני תערובת גופים קאמר שמא יתחלפו לפי שאין הפסח",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נאכל אלא למי שנמנה עליו מחיים אלמא דוקא מפני תערובת גופין אבל לתערובת טעמים לא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חיישינן אע\"פ שפסח זה נאסר לאותן שנמנו על הפסח האחר: <b>ורב</b> איצטריך לחסורה ולתרוצה",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לטעמיה כדאיתא התם בפ' כיצד צולין (דף עו:): <b>כיון שנתן טעם בחתיכה וכו'.</b> חתיכת",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נבלה שנפלה בקדרה על חתיכה שעומדת על שאר החתיכות ונתנה טעם באותה חתיכה לבדה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והוא מכיר אותה חתיכת נבלה ומסלקה כיון שנתנה טעם באחת מן החתיכות שבקדרה אותה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חתיכה שקבלה טעם נעשית נבלה [כלומר שרואין אותה חתיכה כאילו היא כולה איסור",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כחתיכת נבלה] ואוסרת כל החתיכות מפני שהן מינה והא דאיצטריך למימר חתיכה עצמה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נעשית נבלה משום דבלאו הכי אינה אוסרת שאר חתיכות משום דהוי פליטתה איסור והיתר",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מעורבים זה בזה וכה\"ג לא אמרינן מין במינו לא בטיל אפילו לרבי יהודה ודאמרינן",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כיון שנתן טעם בחתיכה נתן טעם לאו דוקא דכיון דמין במינו לא בטיל לא בעינן נותן",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טעם אלא כל שבלעה חתיכה המותרת מן האסורה סגי ואוסרת: <b>דאמר רבי יהודה אין דם מבטל</b>",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דם.</b> לעיל בפרק כיסוי הדם (דף פז:) גבי דם חיה שנתערב בדם בהמה דס\"ל דאין דם בהמה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מבטל דם החיה אע\"פ שהוא רבה עליו וטעון כיסוי דמין במינו לא בטיל וכיון דס\"ל לרב",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמין במינו לא בטיל כרבי יהודה דינא הוא דלימא דריחא מילתא היא ואסור דריחא משהו",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיהא הוי ולא בטיל לעולם מין במינו הלכך ליתא לדרב כיון דליתא לדרבי יהודה <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>: <b>והא</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דתני רב כהנא פת שאפאה עם הצלי וכו'.</b> וכמו שכתוב בהלכות קצת דברי הרב אלפסי ז\"ל",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בכאן אינן מחוורין דמה שכתב דרב לטעמיה דסבירא ליה דמין במינו לא בטיל אפילו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במשהו ומש\"ה אסר בריחא ליתא דהא אמרינן עלה בגמ' דפלוגתייהו תליא בפלוגתא דפליגי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תנאי בהרודה פת חמה והניחו ע\"פ חבית יין של תרומה שהוא מין בשאינו מינו והוי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בששים לכ\"ע ואמרינן דר\"מ אוסר משום דס\"ל דריחא מילתא היא ורב כר\"מ ועוד דהא אביי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דסבירא ליה נמי כרב אע\"ג דס\"ל דכל איסור שבתורה בששים אלמא כי אמר רב ריחא מילתא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היא לאו משום דס\"ל דמין במינו לא בטיל ומאי דקאמר נמי דלוי לא שרי לכתחלה אלא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בדיעבד ליתא דהתם בפ' כיצד צולין [דף עו:] מוכח דלוי אף לכתחלה קאמר מדמקשינן",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עליה ממתני' דקתני אין צולין שני פסחים כאחד מפני התערובות ולא משני התם לכתחלה",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הוא דלא הא דיעבד שפיר דמי ועוד דגרסינן בירושלמי במס' תרומות מהו לצלות שני",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שפודין אחד של שחוטה ואחד של נבלה בתנור אמר רבי ירמיה בשם רב אסור שמואל בשם לוי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "[אמר] מותר אלמא דלוי אפילו לכתחלה שרי ועוד דרבא דאזיל בשיטתיה דלוי שרי בבת",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תיהא אפילו לכתחלה וכן מ\"ש הרב אלפסי ז\"ל דפת שאפאה עם הצלי הוי כדבר שיש לו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מתירין (וכיון דיש לו מתירין) דאפילו באלף לא בטיל ריחא נמי לא בטיל אינו מחוור",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ב\" data-order=\"2\"></i>שהרי רבא כי אמר ריחא לאו מילתא היא אפילו בפני עצמו קאמר דהא בת תיהא הכי היא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והיאך אפשר דבפני עצמו לאו מילתא וכשנתערב בדבר שיש לו מתירין יאסור תערובתו ועוד",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכשאמרו דבר שיש לו מתירין אפילו באלף לא בטיל לא אמרו אלא במינו אבל שלא במינו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בטל כשאר האיסורין בנותן טעם וראיה לדבר מדתנן בנדרים (דף נב:) הנודר מן הדבר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונתערב באחרים אם יש בו נותן טעם אסור ונדרים דבר שיש לו מתירין הוא כדאיתא בפרק",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הנודר מן הירק (דף נט.) משום דאי בעי מתשיל עלייהו ואפ\"ה צריך נותן טעם אלא שיש",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לי תירוץ בקושיא זו וכתבתיו במסכת נדרים בפרק הנודר מן המבושל [דף נב.] בס\"ד",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומיהו אכתי לא נהירא דהא אשכחן בבשר בחלב דמותר כל היכא דליכא נותן טעם דהא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אמרינן (חולין דף קיא:) דדגים שעלו בקערה שנתבשל בה בשר שמותר לאכול בכותח משום",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דהוה ליה נ\"ט בר נ\"ט ולא אסרינן ליה משום דבר שיש לו מתירין מפני שאפשר לאכול",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הדגים בלא כותח אלמא לא חשיב דבר שיש לו מתירין כיון שנאסר עם כותח לעולם דלא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיקרי דבר שיש לו מתירין אלא כשיש היתר אחר איסורו לגמרי כביצה שנולדה ביום טוב",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומאי דקשיא ליה לרב אלפסי ז\"ל מההיא דתני רב כהנא פת שאפאה עם הצלי אסור לאוכלו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עם הכותח וההיא ביניתא דאיטויא בהדי בשרא ואסרה רבא מפרזיקא לאוכלה בכותחא לא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קשיאן דאפילו אתיא ההיא מתניתא דלא כלוי לא איכפת לן דלוי נמי תנא הוא ותני",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מתניתא ואי משום עובדא דרבא מפרזיקא נמי לא איכפת לן דמימרא דרבא סתם דהוא מריה",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דתלמודא עדיפא לן והא דאמר רב אשי עלה אפילו באפי נפשה נמי אסור משום דקשה לדבר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אחר לאו דמודה לדיניה דרבא מפרזיקא אלא לומר דבלא\"ה מיתסר משום סכנתא ועוד דאפשר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמתניתא דרב כהנא ועובדא דביניתא אפילו לוי מודה בהו משום דכיון שריח הבשר נרגש",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהן הטועם אותן יהא סבור שממשו של בשר נבלע בהם וכי אכיל להו בכותחא מתחזי כבשר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בחלב ומשום הכי אסור מה שאין כן בבשר שחוטה שצלו עם בשר נבלה שאין ריחה וטעמה של",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נבלה נרגש בשחוטה כלל ועוד שאפשר שחומרא הוא שהחמירו בבשר בחלב יותר משאר איסורין",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמשום דלא בדילי אינשי מיניה מפני שכל אחד היתר בפני עצמו החמירו בו יותר משאר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "איסורין כמו שהחמירו בו [דף קג:] שלא להעלותו עם בשר על השלחן משא\"כ בשאר איסורים",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאם אוכל עם העובד כוכבים על השלחן מעלה עליו יין נסך ושאר איסורים הלכך בפת",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאפאה עם הצלי נמי גזרו בו הואיל ויש בו ריח [בשר] שלא לאוכלו בכותח ולאו משום",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דריחא מילתא היא דא\"כ אפילו בפ\"ע תהא אסורה וכדאמרינן (פסחים דף ל:) אין טשין את",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "התנור באליה ואם טש כל הפת כולה אסורה מפני הרגל עבירה שלפי שאדם אופה ממנו בפעם",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אחת לימים הרבה אם אתה מתיר לאוכלו בפני עצמו יבא לאוכלו בכותח אבל כיון שאף בחלב",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אינה אסורה מן הדין דריחא לאו מילתא היא לא אסרוה בפ\"ע דהוה ליה גזירה לגזירה אבל",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאכלה עם חלב אסורה לכ\"ע משום חומרא דבשר בחלב ואפילו לוי ורבא דאית להו דריחא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאו מילתא היא מודו בה:",
      "segment_ids": [
        14
      ]
    }
  ],
