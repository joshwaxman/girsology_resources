  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דרש מרימר הלכתא בין כבדא בין כחלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למישפדינהו בשפודא תותי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>בישרא שרי עילוי",
      "segment_ids": [
        0
