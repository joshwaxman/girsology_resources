        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אסור לחתוך <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>בה רותח צונן אמרי לה בעיא",
      "segment_ids": [
        1
      ]
