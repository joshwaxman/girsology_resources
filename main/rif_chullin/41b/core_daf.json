  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והני מילי חי אבל צלי קליפה בעי.</b> מלמעלה סביב: <b>ואי אית בה פילי.</b> בקעים והוא צלי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא סגי ליה בקליפה לפי שבולע דרך הבקעים וכולו אסור: <b>ואי מתבל בתבלי.</b> התבלין",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שנתבשלו עמו מרככין אותו ונוח לבלוע וכשנפל לכותח היה צמא לבלוע ובלע: <b>וחי וצלי.</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרינן חי היינו צונן וצלי היינו רותח אבל צלי צונן הרי הוא כשאר צונן דעלמא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דסגי ליה בהדחה אלא צלי רותח",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמר ואורחא דתלמודא הכי דקרי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לצלי רותח צלי סתמא כדתנן בפ'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיצד צולין (דף עה:) סכו בשמן",
