      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חם לתוך צונן <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>וצונן לתוך חם.</b>",
