  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והני מילי חי אבל צלי קליפה בעי.</b> מלמעלה סביב: <b>ואי אית בה פילי.</b> בקעים והוא צלי לא סגי ליה בקליפה לפי שבולע דרך",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הבקעים וכולו אסור: <b>ואי מתבל בתבלי.</b> התבלין שנתבשלו עמו מרככין אותו ונוח לבלוע וכשנפל לכותח היה צמא לבלוע ובלע:",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וחי וצלי.</b> דאמרינן חי היינו צונן וצלי היינו רותח אבל צלי צונן הרי הוא כשאר צונן דעלמא דסגי ליה בהדחה אלא צלי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רותח קאמר ואורחא דתלמודא הכי דקרי לצלי רותח צלי סתמא כדתנן בפ' כיצד צולין (דף עה:) סכו בשמן של תרומה אם חי הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ידיחנו ואם צלי יקלוף את",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החיצון והתם ודאי צלי רותח",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמר שאין סכין את הצלי אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעודו רותח כשצולין אותו על",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבי האש ודאמרינן נמי ואי אית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביה פילי [כולו אסור היינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בצלי רותח דאית ביה פילי דאגב",
