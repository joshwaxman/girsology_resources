        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וסתמא כרבי עקיבא דאמר כל</b>",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מידי דמימלך עליה שלוחיה.</b> דבר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו נשמע מן הסתם לא בתוך",
      "segment_ids": [
