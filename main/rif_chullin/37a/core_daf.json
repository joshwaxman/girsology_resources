  "rashi": [
    {
      "width": "1010px",
      "text": "<b>הנודר מן הבשר.</b> כל הנודר אין דעתו אלא אחר",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "לשון בני אדם שהוא קורא שם הדבר כך",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "ואשמעינן דכל מין בשר אדם קורהו בשר חוץ",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "מבשר דגים וחגבים ובגמ' יתבאר עוד",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "450px",
      "text": "בס\"ד: <b>העוף עולה עם הגבינה על השולחן.",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "</b> דקסברי דבשר עוף דרבנן ומש\"ה לא גזרינן",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ביה העלאה אטו אכילה וב\"ה אמרי לא עולה",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ולא נאכל דאע\"ג דלא מיתסר אלא מדרבנן",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אפילו הכי גזרו בהעלאתו דאי לא לא [קיימא]",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "גזרה דאכילה: <b>דבר זה מקולי ב\"ש ומחומרי",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ב\"ה.</b> מדברים שב\"ש מקילין ובית הלל מחמירין",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ואתא תנא לאשמעינן דמשמיה דר' יוסי",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נקיטינן הך פלוגתא דב\"ש וב\"ה דכל האומר",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דבר בשם אומרו מביא גאולה לעולם והכי איתא",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
