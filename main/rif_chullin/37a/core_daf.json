        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דקתני הכא מותר בבשר דגים",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אוקימנא בפרק הנודר מן הירק",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "(שם) כשהקיז דם וכייבין ליה",
