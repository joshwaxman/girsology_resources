        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "רשב\"ג הוא דתניא הנודר מן",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הבשר אסור בכל מיני בשר ובראש",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "וברגלים ובקנה ובלב ובעופות",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ומותר בבשר דגים וחגבים רשב\"ג",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אומר הנודר מן הבשר אסור בכל",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מיני בשר ומותר בראש וברגלים",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ובקנה ובלב ובעופות ואין צריך",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לומר בשר דגים וחגבים וכן היה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "רשב\"ג אומר קרבין לאו בשר",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ואוכליהן לאו איניש ומדסתם <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>לן",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "תנא הכא כר' עקיבא שמעינן",
