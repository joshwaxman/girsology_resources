      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחדא בקדשים וצריכי: <b>גמ'</b> יש",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נוסחי הלכות שכתוב בהן גבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ורובו של אחד כמוהו ודוקא רוב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנראה לעינים והכי איתא בגמרא",
