        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לא אפשר שכבר הוקש לבהמה הא",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "כיצד הכשרו בסימן אחד: (דף",
