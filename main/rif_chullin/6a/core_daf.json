  "rashi": [
    {
      "width": "1010px",
      "text": "<b>רבי יהודה אומר עד שישחוט את הורידין.",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "</b> חוטי הצואר שמקלחין את הדם ואמרי' בגמ'",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "[דף כח:] דלא אמר רבי יהודה הכי אלא בעוף.",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "ומסתברא דלרבי יהודה חתיכת ורידין בשעת",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "450px",
      "text": "שחיטה מעכבת אפילו בדיעבד דהא מתני'",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בדיעבד קתני כדכתיבנא ורבי יהודה עלה קאי",
