      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "כשרה: <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i><b><big>גמ'</big></b> ורובו של אחד כמוהו",
