    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאשמעינן דאחד וחצי לא מהני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרוב כל אחד ואחד: <b>רוב אחד</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בעוף ורוב שנים בבהמה שחיטתו</b>",
      "segment_ids": [
