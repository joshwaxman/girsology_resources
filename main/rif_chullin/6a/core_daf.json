        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושט אין לו בדיקה מבחוץ אלא מבפנים אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה רב יוסף בריה ניבדקיה לקנה ונשחטיה",
