  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "קרירי קרירי לא משום דמטרשי לה אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדקינן לה בפשורי אי מבצבצא טרפה ואי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשרה. <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>גופא אמר רבא האי ריאה דאגלידא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאהינא סומקא כשרה ואמר רבא ריאה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהאדימה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מקצתה כשרה האדימה כולה טרפה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "א\"ל רבינא מאי שנא מקצתה דהדרא בריא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולה נמי הדרא בריא מי לא תניא ושאר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקצים ורמשים עד שיצא מהן דם וכי תימא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האי לשמנה שרצים מדמינן לה דתניא נצרר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדם אע\"פ שלא יצא אי הכי אפילו מקצתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמי אלא לא שנא כלומר בין כולה בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקצתה כשרה. ואשכחינן מאן דאמר בין כולה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין מקצתה טרפה ואנן לא סבידא לן הכי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דהא אמרינן לקמן <span class=\"bavli-ref\" data-bavli-ref=\"(דף מז:)\" data-bavli-daf=\"47b\" data-bavli-index=\"0\"></span>אדומה כשרה מדרבי נתן.",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<span class=\"bavli-ref\" data-bavli-ref=\"(דף מו:)\" data-bavli-daf=\"46b\" data-bavli-index=\"1\"></span>ואמר רבא ריאה שיבשה מקצתה טריפה ועד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמה אמר רב פפי משמיה דרבא כדי שתפרך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בצפורן אבל אינה נפרכת בצפורן כשרה משום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דהדרא בריא. ואמר רבא האי ריאה דקיימא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גילדי גילדי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>אוכמי אוכמי חזותא חזותא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשרה משום דהדרא בריא איכא מאן דפריש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גלדי גלדי דדמו למצורע אוכמי אוכמי דדמו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לכוחלא חזותא חזותא גווני דמתכשרא בהו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ריאה כגון ירוקה ככרתי או אדום: אמר",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמימר משמיה דרבא <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>אין מקיפין בבועי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פירוש היכא דאיכא ריאה דאית בה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>תרתי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בועי חדא נקובה וחדא לא נקובה ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידעינן אי מקמי שחיטה אינקוב אי בתר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחיטה אינקוב לא אמרינן נינקבה להא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחריתי ונחזי אי דמי ניקבא דהאי לניקבא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דהאי אלא כיון דאשתכח חדא דניקבה טרפה:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואמר רבא הני <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>תרתי אוני <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i><sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בס\"י</i> <i class=\"footnote\">איתא</i>",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">דסריכן</i> <i class=\"footnote\">וכ\"ה</i> <i class=\"footnote\">בגמ'</i>דסמיכן להדדי לית להו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדיקותא אלא טרפה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ה\" data-order=\"5\"></i>והני מילי שלא כסדרן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבל כסדרן היינו רביתייהו וכשרה:",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מטרשי לה.</b> מקשין אותה כאבן ואם אין שם נקב בקרום העליון ויש נקב בתחתון מתקרע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "העליון מחמת שהוא קלוש ומים קרים מותחין אותו. ואחרים פירשו דמטרשי לה שמקשין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותה וסותמין הנקב: <b>אלא בדקינן בפושרין.</b> ונופחין אותה אי מבצבצא כלומר שמתנענעין",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המים מחמתה טרפה ואי לא כשרה דהאי דאושא מפני שניקב קרום התחתון והרוח <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>בין שתי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקרומות: <b>והיכא</b> דאינקיבו",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תרוייהו זה שלא כנגד זה יש מי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכתב דבנפיחה סגי לה ואי מפקא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זיקא טריפה ואי לא כשרה: <b>גופא</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אמר רבא האי ריאה דאיגלידא</b>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> אע\"ג דלא מחדשי בה מידי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איידי דבעי לאיתויי הנך כלהו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדר אייתי נמי הא: <b>וכתב</b> הרב",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעל הלכות ז\"ל והוא דלא מפקא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זיקא משמע דסבירא ליה דצריכה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדיקה דכיון דעילאה איגליד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איכא למיחש לתתאה: <b>ואמר רבא</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ריאה שהאדימה וכו' מי לא תניא</b>",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ושאר שקצים ורמשים קטנים.</b>",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כגון צפרדעים והדומה להם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעורן רך חוץ משמנה שרצים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעורן קשה אינו חייב עליהן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשבת עד שתצא מהם טיפת דם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"פ שנצרר הדם והאדים עור",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מבחוץ אין זה לקותא שמתוך",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעורן רך הוא ממהר להאדים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והכא נמי אמאי חשבת ליה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקותא: <b>וכי תימא הא לשמונה</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שרצים מדמינן לה.</b> דתנינן בהו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרק שמונה שרצים (דף קז:)",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נצרר הדם ונאסף במקום אחד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיינו האדים העור מבחוץ אע\"פ",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא יצא הדם וקרי ליה חבורה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינה חוזרת דכיון שהאדים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העור מבחוץ בידוע שנקרע העור",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מבפנים וסופו לינקב ולצאת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והכא נמי להאי קרום דריאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חשבת ליה כעור גמור והכי מפרש",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה התם דבהנך דאית להו עור",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חשיב להו חבלה ובהנך דלית להו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא חשיב חבלה להך צרירת דם:",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אלא לא שנא.</b> דבין כולה בין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקצתה כשרה וכן כתב רש\"י ז\"ל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכן דעת הר\"ם במז\"ל בפ\"ז",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהלכות שחיטה: <b>ואשכחינן</b> מ\"ד",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבין בכולה בין מקצתה טרפה דברי ר\"ת ז\"ל הם והוא עצמו פסק באדומה דכשרה כדרבי נתן",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולפיכך אמר רבינו אפרים דשאני אדומה מהאדימה דהאדימה משמע שהיא אדומה ביותר מחמת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מכה שיש בדופן הריאה אבל אדומה משמע מעצמה ולפום שקלא ועריא דסוגיין לא משמע הכי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכיון דמעיקרא מהדרינן להיתרא דאמרינן מאי שנא מקצתה דהדרא בריא כולה נמי הדרא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בריא וקאמר נמי דלשמנה שרצים ליכא לדמויה דאי הכי אפילו מקצתה נמי ובתר הכי נמי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אסיקנא אלא [ל\"ש] משמע דל\"ש וכשרה קאמר: <b>ריאה שיבשה מקצתה וכו'.</b> כדי שתפרך",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בצפורן. שנתיבשה כ\"כ שהיא נפרכת בצפורן: <b>משום דהדרא בריא.</b> כיון דלא שליט בה אוירא",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכתב בעל הלכות ז\"ל דכבד שיבש כולו ונפרך בצפורן טרפה ומסתברא כותיה דכיון שיבש",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הוה ליה כניטל לגמרי ולא נשתייר ממנו כלום דטרפה ועוד כתב ז\"ל דהיכא <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>דעביא כבדא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חזינן לריאה דידה אי <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>חורא כפי גופנא טרפה ואי סומקא בריא וכשרה ואין עיקר לדברים",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הללו בגמרא: <b>האי ריאה דקיימא גלדי גלדי.</b> קליפות: <b>דדמיא לכוחלא.</b> מלשון הרב אלפסי",
      "segment_ids": [
        10,
        11,
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>הוא דס\"ל דכי משערין בחזותא חזותא כלומר שיש בה גוונין הרבה דווקא בהנך",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "גוונין דמתכשרא בהו ריאה כדאמרינן לקמן ולפיכך פירש דכי מכשרינן באוכמי אוכמי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דוקא דדמי לכוחלא דאמרינן לקמן ככוחלא כשרה לאפוקי כדיותא דאמרינן לקמן דטרפה וכן",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כתב הר\"ם במז\"ל בפ\"ז מהלכות שחיטה דכי מכשרין חזותא דוקא בגווני דמתכשר בהו ריאה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכן פרש\"י ז\"ל וקמ\"ל שאע\"פ שיש בה מראות הללו כיון שאין באחד מהן מראה פסול אין",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תולין בלקותא וכשרה אבל הראב\"ד ז\"ל כתב בהשגות דבמראות הפסולים עסקינן ואעפ\"כ",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כשרה לפי שאין מראה פסול פוסל אלא בכולה אבל במקצתה לא והביא ראיה מדאמר רבא ריאה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיבשה מקצתה טרפה ואם איתא שכל הדברים שפוסלין בריאה אפילו במקצתה פוסלין למה ליה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לפרושי מקצתה גבי יבשה אלא ודאי משום דבשאר מראות בעינן כולה איצטריך למימר גבי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יבשה דאפי' מקצתה פסולה ולא מיחוור דודאי מראות הפוסלות בריאה מחמת נקב הוא דפסלי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר שעתידין הן לינקב הילכך כי היכי דנקב במשהו ה\"נ מראות הפוסלות במשהו והכי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משמע ודאי דלא שנא בין כולה למקצתה מדאמרינן גבי האדימה מאי שנא מקצתה דהדרא בריא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כולה נמי הדרא בריא והא דאיצטריך למימר גבי יבשה מקצתה משום דלכולה לא בעי יובש",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבצמקה בלחוד טרפה דהיינו חרותא דאמרינן לקמן בפירקין והרא\"ה ז\"ל פי' דבמראות",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הפוסלות עסקינן ואפ\"ה כשרה לפי שאינן פוסלות אלא כשהשינוי הוא בעור מחמתו ולא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מחמת המוגלא שבתוכו אבל הכא האי שנוי מראה לא מחמת העור הוא אלא מחמת המוגלא שהיא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהני גילדי דהיינו צמחים משתנה העור מלמעלה ומש\"ה כשרה: <b>אין מקיפין בבועי.</b> דאע\"ג",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרינן לקמן [דף נ.] מקיפין בריאה ה\"מ ריאה אבל כיון שנעשית בה בועא אין מראה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ניכר בה שעשוי להשתנות כל שעה ושמא מראה אחר היה לו ונשתנה: <b>מקיפין.</b> (בריאה) לשון",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקרבין זה לזה כמו אין מקיפין שתי חביות במס' ביצה (דף לב:) וכתב רש\"י ז\"ל דכי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אמרינן אין מקיפין ואסרין לה בדאינקיבא היכא דלא ממשמשא ידא דטבחא ומכלל דבריו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דהיכא דממשמשא ידא דטבחא תלינן בטבחא ולאחר שחיטה ולמדנו מדבריו דאע\"ג דאיכא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ריעותא כה\"ג בריאה דאיכא למימר מחמת בועא אינקיב ומחיים תלי' בטבחא ולקולא: <b>כתב</b>",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בה\"ג האי בועא דקיימא בשפולי דריאה או על אונא אי מהדר ליה בישרא הדרנא דבועא",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אפילו משהו בעלמא כשרה ואי לא חסרה היא וטרפה. וכתב הרב בעל התוספות ז\"ל ודבר",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תימה הוא וגם אין לאסור מטעם דנראה כשתי בועות דהא מכשירינן היכא דשפכי אהדדי מ\"מ",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טוב ליזהר לפי שכל דבריהם דברי קבלה והרב בעל העטור ז\"ל כתב זה המנהג בכל ארץ",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אשכנז להתיר ואין לנו להוסיף על הטרפות: <b>הני תרתי אוני דסמיכן להדדי לית להו</b>",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בדיקותא.</b> לאכשורי דודאי סירכא זו מחמת נקב היא באה שמתוך שהריאה שואבת כל מיני",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משקה המשקה נעשה עב בתוכה ויוצא מעט מעט דרך הנקב ונקפא ונעשה קרום ואע\"פ שהוא",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סותם הנקב ואין מוציא רוח הא קי\"ל [דף מח.] דקרום שעלה מחמת מכה בריאה אינו קרום",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שסופו ליסתר: <b>שלא כסדרן.</b> כגון ב' החיצונות נדבקו בסירכא ממעל לאמצעית או מתחתיה:",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>היינו רביתייהו.</b> וזו מגינה על זו והדרא בריא שמתוך ששוכבות זו על זו אין מתפרקות",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והקרום הולך וחזק אבל כשהן שלא כסדרן זו הולכת לכאן וזו הולכת לכאן והקרום מתפרק",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונסתר כך פרש\"י ז\"ל פירוש לפירושו דכסדרן היינו טעמא דכשרה משום דכיון דהיינו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רביתייהו חברתה מגינה עליה ולא מתפרקא ולא מחמת הקרום בלבד הוא שכשרה דא\"כ ה\"ל",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קרום שעלה מחמת מכה בריאה ואינו קרום אלא משום דדמיא לריאה שניקבה ודופן סותמתה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכשרה [ודוקא סמיכין ולא סריכא] והכא נמי האונא סותמתה. ולפי שיטה זו של רש\"י ז\"ל",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא אומר שאין סירכא בלא נקב ראוי לאסור סירכא תלויה בכל מקום שהיא <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>וכן ראוי",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאסור אפי' כסדרן כל שהסרכא הולכת מגב לגב או מחתוך לגב אפילו מחתוך לחתוך אם",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הסירכא יוצאה בשיפולי דאונא ונסרכה במקום מגולה ממנה טריפה לפי שאפשר שבאותו מקום",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מגולה הוא הנקב ואין האונא סותמת שם וסירכא לא סתמה דה\"ל קרום שעלה מחמת מכה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בריאה. ואיכא למידק א\"כ דכשיש נקב בריאה אפשר לה דהדרא ובריא והדרא ומתכשרה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בסירכא בחברתה מחתוך לחתוך א\"כ אפילו כי ליתא לסרכא כלל ואית בה נקב היכי מתסרא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעולם והא אמרינן לקמן [דף נד.] דבי מנשיא מחו בכוליאתא וקטלי ומחו בגידא דנשיא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומקשינן עלה כיון דחזינן דמייתי בהכי אמאי לא חשיבי בטרפות ומתרצינן גמירי דאי",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מבדרי לה סמי חייא כלומר שאם חובשין סמים במכתה מתרפאת ואע\"ג דהשתא ליתנהו להנהו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סמים מ\"מ מכה זו אין בה כדי להמית כיון שהיתה יכולה לעלות ארוכה הכא נמי כיון",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאותו נקב יכול לבא לידי היתר בסירכא אפילו אין שם סירכא אינו בדין שתהא טריפה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דטריפה לא הויא אלא היכא שאי אפשר שתהא לה תקנה וכדאמרינן בפרק בהמה המקשה (דף",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סח:) גבי בשר שיצא חוץ למחיצתו דכתיב ובשר בשדה טרפה ואמרינן כטרפה מה טרפה כיון",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שנטרפה אין לה תקנה אף בשר כיון שיצא חוץ למחיצתו שוב אין לו תקנה י\"ל אין הכי",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נמי דכל שאפשר להיות לו תקנה אינה טרפה וכל שנטרפה אין לה היתר אלא שאין כל",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הנקבים שוים יש נקב שאין ראוי שתעלה בו סירכא ויש נקב שהוא ראוי שתעלה בו סירכא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בכסדרן וכל שהוא כן כיון שיש לה תקנה לא נטרפה מעולם ואילו היינו בקיאין בכך",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אפילו קודם שתעלה בו סירכא היינו מתירין אותה אלא מפני שאין אנו יודעין אם ראוי",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שתעלה בו סירכא אם לאו אנו אוסרין כל נקב מחמת הספק אבל בשעלתה בו סירכא הוברר",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הדבר שלא נטרפה מעולם זו היא שיטת רש\"י ז\"ל שהוא סובר שאיסור של סרכות מפני שכבר",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ניקבה הריאה אבל אחרים כתבו שטעם איסור הסירכות מפני שהן עתידות להתפרק ולינקב",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עור הריאה וכל שעתיד לינקב כנקוב דמי והיינו טעמא דמפלגינן בין כסדרן לשלא כסדרן",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דשלא כסדרן עשויות להתפרק אבל כסדרן כיון דהיינו רביתייהו לא מפרקי ולפי זה היה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אפשר להתיר סירכא בכסדרן אפילו מחתוך לגב אי נמי מחתוך לשפולי וכן לפי שיטה זו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סירכא תלויה מותרת היא שהרי אינה עשויה להתפרק אלא שהראשונים כתבו שצריכה בדיקה.",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וטעמא דמילתא שאע\"פ שאיי איסור סירכא מחמת נקב שיש בה כבר אפילו הכי כיון דאיכא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סירכא איתיליד בה ריעותא וחוששין לנקב וכ\"כ הרמב\"ם ז\"ל בפי\"א מהלכות שחיטה שיש",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקומות שאוסרים סירכא תלויה ודבר זה גורם להפסיד ממון של ישראל ואיסור גדול יש",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במי שעושה כן ולא נהגו כן בספרד ולא נשמע בצרפת ובמערב אלא בודקין אותה אם היא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלימה מן הנקב וכשרה ע\"כ. והמנהג פשוט להתירה בלא בדיקה וכך נראה לי שכיון שאע",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סומכין להתיר סירכא תלויה על דברי האומרין שאיסור הסירכא מפני שהיא עתידה להתפרק",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כיון שכן כשם שאנו מתירין כסדרן בלא בדיקה שהטעם לפי שיטה זו מפני שאינה עשויה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "להתפרק כך ראוי להתיר סירכא תלויה בלא בדיקה. ויש כאן דרך אחרת לראב\"ד ז\"ל שהוא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אומר דסירכא שלא במקום רביתא ודאי משום נקב הוא ואע\"פ שהיא עולה בנפיחה אומרין",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קרום עלה על אותו נקב אבל כשהסירכא במקום רביתא תולין שמפני דוחק רביצתה עליו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נעשית הסירכא ולא משום נקב ולפי שיטה זו אומר דאונא הסרוכה לדופן אפילו לגרמא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כשרה שהסירכא זו לא מחמת נקב נעשית אלא מפני דוחק רביצתה. ודאמרינן לקמן [דף מח.]",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והוא דסביך בבשרא דמשמע בבשרא ולא בגרמא דוקא בריאה שניקבה ודאי דבעינן סתימה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חזקה דהיינו סביך בבשרא אבל זו לא ניקבה. ולענין כסדרן ושלא כסדרן יש מי שאומר",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכי מכשרינן כסדרן ה\"מ בבדיקה אבל בלא בדיקה אסורה ודייק לה מדאמרינן שלא כסדרן",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לית להו בדיקותא משמע הא כסדרן אית להו בדיקותא אבל בדיקה מיהת צריכה אבל רבינו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האי גאון ז\"ל כתב דכסדרן לא בעיא בדיקה כלל וכן המנהג ולישנא נמי דאמרינן אבל",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כסדרן היינו רביתייהו משמע דכיון דאורחייהו הכי לא בעי בדיקה כלל והאי דנקט בשלא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כסדרן לית להו בדיקותא לאו למימר דכסדרן בעי בדיקה אלא לישנא דוקא נקט דאי הוה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אמר שלא כסדרן טריפה הוה משמע דאיסור הסירכות מחמת עצמן הוא והא ליתא אלא או מחמת",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיש בה נקב עכשיו או מחמת שסופו לינקב משום הכי נקט לישנא דלית להו בדיקותא ואיכא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מ\"ד דכי אמר רבא דשלא כסדרן לית להו בדיקותא דוקא שאינן סרוכות אלא בסירכא אבל",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סמוכות לגמרי אפילו שלא כסדרן כשרה דתו לא מיפרקי ויש מי שכתב בהפך שלא הכשירו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כסדרן אלא בסמוכות לגמרי אבל בסרוכות אפילו כסדרן מפרקי וטריפה ולא כדברי זה ולא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדברי זה אלא בין סרוכה מעט בין סמוכה כולה כסדרן כשרה שלא כסדרן טרפה וכתב רש\"י",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל דשלא כסדרן היינו מראשונה לשלישית ואם בדוקא כתב הרב ז\"ל לא משכחת תרתי אוני",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלא כסדרן אלא בימינא דאיכא תלתא אבל בשמאלא דליכא אלא תרתי אוני בכל ענין כשרה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל הרב הנשיא אלברגילוני כתב דאפילו בתרתי דסמיכי להדדי משכחת לה שלא כסדרן כגון",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהסירכא מגב לגב או מחתוך לגב וכסדרן מיקרי כגון שאין הסירכא אלא במקום חבור שתי",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האונות דהיינו מחתוך לחתוך וכן כתבו הגאונים ז\"ל ואחרים מוסיפין עוד לומר דלא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיקרי כסדרן אלא בסירכא ישרה אבל אם הולכת באלכסון מראשה של אונא זו לסופה של",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אחרת אפילו מחתוך לחתוך דסמוכה לה טרפה דכל שהיא כן סופה להתפרק וזו היא חומרא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יתירא והמנהג בזה להתיר אבל מגב לגב וכן מחתוך לגב ומשיפולי האונות לשיפולי וכן",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מחתוך לשיפולי ראוי לאסור כמו שכתבנו טעמו של דבר למעלה לפי שיטת רש\"י ז\"ל. ואונא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הסמוכה לאומא שאצלה בכסדרן דהיינו מחתוך לחתוך כתב רש\"י ז\"ל שיש מי שאוסר לפי שלא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מצינו שהתיר רבא בכסדרן אלא באוני הילכך איכא למימר דדוקא באוני שהן עומדות במיצר",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "החזה כדאמרינן לקמן מקום רביתא היינו מקום חתוכא דאוני התם שרי משום דלא מפרקי",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל מאומא לאונא לא אבל הוא ז\"ל כתב בשם רבו דכשרה שגם האומא אונא שמה ובכלל דברי",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רבא הוא ורת\"ם ז\"ל מן האוסרין דודאי אין בכלל דברי רבא אומא דאומא לא מקריא אונא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא ריאה שמה שאם האומות בכלל האונות היכי אמרינן בסמוך חמשה אוני אית לה לריאה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שבעה הוו ואעפ\"כ יש לדון כדברי רש\"י ז\"ל דאע\"ג דאומי אינן בכלל דברי רבא משום",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאומא לא מקריא אונא אפ\"ה איכא למימר דה\"ה לאומא ורבא רבותא קמ\"ל דאפי' אוני",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דקיימי במיצר החזה ואיכא למימר כיון דבדוחקא קיימי לא מפרקי אפ\"ה שלא כסדרן טרפה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכ\"ש אומי שהן עומדות בריוח אבל כסדרן כשרה דהיינו רביתייהו ועיקר חידושיה דרבא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאשמועינן איסורא אתא והכי דייק לישנא דפתח ואמר לית להו בדיקותא ומש\"ה נקטה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בתוני לרבותא אבל אין ה\"נ דמאונא לאומא נמי כסדרן היינו רביתייהו וכ\"כ הרב הנשיא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלברגלוני ז\"ל שהגאונים התירו דבר זה בכנופיא:",
      "segment_ids": [
        18
      ]
    }
  ],
