        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אף כל מים גדלים על גבי קרקע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוו להו בורות שיחין ומערות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלל איסורא ולא הוה שרינן",
