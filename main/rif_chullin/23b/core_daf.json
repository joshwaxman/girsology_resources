        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכל אשר במים דרשינן כעין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפרט מים נובעין ואימעיטו להו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בורות שיחין ומערות להיתרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכי מפרשינן בגמ': <b>דבי רבי</b>",
