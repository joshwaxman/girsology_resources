        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היינו רביתייהו א\"ל רב חסדא לרב הונא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תניא דמסייע לך (ויקרא י״א:מ״ב) <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i>",
