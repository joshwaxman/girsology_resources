      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ישמעאל תנא במים במים שני</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>פעמים וכו'.</b> והואיל ושני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כללות הסמוכים הן כשתטיל פרט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאחריהן ביניהן מדה היא בתורה",
