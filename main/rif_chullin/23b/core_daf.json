      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ריבוי שני לאיתויי כל מידי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואהני מיעוטא למעוטי מידי דלא",
      "segment_ids": [
