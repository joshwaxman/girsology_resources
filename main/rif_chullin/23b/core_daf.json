      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברבוי ומיעוט דלהכי פלגינהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רחמנא לכללא מפרטא דלא תדרשיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלל ופרט ואיכא בין רבוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומיעוט לכלל ופרט דכי דרשינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלל ופרט הוי פרט פירושו של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלל ואין בכלל אלא מה שבפרט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפי' דבר הדומה לו אין לך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להביא וכשכלל לך כלל שני אחר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפרט אהני לאיתויי מידי דדמי",
