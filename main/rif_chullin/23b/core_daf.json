        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפרט מפורש מים נובעין אף כל מים נובעין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאי רבי רבי חריצין <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>ונעיצין לאיסורא",
      "segment_ids": [
        0
      ]
