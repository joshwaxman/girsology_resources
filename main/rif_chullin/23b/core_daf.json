  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והיכן התיר בכלים וכו'.</b> במים כלל בימים פרט במים חזר וכלל מפרשינן בגמרא דהוו שני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כללות הסמוכין זה לזה דכתיב את זה תאכלו מכל אשר במים הרי כלל ראשון כל אשר לו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סנפיר וקשקשת במים הרי כלל שני דמכל חד מהני במים משמע כל מים שבעולם והדר כתיב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פרטא דכתיב בימים ובנחלים דמשמע דדוקא בהני בעינן סימנין והאי פרטא דבימים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובנחלים שדינן ליה בין שני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כללות דהיינו בין שני במים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודיינינן ליה בכלל ופרט ואי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאו רבויא דאת זה תאכלו מכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשר במים הוה אמרינן מה הפרט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפורש מים גדלים על גבי קרקע",
