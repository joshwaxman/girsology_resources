  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> מה שכתב הרי\"ף ז\"ל והיכא דראה אחד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ששחט כתב עליו הרא\"ש ז\"ל לאו דוקא ראה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דהא מייתי ראיה ממצא תרנגולת שחוטה בשוק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא משום דבעי לסיומי ואזיל ליה לעלמא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולאשמועינן דאי לא אזיל לעלמא לא סמכינן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ארוב מצויין אצל שחיטה מומחין הן ובעי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למבדקיה וראה אחד ששחט דקאמר פי' שראהו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מרחוק ולא היה יכול לידע אם שחט יפה דאי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוי באחרים רואין אותן אפי' לרבינא נמי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אי ליתיה קמן דלבדקיה שחיטתו כשרה.",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומדברי הרי\"ף אין להוכיח אי בעינן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מוחזקין. ומתוך דבריו משמע דדין אחד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למומחה ומוחזקין היכא דאיתיה לקמן צריך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לבודקו וגם לשאל אם נתעלף והיכא דליתיה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קמן שחיטתו כשרה מההיא דמצא תרנגולת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחוטה בשוק: <b>ב לשון ריא\"ז</b> מצא תרנגולת",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחוטה בשוק ואינו יודע מי שחטה הרי זו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותרת לפי שרוב מצויין אצל שחיטה מומחין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הן ואין חוששין שמא עובד כוכבים שחטו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין דרכו של עובד כוכבים לשחוט אלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לנחור וכן מי שאבדו לו גדייו ותרנגוליו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומצאן שחוטין בשוק מותרין והוא שמצאן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בבית או בשוק אבל מצאן באשפה שבביתו וכל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שכן באשפה שבשוק אסור שי\"ל מפני שנתנבלו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הושלכו באשפה ורבינו משה אוסר אפי'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשמצאן בשוק ואין שיטת התלמוד כדבריו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בקונט' הראיות. והקשה בא\"ז היאך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נאמין לשוחט והא עד א' אינו נאמן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באיסורין היכא דאיתחזק איסורא ובהמה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחייה בחזקת איסור עומדת והר' אליעזר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממיץ תירץ דהא דאמרי' דעד א' אינו נאמן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היכא דאתחזק איסורא היינו דוקא באנשים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ריקים ופוחזים דומה דשנים שהאמינה תורה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמו שהן ובההיא אין עד א' נאמן אבל בעד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נאמן וכשר סמכינן עליה ואפי' אשה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדאמרי' בפ' בא סימן ר' ישמעאל מוסר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאמו כללו של דבר כל שהוא בחזקת איסור",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מה\"ת אין קטן נאמן ולא אשה ולא גדול דלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מהימן כבי תרי אבל בדרבנן כגון בשר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנמלח שדם מלוח אינו אלא מדרבנן ויין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נסך וכיוצא בו אפי' קטן וכל אדם מהימן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדאמרי' בפ\"ק דפסחים גבי בדיקת חמץ: <b>ג</b>",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        0,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש כתב דקטן מומחה היודע לאמן ידיו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אם גדול עומד על גביו שוחט לכתחלה. בינו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לבין עצמו בדיעבד שחיטתו כשרה והגהות",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אשר\"י בשם א\"ז כתבו דאפי' מומחה ויודע",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאמן ידיו אם אין גדול עומד על גביו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחיטתו פסולה: <b>לשון ריא\"ז</b> ואין מוסרין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לשחוט לכתחלה לחרש שוטה וקטן ואפי' אם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחרים רואים אותם לפי שאינן בני דעת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ודרכן לקלקל וכן הסומא לא ישחוט לכתחלה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואע\"פ שאחרים רואין אותו שמא יקלקל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחיטתו כמבואר בק\"ה. ואם שחט ולא קלקל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחיטתו כשרה ואע\"פ שאין אחרים רואין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותו וכן לא ישחוט אדם בלילה שמא יקלקל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואם שחט ולא קלקל שחיטתו כשרה ואם היתה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבוקה כנגד. שוחט בלילה לכתחלה: כתב",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רש\"י בתשובותיו על דבר העופות שהובאו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחוטין ביד העובד כוכבים בלא סימן ובא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מעשה לפני רבותי והתירו ואין לי ראיה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להתיר דלא נחלקו הכא אלא במקום שהטבחים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רובן ישראל שהרי טעם המתירין לפי שרוב",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מצויין אצל שחיטה מומחין הן ואי בעיר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שרובה עובדי כוכבים אמרו מה לי מומחין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מה לי אינן מומחין הרי שחיטתן נבלה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואחרי שידענו שיש הרבה עובדי כוכבים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וערביים שוחטין ואין שחיטת ישראל ניכרת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בין שחיטתם לא חלקו בין ארמאי לארמאי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואם סמכו על חתוכה דעובד כוכבים מידע",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ידיע בטוח אני שלא באה תקלה ע\"י בהמתן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כ\"ש ע\"י עצמן ומכאן ואילך [אל] ינהגו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כן: <b>ד לשון ריא\"ז</b> ישראל שהוא חשוד לאכול",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        2,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נבלה כשאינו מוצא בשר שחוטה והוא הנקרא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מומר לאכול נבלה לתיאבון הרי ישראל כשר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "(זה) בודק סכינו ונותן לו ומותר לאכול",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משחיטתו ואע\"פ ששחט בינו לבין עצמו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו חשוד לנבל כשיכול לשחוט בהיתר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והוא שיודע הלכות שחיטה ואם לא בדק לו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הסכין קודם שחיטה בודק אחר שחיטה ואם לא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נמצאת פגומה שחיטתו מותרת ואם לא בדק לו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סכין לא קודם שחיטה ולא אחר שחיטה אסור",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאכול משחיטתו לפי שאינו חושש לתקן",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סכינו אם היא פגומה שאינו טורח לחזר אחר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ההיתר כשאינו מצוי לו וכן כל בדיקה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המעכבת השחיטה כגון לבדוק בסימנין אחר",
