      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השחיטה צריך ישראל כשר לבדוק שחיטתו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בק\"ה. היה השוחט מומר לאכול נבלה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להכעיס שאף כשההיתר מצוי לו מניח ואוכל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האיסור אסור לאכול משחיטתו אע\"פ שבדק לו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הסכין אא\"כ היה ישראל כשר עומד על גביו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשעה ששחט ואין צריך שיראהו מתחלה ועד",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סוף אלא אפי' אם היה יוצא ונכנס עליו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הואיל ויודע השוחט הלכות שחיטה ירא הוא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לנבל מפני ישראל כשר הנכנס עליו כמבואר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בק\"ה. היה השוחט הזה מומר לערלות שאינו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רוצה למול או שהיה חשוד לא' משאר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העבירות הרי הוא כישראל כשר לענין שחיטה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאם נחשד לאותה עבירה לא נחשד לשחיטה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולשאר מצות ואם היה מומר לחלל שבת",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בפרהסיא או שהיה מומר לעבודת כוכבים הרי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא מומר לכל התורה כולה ושחיטתו אסורה.",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונראה בעיני שאף המסורות הם כמומר לכל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התורה כולו כמבואר בק\"ה. ורבינו משה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מצריך לבדוק לו סכין למומר לאחת מן",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העבירות ואין שיטת התלמוד כדבריו שלא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נאמר בודק לו סכין אלא במומר לאכול נבלה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לתיאבון שהוא חשוד לאותו דבר כמבואר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בק\"ה. עובד כוכבים ששחט שחיטתו נבלה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הואיל ואינו מצווה על השחיטה הרי שחיטתו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כנחירתו. היו ישראל ועובד כוכבים אוחזים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בסכין זה מצד זה וזה מצד זה ושוחטים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כאחת שחיטתן כשרה שהרי אף בלא כח העובד",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כוכבים היתה נעשית שחיטה זו ע\"י ישראל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בק\"ה: ישראל המומר לכל התורה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כולה אינו כעובד כוכבים לפי שזה מצווה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא על כל המצות כישראל גמור אלא שהוא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
