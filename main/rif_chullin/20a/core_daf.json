  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני'</big></b> <i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>אחוזת דם והמעושנת והמצוננת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושאכלה הרדופני ושאכלה צואת תרנגולים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וששתתה מים הרעים כשרה אכלה סם המות או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנשכה נחש מותרת משום טרפה ואסורה משום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סכנת נפשות: <b><big>גמ'</big></b> אמר שמואל <i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>הלעיטה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חילתית טרפה מאי טעמא משום דמינקיב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למעיה מתיב רב שיזבי אחוזת דם והמעושנת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והמצוננת או שהלעיטה חילתית או שאכלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרדופני או תיעה או שאכלה סם המות או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ששתתה מים הרעים כשרה השיכה נחש או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנשכה כלב שוטה מותרת משום טרפה ואסורה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום סכנת נפשות קשיא חלתית אחלתית קשיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סם המות אסם המות חלתית אחלתית לא קשיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעלין כשרה ודאמר שמואל טרפה בדקרטין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמנקבי למעיה וסם המות אסם המות נמי לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קשיא מתניתין דקתני אסורה משום סכנת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נפשות כשאכלה סם המות דאדם וברייתא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דקתני כשרה בסם המות דבהמה: <span class=\"bavli-ref\" data-bavli-ref=\"(דף נט.)\" data-bavli-daf=\"59a\" data-bavli-index=\"0\"></span><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>ההוא בר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טביא דהוה בי ריש גלותא דאיפסיק כרעא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתרייתא בדקה רב בצומת הגידין ואכשרה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סבר למיכל מינה באומצא א\"ל שמואל לא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייש מר לנקורי א\"ל היכי ליעביד אמר ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותביה בנורא דהוא בדיק נפשיה אותביה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בנורא ואיתמח ונפל תלחי תלחי קרי שמואל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליה דרב (משלי י״ב:כ׳-כ״א) לא יאונה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לצדיק כל און וקרי רב עליה דשמואל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(דניאל ד׳:ו׳) וכל רז לא אנס לך: <b><big>מתני'</big></b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סימני <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>בהמה וחיה נאמרו מן התורה וסימני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העוף לא נאמרו מן התורה אבל אמרו חכמים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל עוף הדורס טמא וכל שיש לו אצבע יתרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וזפק וקרקבן <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>נקלף טהור רבי אליעזר ברבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צדוק אומר כל עוף שחילק את רגליו טמא:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>גמ'</big></b> אמר רב חסדא היה מהלך במדבר ומצא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהמה ופרסותיה חתוכות בודק בפיה אם אין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לה שינים למעלה בידוע שהיא טהורה ואם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאו בידוע שהיא טמאה והוא שיכיר בן גמל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתנא דבי ר' ישמעאל (ויקרא יט) את הגמל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כי מעלה גרה הוא שליט בעולמו יודע שאין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לך דבר שמעלה גרה וטמא אלא גמל לפיכך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרט לך הכתוב הוא. ואמר רב חסדא היה",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מהלך במדבר ומצא בהמה שפיה גמום בודק",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפרסותיה אם פרסותיה סדוקות בידוע שהיא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טהורה ואם לאו בידוע שהיא טמאה והוא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיכיר חזיר דתנא דבי רבי ישמעאל (ויקרא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יט) ואת החזיר כי מפריס פרסה הוא שליט",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעולמו יודע שאין לך דבר שמפריס פרסות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וטמא אלא חזיר לפיכך פרט לך הכתוב הוא.",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וא\"ר חסדא היה מהלך במדבר ומצא בהמה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שפיה גמום ופרסותיה חתוכות בודק בבשרה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אם מהלך שתי וערב טהורה ואם לאו טמאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והוא שיכיר ערוד ודילמא איכא מינא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחרינא דדמי לערוד גמירי דליכא והיכי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדיק אמר אביי ואיתימא רב חסדא בכנפי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העוקץ: <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>אלו הן סימני חיה <span class=\"bavli-ref\" data-bavli-ref=\"(דף נט:)\" data-bavli-daf=\"59b\" data-bavli-index=\"1\"></span>שחלבה מותר כל",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיש לה קרנים וטלפים והרי עז שיש לו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרנים וטלפים וחלבו אסור כרוכות בעינן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והרי שור דכרוכות וחלבו אסור <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בד\"ק</i>",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">ובד\"ס</i> <i class=\"footnote\">הגירסא</i> <i class=\"footnote\">בכל</i> <i class=\"footnote\">הענין</i> <i class=\"footnote\">חדוקות</i>חרוקות",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעינן והרי עז דחרוקות נינהו וחלבו אסור",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפוצלות <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>בעינן והרי צבי דאין מפוצלות",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחלבו מותר הדורות בעינן הילכך כל היכא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאיכא מפוצלות לא בעינן מידי אחרינא לא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיפצלי בעינן <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>חרוקות <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>הדורות וכרוכות",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והוא דמבלעי חרקייהו והיינו ספיקא דעיזא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכרכוז",
      "segment_ids": [
        7
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מתני' אחוזת דם.</b> שאחזה דם וחלתה. והמעושנת. שנכנם עשן בגופה: <b>והמצוננת.</b> חולי מחמת",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הצנה: <b>הרדופני.</b> סם המות לבהמה: <b>מים הרעים.</b> מים מגולים: <b>אכלה סם המות.</b> שהוא סם",
      "segment_ids": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המות לאדם: <b>גמ' הלעיטה חלתית.</b> קורט של חלתית חד הוא ונוקב בני מעים: <b>תיעה.</b> טור\"א",
      "segment_ids": [
        4,
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בלע\"ז ועשב מר הוא מאד וכל אלו קשים לה: <b>כלב שוטה.</b> דאמרינן במסכת יומא (דף פג:)",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רוח רעה שורה עליו וכשנושך",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדם שורה עליו והורגתו: <b>קשיא</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חלתית.</b> דהכא אחלתית דשמואל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקשיא סם המות דהכא אסם המות",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמתני': <b>בסם המות דבהמה.</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו סם המות לאדם: <b>בדקה רב</b>",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בצומת הגידין.</b> צומת הגידין",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשוק הוא סמוך לארכובה ברגלים",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האחרונים: <b>באומצא.</b> אינו צלי",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כ\"כ כבתנור אלא מולחו מאד",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וצולהו כל דהו על הגחלים:",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לנקורי.</b> שמא נשכה נחש שם",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואסורה משום סכנת נפשות:",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>[אותביה</b> בנורא דאיהו בדק",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפשיה. מאליו ע\"י שיתבשל",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יפה]: <b>תילחי תילחי.</b> נתפרק",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חתיכות חתיכות: <b>לא יאונה</b>",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לצדיק כל און.</b> שנזדמנתי לך",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומנעתיך מלאכול: <b>מתני' סימני</b>",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בהמה וחיה נאמרו מן התורה.</b>",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדכתיב זאת החיה וגו'. והיינו",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעלת גרה ומפרסת פרסה ושוסעת",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שסע פרסות: <b>וסימני העוף לא</b>",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נאמרו וכו'.</b> כולה מתניתין",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפרש לקמן בס\"ד: <b>גמ' היה מהלך</b>",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במדבר.</b> ומצא בהמה שפרסותיה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חתוכות ואינו יכול לבדוק אם",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא מפרסת פרסה בודק בפיה אם",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין לה שינים למעלה בידוע",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיא טהורה לפי שהיא מעלת גרה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם לאו בידוע שהיא טמאה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינה מעלת גרה: <b>והוא שיכיר</b>",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בן גמל.</b> שאין לו שינים והוא",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעלה גרה ואינו מפריס פרסה:",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אין לך דבר שמעלה גרה וטמא</b>",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אלא גמל.</b> וה\"ה לשפן וארנבת",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדכתיב קרא בהדיא מיהו אין",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך שיכיר שפן וארנבת לפי",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש להן שינים אבל בן גמל",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעודו קטן אין לו שינים ולא",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניבים: <b>שפיה גמום.</b> חתוך ולשון",
      "segment_ids": [
        20,
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משנה הוא כמו גוממו עם השופי",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומפני שהוא חתוך אינו יכול",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להכיר אם יש לו שינים אם לאו:",
      "segment_ids": [
        21
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אם פרסותיה סדוקות בידוע שהיא</b>",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>טהורה.</b> לפי שהיא גם כן מעלת",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גרה: <b>והוא שיכיר חזיר.</b> שכל",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא מפריס פרסה בידוע שהיא",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעלת גרה חוץ מחזיר שהוא",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפריס פרסה ואינו מעלה גרה:",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בודק בבשרה.</b> לקמן מפרש היכא:",
      "segment_ids": [
        24
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תחת העוקץ.</b> תחת עצם האליה",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקורין אנקא יש בשר שכשקורעין",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו נקרע שתי ויש נקרע ערב:",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואלו הן סימני חיה שחלבה מותר</b>",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כל שיש לה קרנים וטלפים.</b> וא\"ת",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיכי מני טלפים בסימני חיה",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להתיר חלבה והא בבהמה נמי",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איתנהו יש לומר דכיון דלהתיר",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חלבה אתינן בעינן דניפק",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכולהו ספיקי מספק טומאה",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומספק בהמה הלכך בעינן טלפים",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאפוקי מחיה טמאה דאף ע\"ג",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלסימני טהרה מפרסת פרסה",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומעלת גרה בעינן היינו כדי",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיכיר חזיר [שאינו מעלה גרה]",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וזה שיש לו קרנים ליכא לספוקי",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביה כלל הילכך בעינן טלפים",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאפוקי מטומאה וקרנים לאפוקי",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מבהמה ור' יוסי ס\"ל דכל שיש",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו קרנים אין לספקו [בטומאה]",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלל והיינו דתנן בפרק בא סימן",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(דף נא:) כל שיש לו קרנים יש",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו טלפים וסתמא כרבי יוסי:",
      "segment_ids": [
        26
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והרי עז דיש לו קרנים וטלפים</b>",
      "segment_ids": [
        27
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וחלבו אסור כרוכות בעינן.</b> פרש\"י ז\"ל כרוכות עגולות כדאמרינן בב\"ק (דף נ:) גבי",
      "segment_ids": [
        27
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיחין ומערות ובבכורות (דף מ:) גבי (פיו) דומה לחזיר: <b>חדוקות בעינן.</b> מלאות פגימות",
      "segment_ids": [
        27,
        28
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וחריצין: <b>והרי עז דחדוקות.</b> וקס\"ד דהדר ביה מכרוכות ומוקי סימנים אחדוקות. וכרוכות",
      "segment_ids": [
        28,
        29
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תו לא בעינן: <b>מפוצלות בעינן.</b> שיהו להם פצולים: <b>והרי צבי.</b> דאין מפוצלות אותו",
      "segment_ids": [
        29,
        30,
        31
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שקורין אנו צבי לא היו הם קורין צבי אלא אותו הקרוי אשטנבו\"ק וקרנים שלו אינן",
      "segment_ids": [
        31
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מפוצלים: <b>חדודות בעינן.</b> כך גורס רש\"י ז\"ל ופירש כעין קרני איל וצבי שהן מדין",
      "segment_ids": [
        31,
        32
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "למעלה: <b>הילכך כל היכא דאיכא מפוצלות וכו'.</b> כיון דאיכא מפוצלות ואיכא דאלו מפוצלות",
      "segment_ids": [
        32,
        33
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היכא דאיכא מפוצלות לא בעינן מידי אחרינא לפי שאין פצול בקרני בהמה והיכא דאלו",
      "segment_ids": [
        33
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מפוצלות כגון הצבי בעינן חדודות כרוכות וחדוקות דניפוק מספקא דכולהו. חדוקות",
      "segment_ids": [
        33
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאפוקי דשור. חדודות לאפוקי דעז שהם רחבות. כרוכות לאפוקי נמי מספיקא דעז דאע\"ג",
      "segment_ids": [
        33
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דשל עז אינן חדודות יש עיזא כרכוז ששמו עז וקרניו חדוקות וחדודות ומספקא לן אי",
      "segment_ids": [
        33
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מינא דעז נינהו: <b>דמבלע חדקייהו.</b> החריצין תכופין וסמוכין ומובלעין זה בזה: <b>והיינו</b>",
      "segment_ids": [
        33,
        34,
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ספקא דעיזא כרכוז.</b> שקרניו חדוקות וחדודות ומספקא לן כיון דחדודות וחדוקות חיה היא",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "או שמא כיון ששמו עז מין בהמה היא זו היא שטת רבינו שלמה יצחקי ז\"ל ומה שפירש דכי",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקשינן הרי עז דחדוקות הוה סבירא לן דהדרינן מכרוכות לא נהירא דאם כן למה ליה",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לחדושי מפוצלות בעינן לימא דלא הדר וכרוכות וחדוקות בעינן ונפקינן בהו מספקא דשור",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ועז וכן מה שכתב דמדמקשינן והרי צבי דאין מפוצלות משמע שמה שאנו קורין צירב\"ו",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אינו צבי שהרי אמרו כאן שאין קרני הצבי מפוצלות וזה שאנו קורין אותו צבי פצולין",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הרבה יש לו. לא נהירא שהרי כל הסימנין שהזכירו חכמים בצבי יש לו באותו שאנו קורין",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עכשיו צבי (כתובות קיב.) שאין עורו מחזיק את בשרו ושהוא ישן בעינו אחת פתוחה וכן",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מה שפי' בחדודות שהן חדין למעלה ובעינן חדוקות לאפוקי משור וחדודות לאפוקי מעז",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכרוכות לאפוקי מעיזא כרכוז דקרניו חדוקות וחדודות אינו מחוור דאם כן בכרוכות",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וחדוקות תסגי ליה דהא ליכא דכוותייהו בשור ולא בעז ולא בעיזא כרכוז לפיכך פירש",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"ת ז\"ל דכרוכות היינו דקיימא גילדי גילדי וקס\"ד שהגילדי מתקלפין זה מזה ושל עז",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אינן כן ומקשינן והרי שור דכרוכות כלומר דקיימא גילדי גילדי והן מתקלפות ומהדרינן",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חדוקות בעינן כלומר לאו כדקא ס\"ד שיהו הכריכות מתקלפות אלא שיהו מהודקות זו על זו",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וחדוקות כמו הדוקות כדאמרינן בעירובין [דף קא.] טובם כחדק שמהדקין את עובדי",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כוכבים לגיהנם. ומקשינן והרי עז דחדוקות כלומר אם כן דכרוכות מהודקות קאמרת הדרא",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קושיא לדוכתה שהרי של עז ישנן כן דבשלמא מעיקרא דמשנינן כרוכות בעינן וקס\"ד דאפשר",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לקלף הכריכות זו מזו הוא דניחא לן דשל עז אינן מתקלפות אבל השתא דאמרינן דחדוקות",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בעינן הדרא קושיא לדוכתה דשל עז נמי חדוקות נינהו ומהדרינן מבוצלות בעינן כלומר",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהן כפופות בראשיהן ומלשון כפיפה הוא כדאמרינן בקידושין [דף סב:] מאי משמע דהאי",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אגם לישנא דבוצלא הוא דכתיב הלכוף כאגמון ראשו ואפילו לנוסחאות שכתוב בהן מפוצלות",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כך מתפרש שהפ\"א והבי\"ת מתחלפות כמו שאמרנו [בריש פ\"ו דפאה] הבקר במקום הפקר",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ופרכינן והרי צבי דאין מפוצלות כלומר שאינן כפופות ומהדרינן הדורות בעינן כלומר",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הדורות נמי בעינן ופירוש הדורות עגולות ושל עז אינן כן מיהו בהדורות לחוד לא סגי",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דקרני השור נמי עגולין הן הילכך בעינן כרוכות חדוקות לאפוקי משור דלא מהדקי",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והדורות לאפוקי מעז. וספיקא דעיזא כרכוז היינו אי מיקרי מיבלע חדקיהו או לא וסלקא",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמעתין שפיר אלא שקשה מה שנמצא בנוסחאות וכן בהלכות הרי\"ף ז\"ל חדוקות הדורות",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכרוכות בעינן ואם איתא דכרוכות וחדוקות חדא מילתא היא הוה ליה למסמך כרוכות",
      "segment_ids": [
        35
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אחדוקות:",
      "segment_ids": [
        35
      ]
    }
  ],
