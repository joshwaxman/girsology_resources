  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "טמא ובשני סימנין טהור והוא שיכיר עורב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכל מין עורב אמר אמימר הלכתא עוף הבא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בסימן <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>אחד טהור והוא דלא דריס א\"ל רב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אשי לאמימר הא דרב נחמן מאי אמר ליה לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמיע לי כלומר לא סבירא לי ואיבעית אימא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום דפרס ועזניה לא שכיחי בישוב: <span class=\"bavli-ref\" data-bavli-ref=\"(דף סו.)\" data-bavli-daf=\"66a\" data-bavli-index=\"0\"></span>תניא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אומר גלוי וידוע לפני מי שאמר והיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העולם שבהמה טמאה מרובה מן הטהורה לפיכך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנה הכתוב בטהורים ועופות טהורים מרובין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על הטמאים לפיכך מנה הכתוב בטמאים למאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נפקא מינה לכדרב הונא דאמר רב הונא אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב ואמרי לה אמר רב הונא אמר רב משום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי מאיר לעולם ישנה אדם לתלמידיו דרך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קצרה: אמר רבי יצחק",
      "segment_ids": [
        1,
        2
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בשני סימנין טהור והוא שיכיר עורב.</b> שהרי אין בכל עשרים וארבע עופות טמאין שיהא לו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שני סימנים של טהרה בלבד אלא עורב. ומכאן שכל עשרים וארבע עופות טמאין דורסין הן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכיון שרש\"י ז\"ל סובר שיש להם ג' סימני טהרה על כרחינו יש להם אצבע יתרה וזפק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וקרקבן נקלף ולפיכך צריכין אנו לפרש דמתני' דקתני דכל שיש לו אצבע יתרה וזפק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקרקבן נקלף טהור ארישא סמיך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמו שכתבתי במשנתינו שאי אפשר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לך לומר שאחד משלשה סימני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טהרה שיש לעשרים [עופות] הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינו דורס שא\"כ למה אמרו שכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבא בשני סימנין האמורים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במשנתינו שאין לספק בו אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעורב <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>בלבד ליחוש שמא אינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דורס וממין עשרים עופות הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכ\"ת ה\"ק בב' סימנין טהור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כגון שבא באצבע יתרה וזפק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויודע שהשנים האחרים לטומאה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א\"כ אפילו הוא מכיר עורב למה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא טהור והרי זה דורס הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ששניט כל עוף הדורס טמא אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על כרחין ה\"ק בשני סימנים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינו יודע אם הוא דורס אם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאו טהור לפי שאין לספק בו אלא בעורב בלבד שאין לחוש שמא אינו דורס ומעשרים עופות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הוא שהרי כולן דורסין וכמו שכתבתי: <b>והוא שיכיר עורב וכל מין עורב.</b> בגמרא מוכח דכל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיש לו שני סימנין בגופו אע\"פ שאינן סימנין של עורב שהן אצבע יתרה וקורקבן נקלף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שכבר נבדק ונמצא לו כן אלא שני סימנין אחרים בגופו כגון זפק ואצבע יתרה או זפק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וקורקבן נקלף מין עורב הוא וטמא לרבי אליעזר בשוכן עמו בלחוד ולרבנן בשוכן ונדמה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדאיתא לקמן [דף סה.]. ומימריה דרב נחמן ה\"נ מוכחא דקאמר בשני סימנין טהור והוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיכיר עורב ומשמע דבכל שני סימנין בעינן שיכיר עורב דאי לא הוה ליה לפרושי עוף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הבא בשני סימני עורב אלא ודאי כל הבא בשני סימנין בגופו אע\"פ שאינן כשל עורב יש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לחוש שמא מין עורב הוא אלא א\"כ סימן אחד שבו הוא שאינו דורס דכל מיני עורב דורסין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הן: <b>הלכתא עוף הבא בסימן אחד טהור והוא דלא דריס.</b> אפילו אינו בקי בהן ובשמותיהן",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דלא חיישינן שמא פרס או עזניה הוא כדמפרש ואזיל דלא שכיחי בישוב אלא במדבר וה\"מ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דלא דריס כי משכחינן ביה סימן אחד מחזקינן ליה בטהור כל כמה דלא חזינן ליה דדריס",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל דריס על כרחיך או פרס או עזניה הוא שכלל גדול שנינו כל הדורס טמא לפי שאין לך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בטהורים שיהא דורס זו היא שיטת רש\"י ז\"ל: <b>ונמצאו</b> כללי השמועה לפי שיטה זו שכל עוף",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הדורס טמא ועוף הבא בג' סימנין בגופו ואינו ידוע אם דורס אם לאו אסור לפי שיש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לחוש שמא מעשרים עופות טמאים הוא בא בשני סימנים בגופו ואינו [דורס טהור שאין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בעופות טמאים כיוצא בו. בשני סימנים ואינו] יודע אם הוא דורס אם לאו אע\"פ שאינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותן שני סימנין של עורב יש לחוש לעורב ולמיניו. היה לו סימן אחד בגופו אע\"פ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו יודע אם הוא דורס אם לאו וכן אין לו סימן טהרה בגופו ואינו דורס כל אחד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מאלו טהור שאין בכל הטמאין כיוצא בהם אלא פרס ועזניה והנהו לא שכיחי בישוב. ויש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מי שמספק ואומר דכי אמרינן לא שכיחי בישוב דוקא בישובי דידהו אבל דידן חיישינן כל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "זה לפי דרכו של רש\"י ז\"ל: <b>אבל</b> אין דרכו מחוור שלדבריו <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>כי בעי רב נחמן שיהא בקי",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהם ובשמותיהן אינו צריך שיהא בקי אלא בפרס ועזניה דהא ליכא בכולהו עופות בני חד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חד אלא אינהו ולפיכך אין הלשון מתחוור שיאמר סתם היה בקי בהם ובשמותיהם ולא יהא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "צריך להיות בקי אלא בפרס ועזניה. ועוד קשה לשיטת רש\"י ז\"ל שא\"כ כי היכי דאמר דעוף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הבא בסימן אחד ומכיר פרס ועזניה טהור [ועוף הבא בשני סימנים ומכיר עורב טהור]",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לימא נמי עוף הבא בג' סימנין טהור והוא שיכיר עשרים עופות האמורים בפרשה. אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאפשר לי לומר בזה דמשום דהנהו ד' עופות דנפקי מלמינה למינו למינהו למיניהם לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ידיעי לא אמר הכי. ועוד קשה על רש\"י ז\"ל שבדיקת העופות מעידה הפך מדבריו ז\"ל שהוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פירש שעשרים עופות יש להם ג' סימני טהרה בגופן והרי נבדק האישפרוו\"ר שהוא הנץ",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האמור בתורה כמו שפירש רש\"י ז\"ל בפירוש התורה ובמשנת [דף מב.] דרוסת הנץ וכן נראה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא המורגל לצוד בו ודורס תמיד ומצאו שאין לו אלא אצבע יתרה בלבד וכן עוף הגס",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שבמיני הנץ ששנינו בו דרוסת הגס בעוף הגס והוא האסטו\"ר שצדין בו תמיד ואין לו גם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כן אלא אצבע יתרה בלבד וכן בדקו בת היענה הנקראת בלשון חכמים נעמה ואין להסתפק בה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהיא האשטרו\"ץ מפני שאוכלת הברזל והזכוכית כמו שאמרו בפרק מפנין (דף קכח.) ואת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הזכוכית מפני שהיא מאכל לנעמיות והיא העושה אבל תמיד שאינה משוררת ולא משמעת קול",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלל כענין שכתוב (מיכה א) אבל כבנות יענה ואין לה זפק ולא אצבע יתרה שאין לה אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ב' אצבעות לפניה ואחד יוצא גודל ואין זו אצבע יתרה כמו שפירש' במשנתינו אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שקורקבנה נקלף ועוד בדק הרמב\"ן ז\"ל העוף הנקרא מילא\"ן והוא דורס וצד תמיד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תרנגולים קטנים וכיוצא בהם ואין לו אלא אצבע יתרה בלבד וכיון שכן הרי מצינו עוף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הבא בסימן אחד וטמא ואין לומר שהוא פרס או עזניה שהרי הוא מצוי בישוב בשוקים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וברחובות וכן בדק במיני העופות שעיניהם הולכים לפניהם כשל אדם ויש להם לסתות כאדם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והם קריא וקפוף כדאיתא בפרק המפלת (דף כג.) ואין להם לא זפק ולא קרקבן אלא אצבע",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יתרה וכן בדק עוף הנקרא וולטור\"א שהוא בלשון חכמים דיו ובלשון תורה דיה והיא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שרואה נבלה מרחוק יותר מכל העופות כמו שמוזכר בשמועה זו [דף סג:] ואין לו אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אצבע יתרה בלבד וכן העטלף שהוא העכבר הפורח בלילה ואין לה זפק ולא קורקבן נקלף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא אצבע יתרה לפי שיש לו חמש אצבעות לפניו האמצעי ארוך והוא היתר. ומכל זה נדחה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פי' של רש\"י ז\"ל שהרי כל אלו העופות הטמאים אין להם אלא סימן אחד. מלבד מה שקשה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עליו מכל מה שדקדקנו בסוגית הגמרא והארכתי בחדושי וכן נדחו מפני הבדיקה פירושים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אחרים שנתפרשו בשמועה זו:",
      "segment_ids": [
        4
      ]
    }
  ],
