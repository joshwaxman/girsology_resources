        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לעצמו דלא קנסינן שוגג אטו מזיד וכדאיתא",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בפ' הניזקין (שם) הילכך נחתכה אחת מן",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "החתיכות היא מותרת ממ\"נ דאי של היתר היא",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הרי זו כשרה ואם אסורה היא הרי היא מתבטלת",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "והיינו דאמרי' בפ' התערובות (דף עד:) חבית",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "של תרומה שנתערבה במאה חביות אם נפתחה אחת",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מהן נוטל בה כדי דמע ושותה פירוש דכיון",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שנפתחה בטלה חשיבותה ועולה ממ\"נ אלא שצריך",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ליטול ממנה כדי דמע בתרומה משום גזל השבט",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ואם נאבדה אחת מהן כולן מותרות דכיון דמאי",
