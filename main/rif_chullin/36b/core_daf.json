        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דנאבדה אחת מהן תלינן לקולא כדאמרינן בפרק",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "התערובות [דף עד.] טבעת של ע\"ז שנפלה במאה",
