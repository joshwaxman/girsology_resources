        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דחתיכה הראויה להתכבד בפני האורחים אינה",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בטלה ובסוף ע\"ז [שם] משמע דתרתי בעינן דבר",
