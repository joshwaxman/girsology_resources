        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אזלינן דהא תניא בסוף פרק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקומץ רבה [דף לז.] דאיטר",
      "segment_ids": [
