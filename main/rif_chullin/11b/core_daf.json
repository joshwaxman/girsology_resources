      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הונא בר מר כל הני <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>חיותא ברייתא הכי אית",
      "segment_ids": [
        0
      ]
