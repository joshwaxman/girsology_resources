      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפרים ז\"ל וקא יהיב טעמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דודאי הא דסבר רב אשי למטרפה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתרתי הוה עובדא דאי בחדא",
