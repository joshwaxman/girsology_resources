        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קיימא בדרא דידהו לא משלמת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכתב הרב אלברגילונ\"י ז\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון שעכשיו יש לכל הבהמות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ענוניתא דורדא אי משכחינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלית לה טרפה אבל הרמב\"ם ז\"ל",
      "segment_ids": [
