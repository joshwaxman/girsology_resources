      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נראה מדברי הרב אלפסי ז\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכתב סתם והני מילי מקמה וכן",
      "segment_ids": [
