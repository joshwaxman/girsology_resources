        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אית להו ומאי קא מספקא ליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא ודאי בתרתי ואפ\"ה אסיקנא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכשרה ומיהו לישנא דקאמר וקרו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה טבחי ענוניתא דורדא לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דייק הכי אלא שכבר פשט הדבר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להתיר ולענין אשלומי דעת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגאונים ז\"ל דאי חסיר חדא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אונא מימין ענוניתא דורדא",
