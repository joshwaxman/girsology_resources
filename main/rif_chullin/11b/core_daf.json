      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפשורי אי מבצבצא טרפה ואי לא כשרה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתתאה אינקיב עילאה לא אינקיב והאי",
