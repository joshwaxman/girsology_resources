      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרכה לעמוד בשמאל וכן דעת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הר\"ם במז\"ל בפ\"ח מהלכות שחיטה",
