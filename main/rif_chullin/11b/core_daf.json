      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לענוניתא דורדא טרפה (וכן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסקו התוס' בקבלה) דלא",
