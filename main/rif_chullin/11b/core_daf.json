    {
      "width": "380px",
      "right": "275px",
      "text": "רב נחמן ריאה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>שנימוקה וקרום שלה קיים",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשרה תניא נמי הכי ריאה שנימוקה וקרום",
