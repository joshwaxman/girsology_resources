        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נתן דתניא רבי נתן אומר פעם אחת הלכתי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לכרכי הים ובאת אשה אחת לפני שמלה בנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשון ומת שני ומת שלישי ומת <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>רביעי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הביאתו לפני וראיתיו שהוא אדום אמרתי לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתי המתיני לו עד שיבלע בו דמו והמתינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו ומלה אותו וחיה והיו קורין אותו נתן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבבלי על שמי ושוב פעם אחת הלכתי למדינת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קפוטקיא באת אשה אחת לפני שמלה בנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשון ומת שני ומת שלישי ומת <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>רביעי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הביאתו לפני וראיתיו שהוא ירוק אמרתי לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתי המתיני לו עד שיפול בו דמו והמתינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו ומלה אותו וחיה והיו קורין אותו נתן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבבלי על שמי: אמר רב כהנא ככבדא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>כשרה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כבשרא טרפה וסימניך ובשר בשדה טרפה. אמר",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">רב</i> <i class=\"footnote\">סמא</i> <i class=\"footnote\">בריה</i> <i class=\"footnote\">דרבא</i> <i class=\"footnote\">כ\"ה</i> <i class=\"footnote\">בגמ'</i> <i class=\"footnote\">וברא\"ש</i>",
      "segment_ids": [
