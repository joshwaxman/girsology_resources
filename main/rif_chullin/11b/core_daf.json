      "right": "275px",
      "text": "<i class=\"footnote\">לעיל</i> <i class=\"footnote\">וכ\"ה</i> <i class=\"footnote\">בגמ'</i>: ואמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">רפרם</i>",
