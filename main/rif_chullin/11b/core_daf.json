  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ההוא ביני וביני דאתא לקמיה דרב <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i>",
      "segment_ids": [
        0
