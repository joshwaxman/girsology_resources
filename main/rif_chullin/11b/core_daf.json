  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גרסי' בגמ' ההיא דביני ביני.</b> כלומר דלא הוה קיימא בדרא דאוני דאתא לקמיה דרב אשי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סבר למיטרפה א\"ל מר בר רב אויא לרב אשי כל הני חיוי ברייתא כלומר הרועות באפר הכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אית להו וקרו לה טבחי עינוניתא דורדא. עינוניתא כמו אינוניתא על שם שהיא קלושה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואדומה כוורד וה\"מ מקמה אבל מגבה אפילו כטרפא דאסא [טרפה] והך ענוניתא דורדא דקא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכשרינן איכא מאן דאמר דדוקא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשהיא במקום שהיא רגילה להיות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל אם אינה שם או שהיא גדולה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשאר האונות ואינה דומה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לענוניתא דורדא טרפה (וכן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסקו התוס' בקבלה) דלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכשרינן אלא ההיא דקרו לה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טבחי ענוניתא דורדא ולא נראה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כן מדברי הרב אלפסי ז\"ל שכתב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סתם וה\"מ מקמה אלמא כל מקמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשרה. והיכא דאיכא תרתי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ענוניתא דורדא רש\"י ז\"ל אוסר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום דחדא גופא לא התירוה אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום דכל הני עיזי ברייתא הכי",
