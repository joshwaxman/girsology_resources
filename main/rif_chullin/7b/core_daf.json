  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דקה לדקה.</b> לשחיטת בהמה דקה משערינן בכדי בהמה דקה דכוותה ור' יוסי בר' חנינא פירושי קא מפרש מלתייהו דרב ושמואל ור'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יוחנן דבכלל כדי שחיטה הוי כדי שיגביהנה וירביצנה הילכך נקיטינן דשיעור שהיית בהמה הוא כדי שיגביהנה וירביצנה דקה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לדקה וגסה לגסה וכן פסק הרמב\"ם ז\"ל בפ\"ג מהלכות שחיטה: <b>ולענין</b> שהיית עוף כתב רש\"י ז\"ל דמפלגינן בבהמה גופה בין דקה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לגסה הוא הדין דמפלגינן בין בהמה לעוף הילכך נקיטינן כרב דאמר ועוף לעוף דקם ליה רבי יוסי ברבי חנינא כותיה אבל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגאונים סוברים דרבי יוסי בר'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חנינא לא איירי בשיעור עוף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלל הילכך הוה ליה רב יחיד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לגבי שמואל ורבי יוחנן וקי\"ל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כותייהו דאמרי אפילו בהמה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעוף וזהו דעת הרב אלפסי ז\"ל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>וכן דעת הרמב\"ם ז\"ל בפרק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנזכר מיהו איכא לעיוני שיעור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחיטה אי משערין בשחיטת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סימנין בלבד או אף בחתיכת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העור. ובסימנין עצמן אי בכדי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחיטת כולן או רובן ומסתברא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דסימנין ברובן כיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמדאורייתא אפי' לכתחלה בהכי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סגי וכמו שכתבנו בריש פרקין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בעור ודאי משערינן דשיעור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחיטה כדרכה גמירי שהוא שוחט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העור לכתחלה ואיכא מאן דאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאף בכדי כל הסימנין משערים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמכל מקום איתנהו בשחיטה: <b>אמר</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רבא השוחט בסכין רעה.</b> שאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חדודה חותך יפה: <b>אפילו כל</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היום כולו.</b> מאריך ושוהה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשחיטה אחת כשרה הואיל וכל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעה הוא מוליך ומביא ולא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפסיק בשחיטתו: <b>שהיות מהו</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שיצטרפו.</b> הפסיק שתים ושלש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשחיטה אחת ושהה בין שלשתן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדי שיעור שלם: <b>מדידיה.</b> השוחט",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בסכין רעה אלמא לא מיצטרפי דקא סלקא דעתן דאפילו הפסיק קאמר אלא שלא שהה בפעם אחד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כשיעור: <b>התם.</b> בדלא שהה כלל: <b>שהה במיעוט סימנין מהו.</b> פרש\"י ז\"ל שחט הרוב ושהה",
      "segment_ids": [
        5,
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במיעוט האחרון וגמר שחיטתו: <b>מהו.</b> מי אמרינן כיון דעבד ליה רובא אתכשר או דילמא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כיון דהדר גמרה כולה חדא שחיטה היא ולא איפשיטא ולחומרא ולפיכך כתב ז\"ל דמי ששחט רוב הסימנין והשליך העוף מידו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ושוהה למות אסור לחתוך המיעוט בתורת שחיטה מוטב שיכה על הצואר בסכין או ימתין עד שימות ואין זה מחוור שמכיון שנשחטו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רוב הסימנין אינו בדין שיפסלו בשהייה וכמו שכתבתי למעלה בבעיא דהחליד במיעוט סימנין ומדברי הר\"ם במז\"ל בפרק הנזכר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נראה דהכי קא מיבעיא ליה שהייה דאמרינן דהוי כדי שחיטה שהה במיעוט סימנין [כלומר כדי מיעוט סימנין] מהו ואף זה אינו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מחוור דשחיטת מיעוט הסימנין לא מיקרי שחיטה אלא הנכון דשהה במיעוט בתרא דסימן קמא ולאו שהייה ממש דאי הכי פשיטא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דהיינו עיקר שהייה אלא בשוחט בסכין רעה ומוליך ומביא קא מיבעיא ליה ואדרבא סמיך והכי קא מיבעיא ליה שוהה בחתיכת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אותו מיעוט בשיעור שהייה מאי מי אמרינן דאע\"פ שהוליך והביא שחיטתו פסולה דכיון דאינו מעכב בשחיטה כמחתך בבשר בעלמא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא או דילמא כיון דאף מיעוט הסימנין איתיה בשחיטה לא פסיל וסלקא בתיקו ולחומרא: <b>מתני' שחט את הושט וכו' ופסק את</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הגרגרת.</b> היינו עיקור ובבהמה קאי: <b>תחת השני.</b> בין הסימן לצואר: <b>ופסקו.</b> מלמטה למעלה: <b>גמ'</b> גרסי' הכא בגמרא [דף לב:] אמר",
      "segment_ids": [
        9,
        10,
        11,
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"ל שחט את הקנה ואח\"כ ניקבה הריאה כשירה כלומר שניקבה בין שחיטת קנה לשחיטת ושט אמר רבא לא אמר ר\"ל אלא בריאה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הואיל וחיי ריאה תלוים בקנה אבל בבני מעים לא. כלומר כיון דחיי ריאה תלויין בקנה ושחט את הקנה הוי כמו שניטלה כולה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מן הבהמה ומונחת בדיקולא דתו לא מיטרפא בהמה בה והרב אלפסי ז\"ל [לא] הביאה בהלכות וכן הרמב\"ם ז\"ל כתב שחט את הקנה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואח\"כ ניקבה הריאה טריפה נראה שהם דוחין אותה מדרבי זירא דפליג עלה בגמרא לפי דעת קצת מפרשים כמו שכתבתי בחידושי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואין כאן מקום להאריך אבל יש מפרשים אחרים שפסקו הלכתא כר\"ל: <b>תניא הרוצה לאכול מבהמה קודם שתצא נפשה.</b> משום דמעלי",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לגופא וכדאיתא בגמרא: <b>חותך כזית בשר מבית טביחתה.</b> שאינו מחוסר הפשט ויכול לחתכו מיד קודם יציאת הנפש: <b>וממתין לה עד</b>",
      "segment_ids": [
        13,
        14,
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שתצא נפשה.</b> דאמרינן בפ' ארבע מיתות ב\"ד (דף סג.) מנין שאסור לאכול מן הבהמה קודם שתצא נפשה ת\"ל לא תאכלו על הדם:",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אחד עובד כוכבים ואחד ישראל מותרין בו.</b> שאע\"פ שבני נח מוזהרין על אבר מן החי ולא שריא להו בהמה בשחיטה דשחטי אינהו",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא במיתה תליא להו מילתא הכא בשחיטת ישראל מיגו דאישתריא לישראל אישתריא נמי לדידהו ומקשו הכא האי כזית בשר למאי",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קא בעי ליה אי לקדרה דבעי מליחה מאי ממתין לה עד שתצא נפשה דקאמר הא ודאי בשיעור מליחה ובישול כבר יצאה נשמתה ואי",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאומצא ולצלי מאי מולחו יפה יפה דקאמר והא לא בעו מליחה וכמו שפירשתי למעלה י\"ל לעולם לאומצא אי נמי לצלי ואע\"ג",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבעלמא לא בעו מליחה הכא בעו כיון דמבית שחיטתה קא חתיך ועד שלא תצא נפשה שהדם נעקר ממקומו ומתמצה דרך שם: <b>מתני'</b>",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>השוחט בהמה חיה ועוף וכו' בידים מסואבות.</b> בלא נטילה דגזרו עליהן להיות שניות ובגמ' פריך אפילו הוכשרו נמי דהא אין",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שני עושה שלישי בחולין ומוקמינן לה בחולין שנעשו על טהרת הקודש: <b>הוכשרו בשחיטה.</b> דמגו דשריא שחיטה להאי בשר מידי אבר",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מן החי משויא ליה נמי אוכלא לגבי טומאה ומקשו הכא נהי שלא הוכשרו בדם על כרחין קודם אכילה הוכשרו במים דאי לקדרה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הרי הוכשרו במים שבה ואי לצלי הוכשרו נמי בהדחה דודאי אפילו צלי הדחה בעי מפני הדם שעל פני הבשר דכי אמרינן [בדף",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צג:] דנורא משאיב שאיב הני מילי דם הנבלע באיברים אבל דם שהוא בעין אינו יוצא ע\"י האש דאדרבה מתייבש הוא שם ולאומצא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נמי ודאי בעי הדחה מפני הדם שעל פניו דלא מיקרי דם האיברים שלא פירש אלא דם הבלוע בבשר אבל מה שעל גביו ודאי אסור",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וצריך הדחה י\"ל משכחת לה דאכיל ליה לצלי בלא הדחה וא\"ת דדם שעל פניו אוסר ליתיה [דף קיא.] דדם משרק שריק ואינו אוסר",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא כדי קליפה הילכך קולף את החיצון והשאר מותר אי נמי משכחת לה כשהודחו ע\"י גשמים שלא מדעת דכיון דלא אחשבינהו לא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מכשרי: <b>וכתב</b> הרשב\"א ז\"ל דהשוחט בהמה חיה ועוף ולא יצא מהן דם אף על פי שלא שחט את הורידין אינו צריך שינתחם אבר אבר",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דכי בעינן שחיטת ורידין או חתיכת אבר אבר ה\"מ ביצא מהן דם שהדם פורש ואינו מוצא מקום לצאת והוה ליה פורש ממקום",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למקום ואסור אבל בשלא יצא מהן דם הדבר מוכיח שלא פירש דמו ממתום למקום: <b>השוחט את המסוכנת וכו' עד שתפרכס.</b> דאי לא",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפרכסא קים להו לרבנן דניטלה נשמתה קודם שחיטה כדאמרינן בגמרא [דף לח.]:",
      "segment_ids": [
        20
      ]
    }
  ],
