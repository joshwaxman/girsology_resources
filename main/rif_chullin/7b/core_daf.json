  "gemara": [
    {
      "width": "377px",
      "right": "275px",
      "text": "<big><strong>שיגביהנה</strong></big>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "377px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>וירביצנה וישחוט דקה לדקה",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "וגסה לגסה והלכתא כשמואל ורבי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "יוחנן דהוו להו תרי ואין",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דבריו של אחד במקום שנים אמר",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "רבא השוחט בסכין רעה אפי'",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הוליך והביא כל היום כולו",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שחיטתו כשרה: בעי רבא שהיות",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מהו שיצטרפו ותפשוט ליה",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מדידיה התם בדלא שהה בעי רב",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הונא בר נתן שהה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>במיעוט",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "סימנין מהו תיקו וכל תיקו",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דאיסורא לחומרא: <b><big>מתני'</big></b> <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>שחט את",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הושט ופסק את הגרגרת שחט את",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הגרגרת ופסק את הושט או ששחט",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אחד מהן והמתין לה עד שמתה או",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שהחליד את הסכין תחת השני",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ופסקו רבי ישבב אומר נבלה",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ומטמאה במשא רבי עקיבא אומר",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "טרפה כלל אמר רבי ישבב משום",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "רבי יהושע כל שנפסלה בשחיטתה",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "נבלה וכל ששחיטתה בראוי ודבר",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אחר גורם לה להפסל טרפה והודה",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לו ר' עקיבא: <b><big>גמ'</big></b> (דף לג.)",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "<i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>תניא הרוצה לאכול מבהמה <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>קודם",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שתצא נפשה חותך כזית בשר מבית",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "טביחתה ומולחו יפה יפה ומדיחו",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "יפה יפה וממתין לה עד שתצא",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "נפשה ואוכלו אחד עובד כוכבים",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ואחד ישראל מותרין בו: <b><big>מתני'",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "</big></b> <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>השוחט בהמה [חיה] ועוף ולא",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "יצא מהן דם כשרין ונאכלין",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "בידים מסואבות לפי שלא הוכשרו",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "בדם רבי שמעון אומר הוכשרו",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "בשחיטה (דף לז.) <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>השוחט",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "המסוכנת רבן גמליאל אומר",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "275px"
    }
  ],
  "rashi": [
    {
      "width": "1010px",
      "text": "<b>דקה לדקה.</b> לשחיטת בהמה דקה משערינן בכדי",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "בהמה דקה דכוותה ור' יוסי בר' חנינא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "פירושי קא מפרש מלתייהו דרב ושמואל ור'",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "יוחנן דבכלל כדי שחיטה הוי כדי שיגביהנה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "450px",
      "text": "וירביצנה הילכך נקיטינן דשיעור שהיית בהמה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הוא כדי שיגביהנה וירביצנה דקה לדקה וגסה",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לגסה וכן פסק הרמב\"ם ז\"ל בפ\"ג מהלכות",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שחיטה: <b>ולענין</b> שהיית עוף כתב רש\"י ז\"ל",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דמפלגינן בבהמה גופה בין דקה לגסה הוא",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הדין דמפלגינן בין בהמה לעוף הילכך",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נקיטינן כרב דאמר ועוף לעוף דקם ליה רבי",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "יוסי ברבי חנינא כותיה אבל הגאונים סוברים",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דרבי יוסי בר' חנינא לא איירי בשיעור עוף",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כלל הילכך הוה ליה רב יחיד לגבי שמואל",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ורבי יוחנן וקי\"ל כותייהו דאמרי אפילו",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בהמה לעוף וזהו דעת הרב אלפסי ז\"ל <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>וכן דעת",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הרמב\"ם ז\"ל בפרק הנזכר מיהו איכא לעיוני",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שיעור שחיטה אי משערין בשחיטת סימנין בלבד",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "או אף בחתיכת העור. ובסימנין עצמן אי בכדי",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שחיטת כולן או רובן ומסתברא דסימנין ברובן",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כיון דמדאורייתא אפי' לכתחלה בהכי סגי",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "וכמו שכתבנו בריש פרקין אבל בעור ודאי",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "משערינן דשיעור שחיטה כדרכה גמירי שהוא",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שוחט העור לכתחלה ואיכא מאן דאמר שאף בכדי",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כל הסימנין משערים דמכל מקום איתנהו",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בשחיטה: <b>אמר רבא השוחט בסכין רעה.</b> שאין",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "חדודה חותך יפה: <b>אפילו כל היום כולו.",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "</b> מאריך ושוהה בשחיטה אחת כשרה הואיל וכל",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שעה הוא מוליך ומביא ולא הפסיק",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בשחיטתו: <b>שהיות מהו שיצטרפו.</b> הפסיק שתים",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ושלש בשחיטה אחת ושהה בין שלשתן כדי שיעור",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שלם: <b>מדידיה.</b> השוחט בסכין רעה אלמא לא",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מיצטרפי דקא סלקא דעתן דאפילו הפסיק קאמר",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אלא שלא שהה בפעם אחד כשיעור: <b>התם.</b> בדלא",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שהה כלל: <b>שהה במיעוט סימנין מהו.</b> פרש\"י",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ז\"ל שחט הרוב ושהה במיעוט האחרון וגמר",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שחיטתו: <b>מהו.</b> מי אמרינן כיון דעבד ליה",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "רובא אתכשר או דילמא כיון דהדר גמרה כולה",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "חדא שחיטה היא ולא איפשיטא ולחומרא ולפיכך",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כתב ז\"ל דמי ששחט רוב הסימנין והשליך העוף",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מידו ושוהה למות אסור לחתוך המיעוט בתורת",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שחיטה מוטב שיכה על הצואר בסכין או ימתין",
