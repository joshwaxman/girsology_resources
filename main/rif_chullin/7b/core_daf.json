      "right": "275px",
      "text": "בשר מבית טביחתה ומולחו יפה יפה ומדיחו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יפה יפה וממתין לה עד שתצא נפשה ואוכלו",
