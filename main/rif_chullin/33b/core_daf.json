      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"1\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Chullin 94b:13\" data-ror-ocr=\"באו לקראתו: לולי האי. שיצאתם יומר מדאי:\">יצאו: כולי האי - יצאתם יותר</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"1\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Chullin 94b:13\" data-ror-ocr=\"באו לקראתו: לולי האי. שיצאתם יומר מדאי:\">מדאי:</i> <i class=\"ror-line\" data-ror-i=\"2\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Chullin 94b:13\" data-ror-ocr=\"לא הוה ידעינן. ולעשוח עסקינו לילך אל\">לא הוה ידעינן - ולעשות</i>"
