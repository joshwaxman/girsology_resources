  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל ונמצא ישראל אוכל גיד הנשה ואי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעית <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>אימא <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Human Dispositions\" data-label=\"⚬\"></i>חתוכה לא משום דגניב לדעתיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעובד כוכבים <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>דסבירא ליה עובד כוכבים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לכבודו נתנה לו והוא לא נתנה לו אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני שאינה ראויה לו ונמצא גונב דעתו של",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עובד כוכבים דאמר שמואל אסור לגנוב דעת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבריות ואפילו דעתו של עובד כוכבים תניא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי מאיר אומר אל יסרהב אדם לחברו לסעוד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אצלו ויודע <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>שאינו סועד ואל ירבה לו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתקרובת ויודע שאינו מקבל ואל יפתח לו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חביות המכורות לחנוני אלא אם כן הודיעו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואל יאמר לו סוך שמן מפך ריקן ואם בשביל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כבודו מותר תנו רבנן לא ילך אדם לבית",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האבל ובידו לגין המתקשקש ולא ימלאנו מים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני שמתעהו ואם היה שם חבר עיר מותר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנו רבנן לא ימכור אדם לחברו סנדל של",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתה בשביל חיה מפני שני דברים אחד מפני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמתעהו ואחד מפני הסכנה ואל ישלח אדם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לחברו חבית יין ושמן צף על פיה ומעשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באחד ששיגר לחברו חבית של יין ושמן צף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על פיה והלך וזימן עליה אורחים ונכנס",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומצאה שהיא של יין וחנק עצמו ומת <i data-commentator=\"Tur\" data-label=\"⚬\"></i>ואין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האורחין רשאין ליתן ממה שלפניהם לבנו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולבתו של בעל הבית אא\"כ נטלו רשות מבעל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית ומעשה באחד שזימן אורחים בשני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בצורת ולא היה לו ליתן לפניהם אלא כשלש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביצים ובא בנו של בעל הבית ועמד לפניהם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נטל אחד חלקו ונתן לו וכן שני וכן שלישי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בא אביו ומצאו שתופס אחת בפיו ושתים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בידיו נטלו וחבטו ע\"ג קרקע ומת כיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שראתה אמו כך עלתה לראש הגג ונפלה ומתה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אף הוא עלה לראש הגג ונפל ומת אמר רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אליעזר בן יעקב על",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גרסי' בגמ' [דף צד.] השולח ירך לחבירו שלימה א\"צ ליטול ממנה גיד הנשה חתוכה צריך</b>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ליטול ממנה ג\"ה.</b> פירוש דכיון דחתוכה היא יחשוב ישראל שניטל גידה ויאכלנה בגידה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונראה שהראב\"ד ז\"ל סובר דבכה\"ג מדינא מותר לישראל לסמוך ולומר שמי ששלחה לו ניקרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לגמרי שהוא ז\"ל כתב באיסור משהו שלו דמהא שמעינן דישראל שהיה מנקר בשר והלך לו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא ידענו אם נקר כולה אם לאו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א\"צ (הישראל) להראותה לבקי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא סומך עליו שאם היה צריך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להראותה לבקי חתוכה אמאי צריך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליטול גידה והרי מי שנשתלחה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו צריך לראות אם נטל אם לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נטל אלא ודאי כל שנראית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמנוקרת א\"צ להראותה וטעמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום דכל המצויין אצל המצוה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מומחין הן וכדאמרינן [דף ג:]",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרוב מצויין אצל שחיטה מומחין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הן וה\"ה לשאר מצות והיינו נמי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרינן בפ\"ק דמכילתין [דף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יב.] האומר לשלוחו צא ותרום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והלך ומצא תרום אין חזקתו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תרום ומפרשינן טעמא משום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחיישינן דלמא איניש אחרינא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמע ואזיל ותרם והוה ליה תורם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא מדעת ואין תרומתו תרומה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>דוקא היכא דאיכא למיחש לתורם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא מדעת אבל היכא דליכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למיחש כגון דשוינהו לכ\"ע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלוחין ואמר כל הרוצה לתרום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יבא ויתרום חזקתו תרום אלמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן רוב מצויין אצל המצות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מומחין הן אלו דברי הרב ז\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולזה הסכים הרשב\"א ז\"ל ובודאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשולח ירך מנוקרת לחברו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדברים נראין שאין לחוש אבל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בישראל שנקר והלך לו איכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למיחש שמא דעתו היה לחזור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולהשלים ולא השלים. ומדאמרינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחתוכה לא גזרה שמא יתננה לו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפני ישראל נראה שאסור למכור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נבלות וטרפות לעובד כוכבים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סתם במקום שאין מכריזין משום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גזרה שמא ימכרנה לו בפני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישראל ואין המנהג כן שהרי אנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מוכרין נבלות וטרפות לעובד כוכבים בסתם לפיכך נראין דברי ר\"ת ז\"ל שכתב דכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דייקינן ממתניתין דחתוכה לא בשאמר לו כשרה ומותרת היא הילכך אי אמר ליה כה\"ג בפני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ישראל אתי למיזבן מיניה ומש\"ה גזרינן שמא יתננה לו בפני ישראל וזהו שנהגו בכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המקומות הללו למכור נבלות וטרפות סתם דלשמא ימכרנו בפני ישראל ליכא למיחש דכיון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבסתם הוא לא סמיך ישראל בהכי ומשום גניבת דעת נמי ליכא דאיהו מטעי נמי אנפשיה:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואי בעית אימא.</b> טעמא דמתני' דאמרה דחתוכה לא לישדר עם גידה משום דגונב דעתו של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עובד כוכבים כסבור שישראל זה אוהבו מאד שתקנה וטרח בה ליטול הגיד עד שנראית לעצמו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואח\"כ נתנה לו והוא לא נטלה ונמצא מחזיק לו טובת חנם וזהו שכתב הרי\"ף ז\"ל והוא לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נתנה לו אלא בשביל שאינה ראויה לו כלומר שהוא בגידה נתנה לו ומפני שהגיד אינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ראוי לישראל שלח לו ירך ולא שלח לו נתח אחר: <b>לא יסרהב אדם בחבירו לסעוד אצלו.</b> לא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>יפצירנו הואיל וידע שלא יעשה לפי שגונב דעתו להחזיק לו טובת חנם כסבור שמן הלב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הוא מסרהב לו כן: <b>ואל יפתח לו וכו'.</b> כל חביותיהם היו מגופות וכשבא אדם חשוב אצלו",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פותח לו חבית להשקותו יין חזק ואם מכר חבית לחנוני שלימה ועדיין היא אצלו לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יפתחנה לאורח הבא אליו מפני שגונב לבו להחזיק לו טובת חנם כסבור זה הפסד גדול",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נפסד ע\"י שהרי תשאר חבית זו חסרה ויתקלקל יינה וזה ימסרנה לחנוני מיד שמכרה לו:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אא\"כ הודיעו.</b> מכרתיה לחנוני ואינו נפסד: <b>ואל יאמר לו סוך שמן מפך ריקן.</b> דרכן היה",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בסיכה וקאמר שלא יביא לו הפך ויסרהב בו לסוך והפך ריקן ואינו מתכוין אלא לגנוב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דעתו שיחזיק לו טובת חנם שיודע בו שאינו סך: <b>ואם בשביל כבודו מותר.</b> אם בשביל",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כבודו של אורח להודיע לבריות שהוא חביב עליו מותר ובגמרא מוכח דלא מיתסר כה\"ג אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשזה מראה לו שהוא עושה כן לכבודו אבל אם הוא אינו מתכוין כלל להטעות וכגון שפתח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חביותיו לצורך עצמו והלה סבור שבשבילו פתחן אין לו להודיע שלא אסרו אלא שלא יהא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מטעהו אבל אם הוא מוטעה מעצמו אין זקוק לו: <b>לגין המתקשקש.</b> חסר לפי שזה סובר שהוא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מלא: <b>ואם יש שם חבר עיר.</b> חבורת עיר שיש שם רבים וזה מתכוין להחשיב את האבל",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בעיניהם שיאמרו כמה חשוב שזה מכבדו כל כך: <b>מותר.</b> דגדול כבוד הבריות: <b>סנדל של עור</b>",
      "segment_ids": [
        8,
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בהמה שמתה מאליה.</b> אין עורה חזקה כשל בריאה שחוטה: <b>הסכנה.</b> שמא מחמת נשיכת נחש מתה",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והארס נבלע בעור: <b>ושמן צף על פיה.</b> כסבור שהכל שמן ומזמן עליו אורחים ובטוח שיש לו",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמן הרבה לצרכם: <b>וחנק את עצמו.</b> מפני שבוש מהם: <b>גרסי' בגמ' [שם:] ההוא טבחא דאמר</b>",
      "segment_ids": [
        12,
        13,
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לחבריה אי הוית מתפייס מינאי לא הוה ספינא לך משור של פטם דעבדי אחמול.</b> כלומר אם",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היית שלם עמי וכי לא הייתי נותן לך ממנו אמר ליה משופרי שופרי אכלי אמר ליה מנא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לך אמר פלניא עובד כוכבים זבן מינך וספא לי א\"ל תרתי עבדי וההוא טרפה הוה אמר רבי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשביל שוטה זה שעשה שלא כהוגן כלומר למכור טרפה לעובד כוכבים אנו נאסור כל",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המקולין רבי לטעמיה דתניא מקולין וטבחי ישראל בשר הנמצא ביד עובד כוכבים מותר א\"ד",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "א\"ר מפני שוטה זה שמתכוין לצעורי לחבריה אנו נאסור כל המקולין טעמא דאיכוין",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לצעורי לחבריה הא לאו הכי אסור והתניא רבי אומר מקולין וטבחי ישראל בשר הנמצא ביד",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עובד כוכבים מוחר <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>התם דאתחזק איסורא והך עובדא ליכא לפרושה במקום שאין מכריזין",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהרי מותר למכור ומאי עשה שלא כהוגן איכא אלא במקום שלא תקנו כלום עסקינן והעמיד",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הדבר על שורת הדין שאסור למכור ומותר ליקח ומש\"ה קאמר מפני שוטה זה שעשה שלא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כהוגן שהיה לו לחוש שמא ימכרנה לישראל אנו נאסור כל המקולין כיון דאיכא רובא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דהיתרא ושור של פטם זה מיעוטא הוא לא חיישינן ליה ובלישנא בתרא אמרינן דדוקא משום",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאיכוין לצעורי הא לאו הכי כיון דאיתחזק איסורא אסור דכי שרי בשר הנמצא ביד עובד",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כוכבים ה\"מ היכא דלא ידיע דאיכא נבלה וטרפה אבל כשהוחזקה <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>טרפה אסור לפי שרובן של",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עובדי כוכבים מן הטרפה לוקחין דמוזלי גבייהו א\"נ י\"ל דבמקום שמכריזין ולא אכריזו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עסקינן ואפ\"ה אמרינן בלישנא קמא שאע\"פ שנודעת טרפה במקולין כל שלא הכריזו בשר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הנמצא ביד עובד כוכבים מותר שלא התנו עליהם במקום שמכריזין לאסור ליקח מן העובד",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כוכבים אלא לאחר הכרזה שהרי לא כוונו אלא כדי שיהא מותר למכור מן ההכרזה ואילך",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל קודם הכרזה אע\"פ ששוטה זה עשה שלא כהוגן שלא נזהר מלמכור <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>ליקח מהם מותר שהדבר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נשאר בדינו ובלישנא בתרא מפרשינן דדוקא משום דאיכוין לצעורי לחבריה הא לאו הכי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשר <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>אסור כיון דאיחתזק איסורא שבמקום שמכריזין כך התנו שכל שהוחזקה שם טרפה יהא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אסור ליקח:",
      "segment_ids": [
        14
      ]
    }
  ],
