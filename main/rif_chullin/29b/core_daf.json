  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אבל כסה דם הנפש פטור מלכסות במאי קא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיפלגי תנא קמא סבר כל דמו ורבי יהודה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סבר אפילו מקצת דמו ור\"ש בן גמליאל סבר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמו המיוחד והילכתא כתנא קמא דמתני'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכדפירשה רבי יהודה וליתא לדרבן שמעון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן גמליאל דקאמרינן כל מקום ששנה רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אימתי ובמה אינו אלא לפרש דברי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חכמים ואפילו רבי יוחנן לא פליג אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבמה אבל באימתי מודה הילכך עבדינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרבנן וכדפריש רבי יהודה ודלא כר\"ש בן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גמליאל: <b><big>מתני'</big></b> במה מכסין ובמה אין מכסין",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכסין בזבל דק ובחול דק ובסיד ובחרסית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובלבינה ובמגופה שכתשה אבל אין מכסין לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בזבל גס ולא בחול גס ולא בלבינה ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במגופה שלא כתשה ולא יכסה עליו את הכלי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלל אמר רשב\"ג דבר שהוא מגדל צמחין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכסין בו ודבר שאינו מגדל צמחין אין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכסין בו: <b><big>גמ'</big></b> היכי דמי חול הדק אמר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבב\"ח אמר רבי יוחנן כל שאין היוצר צריך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לכותשו: ת\"ר (ויקרא יז) וכסהו יכול",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יכסהו באבנים או יכפה עליו את הכלי ת\"ל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכסהו כעפר אין לי אלא עפר מנין לרבות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זבל דק וחול דק ושחיקת אבנים ושחיקת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חרסית ונעורת פשתן דקה <span class=\"bavli-ref\" data-bavli-ref=\"(דף פח:)\" data-bavli-daf=\"88b\" data-bavli-index=\"0\"></span>ונסורת חרשים דקה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולבינה וסיד וחרסית ובמגופה שכתשה ת\"ל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכסהו יכול שאני מרבה זבל גס וחול גס",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושחיקת כלי מתכות ולבינה ומגופה שלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתשן וסובין וקמח ומורסן ת\"ל בעפר ומה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראית לרבות אלו ולהוציא אלו לאחר שריבה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכתוב ומיעט מרבה אני את אלו שהן מין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עפר ומוציא אני את אלו שאין מין עפר:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גרסינן בפרק השוחט אחד בעוף <span class=\"bavli-ref\" data-bavli-ref=\"(דף לא.)\" data-bavli-daf=\"31a\" data-bavli-index=\"1\"></span>אמר רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זירא אמר רב השוחט צריך שיתן עפר למטה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ועפר למעלה שנאמר וכסהו בעפר עפר לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאמר כאן אלא בעפר מלמד שהשוחט צריך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיתן עפר תיחוח למטה ועפר תיחוח למעלה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וביו\"ט בפרק קמא <span class=\"bavli-ref\" data-bavli-ref=\"(דף ז:)\" data-bavli-daf=\"7b\" data-bavli-index=\"2\"></span>נמי איתא: <span class=\"bavli-ref\" data-bavli-ref=\"(דף פח:)\" data-bavli-daf=\"88b\" data-bavli-index=\"3\"></span>דרש רב נחמן",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר רב חסדא אין מכסין אלא בדבר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>שזורעין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בו ומצמיח דתניא היה מהלך במדבר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>ואין לו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עפר לכסות שורף טליתו ומכסה היה מהלך",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בספינה ואין לו עפר לכסות שוחק דינרי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב ומכסה דאשכחן אפר דאיקרי עפר שנאמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(במדבר י״ט:י״ז) ולקחו לטמא מעפר שרפת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "החטאת וזהב איקרי עפר שנאמר (איוב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כ״ח:ו׳) ועפרות זהב לו. תנא הוסיפו",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליהן השחור והכחול ונקורת הפסלים ואמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבא בשכר שאמר אברהם אבינו (בראשית",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "י״ח:כ״ז) ואנכי עפר ואפר זכו בניו לשתי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מצות לאפר פרה ועפר סוטה: <span class=\"bavli-ref\" data-bavli-ref=\"(דף פט.)\" data-bavli-daf=\"89a\" data-bavli-index=\"4\"></span>אמר רבי אלעא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין העולם מתקיים אלא בשביל מי שבולם",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצמו בשעת מריבה שנאמר (איוב כ״ו:ז׳)",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תולה ארץ על בלימה א\"ר אבהו אין העולם",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתקיים אלא בזכות מי שמשים עצמו כמי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאינו שנאמר תולה ארץ על בלימה וא\"ר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבהו אין העולם מתקיים אלא במי שמשים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצמו כקרקע שנא' (דברים ל״ג:כ״ז) ומתחת",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זרועות עולם <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">שלנו</i> <i class=\"footnote\">אין</i> <i class=\"footnote\">זה</i> <i class=\"footnote\">כאן</i> <i class=\"footnote\">רק</i>",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">בר\"ה</i> <i class=\"footnote\">דף</i> <i class=\"footnote\">יז.</i> <i class=\"footnote\">בשם</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">יהודה</i> <i class=\"footnote\">אמר</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">כל</i>",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">פרנס</i> <i class=\"footnote\">המטיל</i> <i class=\"footnote\">אימה</i> <i class=\"footnote\">יתירה</i> <i class=\"footnote\">על</i> <i class=\"footnote\">הצבור</i> <i class=\"footnote\">וכו'</i>",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">(ג\"א)</i>וא\"ר אבהו כל פרנס המתגאה על הצבור",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא לשם שמים אין רואה בן חכם ומבין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומשכיל לעולם שנאמר (איוב ל״ז:כ״ד) לכן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יראוהו אנשים לא יראה כל חכמי לב: <b>הדרן</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>עלך כסוי הדם</b>",
      "segment_ids": [
        8
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מתני' במה מכסין וכו'.</b> חרסית. שחיקת חרסית: <b>מגופה.</b> שעל פי החבית: <b>גמ' כל שאין</b>",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>היוצר צריך לכתשו.</b> מוכח בגמרא דדוקא בשאינו צריך לכתישה כלל אבל צריך ולא צריך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואיכא דכתשי כה\"ג ואיכא דלא כתשי אין מכסין בו: <b>ת\"ר וכסהו וכו'.</b> נעורת. ארישט\"א",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמנערין מן הפשתן: <b>נסורת.</b> שמגרדין נגרים במגרה וקוצצין בה עצים והיא משרת נסורת",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקה כעפר: <b>ת\"ל וכסהו.</b> בפני",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו נדרש מדלא כתיב ושפך את",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמו ובעפר יכסנו דהוי משמע",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עפר ולא דבר אחר דלא כתיב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כסוי אלא לבתר עפר אבל השתא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדריש וכסהו באפי נפשיה:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ושחיקת כלי מתכות.</b> דלא איקרי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עפר: <b>סובין.</b> שהנפה קולטת:",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מורסן.</b> קליפה היוצאת כשכותשין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במכתשת: <b>אחר שריבה הכתוב</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומיעט.</b> אחר שכתב לך שני",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקראות אחד לרבות ואחד למעט",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרת מעתה יש לך לומר דכל הני",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלעיל מין עפר נינהו מה עפר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיוחד שמגדל צמחים אף כל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמגדל צמחים וכל הנך דלעיל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קים להו לרבנן דמגדלי צמחים",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינך בתראי אין מגדלין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צמחים: <b>ומקשו</b> הכא והא שחיקת",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלי מתכות מגדל צמחים כדמוכח",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרק כל הצלמים (דף מג:) דתנן",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התם רבי יוסי אומר שוחק וזורה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרוח או מטיל לים אמרו לו אף",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא נעשית זבל וההיא ודאי בשל",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתכות איירי דהא מייתינן עלה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרא דכתיב גבי עגל תירצו",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתוספות דנהי דמועיל לזבל",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפני עצמו מיהא אינו מגדל",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צמחים: <b>גרסי' בפ' השוחט (דף</b>",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לא.) וכו' עפר לא נאמר אלא</b>",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בעפר מלמד וכו'.</b> דבעפר משמע",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהא כולו טמון בעפר ומוכח",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמ' בפרקין שאם א\"א ליתן עפר",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלמטה כגון ששחט על גבי דם",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהמה נותן מלמעלה ומוכח לעיל",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפ' השוחט [שם] דכל היכא שיש",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שם כבר עפר תיחוח למטה",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומזמינו בפיו לכך סגי דאמרינן",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התם דמזמין ליה לעפרא דכולי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פקתא כלומר לעפר שעל כל",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבקעה: <b>דרש רב נחמן בר רב</b>",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חסדא אין מכסין אלא בעפר</b>",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שמכסים בו ומצמיח.</b> למעוטי ארץ",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלחה וממתני' ליכא למשמע דיש",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לך דבר שמגדל דבר שצמח בו כבר",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינו מצמיח <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>: <b>היה מהלך</b>",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במדבר.</b> ארץ ציה שאינה מצמחת:",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומקשו</b> הכא וכיון דמסקינן דאין",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכסין אלא בדבר שזורעין בו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומצמיח היאך מכסין בשחיקת",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דינרי זהב דהא שחיקת כלי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתכות אינו מצמיח כדמוכחא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברייתא דלעיל וכ\"ת כי בעינן",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהא מגדל צמחים דוקא במידי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלא איקרי עפר אבל מידי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאיקרי עפר אע\"ג דאינו מגדל",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צמחים כשר וזהב איקרי עפר אם",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כן היה מהלך במדבר יכסה בעפר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המדבר דעפר המדבר ודאי עפר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איקרי ודוחק הוא לומר דעפר",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ארץ מלחה לא איקרי עפר ומדברי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רב אחא משבחא ז\"ל בשאלתות",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאחרי מות נראה דה\"ג אמר רבא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הא בורכא דתניא כלומר דרב",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נחמן בר רב חסדא הוה סבירא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה דלא פליגי רבנן עליה דרבן",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמעון בן גמליאל דאינהו נמי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מודו דכל שאינו מגדל צמחים",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין מכסין בו ואמר ליה רבא",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא בורכא דודאי רבנן פליגי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליה דהא תניא שוחק דינרי זהב",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"פ שאין שחיקת דינרי זהב",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מגדלת צמחים ולפי זה מאי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרינן היה מהלך במדבר ואין",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לו עפר לכסות שורף טליתו מיירי במדבר שעפרו חול הגם ואין לו במה ישחוק. ולפי שיטה",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "זו לא קי\"ל כרשב\"ג דאמר [דבר] שאין מגדל צמחים אין מכסין בו דפליגי רבנן עליה וכן",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נראה מדברי הר\"ם במז\"ל שלא הזכיר מגדל צמחים: <b>תניא הוסיפו עליהם השחור.</b> פחמין",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כתושין: <b>ונקורת הפסלים.</b> עפר שמנקרין מן הרחיים: <b>לאפר פרה ועפר סוטה.</b> שיש הנאה בהן",
      "segment_ids": [
        15,
        16,
        17
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אפר פרה מטהרת הטמאין מטומאתן. עפר סוטה מטיל שלום בין איש לאשתו ונקתה ונזרעה",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "זרע אבל עפר כיסוי לית ביה הנאה דבלאו כיסוי נמי הוה משתרי בשרא ומשום הכי לא",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חשיב ליה בהדייהו הכי אמרינן בגמרא: <b>שבולם עצמו.</b> סוגר את פיו ודומה לו בבכורות",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "(דף מ:) פיו בלום ורגליו מבולמות: <b>ומתחת זרועות עולם.</b> מי שנדרס תחת הכל הוא",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "זרועות עולם: <b>הדרן</b> עלך כסוי הדם",
      "segment_ids": [
        19,
        20
      ]
    }
  ],
