        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתב רש\"י ז\"ל דרוב עביו היינו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא יצא רוב עובי השבירה לחוץ",
