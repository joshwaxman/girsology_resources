      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שסביב העצם של השבר קיים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו [נחתך רוב] העצם ויצא",
