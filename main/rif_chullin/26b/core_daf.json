      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עביו של עצם לא מעלה ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוריד שאם רוב היקף הבשר",
      "segment_ids": [
