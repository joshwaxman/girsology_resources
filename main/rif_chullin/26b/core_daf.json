      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Chullin 76b:17\" data-ror-ocr=\"עובי השבירה לחיץ אלא מיעוט התלל נגלה\">השבירה לחוץ אלא מיעוט חלל</i>"
      },
