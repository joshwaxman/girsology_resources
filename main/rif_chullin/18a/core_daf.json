      "text": "ר' <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">וברא\"ש</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">יוסף</i> <i class=\"footnote\">בריה</i>",
