  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הוריקה כבד כנגד בני מעים מהו.</b> פירוש הכבד מקצתו כנגד בני מעים ומקצתו למעלה אצל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הצלעות ומה שהוא שלא כנגד בני מעים פשיטא לן דהוריקה כשרה שאין ירקות פוסל אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מטעם נקב ונקב אינו פוסל בכבד כלל והיינו דפרכינן ולא יהא אלא ניטלה כלומר ניטלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונשתייר ממנה כל שהוא אלא דבהוריקה כנגד בני מעים הוא דקא מיבעיא לן אי חיישינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמא נחמרו בני מעיה או לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונפקא מינה היכא דליתנהו קמן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלבדקינהו אי נמי אע\"ג",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאיתנהו מי אמרינן כיון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוריקה כבד כל שכן שנחמרו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בני מעיה אלא דלא איגלי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהתתייהו או דילמא כיון שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוריקו בני מעיה האור שלט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכבד ולא בבני מעים ואסיקנא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון שהוריקה כבד בידוע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנחמרו בני מעיה מיהו כתב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרשב\"א ז\"ל דדוקא בשהוריקה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למטה במקום חבורה בבני מעים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואע\"פ שלא הוריקה למעלה כנגד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבה אבל הוריקה לצד גבה ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקום חבורה כשרה שזו דרך גבה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפלה ולפיכך הוריקה כבד ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוריקו בני מעים: <b>כיון</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שהוריקה כבד כנגד בני מעים</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בידוע שנפלה לאור ונחמרו בני</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מעיה וטרפה.</b> זו היא גירסת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגאונים ז\"ל וכן בהלכות הרב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלפסי ז\"ל ולפי גירסא זו משמע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכל שהוריקה כבד אע\"פ שלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראינו שנפלה לאור כודאי נפלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משוינן ליה וכן כתב הרמב\"ם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל בפ\"ז מהל' שחיטה וזה מן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התימה שהרי הירקות מצוי הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמיד בכבד מחמת חולי וכיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא ראינו שנפלה לאור למה לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתלה בחולי דהא תלינן בזאב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ועוד דהא רב יוסף בודאי נפלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קמיבעיא ליה דהא אמתני' קאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומשמע ודאי דאמאי דבעא מיניה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אהדר ליה אלא ה\"ג כל שהוריקה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כבד כנגד בני מעים בידוע שנחמרו בני מעיה וטרפה ואפי' לפי גירסת הרב אלפסי ז\"ל יש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לומר דה\"ק בידוע שכשנפלה לאור נחמרו בני מעיה ובנפלה לאור ודאי קאמר אבל לא נפלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תולין בחולי דהא תלינן בזאב וה\"נ משמע בסמוך מדאמרינן אדומים שלא הוריקו ושלקן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והוריקו טרפה מ\"ט איגלי בהתתייהו ואמר רב אשי עלה הילכך לא ליכול איניש אלא בשלקא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומה ראה רב אשי להצריך לבדוק טרפות זה יותר מכל שאר טרפות שאין חוששין להן אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ודאי בשנפלה לאור הוא דקאמר רב אשי דלא ליכול אלא בשלקא דכיון דנפלה ודאי חיישינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואפ\"ה מהדרינן דאחזוקי ריעותא לאמחזקינן וכיון דרב אשי בנפלה דוקא קאמר כי אמרינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נמי [שלקן] והוריקו טרפה דוקא בנפלה לאור דאי אפילו בלא נפלה היכי לימא רב אשי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סתמא לא ליכול איניש אלא בשלקא והא רב אשי לא איירי אלא בשנפלה אלא ודאי כל שלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נפלה לאור אין חוששין לה כלל ואע\"פ שהוריקו וכן דעת הרמב\"ן והרב רבינו אהרן הלוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תלמידו ז\"ל אבל הרשב\"א ז\"ל מחמיר כדברי הרמב\"ם: <b>אדומין הוו וטרפה.</b> אדומין הוו",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הדקין והן רגילין להיות ירוקין וטרפה: <b>לא אמרו אדומין כשרה אלא בלב וקרקבן וכבד.</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שדרכן להיות אדומין דבדידהו אם הוריקו מוכחא מילתא שהאור שלט בהן וטרפה. ואם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אדומין כלומר אע\"פ שהוסיפו אדמימות כשרה אבל בדקין הוי איפכא שכיון שהן ירוקין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אע\"פ שהוסיפו ירקות כשרה שבמעט חום הן מוסיפין במראה שלהן והיינו דאמר באידך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עובדא דבסמוך ירוקין הוו ואכשרה אבל האדימו טרפה שאין משתניס ממראיתם אא\"כ שלט",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהן האור וא\"ת ואמאי נקט מתניתין טפי אדומין שהוריקו מירוקין שהאדימו י\"ל לרבותא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאע\"פ שדרך האש להאדים משכחת לה דאדומין כשרה ולדברי מי שאומר שהשלק סומכין עליו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהורקה אבל לא בהאדמה כמו שאכתוב בסמוך בס\"ד אתי שפיר טפי דירוקין פסולין הוי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מילתא פסיקתא [דלית להו תקנתא בשלקא אבל אדומים פסולים לא הוי מילתא פסיקתא]",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דירוקין שהאדימו פעמים שחוזרין להכשירן כגון ששלקן והוריקו דאמרינן קוטרא בעלמא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עייל בהו כדאיתא בסמוך: <b>ומדנקט</b> האי דינא דנפלה לאור במתניתין ובגמרא גבי עוף ולא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נקטיה בבהמה יש מי שאומר דליתיה בבהמה כלל דדוקא בעוף שהוא רך האור שולט בו אבל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהמה עורה מגין עליה ואין האור שולט בה ודמיא למאי דאמרינן לקמן בגמרא [דף נז.]",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאין ריאה לעוף לא לינפל ולא ליחמר באש הואיל וצלעות מגינות עליה והם מפרשים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאפילו נחמרה [ריאה של עוף] אין חוששין לה ותולין בחולי אחר וה\"נ אע\"פ שנחמרו בני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מעיה של בהמה תולין ואין חוששין לנפילה באש וכן כתב הרמב\"ן והרמב\"ם בפרק י'",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מהלכות שחיטה ולא מיחוור דא\"כ כי היכי דאמרינן [שם] כל טרפות שמנו חכמים בבהמה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כנגדן בעוף יתר עליהן העוף נשבר העצם אע\"פ שלא ניקב קרום של מוח ה\"נ ה\"ל למימר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יתר עליהן נפלה לאור ונחמרו בני מעיה שאם תאמר שלא אמרו יתר עליהן העוף אלא במה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהעוף והבהמה שוין אבל בנפילה לאור איכא טעמא למיסר עוף טפי מבהמה מפני שעורו רך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והרי אף בנשבר העצם אע\"פ שלא ניקב קרום של מוח איכא טעמא כדאמרינן בגמרא הואיל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וקרומו רך ואעפ\"כ הזכירוהו בפירוש וכן נמי מה שאמר דאין ריאה לעוף ליחמר שאפילו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נחמרה כשרה לא מחוור דכיון שנחמרה הא חזינן שלא הגינו צלעות עליה אלא ודאי כי אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אין ריאה לעוף ליחמר באש היינו לומר שעוף שנפל לאור אין הריאה שלו צריכה בדיקה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל נחמרה ודאי טרפה וכן נמי בבהמה כל שנחמרה ודאי טרפה <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>והא דנקטה בעוף משום דמאי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דשכיח ליה נקיט שמפני שהעוף מצוי בבית תדיר דרכו ליפול על האש יותר מן הבהמה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכדנקט נמי מאי דשכיח ליה דרסה וטרפה בכותל גבי העוף אע\"פ שכך הדין בבהמה כמו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שכתבתי במשנתינו ובתוספתא נמי תניא בהדיא גבי בהמה רצצתה חברתה ולעיל [דף נא.]",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נמי אמרינן שורים שמנגחים זה את זה וכו'. הילכך דינא <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>נמי דנפלה לאור ונחמרו בני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מעיה הרי היא בבהמה כבעוף והרב ב\"ה ז\"ל מטיל פשרה בדבר שעוף מכיון שנפל לאור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חוששין לו וצריך בדיקה חוץ מן הריאה שלו וכמו שכתבנו אבל בהמה שעורה קשה אין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חוששין לה אלא שאם ראינו שנחמרה טרפה כדאמרינן גבי ריאה דעוף [הואיל] וצלעות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מגינות עליה ואף זה אינו מחוור דכיון דבהמה מעוף ילפינן כשם שחוששין בעוף משעה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שנפל לאור כך חוששין בבהמה ושניהם צריכים בדיקה חוץ מריאה של עוף לדברי מי שאומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דההוא לישנא דאין לו לא לינפל ולא ליחמר באש קאי אמסקנא ואפשר לומר דההוא לישנא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אמסקנא לא קאי ואפילו ריאה של עוף צריכה בדיקה ויתבאר לפנינו בס\"ד: <b>לא אמרו</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ירוקין פסולה אלא בלב וקרקבן וכבד.</b> פירוש לב וקרקבן מחמת עצמן שהרי הנקב פוסל בהן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכבד מחמת בני מעים אבל הרשב\"א כתב שאף בכבד משכחת לה מחמת עצמו כגון שהוריקה כבד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במקום מרה ובמקום חיותא בכדי שאם ינטל מקום הירקות לא ישאר בו כזית באחד מאלו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המקומות דטרפה דכנטול כולו דמי והיינו דמני כבד בהדי לב וקורקבן דכולהו טרפותן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מחמת עצמן והאי דלא מני ריאה בהדייהו אע\"ג דודאי היכא דנפלה והוריקה טרפה דאע\"ג",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרינן לעיל [דף מז:] ירוקה כשרה מדרבי נתן ה\"מ בלא נפלה לאור אבל בנפלה לאור",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אין תולין בריאה כדרבי נתן כשם שאין [תולין] בכבד בחולי אלא היינו טעמא לפי שאין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הריאה עשויה ליחמר כלב וקורקבן וכבד הואיל וצלעות מגינות עליה ועוד שאפשר שאין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דינה שוה עם אלו שלב וקרקבן וכבד צריכין בדיקה כל שנפלה לאור וריאה של עוף אינה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "צריכה בדיקה והאי דלא מני טחול בהדייהו לדברי הרמב\"ם שהוא סובר שאין הנקב פוסל בו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אתי שפיר שכיון שאין הנקב פוסל בו אף הירקות אינו פוסל בו וכתב הרשב\"א שאין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הירקות פוסל בכבד אלא ככרתי אבל ירוק כביעתא או כמוריקא כשרה שהרי מראה זה מצוי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הוא תמיד בכבד מחמת שומן והרא\"ה מוסיף שאף בלב וקורקבן אין הירוק פוסל בהן אלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ככרתי שכל שהאש מוריק ככרתי הוא מוריק: <b>ירוקין שהאדימו ושלקן והוריקו כשרה מ\"ט</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>קוטרא הוא דעייל בהו.</b> כלומר מעיקרא ועכשיו הלך מחמת המים הרותחין: <b>אמר רב נחמן</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ברבי יצחק אף אנו נאמר אדומין שלא הוריקו ושלקן והוריקו טרפה מ\"ט איגלי בהתתייהו.</b>",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר חרפתן כך היא הגרסא בהלכות הרב אלפסי ז\"ל ויש מי שדקדק דמדנקט ירוקין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהאדימו ולא נקט אדומין שהוריקו כדנקט תנא דמתניתין ירוקין פסולה ש\"מ שאין שלק",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ראיה לאדמימות כלל דכשחוזרין למראה ירקות הוא דאיכא למימר קוטרא עייל בהו א\"נ",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "איגלי בהתתייהו אבל כשחוזרין למראה אדמימות אין זו ראיה כלל ובקצת ספרים הגרסא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהפך אדומין שהוריקו ושלקן והאדימו כשרה אמר רב נחמן בר' יצחק אף אנו נאמר ירוקין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלא האדימו ושלקן והאדימו טרפה ולפי גירסא זו י\"ל דכי נקט אדומין שהוריקו סרכא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמתניתין נקט דקתני ירוקין פסולה אבל בין האדמימות בין הירקות ניכר ע\"י שלק או",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אפשר אף לפי גירסא זו שאין השלק ראיה אלא לאדמימות אבל לא לירקות ולפיכך יש מי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמחמיר ואומר שמפני שנוי הנוסחאות אין סומכין לעולם בשלק להתיר אלא לאיסור בין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בירוקין בין באדומין אבל הרמב\"ם ז\"ל כתב בכולן והוא שיעמדו באותו מראה אחר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ששולקין אותן: <b>אמר רב אשי הילכך לא ליכול איניש אלא בשלקא.</b> הילכך כיון דאמרינן",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דזמנין דמגליא ריעותייהו כי שליק להו לא ליכול איניש עוף שנפל לאור אלא בשלקא:",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אחזוקי איסורא לא מחזקינן.</b> כיון דלא מינכר ריעותא בהדיא אא\"כ מתרמי דשליק להו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וחזי ריעותא: <b>דרסה וטרפה בכותל או שרצצתה בהמה ומפרכסת אם שהתה מעת לעת ושחטה</b>",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כשרה.</b> תנא הכי גבי עוף והוא הדין לבהמה ורבותא קמ\"ל שאפילו בעוף שחיותו קל אם",
