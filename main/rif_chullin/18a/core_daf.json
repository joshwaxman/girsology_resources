  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ר' <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">וברא\"ש</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">יוסף</i> <i class=\"footnote\">בריה</i>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">דריב\"ל</i> <i class=\"footnote\">כו'</i> <i class=\"footnote\">(ג\"א)</i>יוסי בר' יהושע בן לוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מרבי יהושע בן לוי <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>הוריקה כבד כנגד בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעים מהו אמר ליה טרפה אמר ליה ולא יהא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא ניטלה אמר רבא כיון שהוריקה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>כנגד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בני מעים <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בידוע שנפלה לאור ונחמרו בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעיה וטרפה: ההיא תרנגולתא דהוי בי רבי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע בן לוי אתא לקמיה דר\"א הקפר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירוקין הוו ואכשרה והא אנן תנן ירוקין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פסולה אמר ליה לא אמרו ירוקין פסולה אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בלב <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>ובקרקבן ובכבד תניא נמי הכי באלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בני מעים אמרו בקרקבן ובכבד ובלב: ההיא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תרנגולתא דהוה בי רב <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ב\"ר</i> <i class=\"footnote\">יוסף</i> <i class=\"footnote\">כ\"ה</i> <i class=\"footnote\">בגמ'</i>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">(ג\"א)</i>יצחק אתא לקמיה דר' אבהו אדומין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוו וטרפה והא אנן תנן אדומין כשרים א\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדומין שהוריקו וירוקין שהאדימו טרפה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "[לא אמרו אדומים כשרים אלא בלב וקרקבן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכבד]: אמר רב שמואל בר חייא אמר רבי",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מני <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">כ\"ה</i> <i class=\"footnote\">ברא\"ש</i> <i class=\"footnote\">ובגמ'</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">אדומין</i>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">שהוריקו</i> <i class=\"footnote\">ושלקן</i> <i class=\"footnote\">וחזרו</i> <i class=\"footnote\">והאדי'</i> <i class=\"footnote\">כשרה</i>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">(ג\"א)</i>ירוקין שהאדימו ושלקן <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>והוריקו כשרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאי טעמא קוטרא עייל בהו אמר רב נחמן בר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "יצחק אף אני אומר אדומים שלא הוריקו ושלקן והוריקו טרפה מאי טעמא דאגלי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בהתתייהו אמר רב אשי הילכך לא ליכול איניש אלא בשלקא ולא היא אחזוקי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "איסורא לא מחזקינן: <i data-commentator=\"Tur\" data-label=\"⚬\"></i>דרסה וטרפה בכותל או שרצצתה בהמה והיא מפרכסת אם",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שהתה מעת לעת ושחטה כשרה: ר\"א בן אנטיגנוס אומר משום ר' אלעזר",
      "segment_ids": [
        4,
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הוריקה כבד כנגד בני מעים מהו.</b> פירוש הכבד מקצתו כנגד בני מעים ומקצתו למעלה אצל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הצלעות ומה שהוא שלא כנגד בני מעים פשיטא לן דהוריקה כשרה שאין ירקות פוסל אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מטעם נקב ונקב אינו פוסל בכבד כלל והיינו דפרכינן ולא יהא אלא ניטלה כלומר ניטלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונשתייר ממנה כל שהוא אלא דבהוריקה כנגד בני מעים הוא דקא מיבעיא לן אי חיישינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמא נחמרו בני מעיה או לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונפקא מינה היכא דליתנהו קמן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלבדקינהו אי נמי אע\"ג",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאיתנהו מי אמרינן כיון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוריקה כבד כל שכן שנחמרו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בני מעיה אלא דלא איגלי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהתתייהו או דילמא כיון שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוריקו בני מעיה האור שלט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכבד ולא בבני מעים ואסיקנא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון שהוריקה כבד בידוע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנחמרו בני מעיה מיהו כתב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרשב\"א ז\"ל דדוקא בשהוריקה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למטה במקום חבורה בבני מעים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואע\"פ שלא הוריקה למעלה כנגד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבה אבל הוריקה לצד גבה ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקום חבורה כשרה שזו דרך גבה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפלה ולפיכך הוריקה כבד ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוריקו בני מעים: <b>כיון</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שהוריקה כבד כנגד בני מעים</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בידוע שנפלה לאור ונחמרו בני</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מעיה וטרפה.</b> זו היא גירסת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגאונים ז\"ל וכן בהלכות הרב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלפסי ז\"ל ולפי גירסא זו משמע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכל שהוריקה כבד אע\"פ שלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראינו שנפלה לאור כודאי נפלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משוינן ליה וכן כתב הרמב\"ם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל בפ\"ז מהל' שחיטה וזה מן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התימה שהרי הירקות מצוי הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמיד בכבד מחמת חולי וכיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא ראינו שנפלה לאור למה לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נתלה בחולי דהא תלינן בזאב ועוד דהא רב יוסף בודאי נפלה קמיבעיא ליה דהא אמתני' קאי ומשמע ודאי דאמאי דבעא מיניה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אהדר ליה אלא ה\"ג כל שהוריקה כבד כנגד בני מעים בידוע שנחמרו בני מעיה וטרפה ואפי' לפי גירסת הרב אלפסי ז\"ל יש לומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דה\"ק בידוע שכשנפלה לאור נחמרו בני מעיה ובנפלה לאור ודאי קאמר אבל לא נפלה תולין בחולי דהא תלינן בזאב וה\"נ משמע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בסמוך מדאמרינן אדומים שלא הוריקו ושלקן והוריקו טרפה מ\"ט איגלי בהתתייהו ואמר רב אשי עלה הילכך לא ליכול איניש אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשלקא ומה ראה רב אשי להצריך לבדוק טרפות זה יותר מכל שאר טרפות שאין חוששין להן אלא ודאי בשנפלה לאור הוא דקאמר רב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אשי דלא ליכול אלא בשלקא דכיון דנפלה ודאי חיישינן ואפ\"ה מהדרינן דאחזוקי ריעותא לאמחזקינן וכיון דרב אשי בנפלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דוקא קאמר כי אמרינן נמי [שלקן] והוריקו טרפה דוקא בנפלה לאור דאי אפילו בלא נפלה היכי לימא רב אשי סתמא לא ליכול",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "איניש אלא בשלקא והא רב אשי לא איירי אלא בשנפלה אלא ודאי כל שלא נפלה לאור אין חוששין לה כלל ואע\"פ שהוריקו וכן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דעת הרמב\"ן והרב רבינו אהרן הלוי תלמידו ז\"ל אבל הרשב\"א ז\"ל מחמיר כדברי הרמב\"ם: <b>אדומין הוו וטרפה.</b> אדומין הוו",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הדקין והן רגילין להיות ירוקין וטרפה: <b>לא אמרו אדומין כשרה אלא בלב וקרקבן וכבד.</b> שדרכן להיות אדומין דבדידהו אם",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוריקו מוכחא מילתא שהאור שלט בהן וטרפה. ואם אדומין כלומר אע\"פ שהוסיפו אדמימות כשרה אבל בדקין הוי איפכא שכיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהן ירוקין אע\"פ שהוסיפו ירקות כשרה שבמעט חום הן מוסיפין במראה שלהן והיינו דאמר באידך עובדא דבסמוך ירוקין הוו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואכשרה אבל האדימו טרפה שאין משתניס ממראיתם אא\"כ שלט בהן האור וא\"ת ואמאי נקט מתניתין טפי אדומין שהוריקו מירוקין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהאדימו י\"ל לרבותא שאע\"פ שדרך האש להאדים משכחת לה דאדומין כשרה ולדברי מי שאומר שהשלק סומכין עליו בהורקה אבל לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בהאדמה כמו שאכתוב בסמוך בס\"ד אתי שפיר טפי דירוקין פסולין הוי מילתא פסיקתא [דלית להו תקנתא בשלקא אבל אדומים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פסולים לא הוי מילתא פסיקתא] דירוקין שהאדימו פעמים שחוזרין להכשירן כגון ששלקן והוריקו דאמרינן קוטרא בעלמא עייל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בהו כדאיתא בסמוך: <b>ומדנקט</b> האי דינא דנפלה לאור במתניתין ובגמרא גבי עוף ולא נקטיה בבהמה יש מי שאומר דליתיה בבהמה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלל דדוקא בעוף שהוא רך האור שולט בו אבל בהמה עורה מגין עליה ואין האור שולט בה ודמיא למאי דאמרינן לקמן בגמרא [דף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נז.] דאין ריאה לעוף לא לינפל ולא ליחמר באש הואיל וצלעות מגינות עליה והם מפרשים שאפילו נחמרה [ריאה של עוף] אין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חוששין לה ותולין בחולי אחר וה\"נ אע\"פ שנחמרו בני מעיה של בהמה תולין ואין חוששין לנפילה באש וכן כתב הרמב\"ן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והרמב\"ם בפרק י' מהלכות שחיטה ולא מיחוור דא\"כ כי היכי דאמרינן [שם] כל טרפות שמנו חכמים בבהמה כנגדן בעוף יתר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עליהן העוף נשבר העצם אע\"פ שלא ניקב קרום של מוח ה\"נ ה\"ל למימר יתר עליהן נפלה לאור ונחמרו בני מעיה שאם תאמר שלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמרו יתר עליהן העוף אלא במה שהעוף והבהמה שוין אבל בנפילה לאור איכא טעמא למיסר עוף טפי מבהמה מפני שעורו רך והרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אף בנשבר העצם אע\"פ שלא ניקב קרום של מוח איכא טעמא כדאמרינן בגמרא הואיל וקרומו רך ואעפ\"כ הזכירוהו בפירוש וכן נמי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מה שאמר דאין ריאה לעוף ליחמר שאפילו נחמרה כשרה לא מחוור דכיון שנחמרה הא חזינן שלא הגינו צלעות עליה אלא ודאי כי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמר אין ריאה לעוף ליחמר באש היינו לומר שעוף שנפל לאור אין הריאה שלו צריכה בדיקה אבל נחמרה ודאי טרפה וכן נמי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בבהמה כל שנחמרה ודאי טרפה <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>והא דנקטה בעוף משום דמאי דשכיח ליה נקיט שמפני שהעוף מצוי בבית תדיר דרכו ליפול על האש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יותר מן הבהמה וכדנקט נמי מאי דשכיח ליה דרסה וטרפה בכותל גבי העוף אע\"פ שכך הדין בבהמה כמו שכתבתי במשנתינו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובתוספתא נמי תניא בהדיא גבי בהמה רצצתה חברתה ולעיל [דף נא.] נמי אמרינן שורים שמנגחים זה את זה וכו'. הילכך דינא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>נמי דנפלה לאור ונחמרו בני מעיה הרי היא בבהמה כבעוף והרב ב\"ה ז\"ל מטיל פשרה בדבר שעוף מכיון שנפל לאור חוששין לו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וצריך בדיקה חוץ מן הריאה שלו וכמו שכתבנו אבל בהמה שעורה קשה אין חוששין לה אלא שאם ראינו שנחמרה טרפה כדאמרינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גבי ריאה דעוף [הואיל] וצלעות מגינות עליה ואף זה אינו מחוור דכיון דבהמה מעוף ילפינן כשם שחוששין בעוף משעה שנפל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאור כך חוששין בבהמה ושניהם צריכים בדיקה חוץ מריאה של עוף לדברי מי שאומר דההוא לישנא דאין לו לא לינפל ולא ליחמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "באש קאי אמסקנא ואפשר לומר דההוא לישנא אמסקנא לא קאי ואפילו ריאה של עוף צריכה בדיקה ויתבאר לפנינו בס\"ד: <b>לא אמרו</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ירוקין פסולה אלא בלב וקרקבן וכבד.</b> פירוש לב וקרקבן מחמת עצמן שהרי הנקב פוסל בהן וכבד מחמת בני מעים אבל הרשב\"א",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כתב שאף בכבד משכחת לה מחמת עצמו כגון שהוריקה כבד במקום מרה ובמקום חיותא בכדי שאם ינטל מקום הירקות לא ישאר בו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כזית באחד מאלו המקומות דטרפה דכנטול כולו דמי והיינו דמני כבד בהדי לב וקורקבן דכולהו טרפותן מחמת עצמן והאי דלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מני ריאה בהדייהו אע\"ג דודאי היכא דנפלה והוריקה טרפה דאע\"ג דאמרינן לעיל [דף מז:] ירוקה כשרה מדרבי נתן ה\"מ בלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נפלה לאור אבל בנפלה לאור אין תולין בריאה כדרבי נתן כשם שאין [תולין] בכבד בחולי אלא היינו טעמא לפי שאין הריאה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עשויה ליחמר כלב וקורקבן וכבד הואיל וצלעות מגינות עליה ועוד שאפשר שאין דינה שוה עם אלו שלב וקרקבן וכבד צריכין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בדיקה כל שנפלה לאור וריאה של עוף אינה צריכה בדיקה והאי דלא מני טחול בהדייהו לדברי הרמב\"ם שהוא סובר שאין הנקב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פוסל בו אתי שפיר שכיון שאין הנקב פוסל בו אף הירקות אינו פוסל בו וכתב הרשב\"א שאין הירקות פוסל בכבד אלא ככרתי אבל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ירוק כביעתא או כמוריקא כשרה שהרי מראה זה מצוי הוא תמיד בכבד מחמת שומן והרא\"ה מוסיף שאף בלב וקורקבן אין הירוק",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פוסל בהן אלא ככרתי שכל שהאש מוריק ככרתי הוא מוריק: <b>ירוקין שהאדימו ושלקן והוריקו כשרה מ\"ט קוטרא הוא דעייל בהו.</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר מעיקרא ועכשיו הלך מחמת המים הרותחין: <b>אמר רב נחמן ברבי יצחק אף אנו נאמר אדומין שלא הוריקו ושלקן והוריקו</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>טרפה מ\"ט איגלי בהתתייהו.</b> כלומר חרפתן כך היא הגרסא בהלכות הרב אלפסי ז\"ל ויש מי שדקדק דמדנקט ירוקין שהאדימו ולא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נקט אדומין שהוריקו כדנקט תנא דמתניתין ירוקין פסולה ש\"מ שאין שלק ראיה לאדמימות כלל דכשחוזרין למראה ירקות הוא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאיכא למימר קוטרא עייל בהו א\"נ איגלי בהתתייהו אבל כשחוזרין למראה אדמימות אין זו ראיה כלל ובקצת ספרים הגרסא בהפך",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אדומין שהוריקו ושלקן והאדימו כשרה אמר רב נחמן בר' יצחק אף אנו נאמר ירוקין שלא האדימו ושלקן והאדימו טרפה ולפי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גירסא זו י\"ל דכי נקט אדומין שהוריקו סרכא דמתניתין נקט דקתני ירוקין פסולה אבל בין האדמימות בין הירקות ניכר ע\"י",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלק או אפשר אף לפי גירסא זו שאין השלק ראיה אלא לאדמימות אבל לא לירקות ולפיכך יש מי שמחמיר ואומר שמפני שנוי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הנוסחאות אין סומכין לעולם בשלק להתיר אלא לאיסור בין בירוקין בין באדומין אבל הרמב\"ם ז\"ל כתב בכולן והוא שיעמדו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "באותו מראה אחר ששולקין אותן: <b>אמר רב אשי הילכך לא ליכול איניש אלא בשלקא.</b> הילכך כיון דאמרינן דזמנין דמגליא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ריעותייהו כי שליק להו לא ליכול איניש עוף שנפל לאור אלא בשלקא: <b>אחזוקי איסורא לא מחזקינן.</b> כיון דלא מינכר ריעותא",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בהדיא אא\"כ מתרמי דשליק להו וחזי ריעותא: <b>דרסה וטרפה בכותל או שרצצתה בהמה ומפרכסת אם שהתה מעת לעת ושחטה כשרה.</b> תנא",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הכי גבי עוף והוא הדין לבהמה ורבותא קמ\"ל שאפילו בעוף שחיותו קל אם שהתה כשרה בבדיקה:",
      "segment_ids": [
        10
      ]
    }
  ],
