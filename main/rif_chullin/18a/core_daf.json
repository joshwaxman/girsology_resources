      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מרבי יהושע בן לוי <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>הוריקה כבד כנגד בני",
      "segment_ids": [
