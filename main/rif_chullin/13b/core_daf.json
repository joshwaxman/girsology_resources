        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחרינא ומדמינן האי ניקבא להאי ניקבא אי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמי (<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת</i> <i class=\"footnote\">מ\"ז</i>להאי) לאחר שחיטה אינקיב",
