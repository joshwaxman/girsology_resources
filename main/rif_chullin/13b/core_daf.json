        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כגון דאשתכח ניקבא בבני מעים ולא ידעינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אם קודם שחיטה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>אינקיב אם אחר שחיטה",
