        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכשרה ואי לא דמי קודם שחיטה אינקיב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וטרפה. הנהו בני מעים דאתו לקמיה דרבא",
      "segment_ids": [
