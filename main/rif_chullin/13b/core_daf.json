        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומגסה לגסה כגון צאן לצאן ושור לשור אבל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מדקה לגסה ומגסה לדקה לא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">אביי</i> <i class=\"footnote\">ורבא</i>",
