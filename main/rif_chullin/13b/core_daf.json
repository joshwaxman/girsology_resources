      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">דאמרי</i> <i class=\"footnote\">תרויהו</i> <i class=\"footnote\">כ\"ה</i> <i class=\"footnote\">בגמ'</i> <i class=\"footnote\">(ג\"א)</i>רבה ורבא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמרי תרוייהו <i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>מקיפין בקנה אמר רב פפא",
