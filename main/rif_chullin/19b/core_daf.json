  },
  "gemara": [
    {
      "width": "377px",
      "right": "275px",
      "text": "<big><strong>איתילידו</strong></big>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "377px",
      "text": "בהו ולא מהנך דאיתליעו בה",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "באיביה נינהו תנן התם בעלת",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "חמש רגלים או שאין לה אלא שלש",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הרי זו בעלת מום אמר רב הונא",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לא שאנו <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>חסר ויתיר אלא ביד",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אבל ברגל <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>טרפה נמי הוי מאי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "טעמא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>כל יתר כנטול דמי <i data-commentator=\"Tur\" data-label=\"⚬\"></i>ההיא",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "חיואתא דאישתכחו בה תרתין",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "סניין דיבי אייתוה לקמיה",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דרבינא וטרפה מדרב הונא דאמר",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "כל יתר כנטול דמי ואי שפכי",
      "segment_ids": [
        0
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "להדדי כשרה. ההיא גובתא דנפקא",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מבי כסי להובלילא סבר רב אשי",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "למיטרפה אמר ליה רב הונא הכי",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אמר אמימר בר רב (<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מ\"ז</i>בריה דרב) אויא הני עיזי",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "בריאתא כולהו הכי אית להו",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ההיא גובתא דנפקא מבי כסי",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לכריסא סבר מר בר רב אשי",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לאכשורה א\"ל רב הושעיא <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>כולהו",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "בחדא מחתא מחתינהו היכא",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דאיתמר איתמר היכא דלא איתמר",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "לא איתמר העיד (ר') יונתן בן",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "שילא ריש טבחיא דצפורי לפני",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "רבי על שני בני מעים שיוצאין",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "מן הבהמה כאחד טרפה כנגדן",
      "segment_ids": [
        0,
        1
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "בעוף כשרה. פירוש כל בהמה",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הדקין שלה חוט אחד הוא",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ומשוך. עכשיו אם יצא ממנו מעי",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "אחר כמו שיצא ענף בתוך הבד של",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "עץ טרפה במה דברים אמורים",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "כשיוצאין בשני מקומות אבל",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "יוצאין במקום אחד וכלין <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>עד",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "כאצבע כשרה והוא דהדרי וערבי",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "ונעשו שניהם חוט אחד אבל לא",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "הדרי וערבי הרי יתר בבהמה וכל",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "יתר כנטול דמי:",
      "segment_ids": [
        0,
        1,
        2,
        3
      ],
      "right": "275px"
    }
  ],
  "rashi": [
    {
      "width": "1010px",
      "text": "<b>תנן התם.</b> בבכורות [דף מ.] לענין",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "מומין: <b>לא שאנו.</b> דקתני הרי זה מום לגבוה",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "הא להדיוט שרי אלא שחסר ויתר ביד שחסר זה",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "משלש או יותר זה דבעל חמש ביד הוא שאין לו",
      "segment_ids": [
        0,
        1
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "450px",
      "text": "אלא יד אחת או שיש לו שלש ידים: <b>כנטול",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דמי.</b> הותיר אחת כחסר אחת כנגדו והוי כבעלת",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "רגל אחד וטרפה דהויא כשמוטת ירך בבהמה כך",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "פרש\"י ז\"ל ולפי זה נמצאו לה שני כבדים",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "טרפה דרואין כאילו ניטלו שניהם וניטל הכבד",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כולו טרפה אבל בטחול שאם ניטל כשרה אם יש",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לה שני טחולין כשרה אבל הר\"ם ב\"ן ז\"ל פירש",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דכנטל ממקומו המחובר לו ומקומו עמו קא",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אמרינן ולפיכך כשהיא מחוברת במקום בוקא",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דאטמא רואין כאילו ניטל הוא ובוקא דאטמא",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "של חברו וכן כשהיא סמוכה במקום צומת",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הגידין רואין כאילו ניטלו צומת הגידין של",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שניהם אבל רגל יתר המחובר למטה מבוקא",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דאטמא ומצומת הגידין כשרה ולפי זה אם היו",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לה שני טחולין הסמוכין זה לזה בסומכייהו",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "רואין כאילו ניטל היתר ומקומו עמו וישאר",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "השני נקוב בסומכיה וטרפה. אבל הרשב\"א ז\"ל",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כתב בתורת הבית שלו דכנטל בלחוד קאמרינן",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "כלומר כאילו ניטל הוא לבדו וכי תימא אם כן",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "יתר ברגל למה היא טרפה משכחת לה כגון",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "שהיתר מחובר במקום בוקא דאטמא בענין שאם",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "תעקור את זה ישמט בוקא דאטמא של חברו וכן",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "אם הוא מחובר במקום צומת הגידים בענין שאם",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ינטל יחתוך צומת הגידין של חברו הא יכול",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ליטלו בלא קלקול חברו אפי' ברגל כשרה",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "ולפ\"ז אם נמצאו לה שני טחולים סמוכים אפי'",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בסומכייהו כשרה שהרי יכול ליטול אחד מהם",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "וישאר חברו קיים אא\"כ היה אחד מהם נכנס",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בחברו בענין שאם ינטל אחד מהם לא ישאר",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "בחבירו כעובי דינר זהב דבכה\"ג [אינה] כשרה",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מיהו אף הרב לא אמרה אלא להלכה אבל לא",
      "segment_ids": [
        0,
        1,
        2
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "למעשה: <b>ההוא גובתא.</b> כמו קנה בשר: <b>דהוה",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "נפקא מבי כסי לכריסא סבר מר בר רב אשי",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לאכשורה.</b> כדאכשרנא מבי כסי להובלילא: <b>בחד",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מחתא מחתינהו.</b> וכי באריגה אחת ארגת",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "לכולם: <b>מחי.</b> מתרגמינן אורג: <b>היכא דאיתמר",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "דבריאתא הכי אית להו איתמר והיכא דלא",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "איתמר לא איתמר.</b> ויתר הוא וכאילו ניטל אחד",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "מן המעים כנגדו הוא וכל יתר כנטול דמי וכן",
      "segment_ids": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "right": "0px",
      "left": ""
    },
    {
      "width": "450px",
      "text": "הלכה דליכא מאן דפליג דאע\"ג דאמרן באונא",
      "segment_ids": [
