  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ת\"ר <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>ב\"ש אומרים מקנח וב\"ה אומרים מדיח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואסיקנא <span class=\"bavli-ref\" data-bavli-ref=\"(דף קה.)\" data-bavli-daf=\"105a\" data-bavli-index=\"0\"></span>דבית שמאי אומרים מקנח והוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדין למדיח וב\"ה אומרים מדיח והוא הדין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למקנח ומר אמר חדא ומר אמר חדא ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פליגי הילכך בעי קינוח והדחה והילכתא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בכל מילי הוי קינוח <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>הפה בין בפת בין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במילי אחרינא בר מתמרי וקימחא וירקא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וסימנך תק\"י: אמר רב חסדא אכל בשר אסור",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאכול גבינה. גבינה מותר לאכול בשר א\"ל",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב אחא בר יוסף לרב חסדא בשר שבין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השינים מהו קרי עליה (במדבר י״א:ל״ג)",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבשר עודנו בין שיניהם כלומר הבשר שבין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השינים בשר הוא: אמר מר עוקבא אנא בהא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מילתא חלא בר חמרא אנא דאילו אבא כד הוה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אכיל בישרא האידנא לא הוה אכיל גבינה עד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למחר כי השתא ואילו אנא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בס\"י</i>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">בחדא</i>[בהאי] סעודתא לא אכילנא בסעודתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחריתי אכילנא ושמעינן מהא דהאי דא\"ר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסדא אכל בשר אסור לאכול גבינה דלא שרי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למיכל גבינה בתר בשרא אלא עד דשהי ליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיעור מאי דצריך לסעודתא אחריתי דלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אשכחינן מאן דשרי למיכל גבינה בתר בישרא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפחות מהאי שיעורא דהא מר עוקבא אע\"ג",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דשהי ליה כי האי שיעורא קרי אנפשיה חלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר חמרא: אמר רב אידי בר אבין אמר רב",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצחק בר אשיאן <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>מים ראשונים מצוה אחרונים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חובה מיתיבי מים ראשונים ואחרונים חובה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמצעיים רשות מצוה לגבי רשות חובה קרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה גופא מים ראשונים ואחרונים חובה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמצעיים רשות מים ראשונים ניטלין בין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בכלי בין ע\"ג קרקע אחרונים אין ניטלין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא בכלי ואמרי לה אין ניטלין ע\"ג קרקע",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני שרוח רעה שורה עליהן איכא בינייהו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קינסא שהן חתיכות קרשים מים ראשונים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ניטלין בין בחמין בין בצונן אחרונים אין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ניטלין אלא בצונן אבל בחמין לא מפני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהחמין מפעפעין את הידים ואין מעבירין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הזוהמא ודוקא <span class=\"bavli-ref\" data-bavli-ref=\"(דף קח:)\" data-bavli-daf=\"108b\" data-bavli-index=\"1\"></span>חמין שהיד סולדת בהן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבל פושרין לית לן בה. אמצעיים רשות אמר",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב נחמן ל\"ש אלא בין <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>תבשיל <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>לתבשיל אבל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין תבשיל לגבינה חובה איכא מ\"ד דגמרינן",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>מיהא דרב נחמן דשרי למיכל גבינה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>בתר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בישרא דהא בין תבשיל לגבינה קאמר ואי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אסיר למיכל גבינה בתר בישרא הוה ליה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למימר בין גבינה לתבשיל ולא לימא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>בין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תבשיל לגבינה והא לאו מילתא היא דלא אתא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב נחמן לאשמועינן אלא דמים אמצעיים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חובה [בין בשר לגבינה] אבל אקדומי בשר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לגבינה וגבינה לבשר מדרב חסדא שמעינן לה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דקי\"ל דהא דרב חסדא הילכתא היא דהא קא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקשינן מינה (בדף קח.) לרבי יוחנן וקא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "[מדחינן] לדרבי יוחנן מקמה ואי לאו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הילכתא היא היכי דחינן למימרא דרבי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן מקמה ומתרצינן לה אליבא דרב חסדא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא שמעינן דהילכתא היא והא דרב נחמן לא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גמרינן מינה אלא דמים אמצעיים שבין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גבינה לבשר חובה ותו לא מידי. אמר רב",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה בר רב חייא מפני מה אמרו מים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחרונים חובה מפני שאדם אוכל אחר סעודתו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלח ויש בה מלח סדומית שמסמא את העינים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר אביי ומשתכחא כי קורטא בכורא וכו'",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כדכתיבנא לה במסכת ברכות <span class=\"bavli-ref\" data-bavli-ref=\"(דף מב:)\" data-bavli-daf=\"42b\" data-bavli-index=\"2\"></span>ואפילו אם לא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אכל מלח קבעו רבנן חובה משום <span class=\"bavli-ref\" data-bavli-ref=\"(דף קו.)\" data-bavli-daf=\"106a\" data-bavli-index=\"3\"></span>דמים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשונים האכילו בשר חזיר מים אחרונים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרגו את הנפש וכו':",
      "segment_ids": [
        8
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בית שמאי אומרים מקנח.</b> מקנח הפה כלומר שיאכל איזה דבר ביניהם: <b>ובה\"א מדיח.</b> פרש\"י",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל הדחת הפה ולפי זה כיון דמסקינן דתרוייהו בעינן צריכין קנוח פה והדחת פה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונטילת ידים ואינו נראה דא\"כ כי אמרינן קנוח הפה ונטילת ידים הוה לן למימר קנוח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פה והדחת פה ונטילת ידים לפיכך נראה דמדיח היינו נטילת ידים וב\"ש איירו בהכשר פה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וב\"ה בהכשר ידים וכולהו מודו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתרוייהו בעינן: <b>והלכתא בכל</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מילי הוי קינוח הפה בר מתמרי</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וקמחא [וירקא].</b> דבכל חד מהני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משטר קא שטר כלומר נדבק בחיך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינו מקנח אותו וקימחא משום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרכיך טפי ומפריך כלומר מתפרך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפה ואינו מקנח הפה והחיך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובסמוך יתבאר האי קינוח אי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סגי אפי' בין בשר וגבינה או",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא בין גבינה לבשר: <b>אמר רב</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חסדא אכל בשר אסור לאכול</b>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>גבינה.</b> משום דבשר מוציא שומן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוא נדבק בפה ומאריך בטעמו:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בשר שבין השינים מהו.</b> מי חשיב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר לאסור גבינה עד שנוטלו:",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הבשר עודנו.</b> אלמא בשר קרי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה: <b>אנא להא מילתא חלא בר</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חמרא.</b> אנא לדבר זה אני גרוע",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאבי כחומץ בן יין ויש שפירשו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכי אמר רב חסדא אכל גבינה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר לאכול בשר אפילו בלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קנוח הפה קאמר לפי שאין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגבינה וטעמה נשארת בפה אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמוקת מאליה. ומיהו נטילת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ידים בלילה דלא חזי צריך. ורב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יצחק בריה דרב משרשיא לא עבד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קנוח הפה כלל. דלגבינה ואח\"כ",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר לא צריך. [והכי] קאמר אכל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר אסור לאכול גבינה אא\"כ",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נטל ידיו וקנח פיו ומיהו בהכי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סגי אכל גבינה מותר לאכול בשר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו בלא קנוח פה וראיה לדבר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדאמרינן לקמן בסמוך [דף קה:]",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא שאנו אלא בין תבשיל לתבשיל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בין תבשיל לגבינה חובה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלמא איכא תקנתא בין תבשיל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לגבינה דלא צריך שהייה והיינו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קנוח פה ונטילה ומר עוקבא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהוה שהי מסעודתא לסעודתא מדת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חסידות היא שהיה נוהג בכך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וזהו דעת בעל הלכות ור\"ת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והר\"ז הלוי ז\"ל אבל הרי\"ף ז\"ל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירש דכי אמר רב חסדא אכל בשר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסור לאכול גבינה היינו עד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שישהה כדי שיעור סעודה אחרת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"ק אכל בשר אסור לאכול",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבינה עד שישהה כשיעור שבין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סעודה לסעודה ולא סגי ליה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקנוח אכל גבינה מותר לאכול",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר בקנוח הפה ונטילת ידים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכי אמרי ב\"ש וב\"ה מקנח ומדיח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכה\"ג היא וכן דעת הר\"ם במז\"ל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפ\"ט מהלכות מאכלות אסורות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולפ\"ז רב יצחק בריה דרב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משרשיא דאייתו ליה גבינה ואכל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואייתו ליה בשרא ואכל קינוח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפה עבד ודאמרינן לקמן אבל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין תבשיל לגבינה חובה. בין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תבשיל לגבינה דמעיקרא קאמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא שהר\"א ז\"ל מספק ואומר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאפשר שלא אסר הרי\"ף ז\"ל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאכול בשר ואח\"כ גבינה תוך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיעור סעודה אחרת אלא בלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קנוח הפה אבל בקנוח הפה שרי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותמיהני עליו שכיון שהרי\"ף",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל הביא ראיה ממימרא דמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עוקבא אלמא ס\"ל שלא מפני מדת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החסידות בלבד היה עושה כן אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שורת הדין ואם איתא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבקנוח הפה סגי למה היה מיקל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מר עוקבא יותר מאביו בכך והוה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרי נפשיה חלא בר חמרא ליעביד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קנוח הפה ואבוה נמי לא הוה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך לשהויי עד למחר ועוד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהרי בסמוך הוצרך לפרש הרי\"ף ז\"ל דכי אמר רב נחמן בין תבשיל לגבינה חובה בין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תבשיל לגבינה דמעיקרא קאמר ואם כדבריו לוקמה כפשטה <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>בקנוח הפה ולפיכך הדבר ברור",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהרי\"ף ז\"ל סובר דלבשר ואח\"כ גבינה לא סגי קנוח הפה אלא שהייה בעינן וכבר פשט",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המנהג כדברי הרי\"ף ומ\"מ נראין הדברים שמי שאכל בשר ושהה קצת ואח\"כ מצא בשר בין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיניו שאינו צריך שהייה כדי סעודה מאותו זמן שנטל הבשר משם אלא מאכילה ראשונה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חשבינן ליה לזמן שהייה ומיהו קנוח הפה מיהת משמע דבעינן: <b>מים ראשונים מצוה</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אחרונים חובה.</b> [חובה] עדיפא ממצוה ולקמן מפרש מאי חובתייהו: <b>בין בכלי.</b> תחתיהן",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לקבלם: <b>קינסא חתיכות קרשים.</b> למ\"ד דבעי כלי הכא לאו כלי הוא למ\"ד אין ניטלין ע\"ג",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קרקע סגי בקינסא: <b>מפעפעין.</b> מרככין את הידים ומבליעין בהן זוהמת התבשיל: <b>סולדת.</b>",
      "segment_ids": [
        9,
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נכוית: <b>אבל</b> בין תבשיל לגבינה חובה: <b>איכא מ\"ד וכו'.</b> כבר נתפרשה למעלה: <b>דהא מקשינן</b>",
      "segment_ids": [
        11,
        12,
        13,
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מינה לר' יוחנן.</b> בגמרא איתא: <b>מפני מה אמרו מים אחרונים חובה מפני שאדם אוכל אחר</b>",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>סעודתו מלח.</b> שאמרו חכמים אחר כל אכילתך אכול מלח וכיון דנגע במלח כי הדר יהיב",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ידיה אעיניה מסמא להו ולפיכך צריך לנטלן: <b>ומשתכחא כי קורטא בכורא.</b> אינה מצויה אלא",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קורט בכור וכתב הראב\"ד ז\"ל דכיון דמים אחרונים לא נתקנו אלא כדי להשמר מן הסכנה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אינו מברך עליהם כשם שאינו מברך כל שעה שהוא נשמר מן הסכנה ומיהו בברכות משמע",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמים אחרונים מצוה נמי איכא דאמרינן התם בפרק אלו דברים (דף נג:) והתקדשתם אלו",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מים ראשונים והייתם קדושים אלו מים אחרונים וקשיא אשמעתין אלא שהרב ז\"ל תירץ דהתם",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>למברך וכשאכל דבר מזוהם שהוא צריך ליטול ידיו כדאמרינן התם כשם שכהן מזוהם פסול",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעבודה כך ידים מזוהמות פסולות לברכה אבל כשלא אכל דבר מזוהם אי נמי לשאר המסובין",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אין בנטילתן מצוה אלא חובה משום מלח סדומית. וכתב רבינו האי ז\"ל דכל דבר לח שהוא",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מסתבך בידים מיקרי דבר מזוהם ואחרים אומרים שכל דבר שאינו קרב לגבי המזבח קרי",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מזוהם ושאינו מזוהם הוא הדבר הקרב כדאמרינן בהמה שקרבה לגבי המזבח פסקה זוהמתה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הלכך מי שאכל דבר מזוהם ובא לברך בהמ\"ז מברך על נט\"י כשם שמברך בראשונים ואיכא",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מ\"ד דאחרונים כיון שאין צריכות כלי אינו מברך ענט\"י אלא על רחיצת ידים דלשון",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נטילה הוא מלשון כלי הקרוי נטלא ולא נהירא דאפילו רחיצת ידים שאינה צריכה כלי",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיקרי נטילה בלשון חכמים לפי שרוב הרחיצות בכלי כדאמרינן עלה דתני אגרא הוא תני",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לה והוא אמר לה בלא קנוח הפה ובלא נטילת ידים אע\"ג דהתם ודאי לא בעינן אלא רחיצה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולפיכך אנו נוהגין לברך על נט\"י בשחרית לתפלה אע\"פ שאינן טעונות כלי. וכתב הראב\"ד",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל דבנטילת ידים שבין תבשיל לגבינה מברכינן [ברכה] אע\"ג דקרי להו חובה משום דלא",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמי לחובה דמים אחרונים. דהתם ליתא אלא משום סכנה אבל הכא מצוה איכא אבל אחרים",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אומרים דכה\"ג לא מיקרי מצוה שאינן באין אלא להמנע מן העבירה ויש בגמ' בכאן מימרות",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הרבה בדיני נט\"י וכתבן הרי\"ף ז\"ל בפרק ואלו דברים:",
      "segment_ids": [
        16
      ]
    }
  ],
