        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבינא אסר ורב אחא שרי בכל התורה כולה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב אחא לחומרא ורבינא לקולא והלכתא",
