        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שוריאקי סומקי אסירן ואי לא שריין אומצא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביעי ומוזריקי פליגי בה רב אחא ורבינא",
