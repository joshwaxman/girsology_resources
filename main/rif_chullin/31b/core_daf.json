      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבגוף מיד דמן ואע\"ג דבפרק",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השוחט (דף כח:) אמרינן דדוקא",
      "segment_ids": [
