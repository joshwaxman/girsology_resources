        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא אסמיק הוא וחלייה שרי רבינא אמר אע\"ג",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלא אסמיק נמי חלייה אסור אי אפשר דלית",
