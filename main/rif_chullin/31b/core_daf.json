        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרבינא לקולא בר מהני תלת דרב אחא לקולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ורבינא לחומרא והלכתא כרב אחא לקולא <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>האי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומצא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>דאסמיק חתכיה ומלחיה ואפילו לקדרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שפיר דמי תלייה בשפודא מידב דייב ושרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותביה אגומרי פליגי בה רב אחא ורבינא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חד אמר מישב שייבא ליה וחד אמר מיצמת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צמתא ליה והלכתא מישב שייבא ליה וכן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביעי וכן מוזריקי ביעי בקרמייהו חתכינהו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ומלחינהו אפי' לקדרה שריין תלינהו בשפודא ובית שפידא לתתאי מידב דייבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ושרו אנחינהו אגומרי הלכתא מישב שייבן ושרו: <span class=\"bavli-ref\" data-bavli-ref=\"(פסחים דף עד:)\" data-bavli-daf=\"74b\" data-bavli-scope=\"פסחים\" data-bavli-index=\"0\"></span>האי אומצא דאסמיק הוא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "וחלייה אסור לא אסמיק הוא וחלייה שרי רבינא אמר אע\"ג דלא אסמיק נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חלייה אסור אי אפשר דלית ביה שורייקי דדמא אמר ליה מר בר אמימר לרב אשי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אבא מגמע ליה גמועי א\"ד רבינא גופיה מגמע ליה גמועי והלכתא לא אסמיק הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "וחלייה שרי אמר ליה מר בר אמימר לרב אשי אבא האי חלא דחליט ביה חדא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "זימנא לא הוה חליט ביה זימנא אחריתא כלומר כיון שחלט בו נעשה חומץ רפוי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואינו ראוי לחלוט בו שהוא חשוב כמים ומאי שנא מחלא תמיהא כלומר ומאי שנא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "זה מחומץ שאינו חזק מעיקרו שהרי חולטין בו ואף על פי שאינו חזק א\"ל התם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "איתא לקיוהא דפירא בעיניה הכא ליתא לקיוהא דפירא בעיניה <span class=\"bavli-ref\" data-bavli-ref=\"(שם דף עד.)\" data-bavli-daf=\"74a\" data-bavli-scope=\"שם\" data-bavli-index=\"1\"></span><sup class=\"footnote-marker\">*</sup><i class=\"footnote\">אמר</i> <i class=\"footnote\">רבה</i> <i class=\"footnote\">האי</i>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<i class=\"footnote\">מולייתא</i> <i class=\"footnote\">שריא</i> <i class=\"footnote\">(ג\"א)</i>אמר רבא <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>האי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>מוליאתא שריא אמר ליה אביי והא קא בלעא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דמא אמר ליה כבולעה בך פולטה והלכתא מוליאתא שריא ואפילו פומא לעיל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ודוקא לצלי כעין הפסח שהוא צלי אבל לקדרה לא. <span class=\"bavli-ref\" data-bavli-ref=\"(כאן דף צג:)\" data-bavli-daf=\"93b\" data-bavli-scope=\"כאן\" data-bavli-index=\"2\"></span><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Forbidden Foods\" data-label=\"⚬\"></i>רישא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>בכבשא תלייה אבית",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שחיטה דייב אצדדין מקווא קוו ואסור אנחיריה אי דץ ביה מידי ופתחיה כי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היכי דליפוק דמא מיניה שרי ואי לא אסור פי' אנחירי מלשון (איוב מ״א:י״ב)",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מנחיריו יצא עשן אמר רב <span class=\"bavli-ref\" data-bavli-ref=\"(פסחים דף עד:)\" data-bavli-daf=\"74b\" data-bavli-scope=\"פסחים\" data-bavli-index=\"3\"></span><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>בשר שחוטה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>שמן שצלאו עם בשר נבלה כחוש אסור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דאזיל האי ומפטם ליה להאיך והדר האיך ומפטם ליה להאי ולוי אמר אפילו בשר",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בכל התורה כולה.</b> רב אחא ורבינא חד אמר הכי וחד אמר הכי בכולהו <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>הוא דמיקל רבינא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ורב אחא לחומרא: <b>אומצא דאסמיק.</b> בשר שהוא אדום ביותר וניכר שהדם נצרר בתוכו:",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>חתכיה.</b> לחתיכות הרבה: <b>תלייה בשפודא.</b> בתוך התנור לצלות: <b>מידב דייב ושרי.</b> אפילו בלא",
      "segment_ids": [
        2,
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חתיכה ומליתה אלא כרי מליחת צלי דבר מועט לדברי מי שמצריך כך בצלי וכמו שכתבתי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למעלה: <b>מישאב שאיב ליה.</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שואבין את הדם: <b>מצמת צמית</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ליה.</b> צומתין את הדם בבשר והוא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נצלה בתוכו: <b>מוזריקי.</b> חוטי",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צואר ורידין: <b>תלינהו בשפודא</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ובית שפודא לתתאי.</b> האי ובית",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שפודא לתתאי מלשון הרב אלפסי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל הוא ומשמע לי דדייק ליה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדאמרינן תליא בשפודא ואי לא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוי בית שפודא לתתאי אין זה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרך הניתלין: <b>ומאן</b> דאסר הכא",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום דמצמת צמית ליה אע\"ג",
