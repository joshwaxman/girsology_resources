      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כי נקיב להו בשעת שחיטה נפיק",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דם דחיים אבל שלא בשעת שחיטה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קריר ולא נפיק כתב הרב ז\"ל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהני מילי בניקבה בעלמא אבל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כי חותך להו לגמרי אפילו שלא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשעת שחיטה יוצא הדם מהן ואין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה מחוור דכל שלא בשעת שחיטה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודאי אין דם החוטין שנקרש",
      "segment_ids": [
