      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסירא משום שורייקי קטיני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאית בה ואע\"ג דחתכה פורתא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פורתא ומלחה אסירא [לא שנא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתורא ול\"ש דכל קנינא]. וכתבו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתוס' דכי אמרינן דאין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחזיקין דם בכרכשא והדרא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכנתא היינו בגופן אבל בשמנן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודאי יש בהם דם ולפי זה טוב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למלוח אותן מצד השומן קודם",
      "segment_ids": [
