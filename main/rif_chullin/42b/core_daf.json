      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהפכו אותן כיון דמשום שומן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא דבעו מליחה. ויש מי שאומר",
      "segment_ids": [
