      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסור הוא בא ואיכא למימר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דליתסר דלא דמי שאבר זה אין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו איסור מחמת עצמו משום טרפה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלל אלא מפני שהוא כאבר מן",
      "segment_ids": [
