      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסור וכדתנן [דף קטז:] כשרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שינקה מן הטרפה קיבתה אסורה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואף חלבה של זו כיון שמאבר",
