      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אמרן אלא דצילי אבל עכירי</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>טריפה ודצילי נמי לא אמרן אלא</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דלא אסרוח אבל אסרוח טרפה.</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרב אלפס ז\"ל סובר שאף בריאה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין מים זכים כשרים אלא דצילי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא אסרוח כלל אבל עכירי א\"נ",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסרוח לא כמו שכתבתי למעלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[ופי' מוגלא דכשר בריאה ופסול",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכוליא ליחה שאינה סרוחה הכי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוכח במיימ'] וכן דעת הר\"ם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במז\"ל בפ\"ז מהלכות שחיטה ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחוור כמו שכתבתי למעלה לפיכך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נראה דכי אמרינן לא אמרן אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דצילי ולא אסרוח אבל עכירי או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסרוח טרפה היינו דוקא בכוליא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בריאה בכל ענין כשרה דהא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן לעיל [דף מח:] גבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ריאה חזנהו דקיימי כנדי כנדי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טינרי טינרי ולא אמר להו ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מידי ומדלא בדקו אי אסרוח או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא משמע דבין כך ובין כך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשרה: <b>כוליא שהקטינה בדקה עד</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כפול בגסה עד כעינבה בינונית.</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתוב בהלכות גדולות דכפול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכעינבה כשרה פחות מכן טרפה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוא תימה דבגמרא [דף נה.]",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרי' שכל שיעורי חכמים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להחמיר כלומר דכי הוי חומרא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כי אמרינן עד ועד בכלל אמרינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה וכי הוי חומרא כי אמרינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עד ולא עד בכלל אמרינן ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכל מידי דהוי מדאורייתא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הילכך הכא אית לן למיזל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחומרא ולדון <i data-commentator=\"Hagahot HaBach\" data-label=\"י\" data-order=\"10\"></i>בטרפה כפול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכענבה וכתב הראב\"ד ז\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהקטינה דאמרינן היינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהקטינה לאחר ברייתה מחמת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חולי אבל קטנה בתולדתה אפילו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פחות מכפול כשרה והיכי ידעינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אי הוי מחמת חולי או לא כי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חזינן שהקרום שלה כווץ בידוע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמחמת חולי הוא ואם אינו כווץ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא שהוא עשוי כמדת הכוליא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוכחא מילתא שתחלת ברייתה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היתה כך וכשרה וכתב הר\"ם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במז\"ל בפרק עשירי מהלכות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחיטה דעוף אין לו שיעור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למטה: <b>איזו היא חרותה כל</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שצמקה ריאה שלה.</b> ויבשה ושדים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צומקים (הושע ט) מתרגמינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דדין יבשין: <b>שיחמא.</b> שחורה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינה מצננת כל כך כלבנה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומשמע דבדיקה זו היכא דלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ידעינן אי בידי שמים אי בידי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדם אבל כל היכא דידעינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבידי שמים אינה צריכה בדיקה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והיכא דידעינן דבידי אדם אין בדיקה מועלת לה ואחרים לא כתבו כן: <b>הגלודה</b> שניטל עורה מחמת שחין או מחמת מלאכה: <b>על</b>",
      "segment_ids": [
        4,
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מקום טיבורו.</b> התם בעינן כסלע: <b>ראשי פרקים.</b> בכל פרקי חוליותיה ועצמות השוק והירך בעינן שיור כסלע: <b>כל העור מציל</b>",
      "segment_ids": [
        6,
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בגלודה.</b> כל היכא דמשתייר ההוא כסלע מעלה ארוכה וחוזר כל עורה לקדמותה: <b>חוץ מעור בית הפרסות.</b> מן הארכובה ולמטה דלא",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוי עור מפני שהוא רך ולא חשיב עור אלא בשר: <b>הא מילתא לא איפסיקא הלכתא בהדיא וכו'.</b> האריך בזה הרב אלפסי ז\"ל הרבה",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ורוב דבריו פשוטים וכתב בכלל דבריו ועוד לא עדיפא הא מתניתא ממתניתין דתנן ואלו שעורותיהן כבשרן עור בית הפרסות",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר דלא חשיב עור אלא בשר והא אפקה רבי יוחנן מהלכתא ואוקמה ביחיד הכי איתא בגמרא דרבי יוחנן מוכח דיחידאה היא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אבל לרבנן אפילו עור בית הפרסות חשיב עור הילכך לית לן מהא מתניתא ראיה כלל פירוש דכיון דקתני ההיא מתניתא דעור",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שבשאר איברים אינו מציל דלא חשיב עור אשתכח דההיא מתניתא נמי יחידאה היא דאילו לרבנן אפילו עור בית הפרסות תשיב עור",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זו היא כוונת הרב אלפסי ז\"ל ואין דבריו ברורים אצלי דכי קתני ההיא מתניתא דבעינן דלהוי הך שיורא בבית תללה לאו משום",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דשארא לא להוי עור כיהיכי דתיקום כיחידאה אלא היינו טעמא דכל שנגלד כל בית חללה תו לא הדרא ובריא ואין להאריך בזה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אבל מ\"מ הוא ז\"ל פוסק כשמואל דמחמיר טפי שהוא מצריך שישאר מן העור שיעור גדול מן האחרים ואין זה מחוור שאין זה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מוציאנו מידי ספק שאילו היה מקום טיבורו וראשי פרקים שייכי בדשמואל אלא דאיהו בעי עור טפי היה בדין לפסוק כשמואל",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "[שבכלל] דבריו דבריהם אבל כיון שכל אחד תופס מקום [לעצמו] כיון שהדבר ספק אינו בדין להכשיר עד שיתקיימו דברי כולם",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר שישאר כסלע במקום טיבורו ועל פני כל השדרה כולה ובראשי פרקים וכן פסק הרמב\"ם ז\"ל בפ\"ט מהל' שחיטה:",
      "segment_ids": [
        10
      ]
    }
  ],
