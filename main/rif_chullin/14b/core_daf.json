  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דם עלה פי' משני צדדין נקב מפולש: נפלה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הגג ונשתברו רוב צלעותיה וכו': אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב הונא <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>הניח בהמה למעלה ובא ומצאה למטה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין חוששין משום ריסוק איברים: ההוא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדיא דהוה ליה לרבינא דחזא חושלא מפומא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאיגרא נפל מאיגרא לארעא אתא לקמיה דרב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אשי א\"ל הא דאמר רב הונא הניח בהמה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למעלה ובא ומצאה למטה אין חוששין משום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ריסוק איבדים משום דאית לה מידי למיסרך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והאי לא הוה לה מידי למיסרך או דילמא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום דאמידא נפשה והאי נמי אמידא נפשה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "א\"ל משום דאמידא נפשה והאי נמי אמידא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נפשה. ההיא אימרתא דהוה בי <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בס\"י</i> <i class=\"footnote\">איתא</i>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">ר'</i> <i class=\"footnote\">חנינא</i> <i class=\"footnote\">ובגמ'</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">חביבא</i>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">(ג\"א)</i>רחבניה והוה משדרת כרעיא בתריאתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רב יימר האי שגרונא נקטיה כלומר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חולי לקה אותה על הירך מתקיף לה רבינא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודילמא חוט השדרה איפסיק בדקוה ואשכחיה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרבינא ואפ\"ה הלכתא כרב יימר מ\"ט שגרונא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכיח חוט השדרה לא שכיח: א\"ר הונא זכרים",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המנגחין זה את זה אין חוששין משום ריסוק",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איברים ואי נפיל לארעא ודאי חוששין. אמר",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב מנשה הני דכרי דפתקי גנבי אין חוששין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום ריסוק איברים מאי טעמא אמתנייהו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שדו להו כי היכי דלירהטו קמייהו.",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אהדרינהו ודאי חיישינן וה\"מ דאהדרינהו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחמת יראה אבל מחמת תשובה ודאי תשובה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעליתא עבדי: אמר רב נחמן בית הרחם אין",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>משום ריסוק איברים <span class=\"bavli-ref\" data-bavli-ref=\"(דף נא:)\" data-bavli-daf=\"51b\" data-bavli-index=\"0\"></span>ואמר רב נחמן בית",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המטבחים אין בו משום ריסוק איברים. ההוא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורא דנפל ואישתמע קל גניחותיה עאל רב",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצחק בר שמואל בר מרתא ושקל משופרי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שופרי מיניה אמרי ליה רבנן לא חייש מר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום ריסוק איברים אמר להו הכי אמר רב",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צפרניו נועץ בקרקע עד שמגיע לארץ <span class=\"bavli-ref\" data-bavli-ref=\"(דף נא.)\" data-bavli-daf=\"51a\" data-bavli-index=\"1\"></span>ואמר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב יהורה אמר רב הכה על ראשה והלכה לה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלפי זנבה או על גבי זנבה והלכה לה כלפי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשה ואפילו כנגד כל השדרה אין חוששין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "משום ריסוק איברים ואי שלים חוטרא אפלגיה",
      "segment_ids": [
        8
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>נפלה מן הגג.</b> כלומר שאע\"פ שאין אנו רואין בה שבר ולא מכה חוששין לריסוק אברים וכל שלא שהתה מעת לעת ולא עמדה ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלכה אפילו בבדיקה לא מתכשרא דמדאמרינן בגמ' [דף נא:] עמדה אינה צריכה מעת לעת אבל בריקה ודאי בעיא מכלל דכי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עמדה אפילו בבדיקה לא מתכשרא וכי שהתה מעת לעת ושחטה כשרה כדתנן לקמן [דף נו.] גבי עוף ומיהו דוקא בבדיקה כדאיתמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עלה בגמרא מכלל דכי לא שהתה אפילו בבדיקה לא מתכשרא וא\"ת וכי היכי דמהניא לה בדיקה בתר שהייה אמאי לא מהניא נמי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קודם שהייה י\"ל דבנפילה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חיישינן לתרתי חדא לריסוק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איברים ודבר זה אינו ניכר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בבדיקה כלל שאע\"פ שלא נשתנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איבריה ולא נפסד מראיתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוששין שמא מחמת הנפילה נתרסק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"פ שאינו ניכר ואיכא למיחש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>שמאנקרעו איבריה או נפסקו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודבר זה אפשר לעמוד עליו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בבדיקה וכל ששהתה מע\"ל או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעמדה יצאנו מחשש ריסוק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איברים דקים להו לרבנן דכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנתרסקו אבריה אינה עומדת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינה שוהה מיהו אכתי איכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למיחש שמא נקרעו איבריה או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפסקו ומש\"ה בעיא בדיקה <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>ולפי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיטה זו א\"צ לבדוק אא\"כ נפסקו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איבריה או נקרעו אבל ריסוק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איברים אין לו ענין בבדיקה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלל: <b>אבל</b> הר\"ם במז\"ל כתב בפ'",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ט' מהל' שחיטה שצריך לבדוק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ג\"כ אם נתרסקו איבריה כלומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אם נשתנה מראיתן ואפילו באותן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איברים שאם ניקבו או נטלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשרה אם נשתנו מראיתן טרפה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפי שריסוקן מכאיב אותה יותר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מנטילתן ונקיבתן ולפי זה בשני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרכים בודקין אותה אם נקרע או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפסק אחד מן האיברים שהיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיטרפא בהן ואם נשתנה אחד מן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיברים הפנימים מפני חשש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ריסוק איברים וכ\"ת וכיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהריסוק הוא דבר שאפשר לעמוד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו בבדיקה כי לא שהתה נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמאי לא סגי בבדיקה י\"ל לפי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין הריסוק ניכר לאלתר עד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שתשהה מעת לעת שאז כל אבר שיש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בה מרוסק תפסד צורתו ויתגלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהיתיתיה והראב\"ד ז\"ל מסתפק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהשגות באותן איברים שאם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניטלו או ניקבו כשרה אם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ריסוקן כלומר אם שנוי מראיהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פוסל בהן: <b>ונפולה</b> זו שחוששין",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה דוקא שנפלה מגובה עשרה אבל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פחות מכן אין חוששין לה דאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חבוט בפחות מעשרה טפחים וכדאמרינן בב\"ק בפ' הפרה (דף נ:) גבי ההוא תורא דנפל לאריתא דדלאי שחטיה מריה וטרפיה רב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נחמן ואקשינן אלמא קסבר רב נחמן יש חבט בפחות מעשרה ואותביה רבא לרב נחמן תנן היו פחותין מעשרה וכו' ואסיקנא דלעולם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אין חבט בפחות מעשרה ורב נחמן דטרפה משום דאריתא דדלאי הויא שיתא ומכריסה ועד ארעא ארבעה והוה ליה עשרה וכן כתב בעל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלכות גדולות ז\"ל וכן כתב הר\"ם במז\"ל בפ\"ט מהל' שחיטה שנפולה זו שנפלה הבהמה ממקום גבוה שגבהו י' טפחים אע\"פ שמדברי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הרב אלפסי ז\"ל בפרק הפרה משמע דס\"ל דיש חבט בפחות מעשרה לא משמע הכי מסוגיא דהתם ומיהו ה\"מ בנפלה מעצמה אבל הפילוה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחרים אפילו בפחות מכן חיישינן וכדאמרינן בגמרא בזכרים המנגחין זה את זה דאי נפול לארעא חיישינן: <b>(גמ') הניח בהמה</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>למעלה ובא ומצאה למטה אין חוששין מחמת ריסוק איברים.</b> משום דלא חיישינן ביה אלא בנפלה ודאי שלא לדעת אבל מסתמא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמרינן דקפצה מדעת וכל לדעת אין בו משום ריסוק איברים משום דאיהי אמדא נפשה ואפילו אנו רואין שאין יכולה לילך אפ\"ה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כל לדעת עצמה אינה מתרסקת כל כך שתטרף מחמת [ריסוק] איברים: <b>ההוא גדיא דהוה ליה לרבינא בגג.</b> והיתה ארובה בגג: <b>חזא</b>",
      "segment_ids": [
        3,
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>חושלא.</b> שעורים קלופים: <b>מפומא.</b> כנגד פי הארובה למטה בבית: <b>משום דאית ליה מידי למסרך.</b> שלא קפצה דרך ארובה אלא בצידי",
      "segment_ids": [
        5,
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הגג מסרכת עצמה בכותלים וקופצת ומהניא לה סריכת הכותלים שמסרכת בידיה קצת: <b>והאי לית ליה מידי למסרך.</b> שהארובה אינה",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סמוכה לכותל: <b>דאמדא נפשה.</b> ואם גבוה לה יותר מדאי אינה קופצת: <b>ההיא אימרתא דהות בי [רחבניה] והוה משדרה כרעא</b>",
      "segment_ids": [
        8,
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בתרייתא.</b> רגליה האחרונים היו נגררים אחריה: <b>זכרים המנגחים זה את זה אין חוששין משום ריסוק אברים.</b> שאין בהכאתם כדי",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ריסוק אברים להטרף: <b>נפול לארעא ודאי חיישינן.</b> ולאו משום הכאתם אלא משום החבט: <b>ואע\"ג</b> דקי\"ל בפרק הפרה [שם] דאין חבט",
      "segment_ids": [
        11,
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בפחות מעשרה טפחים ה\"מ בשנפל מעצמו אבל אם היה מכח אחר שדחפו יש חבט: <b>הני דכרי דפתקי גנבי.</b> שגונבין אותן ומשליכין",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אותן מכותלי החצר לארץ: <b>אמתנייהו.</b> על מתניהם נופלים ואינן נהפכים על גבן שיתפרקו חליותיהן: <b>אהדרינהו.</b> דרך למעלה מן",
      "segment_ids": [
        14,
        15,
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הכותל ודאי חיישינן דלא איכפת להו כל היכי דנפלי: <b>וכתב</b> הרב רבינו משה בר נחמן ז\"ל דבכל מאי דאיתמר בשמעתין אין",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חוששין משום ריסוק איברים אין חוששין כלל קאמר ואפילו בדיקה נמי לא בעיא ובהני נמי דאמרינן חוששין לאו דוקא למימר",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דיהבינן להו דיני נפולה ודאית דמתניתין ובעי שהייה ובדיקה אלא בודקין אותם מעכשיו בלא עמידה ושהייה כלל. ולא מחוור",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דנהי דודאי כי קאמרינן אין חוששין לה אין חוששין כלל קאמרינן ולא בעינן ולא מידי אפ\"ה כי קאמרינן חוששין משמע שדינה",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כדין נפולה גמורה ואע\"ג דאמרי' לישנא דחוששין היינו טעמא משום דכולה מילתא דריסוק אינה אלא חששא בעלמא הילכך דינה",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כנפולה גמורה לשהייה ולבדיקה: <b>א\"ר (הונא) [נחמן] בית הרחם.</b> עגל שנולד היום שיצא מבית הרחם אין חוששין שמא נדחק",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ונתרסקו איבריו ואין צריך לשהותו מעת לעת ובדקים לן שכלו חדשיו עסקינן דאי לא הא איכא למיחש שמא נפל הוא וכתבו",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הראשונים ז\"ל דאפילו במקשה לילד קאמר דאי בשאינה מקשה פשיטא דאין בו משום ריסוק אברים דא\"כ רוב הנולדים ימותו ואין",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זה עולה לי לפי סוגיית הגמרא כמו שכתבתי בחידושי ולפיכך נ\"ל דאפילו בשאינה מקשה איצטריך לאשמועינן דאין חוששין",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לריסוק איברים ומאן דדחי סייעתי' כדאיתא בגמרא ס\"ל דאפילו בשאינה מקשה איכא למימר דחיישינן וכ\"ת אם כן רוב הנולדים",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ימותו איכא למימר דודאי פשיטא לן דברובא ליכא ריסוק אברים אלא מיהו אי מיעוטא דמתרסקי בשעת לידה הוי מיעוטא דשכיח",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כיון דאיכא למיקם עלה דמילתא בשהיית מעת לעת לא סמכינן ארובא כדכתב' לעיל דמהאי טעמא צריך לבדוק בסירכות הריאה",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמיעוטא דשכיחא נינהו ומשום הכא קמשמע לן דמיעוטא דמתרסקי בבית הרחם מיעוטא דלא שכיח הוא ולא חיישינן ליה כלל ומאן",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דדחי סייעתא כדאיתא בגמרא ס\"ל דמעוטא דשכיחא הוא: <b>בית המטבחים אין בו משום ריסוק אברים.</b> כשמפילין אותו לארץ אפילו",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ממקום גבוה: <b>ההוא תורא דנפל.</b> בבית המטבחים: <b>קל גניחותיה.</b> כמו גונח מלבו שנשמע קול יללתו כשנפל: <b>צפורניו נועץ בקרקע</b>",
      "segment_ids": [
        19,
        20,
        21,
        22
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עד שמגיע לארץ.</b> כשהוא שוהה ליפול כל שעה הוא מתחזק בצפורניו עד שאינו נופל מגובה: <b>וכתב</b> הרשב\"א ז\"ל דאע\"פ שגבוה י'",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קאמר ואע\"פ שאחרים מפילים אותו בכח וכדיהיב רב יצחק טעמא משמיה דרב דאמודי אמיד נפשיה ונועץ צפורניו לקרקע עד שמגיע",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לארץ וגרסינן בירושלמי אינו דומה נופל מדעת לנופל שלא מדעת ביומי דרבי פינחס חבטין תורא בחיליה אמר לון בחייכון",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שרוניה שרו ליה וערק אמר ברוך שבחר בהם ובדבריהם דאמרי אילין דחבטין תורא בחיליה לית ביה משום ריסוק איברים: <b>הכה לה</b>",
      "segment_ids": [
        23,
        24
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>על ראשה במקל והלכה לה כלפי זנבה או על זנבה והלכה לה כלפי ראשה.</b> ולא נגע בשדרה: <b>ואפילו כנגד כל השדרה.</b> שהכה בכל",
      "segment_ids": [
        24,
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "השדרה: <b>ואי שלים חוטרא אפלגא דחרציה.</b> שנשלם המקל וכלה במקצת השדרה:",
      "segment_ids": [
        25,
        26
      ]
    }
  ],
