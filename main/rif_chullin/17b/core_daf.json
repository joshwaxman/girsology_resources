  "rashi": [
    {
      "width": "1010px",
      "text": "<b>מתני' אלו טרפות בעוף.</b> אע\"ג דכל טרפות",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "דבהמה כנגדן בעוף הני איצטריכו ליה למתניא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "נקובת הוושט משום פסוקת הגרגרת וההיא",
      "segment_ids": [
        0
      ],
      "right": "0px",
      "left": "0px",
      "_ry_header": true
    },
    {
      "width": "1010px",
      "text": "איצטריכא ליה דלא תימא הואיל וחיותו של",
