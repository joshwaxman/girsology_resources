        2,
        3,
        4,
        5,
        6
      ],
      "right": "275px"
    },
    {
      "width": "377px",
      "text": "דמיין: <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>ניקב הקרקבן: <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>א\"ר יצחק",
      "segment_ids": [
        0,
