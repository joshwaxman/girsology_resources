  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>שישחוט את הורידין <span class=\"bavli-ref\" data-bavli-ref=\"(דף כח:)\" data-bavli-daf=\"28b\" data-bavli-index=\"0\"></span>אמר רב חסדא לא לכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "א\"ר יהודה אלא לעוף הואיל וצולהו כולו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאחת אבל בהמה הואיל ומנתחה אבר אבר לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צריך. תניא כותיה דרב חסדא שחט שני חצאי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סימנין בעוף פסולה ואין צריך לומר בבהמה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יהודה אומר בעוף עד שישחוט את הושט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושני ורידין אמר רבי יוחנן ורידין לרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה מנקבן ואפילו בקוץ בשעת שחיטה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכשרין ומאי שנא בשעת שחיטה הואיל ודם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חמים הוא ונפיק. שלא בשעת שחיטה קריר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא נפיק: <b><big>מתני'</big></b> <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>השוחט שני ראשים כאחד",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחיטתו כשרה שנים אוחזין בסכין ושוחטין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו אחד מלמעלה ואחד מלמטה שחיטתן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשרה: <b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף ל.)\" data-bavli-daf=\"30a\" data-bavli-index=\"1\"></span>אמר רב יהודה אמר רב השוחט",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בשנים ושלשה מקומות כשר כי אמריתה קמיה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דשמואל אמר לי בעינן שחיטה מפורעת וליכא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והלכתא כרב דקיימא לן הילכתא כרב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באיסורי ועוד <span class=\"bavli-ref\" data-bavli-ref=\"(דף ל:)\" data-bavli-daf=\"30b\" data-bavli-index=\"2\"></span>דההוא תורא דאישתחוט בשנים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושלשה מקומות עאל רב יצחק ושקל משופרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שופרי מיניה אמר ליה רבי זירא למדתנו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבינו משנתנו בשני סכינים ושני בני אדם.",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכן שחיטה העשויה כמסרק ושחיטה העשויה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כקולמוס כשרה אמר רב יהודה אמר רב <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ritual Slaughter\" data-label=\"⚬\"></i>החליד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סכין בין סימן לסימן [ופסקו] פסולה. תחת",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העור כשרה מאי קא משמע לן תנינא או",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהחליד את הסכין תחת השני ופסקו רבי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישבב אומר נבלה ומטמאה במשא רבי עקיבא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר טרפה אי ממתני' הוה אמינא הני מילי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלמטה למעלה דלא עביד כדרכה דשחיטה אבל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכא מלמעלה למטה דעביד כדרכה דשחיטה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אימא שפיר דמי קמ\"ל בי רב אמרינתחת העור",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איני יודע וכן תחת המטלית וכן תחת צמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסובך",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הואיל וצולהו כולו כאחד.</b> לפיכך צריך להוציא כל דמו: <b>מנקבן בקוץ בשעת שחיטה.</b> שאין",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "צריך לשחטן בסכין שאינן משיעור שחיטה ולא הוזכרו אלא להוציא מהן דם. וכתב הראב\"ד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל דמדנקט צולהו ולא נקנו מבשלו משמע דשחיטת ורידין לא סגי אלא בצלי משום דנורא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מישב שאיב ליה לדמא ולא בעינן חתיכת שאר חוטין כדאמרינן לקמן בפרק הזרוע (דף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קלג.) אמר רב הונא חוטין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבלחי אסורין וכל כהן שאינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יודע ליטלן אין נותנין לו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתנות ולא היא אי בטוויא מידב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דייב אי בקדרה איידי דחתך להו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומלח להו מידב דייבי הילכך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לצלי הוא דסגי בשחיטת ורידין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל לקדרה דבעינן חתיכת חוטין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו שחט את הורידין צריך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחתוך את העוף אבר אבר ולחתוך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ג\"כ כל החוטין שבגוף ולמלוח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקום חתך ובבהמה נמי דאמרינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבניתוח אבר אבר סגי ולא בעי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למחתך חוטין גופייהו היינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לצלי אבל לקדרה לא סגי עד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחתיך להו לכלהו חוטין והביא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראיה לדבריו מדאמרינן בפרק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גיד הנשה (דף צג.) חמשא חוטי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוו תלתא משום תרבא ותרי משום",
