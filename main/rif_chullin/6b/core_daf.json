      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הושט בלבד ואחד שחט הקנה בלבד זה שלא",
      "segment_ids": [
