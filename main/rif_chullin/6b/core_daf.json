      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל לקדרה דבעינן חתיכת חוטין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו שחט את הורידין צריך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחתוך את העוף אבר אבר ולחתוך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ג\"כ כל החוטין שבגוף ולמלוח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקום חתך ובבהמה נמי דאמרינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבניתוח אבר אבר סגי ולא בעי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למחתך חוטין גופייהו היינו",
      "segment_ids": [
