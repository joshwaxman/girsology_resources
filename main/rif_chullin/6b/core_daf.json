      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החתכים שוים בהיקף אחד בין אם היו שני",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בני אדם ששחטו בשני סכינין ואחד שחט",
      "segment_ids": [
