    {
      "width": "380px",
      "right": "275px",
      "text": "מותר איני והאמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">איני</i> <i class=\"footnote\">והאמר</i>",
