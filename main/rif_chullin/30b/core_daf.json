      "right": "275px",
      "text": "<i class=\"footnote\">ר'</i> <i class=\"footnote\">אבא</i> <i class=\"footnote\">אמר</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">יהודה</i> <i class=\"footnote\">אמר</i> <i class=\"footnote\">שמואל</i> <i class=\"footnote\">האי</i> <i class=\"footnote\">תרבא</i>",
