ih","speaker":null,"head":"אֶלָּא, כִּי","text":"אֶלָּא, כִּי אִיתְּמַר הָכִי אִיתְּמַר: אָמַר רַבִּי אַסִּי אָמַר רַבִּי יוֹחָנָן: זָר שֶׁסִּידֵּר שְׁנֵי גְּזִירֵי עֵצִים חַיָּיב, הוֹאִיל וַעֲבוֹדַת יוֹם הִיא."},{"id":14,"seg":5,"role":"probe.attack.difficulty","conf":"high","src":"english+hebrew+kih","speaker":null,"head":"מַתְקֵיף לַהּ","text":"מַתְקֵיף לַהּ רָבָא: אֶלָּא מֵעַתָּה תִּיבְּעֵי פַּיִיס!"},{"id":16,"seg":6,"role":"probe","conf":"high","src":"kih","speaker":null,"head":"לְמֵימְרָא דַּעֲבוֹדַת","text":"לְמֵימְרָא דַּעֲבוֹדַת יוֹם בָּעֲיָא פַּיִיס עֲבוֹדַת לַיְלָה לָא בָּעֲיָא פַּיִיס?"},{"id":18,"seg":6,"role":"respond.answer","conf":"high","src":"english","speaker":null,"head":"סוֹף עֲבוֹדָה","text":"סוֹף עֲבוֹדָה דִימָמָא הִיא."},{"id":19,"seg":6,"role":"probe.question","conf":"high","src":"english+biur","speaker":null,"head":"וַהֲרֵי תְּרוּמַת","text":"וַהֲרֵי תְּרוּמַת הַדֶּשֶׁן!"},{"id":20,"seg":6,"role":"respond.answer","conf":"high","src":"english+kih","speaker":null,"head":"מִשּׁוּם מַעֲשֶׂה","text":"מִשּׁוּם מַעֲשֶׂה שֶׁהָיָה."},{"id":21,"seg":7,"role":"probe.question","conf":"high","src":"english+kih+biur","speaker":null,"head":"לְמֵימְרָא דַּעֲבוֹדַת","text":"לְמֵימְרָא דַּעֲבוֹדַת יוֹם וְשֶׁזָּר חַיָּיב עָלֶיהָ מִיתָה בָּעֲיָא פַּיִיס, אֵין זָר חַיָּיב עָלֶיהָ מִיתָה לָא בָּעֲיָא פַּיִיס?"},{"id":23,"seg":7,"role":"respond.answer","conf":"high","src":"english+hebrew+kih+biur","speaker":null,"head":"שָׁאנֵי שְׁחִיטָה","text":"שָׁאנֵי שְׁחִיטָה דִּתְחִלַּת עֲבוֹדָה הִיא."},{"id":24,"seg":8,"role":"probe","conf":"high","src":"english+hebrew+kih","speaker":null,"head":"אָמַר מָר","text":"אָמַר מָר זוּטְרָא, וְאִיתֵּימָא רַב אָשֵׁי, וְהָא אֲנַן לָא תְּנַן הָכִי: אָמַר לָהֶם הַמְמוּנֶּה צְאוּ וּרְאוּ אִם הִגִּיעַ זְמַן הַשְּׁחִיטָה."},{"id":26,"seg":9,"role":"respond.answer","conf":"high","src":"english+kih+biur","speaker":null,"head":"הָךְ דְּלֵית","text":"הָךְ דְּלֵית לַהּ תַּקַּנְתָּא — קָתָנֵי, הָךְ דְּאִית לַהּ תַּקַּנְתָּא — לָא קָתָנֵי."},