{"daf":"12a","version":1,"tier":"adjacency","assurance":{"basis":"adjacency over discourse role labels","authoredBy":"rule","humanReviewed":false,"note":"Every edge is inferred from label order, not derived by a solver. See discourse_roles/docs/013 for the measured agreement against SVARA's solver-derived graphs."},"units":[{"label":"","from":0,"nodes":[{"id":0,"seg":0,"role":"assert.narrative","conf":"med","src":"english","speaker":null,"head":"לְבָתַר דִּנְפַק,","text":"לְבָתַר דִּנְפַק, אֲמַר לְהוּ עוּלָּא, הָכִי אָמַר רַבִּי אֶלְעָזָר: אֲפִילּוּ מִיַּתְמֵי."},{"id":2,"seg":1,"role":"assert.narrative","conf":"med","src":"english","speaker":null,"head":"הֲוָה עוֹבָדָא","text":"הֲוָה עוֹבָדָא בִּנְהַרְדְּעָא, וְאַגְבּוֹ דַּיָּינֵי דִנְהַרְדְּעָא."},{"id":8,"seg":4,"role":"adduce.proof","conf":"med","src":"english+biur","speaker":null,"head":"לֵימָא כְּתַנָּאֵי","text":"לֵימָא כְּתַנָּאֵי –"},{"id":12,"seg":6,"role":"probe.attack.objection","conf":"med","src":"hebrew","speaker":null,"head":"וְהָתַנְיָא: הֶחְזִיק","text":"וְהָתַנְיָא: הֶחְזִיק בַּעֲבָדִים – קָנָה מִטַּלְטְלִין!"},{"id":14,"seg":8,"role":"probe.attack.rejection","conf":"high","src":"english+biur","speaker":null,"head":"אָמַר רַב","text":"אָמַר רַב אִיקָא בְּרֵיהּ דְּרַב אַמֵּי: דְּכוּלֵּי עָלְמָא – עֲבָדִים כִּמְקַרְקְעֵי דָּמֵי."},{"id":17,"seg":9,"role":"probe.question.source","conf":"high","src":"english+hebrew","speaker":null,"head":"מְנָהָנֵי מִילֵּי?","text":"מְנָהָנֵי מִילֵּי?"},{"id":20,"seg":10,"role":"respond.answer","conf":"high","src":"english","speaker":"Rav Ika","head":"וְהָדְתַנְיָא לֹא","text":"וְהָדְתַנְיָא לֹא קָנָה – שַׁפִּיר; הָא דְּתַנְיָא קָנָה – בְּעוֹדָן עָלָיו."},{"id":21,"seg":11,"role":"probe.question","conf":"high","src":"english+biur","speaker":null,"head":"וְכִי עוֹדָן","text":"וְכִי עוֹדָן עָלָיו מַאי הָוֵי?"},{"id":24,"seg":12,"role":"respond.conclusion.accepted","conf":"high","src":"english+hebrew+biur","speaker":null,"head":"וְהִלְכְתָא בְּכָפוּת.","text":"וְהִלְכְתָא בְּכָפוּת."},{"id":25,"seg":13,"role":"probe.attack.objection","conf":"med","src":"hebrew","speaker":null,"head":"וְהָתַנְיָא: הֶחְזִיק","text":"וְהָתַנְיָא: הֶחְזִיק בְּקַרְקַע – קָנָה עֲבָדִים!"},{"id":26,"seg":14,"role":"respond.answer","conf":"med","src":"biur","speaker":null,"head":"הָתָם בְּעוֹמְדִין","text":"הָתָם בְּעוֹמְדִין בְּתוֹכָהּ."},{"id":27,"seg":15,"role":"probe.question","conf":"med","src":"biur","speaker":null,"head":"מִכְּלָל דְּהַאי","text":"מִכְּלָל דְּהַאי ״לֹא קָנָה״ – כְּשֶׁאֵין עוֹמְדִין בְּתוֹכָהּ?"},{"id":28,"seg":16,"role":"probe.attack.difficulty","conf":"med","src":"hebrew","speaker":null,"head":"הָנִיחָא לְהָךְ","text":"הָנִיחָא לְהָךְ לִישָּׁנָא דְּאָמַר רַב אִיקָא בְּרֵיהּ דְּרַב אַמֵּי: עַבְדָּא כְּמִטַּלְטְלִי דָּמֵי; הַיְינוּ דְּאִי עוֹמְדִין בְּתוֹכָהּ – אִין, אִי לָא – לָא."},{"id":31,"seg":18,"role":"probe.attack","conf":"med","src":"biur","speaker":null,"head":"וְלִיטַעְמָיךְ, לְהָךְ","text":"וְלִיטַעְמָיךְ, לְהָךְ לִישָּׁנָא דְּאָמַר: עַבְדָּא כְּמִטַּלְטְלִין דָּמֵי; לְמָה לִי עוֹמֵד בְּתוֹכָהּ?"}],"edges":[{"source":8,"target":2,"type":"supports","regime":"evidence","gap":1,"confidence":"high","basis":"adjacency"},{"source":12,"target":2,"type":"attacks","regime":"attack","gap":2,"confidence":"medium","basis":"adjacency"},{"source":14,"target":2,"type":"attacks","regime":"attack","gap":3,"confidence":"low","basis":"adjacency"},{"source":20,"target":17,"ordinal":1,"type":"answers","regime":"structural","gap":1,"confidence":"high","basis":"adjacency"},{"source":24,"target":21,"ordinal":1,"type":"concludes","regime":"structural","gap":1,"confidence":"high","basis":"adjacency"},{"source":25,"target":24,"type":"attacks","regime":"attack","gap":1,"confidence":"high","basis":"adjacency"},{"source":26,"target":25,"ordinal":1,"type":"answers","regime":"structural","gap":1,"confidence":"high","basis":"adjacency"},{"source":28,"target":26,"type":"attacks","regime":"attack","gap":2,"confidence":"medium","basis":"adjacency"},{"source"