":"בְּסוֹתֵר בַּלַּיְלָה.","text":"בְּסוֹתֵר בַּלַּיְלָה."},{"id":29,"seg":16,"role":"probe.question","conf":"high","src":"english","speaker":null,"head":"בַּלַּיְלָה נָמֵי","text":"בַּלַּיְלָה נָמֵי אִיבְּעִי לֵיהּ עַיּוֹנֵי!"},{"id":30,"seg":16,"role":"adduce.proof","conf":"med","src":"english","speaker":null,"head":"בְּסוֹתֵר אֶת","text":"בְּסוֹתֵר אֶת כּוֹתְלוֹ בַּיּוֹם – לְאַשְׁפָּה."},{"id":31,"seg":17,"role":"probe.question","conf":"high","src":"english+hebrew","speaker":null,"head":"הַאי אַשְׁפָּה","text":"הַאי אַשְׁפָּה הֵיכִי דָמֵי?"},{"id":35,"seg":19,"role":"assert.citation","conf":"med","src":"english","speaker":"Rav Pappa","head":"רַב פָּפָּא","text":"רַב פָּפָּא מִשְּׁמֵיהּ דְּרָבָא מַתְנִי לַהּ אַרֵישָׁא: הַנִּכְנָס לַחֲנוּתוֹ שֶׁל נַגָּר שֶׁלֹּא בִּרְשׁוּת, וְנִתְּזָה לוֹ בְּקַעַת וְטָפְחָה לוֹ עַל פָּנָיו, וָמֵת – פָּטוּר."},{"id":38,"seg":21,"role":"probe.question","conf":"high","src":"english","speaker":null,"head":"וּמִי חַיָּיב","text":"וּמִי חַיָּיב גָּלוּת?"},{"id":39,"seg":21,"role":"probe.attack.objection","conf":"med","src":"hebrew","speaker":null,"head":"וְהָתַנְיָא: הַנִּכְנָס","text":"וְהָתַנְיָא: הַנִּכְנָס לַחֲנוּתוֹ שֶׁל נַפָּח, וְנִתְּזוּ נִיצוֹצוֹת וְטָפְחוּ לוֹ עַל פָּנָיו וָמֵת – פָּטוּר, וַאֲפִילּוּ נִכְנַס בִּרְשׁוּת!"},{"id":40,"seg":22,"role":"respond.answer","conf":"high","src":"english+hebrew","speaker":null,"head":"הָכָא בְּמַאי","text":"הָכָא בְּמַאי עָסְקִינַן – בִּשְׁוַלְיָא דְנַפָּחֵי."},{"id":41,"seg":22,"role":"probe.question","conf":"high","src":"english","speaker":null,"head":"שְׁוַלְיָא דְנַפָּחֵי","text":"שְׁוַלְיָא דְנַפָּחֵי לְמִקְטְלֵאּ קָאֵי?"},{"id":42,"seg":22,"role":"respond.answer","conf":"high","src":"english","speaker":null,"head":"כְּשֶׁרַבּוֹ מְסַרְהֵב","text":"כְּשֶׁרַבּוֹ מְסַרְהֵב בּוֹ לָצֵאת, וְאֵינוֹ יוֹצֵא."},{"id":43,"seg":23,"role":"probe.question","conf":"high","src":"english","speaker":null,"head":"וּמִשּׁוּם דְּרַבּוֹ","text":"וּמִשּׁוּם דְּרַבּוֹ מְסַרְהֵב בּוֹ לָצֵאת – לְמִיקְטְלֵיהּ קָאֵ