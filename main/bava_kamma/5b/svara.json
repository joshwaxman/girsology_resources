 "sentences": {
  "1": {
   "segId": "Bava_Kamma.5b.2",
   "sugya": "bava_kamma_5b_shadit_bor",
   "marks": [
    {
     "type": "schema",
     "object": "tzad_keren_mikulhu",
     "kind": "tzad_hashaveh",
     "status": "blocked",
     "gloss_en": "Goring should be derivable from the common factor of two other written categories (with Pit among them)"
    },
    {
     "type": "defeater_objection",
     "object": "pircha_muadin_mitechilatan",
     "gloss_en": "what is notable about all the others? they are forewarned from their outset -- whereas Goring begins innocuous",
     "verse": null,
     "blocks": "tzad_keren_mikulhu",
     "withdrawn": false,
     "answered": false
    },
    {
     "type": "proposition",
     "object": "p_kulhu_atyan_mibor",
     "gloss_en": "with Pit cast among them, every category comes from the common factor of two -- except Goring"
    }
   ]
  },
  "2": {
   "segId": "Bava_Kamma.5b.3",
   "sugya": "bava_kamma_5b_shadit_bor",
   "marks": [
    {
     "type": "schema",
     "object": "tzad_keren_leman_damar_adifa",
     "kind": "tzad_hashaveh",
     "status": "stands",
     "gloss_en": "per the view that Goring is superior (its object is to damage), even Goring is derivable from the common factor of two"
    },
    {
     "type": "proposition",
     "object": "p_keren_adifa",
     "gloss_en": "on the contrary, Goring is superior: its object is to cause damage"
    }
   ]
  },
  "3": {
   "segId": "Bava_Kamma.5b.4",
   "sugya": "bava_kamma_5b_shadit_bor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_kativnehu_lehilkhoteihen",
     "gloss_en": "Scripture wrote all the categories for their distinctive halakhot"
    }
   ]
  },
  "4": {
   "segId": "Bava_Kamma.5b.5",
   "sugya": "bava_kamma_5b_shadit_bor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_keren_lechalek",
     "gloss_en": "Goring was written to distinguish the innocuous (half damages) from the forewarned (full damages)"
    }
   ]
  },
  "5": {
   "segId": "Bava_Kamma.5b.6",
   "sugya": "bava_kamma_5b_shadit_bor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_shen_regel_reshut_harabim",
     "gloss_en": "Eating and Trampling were written to exempt them in the public domain"
    }
   ]
  },
  "6": {
   "segId": "Bava_Kamma.5b.7",
   "sugya": "bava_kamma_5b_shadit_bor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bor_liftor_kelim",
     "gloss_en": "Pit was written to exempt vessels damaged in it"
    }
   ]
  },
  "7": {
   "segId": "Bava_Kamma.5b.8",
   "sugya": "bava_kamma_5b_shadit_bor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_adam_arbaa_devarim",
     "gloss_en": "Man was written to obligate him in the four additional payments"
    }
   ]
  },
  "8": {
   "segId": "Bava_Kamma.5b.9",
   "sugya": "bava_kamma_5b_shadit_bor",
   "marks": [
    {
