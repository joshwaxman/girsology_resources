    {
     "type": "proposition",
     "object": "p_esh_lichakha_niro",
     "gloss_en": "per R. Yehuda, who holds one liable for concealed items in fire: Fire was written to include scorching his ploughed field and singeing his stones"
    }
   ]
  },
  "7": {
   "segId": "Bava_Kamma.6a.8",
   "sugya": "bava_kamma_6a_hatzad_hashaveh",
   "marks": [
    {
     "type": "schema",
     "object": "binav_avno_mibor",
     "kind": "binyan_av",
     "status": "blocked",
     "gloss_en": "derive the stone/knife/load (at rest, ownerless) from Pit alone"
    },
    {
     "type": "defeater_objection",
     "object": "pircha_bor_ein_koach_acher",
     "gloss_en": "what is notable about Pit? no other force is involved in it -- whereas here another force (the wind) is involved",
     "verse": null,
     "blocks": "binav_avno_mibor",
     "withdrawn": false,
     "answered": false
    }
   ]
  },
  "8": {
   "segId": "Bava_Kamma.6a.9",
   "sugya": "bava_kamma_6a_hatzad_hashaveh",
   "marks": [
    {
     "type": "schema",
     "object": "binav_avno_meesh",
     "kind": "binyan_av",
     "status": "blocked",
     "gloss_en": "then derive it from Fire alone ('אש תוכיח')"
    }
   ]
  },
  "9": {
   "segId": "Bava_Kamma.6a.10",
   "sugya": "bava_kamma_6a_hatzad_hashaveh",
   "marks": [
    {
     "type": "defeater_objection",
     "object": "pircha_esh_darko_leilech",
     "gloss_en": "what is notable about Fire? its manner is to travel and damage -- whereas these damage at rest",
     "verse": null,
     "blocks": "binav_avno_meesh",
     "withdrawn": false,
     "answered": false
    }
   ]
  },
  "10": {
   "segId": "Bava_Kamma.6a.11",
   "sugya": "bava_kamma_6a_hatzad_hashaveh",
   "marks": [
    {
     "type": "schema",
     "object": "tzad_avno_mibor_veesh",
     "kind": "tzad_hashaveh",
     "status": "stands",
     "gloss_en": "וחזר הדין -- neither Pit nor Fire alone suffices; the common factor of the two (your property, your duty to guard, their manner to damage) obligates for the stone, knife and load"
    }
   ]
  },
