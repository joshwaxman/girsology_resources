  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כ' שגם לאחוריו לא יצאו הרמב\"ן כתב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ג\"כ שאין מקום קריעה אלא לפני בית הצואר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל לא מן הצדדין של בית הצואר מכאן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומכאן ואם קרע שם לא יצא: <b>ב</b> וכתב הר\"ם",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מרוטנבורק דוקא בעודו לפנינו חשוב כחי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל מי שאמרו לו ראינו בנך או אחיך גוסס",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היום ג' ימים הוא בחזקת שמת וצריך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להתאבל עליו: <b>ג</b> מנהג ישראל במתים",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובקבורתם מעמצים עיניו של מת ואם נפתח",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פיו קושרין לחייו ופוקקין נקביו אחר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמדיחין אותו וסכין אותו במיני בשמים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וגוזזין שערו ומלבישין אותו תכריכין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תפורים של פשתן לבנים ולא יהו דמיהם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יקרים ואסור לקבור בתכריכין של משי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובגדים מרוקמין אפי' לנשיא שבישראל שזו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גסות הרוח והשחתה ומעשה עובדי כוכבים: <b>ד</b>",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומכאן היה נראה לאסור מה שנוהגין קצת",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אנשים כשהמת גוסס ואין הנשמה יכולה לצאת",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ששומטין הכר מתחתיו כדי שימות מהרה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאומרים כי יש במטה נוצות של עופות",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שגורמין לנפש שלא תצא וכמה פעמים צעקתי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ככרוכיא להסיר המנהג הרע ולא עלה בידי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ורבותי חלקו עלי והר\"ר נתן איש איגרא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל כתב על זה להתיר. אחר כמה שנים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מצאתי בספר החסידים סי' תשכ\"ג סיוע",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לדברי שכתוב שם ז\"ל ואם הוא גוסס ואינו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יכול למות עד שישימוהו במקום אחר אל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יזיזוהו משם ע\"כ. אמת כי דברי ספר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החסידים צ\"ע כי בתחלה כתב שאם היה איש",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
