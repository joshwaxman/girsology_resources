        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסדא ל\"ש אלא כותל גנה אבל כותל חצר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בונה כדרכו ודוקא בונה אבל סותר לא",
