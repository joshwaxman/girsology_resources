  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>כרבי אליעזר בן יעקב ואע\"ג דהוא יחיד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במקום רבים דהא שמעתא דרב יהודה כוותיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אזלא דקאמר ואם היתה שדה מטוננת מותר",
