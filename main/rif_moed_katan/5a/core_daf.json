  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> ופרקמטיא שלו בדבר האבד שאם לא ימכור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יפסיד מהקרן נמכרת לו ע\"י אחרים אבל אם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינו מפסיד מהקרן אלא שאם ימכרנה עתה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ירויח בם יותר משאם ימכרנה אח\"כ אסור",
      "segment_ids": [
