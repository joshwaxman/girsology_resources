  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> וי\"א שהיא גי' כאינה מתאבלת אלא כשמה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תמיה או חמותם אבל שאר קרוביו שמתו אינה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתאבלת עמו וכן כתב הרמב\"ה אבל הרמב\"ן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב שהיא מתאבלת על כל הקרובים שמתאבל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עליהן וכן יראה דעת הרא\"ש. כתב הרמב\"ם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין מתאבלים עם הקרובים שמתאבלים עליהן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא כשמתאבלים על קורבה דשאר כגון בנו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואחיו שמתאבל על בן או בת שלהם והאידנא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נהגו להקל באבילות של המתאבלים וסומכים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על זה שאינו אלא בשביל כבוד האבל ואם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רצה האבל למחול על כבודו א\"צ להתאבל עמו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והאידנא כל האבלים נוהגים למחול על",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כבודם לכן נהגו להקל וכן כתב הרמב\"ן: <b>ב</b>",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכתב הרמב\"ן מנין ל' אינו מונה אלא מז'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ימי אבילות ואילך ואינו דומה לקובר מתו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ברגל שהרגל עולה לו למנין ל' אע\"פ שאינו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מונה ז' אלא לאחר הרגל דהתם נוהג * צ\"ל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דין ל' שהוא גיהוץ ותספורת תוך הרגל אבל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כו' מצות הרגל אבל הכא כל ז' ימי החופה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותרים בגיהוץ ותספורת הלכך לא סלקו כלל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכ\"כ הרא\"ש: <b>ג</b> וכתב הראב\"ד דתרוייהו",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דוקא שיהו אנשים ישנים עם החתן ונשים עם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכלה ודוקא בלילה אבל ביום מותר להתייחד",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עמה כמו עם שאר נשים ואינו אסור אלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בתשמיש המטה אבל במיני פרישות כמזיגת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכוס והצעת המטה והרחצת פניו ידיו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ורגליו מותר ולא עוד אלא אפי' בחבוק",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונשוק וכיוצא בו מותר והרא\"ש כתב הרבה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הפליג החכם להחמיר בלילה להצריך שתי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משמרות והפליג להקל ביום להתיר יחוד",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חבוק ונשוק ואיפכא מסתברא כי למראית",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העין היצר מתגבר הלכך יחוד אסור ביום",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמו בלילה אבל במיני פרישות א\"צ להרחיק",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וא\"צ שתי משמרות אלא או הוא בין אנשים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "או היא בין נשים: <b>ד</b> והיכא שאין לו פסידא",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
