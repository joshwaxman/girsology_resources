    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהיה אמר רשב\"ל כשם שנכנסת ברמ\"ח איברים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כך כשיוצאת יוצאת מרמ\"ח איברים כשהיא",
