        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמתא היכי עביד כי הא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>דבמערבא ממנו",
