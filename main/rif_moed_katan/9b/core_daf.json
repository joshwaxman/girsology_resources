    {
      "width": "380px",
      "right": "275px",
      "text": "מאי אמר ליה <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">וברא\"ש</i> <i class=\"footnote\">ליתא</i>(רב אחא",
