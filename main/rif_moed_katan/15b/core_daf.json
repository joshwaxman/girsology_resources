  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אין עומדין עליו בשורה.</b> פי' שהיו שם האבלים ואומר עליו עמדו יקרים עמודו שבו יקרים שבו וזהו לשון אין עומדין או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עומדים ונקראים בגמ' מעמדות ומושבות: <b>ברכת אבלים.</b> עשרה כוסות שתקנו בבית האבל לתנחומי אבלים: <b>כשעומדים בשורה.</b> היו",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מקלסין אותו בדברי שבח אומרים עליו כמה היה גדול אדם זה: <b>שלדו.</b> שדרתו כששדרתו קיימת עומדין עליו בשורה כשיש שם אבל:",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אין שלדו קיימת.</b> אין עומדין עליו בשורה ואין אומר עליו ברכת אבלים ותנחומי אבלים: <b>וכתב</b> הריא\"ף ז\"ל גרסי' בהאי מסכת",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פ\"ק (דף ח.) תניא המלקט עצמות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אביו ואמו ה\"ז מתאבל עליהם כל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היום כולו ולערב אין מתאבל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליהם אמר רב חסדא ואפי'",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צרורין לו בסדינו ופירושו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המלקט שמת אביו רחוק מקרוביו",
      "segment_ids": [
