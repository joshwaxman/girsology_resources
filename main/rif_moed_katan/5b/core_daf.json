      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ביתו רבינו השמיט הא דא\"ר יהודה אף",
      "segment_ids": [
