  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> עי' פ' מקום שנהגו: <b>ב לשון ריא\"ז</b>",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האומנין שעושין שולחנו' בביתו של ראש",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גלות ואוכלין על שולחנו מותרים לעשותן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במועד ואע\"פ שאינן צריכין לו במועד כל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כך שיש לו שולחנות אחרים הואיל ואין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נוטלין מהם שכר אלא שאוכלין על שולחנו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרי הן כעושין לצורך עצמן להשתמש בהן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במועד כמבואר בקונט' הראיות: <b>ג</b> י\"א",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שצריך ליזהר ביו\"ט שלא להכין ליום שני",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "של יו\"ט אלא ע\"י הערמה שיאכל ממנו מעט",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בו ביום דכיון דבקיאין בקביעא דירחא ה\"ל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חול וא\"כ מכין מיו\"ט לחול ונראה לטור",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאדרבא שאין ליזהר בכך כי היכי דלא אתי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לזלזולי ביו\"ט שני דמהאי טעמא נמי לא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מבדלינן בליליא כי היכי דלא לזלזולי ביה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא ראה לרא\"ש נזהר בזה: <b>ד</b> ור\"ת פסק",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        3,
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כיון שזהו הטעם א\"כ גלח קודם המועד מותר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לגלח במועד וקשה מאד להתיר וגם אינו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נראה כן מתוך הגמ' דאם איתא הו\"ל לפורטה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בהדי הנך דתנן ואלו מגלחין כי היכי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דקאמר גבי כבוס כל מי שאין לו אלא חלוק",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "א' מותר לכבסו משום דאפי' אם כבסו קודם",
      "segment_ids": [
