  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> וי\"א שהקובר מתו קודם ר\"ה אין יוה\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מבטל ממנו גזירת ל' וכן אם קברו קודם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יוה\"כ אין החג מבטל ממנו גזירת ל' דתרי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קולי בחדא אבילות לא עבדינן שיבא רגל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחד ויבטל ממנו גזירת ל' וכן דעת בעל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הלכות שכתב היכא שמת לו מת שעה אחת קודם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"ה עולה לו למנין ז' ור\"ה ז' הרי י\"ד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וז' שבין ר\"ה ליוה\"כ הרי כ\"א ויוה\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא כרגל וחשוב כז' הרי כ\"ח יום ונקט",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בתר יוה\"כ שני ימים וסברא ראשונה היא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סברת הרמב\"ן ולזה הסכים הרא\"ש כתב ה\"ר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמעון הקובר מתו שעה אחת לפני הרגל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאותה שעה והרגל חשובים כי\"ד ומיד אחר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרגל יש לו דין שבוע שלישי לענין שיושב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במקומו ואינו מדבר אפי' בר\"ה ועצרת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו אלא יום אחד: <b>ב</b> כתב הרמב\"ן וה\"מ",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לענין גזרת ז' אבל לענין גזרת ל' נוהג",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על אביו ועל אמו בתספורת עד שיגערו בו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
