","n":23,"p":[[0,2,"Rava said"],[2,3,"This"],[3,4,"is saying:"],[4,5,"leaven:"],[5,8,"Do not burn"],[8,9,"I have"],[9,10,"only"],[10,11,"handful … From where","<b>handful</b> that is removed from the meal offering. <b>From where</b>"],[11,12,"half"],[12,13,"handful?"],[13,18,"The verse states: … “Any … from where … its mixed state?","<b> The verse states:</b><b> “Any</b> leaven.” Furthermore, <b>from where</b> is it derived that one is liable not only for leaven by itself, but also for <b>its mixed state?</b>"],[18,21,"The verse states:"],[21,23,"“As any"]],"w":{"0":"Rava","1":"said","2":"This","3":"is saying","4":"leaven","5":"Do not","6":"burn","8":"I have","9":"only","10":"handful … From where","11":"half","12":"handful","13":"The … from where","14":"verse","15":"states … state","16":"Any","17":"its mixed","18":"The","19":"verse","20":"states","21":"As","22":"any"},"g":[[2,4,"כך הוא, החכם שבברייתא, אמר","a"]]},{"k":"7ae56e76cffe","n":10,"p":[[0,1,"what"],[1,2,"do"],[2,3,"disagree?"],[3,5,"Abaye holds:"],[5,6,"There is"],[6,7,"a handful"],[7,8,"less than"],[8,10,"two olives."]],"w":{"0":"what","1":"do","2":"disagree","3":"Abaye","4":"holds","5":"There is","6":"a handful","7":"less than","8":"two","9":"olives"},"g":[[0,3,"במה, באיזה עיקרון, הם, אביי ורבא חלוקים","a"]]}]}
