 "sentences": {
  "0": {
   "segId": "Berakhot.6b.1",
   "sugya": "berakhot_6a_tefillin_dmarei_alma",
   "marks": [
    {
     "type": "proposition",
     "object": "p_kulhu_beedraeih",
     "gloss_en": "and all of them are written [together] in the arm-tefillin"
    }
   ]
  },
  "17": {
   "segId": "Berakhot.6b.18",
   "sugya": "berakhot_6b_achorei_beit_hakneset",
   "marks": [
    {
     "type": "proposition",
     "object": "p_nikra_rasha",
     "gloss_en": "whoever prays behind the synagogue is called wicked"
    }
   ]
  },
  "18": {
   "segId": "Berakhot.6b.19",
   "sugya": "berakhot_6b_achorei_beit_hakneset",
   "marks": [
    {
     "type": "proposition",
     "object": "p_lo_amaran_ela_lo_mahdar",
     "gloss_en": "Abaye: this was said only where he does not turn his face toward the synagogue"
    }
   ]
  },
  "19": {
   "segId": "Berakhot.6b.20",
   "sugya": "berakhot_6b_achorei_beit_hakneset",
   "marks": [
    {
     "type": "proposition",
     "object": "p_maaseh_eliyahu_katleih",
     "gloss_en": "a certain man prayed behind the synagogue without turning his face toward it; Elijah passed by, saw him, appeared to him as an Arab, said 'is this how you stand before your Master?!', drew a sword and killed him"
    }
   ]
  },
  "21": {
   "segId": "Berakhot.6b.22",
   "sugya": "berakhot_6b_achorei_beit_hakneset",
   "marks": [
    {
     "type": "proposition",
     "object": "p_krum_zulut_devarim_shebrumo",
     "gloss_en": "'when vileness is exalted among the sons of men' (Ps 12:9): these are things that stand at the height of the world, and people belittle them"
    }
   ]
  },
  "22": {
   "segId": "Berakhot.6b.23",
   "sugya": "berakhot_6b_achorei_beit_hakneset",
   "marks": [
    {
     "type": "proposition",
     "object": "p_nitztarech_panav_mishtanot",
     "gloss_en": "once a person needs other people, his face changes like a kerum"
    }
   ]
  },
  "23": {
   "segId": "Berakhot.6b.24",
   "sugya": "berakhot_6b_achorei_beit_hakneset",
   "marks": [
    {
     "type": "proposition",
     "object": "p_krum_of",
     "gloss_en": "what is kerum? there is a bird in the cities by the sea named kerum, and when the sun shines it turns several colours"
    }
   ]
  },
  "24": {
   "segId": "Berakhot.6b.25",
   "sugya": "berakhot_6b_achorei_beit_hakneset",
   "marks": [
    {
     "type": "proposition",
     "object": "p_nitztarech_keilu_nidon",
     "gloss_en": "[one who needs other people] is as if judged with two judgments, fire and water"
    }
   ]
  },
  "8": {
   "segId": "Berakhot.6b.9",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_al_yafsia_pesia_gasa",
     "gloss_en": "one leaving the synagogue should not take a large stride"
    }
   ]
  },
  "9": {
   "segId": "Berakhot.6b.10",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rabbanan_mechalyin_shabbata",
     "gloss_en": "R' Zeira at first: the rabbis running to the lecture on Shabbat are desecrating Shabbat"
    }
   ]
  },
  "10": {
   "segId": "Berakhot.6b.11",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_agra_depirka",
     "gloss_en": "R' Zeira: the reward for the lecture is for the running"
    }
   ]
  },
  "11": {
   "segId": "Berakhot.6b.12",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_agra_dekalla",
     "gloss_en": "Abaye: the reward for the kalla is for the crowding"
    }
   ]
  },
  "12": {
   "segId": "Berakhot.6b.13",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_agra_dishmaata",
     "gloss_en": "Rava: the reward for a tradition is for the reasoning"
    }
   ]
  },
  "13": {
   "segId": "Berakhot.6b.14",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_agra_devei_tamya",
     "gloss_en": "Rav Pappa: the reward for a house of mourning is for the silence"
    }
   ]
  },
  "14": {
   "segId": "Berakhot.6b.15",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_agra_detaanita",
     "gloss_en": "Mar Zutra: the reward for a fast is for the charity"
    }
   ]
  },
  "15": {
   "segId": "Berakhot.6b.16",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_agra_dehespeda",
     "gloss_en": "Rav Sheshet: the reward for a eulogy is for raising [the mourners' voices]"
    }
   ]
  },
  "16": {
   "segId": "Berakhot.6b.17",
   "sugya": "berakhot_6b_agra_depirka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_agra_devei_hilulei",
     "gloss_en": "Rav Ashi: the reward for a wedding house is for the words [said to the couple]"
    }
   ]
  },
  "4": {
   "segId": "Berakhot.6b.5",
   "sugya": "berakhot_6b_kovea_makom",
   "marks": [
    {
     "type": "proposition",
     "object": "p_lo_matza_asara_koes",
     "gloss_en": "when the Holy One comes to a synagogue and does not find ten there, He is immediately angry"
    }
   ]
  },
  "5": {
   "segId": "Berakhot.6b.6",
   "sugya": "berakhot_6b_kovea_makom",
   "marks": [
    {
     "type": "proposition",
     "object": "p_kovea_makom_elokei_avraham",
     "gloss_en": "whoever fixes a place for his prayer, the God of Abraham is his help"
    }
   ]
  },
  "6": {
   "segId": "Berakhot.6b.7",
   "sugya": "berakhot_6b_kovea_makom",
   "marks": [
    {
     "type": "proposition",
     "object": "p_omrim_alav_keshemet",
     "gloss_en": "and when he dies they say of him: where is the humble one, where is the pious one, of the disciples of Abraham our father"
    }
   ]
  },
  "7": {
   "segId": "Berakhot.6b.8",
   "sugya": "berakhot_6b_kovea_makom",
   "marks": [
    {
     "type": "proposition",
     "object": "p_avraham_kava_makom",
     "gloss_en": "Abraham our father fixed a place for his prayer"
    }
   ]
  },
  "1": {
   "segId": "Berakhot.6b.2",
   "sugya": "berakhot_6b_ragil_lavo",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ragil_velo_ba",
     "gloss_en": "whoever is accustomed to come to the synagogue and did not come one day, the Holy One inquires after him"
    }
   ]
  },
  "2": {
   "segId": "Berakhot.6b.3",
   "sugya": "berakhot_6b_ragil_lavo",
   "marks": [
    {
     "type": "proposition",
     "object": "p_lidvar_mitzva_nogah",
     "gloss_en": "if he went for a matter of mitzva -- there is light for him"
    }
   ]
  },
  "3": {
   "segId": "Berakhot.6b.4",
   "sugya": "berakhot_6b_ragil_lavo",
   "marks": [
    {
     "type": "proposition",
     "object": "p_taama_lo_batach",
     "gloss_en": "the reason [there is no light for him]: 'let him trust in the name of the Lord' -- he ought to have trusted in the name of the Lord, and did not trust"
    }
   ]
  },
  "30": {
   "segId": "Berakhot.6b.31",
   "sugya": "berakhot_6b_seudat_chatan",
   "marks": [
    {
     "type": "objection",
     "object": "obj_ini_vechol_haam_roim",
     "kind": "svara",
     "gloss_en": "איני? והא כתיב וכל העם רואים את הקולות -- is that so? the verse names further voices at Sinai, so the Torah was given with more than five (kind svara under protest: no ObjectionKind names איני / והא כתיב)",
     "against": "p_torah_nitna_bechamisha_kolot",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_vechol_haam_roim_hakolot",
     "gloss_en": "but it is written: 'and all the people saw the voices' (Ex 20:15) -- further voices at Sinai"
    }
   ]
  },
  "31": {
   "segId": "Berakhot.6b.32",
   "sugya": "berakhot_6b_seudat_chatan",
   "marks": [
    {
     "type": "objection_answer",
     "object": "a_kodem_matan_torah",
     "gloss_en": "אותן קולות דקודם מתן תורה הוו -- those voices were before the giving of the Torah, and do not count",
     "answers": "obj_ini_vechol_haam_roim",
     "restores": "p_torah_nitna_bechamisha_kolot"
    }
   ]
  },
  "28": {
   "segId": "Berakhot.6b.29",
   "sugya": "berakhot_6b_seudat_chatan",
   "marks": [
    {
     "type": "proposition",
     "object": "p_over_bechamisha_kolot",
     "gloss_en": "whoever enjoys a groom's feast and does not gladden him transgresses five voices"
    }
   ]
  },
  "29": {
   "segId": "Berakhot.6b.30",
   "sugya": "berakhot_6b_seudat_chatan",
   "marks": [
    {
     "type": "proposition",
     "object": "p_zocheh_latorah",
     "gloss_en": "if he gladdens him, his reward: he merits the Torah"
    }
   ]
  },
  "32": {
   "segId": "Berakhot.6b.33",
   "sugya": "berakhot_6b_seudat_chatan",
   "marks": [
    {
     "type": "proposition",
     "object": "p_keilu_hikriv_toda",
     "gloss_en": "R' Abbahu: [one who gladdens the groom] is as if he offered a thanks-offering"
    }
   ]
  },
  "36": {
   "segId": "Berakhot.6b.37",
   "sugya": "berakhot_6b_yakdim_shalom",
   "marks": [
    {
     "type": "proposition",
     "object": "p_yakdim_shalom",
     "gloss_en": "whoever knows that his fellow is accustomed to greet him should greet him first"
    }
   ]
  },
  "33": {
   "segId": "Berakhot.6b.34",
   "sugya": "berakhot_6b_yirat_shamayim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_yerei_shamayim_devarav_nishmaim",
     "gloss_en": "any person who has fear of Heaven, his words are heeded"
    }
   ]
  },
  "34": {
   "segId": "Berakhot.6b.35",
   "sugya": "berakhot_6b_yirat_shamayim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_kol_haolam_nivra_bishvil_zeh",
     "gloss_en": "'for this is all of man': R' Elazar -- the Holy One said: the whole world was created only for the sake of this one"
    }
   ]
  },
  "35": {
   "segId": "Berakhot.6b.36",
   "sugya": "berakhot_6b_yirat_shamayim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_shakul_keneged_kol_haolam",
     "gloss_en": "R' Abba bar Kahana: this one is weighed against the whole world"
    }
   ]
  },
  "25": {
   "segId": "Berakhot.6b.26",
   "sugya": "berakhot_6b_zahir_bemincha",
   "marks": [
    {
     "type": "proposition",
     "object": "p_zahir_bemincha",
     "gloss_en": "a person should always be vigilant about the afternoon prayer"
    }
   ]
  },
  "26": {
   "segId": "Berakhot.6b.27",
   "sugya": "berakhot_6b_zahir_bemincha",
   "marks": [
    {
     "type": "proposition",
     "object": "p_aneni_tered_esh",
     "gloss_en": "the first 'answer me': that fire descend from heaven"
    }
   ]
  },
  "27": {
   "segId": "Berakhot.6b.28",
   "sugya": "berakhot_6b_zahir_bemincha",
   "marks": [
    {
     "type": "proposition",
     "object": "p_zahir_bearvit",
     "gloss_en": "R' Yochanan: [one must be vigilant] about the evening prayer as well"
    }
   ]
  }
 }
}