   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "support",
     "object": "s_mai_kraa_kos_yeshuot",
     "kind": "svara",
     "gloss_en": "מאי קראה -- כוס ישועות אשא ובשם ה׳ אקרא",
     "supports": "p_magbihu_tefach",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_kos_yeshuot_esa",
     "gloss_en": "Rav Acha b'R' Chanina: what is the verse? -- 'I will lift up the cup of salvation and call upon the name of the Lord' (Ps 116:13)"
    }
   ]
  },
  "4": {
   "segId": "Berakhot.51b.5",
   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "support",
     "object": "s_shenemar_uverach_ry",
     "kind": "svara",
     "gloss_en": "שנאמר וברך פרי בטנך -- פרי בטנה לא נאמר אלא פרי בטנך",
     "supports": "p_pri_bitna_mipri_bitno_ry",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_ulla_pri_bitnecha",
     "kind": "svara",
     "gloss_en": "אמר ליה: הכי אמר רבי יוחנן, אין פרי בטנה של אשה מתברך אלא מפרי בטנו של איש -- Ulla answers the request to send the cup to Yalta with R' Yochanan's dictum; the text records no reply",
     "against": "p_lishadar_kasa_leyalta",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_ulla_yahav_kasa_lerav_nachman",
     "gloss_en": "Ulla came to Rav Nachman's house; he ate bread, said Grace after Meals, and gave the cup of blessing to Rav Nachman"
    }
   ]
  },
  "5": {
   "segId": "Berakhot.51b.6",
   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "support",
     "object": "s_tanya_rn_pri_bitna",
     "kind": "tanya_nami_hachi",
     "gloss_en": "תניא נמי הכי: רבי נתן אומר, מנין שאין פרי בטנה של אשה מתברך אלא מפרי בטנו של איש",
     "supports": "p_pri_bitna_mipri_bitno_ry",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_shenemar_uverach_rn",
     "kind": "svara",
     "gloss_en": "שנאמר וברך פרי בטנך -- פרי בטנה לא נאמר אלא פרי בטנך",
     "supports": "p_pri_bitna_mipri_bitno_rn",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_pri_bitna_mipri_bitno_rn",
     "gloss_en": "R' Natan: whence that the fruit of a woman's womb is blessed only from the fruit of a man's womb?"
    }
   ]
  },
  "7": {
   "segId": "Berakhot.51b.8",
   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "support",
     "object": "s_tanya_hashoteh_kfalayim",
     "kind": "tanya_nami_hachi",
     "gloss_en": "תניא נמי הכי: השותה כפלים לא יברך",
     "supports": "p_kos_puranut_kos_sheni",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_mishum_shenemar_hikon",
     "kind": "svara",
     "gloss_en": "משום שנאמר הכון לקראת אלהיך ישראל, והאי לא מתקן",
     "supports": "p_hashoteh_kfalayim_lo_yevarech",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_ein_mesichin_al_kos",
     "gloss_en": "Rav Asi: one does not converse over the cup of blessing"
    }
   ]
  },
  "8": {
   "segId": "Berakhot.51b.9",
   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "ruling",
     "object": "hil_bechulhu_yoshev_umevarech",
     "gloss_en": "והלכתא: בכולהו יושב ומברך",
     "prop": "p_hilchata_bechulhu_yoshev",
     "tension": false
    },
    {
     "type": "proposition",
     "object": "p_ochel_umehalech_meumad",
     "gloss_en": "one who eats while walking blesses standing"
    }
   ]
  },
  "0": {
   "segId": "Berakhot.51b.1",
   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "proposition",
     "object": "p_naaved_lechumra",
     "gloss_en": "Rav Ashi: since the early ones raised it and it was not resolved for them, we act stringently [the left does not assist the right]"
    }
   ]
  },
  "2": {
   "segId": "Berakhot.51b.3",
   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "proposition",
     "object": "p_taam_noten_einav",
     "gloss_en": "he sets his eyes on it -- so that his mind not be diverted from it"
    }
   ]
  },
  "3": {
   "segId": "Berakhot.51b.4",
   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "proposition",
     "object": "p_taam_meshagro",
     "gloss_en": "he sends it as a gift to his household -- so that his wife be blessed"
    }
   ]
  },
  "6": {
   "segId": "Berakhot.51b.7",
   "sugya": "berakhot_51a_kos_shel_beracha",
   "marks": [
    {
     "type": "proposition",
     "object": "p_yalta_tavra_danei",
     "gloss_en": "Yalta heard, rose in anger, went into the wine-store and broke four hundred jars of wine"
    }
   ]
  },
  "10": {
   "segId": "Berakhot.51b.11",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_yom_kodem",
     "gloss_en": "Beit Shammai: one blesses over the day, and afterwards blesses over the wine"
    }
   ]
  },
  "11": {
   "segId": "Berakhot.51b.12",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_netila_kodemet",
     "gloss_en": "Beit Shammai: one washes the hands and afterwards mixes the cup"
    }
   ]
  },
  "12": {
   "segId": "Berakhot.51b.13",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_mapa_shulchan",
     "gloss_en": "Beit Shammai: he wipes his hands with the cloth and places it on the table"
    }
   ]
  },
  "13": {
   "segId": "Berakhot.51b.14",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_kibud_kodem",
     "gloss_en": "Beit Shammai: one sweeps the house, and afterwards washes the hands"
    }
   ]
  },
  "14": {
   "segId": "Berakhot.51b.15",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_seder_havdala",
     "gloss_en": "Beit Shammai: candle and food, spices and havdala [in that order]"
    }
   ]
  },
  "15": {
   "segId": "Berakhot.51b.16",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_nusach_ner",
     "gloss_en": "Beit Shammai: [the candle blessing is] 'Who created the light of fire'"
    }
   ]
  },
  "16": {
   "segId": "Berakhot.51b.17",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ner_besamim_goyim",
     "gloss_en": "one does not bless over the candle or over the spices of gentiles"
    }
   ]
  },
  "17": {
   "segId": "Berakhot.51b.18",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_yachzor_limkomo",
     "gloss_en": "one who ate and forgot and did not bless -- Beit Shammai: he returns to his place and blesses"
    }
   ]
  },
  "18": {
   "segId": "Berakhot.51b.19",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_yayin_kodem_mazon",
     "gloss_en": "wine came to them after the food and there is only that cup -- Beit Shammai: one blesses over the wine and afterwards over the food"
    }
   ]
  },
  "19": {
   "segId": "Berakhot.51b.20",
   "sugya": "berakhot_51b_eilu_devarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_amen_yisrael",
     "gloss_en": "and one answers amen after an Israelite who blesses"
    }
   ]
  },
  "20": {
   "segId": "Berakhot.51b.21",
   "sugya": "berakhot_51b_kiddush_yom_veyayin",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bs_kiddush",
     "gloss_en": "Beit Shammai: [at kiddush] one blesses over the day and afterwards blesses over the wine"
    }
   ]
  },
  "21": {
   "segId": "Berakhot.51b.22",
   "sugya": "berakhot_51b_kiddush_yom_veyayin",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bh_kiddush",
     "gloss_en": "Beit Hillel: one blesses over the wine and afterwards blesses over the day"
    }
   ]
  }
 }
}