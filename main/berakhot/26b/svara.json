  "13": {
   "segId": "Berakhot.26b.14",
   "sugya": "berakhot_26b_tefillot_avot_tiknum",
   "marks": [
    {
     "type": "support",
     "object": "s_musaf_man_tiknah",
     "kind": "svara",
     "gloss_en": "דאי לא תימא הכי, תפלת מוסף לרבי יוסי ברבי חנינא מאן תקנה? -- אלא תפלות אבות תקנום, ואסמכינהו רבנן אקרבנות",
     "supports": "p_asmechinhu_akorbanot",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_neima_teyuvta_rybc",
     "kind": "tanya",
     "gloss_en": "נימא תיהוי תיובתיה דרבי יוסי ברבי חנינא? -- the baraita explains each prayer time by an offering, so shall we say the prayers were instituted after the offerings, against him?",
     "against": "p_avot_tiknum",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_asmechinhu_akorbanot",
     "gloss_en": "אמר לך רבי יוסי ברבי חנינא: לעולם תפלות אבות תקנום, ואסמכינהו רבנן אקרבנות (= p_asmechinhu_akorbanot)",
     "answers": "obj_neima_teyuvta_rybc",
     "restores": "p_avot_tiknum"
    },
    {
     "type": "proposition",
     "object": "p_asmechinhu_akorbanot",
     "gloss_en": "the Patriarchs instituted the prayers, and the Rabbis attached them to the offerings"
    }
   ]
  },
