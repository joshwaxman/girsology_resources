     "status": "live"
    },
    {
     "type": "support",
     "object": "s_ry_shehare_shacharit",
     "kind": "svara",
     "gloss_en": "עד ארבע שעות, שהרי תמיד של שחר קרב והולך עד ארבע שעות",
