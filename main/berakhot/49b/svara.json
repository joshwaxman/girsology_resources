     "status": "live"
    },
    {
     "type": "objection_answer",
     "object": "ans_muchlefet_rm",
     "gloss_en": "מוחלפת השיטה -- the attributions are reversed (= p_muchlefet_hashita)",
     "answers": "obj_ifcha_r_meir",
     "restores": "p_shiur_zimmun_kezayit"
    },
    {
     "type": "objection_answer",
     "object": "ans_lo_tipuch_rm",
     "gloss_en": "לעולם לא תיפוך: הכא בקראי פליגי, התם בסברא פליגי -- in zimmun R' Meir reads ושבעת as drinking so the eating is an olive-bulk; in returning he likens return to impurity, an egg-bulk",
     "answers": "obj_ifcha_r_meir",
     "restores": "p_shiur_zimmun_kezayit"
    },
    {
     "type": "objection_answer",
     "object": "ans_muchlefet_ry",
     "gloss_en": "מוחלפת השיטה (= p_muchlefet_hashita)",
     "answers": "obj_ifcha_r_yehuda",
     "restores": "p_ry_shiur_zimmun_kebeitza"
    },
    {
     "type": "objection_answer",
     "object": "ans_lo_tipuch_ry",
     "gloss_en": "לעולם לא תיפוך: in zimmun R' Yehuda requires eating that satisfies, an egg-bulk; in returning he likens return to the prohibition, an olive-bulk",
     "answers": "obj_ifcha_r_yehuda",
     "restores": "p_ry_shiur_zimmun_kebeitza"
    },
    {
     "type": "proposition",
     "object": "p_muchlefet_hashita",
     "gloss_en": "R' Yochanan: the attributions [in one of the two mishnayot] are reversed"
    }
