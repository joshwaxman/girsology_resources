     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_rbs_achar_achilatcha_melach",
     "gloss_en": "Rava bar Shmuel (in R' Chiyya's name): after all your eating eat salt, and after all your drinking drink water, and you will not be harmed"
    }
   ]
  },
