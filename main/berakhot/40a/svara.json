     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_rav_tol_baruch",
     "gloss_en": "Rav: [if after blessing he said] 'take, bless; take, bless' -- he need not bless [again]"
    }
   ]
  },
  "3": {
