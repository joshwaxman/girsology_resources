     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_lo_mesalki_taka",
     "gloss_en": "לא מסלקי תכא מקמיה עד דנימטי מיא לגביה -- they do not remove the table from before him until the water reaches him (= p_lo_mesalki_taka)",
     "answers": "obj_yadav_mezuhamot",
     "restores": "p_parsaei_acharonim"
    },
    {
     "type": "proposition",
     "object": "p_lo_mesalki_taka",
     "gloss_en": "they do not remove the table from before him until the water reaches him"
    }
