  "6": {
   "segId": "Berakhot.46b.7",
   "sugya": "berakhot_46b_reish_galuta_seder_seuda",
   "marks": [
    {
     "type": "objection",
     "object": "obj_mitrtatz_veyativ",
     "kind": "svara",
     "gloss_en": "וכי בעי אשתעויי בהדיה, מתריץ תרוצי ויתיב ומשתעי בהדיה?! -- if [the greatest] wants to talk with [the one above him], must he straighten up and sit to talk with him?",
     "against": "p_parsaei_shtei_mitot",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_machvei_bemachog",
     "gloss_en": "שאני פרסאי, דמחוי ליה במחוג -- the Persians are different, they signal with gestures (= p_machvei_bemachog)",
     "answers": "obj_mitrtatz_veyativ",
     "restores": "p_parsaei_shtei_mitot"
    },
    {
     "type": "proposition",
     "object": "p_machvei_bemachog",
     "gloss_en": "the Persians are different, for they signal to him with gestures"
    }
   ]
  },
  "8": {
   "segId": "Berakhot.46b.9",
   "sugya": "berakhot_46b_reish_galuta_seder_seuda",
   "marks": [
    {
     "type": "objection",
     "object": "obj_yeshev_veyishmor",
     "kind": "svara",
     "gloss_en": "ישב גדול וישמור ידיו עד שנוטלין כולן? -- shall the greatest sit and guard his hands until all have washed?",
     "against": "p_parsaei_rishonim",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_maytu_taka",
     "gloss_en": "לאלתר מייתו תכא קמיה -- they bring the table before him at once (= p_maytu_taka)",
     "answers": "obj_yeshev_veyishmor",
     "restores": "p_parsaei_rishonim"
    },
    {
     "type": "proposition",
     "object": "p_maytu_taka",
     "gloss_en": "they bring the table before him at once"
    }
   ]
  },
  "10": {
