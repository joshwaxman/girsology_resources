     "restores": "p_shema_shema_kemodim"
    },
    {
     "type": "proposition",
     "object": "p_machinan_bemarzafta",
     "gloss_en": "Abaye: is there familiarity toward Heaven? if he did not direct his mind at first, we strike him with a smith's hammer until he directs his mind"
    }
   ]
  },
