        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעריבן אי איכא פס ד' ומשהו אין ואי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא אמר רבא ואינה ניתרת אלא בצורת פתח",
