    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומשהו התם דאיכא שתי דפנות דעריבן סגי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה בטפח שוחק הכא דליכא שתי דפנות",
