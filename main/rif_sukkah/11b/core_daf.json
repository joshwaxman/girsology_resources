  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> וכתב ה\"ר פרץ ע\"כ אין נכון לעשות כל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המחיצות מיריעות של פשתן בלא קנים אע\"פ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שקושרין בטוב זמנין דמנתקי ולאו אדעתיה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והוה ליה מחיצה שאינה יכולה לעמוד בפני",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רוח מצויה והרוצה לעשות בסדינין טוב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיארוג במחיצות קנים בפחו' מג': <b>ב</b> כתב",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הטור ודוקא שבא לו הצער במקרה אחר שעשה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שם סוכה אבל אין לו לעשות סוכתו לכתחלה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במקום הריח או הרוח ולומר מצטער אני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונראה שאין כל אדם יכול לומר מצטער אני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ליפטר אלא בדבר שדרך בני אדם להצטער בו:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לשון ריא\"ז</b> מצטער פטור מן הסוכה הוא ולא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משמשיו. ומז\"ה מפרש מצטער שתפשתו חלישות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמעט ואינו בריא כבתחלה אלא שאינו דומה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחולה הצריך רפואה ול\"נ שאפי' היה בריא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כבתחלה ומצטער בריח העשבים או מפני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היתושים או מפני השרב או מפני הגשמים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והרוח וכיוצא בהן הרי זה מותר לו לישן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חוץ לסוכה כמבואר בקונט' הראיות וכך היא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיטת המורה שלא אמרה תורה לישב אלא כעין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דירתו שאם היה מצטער בדירתו יוצא באויר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא נוח לו אף בסוכה כמו כן: <b>ג</b> וכן כתב",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיי' כרבינו והרא\"ש ז\"ל כתב דשושבינין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לא מיקרו עוסקין במצוה וחייבין בכל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המצות חוץ מן התפלה ותפילין וחתן אף ע\"פ",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שפטור מכל המצות חייב בסוכה שאפשר לו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לשמוח בסוכה: <b>לשון ריא\"ז</b> החתן ושושבינין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכל בני החופה פטורין מן הסוכה כל ז'",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ימי המשתה לפי שאוכלים ושמחים עם החתן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחדר חופתו וצער הוא לחתן לעשות חופתו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
