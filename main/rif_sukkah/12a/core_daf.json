        2
      ],
      "gemara_segment_ids": [
        2,
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אפי' בפירות שלא לאוכלן חוץ לסוכה וה\"ר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פרץ היה אומר דפירי לא צריכי סוכה אבל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאר דברים כגון בשר וגבינה וכיוצא בהן",
