      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחריה: <b>ג</b> והר\"ם מרוטנבור\"ק היה מחמיר",
      "segment_ids": [
