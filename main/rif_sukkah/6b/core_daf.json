      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פסולין לסכוך כמו שמבואר בתלמוד ארץ",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
