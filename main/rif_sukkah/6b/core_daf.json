  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א לשון ריא\"ז</b> השבת והפיגם והמצפו' זרע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החלתית שלו סתמן לאכילה או לעשות מהן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיני טבולין שנאכלין בעין ומטמאין טומאת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אוכלין ואין מסככין בהן וכל זה מבואר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות: <b>ב</b> אבל חבילה שהעלה ליבש",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונמלך עליה לסיכוך שפסול מן התורה כתב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הר\"י מקרקשונא שאינה ניתרת בהתרה אלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריכה נענוע ויש אומרים שאף זאת ניתרת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בהתרה ומסתברא שצריכה נענוע: <b>לשון ריא\"ז</b>",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ג</b> חצים נקבות שראשיהן נקובין ליכנס בהן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זכרות הברזל פסולין לסיכוך שכל כלי עץ",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיש לו בית קבול ראוי לקבל טומאה ואע\"פ",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאותו קבול עתיד להתמלאות בזכרות הברזל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עד שלא מלאוהו הרי הוא ככל כלי קבול ואם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יש בהן ברזל נראה בעיני שאף הזכרים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פסולים מפני שהם מקבלי' טומאה ע\"י הברזל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בקונט' הראיות: <b>לשון ריא\"ז ד</b>",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קלחים של פשתן כשרים לסיכוך כשאר עשבים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואם דק אותן ולא נפצן או ששרה אותן במים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדרך ששורין הפשתן אע\"פ שלא דק אותן הרי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלו ספק בתלמוד וספיקו להחמיר לפי שספק",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תורה הוא כדאמרי' בפשתן הראוי לטמא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנגעים אבל שאר היוצא מן העץ כגון צמר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גפן וקנבוס אע\"פ שדק אותן ונפצן אין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עליהם תורת טומאה כלל וכשרין לסכוך",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ועז\"ה אינו תולה הטעם משום טומאה ולפי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבריו אין חילוק בין פשתן לקנבוס וצמר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גפן ואין שיטת התלמוד כדבריו וכמבואר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונט' הראיות ושיטת המורה כדברי. חבלים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "של פשתן פסולים לסכוך ושל סיב הדקל",
      "segment_ids": [
