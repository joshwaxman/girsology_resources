      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"14\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Sukkah 27a:8\" data-ror-ocr=\"רצא מ ן הכלל ללמל שאטלת מצות\">תאכל מצות ויצא מן הכלל ללמד שאכילת</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"14\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Sukkah 27a:8\" data-ror-ocr=\"רצא מ ן הכלל ללמל שאטלת מצות\">מצות</i> <i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Sukkah 27a:8\" data-ror-ocr=\"ה א מ ו ר (א) אינה ח ו ב ה אלא א ם באת\">האמור בו אינו חובה אלא אם באת</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"16\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Sukkah 27a:8\" data-ror-ocr=\"לאכול ת ה א א ט ל ת ך מצה ולא חמץ ולא\">לאכול תהא אכילתך מצה ולא חמץ ולא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"17\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Sukkah 27a:8\" data-ror-ocr=\"ללמל ע ל עצמו יצא אלא ללמל ע ל הכלל\">ללמד על עצמו יצא אלא ללמד על הכלל</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"18\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Sukkah 27a:8\" data-ror-ocr=\"כולו יצא ו ה ת ם ג ו פ י ה מנלן ללילה הראשון\">כולו יצא: והתם גופיה מנלן - דלילה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"18\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Sukkah 27a:8\" data-ror-ocr=\"כולו יצא ו ה ת ם ג ו פ י ה מנלן ללילה הראשון\">הראשון מיהא</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"20\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Sukkah 27b:1\" data-ror-ocr=\"לקובעה חובה: אין יוצאין מסוכה לסוכה.\"><i class=\"ror-printed-only\" data-ror-ocr=\"לקובעה חובה:\" data-ror-chars=\"10\">°</i> <i class=\"ror-talmud-only\" data-ror-chars=\"16\" data-ror-talmud=\"שצריך לישב כל ז&#x27; בסוכה אחת:\">°</i> אין יוצאין מסוכה</i>"
      },
