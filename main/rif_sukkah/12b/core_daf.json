    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאי בעי לא אכיל כלל שהרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסור להתענות בהן אלא ודאי אי",
