      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וביו\"ט הראשון של סוכות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמרינן נמי דמיחייב לאכול",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיעור שהוא חייב לאכול בסוכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאילו מדין יו\"ט סגי ליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאכול כביצה עראי חוץ לסוכה",
      "segment_ids": [
