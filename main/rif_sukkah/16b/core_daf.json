  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "כשם שאתרוג אחד ולולב אחד כך הדס אחד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וערבה אחת: <b><big>גמ'</big></b> אמר רב יהודה אמר שמואל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלכה כר' טרפון: <span class=\"bavli-ref\" data-bavli-ref=\"(דף לד:)\" data-bavli-daf=\"34b\" data-bavli-index=\"0\"></span>תניא ר' אליעזר אומר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יכול יאגדם כולם כאחד אמרת וכי נאמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכפות והלא לא נאמר אלא כפות ומנין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>שמעכבין זה את זה תלמוד לומר ולקחתם לכם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתהא לקיחה תמה: <span class=\"bavli-ref\" data-bavli-ref=\"(דף לא.)\" data-bavli-daf=\"31a\" data-bavli-index=\"1\"></span>תניא ארבעה מינין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שבלולב אין פוחתין מהן <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>ואין מוסיפין עליהן",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גמ' אמר רבי יהודה אמר שמואל הלכה כרבי טרפון.</b> וגרסינן עלה בגמרא ואזדא שמואל לטעמיה דאמר להו להנהו דמזבני אסא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אשוו וזבינו ואי לא דרשינא לכו כרבי טרפון כלומר מכרו בשוה ולא תעלו על דמיכם מפני שמבקשין מכם שלשה הדסים ושלמים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואי לא דרשינא לכו כרבי טרפון דמכשר בקטומין ופרכינן עלה ולדרוש להו כרבי עקיבא דמיקל טפי ומשני תלתא וקטומין שכיחי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חד ולא קטים לא שכיח והקשו בתוס' ואי לא ס\"ל כר\"ע אלא כרבי טרפון היכי פרכינן עליה דלדרוש להו כוותיה ותירצו שכל זה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא מן הדיוק שבא להוכיח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשמואל לטעמיה ומוכיח לה הכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודאי כי אמר ואי לא דרשינא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכו כרבי טרפון היינו משום",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאזדא לטעמיה וס\"ל הכי דאי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תימא הכי אלא אף על גב דלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סבירא ליה כוותיה כדי להפחידם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא ימכרו ביוקר היה אומר להם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלדרוש כרבי טרפון אם כן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביותר מזה היה אפשר לו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "להפחידם דלדרוש כר\"ע דמיקל טפי אלא ודאי אזדא לטעמיה וס\"ל כר' טרפון ודחי' תלתא וקטימי שכיחי כלומר לעולם לא תפשוט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאזלא למעמיה דדילמא להפחידם אמר כן וליה לא ס\"ל ודקאמרת א\"כ יפחידם כר\"ע דמיקל טפי ליתא דאדרבה רבי טרפון מיקל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ממנו דתלתא וקטימי שכיחי וחד ולא קטום לא שכיח אבל צריך לדקדק שיש סוגיא כיוצא בזו בפרק כל שעה [דף ל.] ויש בה חלוף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בב' דברים דאמרי' התם דאמר שמואל דקדרות בפסח משהינן להו עד לאחר הפסח ועביד בהו בין במינן בין שלא במינן ואמרינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "התם ואזדא שמואל לטעמיה דאמר ליה שמואל להנהו דמזבני כנדי אשוו וזבינו ואי לא דרשינא לכו כרבי שמעון כלומר דשרי חמץ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחר הפסח כי ליתא בעיניה ופרכינן התם ולדרוש להו כר\"ש ומפרקינן התם אתרי' דרב הוה כלומר דפליג עליה כדאיתא התם והרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סוגיות הללו מתחלפין דהכא מספקינן אי אזדא שמואל לטעמיה במאי דאמר הכי או. לא אלא שמא להפחידם אמר כן וכמו שפירשנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והתם לא מספקינן בהכי כלל אדרבה פרכינן ולדרוש להו כר\"ש ועוד דהכא לא קשיא לן כלל כי סברי' דאזדא לטעמיה אמאי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דריש להו כר\"מ <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>דהתם פרכינן ואמאי ולדרוש להו כר\"ש וטעמו של חלוף זה משום דהתם ליכא לספוקי כלל שמא להפחידם אמר כן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבשלמא הכא איכא לספוקי דאמר הכי כדי שתהא מצוה מצויה אצל הכל ומשום הכי הוה מפחד להו במילי דלא ס\"ל אבל התם גבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קדרות אין מצוה תלויה בכך דלימא להו הכי אי לאו דס\"ל והכא היינו טעמא דלא פרכינן ולדרוש להו כר\"ט כדפרכינן התם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולדרוש להו כר\"ש דמשום דבשאינו קטום איכא הדור מצוה הוה ניחא ליה דליהדרו בתריה כל זמן שהמוכרין לא יעלו בדמים יותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מדאי והתם נמי בריש בבא בתרא [דף ה.] גבי רוניא דאקפיה רבינא מד' רוחותיו ואתא לקמיה דרבא ואמר ליה זיל [פייסיה <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>]",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואי לא דרשינא לך כרב הונא ואליבא דרבי יוסי דאמר הכל לפי מה שגדר היינו טעמא דלא דריש הכי לפי שכבר נתפייס רבינא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בפחות מכן כדאיתא התם ויש לרמב\"ן ז\"ל שטה אחרת שהוא אומר דכי פרכינן ולדרוש להו כר\"ע דדוקא פרכינן הכא הכי דאע\"ג",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאמר שמואל הלכה כרבי טרפון היינו לומר דקטומין כשרין אבל במנינא ודאי קי\"ל כר\"ע דסגי בהדס אחד דהא ר\"ט לא משמע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דפליג במנינא אלא אדרבי ישמעאל סמיך דאמר אפילו שנים קטומים ואחד שאינו קטום כלומר אחד שאינו קטום מעכב ובעינן שנים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קטומין בר מיניה להדור מצוה ורבי טרפון עלה קאי דאמר אפילו שלשתן קמומין סגי ולעיכובא לא משמע דפליג אדרבי ישמעאל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שחזר והודה דבחד סגי ואי נמי פליג עליה כיון דהודה רבי ישמעאל לר\"ע הוה ליה ר\"מ יחידאה ומשום הכי פרכינן דוקא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולדרוש להו כר\"ע משום דקים לן דהלכתא כוותיה דאפילו תימא דלא בעי למדרש בקולי תרוייהו ולאכשורי בחד וקטום מ\"מ לדרוש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כר\"ע לחודיה דמכשר בחד ולא קטום דהא קילא טפי ומהדרינן דחד ולא קטום לא שכיח הלכך אליבא דהלכתא נקטינן כתרוייהו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלמניינא בחד סגי מדרבי עקיבא וקטום נמי שרי מדרבי טרפון אלא דלהדור מצוה בעינן שלשה ואחד מהן שאינו קטום ומיהו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "באתרא דלא שכיח מוקמי' אדינא ומכשרין בחד וקמטום זו היא שטתו ז\"ל ולבי מגמגם בה דאם איתא דרבי טרפון כי אמר שלשתן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קטומין שלשה בעי לעיכובא לית לן למיפרך ולדרוש להו כרבי עקיבא משום דרבי טרפון אע\"ג דהוה ליה יחידאה לגבי רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ישמעאל ורבי עקיבא כיון דחזינן דשמואל פסק בקטום לקולא כרבי טרפון אע\"ג דהוה ליה יחידאה לגבי רבי ישמעאל ורבי עקיבא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כל שכן דמצי למפסק כוותיה לחומרא דבעינן שלשה לעכובא ואי רבי טרפון האי שלשה דקאמר לאו לעכובא בעי להו אלא למצוה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובשעת הדחק בחד וקטום סגי ליה אי הוה דריש הלכה כרבי טרפון הוה מיקל טפי דהוה מכשר אפילו חד וקטום ועוד שבכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הנוסחאות כתוב מאי מטמא אילימא משום דמיקל וזה הלשון מורה הפי' הראשון שכתבתי דלישנא דאילימא משמע דהכי קאמר אילימא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דכי אמר הכי לאו משום דאזיל לטעמיה אלא משום דמיקל אבל לשטת הרמב\"ן ז\"ל דלא מספקינן כלל במאי דאמרינן דאזיל לטעמיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא לפרכינן אדדריש להו כרבי טרפון משום דמיקל לדרוש להו כרבי עקיבא משום דמיקל טפי היכי שייך לישנא דאילימא והרב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל כתב דאיכא מקצת נוסחאות דלא גרסי מאי מעמא אילימא משום דמיקל אלא גרסינן ולדרוש להו כרבי עקיבא וזו הגירסא ודאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אם היתה עקרית מורה כדבריו ז\"ל אבל בכל הנוסחאות הנמצאות אצלנו כתוב בהן מאי טעמא אילימא משום דמיקל וזו הגירסא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "איני יכול לישבה ע\"פ פירושו. תניא ר' אליעזר הגדול אומר יכול יאגדם כולם כאחת. ואף האתרוג עמהם: <b>וכי נאמר וכפות.</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תמרים דניהוי וי\"ו מוסיף על ענין ראשון לצרפו עם פרי עץ הדר והלא לא נאמר אלא כפות דמשמע בפני עצמן הן ולא עם אתרוג",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וענף עץ עבות וערבי נחל מוסיף עליהן שנאמר בהן ווי\"ן לפיכך נאגדים עם הלולב: <b>שמעכבין זה את זה.</b> שאם חסר אחד מארבעה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אין השלשה מצוה: <b>תמה.</b> שלימה: <b>תניא ד' מינים שבלולב אין פוחתין מהן ואין מוסיפין עליהן.</b> יש מפרשין אין מוסיפין עליהן",
      "segment_ids": [
        2,
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אפילו ממינן ומפקפקין לפי זה שלא להוסיף בהדס וליתא דהא אמרינן בגמרא [דף לד.] אמר להו שמואל להנהו דמזבני אסא אשוו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וזבינו ואי לא דרשינא לכו כרבי טרפון כלומר דמכשר אפילו שלשתן קטומין ופרכינן ולדרוש להו כר\"ע כלומר דסבר דלא בעינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא הדס אחד ומדפרכינן הכי אלמא כר\"ע סבירא ליה דבחד סגי ואפ\"ה מהדר שמואל אתלתא ואמר להו אשוו וזבינו אלמא כי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמרינן הכא אין מוסיפין עליהן דוקא ממין אחר אבל ממינן שפיר דמי ולי לא תליא מלתא בין מינן ומין אחר דהא מכשירין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גימוניות של זהב אע\"ג דמין אחר הוא אלא בלנאותו תלי דכיון דלרבנן דאמרי לולב אין צריך אגד ליכא למיחש משום בל תוסיף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא מדרבנן כמו שכתבתי בחדושי כל לנאותו לא גזרו ולפיכך כתב הרמב\"ם ז\"ל בפרק שביעי מהלכות שופר וסוכה ולולב שאם רצה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "להוסיף בהדס או בערבה כדי שיהא אגודה גדולה מוסיף ונויי מצוה הוא אבל שאר המינין אין מוסיפין על מניינן פירוש משום",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבהנהו ליכא נוי:",
      "segment_ids": [
        4
      ]
    }
  ],
