      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האיצטבא באמצע אם יש ממנה לכל צד לכותל",
      "segment_ids": [
