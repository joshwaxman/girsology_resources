      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות: <b>ג</b> כתב הטור ואם בנה",
      "segment_ids": [
        1,
