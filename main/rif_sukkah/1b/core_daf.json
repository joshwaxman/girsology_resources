      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גבוהה יותר מי' דלא כרי\"ץ גיאות שפסל",
      "segment_ids": [
