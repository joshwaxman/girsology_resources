      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פחות מד' אמות כשרה על האיצטבא אפי' אם",
      "segment_ids": [
