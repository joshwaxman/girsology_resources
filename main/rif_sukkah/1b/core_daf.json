      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באיצטבא גבוהה י' אע\"פ שהיא בתוך ד'",
      "segment_ids": [
