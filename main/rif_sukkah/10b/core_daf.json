  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ושצלתה מרובה מחמתה כשרה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>המעובה כמין",
