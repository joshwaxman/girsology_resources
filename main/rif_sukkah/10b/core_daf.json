      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלמטה אם החמה והצל שוין מלמטה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>כשרה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבידוע שהצל מלמעלה הוא מרובה ואם החמה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והצל מלמעלה שוין פסולה שבידוע שהחמה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלמטה מרובה על הצל אמר רב פפא היינו",
