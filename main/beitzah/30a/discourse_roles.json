 לִידֵי סְחִיטָה."}],"speaker":"R. Ashi"},{"id":17,"role":"probe","conf":"high","reviewed":false,"src":"kih","spans":[{"seg":6,"from":0,"to":195,"head":"אֲמַר לֵיהּ","text":"אֲמַר לֵיהּ רָבָא בַּר רַב חָנִין לְאַבָּיֵי, תְּנַן: אֵין מְטַפְּחִין וְאֵין מְסַפְּקִין וְאֵין מְרַקְּדִין, וְהָאִידָּנָא דְּקָא חָזֵינַן דְּעָבְדָן הָכִי, וְלָא אָמְרִינַן לְהוּ וְלָא מִידֵּי?"}],"speaker":"Rava b. R. Chanin"},{"id":18,"role":"respond.answer","conf":"low","reviewed":false,"src":"kih","spans":[{"seg":7,"from":0,"to":309,"head":"אֲמַר לֵיהּ:","text":"אֲמַר לֵיהּ: וּלְטַעְמָךְ הָא דְּאָמַר (רָבָא): לָא לֵיתֵיב אִינִישׁ אַפּוּמָּא דְלִחְיָא, דִּלְמָא מִגַּנְדַּר לֵיהּ חֵפֶץ וְאָתֵי לְאֵתוֹיֵי (אַרְבַּע אַמּוֹת בִּרְשׁוּת הָרַבִּים), וְהָא הָנֵי נְשֵׁי דְּשָׁקְלָן חַצְבַיְיהוּ, וְאָזְלָן וְיָתְבָן אַפּוּמָּא דִמְבוֹאָה, וְלָא אָמְרִינַן לְהוּ וְלָא מִידֵּי!"}],"speaker":"Abaye"},{"id":26,"role":"probe.attack","conf":"high","reviewed":false,"src":"english+kih+biur","spans":[{"seg":11,"from":0,"to":51,"head":"אֵימָא סֵיפָא:","text":"אֵימָא סֵיפָא: אֲבָל לֹא בָּעֵצִים שֶׁבַּמּוּקְצֶה."}],"agree":"refined","alt":"probe"},{"id":28,"role":"respond.answer","conf":"high","reviewed":false,"src":"english+kih+biur","spans":[{"seg":11,"from":101,"to":216,"head":"הָכָא בְּאַרְזֵי","text":"הָכָא בְּאַרְזֵי וְאַשּׁוּחֵי עָסְקִינַן, דְּמוּקְצֶה מֵחֲמַת חֶסְרוֹן כִּיס, וַאֲפִילּוּ רַבִּי שִׁמְעוֹן מוֹדֶה."}],"agree":"confirmed"},{"id":30,"role":"assert.exposition","conf":"high","reviewed":false,"src":"kih","spans":[{"seg":12,"from":71,"to":144,"head":"אָמַר רַב","text":"אָמַר רַב כָּהֲנָא: זֹאת אוֹמֶרֶת, אֵין מַתְחִילִין בָּאוֹצָר תְּחִלָּה."}],"speaker":"Alternate rendering of R. Kehana's teaching"},{"id":32,"role":"probe.attack","conf":"high","reviewed":false,"src":"english+kih+biur","spans":[{"seg":12,"from":199,"to":298,"head":"אֵימָא רֵישָׁא:","text":"אֵימָא רֵישָׁא: מַתְחִילִין בַּעֲרֵמַת הַתֶּבֶן, אֲתָאן לְרַבִּי שִׁמְעוֹן דְּלֵית לֵיהּ מוּקְצֶה!"}],"marks":{"source":[{"kind":"verse","cue":