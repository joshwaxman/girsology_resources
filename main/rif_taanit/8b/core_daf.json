  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "נראתה ביום משולחת בלילה אינה משולחת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראתה שני בני אדם ורצה אחריה משולחת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברחה מפניהם אינה משולחת טרפה שני בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדם ואכלה אחר מהם משולחת שניהם אינה",
