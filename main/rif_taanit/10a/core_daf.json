      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המחמיר דבר שדרכו בכך כל השנה כגון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
