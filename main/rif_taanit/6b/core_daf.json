    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הברייתא השנויה בגמ' בכך שהרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסדר הברכה פירשו סדר ההתרעות",
