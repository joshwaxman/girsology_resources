      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלתנא דמתני' נמי תוקעין היו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגבולין בין ברכה לברכה כמו",
      "segment_ids": [
