      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תענית. אבל מ\"מ על כרחינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תוקעין היו בסוף התפלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשופרות או בחצוצרות שמצות",
      "segment_ids": [
