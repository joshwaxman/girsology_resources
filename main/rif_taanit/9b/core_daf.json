        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היחידים נמנעין מבשר ויין מי\"ז בתמוז",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואילך ומר\"ח ואילך נמנעים כולם מבשר",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ויין זולת השבת שאוכלים ושותים כדרך כל",
