      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלפניו לספר ולכבס וכתב בסמ\"ק פי'",
      "segment_ids": [
