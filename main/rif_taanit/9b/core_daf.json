        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כרשב\"ג דאסר כל השבת והלכה כרשב\"נ דלא",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אסר אלא באותו שבוע ודלא כר\"מ דאסר מר\"ח",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואילך ואם חל תשעה באב יום א' או בשבת",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונדחה עד אתר השבת מותר בב' שבתות בשבוע",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלפניו מותר כיון שנדחה התענית עד יום",
