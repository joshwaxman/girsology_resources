      "left": "",
      "text": "כיון שלא הבדיל כל היום לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתנו לו תשלומין עוד כדאמרי'",
      "segment_ids": [
        1
      ]
    },
    {
