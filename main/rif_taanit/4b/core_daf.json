  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> הטור כ' דאע\"פ שאין העוברות מתענות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דגם לא יאכלו אלא לקיום הולד וכתב נמי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאין מתענות בז' התעניות אלא בג'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האמצעיות. ומיי' כתב דעוברות ומניקות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתענו' גם בז' התעניות ולא בראשונים:",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לשון ריא\"ז</b> עוברות ומניקות אינן מתענות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בג' תעניות הראשונות לפי שאינן חמורות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כ\"כ וכן לא בז' האחרונות אע\"פ שהן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חמורות הן תעניות רבות וקשה להן להתענות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
