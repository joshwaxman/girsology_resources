 "continuesQuestionOf": null,
 "segments": [
  {
   "id": "eruvin.15a.20",
   "daf": "15a",
   "sentenceId": 19,
   "he": "מַתְנִי׳ בַּכֹּל עוֹשִׂין לְחָיַיִן אֲפִילּוּ בְּדָבָר שֶׁיֵּשׁ בּוֹ רוּחַ חַיִּים, וְרַבִּי מֵאִיר אוֹסֵר. וּמְטַמֵּא מִשּׁוּם גּוֹלֵל,",
   "en": "«MISHNA:» «One may construct side posts from anything, even a living creature,» provided that it was properly attached to the entrance of the alleyway, «and Rabbi Meir prohibits» using a living creature as a side post. The mishna continues with a similar dispute: Even a living creature «imparts ritual impurity» if it used as the «covering of a grave.»"
  },
  {
   "id": "eruvin.15b.1",
   "daf": "15b",
   "sentenceId": 0,
   "he": "וְרַבִּי מֵאִיר מְטַהֵר. וְכוֹתְבִין עָלָיו גִּיטֵּי נָשִׁים, וְרַבִּי יוֹסֵי הַגְּלִילִי פּוֹסֵל.",
   "en": "«But Rabbi Meir deems it pure.» Likewise, «one may write women’s bills of divorce on» anything, even a living creature. «But Rabbi Yosei HaGelili invalidates» a bill of divorce written on a living creature."
  }
 ],
