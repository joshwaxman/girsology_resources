      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ידיעתי ושמעון משיב אתה אמרת לפוטרן",
      "segment_ids": [
