        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובכתובתה מדאמרינן אמר רב פפא ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרינן רב פפא אמר גמרינן דעל טעמיה דרב",
