        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Makkot 3a:10\" data-ror-ocr=\"טובת הנאה זו אך המותר ישומו שכל\">דלמא</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Makkot 3a:10\" data-ror-ocr=\"רילמא זכות ספיקו קאמר ממני׳ ללישלמו\">זכות ספיקו קאמר מתני'</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Makkot 3a:10\" data-ror-ocr=\"רילמא זכות ספיקו קאמר ממני׳ ללישלמו\">דלישיימו</i> <i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Makkot 3a:10\" data-ror-ocr=\"ואותן למים ימנו העלים ולא מחייבינן\">ואותן דמים יתנו העדים</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Makkot 3a:10\" data-ror-ocr=\"ואותן למים ימנו העלים ולא מחייבינן\">ולא מחייבינן</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Makkot 3a:10\" data-ror-ocr=\"הנאתה לשמא לא היה נפסל בעלותן\">הנאתה דשמא לא היה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Makkot 3a:10\" data-ror-ocr=\"הנאתה לשמא לא היה נפסל בעלותן\">נפסד בעדותן כל</i> <i class=\"ror-line\" data-ror-i=\"16\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Makkot 3a:10\" data-ror-ocr=\"כ״כ שאף עמה כשהוזמו שמא ימות מחר\">כך שאף עתה כשהן</i>"
      },
