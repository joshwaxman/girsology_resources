  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר באשה אמר רב פפא באשה ובכתובתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ופירש גאון כך מראין הדברים רב חסדא אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבעל הישנו זקן שהוא כמנהג העולם קרוב",
