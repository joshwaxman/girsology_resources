      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר (רשב\"א) [ר' אלעזר] מתניתא מסייעא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה לר' יוחנן מה שנים נמצא אחד מהן",
