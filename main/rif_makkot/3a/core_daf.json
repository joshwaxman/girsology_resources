        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא מדעת חבירו: ירושלמי <i data-commentator=\"Tur\" data-label=\"⚬\"></i>כתב כל נכסיו",
      "segment_ids": [
