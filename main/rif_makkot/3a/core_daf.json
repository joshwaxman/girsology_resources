        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לב' בני אדם והעדים כשרים לזה ופסולין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לזה ר' יוחנן אמר פסול ורשב\"ל אמר כשר",
