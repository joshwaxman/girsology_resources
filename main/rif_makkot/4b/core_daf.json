      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יד הבגד שלו והכניסן חייב",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהרי נראה כמכין עצמו ללבוש",
      "segment_ids": [
