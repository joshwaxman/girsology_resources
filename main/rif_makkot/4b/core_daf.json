  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מתני' קעקע.</b> לשון קריעה וחקיקה: <b>עד שיכתוב ויקעקע.</b> כלומר אחר שקרע עורו הניח דיו באותו שריטה ונכרת שם זמן גדול",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובעינן תרתי לחיובא שריטה וכתיבה ולישנא דקרא נקט דכתיב וכתובת קעקע שהרי תחלה הוא קורע העור ואח\"כ כותב: <b>עד שיכתוב</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שם השם.</b> כלומר על אותה שריטה שיכתוב את השם ומפרש בברייתא שם עבודת כוכבים ואזהרתיה מדכתיב אני ה' ולא אחר ולית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלכתא כוותיה אלא כת\"ק: <b>גמ' עד דכתב אני ה' ממש.</b> שתי התיבות: <b>שנאמר</b> וכתובת שם עבודת כוכבים לא תתנו בכם ולמה כי אני",
      "segment_ids": [
        2,
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה' ולא תעשו אדון אחר זולתי:",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אפי' אריבדא דכוסילתא.</b> אפי'",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על מקום הקזה קפיד שלא ליתן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו דבר שחור שנראה ככתובת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קעקע ולית הלכתא כוותיה ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרב מלכיו אלא כרב אשי דהוא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתרא וכל מקום מכה מותר:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתני' אינו חייב אלא אחת.</b> על",
      "segment_ids": [
