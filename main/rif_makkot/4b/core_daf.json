      "right": "0px",
      "left": "",
      "text": "כגון לבישת שעטנז וכן כהן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטמא למתים כענין נזיר: <b>גמ'</b>",
      "segment_ids": [
