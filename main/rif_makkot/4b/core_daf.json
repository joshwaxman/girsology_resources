      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לומר שכחתי שהיה אסור אבל אם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התרו בו על כוס וכוס חייב על",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל אחת ואחת וה\"ה לכל איסורי",
