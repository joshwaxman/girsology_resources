  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> עיין לקמן פרק ב\"ש: <b>לשון ריא\"ז</b> השיאה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו אביה כשהיא קטנה וגרשה והחזירה ומת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעודה שהיא קטנה אסורה ליבם איסור ערוה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהרי קדושין הראשונים היו קדושי תורה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכשגרשה בעלה נעשית עליו גרושת אחיו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכשהחזירה בעלה אין קדושי' קדושי תורה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שכבר יצאת מרשות האב משעה שהשיאה ואין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בידו לקדשה היא הנקראת יתומה בחיי האב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שקדושיה מדברי סופרים ומאחר שאסורה על",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היבם איסור ערוה לא חולצת ולא מתיבמת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בקונטרס הראיו': <b>ב</b> כתב הרא\"ש ז\"ל",
