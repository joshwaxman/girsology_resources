      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שהוא ב\"ד וכתב רי\"ף ז\"ל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולאו דוקא ב\"ד אלא אפילו תרי",
      "segment_ids": [
