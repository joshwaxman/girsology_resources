      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא <i data-commentator=\"Nuschaot Ktav Yad\" data-label=\"ו\" data-order=\"6\"></i>רצה אחד מן העדים לקנות",
      "segment_ids": [
