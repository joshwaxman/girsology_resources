      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החתומים על שדה מקח ועל גט",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשה לא חששו חכמים לדבר זה",
      "segment_ids": [
