  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> עיין פרק אלו מגלחין בהגהה: <b>ב</b> עיין",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פרק אלו מגלחין בהגהה: <b>ג</b> וכן הולדות של",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שפחה ובהמה מנכסי מלוג אע\"פ שהן של הבעל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כשיוצאה נותנת דמיהם ונוטלתן ומטעם זה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב הרמ\"ה שאינו רשאי למכרם אפילו בעודה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תחתיו ולא נהירא להרא\"ש ז\"ל דודאי בעודה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תחתיו עושה בהן כל מה שירצה אלא אם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיירם נותנת דמים ונוטלתן: <b>ד</b> כתב הראב\"ד",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        1,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל גם כי אני איני כדאי להשיב על דברי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרב ז\"ל כל כי האי מלתא נימא איניש ולא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לשתוק כיון דקי\"ל כר' יוחנן דאמר המזכה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לבנו אפילו במעי אמו קנה הואיל ודעתו של",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אדם קרובה אצל בנו והכי איתא בפרק מי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמת והתם אמרי' דירושה הבאה מאליה עדיפא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מן המזכה לעובר ואי במזכה אמרי' דקני",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כ\"ש בירושה הבאה מאליה וא\"כ היכי נדחי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למילתיה דרבי יוסי דהכא מהאי טעמא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרי' דעובר לית ליה זכייה הא קי\"ל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דעובר אית ליה זכייה. והשיב הרמב\"ן ז\"ל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לקיים דברי רב אלפס דלית הלכתא כר' יוסי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אפילו בירושה הבאה מאליה משום דיחידאה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא ורבנן פליגי עליו ואפי' שמואל דס\"ל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כוותי' קאמר אבל חכמים אומרים יש לו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנים אוכלים בשביל בנים יש לו אחים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אוכלים בשביל אחים. והא דשמואל סבר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כוותיה שמואל לטעמיה דאית ליה המזכה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעובר קנה והא אפסיק התם בפרק מי שמת",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
