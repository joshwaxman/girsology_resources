  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תומא.</b> שום. גרגישתא: <b>ארזיל\"א במעבה האדמה (מלכים א ז) מתרגמינן גרגישתא דארעא.</b> והא דאמרינן דבעינן שיהא הרוק בפניו",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מדכתיב וירקה בפניו מסתברא דלא קאמר אלא שיהא כנגד פניו בין רואה בין שאינו רואה ואפילו סומא חולץ לכתחלה ודוקא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לבית דין הוא דבעינן שיראו הרוק מדכתיב לעיני הזקנים והא דתניא בברייתא החולצת מן הסומא חליצתה כשרה בדיעבד משום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סיפא דקתני פסולה נקט הכי אלא שהרמב\"ם ז\"ל כתב דאין סומא חולץ לכתחלה: <b>הדרן</b> עלך מצות חליצה <b>פרק</b> שלשה עשר <b>בית שמאי</b>",
      "segment_ids": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אומרים אין ממאנין.</b> יתומות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהשיאום אמה ואחיה. אלא מן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האירוסין: <b>בבעל.</b> אבל אם מת",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא מאנה בו ונפלה לפני יבם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינה יוצאה במיאון אלא תמתין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עד שתגדיל ותחלוץ: <b>אין בנות</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> ואפי' מן האירוסין לא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמאן ותארס לאחר [<i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>ותמאן אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממאנת בזה ותמתין מליארס לאחר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עד שתגדיל ויהיו קדושין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמורין ולא תצא עוד משני]",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במיאון: <b>ותמאן.</b> בראשון ותנשא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובגמ' פריך הא מיאנה ביה חדא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זימנא: <b>גמ' ממאנת למאמרו.</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לב\"ה דאמרי ממאנת ביבם למאמרו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממאנת שאם עשה בה מאמר ממאנת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ועוקרתו שלא תהא צריכה גט",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למאמרו אבל חליצה שהיא בשביל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זיקה לא עקרה: <b>זיקה דרחמנא</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רמיא עליה.</b> דסבר רבי אושעיא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון דלא מאנה בראשון בחייו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כבר קיימה לנשואין ואינה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יכולה לעקרם לאחר מיתתו כלל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכיון שכן זיקת יבם בעל כרחה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רמיא עלה כמו ביבמה דעלמא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהשתא לא מציא למאן בבעל ואין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה רשות לעקור נשואין לאחר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותו זו דעת ר' אושעיא וליתא.",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל עולא אמר ממאנת אף לזיקתו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקסבר יש מיאון ואפי' לאחר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיתה ויכולה לומר רציתי בבעל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשון אבל לא נתרציתי לו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיזקיקני ליבם ואפי' כשממאנת",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביבם סתם הוי מיאון מהאי טעמא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והלכתא כעולא כן פסק הריא\"ף",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל: <b>שיכולה למאן.</b> בפ\"ק בתו",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קטנה הנשואה לאחיו ולא קבל",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אביה קדושי' כגון שהשיאה אביה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאחר תחלה ונתגרשה והיא יתומה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחיי האב ויכולה למאן ולא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיאנה בו ומת:",
      "segment_ids": [
        10
      ]
    }
  ],
