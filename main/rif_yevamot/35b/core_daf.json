  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "תומא ורקקה או אכלה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>גרגישתא ורקקה <i data-commentator=\"Nuschaot Ktav Yad\" data-label=\"א\" data-order=\"1\"></i>ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום הוא מ\"ט וירקה מעצמה בעינן וליכא):",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונקרא שמו בישראל מצוה בדיינין תניא א\"ר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה פעם אחת היינו יושבין לפני רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טרפון באה יבמה לחלוץ ואמר לנו ענו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כולכם ואמרו חלוץ הנעל חלוץ הנעל חלוץ הנעל: <b>סליק פירקא <big>סידור חליצה</big></b>",
      "segment_ids": [
        1,
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ברישא צריכין בית דין למקבע דוכתא ביממא ועבדין סנדלא דאית ליה עקב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ושנאצי ודלא תאפיר בכיתנא ומשוי ליה ברגליה דימינא ומקרו ליבמה מאן יבמי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "להקים לאחיו שם בישראל לא אבה יבמי כלשון הזה בלשון הקדש ומקרו ליבם לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חפצתי לקחתה וצריך יבם לדחוסי רגליה בארעא ואתיא יבמה ושריא שנאצי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דסנדלא ושלפא ליה מרגליה ושדיא רוקא על ארעא מפומה קמי יבם וצריכין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דיינין למיחזי רוקא כד נפיק מפומה ובתר הכין מקרו לה (דברים כ״ה:ט׳-י׳)",
      "segment_ids": [
        3
      ]
