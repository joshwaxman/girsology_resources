        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "י\"ב וכן הקטן שהביא סימנים בתוך שנת י\"ג",
