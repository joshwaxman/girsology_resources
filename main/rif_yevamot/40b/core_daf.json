      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בדיקת נשים אפי' להקל מפני שהחזקה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מסייעתן קטנה שהביאה סימנים בתוך שנת",
