      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבשניה ליכא למימר לקוחין דהא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא תפסי בה קדושין: <b>ומיהו</b> קשה",
      "segment_ids": [
