        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואשה אל אחותה לא תקח: <b>דרך</b>",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לקוחין.</b> שהיתה ראשונה לקוחה",
