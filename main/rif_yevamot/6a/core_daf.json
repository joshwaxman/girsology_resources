      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנטען <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>אין מוציאין אותה מידו ודייק רב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מדקתני הוציאוה ולא קתני הוציאה מכלל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבית דין הוציאוה ובית דין אין מוציאין",
