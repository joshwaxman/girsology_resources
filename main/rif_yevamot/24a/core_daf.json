      ],
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש וקשה וכי פליג ר' ישמעאל אמתני'",
