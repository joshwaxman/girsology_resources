        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקדושתו ואסור בפסולי כהונה אם לאו וכן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אסור בממזרת אפילו פצוע דכא ישראל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בקונטרס הראיות אבל מותר הוא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנתינה ואע\"פ שהיא מפסולי קהל שאין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אסורה אלא מדברי סופרים לא גזרו בה",
