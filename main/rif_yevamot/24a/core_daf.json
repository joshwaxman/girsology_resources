  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב הטור בראש הגיד יש בשר ובחיבורו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
