    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>את החרשת <i data-commentator=\"Hagahot HaBach\" data-label=\"ל\" data-order=\"11\"></i>וכו'.</b> דחליצת קטנה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסלה לה עליה: <b><i data-commentator=\"Hagahot HaBach\" data-label=\"מ\" data-order=\"12\"></i>דחרשת קנויה</b>",
      "segment_ids": [
