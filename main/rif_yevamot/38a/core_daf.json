    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במקצת ומשוירת <i data-commentator=\"Hagahot HaBach\" data-label=\"נ\" data-order=\"13\"></i>קטנה קנויה</b>",
