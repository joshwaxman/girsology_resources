  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "פצוע ולא קרינן הפצוע במתניתא תנא נאמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא יבא פצוע דכא ונאמר לא יבא ממזר מה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להלן בידי אדם אף כאן בידי אדם אמר רבא",
      "segment_ids": [
