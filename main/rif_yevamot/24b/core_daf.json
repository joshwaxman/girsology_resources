  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> נקב למטה מהעטרה לצד הקרקע [כשר] ניקב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העטרה עצמה אם הנקב גדול ששכבת זרע יוצא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משם כשרואה קרי פסול ואם לאו כשר נסתם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הנקב חוזר להכשרו נקב נקב מפולש בראש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הגיד בענין שבעליונו של גיד שהעטרה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מארכת כלפי הגוף הוא למטה מהעטרה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובתחתיתו של גיד הוא למעלה מהעטרה פסול:",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ב</b> כתב הטור נסתם מקום הזרע ויוצא במקום",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יציאת מי רגלים אם הוא ממעי אמו ממילא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כשר ואם הוא ע\"י חולי או לקוי פסול כתב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הר\"ר אליעזר בניקב הגיד דפסול וכן בנסתם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מקום הזרע לאו אגברא קאי אלא אולד קאי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פירוש פסול הולד הנולד לו שאינו מוליד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובודאי ממזר הוא אבל הוא כשר לבא בקהל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דלאו כרות שפכה הוא ואין הלשון משמע כן:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ג</b> כתב סמ\"ג שעמוני לאו בפני עצמו ומואבי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאו בפני עצמו וכ' הר\"ר יוסף הטעם בעמון",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מפני שלא קדמו והטעם במואב מפני ששכר את",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בלעם ונשים אין דרכם לקדם ולא לשכור: <b>ד</b>",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב סמ\"ג דבזמן הזה כל הגרים מותרין לבא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בישראל מיד מפני שבלבל סנחריב העולם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואמנם מצא בתוספתא דידים שמצרים חזרו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא נתבלבלו וכ\"כ רבינו שמשון שעמון",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומואב לא בלבלם סנחריב וכן יש מדקדקין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאדומים לא נתבלבלו מההי' דאנטונינו'",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דפ\"ק דע\"ז הילכך צריך להתיישב בדבר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומיימוני מתיר כולם לבא בקהל מיד וטור",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתיר כולן חוץ מן המצרי שפוסלו עד דור",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלישי ורבינו השמיט כל זה וצריך עיון:",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לשון ריא\"ז</b> מצרי ואדומי אינן אסורין אלא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עד שלש דורות אחד זכרי' ואחד נקבות",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והראשון שנתגייר נחשב דור ראשון ובנו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שני ובן בנו שלישי וכבר נתבאר בפרק תפלת",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השחר שכל האומות הקדומות אינן יושבות",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במקומן שכבר עלה סנחריב ובלבל את כל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האומות ואינו ניכר עמוני ומואבי מצרי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואדומי וכל גר שיתגייר בזמן הזה הרי הוא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחזקה משאר אומות ומותר לבא בקהל כמבואר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות:",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        4
      ]
    }
