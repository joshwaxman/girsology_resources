      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפילו היה זקן או חולה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדאיתא במסכת גיטין פרק כל",
      "segment_ids": [
