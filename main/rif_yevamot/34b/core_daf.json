  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> סמ\"ג האריך בזה הרבה לבאר טעם הדבר גם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
