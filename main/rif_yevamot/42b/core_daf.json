        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פי' ר\"ת לקמן גבי אין מעידין אלא עד",
      "segment_ids": [
