      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלשה ימים. ועי' בהרא\"ש: <b>ד</b> ומיי' כתב",
