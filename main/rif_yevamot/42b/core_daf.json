  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב מיי' שאם נשאת לא תצא ואם אומר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העד מת וקברתיו נאמן וכתב רבינו דה\"ה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נמי בשנים במלחמה דאינם נאמנים אא\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אומרים מת וקברנוהו: <b>לשון ריא\"ז</b> בא עד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחד ואמר שמת בעלה במלחמה כתב מז\"ה שאף",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זה ספק ומחמירים בה מספק ואני אומר שעד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחד במלחמה נאמן שלא חששו חכמים אלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעדות האשה עצמה שהיא טועה לפי תאותה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחפצה להתיר עצמה אבל העד אינו אומר אלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מה שראה ואין טעות בדבריו כמבואר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיו' לפיכך נאמן ומשיאין אותה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על פיו: <b>ב לשון ריא\"ז</b> ואפילו אמר לה עד",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "א' הולכת לב\"ד ומתרת עצמה ע\"פ אותו העד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהעיד לה ואע\"פ שהעד כופר אח\"כ עדותו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לב\"ד ואומר שאינו יודע לה עדות כמבואר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בפ' שבועת העדות ולא בכ\"מ האמינו עד אחד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באשה שהרי אם בא עד אחד והעיד על אשת",
      "segment_ids": [
