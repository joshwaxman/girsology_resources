  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בעולם או דילמא כיון דחזקה הוא דאמרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדדמי לא אתיא מה לי לשקר ומרעי לחזקה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא איפשיטא עישנו עלינו בית עישנו",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עלינו מערה הוא מת ואני נצלתי אינה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאמנת דאמרינן לה <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>כי היכי דלדידך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איתרחיש ניסא לדידיה נמי איתרחיש ניסא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נפלו עלינו כותים נפלו עלינו ליסטים הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מת ואני נצלתי נאמנת כדרב אידי דאמר אשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלי זיינה עליה כלומר שמניחין אותה לבא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליה ההוא גברא דבשילהי הילוליה איתלי",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נורא בגנניה אמרה להו דביתהו חזו גבראי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(אתו) חזו גבראי אתו חזו גברא חרוכא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דשדי ופסתא דידא דשדיא רבא אמר נאמנת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ור\"ח בר אבין אמר האי גברא חרוכא דילמא איניש מעלמא אתא לאצוליה ואכלתיה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נורא והאי <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בד\"ס</i> <i class=\"footnote\">הגי'</i> <i class=\"footnote\">פס</i> <i class=\"footnote\">ידא</i>פסתא פס ידא דחתנא הוא ומחמת כיסופא ערק ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואזיל לעלמא איבעיא להו עד אחד במלחמה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מהו טעמא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>דעד אחד דמהימן משום",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דמילתא דעבידא לאיגלויי <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>לא משקר <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ג\" data-order=\"3\"></i>ה\"נ לא משקר או דילמא טעמא דעד אחד משום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דהיא גופה דייקא ומינסבא <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>והכא זימנין דסניא ליה ולא דייקא ומינסבא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואתינן למפשטה מהא דתניא מעשה בשני תלמידי חכמים שהיו באין עם אבא יוסי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בן סימאי בספינה וטבעו והשיא רבי את נשותיהן ע\"פ נשים והא מים כמלחמה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דמו ומאה נשים כעד אחד דמו וקתני והשיא רבי את נשותיהן אלמא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>דעד אחד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נאמן במלחמה ודחינן ותסברא והא מים שאין להן סוף נינהו ומים שאין להם",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "סוף אשתו אסורה אלא היכי דמי הכא כגון דקאמרן אסוקינהו לקמן <span class=\"bavli-ref\" data-bavli-ref=\"(דף קטו:)\" data-bavli-daf=\"115b\" data-bavli-index=\"0\"></span>וחזונוהו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לאלתר וקאמרי סימנין דידהו דלאו עלייהו קא סמכינן אלא אסימנין הוא דקא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>סמכינן וליכא למגמר מינה דסמכינן אנשים והוא הדין לעד אחד ולא אפשיט",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בעיין <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>אלא מיהו כיון דאמרינן בפרקא דלקמן <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכא.)\" data-bavli-daf=\"121a\" data-bavli-index=\"1\"></span>ההוא גברא דטבע בדיגלת ואסקוה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אגישרא דשביסתנא ואסבא רבא לדביתהו אפומא דשושבינא לבתר חמשא יומא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שמעינן <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>דעד אחד במים שאין להם סוף נאמן ודוקא היכא דאמר אסקוה לקמאי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "וחזיתיה לאלתר ואישתמודענא ליה דאיהו פלוני וכד אסיקנא למעשה דשני ת\"ח",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שהיו באין עם אבא יוסי בן סימאי וכדאמרינן בההוא גברא דטבע בדיגלת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואסקוה אגישרא והוא הדין לעד אחד במלחמה היכא דאמר מת וקברתיו ואי לא קא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מסהדי",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עישנו.</b> הציתוהו באש ונתמלא עשן ואני ברחתי והוא נשאר שם ומת: <b>אשה כלי זיינה עליה.</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר שמניחין אותה כדי לבא עליה וכיון דלא מסתפיא הויא בהדיה ולא אמרה בדדמי אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נטרה וחזיא ליה דמית וזו ראיה למה שכתבנו דכשאינה יראה לא שבקא ליה ונאמנת דלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אמרה בדדמי: <b>ההוא גברא.</b> חזו גברא. שהאש אוכלתו: <b>והלכו ומצאו חרוכא דשדי.</b> איש אחד",
      "segment_ids": [
        1,
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נשרף: <b>ופיסתה דידא דשדיא.</b> ויד",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד חתוכה (לה) מוטלת סמוכה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה ונשרפה ג\"כ: <b>כיסופא</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דאתיליד ביה מומא.</b> כתבו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המפרשים ז\"ל היה נראה למפסק",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהא הלכה כרבא מדאמרי' בגמרא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סבר רב חייא בר אבין למימר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשמע שהיה עולה כן בדעתו אבל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא שיהיה כן הדין אבל <i data-commentator=\"Hagahot HaBach\" data-label=\"י\" data-order=\"10\"></i>הרב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלפסי ז\"ל נראה שפסק כרב חייא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בר אבין לחומרא וכן פסקו רוב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשונים ז\"ל: <b>איבעיא</b> להו עד",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד במלחמה פירשה רבינו אלפסי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל באומר מת <i data-commentator=\"Hagahot HaBach\" data-label=\"כ\" data-order=\"11\"></i>וקברתיו דוקא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכטעמא דאמרינן דילמא טעמא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דעד אחד משום דלא משקר הכא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי לא משקר <i data-commentator=\"Hagahot HaBach\" data-label=\"ל\" data-order=\"12\"></i>וכו' דזימנין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשקר אלא אנן לאו עליה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סמכינן אלא אאתתא גופה דדייקא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עד שתגיע לדבר ברור והכא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זימנין דסניא ליה <i data-commentator=\"Hagahot HaBach\" data-label=\"מ\" data-order=\"13\"></i>וסמיך כיון",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאית לה מידי למסמך בדדמו אבל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באומר מת סתם לא מיבעיא חד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלא מהימן אלא אפי' תרי נמי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא מהמני משום דכל במלחמה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרי בדדמי: <b>והא מים כמלחמה</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דמו.</b> דאיכא למימר <i data-commentator=\"Hagahot HaBach\" data-label=\"נ\" data-order=\"14\"></i>בדדמי: <b>מים</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שאין להם סוף.</b> בפרק בתרא [דף",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קכא.] מפרש שיש להם סוף שעומד",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ס\" data-order=\"15\"></i>ורואהו מארבע רוחותיו דאי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"פ\" data-order=\"16\"></i>איתיה דסליק מחזו חזי ליה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומים שאין להם סוף כל שעומד",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינו <i data-commentator=\"Hagahot HaBach\" data-label=\"צ\" data-order=\"17\"></i>רואהו מארבע רוחותיו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשתו אסורה אפילו יש עדים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשרים שטבע שמא צף מתחת המים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויצא: <b>סימני.</b> דאי לאו סימנים",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חיישינן דלמא אחריני נינהו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לפי שהמים משנין צורת פנים ואינם ניכרים כל כך ואם כן צריך סימן מובהק כדרך שנותנין באבדה כגון שהוא במקום המוצנע",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובעיין לא איפשיטא הכא אבל הרי\"ף ז\"ל פשט לה מההוא דטבע בדיגלת ורבא אנסיבא לדביתהו אפומה דשושביניה שאמר אסקוה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לקמאי וחזיתיה לאלתר ואשתמודענא ליה וכי האי מעשה של ב' ת\"ח וכן מההוא עובד כוכבים מסיח לפי תומו [ריש דף קנב.]",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאמר על ס' בני אדם שמתו על כרקום ביתר וקברתים והתירו נשותיהן וכ\"ש על פי עד אחד כשר ודוקא במת וקברתיו וכן נראה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מלשון הרמב\"ם ז\"ל שאמר עד אחד שאמר ראיתיו במלחמה או ראיתיו שנפלה עליו מפולת או שטבע בים הגדול ומת כיוצא באלו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מדברים שרובן למיתה אם אמר קברתיו נאמן ותנשא אשתו על פיו ואם לא אמר קברתיו לא תנשא ואם נשאת לא תצא וכן האשה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמעיד לה שטבע בעלה במים שאין להם סוף ולא עלה הרי זו לא תנשא ואם נשאת לא תצא ומדבריו ז\"ל שכ' במים שאין להם סוף",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "או שטבע בים הגדול נראה דטעמא דעד אחד משום דאמר בדדמי כדברי הרי\"ף ז\"ל אבל מן המפרשים ז\"ל הוכיחו מן הירושלמי דעד",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחד נאמן במלחמה אפילו אמר מת סתם וכן כתב הראב\"ד ז\"ל דעד אחד במלחמה לא בעינן מת וקברתיו ומנסבינן לה לכתחלה ודייק",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לה מההיא דפרק בתרא [דף קכא.] דטבע חסא ולא אקיה אפי' במים שאין להם סוף אלמא במים שיש להם סוף אפילו לכתחלה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מנסבינן לה ואפילו לא אמר קברתיו <i data-commentator=\"Hagahot HaBach\" data-label=\"מ\" data-order=\"13\"></i>ומת במלחמה [כמים דמו] <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>:",
      "segment_ids": [
        9
      ]
    }
  ],
