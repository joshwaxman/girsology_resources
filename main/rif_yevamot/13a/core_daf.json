  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> ור\"ת פליג ופסק דמצות חליצה קודמת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בזמן הזה וכך פוסק ר\"ת והאריך בראיות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיהו אין כופין אותו לחלוץ אלא אם חפץ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיבם ומה שכתוב בספרים בפרק החולץ חזרו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
