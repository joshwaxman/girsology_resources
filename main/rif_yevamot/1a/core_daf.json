  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<big><strong>חמש</strong></big>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "עשרה נשים <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i>פוטרות צרותיהן וצרות צרותיהן מן החליצה ומן היבום עד סוף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "העולם <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>בתו ובת בתו ובת בנו בת אשתו ובת <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>בתה ובת בנה חמותו ואם חמותו ואם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "חמיו אחותו [מאמו] ואחות אמו ואחות אשתו ואשת אחיו מאמו ואשת אחיו שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "היה בעולמו וכלתו הרי אלו פוטרות צרותיהן וצרות צרותיהן מן החליצה ומן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "היבום עד סוף העולם וכולן אם מתו או <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>נתגרשו או מיאנו או שנמצאו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>אילוניות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "צרותיהן מותרות ואי אתה יכול לומר בחמותו ובאם חמותו ובאם חמיו שנמצאו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אילוניות או שמיאנו <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>שכבר ילדו: <b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף ג:)\" data-bavli-daf=\"3b\" data-bavli-index=\"0\"></span>מנא ה\"מ דתנו רבנן (ויקרא י״ח:י״ח)",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ואשה אל <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>אחותה לא תקח לצרור לגלות ערותה עליה בחייה מה ת\"ל לפי שנאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "(דברים כ״ה:ה׳) יבמה יבא עליה שומע אני אפילו על אחת מכל העריות האמורות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בתורה הכתוב מדבר נאמר כאן עליה ונאמר להלן יבמה יבא עליה מה להלן במקום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מצוה <i data-commentator=\"Nuschaot Ktav Yad\" data-label=\"א\" data-order=\"1\"></i>אף כאן במקום מצוה ואמר רחמנא לא תקח אין לי אלא היא צרתה מנין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תלמוד לומר לצרור אין לי אלא צרתה צרת צרתה מנין ת\"ל לצרור <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>ולא <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>לצרר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ואין לי אלא אחות אשה שאר עריות מנין אמרת מה אחות אשה מיוחדת שהיא ערוה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "וחייבין על זדונה כרת ועל שגגתה חטאת ואסורה ליבם אף כל שהיא ערוה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "וחייבין על זדונה כרת ועל שגגתה חטאת אסורה ליבם ואין לי אלא הן צרותיהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מנין אמרת מה אחות אשה מיוחדת שהיא ערוה וחייבין על זדונה כרת ועל שגגתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "חטאת ואסורה ליבם צרתה אסורה אף כל שהיא ערוה וחייבין על זדונה כרת ועל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שגגתה חטאת ואסורה ליבם צרתה אסורה מכאן אמרו חמש עשרה נשים פוטרות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "צרותיהן וצרות צרותיהן מן החליצה ומן הייבום עד סוף <i data-commentator=\"Nuschaot Ktav Yad\" data-label=\"ב\" data-order=\"2\"></i>העולם יכול שאני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מרבה <i data-commentator=\"Nuschaot Ktav Yad\" data-label=\"ג\" data-order=\"3\"></i>את שש עריות חמורות",
      "segment_ids": [
        1
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פרק</b> ראשון <b>חמש עשרה נשים פוטרות צרותיהן.</b> כדקתני שאם היתה <i data-commentator=\"Hagahot HaBach\" data-label=\"נ\" data-order=\"14\"></i>נשואה לאחיו ולו אשה אחרת ומת בלא בנים שתיהן פטורות",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וטעמא יליף בגמרא: <b>וצרות צרותיהן.</b> לקמן במתניתין מפ': <b>חמותו.</b> שאם מת בעלה ונשאה אחיו ומת בלא בנים: <b><i data-commentator=\"Hagahot HaBach\" data-label=\"ס\" data-order=\"15\"></i>וכן אם חמותו</b>",
      "segment_ids": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואם חמיו.</b> שכולן אסורות לו <i data-commentator=\"Hagahot HaBach\" data-label=\"ע\" data-order=\"16\"></i>מטעם הפסוק דכתיב (ויקרא י״ח:י״ז) ערות אשה ובתה לא תגלה את בת בנה ואת בת בתה ויש בכלל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זה חמותו [ואם חמותו ואם חמיו] <i data-commentator=\"Hagahot HaBach\" data-label=\"פ\" data-order=\"17\"></i>שכולן אסורות לו משום ערוה כדמפרש באלו הן הנשרפין (דף עה.) ובתו ובת בתו ובת בנו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהכא בבתו מאנוסתו מיירי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאילו בתו מאשתו היינו בת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשתו דכיון דכתיב אשה ובתה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ל\"ש הימנו ול\"ש מאיש אחר אבל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתו מאנוסתו לא ילפינן מהכא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאשה ע\"י קדושין משמע דאישות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא ומקרא אחרינא נפקא כדמפרש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמ': <b>אחותו מאמו.</b> שנשאת",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאחיו מאביו ומת בלא בנים וכן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחות אמו שנשאת לאחיו מאביו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין יבום אלא לאחין מן האב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכתיב כי ישבו אחים יחדיו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וילפינן אחוה אחוה מבני יעקב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפ' שני (דף יז:) מה להלן מן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האב אע\"פ שאין מן האם ה\"נ",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ל\"ש: <b>ואשת אחיו מאמו.</b> שמת",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונשאה אחיו מאביו שהיתה נכרית",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אצלו ומת בלא בנים ונפלה לפני",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה ליבום אסורה לו לפי שהיתה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשת אחיו מאמו תחלה ואסורה לו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עולמית דכתיב ערות אשת אחיך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודרשינן ליה בפרק הבא על",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יבמתו (דף נה.) אחיך בין מן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האב בין מן האם: <b>ואשת אחיו</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלא היה בעולמו.</b> כגון ראובן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמת בלא בנים ונולד לו אח <i data-commentator=\"Hagahot HaBach\" data-label=\"צ\" data-order=\"18\"></i>אחר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיתה ושמו לוי ועמד שמעון",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויבם את אשתו ולו אשה אחרת",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומת בלא בנים ונפלו שתיהן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפני לוי שתיהן פטורות לפי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאשת ראובן שנשאת לשמעון אסורה ללוי וענוש כרת עליה לפי שאשת אח בכרת כשאר עריות שבפרשה <i data-commentator=\"Hagahot HaBach\" data-label=\"ק\" data-order=\"19\"></i>וכתיב בכולהו כי כל אשר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וגו' ובמקום מצות יבום כשמת בלא בנים שרייה רחמנא ואשת אחיו שלא היה בעולמו שמת קודם לידתו לא שריא ליה דכתיב כי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ישבו אחים יחדיו שהיתה להם ישיבה אחת בעולם והלכך כשמת ראובן נאסרה על לוי איסור עולם כאשת אח שיש לו בנים ואפי'",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עכשיו שנפלה מכח נשואי שמעון שהיה בעולמו אסורה לו בשביל ראובן וכשם שהיא אסורה לו כך צרתה אשת שמעון האחרת אסורה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לו דילפי' לקמן על כל העריות העומדות עליו בכרת שנפלו לפניו ליבום עם צרותיהן ששתיהן פטורות ואם נשאן חייב כרת",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמאחר שפטרן הכתוב עומדת עליו באיסור אשת אח שיש לו בנים וכתבו המפרשים ז\"ל דהא דפירש רש\"י ז\"ל <i data-commentator=\"Hagahot HaBach\" data-label=\"ר\" data-order=\"20\"></i>בנולד ואח\"כ ייבם לא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נקטא בדווקא אלא דבעינן לפרושי לדברי הכל ומיהו אליבא דהלכתא קי\"ל כרבנן לקמן <i data-commentator=\"Hagahot HaBach\" data-label=\"ש\" data-order=\"21\"></i>פ' כיצד (דף יט.) דאסירה עליה בין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנולד ואח\"כ ייבם בין ייבם ואח\"כ נולד: <b>וכלתו.</b> שמת בנו ונשאת לאחיו וכלתו אסורה לו לעולם ואפי' אחר מיתת בנו: <b>וכולן</b>",
      "segment_ids": [
        7,
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שמתו.</b> אם מתה בתו קודם לאחיו: <b><i data-commentator=\"Hagahot HaBach\" data-label=\"ת\" data-order=\"22\"></i>או מיאנו.</b> והיכי משכחת מיאון בבתו והרי אביה קיים ואין מיאון אלא ביתומה משכחת לה",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כגון שהשיאה אביה ונתגרשה כשהיא קטנה ושוב אין לאביה רשות בה והלכה ונשאת לאחי אביה בעודה קטנה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"23\"></i>יוצאה במיאון ובפ'",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ב\"ש (דף קט.) קרי לה יתומה בחיי האב ואם מאנה באחי אביה או נתגרשה מאחי אביה: <b>או נמצאו איילוניות.</b> שמקחו מקח טעות",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולא הויא אשת אחיו וכשמת אחיו הרי היא כמו שאינה <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"24\"></i>ומתייבמת צרתה ומפרש <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"25\"></i>בתוספתא האי נמצאו בין בחיי הבעל בין לאחר",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מיתתו ורב אסי פירש בגמרא [דף יב.] דווקא נמצאו דהיינו שלא הכיר בה ומשום מקח טעות אבל רבא פירשה [דף יב:] בין",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהכיר בה <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"26\"></i>בעלה בין שלא הכיר בה ואפי' הכיר בה צרתה מותרת משום דכיון דלא חזיא ליבום כלל הרי היא כצרת ערוה שלא",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במקום מצוה [פי' כצרת ערוה באיש אחר שאינו אחיו דלא שייכא מצות יבום]: <b>והכי</b> איתא בירושלמי איילונית כמי <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ג\" data-order=\"3\"></i>שאינה בעולם",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והא דקתני שנמצאו תני שהיו והלכתא כרבא וכתב ר\"ת ז\"ל דלרבא דלאו טעמיה משום מקח טעות אפשר דאיילונית שלא הכיר בה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גיטא מדרבנן בעיא ואתיא שפיר מתניתין <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"27\"></i>דכתובות (דף ק:) דהממאנת והשניה והאיילונית אין להם כתובה דמשמע כתובה הוא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלית לה הא גיטא בעיא כדדייק התם (דף עג.) ואתיא שפיר נמי הא דאמרי' (במכילתין דף סא:) קטן וקטנה לא חולצין ולא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מיבמין קטן שמא ימצא סריס קטנה שמא תמצא איילונית ונמצאו פוגעין בערוה ואם איתא דלא בעיא גיטא כלל תתיבם קטנה ממה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נפשך דאפילו תמצא איילונית אנוסת אחיו בעלמא היא ושריא ליה אבל אי בעיא גיטא מדרבנן אמרינן פוגעין בערוה מדרבנן",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והרשב\"א ז\"ל תמה על פרש\"י ז\"ל שפי' <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"28\"></i>נמצאת איילונית שמקחו מקח טעות הוא ולא הויא אשת אחיו ולפי זה מתני' בשלא הכיר",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בה וכרב אסי ואנן כרבא קי\"ל דפירשה אפילו הכיר בה וכדאפסיק הלכתא בהדיא בגמרא: <b>גמ' מנא הני מילי.</b> דערוה וצרתה וצרת",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צרתה פטורות לעולם: <b>עליה מה ת\"ל.</b> ליכתוב לגלות ערותה בחייה ומשמע נמי שבחיי אשתו נאסרת עליו אחותה ולאחר מיתה",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מותרת: <b>שומע אני אפילו נפלה לפניו ליבום אחת מן העריות.</b> תתייבם: <b>לצרור.</b> צרות הרבה מדלא כתיב לצרר: <b>זדונה כרת.</b> בפ'",
      "segment_ids": [
        14,
        15,
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עריות כתיב בתר כולהו ונכרתו הנפשות העושות וכל שזדונו כרת שגגתו חטאת כדיליף בפירקין [דף ט.]: <b>ט\"ו</b> נשים ותו ליכא",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עריות בכרת חוץ משש עריות של משנתינו שאין בהם צד יבום לעולם: <b>(שנשואות לאחרים) יכול שאני מרבה וכו'.</b> שנשואות",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאחרים שיהו צרותיהן אסורות להנשא לזה <i data-commentator=\"Hagahot HaBach\" data-label=\"ל\" data-order=\"12\"></i>וה\"ה דהוה מצי למימר יכול שאני מרבה <i data-commentator=\"Nuschaot Ktav Yad\" data-label=\"א\" data-order=\"1\"></i>ט\"ו נשים אלו שלא במקום מצוה אלא דמשום",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דתנא דמתניתין תנא התירא שלא במקום מצוה בשש עריות נקט הכי ולהכי קתני בסוף דבריו שאין צרה אלא מאח לתת טעם לאלו",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "השש כדי שנלמוד מהם לט\"ו שלא במקום מצוה דאי לא למה <i data-commentator=\"Hagahot HaBach\" data-label=\"מ\" data-order=\"13\"></i>לי למתני שאין צרה אלא מאח כיון דהא ברירא להו להתירא אלא ודאי",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כדאמרן וכן פי' ר\"י ז\"ל <i data-commentator=\"Hagahot HaBach\" data-label=\"נ\" data-order=\"14\"></i>שאין צרה אלא מאח. דהואיל ופטרה הכתוב מזיקתו הרי היא עליו כאשת אח שיש לה בנים שהיא בכרת",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דכתיב ערות אשת אחיך <i data-commentator=\"Hagahot HaBach\" data-label=\"ס\" data-order=\"15\"></i>אבל בעלמא [דלא רמי] איסור אשת אח עלה <i data-commentator=\"Hagahot HaBach\" data-label=\"ע\" data-order=\"16\"></i>שריא ליה:",
      "segment_ids": [
        19
      ]
    }
