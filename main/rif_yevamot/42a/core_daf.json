      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכרתיו ע\"י סימנים כמבואר בקונטרס",
      "segment_ids": [
