      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היכא דמיהייב באחריותן אכלי בתרומה מהא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתנן כהן ששכר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>פרה מישראל אע\"פ",
      "segment_ids": [
