    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שתאסר אשת גיסו בלא גט ותהא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשתו מותרת וכן כתב הריטב\"א",
      "segment_ids": [
