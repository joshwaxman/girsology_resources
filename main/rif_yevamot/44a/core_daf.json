        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קודם שהתירוה ע\"פ ראשונה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפי' שניה זו צרתה אוסרת לה",
      "segment_ids": [
