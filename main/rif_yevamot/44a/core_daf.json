      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וזו מודות וכו'. הא אחת מודה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא ינשאו שתיהן אלא האחת. אשה",
