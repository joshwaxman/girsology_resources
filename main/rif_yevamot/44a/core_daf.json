  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>עד אומר מת ושנים אומרים לא מת אע\"פ",
      "segment_ids": [
