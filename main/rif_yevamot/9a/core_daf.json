      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפנקס דהא אי בעו כבשי ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשטרא ולא מסהדי הלכך אי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדכרי לה לסהדותא ומסהדי בה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השתא על פה הוי עדות ואי לא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא הוי עדות אבל שטרא דנפיק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתותי ידי בעל דין לא אמרי'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביה מפי כתבם הוא דהא מעידנא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחתמי בשטרא ויהבי ליה למריה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא יכלי למהדר בהו והוה להו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמו שנחקרה עדותן בב\"ד דאמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רשב\"ל עדים החתומים על השטר",
      "segment_ids": [
