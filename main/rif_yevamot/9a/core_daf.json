      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסהדי בה דמי ולא גמרינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיניה דהוה ליה ככותב עדותו",
      "segment_ids": [
