  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב סמ\"ג וגם בזמן הזה מועיל זמן שלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
