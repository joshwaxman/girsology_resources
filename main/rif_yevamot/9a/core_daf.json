        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש ז\"ל וא\"ת ומאי נפקא מינה אי מסהדי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על פי כתבם והא אמרינן בפרק גט פשוט מי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנמחק שטר חובו מעמיד עליו עדים ובא",
