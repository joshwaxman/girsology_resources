      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מזיד קאמרינן שכן רבתה אותה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תורה כדאיתא בגמרא [בדף נד",
