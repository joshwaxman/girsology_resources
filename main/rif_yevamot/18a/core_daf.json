    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודף נה] וכן הסכימו המפרשים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל: <b>ולא חלק בין ביאה לביאה.</b>",
