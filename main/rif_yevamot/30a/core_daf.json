  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דרש רבי אלעזר בן מתיא (ויקרא כ״א:ז׳)",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואשה גרושה מאישה ולא מאיש שאינו אישה:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף צד.)\" data-bavli-daf=\"94a\" data-bavli-index=\"0\"></span>אמר רב הוה ליה <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">ברא\"ש</i> <i class=\"footnote\">אית'</i>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">לר'</i> <i class=\"footnote\">אלעזר</i> <i class=\"footnote\">[וכ\"ה</i> <i class=\"footnote\">הב\"ח]</i>לאלעזר בן מתיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למידרש בהאי קרא מרגניתא ודרש בה חספא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאי מרגניתא ואשה גרושה מאישה אפי' לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נתגרשה אלא מאישה נפסלה מן הכהונה כגון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמר לה הרי את מגורשת ממני ואי את",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותרת לכל אדם אע\"ג דלעלמא לא הוו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גרושין ולא שריא לאינסובי בהאי גיטא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לדידיה מיהא איפסלא דאי כהן הוא איפסילא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיניה והיינו ריח הגט דפסיל בכהונה:",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני'</big></b> <i data-commentator=\"Mishneh Torah, Divorce\" data-label=\"⚬\"></i>מי שהלכה אשתו למדינת הים ובאו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואמרו לו מתה אשתו ונשא את אחותה ואחר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כך באה אשתו מותרת לחזור לו <span class=\"bavli-ref\" data-bavli-ref=\"(דף צד:)\" data-bavli-daf=\"94b\" data-bavli-index=\"1\"></span>ומותר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקרובות שניה ושניה מותרת בקרוביו ואם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מתה הראשונה מותר בשניה אמרו לו מתה אשתו ונשא אחותה ואח\"כ אמרו לו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "קיימת היתה ומתה הולד הראשון ממזר והאחרון אינו ממזר רבי יוסי אומר כל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שהוא פוסל על ידי אחרים פוסל על ידי עצמו וכל שאינו פוסל על ידי אחרים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אינו פוסל על ידי עצמו: <b><big>גמ'</big></b> ואף על גב דאזלא אשתו וגיסו למדינת הים",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דאהנו הני נשואין דקא מיתסרא אשת גיסו אגיסו אשת גיסו אסירא ואשתו שריא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ולא אמרינן מתוך שנאסרה אשת גיסו אגיסו תיאסר אשתו עליו לימא מתניתין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דלא כרבי עקיבא דאי רבי עקיבא הויא לה אחות גרושתו דתניא כל עריות שאמרו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אין צריכות הימנו גט חוץ מאשת איש שנשאת על פי בית דין או ע\"פ עדים ורבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "עקיבא מוסיף אף אשת אח ואחות אשה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>כיון דאמר רבי עקיבא בעיא גט ממילא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "איתסרא עליה דהויא לה אחות גרושתו ולאו מי איתמר עלה אמר רב גידל אמר רב",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "חייא בר יוסף אמר רב האי אשת אח היכי דמי כגון שקידש אחיו את האשה והלך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "למדינת הים ושמע שמת אחיו ועמד ויבם את אשתו ואחר כך בא אחיו דאמרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אינשי הך קמא תנאה הוה ליה בקידושין והאי שפיר קא נסיב והאי אחות אשה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "נמי היכי דמי כגון שקידש אשה והלכה לה למדינת הים ושמע שמתה ועמד ונשא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "את אחותה דאמרי אינשי הך קמייתא תנאה הוה ליה בקידושין <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>והאי שפיר נסיב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אבל בנשואין דליכא למימר תנאה הוה ליה בנשואין לא אמר רבי עקיבא דצריכה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הימנו גט הילכך הויא מתניתין כוותיה וכיון דמתניתין כוותיה <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>הלכתא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>כוותיה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "וחזינן מאן דכתב כל האסורות לאדם איסור ערוה ובא עליהן אין צריכות הימנו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "גט חוץ מאחות אשתו ואשת אחיו ואשת איש שנשאת על פי בית דין מפני שיש להן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "היתר אחר איסורן גזירה שמא יאמרו בהיתר נשאת ויוצאת בלא גט ולא קא מפליג",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בין נשואין לקדושין ואנן כתבינן מאי דסבירא לן: תניא (במדבר ה׳:י״ג)",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ושכב איש אותה <span class=\"bavli-ref\" data-bavli-ref=\"(דף צה.)\" data-bavli-daf=\"95a\" data-bavli-index=\"2\"></span>אותה שכיבתה אוסרתה ואין שכיבת אחותה אוסרתה והלא דין הוא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ומה במקום שבא על איסור קל שהיא אשת איש שאין האוסרה אוסרה כל ימיו נאסר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "האוסר מקום שבא על איסור חמור שהיא אחות אשה שאחותה אוסרתה על בעלה כל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ימי חייה אינו דין שנאסר האוסר אמר רבי יהודה לא נחלקו בית שמאי ובית",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הלל בבא על חמותו שפסל את אשתו ועל מה נחלקו בבא על אחות אשתו שבית שמאי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אומרים <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>פסל ובית הלל אומרים לא פסל א\"ר יוסי לא נחלקו בית שמאי ובית",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואף על פי שנתן לה (גט האחרון) לא פסלה מן הכהונה.</b> אם ימות בעלה הראשון דהא לאו גט הוא כלל שהרי היה בעלה חי: <b>מתני'</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ונשא את אתותה.</b> לפי שהכתוב לא אסרה אלא בחייה: <b>מותרת לחזור לו.</b> דקדושי שניה אינם כלום והרי ביאתה ביאת זנות ואמרינן",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בגמרא [דף צה.] אותה שכיבתה אוסרתה ואין שכיבת אחותה אוסרתה: <b>בקרובות שניה.</b> לישא בתה דקיימא לן [דף צז.] נושאין על",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "האנוסה ועל המפותה: <b>ושניה מותרת בבנו.</b> דנושא אדם אנוסת אביו ומפותת אביו ומתניתין דלא כרבי יהודה [שם] דאסר באנוסת",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אביו ומפותת אביו: <b>מותר</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בשניה.</b> אף על פי שהיתה שעה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחת אסורה עליו שריא ליה השתא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא בחייה כתיב: <b>הראשון.</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלפני מיתה ממזר: <b>האחרון.</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלאחר מיתה דהא שריא ליה: <b>גמ'</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואף על גב דאזיל וכו'.</b> דעל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרחך מתני' לא מיירי אלא בהכי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדמוכח סיפא דר' יוסי וכדאיתא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקמן: <b>דאזיל אשתו וגיסו.</b> כמו",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יצחק ועמרם שאינם אחים נשאו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ב' אחיות ואשת של יצחק הלכה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למדינת הים עם עמרם בעל אחותה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובאו שני עדים ואמרו ליצחק",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתה אשתך דאילו בעד אחד לא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שרי ליה למנסב לאחות אשתו דעד",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד לא התירוהו אלא לגבי אשה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא משום עגונא ואחד מהם או",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שניהם העידו לאשת עמרם שמת",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלה ונשא יצחק לאשת עמרם",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאשה שהיתה אחות אשתו דכיון",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמתה אחותה שריא ליה ואחר כך",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באת אשתו ועמרם גיסו אשת עמרם",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסורה לעמרם וצריכה גט ממנו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינה צריכה גט מיצחק אף על",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פי שנשאת כבר לאשה דליכא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למטעי בהא שמא גרש זה ונשא זה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויאמרו מחזיר גרושתו משנשאת",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואשת איש יוצאה בלא גט",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדאמרינן גבי רישא דמתני' [דף",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פח:] דהאשה שהלך בעלה למדינת",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הים דאילו הכא ליכא למימר הכי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאפילו גרש גיסו את אשתו אין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קדושין תופסין לו בה בחיי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשתו משום אחות אשה: <b>תאסר</b>",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אשתו עליו.</b> אשת יצחק ליצחק",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דנימא כיון שהיא אוסרת אחותה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דין הוא שתאסר היא לבעלה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומדין ק\"ו כדאיתא לקמן",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושיצטרך גט <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>האסורה אשת עמרם",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיצחק האוסר ונמצאת אשת יצחק",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסורה עליו משום אחות גרושתו:",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כגון שקדש אחיו וכו' ושמע.</b>",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האח שעומד כאן: <b>שמת אחיו.</b>",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהלך: <b>דאמרי אינשי.</b> אי לא",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נסיבה גט מהך שלקחה לו לאשה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יאמרו שמוציא לאשתו גמורה בלא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גט דאילו <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>הראשון יאמרו כשראו",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאחיו לקחה שעשה כן משום שלא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה לאחיו הראשון שום קנין בה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לפי שהקדושין נעשו על תנאי ולא השלימו התנאי נמצא שהקדושין בטלין למפרע וכדי שלא יאמרו כן דאשת איש יוצאה בלא גט",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מצריכה ר\"ע גט משני. וכן הדין באחות אשה דעל ידי קדושין בלא נשואין. ומתני' מיירי בנשואין <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>ואי אפשר לומר שנשאה בעלה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהלך בתנאי לפי שאם לא השלימו התנאי הוה עביד בעילתו בעילת זנות וליכא מאן דסבר כן אחר שלא שמענו בברור שהתנה",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ושנאמר מדעתנו שהתנה ושעושה בעילתו בעילת זנות ואם כן כשראו שזה הניחה כשבא בעלה על כרחם יאמרו שנשואי שניה זו שלקח",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אינם כלום שטעו שהיו סבורים שמת בעלה הלכך אפילו ר\"ע מודה בהא דמתני' דלא בעיא גט מיניה ואשתו של יצחק שבאה מותרת",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ליצחק דלא הויא אחות גרושתו ופסק הריא\"ף ז\"ל דהכי הלכתא דבנשואין אינה צריכה גט אבל מן האירוסין צריכה גט כר\"ע אף",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על גב דאיכא מאן דסבר דלעולם אחות אשתו ואשת אח ואשת איש שנשאת על פי ב\"ד צריכות גט מזה ומזה ומפני שיש להם היתר",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאחר איסורן דלא דמו לשאר עריות ואיכא למגזר שמא יאמרו בהיתר נשאת ויוצאה בלא גט ולא קא מפליג בין נשואין לאירוסין:",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תניא וכו' והלא הדין שתאסר.</b> ולהכי אצטריך אותה: <b>שאין האוסרה וכו'.</b> שיש לה היתר בגט: <b>נאסר האוסר.</b> נאסר בה. בעלה שהוא",
      "segment_ids": [
        14,
        15,
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אוסרה לאחרים אינו דין וכו' שתאסר אשתו האוסרת את אחותה לכך נאמר אותה. <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ב\" data-order=\"2\"></i>וא\"ת השתא לא מצריכין קרא דושכב איש אותה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא להתיר אשה זו לבעלה שלא תאסר אף על פי שאוסרת אחותה לבעלה והך איסור דאחותה בשוגג נעשה כדתנן במתניתין שאמרו לה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמת בעלה וגם ליצחק אמרו שמתה אשתו ובשוגג ליכא ק\"ו שיהא נאסר האוסר מק\"ו דאשת איש דמזיד הוא דאילו בשוגג לא נאסר",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "האוסר דמותרת היא לבעלה דכתיב והיא לא נתפשה הא נתפשה מותרת וא\"כ לישתוק קרא מיניה דלענין שוגג בלא קראו דושכב איש",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא נאסר האוסר בק\"ו לפי שבתחלה קודם שקדש זה לאחת מן האחיות הוא היה מותר בכל הנשים שבעולם והיא היתה מותרת בכל",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אנשים שבעולם קדשה הוא אסרה והיא אסרתו מרובה איסור שאסרה מאיסור שאסרתו שהוא אסרה בכל אנשים והיא אסרתו בקרובותיה",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והלא דין הוא ומה הוא שאסרה בכל אנשים שבעולם שגגה באסור לה לא נאסרה במותר לה דהיינו בעלה דהא נתפשה היא שלא אסרתו",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא בקרובותיה שגג באסור לו דהיינו אחות אשתו אינו דין שלא נאסר במותר לו דהיינו אשתו וא\"כ קרא למה לי וי\"ל",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאיצטריך קרא <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>למזיד דאי לאו קרא כיון דבמזיד נאסר במותר לו הוה גזרינן בשוגג דידיה כדין אשה שהלך בעלה למדינת הים",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאע\"ג דמדאורייתא כיון דשוגנ היא שריא לבעלה גזרו בה רבנן ואמרו תצא והיינו משום דבמזיד דידה אסורה מדאורייתא: <b>אמר</b>",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>רבי יהודה לא נחלקו ב\"ש וב\"ה וכו' שפסל את אשתו.</b> דדריש הכי קרא באש ישרפו אותו ואתהן וכי כל הבית כולו בשריפה אשתו",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מה חטאת אלא אם אינו ענין שיהיו שוות אתהן לשרפה תנהו ענין לאיסורא דלענין איסור נאמר אתהן שהשוה אותה ליה: <b>שבית</b>",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שמאי אומרים פסל.</b> מק\"ו שאמרנו לעיל ומה במקום שבא על איסור קל וכו' ואותה לא דרשי: <b>וב\"ה אומרים לא פסל.</b> דדרשי אותה:",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א\"ר יוסי וכו' שלא פסל את אשתו.</b> דדרשי אותה:",
      "segment_ids": [
        20
      ]
    }
  ],
