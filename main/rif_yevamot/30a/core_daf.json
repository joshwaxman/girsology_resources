      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פלוגתייהו כגון שקדש אחיו את האשה והלך",
      "segment_ids": [
