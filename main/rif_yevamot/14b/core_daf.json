    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלה או נתגרשה <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ב\" data-order=\"2\"></i>ומונים לגט",
