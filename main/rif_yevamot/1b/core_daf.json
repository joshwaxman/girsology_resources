  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עונש מנין.</b> אם יבם ערוה או צרתה וא\"ת היכן שנינו שיש עליהם עונש דקתני מנין וי\"ל דתנא קים ליה במילתא ואורחא הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בהכי: <b>תניא מאי ולקחה.</b> דכתיב ולקחה לו לאשה ומדלא כתיב ולקח משמע דשתים נפלו לו מאחיו וכששתים ראויות לו אז יקח אחת",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מהן דבית אחד הוא בונה ואין בונה שני בתים אבל אם אחת מהן ערוה עליו שתיהן פטורות וצרות צרותיהן נמי מהכא נפקי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמשנפלה לו צרת ערוה מאחיו הראשון ודחתה הערוה ממנו נאסרה עליו עולמית משום אשת אח וכשנתיבמה לאחיו השני ולו אשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחרת ומת וחזרה ונפלה לפני זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא קרינן ביה בזו שנאסרה עליו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולקחה הלכך תרוייהו אסירן וכן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעולם: <b>ונודעה החטאת כו'.</b> בפר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העלם דבר של צבור כתיב: <b>ונאמר</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>להלן עליה.</b> לגלות ערותה עליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא מופנה לדרשה מה להלן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באיסור כרת מיירי אף כאן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשהורו ב\"ד לצבור להתיר איסור",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרת מביאין פר: <b>האי סברא</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דרבי.</b> דאין מביאין פר אם הורו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדבר שיש בו לאו או עשה אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא אם טעו בדבר שזדונו כרת:",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תורה אחת.</b> לענין קרבן כתיב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרשת עבודת כוכבים: <b>תורה.</b> כל",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התורה במשמע: <b>הוקשה כל התורה.</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לענין קרבן: <b>לעבודת כוכבים מה</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ע\"כ <i data-commentator=\"Hagahot HaBach\" data-label=\"פ\" data-order=\"17\"></i>על דבר שזדונו כרת ושגגתו</b>",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חטאת.</b> כדכתיב התם והנפש אשר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תעשה ביד רמה אלמא כל הפרשה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדבר שזדונו כרת משתעי. אמר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המחבר כל זה ללא צורך כתבתי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא שרבינו אלפס האריך בו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפרש בהלכה זו לענין חלוק",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבנות כמו שכתוב בהלכותיו:",
      "segment_ids": [
        8
      ]
    }
  ],
