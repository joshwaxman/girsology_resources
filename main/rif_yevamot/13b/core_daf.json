  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דאזלא בהדה.</b> רש\"י ז\"ל ורי\"ף ז\"ל פירשוה באחותה דאזלא בהדה לבי דינא בעידן חליצה מפני הקורבה עושין לה צוות וסבורין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "העם שזו היא שנחלצה ואתי לאיחלופי בהדי הדדי ואי שרית לה לצרת אחותה סברי צרת חלוצה היא ואתי למשרי צרת חלוצה דעלמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אבל צרתה לא אזלה בהדה לבי דינא לפיכך לא אתו למטעי בה ולא גזרו רבנן באחותה וגמגמו מן המפרשים ז\"ל על פירוש זה:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>באיסורה קיימא.</b> חלוצה הוא דקיימא בלא יבנה ותו לא אבל צרתה קיימא עליה באיסור אשת אח בכרת והולד ממזר: <b>והא</b> דשמואל",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליתא דבפרק קמא גרסי' פלוגתא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דריש לקיש ורבי יוחנן בהחולץ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליבמתו וחזר וקדשה דאמר ריש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקיש דחייבין על צרתה כרת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ורבי יוחנן אמר אין חייבין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין הוא בין אחין לא על חלוצה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרת ולא על צרתה כרת דמי איכא",
      "segment_ids": [
