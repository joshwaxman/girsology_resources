      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Yevamot 108b:14\" data-ror-ocr=\"שניה. מלרבנן גזירה משוס אשמ אמי האב\">גזירה משום אשת אחי האב</i> <i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yevamot 108b:14\" data-ror-ocr=\"שהיא ערוה: מהו שהמאן. בנישואין\">שהיא ערוה:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yevamot 108b:14\" data-ror-ocr=\"שהיא ערוה: מהו שהמאן. בנישואין\">מהו שתמאן - בנישואין</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yevamot 108b:14\" data-ror-ocr=\"הראשונים שלא תהא השניה זקוקה לו:\">הראשונים שלא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yevamot 108b:14\" data-ror-ocr=\"הראשונים שלא תהא השניה זקוקה לו:\">תהא שנייה לו</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yevamot 108b:14\" data-ror-ocr=\"וססייבם צרהה. אבל באישות לערוה כגון\">ותתייבם. אבל באישות</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yevamot 108b:14\" data-ror-ocr=\"וססייבם צרהה. אבל באישות לערוה כגון\">דערוה כגון</i> <i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Yevamot 108b:14\" data-ror-ocr=\"אשת את מאמו קטנה ומת ונשאה אתיו\">אשת אחיו מאמו קטנה ומת</i>"
      },
