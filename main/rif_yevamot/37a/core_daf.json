        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מיאון דחבריה ומבטל גיטא דידיה ופריק רבי אלעזר תברא מי ששנה זו לא שנה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "זו ועולא אמר כגון <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>ששילשה בגיטין דמחזיא כגדולה ומשום הכי לא אתי מיאון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דחבריה ומבטיל גיטא דידיה ומאן <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בס\"י</i> <i class=\"footnote\">תנאי</i> <i class=\"footnote\">דאמר</i> <i class=\"footnote\">ר\"א</i> <i class=\"footnote\">ת\"ק</i> <i class=\"footnote\">ור'</i> <i class=\"footnote\">ישמעאל</i> <i class=\"footnote\">בר\"י</i>",
