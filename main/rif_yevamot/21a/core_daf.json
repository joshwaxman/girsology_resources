      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להוליד שהוא נאמן כדפרשינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעיל וי\"ל דהכא כיון שכבר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוליד אלא שהפילה ריע טענתיה",
      "segment_ids": [
