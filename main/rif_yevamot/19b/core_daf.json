  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב הטור ואין חילוק בין יש לו בנים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לשאין לו אלא לענין מכירת ס\"ת שלעולם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריך שישא אשה בת בנים אם יש ספק בידו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אפילו יש לו כמה בנים ואם אין ספק בידו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לישא אשה בת בנים אלא אם כן ימכור ס\"ת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אם אין לו בנים ימכור כדי שישא אשה בת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנים אבל אם יש לו בנים לא ימכור אלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ישא אשה שאינה בת בנים ולא יעמוד בלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אשה. וי\"א שאפילו אם יש לו בנים ימכור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ס\"ת כדי שישא אשה בת בנים ואין חילוק אם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יש לו בנים לשאין לו בנים אלא לענין נשא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אשה ושהה עמה י' שנים ולא ילדה שאם אין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו בנים חייב לגרשה כדי לקיים פריה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ורביה ואם יש לו בנים אינו חייב לגרשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אם אינה בת בנים וכך היא מסקנת הרא\"ש:",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לשון ריא\"ז</b> רבינו משה ביאר בפרק טו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מהלכות אישות שאף על פי שקיים אדם מצות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פריה ורביה הרי הוא מצוה מד\"ס שלא יבטל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מלפרות ולרבות כל זמן שיש בו כח וכבר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ביארתי בקונטרס הראיות מכח שיטת התלמוד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין הלכה כן אלא הואיל וקיים אדם פריה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ורביה רשאי ליבטל ולישא אשה שאינה בת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנים אבל לעמוד בלא אשה כל עיקר אסור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנאמר לא טוב היות האדם לבדו וכן לא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תעמוד אשה בלא איש שלא תחשד כמבואר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בתוספתא ומותר אדם למכור ס\"ת שלו כדי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לישא אשה ואם קיים פריה ורביה ומוצא אשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאינה בת בנים לא ימכור ס\"ת לישא אשה בת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנים: <b>ב</b> צ\"ע היכא שנודע לנו שהוליד בן",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממזר ונשא אשה והוליד בן בכור אי הוי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בכור לנחלה או לאו: <b>ג</b> ובני בנים הרי הן",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        4,
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כבנים ובת בנו שמת הרי היא במקום בנו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכל שכן בן בתו שמתה שהוא במקום בתו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומכל מקום צריך שיוליד הוא תחלה זכר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונקבה ואע\"פ שמתו ונשארו להם ב' בנות",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחת מזה ואחת מזו קיים פריה ורביה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בקונטרס הראיות: <b>ד</b> מיי' לא הזכיר",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        7,
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שישיבת חו\"ל אינה ממנין י' שנים נראה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דפליג אמנם סמג כתב דרש\"י ומיי' ורבינו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כלהו שוים דשהה עשר שנים אף בחו\"ל יוציא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וסמג פליג וסבר דלא יוציא וצ\"ע מנא ליה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לסמג שיהיה דעת רבינו כן: כ' הרא\"ש י\"א",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבחו\"ל אין כופין להוציא אחר עשר שנים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דתלינן בעונש דירתו בחו\"ל כדחזינן",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באברהם שישיבת חו\"ל לא עלתה לו מן המנין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא מסתבר לטור להורות כן שיבטל אדם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מפריה ורביה בסברא רעועה כזאת דהא חזינן",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רובא דאינשי שפרים ורבין בחו\"ל ומה שלא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עלתה לאברהם ישיבת חו\"ל לפי שצוהו הקב\"ה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        11
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
