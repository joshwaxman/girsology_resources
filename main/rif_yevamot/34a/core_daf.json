  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> וכ\"כ מיי' כרבינו והרא\"ש כתב דאפילו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשותתת אינה צריכה לרוק פעם אחר: <b>ב לשון</b>",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> רקקה בלבד בבית דין לפני היבם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נפסלה על האחין ואפילו רקקה דם לפי שא\"א",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לדם בלא צחצוחי רוק והוא שמוצצת ורוקקת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בדרך רקיקה אבל אם היה דם שותת וירד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מפיה אין חוששין בו משום רקיקה: כתב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סמ\"ג מכאן אתה למד שמה שאנו מצריכים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שתחלוץ בימינה זהו מדברי סופרים: חליצת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חרש וחרשת אלם ואלמת פסולה ופוסלת אבל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שוטה וקטן אין חליצתן כלום אפילו לפסול",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על האחים והרא\"ש השוה חליצת קטנה לחליצת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קטן: <b>ג לשון ריא\"ז</b> החרש שנחלץ או החרשת",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שחלצה חליצתה פסולה וכן אלם ואלמת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
