      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הים משום דאית לה גט מזה ומזה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא דאמרינן תצא מזה ומזה",
      "segment_ids": [
