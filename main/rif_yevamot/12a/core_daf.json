  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני'</big></b> <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Marriage\" data-label=\"⚬\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>שומרת <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>יבם שנפלו לה נכסים מודים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית שמאי וב\"ה שמוכרת ונותנת וקיים מתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>מה יעשו בכתובתה ובנכסים הנכנסין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והיוצאים עמה בית שמאי אומרים יחלוקו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יורשי הבעל עם יורשי האב <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>וב\"ה אומרים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נכסים בחזקתן כתובה בחזקת יורשי הבעל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונכסים הנכנסין והיוצאין עמה בחזקת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יורשי האב",
      "segment_ids": [
