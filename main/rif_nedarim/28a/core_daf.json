  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "top": 60.0,
      "text": "עיקר טענתם אלא על הכתובה קים ליה לבעל בטענתה ומכחיש לה בברי ואמר דמינה הוא ולית לה כתובה וידע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "top": 82.8,
      "text": "ודאי דשקרא טענה עליה דינא הוא דבעל מהימן גבי כתובה דהמוציא מחבירו עליו הראיה וליכא למימר הכא חזקה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "top": 105.5,
      "text": "אין אשה מעיזה פניה דהא איהו דמפיק לה ואיהי לא תבעה גירושין והויא הך טענה דידה כשאר כל תביעות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "top": 128.2,
      "text": "דעלמא דליכא למימר בהו חזקה אינה מעיזה פירוש וכאילו אין בידה כתובה וטוען שפרעה והיא טוענת שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "top": 151.0,
      "text": "נתפרעה דלא מהימנא בחזקה זו שאינה מעיזה פניה וכן הדין בשטוענת עליו שאינו בא עליה והוא מכחישה שאינה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 173.8,
      "text": "נאמנת כיון שהוא בא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 196.5,
      "text": "להוציאה אבל כי לא קים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 219.2,
      "text": "ליה ביעל במילתא ואיהי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 242.0,
      "text": "קים לה כגון יורה כחץ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 264.8,
      "text": "בהא אמר רבי אמי דכיון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 287.5,
      "text": "דאיהו אתי לאפוקה דלדידה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 310.2,
      "text": "דאתיא בברי הימנוה רבנן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 333.0,
      "text": "דלאו כל כמיניה לאפסודה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 355.8,
      "text": "איהו בכתובה בטענת שמא.",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 378.5,
      "text": "הדין הוא פירוקא דהא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 401.2,
      "text": "שמעתתא ופירוקא תריצא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 424.0,
      "text": "ומעליא הוא ובהכי סליק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 446.8,
      "text": "פירקא. וסליק לה מסכת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "0px",
      "left": "698px",
      "top": 469.5,
      "text": "ברחמי שמיא:",
      "segment_ids": [
        0
      ]
    }
  ],
  "tosafot": [
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 177.8,
      "text": "לה ובכתובה הוא דפליגי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 198.6,
      "text": "כיון דאיהו לא קים ליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 219.5,
      "text": "ואיהי קים לה הויא ליה ברי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 240.4,
      "text": "ושמא וברי עדיף: [דף צא.]",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 261.2,
      "text": "ההיא אתתא דכל יומא דתשמיש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 282.1,
      "text": "כי מקדמה וכו' (ד) בבא לי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 303.0,
      "text": "בבא. במסך שלפני הדלת והא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 323.9,
      "text": "דאצטרכינן להני טעמי לאו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 344.8,
      "text": "למימרא דבלאו הכי איתתא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 365.6,
      "text": "אסירא דליתא דאין האשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 386.5,
      "text": "נאסרת על בעלה אלא בקינוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 407.4,
      "text": "וסתירה או בכדי דבר ברור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 428.2,
      "text": "ואין בית דין מוציאין אותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 449.1,
      "text": "מבעלה אפילו באמתלאות ודבר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 470.0,
      "text": "מכוער וההיא דאמרינן התם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 490.9,
      "text": "(יבמות דף כד.) רוכל יוצא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 511.8,
      "text": "ואשה חוגרת בסינר וכו' תצא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 532.6,
      "text": "כבר פירשו שם ז\"ל דתצא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 553.5,
      "text": "מנטען קאמר א\"נ דלמדת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 574.4,
      "text": "חסידות תצא ותטול כתובה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 595.2,
      "text": "מעתה הא דאמרינן בהני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 616.1,
      "text": "עובדי דאמרינן אם איתא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 637.0,
      "text": "דעבד איסורא וכו'. דמשמע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 657.9,
      "text": "דאי לאו הכי איתתא אסירא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 678.8,
      "text": "כולן למדת חסידות ולמי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 699.6,
      "text": "שלבו נוקפו שכל המדקדק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 720.5,
      "text": "בדברים אלו ביראת שמים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 741.4,
      "text": "נקרא קדוש ותבא עליו ברכה.",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 762.2,
      "text": "המברך עמו יברכנו ויאמר די",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 783.1,
      "text": "לצרותינו והוא יצליחנו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 804.0,
      "text": "בתורתו התמימה לשמה. נזכה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 824.9,
      "text": "בבנין אריאל בקרב כל ישראל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 845.8,
      "text": "אמן סליק פירקא וסליקא לה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "232px",
      "right": "698px",
      "left": "0px",
      "top": 866.6,
      "text": "מסכת נדרים",
      "segment_ids": [
        2
      ]
    }
  ],
