    },
    {
      "right": "275px",
      "width": "380px",
      "text": "וְהִלְכְתָא <span class=\"name-reference-marker name-reference-amora\" data-sage-type=\"amora\" title=\"Rav Huna This name is ambiguous; click to compare candidates\" data-full-name=\"Rav Huna\" data-name-he=\"רַב הוּנָא\" data-ambiguous-key=\"rav-huna-ambiguous\" data-ambiguous-name-he=\"רַב הוּנָא\" data-ambiguous-name-en=\"Rav Huna\" data-ambiguous-candidate-ids=\"895,898\">כְּרַב הוּנָא</span>. <span class=\"sentence\" id=\"8\" type=\"start\">&star;</span>לָמָּה עוֹקְרִין אֶת הַשּׁוּלְחָן?",
      "segment_ids": [
        8
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "אָמְרִי דְּבֵי <span class=\"name-reference-marker name-reference-amora\" data-sage-type=\"amora\" title=\"Rabbi Yannai, son II, first-generation II Amora\" data-authority-id=\"1814\" data-full-name=\"Rabbi Yannai, son II\" data-name-he=\"רבי ינאי רבה\">רַבִּי יַנַּאי</span>: כְּדֵי שֶׁיַּכִּירוּ תִּינוֹקוֹת",
      "segment_ids": [
        8
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "וְיִשְׁאֲלוּ. <span class=\"name-reference-marker name-reference-amora\" data-sage-type=\"amora\" title=\"Abaye, fourth-generation Amora\" data-authority-id=\"121\" data-full-name=\"Abaye\" data-name-he=\"אביי\">אַבָּיֵי</span> הֲוָה יָתֵיב קַמֵּיהּ <span class=\"name-reference-marker name-reference-amora\" data-sage-type=\"amora\" title=\"Rabba bar Naḥmani, third-generation Amora\" data-authority-id=\"2581\" data-full-name=\"Rabba bar Naḥmani\" data-name-he=\"רַבָּה בַּר נַחְמָנִי\">דְּרַבָּה</span>, חֲזָא",
      "segment_ids": [
        8
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "דְּקָא מַדְלִי תַּכָּא מִקַּמֵּיהּ, אֲמַר לְהוּ: עֲדַיִין לָא",
      "segment_ids": [
        8
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "קָא אָכְלִינַן, אָתוּ קָא מְעַקְּרִי תַּכָּא מִיקַּמַּן?!",
      "segment_ids": [
        8
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "אֲמַר לֵיהּ <span class=\"name-reference-marker name-reference-amora\" data-sage-type=\"amora\" title=\"Rabba bar Naḥmani, third-generation Amora\" data-authority-id=\"2581\" data-full-name=\"Rabba bar Naḥmani\" data-name-he=\"רַבָּה בַּר נַחְמָנִי\">רַבָּה</span>: פְּטַרְתַּן מִלּוֹמַר ״מָה נִּשְׁתַּנָּה״<span class=\"sugya-marker sugya-marker-vilna-piska\" data-sugya-kind=\"vilna-piska\" data-sugya-id=\"419\" data-raw-symbol=\"׃\">׃</span>",
      "segment_ids": [
        8
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "<span class=\"sugya-marker sugya-marker-steinsaltz\" data-sugya-kind=\"steinsaltz\" data-sugya-id=\"515\" data-sentence-id=\"9\" data-steinsaltz-label=\"ג\"></span> <span class=\"sentence\" id=\"9\" type=\"start\">&star;</span>אָמַר <span class=\"name-reference-marker name-reference-amora\" data-sage-type=\"amora\" title=\"Shmuel II, first-generation Amora\" data-authority-id=\"2763\" data-full-name=\"Shmuel II\" data-name-he=\"שמואל\">שְׁמוּאֵל</span>: ״לֶחֶם עוֹנִי״ כְּתִיב — לֶחֶם",
      "segment_ids": [
        9
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "שֶׁעוֹנִין עָלָיו דְּבָרִים. תַּנְיָא נָמֵי הָכִי: ״לֶחֶם עוֹנִי״ —",
      "segment_ids": [
        9
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "לֶחֶם שֶׁעוֹנִין עָלָיו דְּבָרִים הַרְבֵּה. דָּבָר אַחֵר:",
      "segment_ids": [
        9
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "״לֶחֶם עוֹנִי״ — ״עֹנִי״ כְּתִיב, מָה עָנִי שֶׁדַּרְכּוֹ בִּפְרוּסָה,",
      "segment_ids": [
        9
      ]
    }
  ],
  "rashi": [
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "<b>צְרִיךְ לְשַׁקּוֹעֵיהּ בַּחֲרוֹסֶת, מִשּׁוּם קָפָא</b> ארס שבחזרת שהשרף שבחזרת",
      "source_ref": "Rashi on Pesachim 115b:1:1",
      "gemara_segment_ids": [
        0
      ],
      "work": "rashi"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "יש בו ארס כדרך הבצלים: <b>הָא לָא נָגַע</b> ידו במשקה: <b>הא</b> <b>בעלמא</b>",
      "source_ref": "Rashi on Pesachim 115b:1:2",
      "gemara_segment_ids": [
        0
      ],
      "work": "rashi"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "<b>אִיתְּמַר</b> בשאר טיבולין שאינן קבע צריך שיטול ידיו לטיבול דכשנטל",
      "source_ref": "Rashi on Pesachim 115b:3:1",
      "gemara_segment_ids": [
        2
      ],
      "work": "rashi"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "ידיו לראשון לא היה יודע שסוף שני לבוא: <b>דְּאִי <span class=\"dh-divergent\">ס&quot;ד</span> הָכָא.</b> גבי",
      "source_ref": "Rashi on Pesachim 115b:3:2",
      "gemara_segment_ids": [
        2
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "מרור איתמר אמאי הא משי ליה חדא",
      "source_ref": "Rashi on Pesachim 115b:3:2",
      "gemara_segment_ids": [
        2
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "זמנא בטיבול ראשון: <b>אַסְּחֵיהּ לְדַעְתֵּיהּ</b>",
      "source_ref": "Rashi on Pesachim 115b:5:1",
      "gemara_segment_ids": [
        4
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>וּנְגַע</b> בבשרו: <b>בלע</b> <b>מצה.</b> ולא לעסה",
      "source_ref": "Rashi on Pesachim 115b:5:1",
      "gemara_segment_ids": [
        4
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "יצא: <b>בָּלַע מָרוֹר לֹא יָצָא</b> אפשר",
      "source_ref": "Rashi on Pesachim 115b:6:2",
      "gemara_segment_ids": [
        5
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "שלא טעם בו טעם מרור: <b>בָּלַע מַצָּה</b>",
      "source_ref": "Rashi on Pesachim 115b:6:3",
      "gemara_segment_ids": [
        5
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>וּמָרוֹר.</b> יחד ולא אכל עדיין לא מזה",
      "source_ref": "Rashi on Pesachim 115b:6:3",
      "gemara_segment_ids": [
        5
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "ולא מזה יצא ידי מצה שאינה צריכה",
      "source_ref": "Rashi on Pesachim 115b:6:3",
      "gemara_segment_ids": [
        5
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "טעם אבל ידי מרור לא יצא הואיל",
      "source_ref": "Rashi on Pesachim 115b:6:3",
      "gemara_segment_ids": [
        5
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "ולא לעסו ואוכל מצה עמו אין לו שום",
      "source_ref": "Rashi on Pesachim 115b:6:3",
      "gemara_segment_ids": [
        5
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "טעם: <b>כְּרָכָן.</b> שניהם יחד בסיב",
      "source_ref": "Rashi on Pesachim 115b:6:4",
      "gemara_segment_ids": [
        5
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "הדקל לא יצא שהרי לא היה ממש",
      "source_ref": "Rashi on Pesachim 115b:6:4",
      "gemara_segment_ids": [
        5
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "בפיו לא זה ולא זה: <b>וְאֵין עוֹקְרִין</b>",
      "source_ref": "Rashi on Pesachim 115b:7:1",
      "gemara_segment_ids": [
        6
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>אֶת הַשֻּׁלְחָן.</b> א\"צ להגביה קערה",
      "source_ref": "Rashi on Pesachim 115b:7:1",
      "gemara_segment_ids": [
        6
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "כשמתחיל הגדה אלא מלפני הגדול",
      "source_ref": "Rashi on Pesachim 115b:7:1",
      "gemara_segment_ids": [
        6
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "שבהן שעושה הסדר ואומר ההגדה:",
      "source_ref": "Rashi on Pesachim 115b:7:1",
      "gemara_segment_ids": [
        6
      ],
      "work": "rashi"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "רשב\"ם",
      "work": "rashbam",
      "kind": "rubric"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>צריך</b> <b>לשקועיה</b> <b>בחרוסת</b> <b>משום</b> <b>קפא.</b>",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "ארס שחזרת יש בו ארס כדרך",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "הבצלים והלכך צריך נט\"י לטיבול ראשון",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "כדלקמן שהרי נוגע במשקין כשמשקע",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "את החזרת בחרוסת ור\"ח פירש קפא",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "תולעת דתניא בתרומות התולעים",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "שבעיקרי אילנות ואת הקפא שבירק",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "יבחושין שבחומץ ושביין מותרין סיננם",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "במסננת אסורין דכיון דפריש ממקום",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "רביתיה הוי ליה כשרץ השורץ על",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "הארץ כדאמר בשילהי אלו טריפות",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "(<a href=\"/chullin/67b\">חולין דף סז:</a>) ועיקר: <b>הא</b> <b>לא</b> <b>נגע.</b> ידו",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "במשקה: <b>אגב</b> <b>חולייה.</b> שנותנין בו",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "תפוחין כדמוכח לקמן זכר לתפוח:",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>לטיבול</b> <b>ראשון.</b> של שאר ירקי: <b>לטיבול</b>",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>שני.</b> חזרת: <b>הא</b> <b>בעלמא</b> <b>איתמר.</b>",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "בשאר טיבולין שבשאר ימות השנה",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "שאינן קבע וכשנוטל ידיו לראשון לא",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "היה יודע שסוף שני לבוא והסיח",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "דעתו: <b>דאי</b> <b>ס\"ד</b> <b>הכא.</b> גבי מרור",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "איתמר אמאי הא משא ליה ידיה חדא",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "זמנא בטיבול ראשון <b>אסחיה</b> <b>לדעתיה.</b>",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "ונגע בשום דבר טינוף: <b>בלע</b> <b>מצה.</b>",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "ולא לעסה יצא שהרי קיים בערב",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "תאכלו מצות (<a href=\"https://www.sefaria.org/Exodus.12.18\" target=\"_blank\" rel=\"noopener noreferrer\" data-sefaria-ref=\"Exodus.12.18\">שמות י״ב:י״ח</a>) שהרי אכילה",
      "work": "rashbam"
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "היא לו ומיהו לכתחלה טעם מצה",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "בעינן: <b>בלע</b> <b>מרור</b> <b>לא</b> <b>יצא.</b> דבעינן טעם מרור וליכא דמשום הכי",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "קפיד רחמנא למרר את פיו של אוכל זכר לוימררו את חייהם (שם א)",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "כך מצאתי כתוב בכל הספרים ובפי' ר\"ח ורבינו פי' בלע מרור יצא",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "א\"א שלא יהא בו טעם מרור בלע מצה ומרור יחד ולא אכל עדיין",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "לא מזה ולא מזה ידי מצה יצא ידי מרור לא יצא הואיל ולא לעסו",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "ואכל מצה עמו אין לו שום טעם ולפי הכתוב בספרים צריך לפרש",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "בלע מצה ומרור ידי מצה מיהו יצא דלא תימא אף ידי מצה לא יצא",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "דאיכא תרתי לריעותא שלא טעם טעם מצה וגם לא נגע בגרונו שהמרור",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "חוצץ בינתיים: <b>כרכן.</b> שניהן יחד בסיב הגדל סביב הדקל לא יצא שהרי",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "לא היה ממש בפיו לא זה ולא זה וכזורק אבן לחמת דמי <b>מצה</b> <b>לפני</b> <b>כל</b>",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "<b>אחד</b> <b>ואחד.</b> מנהג שלהן היה להסב על המטות והיה שלחן לפני כל אחד",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "ואחד הלכך צריך מצה ומרור לפני כל אחד ואחד על שולחנו אבל לדידן",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "אין צריך כי אם לפני מי שעושה הסדר והוא יחלק לכל אחד מצה ומרור:",
      "work": "rashbam"
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "<b>ואין</b> <b>עוקר</b> <b>את</b> <b>השלחן.</b> שמצוה היא לעקור את השלחן כדלקמן כי היכי",
      "work": "rashbam"
    },
    {
      "width": "930px",
      "right": "",
      "left": "0px",
      "text": "דליהוי הכירא לתינוקות וה\"מ לדידיהו דהוי להו שלחן קטן לפני מי שאומר הגדה לבדו וכן לכל אחד אבל אנו מסלקין את הקערה שבה מצה",
      "work": "rashbam"
    },
    {
      "width": "930px",
      "right": "",
      "left": "0px",
      "text": "ומרור ושני תבשילין לסוף השלחן ודי לנו בכך ויש שנוהגין להגביה את הקערה על הכף ומוציאין הבשר מן הקערה ולאו מלתא היא דהא",
      "work": "rashbam"
    },
    {
      "width": "930px",
      "right": "",
      "left": "0px",
      "text": "דאמר לקמן בשר אין צריך להגביה ה\"מ בשעה שאומר הגדה פסח שהיו אבותינו כו' וכיון דלא מצי למימר פסח זה אם היה מגביהו לתבשיל",
      "work": "rashbam"
    },
    {
      "width": "930px",
      "right": "",
      "left": "0px",
      "text": "שהיה בידו נראה כמקדיש בהמתו מחיים אבל כשמגביה הקערה כדי שיכיר תינוק וישאל היאך נראה כמקדיש קדשים לפיכך אין צריך",
      "work": "rashbam"
    },
    {
      "width": "930px",
      "right": "",
      "left": "0px",
      "text": "להוציא ממנה התבשיל וגם הגבהתה חנם ואין כאן היכר לתינוק אבל עוקרין הקערה לגמרי ויניחנה בקרן זוית כאילו כבר אכלו כדי שיכיר",
      "work": "rashbam"
    },
    {
      "width": "930px",
      "right": "",
      "left": "0px",
      "text": "התינוק וישאל דדמי לעקירת שלחן: <b>פטרתן</b> <b>מלומר</b> <b>מה</b> <b>נשתנה.</b> דתניא לקמן חכם בנו שואלו ואם לאו שואל הוא לעצמו מה נשתנה וכיון",
      "work": "rashbam"
    },
    {
      "width": "930px",
      "right": "",
      "left": "0px",
      "text": "ששאלו לנו מה נשתנה אין אנו צריכין לומר מה נשתנה אלא להשיב על דבריו (של בנו) לפי שנשתעבדנו במצרים אנו עושין כל הדברים הללו:",
      "work": "rashbam"
    }
  ],
