    {
      "id": 1,
      "marker_letter": "ב",
      "line_number": 2,
      "content": {
        "html": "<p><big><b>קלז</b></big> <cite id=\"fn_ב\" style=\"font-style:normal;\"><b><a href=\"#fn_ב_back\">ב</a></b> </cite> <a href=\"/wiki/%D7%A8%D7%9E%D7%91%22%D7%9D_%D7%94%D7%9C%D7%9B%D7%95%D7%AA_%D7%A9%D7%9B%D7%99%D7%A8%D7%95%D7%AA_%D7%99\" title='רמב\"ם הלכות שכירות י'>מיי' פ\"י מהל' שכירות</a> <a href=\"/wiki/%D7%A8%D7%9E%D7%91%22%D7%9D_%D7%94%D7%9C%D7%9B%D7%95%D7%AA_%D7%A9%D7%9B%D7%99%D7%A8%D7%95%D7%AA_%D7%99_%D7%91\" title='רמב\"ם הלכות שכירות י ב'>הלכה ב'</a>, <a href=\"/wiki/%D7%A1%D7%9E%22%D7%92_%D7%A2%D7%A9%D7%94_%D7%A4%D7%98\" title='סמ\"ג עשה פט'>סמ\"ג עשין פט</a>, <a href=\"/wiki/%D7%98%D7%95%D7%A8_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A7%D7%A2%D7%95\" title=\"טור חושן משפט קעו\">טור</a> ו<a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A7%D7%A2%D7%95\" title=\"שולחן ערוך חושן משפט קעו\">שו\"ע חו\"מ סי' קע\"ו</a><a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A7%D7%A2%D7%95_%D7%97\" title=\"שולחן ערוך חושן משפט קעו ח\"> סעיף ח'</a>, ו<a href=\"/wiki/%D7%98%D7%95%D7%A8_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A9%D7%94\" title=\"טור חושן משפט שה\">טור</a> ו<a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A9%D7%94\" title=\"שולחן ערוך חושן משפט שה\">שו\"ע חו\"מ סי' ש\"ה</a><a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A9%D7%94_%D7%95\" title=\"שולחן ערוך חושן משפט שה ו\"> סעיף ו'</a>, ו<a href=\"/wiki/%D7%98%D7%95%D7%A8_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A9%D7%9E%D7%95\" title=\"טור חושן משפט שמו\">טור</a> ו<a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A9%D7%9E%D7%95\" title=\"שולחן ערוך חושן משפט שמו\">שו\"ע חו\"מ סי' שמ\"ו</a><a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A9%D7%9E%D7%95_%D7%94\" title=\"שולחן ערוך חושן משפט שמו ה\"> סעיף ה'</a> <a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%97%D7%95%D7%A9%D7%9F_%D7%9E%D7%A9%D7%A4%D7%98_%D7%A9%D7%9E%D7%95_%D7%97\" title=\"שולחן ערוך חושן משפט שמו ח\">וסעיף ח</a>:\n</p>",
        "text": "קלז ב מיי' פ\"י מהל' שכירות הלכה ב' , סמ\"ג עשין פט , טור ו שו\"ע חו\"מ סי' קע\"ו סעיף ח' , ו טור ו שו\"ע חו\"מ סי' ש\"ה סעיף ו' , ו טור ו שו\"ע חו\"מ סי' שמ\"ו סעיף ה' וסעיף ח :",
