  "vilna_piskaot": [
    {
      "id": 479,
      "symbol": "׃",
      "raw_symbol": "׃",
      "line_number": 10
    },
    {
      "id": 480,
      "symbol": "׃",
      "raw_symbol": "׃",
      "line_number": 11
    },
    {
      "id": 481,
      "symbol": "׃",
      "raw_symbol": "׃",
      "line_number": 17
    },
    {
      "id": 482,
      "symbol": "׃",
      "raw_symbol": "׃",
      "line_number": 28,
      "mishnah_ref": "Bava Batra 140b",
      "mishnah_href": "/bava_batra/140b#gemara-line-23",
      "mishnah_line_number": 23,
      "quote_text": "״אִם זָכָר – מָנֶה, אִם נְקֵבָה – מָאתַיִם״, וְיָלְדָה זָכָר וּנְקֵבָה – זָכָר נוֹטֵל מָנֶה, נְקֵבָה נוֹטֶלֶת מָאתַיִם. יָלְדָה טוּמְטוּם – אֵינוֹ נוֹטֵל. אִם אָמַר: ״כֹּל מַה שֶּׁתֵּלֵד אִשְׁתִּי, יִטּוֹל״ – הֲרֵי זֶה יִטּוֹל. וְאִם אֵין שָׁם יוֹרֵשׁ אֶלָּא הוּא – יוֹרֵשׁ אֶת הַכֹּל"
    }
  ],
