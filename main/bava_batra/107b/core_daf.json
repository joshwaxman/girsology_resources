  "tosafot": [
    {
      "width": "450px",
      "right": "0px",
      "left": "",
      "text": "<big><b>דְּמִתּוֹרַת מָנֶה לָא מַפְּקִי לֵיהּ.</b></big> וליכא למימר דניזיל בתר בתראי",
      "source_ref": "Tosafot on Bava Batra 107b:5:1",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "70px",
      "left": "",
      "text": "דלא גרעי ממנה! דיש לתפוס המועט כדפ''ה.",
      "source_ref": "Tosafot on Bava Batra 107b:5:1",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "450px",
      "right": "0px",
      "left": "",
      "text": "<big><b><span class=\"dh-divergent\">מסתייה</span> דְּקָא <span class=\"dh-divergent\">טפינא</span> כּוּלֵּי הַאי אַחַבְרַאי.</b></big> שכן הסדר דשנים",
      "source_ref": "Tosafot on Bava Batra 107b:6:1",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "310px",
      "right": "140px",
      "left": "",
      "text": "הפוחתים מדברים תחלה.",
      "source_ref": "Tosafot on Bava Batra 107b:6:1",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>אַדְּרַבָּה! הַאי אַרְעָא מְאָה</b></big>",
      "source_ref": "Tosafot on Bava Batra 107b:7:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>ותליסר ותילתא שויא</b></big>.",
      "source_ref": "Tosafot on Bava Batra 107b:7:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "תימה לר''י דהשתא אי לא הוי אלא",
      "source_ref": "Tosafot on Bava Batra 107b:7:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "תרי דחד אמר מנה וחד אמר שלשים",
      "source_ref": "Tosafot on Bava Batra 107b:7:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "הוה אמינא דמאה ועשרה שויא דכן",
      "source_ref": "Tosafot on Bava Batra 107b:7:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "האמת נראה לכ''ע, והשתא דאיתיה",
      "source_ref": "Tosafot on Bava Batra 107b:7:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "להאי דפחות מכולהו אמר תלתא",
      "source_ref": "Tosafot on Bava Batra 107b:7:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "ותילתא הוי טפי:",
      "source_ref": "Tosafot on Bava Batra 107b:7:1",
      "gemara_segment_ids": [
        1
      ]
    }
  ],
  "ein_mishpat_markers": [
