  "tosafot": [
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>דִּלְמָא בִּתְרֵי בֵּי דִינָא אִיתְּקוּן.</b></big>",
      "source_ref": "Tosafot on Bava Batra 131b:2:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "160px",
      "right": "90px",
      "left": "",
      "text": "פירוש דספיקא הוי אי",
      "source_ref": "Tosafot on Bava Batra 131b:2:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "אמר בבריא אי לא. ולר''י נראה",
      "source_ref": "Tosafot on Bava Batra 131b:2:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "דבבריא נמי אמר מדאמר רבי נתן",
      "source_ref": "Tosafot on Bava Batra 131b:2:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "שניתם משנתכם כר' יוחנן בן ברוקה:",
      "source_ref": "Tosafot on Bava Batra 131b:2:1",
      "gemara_segment_ids": [
        0
      ]
    }
  ],
