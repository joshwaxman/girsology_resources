  "tosafot": [
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "<big><b>וּבָא בַּעַל חוֹב <span class=\"dh-divergent\">וטרף</span> חֶלְקוֹ שֶׁל אֶחָד מֵהֶן.</b></big> וא''ת היאך טרף כל",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "390px",
      "right": "",
      "left": "0px",
      "text": "חלקו של אחד מהן הא כולן חייבין לפרוע חוב אביהן ויטול",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "מכל אחד חלקו המגיעו כדתניא ביש נוחלין (<a href=\"/bava_batra/124a\">לקמן דף קכד.</a>) יצא עליהן",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "שטר חוב בכור נותן פי שנים. וי''ל דהכא מיירי כגון דעשאו אפותיקי.",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "ולא כאפותיקי דהמקבל (<a href=\"/bava_batra/110b\">ב&#x27;&#x27;מ דף קי:</a>)",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "דקאמר התם שאינו יכול לסלקו",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "בזוזי. דא''כ לרב אסי אמאי נוטל",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "רביע במעות דמשמע דהוי מצי",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "לסלוקי לבעל חוב בזוזי:",
      "source_ref": "Tosafot on Bava Batra 107a:1:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<big><b>רַב אָמַר: בָּטְלָה מַחְלוֹקֶת.</b></big> משמע",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "210px",
      "right": "",
      "left": "0px",
      "text": "דאי בעי לסלוקי בזוזי לא מצי.",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "ולהכי נמי מפרש טעמא דרב דיורשין",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "הוו דאי כלקוחות באחריות הוו אמאי",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "בטלה מחלוקת הא מצי לסלוקי בזוזי!",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "ותימה דמאי שנא מדרב אסי דאותו",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "רביע שהוא נוטל מכח יורשין קאמר",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "רב אסי דיכול לסלקו במעות! ושמא",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "פליגי רב ורב אסי בסברא זו דאפי'",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "אי כיורשין הוו מצי לסלוקי בזוזי",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "לרב אסי משום דאמר ליה אנא",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "לבעל חוב נמי מסליקנא בזוזי ורב",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "אינו חושש לאותה סברא. וא''ת מ''מ",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "יתן לו מעות ויפדה הקרקע מיד",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "בעל חוב דקי''ל בהמפקיד (<a href=\"/bava_batra/35a\">שם דף לה.</a>)",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "דשומא הדרא לעולם! וי''ל דנפקא",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "מינה היכא דזבנה או אורתה",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "דאמר התם דלא הדרא.",
      "source_ref": "Tosafot on Bava Batra 107a:2:1",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<big><b><span class=\"dh-divergent\">ורב</span> אַסִּי מְסַפְּקָא לֵיהּ אִי <span class=\"dh-divergent\">כיורשין</span></b></big>",
      "source_ref": "Tosafot on Bava Batra 107a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "190px",
      "right": "",
      "left": "0px",
      "text": "<big><b>דמי אי כלקוחות דמי</b></big>. ופירש",
      "source_ref": "Tosafot on Bava Batra 107a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "הקונט' שלא באחריות. ותימה לרשב''א",
      "source_ref": "Tosafot on Bava Batra 107a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "מנא ליה הא דילמא ודאי לאו כיורשין",
      "source_ref": "Tosafot on Bava Batra 107a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "דמו אלא מספקא אי כלקוחות",
      "source_ref": "Tosafot on Bava Batra 107a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "באחריות דמו או שלא באחריות דמו! לכך נראה כפירוש שני",
      "source_ref": "Tosafot on Bava Batra 107a:3:1",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "שבקונטרס. <big><b>וְהִלְכְתָא: בָּטְלָה מַחְלוֹקֶת.</b></big> הכא משמע דקי''ל",
      "source_ref": "Tosafot on Bava Batra 107a:4:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "450px",
      "right": "",
      "left": "0px",
      "text": "דיש ברירה מדפסקינן כרב ובסוף השולח (<a href=\"/gittin/48a\">גיטין דף מח.</a>) פירשתי:",
      "source_ref": "Tosafot on Bava Batra 107a:4:1",
      "gemara_segment_ids": [
        6
      ]
    }
  ],
