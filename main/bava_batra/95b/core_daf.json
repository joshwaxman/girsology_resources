  "tosafot": [
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>חַד אָמַר: מְקַבֵּל.</b></big> תימה לדידיה",
      "source_ref": "Tosafot on Bava Batra 95b:5:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "210px",
      "right": "40px",
      "left": "",
      "text": "אמאי מוקי רב זביד מתניתין",
      "source_ref": "Tosafot on Bava Batra 95b:5:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "כר' אושעיא ובדאמר ליה מרתף זה",
      "source_ref": "Tosafot on Bava Batra 95b:5:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "של יין אני מוכר לך וא\"ל למקפה?",
      "source_ref": "Tosafot on Bava Batra 95b:5:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "לוקי מתני' בלא א\"ל למקפה ובדאמר",
      "source_ref": "Tosafot on Bava Batra 95b:5:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "ליה מרתף של יין סתם. <big><b>וְחַד אָמַר</b></big>",
      "source_ref": "Tosafot on Bava Batra 95b:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>לא מקבל</b></big>. קשה לרשב\"א א\"כ אמאי",
      "source_ref": "Tosafot on Bava Batra 95b:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "נקט ר' חייא לעיל המוכר חבית של",
      "source_ref": "Tosafot on Bava Batra 95b:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "יין לחבירו נותן לו יין שכולו יפה",
      "source_ref": "Tosafot on Bava Batra 95b:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "מאי איריא חבית אפי' מרתף נמי!",
      "source_ref": "Tosafot on Bava Batra 95b:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "ויש מפרשים לרבותא נקטיה כדפירש",
      "source_ref": "Tosafot on Bava Batra 95b:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "הקונטרס לעיל.",
      "source_ref": "Tosafot on Bava Batra 95b:6:1",
      "gemara_segment_ids": [
        5
      ]
    }
  ],
