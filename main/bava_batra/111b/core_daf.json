  "tosafot": [
    {
      "width": "450px",
      "right": "0px",
      "left": "",
      "text": "<big><b>מקיש מטה האם למטה האב וכו.</b></big> ולמאן דדריש בעל משארו איצטריך לעבור עליו בשני לאוין. ומיהו",
      "source_ref": "Tosafot on Bava Batra 111b:3:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "360px",
      "right": "90px",
      "left": "",
      "text": "קשה לרשב''א דאמאי איצטריך הכא היקשא דמטות כיון דשמעינן",
      "source_ref": "Tosafot on Bava Batra 111b:3:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "450px",
      "right": "0px",
      "left": "",
      "text": "מואם אין לו בת ומלא תסוב דבן יורש את אמו תיפוק ליה מקל וחומר",
      "source_ref": "Tosafot on Bava Batra 111b:3:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "450px",
      "right": "0px",
      "left": "",
      "text": "דבן קודם לבת! והשתא לא אמר דיו כיון דמפריך ק''ו! ומיהו פלוגתא",
      "source_ref": "Tosafot on Bava Batra 111b:3:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "היא בכיצד הרגל (<a href=\"/bava_kamma/25a\">ב&#x27;&#x27;ק דף כה.</a>) דאיכא",
      "source_ref": "Tosafot on Bava Batra 111b:3:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "מ''ד אפילו היכא דמיפרך ק''ו אמר",
      "source_ref": "Tosafot on Bava Batra 111b:3:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "דיו. ומיהו אפילו למ''ד לא אמר דיו",
      "source_ref": "Tosafot on Bava Batra 111b:3:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "איכא למימר דמילתא דאתיא בק''ו",
      "source_ref": "Tosafot on Bava Batra 111b:3:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "טרח וכתב לה קרא. <big><b>״לוֹ מִשְׁפַּט</b></big>",
      "source_ref": "Tosafot on Bava Batra 111b:4:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>הבכורה</b></big>. השתא לא שייך למיפרך",
      "source_ref": "Tosafot on Bava Batra 111b:4:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "אפילו בלא הנך קראי דלעיל ואימא",
      "source_ref": "Tosafot on Bava Batra 111b:4:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "ה''מ בבחור שנשא אלמנה, מדכתיב",
      "source_ref": "Tosafot on Bava Batra 111b:4:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "משפט הבכורה משמע דלא שייך",
      "source_ref": "Tosafot on Bava Batra 111b:4:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "משפט הבכורה אלא באיש וקרא",
      "source_ref": "Tosafot on Bava Batra 111b:4:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "דלעיל אתי לדרשה אחריתי.",
      "source_ref": "Tosafot on Bava Batra 111b:4:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>הוּא יוֹרֵשׁ אוֹתָהּ.</b></big> משמע ליה",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "200px",
      "right": "50px",
      "left": "",
      "text": "מיעוטא מדלא כתיב וירשה",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "ומדכתיב אותה משמע מיעוט דאין",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "היא יורשת אותו. ועוד דלגמרי",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "וירש אותה מיותר דמשארו שמעי' תרתי,",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "דכיון שהיא יורשת אותו מטעם שהיא",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "שארו גם הוא יירשנה מטעם שארו.",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "ומיהו קשה דאמאי איצטריך כלל",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "מיעוט דמדקפיד בסיבת הבעל",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "ולא קפיד בסיבת האשה משמע",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "דאינה יורשת אותו:",
      "source_ref": "Tosafot on Bava Batra 111b:5:1",
      "gemara_segment_ids": [
        8
      ]
    }
  ],
  "ein_mishpat_markers": [
    {
