        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום בל תוסיף ולפיכך פוסק ואפילו באמצע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכה ובהא אפילו רבי יוחנן מודה דלא",
