        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נדבה שכן היחיד מביא עולת נדבה הלכך אין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היחיד מתפלל תפלת המוספין תפלת נדבה",
