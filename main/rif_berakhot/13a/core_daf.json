        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושכח שכבר התפלל ועמד להתפלל אדעתא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דחובה ונזכר שכבר התפלל פוסק ואפילו",
