        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באמצע ברכה שאם בא לגומרה נמצא כמי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמקריב שני תמידין בשחרית שהוא עובר",
