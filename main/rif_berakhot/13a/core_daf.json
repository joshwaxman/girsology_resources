  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אדעתא דחובה בין אדעתא דרשות אסור דקי\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתפלות כנגד תמידין תקנום וכשם שאין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הצבור מביא עולת נדבה כך אין הצבור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתפללין תפלת נדבה אבל היחיד מתפלל תפלת",
