  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "הסמוכין לרה\"ר שמא יטלו אותן עוברי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרכים ויבא לידי חשד ומעשה בתלמיד אחד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהניח תפיליו בחורין הסמוכין לרה\"ר ובאה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זונה אחת ונטלתן ובאה לפני חכמים אמרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להם ראו מה נתן לי פלוני באתנני כיון",
