        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רוצצות אסור ואם לאו מותר באיזה משוי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרו במשוי של ארבעה קבין תני ר' חייא",
