        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המוציא זבל על ראשו ותפילין בראשו הרי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זה לא יסלקם לצדדים ולא יקשרם בידו מפני",
