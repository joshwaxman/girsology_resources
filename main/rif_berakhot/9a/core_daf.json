  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "חוזר לפרק ראשון באמצע הפרק חוזר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>לתחלת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפרק בין כתיבה לכתיבה חוזר לכתיבה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשונה אמר ליה ר' יוחנן לא שנו אלא דלא",
