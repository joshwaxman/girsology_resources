  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>באמצע</b> הפרק חוזר לראש הפרק אין לפרש שאחר שקרא פסוק אחד או שני פסוקים טעה ואינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יודע באיזה מקום טעה שאם כן לא היה לו לומר חוזר לראש הפרק שהפסוק שקרא מתחלה למה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חוזר אותו פעם אחרת דהוה ליה כקורא למפרע אלא ר\"ל שטעה באמצע הפרק ואינו יודע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "באיזה מקום טעה וגם בכלל הטעות הוא שאינו יודע אם קרא כלום מהפרק אם לא ולפיכך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוזר לראש הפרק אבל אם היה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברי לו שקרא ממנו פסוק אחד או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שני פסוקים אין צריך לחזור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותם ויש להקשות לשמואל דאמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפ' מי שמתו (דף כא) ספק קרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ק\"ש ספק לא קרא ק\"ש אינו חוזר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקורא ק\"ש דק\"ש דרבנן היכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן הכא שחוזר לראש הפרק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "י\"ל שאינו דומה זה לזה דבשלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרא כלל אינו חוזר וקורא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>דק\"ש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרבנן אבל כשהתחיל לקרוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו שמואל מודה שאם טעה יש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו לתקן כיון שהתחיל. מפי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מורי הרב נר\"ו: <b>מתני' האומנין</b>",
