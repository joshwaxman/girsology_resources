    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להיכן טעה חוזר לתחלת הפרק היינו דוקא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כשאינו יודע להיכן טעה אבל אם ידע דאמר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זה הפרק ונזכר שדלג בפסוק אחד ותיבה אחת",
      "segment_ids": [
