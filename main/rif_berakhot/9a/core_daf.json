      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מלאכה הוי כאדם שעולה לעליה ומצי להתפלל",
      "segment_ids": [
