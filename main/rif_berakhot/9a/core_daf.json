        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר למען ירבו ימיכם אבל אמר למען ירבו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ימיכם סירכיה נקט ואתי: <b><big>מתני'</big></b> <i data-commentator=\"Mishneh Torah, Reading the Shema\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Prayer and the Priestly Blessing\" data-label=\"⚬\"></i>האומנין",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קורין בראש האילן ובראש הנדבך מה שאינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רשאין לעשות כן בתפלה: <b><big>גמ'</big></b> תנו רבנן",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האומנין קורין בראש האילן ובראש הנדבך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומתפללין בראש הזית ובראש התאנה ובשאר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל האילנות יורדין למטה ומתפללין ובעל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית בין כך ובין כך ירד למטה ומתפלל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>לפי שאין דעתו מיושבת עליו ירושלמי למה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לי בראש הזית ובראש התאנה ר' אבא ורבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סימון תרויהון אמרין מפני שטרחותן מרובה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראמי ליה רב מארי בריה דבת שמואל לרבא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנן <i data-commentator=\"Mishneh Torah, Reading the Shema\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>האומנין קורין בראש האילן ובראש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנדבך למימרא דלא בעינן כוונה ורמינהו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ר\"ש בן יוחאי אומר הקורא את שמע צריך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיכוין את לבו שנאמר שמע ישראל ולהלן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא אומר (דברים כ״ז:ט׳) הסכת ושמע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל מה להלן בהסכת אף כאן בהסכת אשתיק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "א\"ל מידי שמיע לך בהא א\"ל הכי אמר ר'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן בטלין ממלאכתן וקורין והתניא בה\"א",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עוסקין במלאכתן וקורין לא קשיא כאן בפרק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשון <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>כאן בפרק שני האי פירוקא",
      "segment_ids": [
        2
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>באמצע</b> הפרק חוזר לראש הפרק אין לפרש שאחר שקרא פסוק אחד או שני פסוקים טעה ואינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יודע באיזה מקום טעה שאם כן לא היה לו לומר חוזר לראש הפרק שהפסוק שקרא מתחלה למה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חוזר אותו פעם אחרת דהוה ליה כקורא למפרע אלא ר\"ל שטעה באמצע הפרק ואינו יודע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "באיזה מקום טעה וגם בכלל הטעות הוא שאינו יודע אם קרא כלום מהפרק אם לא ולפיכך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוזר לראש הפרק אבל אם היה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברי לו שקרא ממנו פסוק אחד או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שני פסוקים אין צריך לחזור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותם ויש להקשות לשמואל דאמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפ' מי שמתו (דף כא) ספק קרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ק\"ש ספק לא קרא ק\"ש אינו חוזר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקורא ק\"ש דק\"ש דרבנן היכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן הכא שחוזר לראש הפרק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "י\"ל שאינו דומה זה לזה דבשלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרא כלל אינו חוזר וקורא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>דק\"ש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרבנן אבל כשהתחיל לקרוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו שמואל מודה שאם טעה יש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו לתקן כיון שהתחיל. מפי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מורי הרב נר\"ו: <b>מתני' האומנין</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>קורין בראש האילן</b> <b>וכו'.</b>: <b>גמ'</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תנו רבנן האומנין קורין בראש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האילן אינו דוקא אומנין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאפילו בעל הבית קורא ג\"כ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בראש האילן אלא איידי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאיצטריך למימר בסיפא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומתפללין בראש הזית שאינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר לבעל הבית אלא לאומנים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלבד כדי שלא יתבטלו נקט",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברישא נמי האומנין ואמרינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בירושלמי מפני שטרחותן מרובה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופירשו בו כמה פירושים והנראה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למורי הרב נר\"ו יותר נכון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמפני שיש להם ענפים הרבה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יותר משאר אילנות יש טורח",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "גדול בעלייתן ובירידתן ויתבטלו ממלאכת בעה\"ב ולפיכך אמרו שיתפללו לשם אבל בשאר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אילנות דליכא ביטול (מותר) [ירדו]: <b>למימרא דלא בעי כוונה וכו'.</b> פי' קס\"ד השתא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמאי דקתני האומנים קורין בראש האילן בעוד שעוסקין במלאכתם קאמר ומ\"ה פריך כיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שעוסקים במלאכתם וקורין ודאי נראה דלא בעיא כוונה דאי אפשר לכוין בעוד שעוסקין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במלאכתם ורמינהו וכו' לא קשיא כאן בפרק ראשון כאן בפרק שני כלומר בפרק ראשון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מתבטלין ממלאכתם וקורין אבל בפרק שני עוסקין במלאכתם וקורין דלא בעי כוונה אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>בפסוק ראשון וכתב הרי\"ף ז\"ל דהאי פירוקא לדברי ר' יוחנן הוא אבל לרבא דאמר דלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בעיא כוונה אלא בפסוק ראשון אין טעם דמבטלין ממלאכתם בכל הפרק משום כוונה אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משום דלא לישוי ליה עראי כדמפרש ואזיל בהלכות. אבל רבני צרפת ז\"ל מפרשין דודאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הלכתא כרבא דאמר דלא צריך כוונה אלא פסוק ראשון בלבד ומאי דאמרינן לא קשיא כאן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בפרק ראשון כאן בפרק שני לאו משום דצריך כל הפרק כוונה דודאי לא צריך כוונה אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פסוק ראשון בלבד כרבא אלא שתירצו כן לרווחא דמילתא ואמרו אפי' לר' יוחנן דס\"ל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דצריך כוונה בכל הפרק לא קשיא כאן בפרק ראשון כאן בפרק שני וכיון דלית הלכתא כר'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יוחנן בהא כדאמרי' שמעינן דא\"צ כוונה אלא <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>פסוק ראשון בלבד ולא חיישינן משום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דלישוי ליה עראי ומתוך מ\"ש הרי\"ף ז\"ל משום דלא לשוי ליה עראי אמרו דבטלין ממלאכתן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בכל הפרק הראשון שמעינן דמפרק ראשון ואילך אינו אלא מדרבנן דאם איתא דהוא מן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "התורה הוה לן למיחש דלא לישוי להו עראי לכל שאר הפרקים כי היכי דחיישינן בפרק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ראשון ועוד הביא ראיה מדאמרינן בגמ' (דף יג:) והיו הדברים האלה על לבבך אמר מר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "זוטרא עד כאן מצות כוונה וקריאה מכאן ואילך מצות קריאה בלא כוונה וכו' ורבי יאשיה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אומר עד כאן מצות קריאה וכוונה מכאן ואילך מצות כוונה בלא קריאה כלומר כיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיתכוין לצאת אע\"פ שלא יחתוך בשפתיו כלל והוינן בה מאי שנא ע\"כ מצות קריאה וכוונה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכתיב ודברת בם התם נמי כלומר בפ' שני הא כתיב לדבר בם ומתרצינן הכי קאמר [רחמנא]",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אגמרו בנייכו תורה כי היכי דניגרסו בה כלומר מה שכתב בפ' שנייה ולמדתם אותם את",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בניכם לדבר בם לא נלמוד משום דצריך שיחתוך בשפתיו פרשה שנייה שזה לא בא אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "להשמיענו ללמוד את בנינו תורה ושהם ידברו בה ויקראו אותה תמיד אבל מה שאמר בפרשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ראשונה ודברת בם לא בא אלא להודיענו שיתכוון ויקרא בפרשה ראשונה ואע\"פ שאין הלכה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כר' יאשיה בעניין הכוונה דהא קי\"ל דא\"צ כוונה אלא <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>פסוק ראשון בלבד אפ\"ה בענין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הקריאה דאמרי' דמפרק ראשון ואילך א\"צ קריאה אפשר שהלכה כמותו וכיון דחזינן לשמואל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאמר בפרק מי שמתו (דף כא) דק\"ש דרבנן וסוגיין דעלמא בכמה דוכתי דק\"ש דאורייתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בעניין פרשה ראשונה אמרינן דהויא מן התורה אבל מפרשה ראשונה ואילך שלא מצינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שנדחו דבריו אמרינן דלא הויא אלא מדרבנן ועוד הביא ראיה מדאמרינן בגמ' (דף יג)",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמע ישראל ה' אלהינו ה' אחד זו היא ק\"ש של רבי יהודה הנשיא מפרש מורי הרב נר\"ו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דר\"ל כל הפרק ואם איתא דכולהו מן התורה הויא כשהיה לומד לתלמידיו למה לא היה פוסק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לכולה אלא ודאי משום דלא הוי אלא מדרבנן לא היה פוסק ובירושלמי שואל למאן דסבירא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ליה דק\"ש דאורייתא אמאי לא היה פוסק מן הלמוד לק\"ש כולה כמו שפוסק לשאר מצות כגון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שופר ולולב ומקרא מגילה וכיוצא בהן שחייב לפסוק בהם כדי לקיים המצוה והלא אמרו כל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הלומד ואינו מקיים נוח לו שנהפכה שלייתו על פניו ולא יצא לאויר העולם ומתרץ זה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שינון וזה שינון יבא שינון וידחה שינון כלומ' אין (ללמוד) [לדמות] זה לזה שהדברים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיש בהם מעשה אינן נידחין מפני הלמוד אבל מצוה שאין בה אלא אמירה בעלמא תדחה מפני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הלימוד ואע\"פ שמצות תפילין יש בהם מעשה והיה נראה שאינה נדחית מפני הלימוד אפי'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הכי במכילתא אמרינן שמי שעוסק בתורה פטור מן התפילין ואמרינן התם דטעמא דמלתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משום דבתפילין כתוב למען תהיה תורת ה' בפיך וכיון שטעם התפילין מפני התורה והוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עוסק בתורה כל היום זהו במקום תפילין ומכל מקום לא בא לפטור שלא יניחם בשעת קריאת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמע ותפלה שזה צריך הוא לקבל עליו עול מלכות שמים שלימה כדאמרינן לעיל (סי' לט)",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא הרווחנו בזה שאע\"פ שהחיוב כל היום פוטר למי שעוסק בתורה מפי מורי הרב נר\"ו:",
      "segment_ids": [
        3
      ]
    }
  ],
