  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א לשון ריא\"ז</b> מי שאינו יכול לילך לבית",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכנסת מקבץ עשרה ומתפלל ואם אינו מוצא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עשרה יכוין להתפלל בשעה שהצבור מתפללין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עכ\"ל: <b>ב</b> ואפי' הוא אנוס שאינו יכול לילך",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לביהכ\"נ טוב לו לכוין השעה שהצבור",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתפללין. טור: <b>ג</b> יש מפרשים שישהה שיעור",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        1,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ב' פתחים קודם שיתפללו ואומר מהר\"ם ז\"ל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דדוקא כשהפתח מביט ברשות הרבים אבל אם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינו מביט ברה\"ר אין לחוש. והטור כתב",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבכל ענין צריך שיכנס לפנים מבית הכנסת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כשיעור ב' פתחים: <b>ד</b> כתב הרא\"ש האידנא",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טוב הוא שגם ת\"ח ילכו לבהכ\"נ להתפלל כי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זמן תפלה לחוד וזמן תורה לחוד וגם אין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תורתנו אומנתנו וגם אם אין ת\"ח מתפלל עם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הצבור ילמדו אחרים ק\"ו ממני ולא יחושו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על התפלה ונמצאו בתי כנסיות בטלו' כי לא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ידונו אותו לכף זכות שאינו בא בשביל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למודו. ע\"כ טור. ומזה ראי' לאותם ת\"ח",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שעוסקי' בתורה בבית הכנסת ביום הכפורים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשעה שהצבור מתפללים ומשמיטי' עצמם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מלהתפלל אותם התחנות והסליחו' והבקשות",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עמהם דלאו שפיר עבדי: <b>ה</b> כתב הרא\"ש וא\"ת",
      "segment_ids": [
        3,
        4
      ],
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הא אמרי' בסוטה פ' ואלו נאמרים כיון",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנפתח ס\"ת אסור לדבר ואפילו בדבר הלכה",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנאמר ובפתחו עמדו כל העם ואין לומר",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאני הכא דמהדר אפיה דא\"כ הוי ליה",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאתויי מלתא דרב ששת התם לאשמועינן",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבהכ\"ג שרי ונ\"ל לפרש הא דקאמר התם אסור",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לדבר היינו דוקא בקול רם לפי שמעכב את",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחרים מלשמוע אבל בלחש שפיר דמי והא",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דמהדר אפיה ה\"ה לא מהדר אפיה מצי למגרס",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בלחש אלא רבותא נקט אפי' במהדר אפיה",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנראה כמניח ס\"ת שרי והוא היה מהפך פניו",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדי שיכוין לבו בגירסתו והרי\"ף פי' דוקא",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רב ששת שתורתו אומנתו אבל להורות לאדם",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ששואל לפי שעה ולפרש דבר איסור לא עכ\"ל:",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ו</b> וכן כתב מיימון אמנם ה\"ג פי' הני מילי",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאסור לספר בדליכא עשרה דצייתי לספר",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תורה אבל אי איכא עשרה דצייתי שפיר דמי",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"כ. וסמ\"ג פירש דהא דאסור לספר היינו",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דוקא בקול רם לפי שמונע אחרים מלשמוע",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל בלחש שרי ע\"כ: <b>לשון ריא\"ז</b> יש מגדולי",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חכמים שהיה מחזיר פניו וגורס תלמודו",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשעה שקורין בתורה ואומרים הגאונים שלא",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הותרו כן אלא למי שתורתו אומנתו ע\"כ:",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב מיימון ופסוק שאין לו תרגום קוראו",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלש פעמים ע\"כ וי\"א שלע\"ז שלט הוי כמו",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        6
      ]
    },
