      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דמיירי בתחנונים שהיה אומר אחר י\"ח",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ברכות דאי בתוך י\"ח היכי קאמר אדם מליחו",
