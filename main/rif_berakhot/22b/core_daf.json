      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"3\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 31a:21\" data-ror-ocr=\"המחיל אז במפלה אבל קולם לכן לא היה\">רגיל בכך:</i> <i class=\"ror-line\" data-ror-i=\"4\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 31a:23\" data-ror-ocr=\"ממפלל: יכול יהא כוללן. לג׳ מפלומ\">יכול יהא כוללן –</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"4\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 31a:23\" data-ror-ocr=\"ממפלל: יכול יהא כוללן. לג׳ מפלומ\"><i class=\"ror-talmud-only\" data-ror-chars=\"12\">לשלש תפלות הללו</i></i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 31a:23\" data-ror-ocr=\"כל אלה המפלות: יכול ישאל צרכיו. כגון\"><i class=\"ror-printed-only\" data-ror-ocr=\"כל אלה המפלות:\" data-ror-chars=\"10\">°</i> יכול</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 31a:23\" data-ror-ocr=\"כל אלה המפלות: יכול ישאל צרכיו. כגון\">ישאל צרכיו – כגון</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 31a:25\" data-ror-ocr=\"ברכמ אמה חונן על שומע תפלה ואח״כ\">ברכות דאתה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 31a:25\" data-ror-ocr=\"ברכמ אמה חונן על שומע תפלה ואח״כ\">חונן עד ש\"ת ואח\"כ</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 31a:25\" data-ror-ocr=\"יתפלל ג׳ הראשונומ שהן שבח: ר&lt;ה זו\">יתפלל שלש</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 31a:25\" data-ror-ocr=\"יתפלל ג׳ הראשונומ שהן שבח: ר&lt;ה זו\">ברכות ראשונות שהן <i class=\"ror-talmud-only\" data-ror-chars=\"10\">של שבח:</i></i>"
      },
