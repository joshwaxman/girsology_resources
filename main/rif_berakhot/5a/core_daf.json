      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לזה כמו אחד ובירושלמי נחלקו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמוראים חד אמר ככהנים וחד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמר כמלאכים מאן דאמר ככהנים",
