  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וכתב הרי\"ף ז\"ל מיהו לית כל איניש יכול לכווני ולמעבד כי הא מלתא ואפ\"ה מצוה</b>",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>למיקרי קודם הנץ החמה וכו'.</b> ותמהני עליו על זה הלשון שזהו מה שהיו עושין ותיקין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עצמן שהיו קורין מעט קודם הנץ כדי שיגמרו עם הנץ ויתפללו מיד ויסמכו גאולה לתפלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והיכי קאמר אלא מיהו לית כל איניש יכול לכווני וכו' דמשמע שבא לומר עת אחרת ואומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מורי הרב נר\"ו שכוונת הרי\"ף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל היא דותיקין מפני שהיו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משערין בדקדוק היו מצמצמין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומכוונין שמיד כשיגיעו לגאל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישראל תהיה הנץ החמה ושאר בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדם אינם בקיאין לשער כל כך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם יבואו לעשותו שמא יטעו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותנץ החמה קודם ק\"ש ויעבור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זמן לכתחלה ועל כן צריך שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישערו בצמצום אלא בענין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיוכלו לכל הפחות לקרוא קודם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנץ פרשה ראשונה ושתהיה הנץ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החמה מקריאת פרשה ראשונה עד",
      "segment_ids": [
        0
