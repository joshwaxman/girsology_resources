      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינם אלא אחת מלשון רגל קא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דייק דמשמע שיהו סמוכים זה",
