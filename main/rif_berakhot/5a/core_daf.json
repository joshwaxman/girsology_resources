        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום ר\"א בן יעקב המתפלל צריך שיכוין את",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רגליו שנאמר (יחזקאל א׳:ז׳) ורגליהם רגל",
