    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך שיכוין את רגליו שנאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ורגליהם רגל ישרה כלומר צריך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיחבר אותם זא\"ז בכיון כאלו",
      "segment_ids": [
