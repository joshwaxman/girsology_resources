        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Mishneh Torah, Reading the Shema\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>יטו ויקראו ובבקר יעמדו שנ' (דברים ו)",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובשכבך ובקומך ובית הלל אומרים כל אדם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קורין כדרכן שנאמר (דברים ו) ובלכתך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדרך א\"כ למה נאמר ובשכבך ובקומך בשעה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבני אדם שוכבין ובשעה שבני אדם עומדין:",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף יא.)\" data-bavli-daf=\"11a\" data-bavli-index=\"1\"></span>תנו רבנן ב\"ה אומרים עומדין וקורין",
      "segment_ids": [
        7
      ]
