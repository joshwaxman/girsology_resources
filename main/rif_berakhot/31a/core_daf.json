      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הסיבתנו חוץ מלילי הפסח שצריכין להסב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זכר לחירות כמבואר בקונט' הראיות בראיה",
      "segment_ids": [
