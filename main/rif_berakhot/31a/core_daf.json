      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על גבי ספסלים וכיוצא בהן ישיבתנו היא",
      "segment_ids": [
