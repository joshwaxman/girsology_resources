      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בברכות המברך ומז\"ה ביאר בפסקיו שאין",
      "segment_ids": [
