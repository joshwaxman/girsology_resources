      "right": "0px",
      "left": "0px",
      "text": "לזמן בג' אם ירצו והרא\"ש הוכיח דעם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האנשים חובה ומיימוני כתב סתם דמזמנות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעצמן אבל לא יזמנו בשם והרא\"ש כתב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דמצטרפות עם האנשים לזימון בשם ור\"י",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכהן היה עושה הלכה למעשה להצטרף נשים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לזימון ומהר\"ם פליג עליו מיהו לכ\"ע",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יוצאות בזימון האנשים אלא דפליגי אם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריכות שיבינו לשון הקדש או לאו י\"א",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דצריכות להבין אותו לשון וי\"א דאינו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריך והכי נמי פליגי בסופר מברך ובור",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יוצא אם צריך שיבין לשון הקדש או לאו:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לשון ריא\"ז</b> הנשים והעבדים אין מצטרפין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותן לזימון אבל אם רצו הנשים לזמן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעצמן מזמנות וכן העבדים אם רצו לזמן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעצמן מזמנין: <b>ג</b> כתב הרא\"ש פרש\"י בין",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ברכת זימון בין ברכת המוציא והעולם לא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נהגו כן וגם רש\"י עצמו לא שמענו שהיה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נהוג כן בברכת המוציא וכן עובדא דבר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קפרא ותלמידיו דלעיל שנתן רשות לאחד מהן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לברך להוציא את כולן ומה שיש חילוק בין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ברכה ראשונה לאחרונה היינו משום דבתחלת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הסעודה כשהן מסובין וקבועים יחד דעתם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להצטרף הלכך כל אחד יוצא בברכת חבירו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל בסוף הסעודה בטל הקבע ונחלקים זה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מזה הלכך כל אחד מברך לעצמו וה\"ר יוסף",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פי' בשם רשב\"ם משום דברכת המזון",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאורייתא אבל ברכה ראשונה דרבנן לא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחמור כולי כאי דיוצא האחד בברכת חבירו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"כ: <b>ד</b> רש\"י ומיימוני כתבו דדרך ארץ הוא",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאחד שיפסיק לשנים ואינו חיוב ור\"ח",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והראב\"ד ורבינו יונה כתבו דחיוב הוא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאחד שיפסיק לשנים פי' ר\"ח שהמפסיק",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כשחוזר לאכול מברך המוציא וכן כתב רב",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האי וכן הראב\"ד שצריך גם נטילת ידים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ורבינו יונה והרא\"ש והטור כתבו דא\"צ",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נט\"י ולא המוציא: <b>לשון ריא\"ז</b> שלשה שאכלו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כאחד ורצו השנים לברך והשלישי עדיין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אוכל הרי זה מפסיק סעודתו ועונה עמהם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדי שיברכו ברכת זימון ואחר שענה עמהם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומזמן עמהם חוזר לסעודתו ואחר שגומר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סעודתו מברך ברכת המזון לעצמו ומתחיל",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מברכת הזן כמבואר בקונטרס הראיות הוצרך",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחד מן הג' להקדים ולברך אין השנים",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מפסיקין סעודתן להצטרף עמו לזימון ואם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רצו להפסיק מפסיקין ועונין לו ואח\"כ",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חוזרים לסעודתם: <b>ה לשון ריא\"ז</b> ונראה",
      "segment_ids": [
        3,
        4
      ],
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעיני שכך ראוי לומר בחבורה של חמשה בני",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אדם שאכלו כאחת וקדמו שלשה מהן וזמנו",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעצמן והשנים אוכלין עדיין אינו יכול",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להצטרף אחד מאותם השלשה לזמן אח\"כ עם",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותם השנים הואיל ויצא כבר ידי זימון",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בקונטרס הראיות היו שלשה שאכלו",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כאחת וקדם אחד מהם ובירך לעצמו ה\"ז",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מצטרף עמהן לזימון הואיל והוא לא יצא",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ידי זימון מוציא אחרים אבל הוא אינו",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יוצא באותו הזימון שאין זימון למפרע",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לזמן אחר שבירך:",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        3
      ]
    }
  ],
