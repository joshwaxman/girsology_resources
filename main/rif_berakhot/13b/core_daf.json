      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהאי מתני' שאין היחיד אומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קדושה אלא ודאי פי' אין",
      "segment_ids": [
