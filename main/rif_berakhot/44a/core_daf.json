    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דדוקא כשבאו לידו בתורת ירושה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא קנאם צריך לברך כיון",
