  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "מברך עליה המוציא לחם ושלש ברכות ואי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לית ביה פירורין כזית בתחלה מברך עליה",
