        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמשתכחת בתר הכי אהבה רבה אעיקרא דשמואל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גריר <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>אמר רב הונא <i data-commentator=\"Mishneh Torah, Prayer and the Priestly Blessing\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>למקרא צריך לברך למשנה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולתלמוד אינו צריך לברך ורבי יוחנן אמר",
