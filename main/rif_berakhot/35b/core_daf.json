      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 48a:7\" data-ror-ocr=\"םימ או כביצה כומיה אבל אכלו ושבעו\">אכלו ושבעו</i> <i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 48a:7\" data-ror-ocr=\"לא מפיק ואי אפשר להעמידה דהא ינאי\">לא מפיק ואי אפשר</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 48a:7\" data-ror-ocr=\"לא מפיק ואי אפשר להעמידה דהא ינאי\">להעמידה דהא ינאי</i> <i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 48a:7\" data-ror-ocr=\"וחביריו אכלו ושבעו ואפקינהו שמעון בן\">וחבריו אכלו</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 48a:7\" data-ror-ocr=\"וחביריו אכלו ושבעו ואפקינהו שמעון בן\">ושבעו ואפקינהו שמעון בן</i> <i class=\"ror-gap\" data-ror-gap=\"2\">⋯</i> <i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 48a:7\" data-ror-ocr=\"דאי כזית דגן הוה אטל הוה מפקינהו\"><i class=\"ror-printed-only\" data-ror-ocr=\"הוה אטל הוה מפקינהו\" data-ror-chars=\"15\">°</i></i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 48a:7\" data-ror-ocr=\"דאי כזית דגן הוה אטל הוה מפקינהו\">כזית דגן הכי</i> <i class=\"ror-line\" data-ror-i=\"14\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 48b:3\" data-ror-ocr=\"שפיר: מסחיל בגחמה. כלומר אינו צריך\"><i class=\"ror-talmud-only\" data-ror-chars=\"12\">נמי: ובשבת</i></i>"
      },
