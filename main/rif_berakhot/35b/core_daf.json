      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצטרפין האחרים עמהם הה\"נ בג'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון שאכלו רובא דמינכר דגן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצטרפין האחרים עמהם והב' אצל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הג' רובא דמינכר הוי כיון שהם",
      "segment_ids": [
