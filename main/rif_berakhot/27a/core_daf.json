      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רש\"י ז\"ל צריכין אנו לומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שההפרש שיש בין טריתא זו",
      "segment_ids": [
