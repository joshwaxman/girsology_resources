      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המוציא שברכת המוציא תלויה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלחם וזה כיון שנתבטל מתורת",
      "segment_ids": [
