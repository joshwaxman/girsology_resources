      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא ג' ברכות וכבר הארכתי בזה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפסחים ת\"ל: <b>האי טריתא דארעא</b>",
      "segment_ids": [
