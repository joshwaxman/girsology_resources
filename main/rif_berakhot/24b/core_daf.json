        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמחמת השינוי חשוב יותר קובע",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכה לעצמו כדמפרש בגמרא",
