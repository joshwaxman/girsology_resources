        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו לשנה אחרת מברכין ב\"פ העץ:",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חוץ</b> מן היין מפני שהיין כיון",
