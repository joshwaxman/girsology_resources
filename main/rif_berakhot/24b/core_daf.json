        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן דכל היכא דכי שקלת ליה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפירא איתיה לאילנא מברכין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו ב\"פ העץ ור\"ל שכשלוקטין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפרי נשאר העץ משנה לשנה וגדל",
