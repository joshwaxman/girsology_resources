  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "סימן לדבר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>צאת הכוכבים <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>ואע\"פ שאין ראיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לדבר זכר לדבר שנאמר (נחמיה ד׳:ט״ו)",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואנחנו עושים במלאכה וחצים מחזיקין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברמחים מעלות השחר עד צאת הכוכבים ואומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(נחמיה ד׳:ט״ז) והיו לנו הלילה משמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והיום מלאכה שמעינן השתא דבין למתניתין",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובין לברייתא עונת ק\"ש לרבנן משעה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהכהנים נכנסין לאכול בתרומתן דהיא שעת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צאת הכוכבים והכין <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>הלכתא דקיימא לן יחיד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ורבים הלכה כרבים והאי דאקשינן דר'",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אליעזר אדר' אליעזר דתניא מאימתי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתחילין לקרות ק\"ש בערבין משעה שקדש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היום בערבי שבתות דברי רבי אליעזר ותנן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמי במתניתין משעה שהכהנים נכנסין לאכול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתרומתן דברי ר\"א לאו למימרא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">י\"נ</i>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">דההוא</i>דהאי דקתני במתניתין משעה שהכהנים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נכנסין לאכול בתרומתן לר' אליעזר בלחוד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היא אלא בין רבי אליעזר בין רבנן הכי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סבירא להו דהא לא אפליגו רבנן עליה דרבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אליעזר אלא בעד סוף דרבי אליעזר סבר עד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סוף האשמורה הראשונה ורבנן סברי עד חצות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבל במשעה שהכהנים נכנסין לאכול בתרומתן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא פליגי דאי לא סבירא להו לרבנן משעה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהכהנים נכנסין לאכול בתרומתן אלא ר\"א",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בלחוד הוא דסבירא ליה הכי הוה להו לרבנן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאיפלוגי עליה במשעה כדאפליגו עליה בעד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סוף ומדלא אפליגו עליה אלא בעד סוף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעינן דבין לר\"א ובין לרבנן כולהו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סבירא להו משעה שהכהנים נכנסין לאכול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתרומתן וכיון דס\"ל לר\"א בהדי רבנן משעה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהכהנים נכנסין לאכול בתרומתן ואשכחינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה בברייתא דס\"ל משעה שקדש היום בערבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבתות אקשינן <span class=\"bavli-ref\" data-bavli-ref=\"(דף ג.)\" data-bavli-daf=\"3a\" data-bavli-index=\"0\"></span>דידיה אדידיה ופרקינן תרי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנאי אליבא דר\"א ולהאיך פירוקא בתרא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמרינן איבעית אימא סיפא רבי אליעזר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רישא לאו ר\"א ברירא מילתא דמשעה שהכהנים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נכנסין לאכול בתרומתן לרבנן בלחוד היא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולאו רבי אליעזר הלכך בין לפרוקא קמא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין לפרוקא בתרא האי דקתני במתניתין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משעה שהכהנים נכנסין לאכול בתרומתן איתא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרבנן וכיון דאיתא לרבנן עבדינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כוותייהו: עד סוף האשמורה הראשונה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>: <span class=\"bavli-ref\" data-bavli-ref=\"(דף ח:)\" data-bavli-daf=\"8b\" data-bavli-index=\"1\"></span>אמר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב יהודה אמר",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ורבינו</b> האי גאון ז\"ל אומר בדרך אחרת שמתפלל עם הצבור בבית הכנסת ויקרא ק\"ש כמו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שקורא פסוקים כדי להתפלל מתוך דברי תורה כמו שאמרו בירושלמי ולא יקרא הברכות גם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא יענה אמן בכונה לצאת ידי חובה אלא אם ירצה לאומרה עם הקהל בלא חתימה ובלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פתיחה הרשות בידו ולאחר יציאת הכוכבים יקרא ק\"ש עם ברכותיה לצאת ידי חובתו ואע\"פ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו סומך גאולה לתפלה שהרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתפלל תחלה וקורא ק\"ש אח\"כ עם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכותיה לכונת חובה אפילו הכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר לעשות כן כיון שמתכוין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למצוה להתפלל עם הצבור שהתפלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נשמעת יותר ומקובלת לפני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המקום וראיה לדבר מדאמרי'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקמן (דף כז.) רב צלי של שבת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בע\"ש כלומר קודם שקיעת החמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובודאי לא היה קורא ק\"ש באותה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעה כיון שלא יצאו הכוכבים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמצא שלא היה סומך גאולה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתפלה ואפילו הכי לא היה חושש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון שהיה עושה כן למצוה לקבל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבת מבעוד יום ולהוסיף מחול",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על הקודש שהוא מצוה גדולה הכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי אע\"פ שאינו סומך גאולה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתפלה כיון שמתפלל עם הצבור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר: <b>ומי</b> שירצה להחמיר על",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו יכול לעשות בדרך אחרת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יותר נכונה שיקרא בבית הכנסת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ק\"ש והברכות בלא חתימה ופתיחה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויתפלל עם הצבור ואותה התפלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יתפלל על שם נדבה שהרי אברים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופדרים של עולת נדבה נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבין כל הלילה ואח\"כ בביתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יקרא ק\"ש אחר יציאת הכוכבים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בברכותיה בפתיחות וחתימות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויתפלל לשם חובה ובזה יהיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכל מתוקן שאותה שבב\"ה תהיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעמוד בתפלה מתוך ד\"ת כמו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאמרו בירושלמי ויקרא ק\"ש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעונתה ויסמוך גאולה לתפלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומה שמתפלל אותה הברכה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>כדי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לסמוך גאולה לתפלה הוי כמו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמחדש דבר בתפלתו וא\"צ לחדש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בה דבר אחר: <b>גמ' ואע\"פ שאין</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ראיה לדבר זכר לדבר שנאמר</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואנחנו עושים במלאכה וכו'.</b> יש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשאול האיך אמר שאין ראיה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדבר שבפירוש נראה מהפסוקים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיציאת הכוכבים הוא לילה ואין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לך ראיה גדולה מזו וגם במסכת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מגילה [דף כ:] מוכיח בפירוש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאלו הפסוקים שזהו נקרא לילה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וי\"ל שמפני שאינו מוכיח",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהפסוקים בפירוש שכל זה הזמן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא זמן שכיבה אמר שאין ראיה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדבר ואע\"פ שמוכח שהוא לילה:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והא</b> דאמרי' דמצאת הכוכבים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואילך הוא לילה דוקא ג' כוכבים בינונים אבל פחות לא הוו לילה דהכי אמרי' במס' שבת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "(ד' לה:) כוכב א' יום ב' בין השמשות ג' לילה ואמרינן עלה לא כוכבים גדולים הנראים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ביום ולא כוכבים קטנים הנראים בלילה אלא בינונים וכיון שכן ואין הכל בקיאין בין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "(בינונים לקטנים) צריך ליזהר עד שיראו הקטנים וכן במוצאי שבת צריך ליזהר ג\"כ שלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעשות שום מלאכה עד שיראו ג' כוכבים קטנים ואם הוא יום מעונן ימתין עד שיצא הספק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מלבו ובע\"ש ג\"כ אם הוא יום מעונן יקבל אותו מבעוד יום מפני הספק וזהו עיקר היראה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ליזהר מהספקות ושלא לעשות המצות ע\"ד ההרגל שעונש הספק יותר מהודאי וכן מצינו שעל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הודאי מביא חטאת ואמרינן (זבחים ד' מח.) דחטאת <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>דנקא כלומר שאפי' לא יהיו דמי כשבה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "או שעירה שיביא לחטאת אלא דנקא די לו בזה ודנקא היא מעה והוא שתות הדינר כדאמרי'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "(קדושין דף יב.) שש מעין כסף דינר ואם מביא אשם על הספק כגון שהיו לפניו ב'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חתיכות אחת של שומן ואחת של חלב ואכל אחת מהן ואינו יודע איזה מהן אכל (זבחים שם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכריתות ד' כו: במשנה) צריך להביא ב' סלעים שהם מ\"ח מעין כי הסלע ד' דינרים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והדינר ו' מעין אישתכח דב' סלעים הוו מ\"ח מעין ועל הודאי סגי במעה א' בלבד והטעם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בזה למה החמירו על הספק יותר מן הודאי אומר מורי הרב שהוא מפני שעל הודאי משים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האדם החטא אל לבו ודואג ומתחרט עליו וחוזר בתשובה שלימה אבל על הספק עושה סברות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואומר אותה חתיכה שאכלתי אולי היתה מותרת ולא ישית אל לבו לשוב ולזה החמירו בו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יותר:",
      "segment_ids": [
        3
      ]
    }
  ],
