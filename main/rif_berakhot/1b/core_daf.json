      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיקרא בבית הכנסת ק\"ש והברכות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלא חתימה ופתיחה ויתפלל עם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הצבור ואותה התפלה יתפלל על",
      "segment_ids": [
