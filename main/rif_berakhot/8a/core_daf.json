      "right": "275px",
      "text": "שיתפלל שנאמר (תהילים פ״ה:י״ד) צדק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפניו יהלך וישם לדרך פעמיו אמר רב אידי",
