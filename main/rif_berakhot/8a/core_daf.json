  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "במה והני מילי כמשכים לפתחו אכל כשאינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>משכים לפתחו שרי דתנן בפרקים שואל מפני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכבוד ומשיב שלום לכל אדם אמר ר' יצחק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר אשיאן אסור לאדם לצאת לדרך קודם",
