      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובעפר ובקסמים אמר ליה שפיר קאמר מי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתיב במים בנקיון כתיב כל מידי דמנקי",
