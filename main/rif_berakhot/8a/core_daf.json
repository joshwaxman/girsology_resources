        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לייט רב חסדא מאן דמהדר אמיא בעידן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צלותא וה\"מ",
      "segment_ids": [
        4
      ]
    }
