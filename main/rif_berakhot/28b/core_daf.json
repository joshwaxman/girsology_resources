        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצחק כל המוקדם בפסוק זה הוא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ה\" data-order=\"5\"></i>מוקדם",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לברכה (דברים ח׳:ח׳) ארץ חטה ושעורה",
