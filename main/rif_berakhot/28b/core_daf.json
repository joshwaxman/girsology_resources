      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תחלה וסוף. מפי מורי הרב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נר\"ו: <b>רבי</b> יהודה אומר כל שהוא",
      "segment_ids": [
