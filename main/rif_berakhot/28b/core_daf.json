        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מין קללה אין מברכין עליו יש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרשים לומר דלא קאי אלא",
      "segment_ids": [
