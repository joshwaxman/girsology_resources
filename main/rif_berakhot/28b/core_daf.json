      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>יהנה מן העולם בלא ברכה ואינו",
      "segment_ids": [
