        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכל מברך על זה וחוזר ומברך על זה ואיזה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>שירצה יקדים: אמר רב יוסף ואיתימא רבי",
      "segment_ids": [
