      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מניחן בכובע תחת מראשותיו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשמע אפי' כנגד ראשו מותר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויש לשאול על זה ומאי קושיא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דדילמא ר' חייא נמי מאי דאמר",
      "segment_ids": [
