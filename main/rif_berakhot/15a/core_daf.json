      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפי' בלא אשתו עמו ושלא כנגד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראשו אם אשתו עמו צריך כלי",
      "segment_ids": [
