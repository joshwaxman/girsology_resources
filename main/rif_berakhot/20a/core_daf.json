        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן לוי הלכה כאחרים א\"ל אליהו לרב יהודה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחוה דרב סלא חסידא לא תרתח דלא תחטי",
