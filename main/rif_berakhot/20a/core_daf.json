        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צרכי עמך ישראל מרובים ודעתם קצרה יהי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רצון מלפניך ה' אלהינו שתתן לכל אחד",
