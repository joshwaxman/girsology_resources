      "left": "",
      "text": "הברכה דיינינן ליה ורבינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יצחק הזקן ז\"ל אמר דכיון שכבר",
