      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומר לשון חוזר ואע\"פ שלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התחיל עדיין הברכה האחרת הכא",
      "segment_ids": [
