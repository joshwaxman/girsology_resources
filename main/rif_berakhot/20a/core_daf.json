      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המלך בקונך וצא מאי היא אמר רבי יעקב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רב חסדא זו תפלת הדרך: ואמר רבי",
