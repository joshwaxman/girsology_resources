      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי כיון שסיים ברכת אתה חונן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואע\"פ שלא התחיל עדיין השיבנו",
