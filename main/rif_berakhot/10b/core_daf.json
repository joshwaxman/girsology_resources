  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "נושאי המטה וחלופיהן וחלופי חלופיהן את",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלפני המטה ואת שלאחר המטה את שלמטה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורך בהן פטורין ואת שאין למטה צורך בהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייבין אלו ואלו פטורין מן התפלה: <b><big>גמ'</big></b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מוטל לפניו אין שאין מוטל לפניו לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ורמינהו מי שמתו מוטל לפניו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>אוכל בבית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחר אין לו בית אחר אוכל בבית חבירו אין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו בית לחבירו עושה מחיצה ואוכל אין לו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר לעשות מחיצה מחזיר פניו ואוכל ואינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיסב ואוכל ואינו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>אוכל בשר ואינו שותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יין <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>ואין מברך <span class=\"bavli-ref\" data-bavli-ref=\"(דף יח.)\" data-bavli-daf=\"18a\" data-bavli-index=\"0\"></span>ואין מזמן ואין מברכין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליו ואין מזמנין עליו ופטור מק\"ש ומן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התפלה ומן התפילין <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>(ומכל מצות האמורות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתורה) ובשבת מיסב ואוכל ואוכל בשר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושותה יין ומברך ומזמן ומברכין עליו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומזמנין עליו וחייב בקריאת שמע ובתפלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובכל מצות האמורות בתורה רבן גמליאל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר מתוך שנתחייב באלו נתחייב בכולן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואמר ר' יוחנן תשמיש המטה איכא בינייהו קתני מיהת אוכל",
      "segment_ids": [
        1
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פטור מן ק\"ש ומן התפלה ומן התפלין נושאי המטה וכו'.</b> כך היא הגרסא בכל הספרים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המדוייקים ויש מפרשים דכיון שלא שנינו במשנה בפירוש שפטור מכל המצות האמורות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בתורה אינו פטור אלא מאילו השלשה בלבד אבל בכל השאר חייב ומביאין ראייה מדאמרינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בפרק הישן חתן פטור מכל המצות האמורות בתורה ותנא שילא חייב ואומרים דהתם משמע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהלכתא כשילא וכי היכי דחתן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב בכל המצות האמורות בתורה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"נ שאבל חייב בכולן אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באילו השלשה בלבד שאסור מפני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ששלשתן צריכות כוונה יותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משאר מצות ק\"ש מפני קבלת עול",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלכות שמים וצריך שיהיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכוונה ותפילין ג\"כ צריך שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יסיח דעתו מהם ותפלה ג\"כ צריך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כוונה שאם לא כוון באבות צריך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחזור ולהתפלל פעם אחרת ומתוך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא בהול על מתו וטרוד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעסקיו לא יוכל לכוין בהם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולפיכך פטור אבל בשאר מצות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינן צריכות כוונה כל כך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב ואין זה נראה למורי הרב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נר\"ו שאותה הברייתא דסוכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמביאין ראיה ממנה שחייב בכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאר המצות כבר תירצה רש\"י ז\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואמר דלא סבירא ליה העוסק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במצוה פטור מן המצוה אבל אנן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקיימא לן דהעוסק במצוה פטור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מן המצוה ודאי פטור: <b>ועל</b> כן נראה לפרש שאע\"פ שלא שנה במשנה אלא אלו השלשה בלבד הוא הדין דפטור מכל שאר המצות אלא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דתנא אלו שהם חמורות שיש בהם קבלת עול מלכות שמים וכל שכן בכל שאר המצות שאינן חמורות כל כך לפיכך אמר תפלה ותפילין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עם קריאת שמע מפני שקבלת עול מלכות שמים שלימה היא עם התפילין כדכתבינן לעיל וגם צריך להתפלל עמהם ומביא ראיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מהירושלמי דגרסינן התם אם רצה להחמיר על עצמו אין שומעין לו למה מפני כבודו של מת או מפני שאין לו מי שישא משאו מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נפיק מביניהון יש לו מי שישא משאו כלומר דכיון שיש לו מי שישתדל בדבר אין לו טרדא ויכול לקרוא קריאת שמע ולעשות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המצוה כתקונה ומקשה עלה התם והתניא פטור מלולב כלומר היאך נחייב אותו אפילו בשיש לו מי שישא משאו מאחר שאין לו טרדא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והרי ביום טוב אע\"פ שהמת מוטל לפניו אין טרדא לו שאינו יכול לעשות לו ארון ותכריכין ולהוליכו וכמי שיש לו מי שישא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משאו דמי ואפילו הכי פטור מלולב ומתרצינן בחול כלומר כשאמרו דפטור לא אמרו ביום טוב עצמו אלא בחולו של מועד דחג",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הסוכות ולפיכך פטור מפני שהוא טרוד בעסקי מתו ומקשינן והא תניא פטור מתקיעת שופר אית לך למימר בחול ומתרצינן כאותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ששנינו (שבת דף קנא) מחשיכין על התחום לפקח על עסקי כלה ועל עסקי המת להביא לו ארון ותכריכין ונמצא שאפילו במועד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא טרוד שיש לו לפעמים ללכת במועד עצמו עד אלפים אמה כדי <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>שיצא מזומן לדרכו כשיצא המועד ולפיכך אמרו שפטור מתקיעת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שופר אלמא משמע הכא בהדיא דכי היכי דפטור מן התפלה ומן התפילין ה\"נ פטור מכל שאר המצות כגון לולב ושופר וכיוצא בהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תדע <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>שבספרים המדויקים אינו גורס לא במשנה ולא בברייתא ומכל מצות האמורות בתורה ובסוף הברייתא כשהוצרך להודיענו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "(היתר) גבי שבת אמר וחייב בכל מצות האמורות בתורה ונראין הדברים דטעמא דמילתא הוי משום שמתחילה כשהיה פטור לא הוצרך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לומר ובכל מצות האמורות <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>דכיון שהיה פטור אלו שהם חמורות ממילא שמעינן דכ\"ש השאר אבל בסיפא שהיה בא להתיר הוצרך לומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וחייב בכל מצות האמורות בתורה שאם לא היה אומר אלא חייב בק\"ש ובתפלה היינו אומרים דדוקא באילו חייבו אותו בשבת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואע\"פ שמתו מוטל לפניו מפני שהם חמורות אבל בכל שאר מצות האמורות בתורה פטור ולפיכך הוצרך להשמיענו שחייב ג\"כ בכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאר מצות האמורות בתורה: <b>נושאי המטה וחילופיהן וחילופי חילופיהן וכו'.</b> ואע\"פ שיש שהות לאחרונים לקרוא בעוד שנושאין",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הכת השניה אפ\"ה פטורין מפני שפעמים נמלכים שאותה כת שלישית בשניים יסעו ומתוך כך אין להם להתחיל: <b>את שלמטה צורך בהן</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פטורין וכו'.</b> בירוש' מפרש שאין זה החילוק אלא באותם שלפני המטה בלבד אבל באותם שלאחר המטה מתוך כך הולכין אחר המטה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפני שלעולם אינן צריכין למטה ולעולם חייבים: <b>אלו</b> ואלו פטורין מן התפלה פי' רש\"י ז\"ל מפני שהתפלה אינה אלא מדרבנן",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והטעם היותר נכון מפני שהתפלה צריך להתפלל מעומד ואין יכולין לשהות כל כך אבל ק\"ש שיכולין לאומרה בעוד שמהלכין ודי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לעמוד בפסוק ראשון בלבד שלא יתעכבו בו אלא מעט חייבין מפי מורי הרב נר\"ו: <b>גמ' ואינו מיסב וכו'.</b> בירוש' אמרינן ואינו",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אוכל כל צרכו ונראה שהתלמוד שלנו אסר ההסיבה מפני שלא יאכל בהסיבה בקביעות וישכח עסקי המת אלא אכילת עראי בלבד שרי:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואין מברכין עליו וכו'.</b> כלומר אין מחזירין שיאכלו אחרים עמו כדי שיברכו אחרים ברכת המוציא ויפטר גם הוא שאין צריך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבלאו הכי פטור ובירושלמי אומר דאין מברכין ר\"ל שאם היו מברכין ברכת המוציא לא יענה אמן וה\"ג התם בירך לא יענו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחריו אמן ברכו הם לא יענה אחריהם אמן: <b>ובשבת</b> מיסב ואוכל בשר ושותה יין לא קאמר וחייב לאכול בשר ולשתות יין דכיון",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ד\" data-order=\"4\"></i>שהוא מתכוין למצוה אם ירצה יאכל ואם לא ירצה לא יאכל שאינו חובה על האדם שיאכל בשר וישתה יין בשבת שהרי אמרו (שבח",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ד' קיח.) עשה שבתך חול ואל תצטרך לבריות הלכך בכל דבר שהוא מצוה חייב לעשותו בשבת אבל זה רשות הוא אם ירצה יאכל בשר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וישתה יין ואם לא ירצה יניח וא\"ת וגם בחול למה אסרו אותו והלא אחר הקבורה שחל עיקר האבלות ואסור בנעילת הסנדל מותר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "י\"ל שהטעם שאסרו אותו קודם קבורה מפני שאם יבא לאכול בשר ולשתות יין ימשך אחר תענוגיו ויתעצל בקבורת המת ומפני זה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הטעם נמי לא אסרו לו נעילת הסנדל שאם ילך יחף לא יוכל ללכת לכאן ולכאן ולהשתדל בקבורתו: <b>תשמיש המטה איכא בינייהו.</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פי' דת\"ק ס\"ל דחייב בכל המצות האמורות בתורה אבל תשמיש המטה אע\"פ דיש בה מצות עונה אסור שמאחר שמתו מוטל לפניו קלות",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ראש הוי לשמש מטתו בעת כזאת ורבן גמליאל הוסיף ואמר <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ה\" data-order=\"5\"></i>נתחייב בכולן שמאחר שחייב בכל המצות האמורות בתורה גם בזה חייב",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לשמש עונה אבל לדברי הכל אין לו לשמש מטתו להנאתו יותר והלכה כת\"ק דיחיד ורבים הלכה כרבים <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ב\" data-order=\"2\"></i>והכי איתא משמיה דרי\"ף",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל ומקשי' עלה מדאמרינן בפ\"ק דכתובות (דף ג:) הרי שהיתה פתו אפוי וטבחו טבוח ויינו מזוג ומת אביו של חתן או אמה של",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלה מכניסין את המת לחדר ואת החתן ואת הכלה לחופה ובועל בעילת מצוה ופורש ונוהג ז' ימי המשתה ואח\"כ ז' ימי אבלות",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וכל אותן הימים הוא ישן בין האנשים והיא בין הנשים והוינן בה (שם ד' ד.) למימרא דאבלות קיל ליה מנדה כלומר מדחזינן",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאסרו אותו לישן עמה בביתה מכלל דמשום הכי חששו מפני שהאבלות יהיה קל בעיניו ויבא לשמש מטתו ומאי קילותא כלומר ומאי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קולא ימצא בענין אבלות שנחוש שילמוד משם ויבא ג\"כ להקל אילימא ממה דאמרי' ובועל בעילת מצוה ופורש שמתוך שהקלו לו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לבעול קודם קבורה יקל ג\"כ אחר קבורה ויבעול זה אינו דהתם דהקילו משום דאכתי לא חל עליה אבלות אי לרבי אליעזר דאמר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משיסתום הגולל אי לרבי יהושע דאמר עד שיצא מפתח ביתו אלא מדקתני ונוהג שבעת ימי המשתה ואח\"כ נוהג שבעת ימי אבלות",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואם איתא כדברי הרי\"ף ז\"ל דאמר דאסור בתשמיש קודם קבורה היכי קאמר משום דאכתי לא חל עליה אבלות שהרי חל עליה אבלות",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לענין איסור התשמיש וי\"ל דהכי קאמר אי משום דקתני בועל בעילת מצוה ופורש מאי קילותא דהתם מתוך כך התירו לו בעילת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מצוה קודם קבורה משום דאכתי לא חל עליה אבלות שאע\"פ שאסור הוא בתשמיש קודם קבורה זהו מפני חומרא שהחמירו בו מפני",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא קלות ראש ואם הקילו לו לבעול בעילת מצוה בזמן שאין בו אלא חומרא בעלמא מה טעם הוא שנחוש שיבא ג\"כ להקל בעיקר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זמן האבלות והשתא לא קשה מידי:",
      "segment_ids": [
        8
      ]
    }
  ],
