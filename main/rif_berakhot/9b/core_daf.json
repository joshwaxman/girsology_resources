      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בטרדא כזו שהיא טרדא דמצוה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בטרדא שאינו של מצוה כגון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שטבעה ספינתו בים אינו פטור",
      "segment_ids": [
