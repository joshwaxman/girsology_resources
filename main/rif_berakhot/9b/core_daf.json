  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "לדברי רבי יוחנן היא דסבירא ליה דבעי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כוונה בכוליה פרק ראשון כדכתבינן לעיל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבל לרבא לאו משום דבעי כוונה בכוליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרק ראשון הוא דאמר דבטלין ממלאכתן אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום דלא לשוי לה עראי הוא כי הא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דגרסינן ביומא בפרק קמא <span class=\"bavli-ref\" data-bavli-ref=\"(דף יט:)\" data-bavli-daf=\"19b\" data-bavli-index=\"0\"></span>אמר רב יצחק בר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל בר מרתא משמיה דרב הקורא את שמע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא ירמוז בעיניו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>ולא יקרוץ בשפתיו ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יראה באצבעותיו ותניא רבי אלעזר <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>חסמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר הקורא את שמע ומרמז בעיניו ומקריץ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשפתיו ומראה באצבעותיו עליו הכתוב אומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(ישעיהו מ״ג:כ״ב) ולא אותי קראת יעקב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגו' ואוקימנא בפרק ראשון ופרשי לה רבנן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום דקא משוי לה עראי הכי נמי אי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בטיל ליה ממלאכה קא משוי לה עראי דאי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תימא הכי קשיא דרבא אדרבא דהתם אמר רבא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלכה כר' מאיר והכא קאמר <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>דבעינן כוונה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפרק ראשון אלא לאו ש\"מ כדאמרינן כי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היכי דלא תיקשי דרבא אדרבא גרסינן ביומא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(שם) ת\"ר ודברת בם בם ולא בתפלה ודברת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בם בם יש לך רשות לדבר ולא בדברים אחרים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודברת בם עשה אותם קבע <i data-commentator=\"Tur\" data-label=\"⚬\"></i>ת\"ר הפועלין שהיו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושין מלאכה אצל בעה\"ב קורין ק\"ש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומתפללין ואוכלין פתן ומברכין לפניה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולאחריה שתי ברכות כיצד ברכה ראשונה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתקנה שניה פותח ברכת הארץ וכולל לבונה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירושלים בברכת הארץ וחותם בברכת הארץ",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בד\"א כשעושין בשכרן אבל בעושין בסעודתן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "או שהיה בעל הבית מסב עמהם מברכין כתקנן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארבע: <b><big>מתני'</big></b> <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>חתן פטור מקריאת שמע בלילה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הראשון עד מוצאי שבת אם לא עשה מעשה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומעשה בר\"ג שנשא אשה וקרא לילה הראשון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנשא אמרו לו תלמידיו לא למדתנו רבינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחתן פטור מק\"ש בלילה הראשון אמר להם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איני שומע לכם לבטל ממני עול מלכות שמים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו שעה אחת: <b><big>גמ'</big></b> מנא הני מילי דת\"ר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשבתך בביתך פרט לעוסק כמצוה ובלכתך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדרך פרט לחתן מכאן אמרו הכונס את",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבתולה פטור ואת האלמנה חייב דלא טריד:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני'</big></b> רחץ <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>בלילה הראשון שמתה אשתו א\"ל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלמידיו לא למדתנו רבינו שאבל אסור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרחוץ אמר להם איני כשאר כל אדם אסטניס",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>אני: <b><big>גמ'</big></b> מ\"ט אנינות דאורייתא ביום הוא",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכתיב (עמוס ח׳:י׳) ואחריתה כיום מר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ורבנן הוא דגזרו בלילה ובאסטניס לא גזרו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבנן <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>וחזינן למקצת רבואתא דקא כתבי הא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דר\"ג דקסבר אנינות לילה דרבנן היא לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קיימא לן כותיה ואע\"ג דכתיב שבעת ימים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לילות בכלל ימים ומחזיא מלתא דס\"ל להני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבואתא דז' ימי אבילות דאורייתא נינהו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגמרי להא מלתא מדכתיב (בראשית נ׳:י׳)",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויעש לאביו אבל שבעת ימים ולאו הכין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מילתא דהא בהדיא",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ודברת בם.</b> בם ולא בתפלה כלומר בק\"ש יש לך רשות להפסיק לשאלת שלום מפני היראה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולהשיב מפני הכבוד כדאמרי' לעיל אבל לא בתפלה כדתנן (ד' ל) ואפי' המלך שואל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשלומו לא ישיבנו ורבני צרפת פירשו בם יש לך רשות להשמיע קולך אבל לא בתפלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדאיתא (ברכות דף כד) כל המשמיע קולו בתפלתו הרי זה מקטני אמנה: <b>בם</b> יש לך רשות",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדבר ולא בדברים אחרים כלו'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו בק\"ש באילו יש לך רשות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדבר שהם מפני היראה ומפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכבוד אבל בדברים אחרים אין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לך להפסיק: <b>ודברת</b> בם עשה אותם",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קבע שיהיו כל דבריך בזה וכן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרו בירושל' מכאן שהשח שיחת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חולין עובר בעשה ושיחת חולין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיקרי כשמדבר בדברי הבאי אבל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשמדבר בעסקיו לצורך פרנסתו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"פ שאינה שיחה של תורה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר: <b>מתני'</b> חתן פטור מק\"ש",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לילה הראשון עד מוצאי שבת אם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא עשה מעשה פירוש מנהג' היה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכנוס את הבתולה ברביעי וכל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותן הג' ימים והד' לילות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמיום ד' ועד יום ראשון היה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טרוד לחשוב מחשבות לעשות מצוה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שמתירא שלא יעשה מעשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרות שפכה ולפיכך פטור אבל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מזה הזמן ואילך אע\"פ שלא עשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשה חייב דכיון שכבר עברו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השלשה ימים ולא עשה מעשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתיאש אחר כך מן הדבר ואינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טרוד כלל ולפיכך חייב ומפרש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמרא (דף טז:) דאפילו עד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוצאי שבת לא פטרו אותו אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בטרדא כזו שהיא טרדא דמצוה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בטרדא שאינו של מצוה כגון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שטבעה ספינתו בים אינו פטור",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש לו לישב ולכוין: <b>גמ'</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשבתך בביתך פרט לעוסק",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(בתורה) [במצוה] ובלכתך בדרך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרט לחתן דמדקאמר ובלכתך בדרך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משמע בהליכה דידך הוא דמחייבת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בהליכה דמצוה פטירת וזה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמו הליכת מצוה היא כיון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שטרוד לבו במחשבת מצוה ומה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוצרך לומר למעט חתן מובלכתך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדרך ולא מיעט אותו מטעם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהעוסק במצוה פטור ממצוה משום",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאי מהתם הוה אמינא שאינו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פטור אלא בשעת מעשה בלבד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולפיכך השמיענו שאפי' שלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשעת מעשה (דוקא) [אם] הוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טרוד טרדא דמצוה פטור: <b>מתני'</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רחץ בלילה הראשון שמתה אשתו</b>",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו' איני כשאר כל אדם</b>",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>איסטניס אני.</b> פר\"ח ז\"ל משום",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהוה ליה סכנה ולפיכך מותר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואין זה נכון אלא אפילו בלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סכנה כיון שיש בו צער מותר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וראיה לדבר מדחזינן ביום",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכפורים שאסור בסיכה ואפ\"ה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרו (יומא דף עז) שאם יש לו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חטטין בראשו סך כדרכו ואינו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חושש הנה שאפי' בלא סכנה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התירו לו לסוך וכיון שביום",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכפורים שהוא מן התורה הקילו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל שכן באבלות שרוחץ אע\"פ",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין שם סכנה כיון שיש שם צער",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדאמרינן בנדרים (דף פא.) ערבוביתא דרישא דמתיא לידי עוירא פירוש מתוך האבק שנעשה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בראש והמאכולת מזיק לעינים אם מתאחר לרחוץ: <b>גמ'</b> מאי טעמא אנינות (לילה) דאורייתא",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ביום היא דכתיב ואחריתה כיום מר אינו מביא הפסוק לראיה אלא לסימנא בעלמא שיום",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המיתה הוא יום המרירות ובאותו היום הוא יום האנינות מן התורה ורבנן הוא דגזרו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בלילה ורבני צרפת ז\"ל פירשו שאפילו האבילות של יום ראשון אינו מן התורה אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מדרבנן בלבד ואע\"פ שאמרו בפירוש בכמה מקומות דאנינות יום <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>אחד הוא מן התורה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "באבילות אינו אלא מדרבנן שאין לשון אנינות ולשון אבילות אחד שלשון אנינות נאמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בדברים ידועים שהוא אסור ביום ראשון מן התורה שיום ראשון אסור לאכול מעשר שני",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכתיב לא אכלתי באוני ממנו וכן לענין אכילת החטאות אסור ביום א' כדמשמע בזבחים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בפרק טבול יום (דף ק:) אבל לא מצינו בשום מקום שיאמר שדין האבלות יהיה נוהג ביום",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ראשון מן התורה והכי תנן בסנהדרין (דף מו:) ואין הקרובים מתאבלים עליו אלא אוננין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמשמע ששתי לשונות הוי ומאי דאמר רבנן הוא דגזרו בלילה לא מפני שהלילה בלבד דרבנן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והיום הוא מן התורה אלא כך ר\"ל שאע\"פ שיום ראשון הוא מדרבנן כיון שהוא כעין של",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תורה שבאותו היום הוא אונן ואסור במקצת דברים כדכתיב' לעיל החמירו בו ג\"כ ואסרו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הרחיצה ואע\"פ שהוא אסטניס אסור אבל בלילה שלא אמרו כעין של תורה אלא משום גזירה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "באסטניס לא גזרו רבנן ומביאין ראיה מדאמרינן בפ\"ק דכתובות (דף ג:) גבי מי שהיה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טבחו טבוח ויינו מזוג ומת אביו של חתן או אמה של כלה מכניסין את המת לחדר ואת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "החתן ואת הכלה לחופה ונוהג שבעת ימי המשתה ואח\"כ נוהג שבעת ימי אבלות ואם איתא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאבלות יום ראשון מן התורה האיך תדחה מצוה מן התורה מלפני המשתה דלכל הפחות הוה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לן למימר שנוהג יום א' תחלה אלא ודאי משום דלא הוי אלא מדרבנן לא חששו ועוד הביאו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ראיה מדאמרינן בבכורות (דף מט) גבי פדיון כל ששהה ל' יום באדם אינו נפל דכתיב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ופדוייו מבן חדש תפדה איבעיא לן יום ל' כלפני שלשים או כלאחר ל' ומסקנא דיום ל'",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלאחר ל' לחומרא ואמר עלה התם ולענין אבל אינו כן אלא יום ל' כלפני ל' דקי\"ל הלכה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדברי המיקל באבל ואם איתא דאבילות יום ראשון מה\"ת ה\"ל למימר דמספק יום ל' כלאחר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ל' לחומרא ונוהג אבלות דספיקא דאורייתא לחומרא: <b>ויש</b> להקשות לפי זה הפסק מהא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרי' בפ' ואלו מגלחין (דף יד:) אבל אינו נוהג אבילות ברגל דכתי' ושמחת בחגך אי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבילות דמעיקרא היא אתי עשה דרבים ודחי עשה דיחיד וכו' דמשמע שהאבלות מן התורה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולפי מאי דכתבינן לעיל דליכא מ\"ד דהוי מן התורה אלא אנינות בלחוד קשיא דהא אמרינן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהדיא לשון אבילות ואפ\"ה קרי ליה עשה ומתרצים שאע\"פ שאינו אלא מדרבנן קרי ליה עשה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שכך מצינו הרבה מקומות בתלמוד שקורא עשה לדבר שאינו אסור אלא מדרבנן כדאמרינן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בזבחים (דף לב:) דטבול יום אם נכנס במחנה לוייה עובר בעשה ובפי' מוכיח במסכת סוטה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאין בו אלא איסורא דרבנן ואפ\"ה קורא אותה עשה זו היא שיטת רבני צרפת ז\"ל: <b>אבל</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הגאונים והרי\"ף ז\"ל מפרשים דאבלות יום ראשון דאורייתא וס\"ל דליכא הפרש בין לשון",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אנינות ללשון אבלות ואנינות יום ראשון מצינו בפירוש שהוא מן התורה לד\"ה ולא נחלקו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא בלילה שאחר יום המיתה וקבורה כדמפרש ואזיל בהלכות מדאמר <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>ר' יוסי יום קבורה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תופס לילו מדרבנן מכלל דיום מיתה תופס לילו מדאורייתא פירוש דאמר לעיל דכל זמן",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלא נקבר תופס לילו מדרבנן ור\"ל אע\"פ שאינו אלא יום הקבורה בלבד שלא נקבר ביום",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המיתה ממש כגון ששהה אותו שני ימים או ג' אפ\"ה כיון שנקבר באותו יום הואיל ויום",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קבורה בלבד <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>תופס לילו מדרבנן ומדאמרינן דיום קבורה בלבד תופס לילו מדרבנן מכלל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דיום מיתה ויום קבורה כגון שקברוהו ביום שמת תופס לילו מדאורייתא ומקשינן וסבר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רבי אנינות לילה דאורייתא אפילו יום מיתה ויום קבורה והתניא הן היום הקריבו את",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חטאתם וגו' ואכלתי חטאת היום אני היום אסור והלילה מותר ולדורות בין ביום ובין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בלילה אסור דברי ר' יהודה רש\"י ז\"ל מפרש ששעיר מוסף של ר\"ח היה השעיר שנשרף וג'",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היה שעיר נחשון. וקרבן יום ח' למילואים. ושעיר ר\"ח ושל ר\"ח נשרף ומרע\"ה אמר להם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואכלוה מצות כי כן צויתי כלומר אפילו באנינות ולפיכך אמר להם אח\"כ מדוע לא אכלתם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "את החטאת ואמר לו אהרן הן היום הקריבו את חטאתם ואת עולתם וגו' כלומר אם שמעת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בקדשי שעה שהאונן אוכל לא שמעת בקדשי דורות אני היום אסור ובלילה מותר משום דהוה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ליה הוראת שעה שהצריכו להתיר בלילה אבל בדורות הבאים בין ביום ובין בלילה אסור",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאנינות לילה מיתה וקבורה דאורייתא היא רבי אומר אנינות לילה אינו מד\"ת אלא מד\"ס",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואפילו לדורות מותר בלינה הנה סובר רבי שאנינות לילה מיתה וקבורה אינו מדאורייתא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומתרצינן לעולם דרבנן כלומר לעולם ס\"ל לרבי דאנינות <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>של מיתה וקבורה מדרבנן ומה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאתה מדקדק מדבריו דמאי דאמר יום קבורה תופס לילה מדרבנן מכלל דיום מיתה וקבורה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תופס לילו מן התורה אינו כן אלא כמו שליל יום קבורה אינה אלא מדרבנן כך ליל יום",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיתה וקבורה אינה אלא מדרבנן דחכמים עשו חיזוק לדבריהם יותר משל תורה וא\"ת והיכי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קאמר יותר משל תורה שהרי שוה הוא וכמו שליל קבורה מדרבנן כך ליל מיתה וקבורה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מדרבנן ולמה אמר לשון יותר י\"ל דה\"ק חכמים עשו חיזוק לדבריהם בשל דבריהם יותר משל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תורה בשל תורה דאילו ביום מיתה וקבורה שהוא מן התורה הלילה אינה מן התורה אלא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מדרבנן ואלו ביום קבורה שהוא מדרבנן הלילה ג\"כ מדרבנן וגבי פסח לא העמידו דבריהם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במקום כרת ומש\"ה אמרו גבי פסח מפני שיש כריתות אחרות שהעמידו בהם דבריהם אבל בזה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא העמידו אותם אלא אמרו שבלילה טובל לאנינותו ואוכל פסחו שבכל הכריתות מצינו לאו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא בפסח ומילה בלבד שאין בהם לאו: <b>הדרן</b> עלך היה קורא",
      "segment_ids": [
        8,
        9
      ]
    }
  ],
