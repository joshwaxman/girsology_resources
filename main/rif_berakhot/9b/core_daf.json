  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> ומה שנוהגין להטות הראש מעלה ומטה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולארבע רוחות העולם אין בזה משום רמיזה.",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טור: <b>ב</b> רב האי וגאונים סבירא להו דאסור",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לרחוץ בלילה הראשון אף איסטניס וכן כל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבעת ימים ולדברי התוספות וסמ\"ג ואשר\"י",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותר לרחוץ אף בלילה הראשון ומיימוני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הסכים לדעת רבינו. וכתב עוד רב האי לאו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כל האומר איסטניס אני שומעין לו אבל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ודאי אי מגליא מילתא דאית ביה האי מילתא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאם אינו רוחץ בא לידי סכנה רוחץ דדמי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לסכנה ורפואה משום דאיסטניס כחולה גדול",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא ממדה זו ולא כל מי שנוהג בשרו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנקיון איסטניס הוא אלא מי שבא לידי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סכנה אם אינו רוחץ ע\"כ: כתב הרמב\"ן מה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שכתב לא כל מי שאומר אסטניס אני ומתנהג",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנקיות מתירין לו יפה כיון אבל מה שכתב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאם אינו רוחץ בא לידי סכנה לאו סכנה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממש אלא מצטער הרבה ובא לידי מיחוש בכך.",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ירושלמי מקום שנהגו לרחוץ אחר המטה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מרחיצין אמר רבי יוסי ברבי בון מי שמתיר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ברחיצה עשה אותו כאכילה ושתיה וכתב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרמב\"ן יראה מכאן שהיו נוהגים במקצת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מקומות שהקרובים המברין האבל היו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מרחיצין אותו קודם הבראה לפי שעשו אותו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כאכילה ושתיה שצריכה להם הרבה מפני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שצריכין להעביר מהם זוהמא והיו מתירין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זו הרחיצה ראשונה ואחר כך היו נוהגין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "איסור ברחיצה כל שבעה הלכך אי איכא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דוכתא דנהיגי ברחיצה זו אין ממחין בידם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טור:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    }
  ],
