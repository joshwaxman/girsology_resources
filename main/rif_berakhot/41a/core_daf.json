        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר ואמר ר' אושעיא לא אמרו נטילת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידים לפירות אלא משום נקיות בלבד ופליגא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרב נחמן דאמר רב נחמן הנוטל ידיו",
