    {
      "width": "380px",
      "right": "275px",
      "text": "בחולין עד <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>לפרק לתרומה עד לפרק",
      "segment_ids": [
        2
      ]
    }
