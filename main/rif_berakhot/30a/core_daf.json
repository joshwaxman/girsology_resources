      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקבעו עילויהו מברכין עליהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המוציא וכי היכי דבהני אזלינן",
