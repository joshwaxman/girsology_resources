  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "תלתא לקבא ולא בריך אמר רב נחמן עדיין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מר כפין הוא אלא אמר רב נחמן כל שאחרים",
      "segment_ids": [
