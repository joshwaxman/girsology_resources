        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שתי פעמים על ידיו והתוספות וסמ\"ג וטור",
      "segment_ids": [
