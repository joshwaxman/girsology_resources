      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתבו דצריך לשפוך שלש פעמים: <b>לשון ריא\"ז</b>",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הנוטל ידיו צריך להגביה את ידיו שלא",
      "segment_ids": [
