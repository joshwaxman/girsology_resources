      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יצאו מים חוץ לפרק ויחזרו ויטמאו את",
      "segment_ids": [
