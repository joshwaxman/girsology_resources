        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להכיר אותו אפי' כשלא אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותה אין מעלין אותו עוד נוכל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לומר שבתחיית המתים כשטעה אין",
