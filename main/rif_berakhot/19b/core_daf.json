  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בית המדרש ולא שמת חלקי מיושבי קרנות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאני משכים והם משכימין אני משכים לדברי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורה והם משכימין לדברים בטלים אני עמל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והם עמלים אני עמל ומקבל שכר והם עמלים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואינם מקבלים שכר אני רץ והם רצים אני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רץ לחיי העולם הבא והם רצים לבאר שחת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנאמר (תהילים נ״ה:כ״ד) ואתה אלהים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורידם לבאר שחת וגו': <b><big>מתני'</big></b> רבן גמליאל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר בכל יום <i data-commentator=\"Mishneh Torah, Prayer and the Priestly Blessing\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>מתפלל אדם שמונה עשרה רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע אומר מעין שמונה עשרה ר' עקיבא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר אם שגורה תפלתו בפיו מתפלל שמונה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשרה ואם לאו מעין שמונה עשרה: <b><big>גמ'</big></b> הני",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמני סרי תשסרי הויין אמר ר' לוי ברכת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המינין ביבנה תקנוה ת\"ר שמעון הפקולי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הסדיר שמונה עשרה ברכות לפני ר' גמליאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על הסדר ביבנה אמר להם רבן גמליאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לחכמים כלום יש אדם בכאן שיודע לתקן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכה למינין ירד שמואל הקטן ותקנה לשנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחרת שכחה <span class=\"bavli-ref\" data-bavli-ref=\"(דף כט.)\" data-bavli-daf=\"29a\" data-bavli-index=\"0\"></span>והשקיף בה שתים ושלש שעות ולא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העלוהו אמאי לא העלוהו והאמר רב יהודה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רב טעה בכל הברכות כולן אין <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מעלין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו טעה בברכת המינין מעלין אותו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חיישינן שמא מין הוא שאני שמואל הקטן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דהוא תקנה ודלמא הדר ביה אלא שאני שמואל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקטן דאתחיל בה דאמר רב יהודה אמר רב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואיתימא ר' יהושע בן לוי לא שנו אלא שלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התחיל בה אבל התחיל בה גומרה: ר' יהושע",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר מעין שמונה עשרה: מאי מעין שמונה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשרה רב אמר מעין כל ברכה וברכה ושמואל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר הביננו לדעת את דרכיך ומול את לבבנו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליראתך לסלוח היה לנו לחיות גאולים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רחקנו ממכאוב ודשננו בנאות ארצך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והנפוצים מארבע כנפות הארץ תקבץ והתועים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדעתך ישפטו ועל הרשעים תניף ידיך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וישמחו צדיקים בבנין עירך ובתיקון היכלך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובהצמחת קרן לדוד עבדך ועריכת נר לבן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישי משיחך טרם נקרא אתה תענה טרם נדבר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אתה תשמע כי אתה עונה בכל עת צרה וצוקה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ופודה ומציל ברוך אתה ה' שומע תפלה אמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב נחמן אמר שמואל כל השנה כולה מתפלל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדם <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>הביננו חוץ ממוצאי שבתות ומוצאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ימים טובים מפני שצריך לומר הבדלה בחונן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדעת: אמר רב ביבי בר אבין כל השנה כולה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתפלל אדם הביננו חוץ מימות הגשמים מפני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שצריך לומר שאלה בברכת השנים וקאמרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבנן <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>הני מילי בשעת הדחק אבל שלא בשעת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדחק אין מתפלל הביננו אמר ר' תנחום אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אסי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i><i data-commentator=\"Mishneh Torah, Prayer and the Priestly Blessing\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>טעה ולא הזכיר גבורות גשמים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>בתחיית המתים מחזירין אותו שאלה בברכת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השנים אין מחזירין אותו מפני שיכול",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גמ'</b> אני רץ לחיי העוה\"ב והם רצים לבאר שחת וא\"ת ולמה הוצרך לחזור זה והלא הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בכלל מה שאמר תחלה אני עמל ומקבל שכר והם עמלים ואינם מקבלים שכר י\"ל שהוא דבר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בפני עצמו ור\"ל כשאני רואה שעוברים הימים והזמנים אני מרגיש בעצמי שאני רץ בכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יום ומתקרב למיתה ומפני זה אני מכין צדה לדרך כדי שאזכה לחיי העולם הבא אבל הם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינם מרגישין במיתתם כלל עד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעת המיתה ואינם מכינין צדה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדרכם. מפי מורי הרב נר\"ו:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתני' ר\"ג אומר בכל יום מתפלל</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אדם י\"ח</b> <b>וכו'.</b>: <b>גמ'</b> הסדיר י\"ח",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכות על הסדר ביבנה שמתחלה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא היו מתפללים אותה על הסדר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא כל אחד ואחד הברכה שהיתה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריכה לו ובא שמעון הפקולי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לסדור אותם אחר כך על הסדר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמד הסדר מכח הפסוקים כדאי'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמ' דמגלה (דף יז:): <b>טעה</b> בכל",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הברכות כולן אין מעלין אותו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומ\"ש העובר לפני התיבה וטעה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יעבור אחר תחתיו זהו לפי שעה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בכאן אמר שאין מסירין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו מש\"צ ולא קשיין אהדדי:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>טעה</b> בברכת המינין מעלין אותו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחיישי' שמא מין הוא ומה שלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרו שאם טעה ולא הזכיר תחיית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המתים שמעלין אותו ג\"כ מפני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שברכת המינין יש בה קללה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למינין וכשאינו אומר אותה אנו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוששין שמפני שהוא מין אינו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רוצה לקלל את עצמו אבל בברכת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תחיית המתים כיון שאין בה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קללה אין בזה היכר אם הוא מין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או לא שאפשר שאפי' שלא יאמין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא בתחיית המתים עכ\"ז יאמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הברכה דמאי איכפת ליה אם יאמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחיה המתים כיון שאינו מקלל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו הלכך כיון שאיפשר שיאמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותה ויהיה מין ולא נוכל",
