        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדעתך תשפוט ובירושלמי ג\"כ",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומר בדעתך תשפטם וקשיא לזה",
