        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תשפוט אותם ואם מזלם לטובה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תהפוך אותו לרעה וכן גורסין",
