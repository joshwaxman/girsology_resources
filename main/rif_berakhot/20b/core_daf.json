        "text": "<i class=\"ror-line\" data-ror-i=\"0\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:1\" data-ror-ocr=\"לעתו לילך שיתפלל תפלה זו על פרשה\">יתפלל תפלה</i> <i class=\"ror-gap\" data-ror-gap=\"2\">⋯</i> <i class=\"ror-line\" data-ror-i=\"3\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:3\" data-ror-ocr=\"הואיל ויכול אני להתפלל תפלה זו מעומד\">הואיל ואני יכול</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"3\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:3\" data-ror-ocr=\"הואיל ויכול אני להתפלל תפלה זו מעומד\">להתפלל מעומד</i> <i class=\"ror-line\" data-ror-i=\"4\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:3\" data-ror-ocr=\"שהד חבורתו היו עומלין לא אקרא רע\"><i class=\"ror-printed-only\" data-ror-ocr=\"חבורתו היו עומלין\" data-ror-chars=\"10\">°</i> שהרי חבורתי</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"4\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:3\" data-ror-ocr=\"שהד חבורתו היו עומלין לא אקרא רע\">עומדת לא אקרא רע</i> <i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 30a:3\" data-ror-ocr=\"להתפלל מהלך ואע״פ שמותר: וכי מעי\">להתפלל מהלך</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 30a:3\" data-ror-ocr=\"להתפלל מהלך ואע״פ שמותר: וכי מעי\">ואע\"פ שמותר: וכי מטי</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 30a:4\" data-ror-ocr=\"שהד לא התפלל כלוס מתפלת י״ח: אלא\">שהרי</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 30a:4\" data-ror-ocr=\"שהד לא התפלל כלוס מתפלת י״ח: אלא\">לא התפלל כלום מתפלת י\"ח:</i> <i class=\"ror-gap\" data-ror-gap=\"4\">⋯</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:6\" data-ror-ocr=\"מיישבת עליו. ט קשה לו עכוב הלרך:\">עליו – שקשה עליו עכוב הדרך:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"14\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:8\" data-ror-ocr=\"ישראל כמו למסיק לקמן מל שהכל פונים\"><i class=\"ror-printed-only\" data-ror-ocr=\"כמו למסיק לקמן מל\" data-ror-chars=\"12\">°</i> ישראל <i class=\"ror-talmud-only\" data-ror-chars=\"12\">כדבעינן למימר תל</i></i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"14\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:8\" data-ror-ocr=\"ישראל כמו למסיק לקמן מל שהכל פונים\">שהכל פונים בו:</i> <i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:9\" data-ror-ocr=\"לה: אחורי הכפרה. שהיה במערב העזרה\">אחורי בית</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:9\" data-ror-ocr=\"לה: אחורי הכפרה. שהיה במערב העזרה\">הכפורת – במערב העזרה היו</i> <i class=\"ror-line\" data-ror-i=\"16\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 30a:9\" data-ror-ocr=\"ט היה לשס י״א אמה חצר פכר מכותל\">י\"א</i>"
      },
