    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התפלה שאסרו לרוק אין לו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעשות בשום ענין אלא כשהוא",
      "segment_ids": [
