    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלשים יום חזקה מה שהוא למוד מזכיר מכאן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואילך מה שצריך מזכיר כך כתוב בתוספות",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
