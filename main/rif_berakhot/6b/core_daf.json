      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרי' בירושלמי דתענית פ\"ק תניא המתפלל",
      "segment_ids": [
