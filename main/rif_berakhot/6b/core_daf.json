        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו עשרת הימים שבין ר\"ה ליוה\"כ אם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר האל הקדוש והאל המשפט יצא שנא'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(ישעיה מה) ויגבה ה' צבאות במשפט והאל",
