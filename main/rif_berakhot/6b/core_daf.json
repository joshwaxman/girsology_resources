  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> ואיתא בירושלמי צריך להזכיר באמת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ויציב יציאת מצרים ומלכות וקריעת ים סוף",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומכת בכורי' וצור ישראל וגואלו ותקנו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמת ואמונה ערבית על הגאולה של עתיד אי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נמי על שאנו מפקידים בידו נשמותינו בכל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לילה ומאמינים בו שישיבנו אלינו ופי' לא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יצא ידי חובתו ר\"ל לא יצא ידי חובת מצוה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתקנה אבל לעולם יצא דברכות אינן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מעכבות. טור: <b>ב</b> רב האי ז\"ל פי' חיזרא",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא א' ממיני הקוצים וראשו כפוף וכשהוא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כורע לא יכרע באמצע מתניו וראשו ישאר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זקוף. ומיי' פי' שיתפקקו כל חליות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבשדרה. ויעשה עצמו כקשת. ובהגהת הרא\"ש",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל מי שמתפלל ובא לו נכרי כנגדו ויש לו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צורות בבגדיו אל ישתחוה במודים ואפילו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יהיה לבו לשמים ע\"כ: <b>ג</b> כתב הרא\"ש ז\"ל",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובלאו האי פסקא קי\"ל כרבה דרבה ורב יוסף",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הלכה כרבה ואם לא אמר מחזירין אותו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מדקאמר ר' אלעזר אפי' אמר האל הקדוש יצא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מכלל דלרב אפילו בדיעבד לא יצא ורבה ס\"ל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כרב וכן זכרנו ומי כמוך וכתוב לחיים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובספר חיים שמוסיפין בי' ימי תשובה אם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לא אמר מחזירין אותו בין ביחיד בין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בצבור דמשנה הוא ממטבע ברכות ואם מסופק",
      "segment_ids": [
