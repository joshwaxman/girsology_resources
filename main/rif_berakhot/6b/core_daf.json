      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא אם הזכיר אם לאו יחזור ויתפלל",
      "segment_ids": [
