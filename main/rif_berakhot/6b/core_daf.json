  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>להגיד בבקר חסדך ואמונתך בלילות.</b> פי' האמונה שהבורא עושה עמנו בכל יום שאנו מפקידין נשמתנו בידו והוא מחזירן אלינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשבח שהנשמות הולכות עייפות מהעמל שטורחים בני אדם כל היום לבקש פרנסתם ובבקר הן שבות במנוחה ואינו כבשר ודם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שכשמפקידין בידו פקדון מחזיר אותו כמו שנתנוהו לו ולפעמים יותר גרוע אבל הבורא יתעלה מחזיר הפקדון בשבח כאמור ועל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כך אנו משבחין אותו כל לילה כי הוא ה' אלהינו ואין זולתו ובבקר אנו משבחין אותו עם יציאת מצרים ועם החסד שעשה עמנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שגאלנו להיות לו לעבדים:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כשהוא</b> כורע כורע בברוך וכשהוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זוקף זוקף בשם ובגמ' פריך והא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב מפני שמי נחת הוא והכא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמרינן שזוקף בשם ומתרץ מי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב בפני שמי אלא מפני שמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשמע קודם שיזכיר השם דהיינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשמזכיר ברוך והטעם להיות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כורע בברוך ולזקוף בשם מפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבשעה שכורע מראה הפחד והיראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש מלפניו וכשזוקף מראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבטחון שיש לו בו בכל עניניו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיטיב אליו וזה תלוי בזה שמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שירא מהש\"י הוא בוטח בו כענין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנאמר ביראת ה' מבטח עוז",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(משלי יד): <b>ואסיקנא</b> והלכתא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המלך הקדוש והמלך המשפט אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפרש דר' אלעזר היה אומר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלכתחלה לא יצא אלא בדיעבד דאם איתא דרבה ור' אלעזר בהאי פליגי דרבה ס\"ל בין לכתחלה בין בדיעבד צריך שיאמר המלך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקדוש והמלך המשפט ור' אלעזר ס\"ל דלכתחלה צריך שיאמר המלך הקדוש והמלך המשפט אבל בדיעבד אם אמר האל הקדוש והאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המשפט יצא א\"כ לא היה לו לומר במסקנא לשון והלכתא המלך הקדוש והמלך המשפט דלשון והלכתא ר\"ל שכך יש לו <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>לומר ולא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בענין אחר וכיון דבין רבה ובין ר\"א תרווייהו ס\"ל לכתחלה צריך שיאמר המלך הקדוש והמלך המשפט מה הוצרך לומר אח\"כ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והלכתא (צ\"ל) המלך המשפט והמלך הקדוש דפשיטא הוא זה לדברי הכל ומה בא להשמיענו ולפסוק הלכה במה שלא נחלקו וכי תימא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משום דבדיעבד נקטי' דאתא לאשמעינן דאפילו בדיעבד לא יצא ודלא כרבי אלעזר שהיה אומר דבדיעבד יצא א\"כ לא הל\"ל זה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלשון אלא והלכתא אם אמר האל הקדוש והאל המשפט לא יצא ומדקאמר ליה בהאי לישנא משמע דמעקרא רבה ורבי אלעזר אפילו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לכתחלה נחלקו דרבה היה אומר בין לכתחלה בין בדיעבד צריך שיאמר לעולם המלך הקדוש והמלך המשפט ורבי אלעזר אומר שאפי'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לכתחלה אם ירצה יכול לומר האל הקדוש והאל המשפט ומאי דאמר אם אמר האל הקדוש והאל המשפט יצא ר\"ל שאם ירצה יאמר המלך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקדוש ואם ירצה יאמר האל הקדוש ואפילו לכתחלה אינו תלוי אלא ברצונו ולפיכך פסק התלמוד כרבה ואמר והלכתא המלך הקדוש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר אין לו לומר בשום ענין אלא המלך הקדוש והמלך המשפט וא\"ת מנא לן דרבה ס\"ל דבדיעבד לא יצא דע\"כ לא שמעי' דאמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא שמתפלל המלך הקדוש והמלך המשפט ואפשר שסובר שכך צריך לומר לכתחלה אבל בדיעבד יצא והיכי פסק תלמודא אליבא דידיה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלעולם לא יצא כלל י\"ל שמתוך דברי ר\"א שאמר אם אמר האל הקדוש והאל המשפט יצא שמעינן דרבה ס\"ל דלא יצא אפי' בדיעבד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דכיון דר\"א ס\"ל דאפי' לכתחלה אם ירצה יכול לומר האל הקדוש והאל המשפט לא היה לו לומר לשון יצא דמשמע דיעבד דוקא אלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ודאי משום דשמע ליה לרבה דאמר לא יצא ואפילו דיעבד נקט ר' אלעזר יצא ומש\"ה פסק תלמודא אליבא דידיה דלעולם צ\"ל המלך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקדוש והמלך המשפט ואם לאו לא יצא ואפי' דיעבד והיינו דכתב הרי\"ף ז\"ל ומדאסיקנא הכי שמעינן ליה דליתא לדרבי אלעזר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאמר אם אמר האל הקדוש והאל המשפט יצא אלא לא יצא וצריך לחזור דמשמע דס\"ל דרבה ואפי' בדיעבד היה אומר דלא יצא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כדכתבינן ורבני צרפת ז\"ל חולקין על זה הפסק ואומרים דאם אמר בדיעבד האל הקדוש והאל המשפט יצא משום דס\"ל דפלוגתא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דרבה ורבי אלעזר הוו בהכי דרבי אלעזר סבר דאפי' לכתחלה יכול לומר האל הקדוש אם ירצה כדכתבינן ורבה ס\"ל דלכתחלה צריך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לומר המלך הקדוש והמלך המשפט אבל בדיעבד אם אמר האל הקדוש והאל המשפט יצא ונמצא שכשפסק התלמוד אליבא דרבה לא פסק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא לענין לכתחלה בלבד אבל בדיעבד יצא והוצרכו לפרש כן משום דלא שמעינן ליה לרבה דאמר דלא יצא בדיעבד ואין זה נראה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמדברי ר' אלעזר שאמר יצא שמעינן לרבה שהיה אומר דאפי' דיעבד לא יצא כדכתבי' לעיל הלכך בעשרה ימים שבין ר\"ה ליוה\"כ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אם לא אמר המלך הקדוש והמלך המשפט צריך לחזור:",
      "segment_ids": [
        2
      ]
    }
  ],
