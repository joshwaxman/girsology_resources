  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>להגיד בבקר חסדך ואמונתך בלילות.</b> פי' האמונה שהבורא עושה עמנו בכל יום שאנו מפקידין נשמתנו בידו והוא מחזירן אלינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשבח שהנשמות הולכות עייפות מהעמל שטורחים בני אדם כל היום לבקש פרנסתם ובבקר הן שבות במנוחה ואינו כבשר ודם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שכשמפקידין בידו פקדון מחזיר אותו כמו שנתנוהו לו ולפעמים יותר גרוע אבל הבורא יתעלה מחזיר הפקדון בשבח כאמור ועל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כך אנו משבחין אותו כל לילה כי הוא ה' אלהינו ואין זולתו ובבקר אנו משבחין אותו עם יציאת מצרים ועם החסד שעשה עמנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שגאלנו להיות לו לעבדים:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כשהוא</b> כורע כורע בברוך וכשהוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זוקף זוקף בשם ובגמ' פריך והא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב מפני שמי נחת הוא והכא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמרינן שזוקף בשם ומתרץ מי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב בפני שמי אלא מפני שמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשמע קודם שיזכיר השם דהיינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשמזכיר ברוך והטעם להיות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כורע בברוך ולזקוף בשם מפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבשעה שכורע מראה הפחד והיראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש מלפניו וכשזוקף מראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבטחון שיש לו בו בכל עניניו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיטיב אליו וזה תלוי בזה שמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שירא מהש\"י הוא בוטח בו כענין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנאמר ביראת ה' מבטח עוז",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(משלי יד): <b>ואסיקנא</b> והלכתא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המלך הקדוש והמלך המשפט אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפרש דר' אלעזר היה אומר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלכתחלה לא יצא אלא בדיעבד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאם איתא דרבה ור' אלעזר בהאי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פליגי דרבה ס\"ל בין לכתחלה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין בדיעבד צריך שיאמר המלך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הקדוש והמלך המשפט ור' אלעזר ס\"ל דלכתחלה צריך שיאמר המלך הקדוש והמלך המשפט אבל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בדיעבד אם אמר האל הקדוש והאל המשפט יצא א\"כ לא היה לו לומר במסקנא לשון והלכתא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המלך הקדוש והמלך המשפט דלשון והלכתא ר\"ל שכך יש לו <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>לומר ולא בענין אחר וכיון דבין רבה ובין ר\"א תרווייהו ס\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לכתחלה צריך שיאמר המלך הקדוש והמלך המשפט מה הוצרך לומר אח\"כ והלכתא (צ\"ל) המלך המשפט והמלך הקדוש דפשיטא הוא זה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לדברי הכל ומה בא להשמיענו ולפסוק הלכה במה שלא נחלקו וכי תימא משום דבדיעבד נקטי' דאתא לאשמעינן דאפילו בדיעבד לא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יצא ודלא כרבי אלעזר שהיה אומר דבדיעבד יצא א\"כ לא הל\"ל זה הלשון אלא והלכתא אם אמר האל הקדוש והאל המשפט לא יצא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומדקאמר ליה בהאי לישנא משמע דמעקרא רבה ורבי אלעזר אפילו לכתחלה נחלקו דרבה היה אומר בין לכתחלה בין בדיעבד צריך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שיאמר לעולם המלך הקדוש והמלך המשפט ורבי אלעזר אומר שאפי' לכתחלה אם ירצה יכול לומר האל הקדוש והאל המשפט ומאי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאמר אם אמר האל הקדוש והאל המשפט יצא ר\"ל שאם ירצה יאמר המלך הקדוש ואם ירצה יאמר האל הקדוש ואפילו לכתחלה אינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תלוי אלא ברצונו ולפיכך פסק התלמוד כרבה ואמר והלכתא המלך הקדוש כלומר אין לו לומר בשום ענין אלא המלך הקדוש והמלך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המשפט וא\"ת מנא לן דרבה ס\"ל דבדיעבד לא יצא דע\"כ לא שמעי' דאמר אלא שמתפלל המלך הקדוש והמלך המשפט ואפשר שסובר שכך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צריך לומר לכתחלה אבל בדיעבד יצא והיכי פסק תלמודא אליבא דידיה דלעולם לא יצא כלל י\"ל שמתוך דברי ר\"א שאמר אם אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "האל הקדוש והאל המשפט יצא שמעינן דרבה ס\"ל דלא יצא אפי' בדיעבד דכיון דר\"א ס\"ל דאפי' לכתחלה אם ירצה יכול לומר האל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקדוש והאל המשפט לא היה לו לומר לשון יצא דמשמע דיעבד דוקא אלא ודאי משום דשמע ליה לרבה דאמר לא יצא ואפילו דיעבד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נקט ר' אלעזר יצא ומש\"ה פסק תלמודא אליבא דידיה דלעולם צ\"ל המלך הקדוש והמלך המשפט ואם לאו לא יצא ואפי' דיעבד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והיינו דכתב הרי\"ף ז\"ל ומדאסיקנא הכי שמעינן ליה דליתא לדרבי אלעזר דאמר אם אמר האל הקדוש והאל המשפט יצא אלא לא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יצא וצריך לחזור דמשמע דס\"ל דרבה ואפי' בדיעבד היה אומר דלא יצא כדכתבינן ורבני צרפת ז\"ל חולקין על זה הפסק ואומרים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאם אמר בדיעבד האל הקדוש והאל המשפט יצא משום דס\"ל דפלוגתא דרבה ורבי אלעזר הוו בהכי דרבי אלעזר סבר דאפי' לכתחלה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יכול לומר האל הקדוש אם ירצה כדכתבינן ורבה ס\"ל דלכתחלה צריך לומר המלך הקדוש והמלך המשפט אבל בדיעבד אם אמר האל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקדוש והאל המשפט יצא ונמצא שכשפסק התלמוד אליבא דרבה לא פסק אלא לענין לכתחלה בלבד אבל בדיעבד יצא והוצרכו לפרש כן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משום דלא שמעינן ליה לרבה דאמר דלא יצא בדיעבד ואין זה נראה דמדברי ר' אלעזר שאמר יצא שמעינן לרבה שהיה אומר דאפי'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
