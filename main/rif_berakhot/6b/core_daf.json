  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>להגיד בבקר חסדך ואמונתך בלילות.</b> פי' האמונה שהבורא עושה עמנו בכל יום שאנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מפקידין נשמתנו בידו והוא מחזירן אלינו בשבח שהנשמות הולכות עייפות מהעמל שטורחים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בני אדם כל היום לבקש פרנסתם ובבקר הן שבות במנוחה ואינו כבשר ודם שכשמפקידין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בידו פקדון מחזיר אותו כמו שנתנוהו לו ולפעמים יותר גרוע אבל הבורא יתעלה מחזיר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפקדון בשבח כאמור ועל כך אנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משבחין אותו כל לילה כי הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה' אלהינו ואין זולתו ובבקר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אנו משבחין אותו עם יציאת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצרים ועם החסד שעשה עמנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שגאלנו להיות לו לעבדים:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כשהוא</b> כורע כורע בברוך וכשהוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זוקף זוקף בשם ובגמ' פריך והא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב מפני שמי נחת הוא והכא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמרינן שזוקף בשם ומתרץ מי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב בפני שמי אלא מפני שמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשמע קודם שיזכיר השם דהיינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשמזכיר ברוך והטעם להיות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כורע בברוך ולזקוף בשם מפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבשעה שכורע מראה הפחד והיראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש מלפניו וכשזוקף מראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבטחון שיש לו בו בכל עניניו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיטיב אליו וזה תלוי בזה שמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שירא מהש\"י הוא בוטח בו כענין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנאמר ביראת ה' מבטח עוז",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(משלי יד): <b>ואסיקנא</b> והלכתא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המלך הקדוש והמלך המשפט אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לפרש דר' אלעזר היה אומר דלכתחלה לא יצא אלא בדיעבד דאם איתא דרבה ור' אלעזר בהאי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פליגי דרבה ס\"ל בין לכתחלה בין בדיעבד צריך שיאמר המלך הקדוש והמלך המשפט ור'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלעזר ס\"ל דלכתחלה צריך שיאמר המלך הקדוש והמלך המשפט אבל בדיעבד אם אמר האל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הקדוש והאל המשפט יצא א\"כ לא היה לו לומר במסקנא לשון והלכתא המלך הקדוש והמלך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המשפט דלשון והלכתא ר\"ל שכך יש לו <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>לומר ולא בענין אחר וכיון דבין רבה ובין ר\"א",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תרווייהו ס\"ל לכתחלה צריך שיאמר המלך הקדוש והמלך המשפט מה הוצרך לומר אח\"כ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והלכתא (צ\"ל) המלך המשפט והמלך הקדוש דפשיטא הוא זה לדברי הכל ומה בא להשמיענו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולפסוק הלכה במה שלא נחלקו וכי תימא משום דבדיעבד נקטי' דאתא לאשמעינן דאפילו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בדיעבד לא יצא ודלא כרבי אלעזר שהיה אומר דבדיעבד יצא א\"כ לא הל\"ל זה הלשון אלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והלכתא אם אמר האל הקדוש והאל המשפט לא יצא ומדקאמר ליה בהאי לישנא משמע דמעקרא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רבה ורבי אלעזר אפילו לכתחלה נחלקו דרבה היה אומר בין לכתחלה בין בדיעבד צריך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיאמר לעולם המלך הקדוש והמלך המשפט ורבי אלעזר אומר שאפי' לכתחלה אם ירצה יכול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לומר האל הקדוש והאל המשפט ומאי דאמר אם אמר האל הקדוש והאל המשפט יצא ר\"ל שאם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ירצה יאמר המלך הקדוש ואם ירצה יאמר האל הקדוש ואפילו לכתחלה אינו תלוי אלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ברצונו ולפיכך פסק התלמוד כרבה ואמר והלכתא המלך הקדוש כלומר אין לו לומר בשום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ענין אלא המלך הקדוש והמלך המשפט וא\"ת מנא לן דרבה ס\"ל דבדיעבד לא יצא דע\"כ לא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמעי' דאמר אלא שמתפלל המלך הקדוש והמלך המשפט ואפשר שסובר שכך צריך לומר לכתחלה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל בדיעבד יצא והיכי פסק תלמודא אליבא דידיה דלעולם לא יצא כלל י\"ל שמתוך דברי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"א שאמר אם אמר האל הקדוש והאל המשפט יצא שמעינן דרבה ס\"ל דלא יצא אפי' בדיעבד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכיון דר\"א ס\"ל דאפי' לכתחלה אם ירצה יכול לומר האל הקדוש והאל המשפט לא היה לו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לומר לשון יצא דמשמע דיעבד דוקא אלא ודאי משום דשמע ליה לרבה דאמר לא יצא ואפילו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דיעבד נקט ר' אלעזר יצא ומש\"ה פסק תלמודא אליבא דידיה דלעולם צ\"ל המלך הקדוש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והמלך המשפט ואם לאו לא יצא ואפי' דיעבד והיינו דכתב הרי\"ף ז\"ל ומדאסיקנא הכי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמעינן ליה דליתא לדרבי אלעזר דאמר אם אמר האל הקדוש והאל המשפט יצא אלא לא יצא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וצריך לחזור דמשמע דס\"ל דרבה ואפי' בדיעבד היה אומר דלא יצא כדכתבינן ורבני צרפת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל חולקין על זה הפסק ואומרים דאם אמר בדיעבד האל הקדוש והאל המשפט יצא משום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דס\"ל דפלוגתא דרבה ורבי אלעזר הוו בהכי דרבי אלעזר סבר דאפי' לכתחלה יכול לומר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האל הקדוש אם ירצה כדכתבינן ורבה ס\"ל דלכתחלה צריך לומר המלך הקדוש והמלך המשפט",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל בדיעבד אם אמר האל הקדוש והאל המשפט יצא ונמצא שכשפסק התלמוד אליבא דרבה לא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פסק אלא לענין לכתחלה בלבד אבל בדיעבד יצא והוצרכו לפרש כן משום דלא שמעינן ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לרבה דאמר דלא יצא בדיעבד ואין זה נראה דמדברי ר' אלעזר שאמר יצא שמעינן לרבה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהיה אומר דאפי' דיעבד לא יצא כדכתבי' לעיל הלכך בעשרה ימים שבין ר\"ה ליוה\"כ אם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא אמר המלך הקדוש והמלך המשפט צריך לחזור:",
      "segment_ids": [
        2
      ]
    }
  ],
