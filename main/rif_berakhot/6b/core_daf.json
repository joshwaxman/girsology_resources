    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשם ר\"י ז\"ל ותמיהני למה מחזירין אותו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
