        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקדוש נקדש בצדקה וגו' מאי הוי עלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואסיקנא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>והלכתא המלך הקדוש והמלך המשפט",
