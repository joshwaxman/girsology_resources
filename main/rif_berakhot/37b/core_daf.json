      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דייסא בפת אא\"כ אוכל ממנו מעט בכל פעם:",
      "segment_ids": [
