      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא כזית טעון ברכה לאחריו ויש אומרים",
      "segment_ids": [
