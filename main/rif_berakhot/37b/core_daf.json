      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיברך בכוס ואין מברכין בו עד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיתן לתוכו מים מפני שהיינות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלהם היו חזקים ואין השבח",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניכר בתוכו עד שיהיה בו מים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמו שנפרש לקמן בס\"ד: <b>אין</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מניחין בשר חי על הפת טעמא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמילתא משום דמימאיס ועוד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפשר לתת בזה טעם אחר מפני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיצטרך להדיחו מפני הדם הנדבק",
      "segment_ids": [
