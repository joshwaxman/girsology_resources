      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הדין דאוכלין דייסא וחביצא בפת עצמו",
      "segment_ids": [
