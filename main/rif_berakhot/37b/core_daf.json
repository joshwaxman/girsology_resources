      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מברכין עליו עד שיתן לתוכו</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מים וכו'.</b> פירוש ברכה טעונה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כוס והיכא שיש לו יין יש לו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לברך ברכת המזון בכוס אפי'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היחיד שמברך בלא זימון צריך",
      "segment_ids": [
