      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעבור היחיד שבירך ומצטרף עם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השנים לפטרן מזימון וכ\"כ ר\"מ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל: <b>מתני' אין מברכין על</b>",
