      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומיימוני פסקו כרבינו ואוסרין לאכול",
      "segment_ids": [
