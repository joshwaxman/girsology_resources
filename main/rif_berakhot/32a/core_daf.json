      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתמרי נמי מיזן זייני ואם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איתא דברכה אחת מעין שלש היא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן התורה האיך היה אומר שאם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמר במקומה ברכת הזן יצא אלא",
