  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גמ' באוכלי פירות גינוסר שנינו.</b> פי' פירות גינוסר הם מתוקים ביותר ואינם נאכלים אלא עם מלח הרבה כדי שהמתיקה לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יזיק להם ואוכלים אותם עם הפת ונמצא שהפת טפיל' אל הפירות ולפיכך מברך על הפירות ופוטר את הפת: <b>מתני' אכל תאנים</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ענבים ורמונים מברך עליהם ג' ברכות דברי ר\"ג וכו'.</b> מפרש בגמ' דסבירא ליה לר\"ג דכיון דכתב רחמנא בשבח א\"י שבעת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המינים וכתב מיד באותה הפרשה ואכלת ושבעת וברכת וגו' למדנו שכולם צריכות שלש ברכות כמו חטה ושעורה ורבנן ס\"ל ארץ",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשר לא במסכנות פסק הענין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר כיון שמצינו שהפסיק בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרא דארץ חטה ושעורה ובין קרא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דואכלת ושבעת אינו חוזר לכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מה שאמר בפסוק של ארץ חטה אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>חטה ושעורה ומתוך כך הזכיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואכלת ושבעת וברכת גבי תאכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בה לחם ללמדנו שעל הלחם בלבד",
      "segment_ids": [
