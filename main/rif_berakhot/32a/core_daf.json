      "right": "275px",
      "text": "ברכות דברי ר\"ג וחכ\"א ברכה אחת מעין שלש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ר\"ע אומר אפי' אבל שלוק והוא מזונו מברך",
