        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואין טעונין ברכה לאחריהם וכן אמר רב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נחמן ורב ששת אמר טעונין ברכה בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפניהם בין לאחריהם שאין לך דבר שטעון",
      "segment_ids": [
