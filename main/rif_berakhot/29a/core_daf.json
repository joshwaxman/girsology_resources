    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפניו ולא יהיה טעון ברכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאחריו מעין הברכה שלפניו אלא",
      "segment_ids": [
