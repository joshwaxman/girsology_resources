  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "כל המוקדם בפסוק זה הוא קודם לברכה אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה זה שני לארץ וזה חמישי לארץ אמר ליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאן יהיב לן נגרי דפרזלא ונשמעינן:",
