        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פת הבאה בכסנין בלבד ופליגא דרבי חייא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמר רבי חייא פת <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>פוטרת כל מיני מאכל",
