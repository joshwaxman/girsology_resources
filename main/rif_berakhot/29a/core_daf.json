        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלכתא דברים הבאים <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Blessings\" data-label=\"⚬\"></i>מחמת <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>הסעודה בתוך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הסעודה אין טעונין ברכה לא לפניהם",
      "segment_ids": [
        2
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שאין</b> לך דבר שטעון ברכה לפניו ואין טעון ברכה לאחריו אלא פת הבאה בכסנין פרש\"י",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל דכסנין הוא מיני קליות כדאמרי' (עירובין דף כט:) כיסני מעלו ללבא וכדאמרי'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בכתובות (דף יז:) ארמלתא לית לה כסני ומנהגם היה לאכול תחלה הקליות ואחר הקליות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היו אוכלין פת ידוע שהיו בו מיני תבלים הרבה ומפני התבלים אין דרך לאכול ממנו כל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כך ומש\"ה אמרו שזה הפת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאוכלין אחר הקליות שטעון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכה לפניו במ\"מ ואין טעון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכה לאחריו ופי' הרב ז\"ל",
      "segment_ids": [
