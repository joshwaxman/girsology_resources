        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרואה מעברות הים ומעברות הירדן ומעברות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נחל ארנון ואבני אלגביש של בית חורון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואבן שזרק עוג מלך הבשן במשה ואבן שישב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליה משה בשעה שנלחם בעמלק ואשתו של לוט",
