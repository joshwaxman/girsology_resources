  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גמ' אניסא דרבים כ\"ע צריכי לברוכי וכו'.</b> כלומר שנעשה לכל ישראל או לרובן כגון מעברות הירדן וכל אותן שמפרש בברייתא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כ\"ע צריכי לברוכי שעשה נסים לאבותינו במקום הזה ובכי ה\"ג מיירי מתני' אבל אניסא דיחיד הוא ובריה ובר בריה בלחוד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צריכי לברוכי הוא מברך שעשה לי נס במקום הזה ובריה ובר בריה מברכין שעשה נס לאבותי במקום הזה וכל נס שאינו נעשה לכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ישראל או לרובן נקרא של יחיד ואינו מברך עליו אלא הוא ובריה ובר בריה בלבד: <b>ארבעה צריכין להודות יורדי הים וכו'.</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נשאל מרבינו האי גאון ז\"ל למה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא אמר אותם כסדר שכתובין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במזמור והשיב שרצה למנות תחלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותם שהם מסוכנים יותר שיורדי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הים והולכי מדברות הם בסכנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יותר מהחולה שרוב החולים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרפואה וחבוש רוב הפעמים הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חבוש בעבור ממון ואין סכנתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל כך אבל במזמור הזכיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המצוים יותר תחלה ומנהג הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בצרפת שאינם מברכין ברכת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגומל כשהולכין מעיר לעיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שאומרים שלא הצריכו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להודות אלא להולכי מדברות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא סכנה מחיות רעות ומלסטים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל להולכי דרכים לא ומה שאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בירושלמי כל הדרכים בחזקת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סכנה הם עומדים לא אמרו זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא לענין תפלת יוצא לדרך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלבד שבכל הדרכים יש לו לבקש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על נפשו. זה דעת רבני צרפת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל: <b>אמרי ליה בריך רחמנא</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דיהבך לן ולא יהבך לעפרא.</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נראה ששם ומלכות היו מזכירין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בה והיו אומרים בריך רחמנא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלהנא מלכא דעלמא דאל\"כ היאך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה נפטר הוא מלומר ברכת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגומל בעניית אמן דהא קי\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכל ברכה שאין בה <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>מלכות אינה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכה והיאך אפשר שיפטר מברכה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש בה <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>מלכות בעניית אמן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לברכה שאין בה <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>מלכות אלא ודאי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>זו בין כל הברכות הנזכרות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרקין כשאומר בהן הזכרת השם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומלכות מיירי: <b>אמר להו רב</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יהודה פטרתון מלאודויי.</b> כלומר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בברכה זו שברכתם אתם ושמעתי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אני אותה נפטרתי מלברך ברכת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגומל ומקשה התלמוד האיך אמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנפטר בזה והאמר אביי וצריך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאודויי באפי עשרה ומהדרינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהוו שם י' וענה איהו אמן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולפיכך נפטר בזה למדנו משם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאם יש שם עשרה וברכו ברכה זו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וענה החולה אמן אין צריך לברך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכה אחרת ואם אין שם י' צריך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לברך ונראה שהם יכולים לאומרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפי' בלא עשרה אע\"פ שאין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החולה נפטר בה. מפי מורי הרב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נר\"ו: <b>שלשה צריכין שימור חולה</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חיה וכלה.</b> מפני שהשטן מקטרג",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשעת הסכנה ובשעת השמחה:",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וניכוון וניסק בהדי כהני</b>",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> ואם אין עושין נשיאות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כפים יכוין שישלים כשיגיע ש\"צ",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למברך את עמו ישראל כדי שיענו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כולם אמן: <b>הרואה את המרקוליס</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> י\"מ דה\"ה לשאר ע\"ז אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאמר זו שהיו עובדים אותה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בימיהם יותר וי\"מ דדוקא נקט",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מרקוליס מפני שדרכן להשליך לה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבנים ולאותם אבנים שמשליכים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הם עובדין ומפני שהע\"ז היא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתחדשת בכל יום התקינו לברך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליה שנתן ארך אפים לעוברי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רצונו: <b>הרואה בבל מברך חמש</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ברכות.</b> הני דמפרש ואזיל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשרואה כל אחת ואחת: <b>ראה</b> מקום",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנוטלין ממנו עפר נראה לפרש",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנוטלין ממנו עפר לטיט וקרא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוטאטאתיה ר\"ל אעשה ממנה טיט",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודומה לו ושרשך שר\"ל יסיר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השרש וי\"מ בענין אחר: <b>הרואה</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אוכלסי ישראל מברך ברוך חכם</b>",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הרזים.</b> ובגמ' (דף נח:) אומר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאם ראה אדם חשוב וגדול בתורה שמברך עליו ברוך חכם הרזים:",
      "segment_ids": [
        9
      ]
    }
  ],
