  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר ברוך דיין האמת: <b><big>גמ'</big></b> <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>על ניסא דרבים",
      "segment_ids": [
