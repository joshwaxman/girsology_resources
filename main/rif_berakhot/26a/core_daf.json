    "lines": [
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"0\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 36b:18\">ודובשא ומשחא: חמשת מינין. חטה</i> <i class=\"ror-line ror-read\" data-ror-i=\"1\" data-ror-conf=\"read\" data-ror-ref=\"\">ושעורה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"1\" data-ror-conf=\"read\" data-ror-ref=\"\">שבולת שועל שיפון כוסמין:</i> <i class=\"ror-line ror-read\" data-ror-i=\"2\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">הכוסס את</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"2\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">החטה. שאכלה חיה: טחנה</i> <i class=\"ror-line ror-read\" data-ror-i=\"3\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">ואפאה. בתנור</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"3\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">ואח\"כ בישלה בקדירה:</i> <i class=\"ror-line ror-read\" data-ror-i=\"4\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">בזמן שהפרוסות</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"4\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">קיימות. שלא נימוחו</i> <i class=\"ror-line ror-read\" data-ror-i=\"5\" data-ror-conf=\"read\" data-ror-ref=\"\">בבישולן ויש בו</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"5\" data-ror-conf=\"read\" data-ror-ref=\"\">פרוסות קיימות כזית וי\"מ</i> <i class=\"ror-line ror-read\" data-ror-i=\"6\" data-ror-conf=\"read\" data-ror-ref=\"\">שהלחם אין שרוי</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"6\" data-ror-conf=\"read\" data-ror-ref=\"\">במים כל כך שאם יקח</i> <i class=\"ror-line ror-read\" data-ror-i=\"7\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">הפרוסות לא ישבר:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"7\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">ברכה אחת מעין</i> <i class=\"ror-line ror-read\" data-ror-i=\"8\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">שלש. על המחיה ועל</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"8\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37a:6\">הכלכלה: והני מילי</i> <i class=\"ror-line ror-read\" data-ror-i=\"9\" data-ror-conf=\"read\" data-ror-ref=\"\">בדאיתיה לאורז</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"9\" data-ror-conf=\"read\" data-ror-ref=\"\">בעיניה. כלומר שבישלו</i> <i class=\"ror-line ror-read\" data-ror-i=\"10\" data-ror-conf=\"read\" data-ror-ref=\"\">בלא תערובת קמח אז</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"10\" data-ror-conf=\"read\" data-ror-ref=\"\">מברך בתחלה (ב) ב\"פ</i> <i class=\"ror-line ror-read\" data-ror-i=\"11\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37b:2\">האדמה ולבסוף ב\"נ</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"11\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37b:2\">רבות כו' אבל ע\"י</i> <i class=\"ror-line ror-read\" data-ror-i=\"12\" data-ror-conf=\"read\" data-ror-ref=\"\">תערובת קמח חשיב כמו</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"12\" data-ror-conf=\"read\" data-ror-ref=\"\">תבשיל דחמשת</i> <i class=\"ror-line ror-read\" data-ror-i=\"13\" data-ror-conf=\"read\" data-ror-ref=\"\">מינין [א] ועם תערובות</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"13\" data-ror-conf=\"read\" data-ror-ref=\"\">תבשיל אחר</i> <i class=\"ror-line ror-read\" data-ror-i=\"14\" data-ror-conf=\"read\" data-ror-ref=\"\">והתבשיל הוא הרוב מברך עליו</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"14\" data-ror-conf=\"read\" data-ror-ref=\"\">כברכת</i> <i class=\"ror-line ror-read\" data-ror-i=\"15\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37b:4\">התבשיל: ריפתא. עשוי כעין חביץ</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"15\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37b:4\">קדרא</i> <i class=\"ror-line ror-read\" data-ror-i=\"16\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37b:4\">בקמח ושמן ודבש: בין דמפשי ביה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line ror-read\" data-ror-i=\"16\" data-ror-conf=\"read\" data-ror-ref=\"Rashi on Berakhot 37b:4\">קמחא.</i> <i class=\"ror-line ror-read\" data-ror-i=\"17\" data-ror-conf=\"read\" data-ror-ref=\"\">שנתנו בו קמח הרבה: הבילא. שלוקות</i>"
      }
    ]
