  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב הרא\"ש נראה דכל השבוע מקרי עם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
