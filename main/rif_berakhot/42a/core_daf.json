      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו רביעית בב' פעמים אפ\"ה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון שאין הכלי מחזיק רביעית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין נוטלין ממנו לידים דלאו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלי הוא: <b>קפדיתו אמנא.</b> שיהיה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכלי מחזיק רביעית: <b>קפדיתו</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אחזותא.</b> שהמראה יפסול בנטילה",
      "segment_ids": [
