        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התירו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>במפה לאוכלי טהרות איבעיא להו",
