        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ועד בכלל ודיקא נמי דקתני העיד רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה בן בבא על תמיד של שחר שקרב בארבע",
