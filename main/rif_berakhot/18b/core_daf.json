    {
      "width": "380px",
      "right": "275px",
      "text": "שהרי תמיד של בין הערבים היה קרב והולך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד פלג המנחה ומפני מה אמרו תפלת הערב",
