      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היא מנחה גדולה משש שעות ומחצה ולמעלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואי זו היא מנחה קטנה מתשע שעות ומחצה",
