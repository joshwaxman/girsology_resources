      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"מנחה קטנה. זמן תמיד של בין הערטם\">בין הערבים</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"בכל יום הוא מתשע שעות ומחצה ולמעלה\">בכל יום מתשע שעות ומחצה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"בכל יום הוא מתשע שעות ומחצה ולמעלה\">ולמעלה</i> <i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"כלתנן תמיד נשמט בשמנה וממצה וקרב\">כדתנן בתמיד נשחט (ד' נח.) נשחט</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"כלתנן תמיד נשמט בשמנה וממצה וקרב\">בשמונה ומחצה וקרב</i> <i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"בתשע ומתצה והתם מפרש טעמא: פלג\">בתשע ומחצה והתם מפרש</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"בתשע ומתצה והתם מפרש טעמא: פלג\">טעמא: פלג</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:13\" data-ror-ocr=\"מנחה אחרונה. חלוק את [שתי] שעות\">מנחה אחרונה – חלק את ב' שעות</i>"
      },
