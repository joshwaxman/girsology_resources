        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשכינה שתסתלק מישראל אמר רב חייא בר",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבין רב <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ה\" data-order=\"5\"></i>צלי <i data-commentator=\"Mishneh Torah, Prayer and the Priestly Blessing\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Sabbath\" data-label=\"⚬\"></i>של שבת <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ו\" data-order=\"6\"></i>בערב שבת ורבי יאשיה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צלי של מוצאי שבת בשבת איבעיא להו רב",
