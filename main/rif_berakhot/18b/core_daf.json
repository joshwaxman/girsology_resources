      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"מנחה קטנה. זמן תמיד של בין הערטם\">מנחה קטנה – זמן תמיד של בין</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"מנחה קטנה. זמן תמיד של בין הערטם\">הערבים</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 26b:12\" data-ror-ocr=\"בכל יום הוא מתשע שעות ומחצה ולמעלה\">בכל יום מתשע שעות</i>"
      },
