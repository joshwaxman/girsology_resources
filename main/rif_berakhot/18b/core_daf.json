        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מוצאי שבת בשבת אומר הבדלה על הכוס או",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אינו אומר הבדלה על הכוס ת\"ש דאמר ר'",
