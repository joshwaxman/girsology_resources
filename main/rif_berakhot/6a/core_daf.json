      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 12a:11\" data-ror-ocr=\"נזכר שהוא שכר ו א מ ר שהכל נהיה בלברו:\"><i class=\"ror-talmud-only\" data-ror-chars=\"13\">ברכה</i></i> <i class=\"ror-gap\" data-ror-gap=\"2\">⋯</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 12a:12\" data-ror-ocr=\"ברכה זו מוציאה מ י ד (ג) שכר שאינו\">ברכת היין מוציאה ידי</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 12a:12\" data-ror-ocr=\"ברכה זו מוציאה מ י ד (ג) שכר שאינו\">ברכת שכר שאין השכר מן הגפן:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 12a:13\" data-ror-ocr=\"יוצר אור: וסיים כשאמר מלך העולם\">אור – <i class=\"ror-talmud-only\" data-ror-chars=\"36\">כלומר אדעתא דלימא</i></i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 12a:13\" data-ror-ocr=\"יוצר אור: וסיים כשאמר מלך העולם\"><i class=\"ror-talmud-only\" data-ror-chars=\"36\">יוצר אור: וסיים במעריב ערבים</i></i>"
      },
