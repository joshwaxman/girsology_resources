        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ערבים יסיים ביוצר אור יצא בערבית פתח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במעריב ערבים וסיים ביוצר המאורות לא",
      "segment_ids": [
