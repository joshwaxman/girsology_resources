      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומותר דכיון שאין ריח רע מגיע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אליו כאילו היתה מכוסה בכלי",
