      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סנדלו עליה ומותר דכיון שאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ריח רע מגיע אליו כאילו היתה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכוסה בכלי דמי ומותר ואפי'",
      "segment_ids": [
