      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המטה או תחת מחיצותיה חלל ג' טפחים",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונראה בעיני שצריכה שתהיה המטה גבוהה י'",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
