      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא כמהלך מהים לטיגנא שהוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבר מועט: <b>צואה</b> בגומא פורס",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סנדלו עליה ומותר דכיון שאין",
      "segment_ids": [
