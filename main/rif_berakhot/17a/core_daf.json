    {
      "width": "380px",
      "right": "275px",
      "text": "חזי אמר אביי צואה כל שהוא מבטלה ברוק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואמר רבא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>וברוק עבה אמר רב צואה בגומא",
      "segment_ids": [
