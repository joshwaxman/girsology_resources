      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלתא באפי נפשה הוי ור\"ל היכא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכשהולך בדרך או כשעומד במקום",
      "segment_ids": [
