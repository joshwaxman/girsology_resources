        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מטתו עד שיוציאם או עד שיניחם כלי בתוך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלי אמר אביי לא",
      "segment_ids": [
        2
      ]
    }
