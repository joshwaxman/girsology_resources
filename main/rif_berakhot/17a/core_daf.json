      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמכוסים תחתיה אם לאו וספיקו להחמיר.",
      "segment_ids": [
        5
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היו מונחין אחרי המטה הרי המטה חוצצת",
      "segment_ids": [
