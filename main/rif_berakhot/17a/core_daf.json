  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב הרא\"ש ירושלמי ר' זירא ור' אבא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יתבין וחזיין צואה ר' אבא רקיק עליה א\"ר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זירא כמן ימא לטגנא כלומר אין בטול הרוק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מועיל אלא לשעה מועטת כמהלך מן הים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לטגנא שהוא דבר מועט ואח\"כ הרוק מתיבש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וחוזרת הצואה למקומה ע\"כ: <b>ב</b> כתב הרא\"ש",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הלכך המל את הגר צריך לכסות ערותו בשעת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הברכה ויש שנוהגים ג\"כ כשמלין את הקטן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וי\"א דאין צריך והסכים כרבינו יונה: <b>ג</b>",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב הרא\"ש ורבינו משה ז\"ל כתב רביעית",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למי רגלים של פעם אחת ואם יותר צריך",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להוסיף לפי השיעור: <b>ד לשון ריא\"ז</b> היו מי",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רגלים מונחין בכלי נקי שאינו מיוחד להן",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אם נתן לתוכן רביעית לוג מים מותר לקרות",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ק\"ש כנגדן בין שהיו בכלי גדול בין שהיו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בכלי קטן ואפילו אם היו מי רגלים רביעית",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריכין ד' רביעית מים לבטלן בין שהיו מי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רגלים בכלי ונתן עליהן מים בין שהיו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המים בכלי ונפל עליהן מי רגלים אם היו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מי רגלים פחות מרביעית נראה בעיני",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שצריכין מים כנגדן לבטלן כמבואר בקונטרס",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הראיות: <b>ה</b> כתב הרא\"ש ואע\"פ שאין בהם",
      "segment_ids": [
        3,
        4
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כלום ואפי' הטיל בהם רביעית מים לא מהני",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כיון דמיוחדים לכך הוה ליה כבית הכסא",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואפי' אין בהם ריח רע ומיהו בכולי",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תלמודא שמזכיר גרף ועביט מיירי בשל חרס",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ויש להסתפק אם ה\"ה הכי בעביט של עץ ושל",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זכוכית ומסתבר דבעץ אסור מפני שהוא",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מובלע בתוכו ומלא זוהמא אבל בשל זכוכית",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותר ע\"כ: <b>ו</b> הרי\"ץ גיאות פליג על זה",
      "segment_ids": [
