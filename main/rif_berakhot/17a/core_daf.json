      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נוגעת בסנדלו ומאי דבעי מר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בריה דרבינא דבוקה בסנדלו מאי",
