      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מג' ועד עשרה הרי זה ספק בתלמוד אם הם",
      "segment_ids": [
