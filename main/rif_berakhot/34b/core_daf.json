      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"17\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 47a:7\" data-ror-ocr=\"עניית אמן מן הברכה היא ואמרינן בטצד\">עניית אמן מן הברכה היא</i>"
      },
