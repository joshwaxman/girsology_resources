      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(אבות ספ\"ד). כלומר מן העוה\"ב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין זה הכבוד שלהם אלא כבוד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבורא יתברך כמו שאמר בסוף",
