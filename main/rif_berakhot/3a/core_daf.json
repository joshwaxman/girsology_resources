      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שרגיל לילך לבהכ\"נ אין למיחש אע\"פ שעיקר",
      "segment_ids": [
