      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגוים: <b>ואם</b> ת\"ח הוא א\"צ משום",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתורתו משמרתו וכדאמרינן בפ\"ק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דב\"ב (דף ח.) ומאי דאמרי' (דף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נד:) ג' צריכין שימור חולה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חיה חתן וכלה וי\"א אף ת\"ח",
      "segment_ids": [
