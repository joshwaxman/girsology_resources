      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בגירסיה ויעבור זמן תפל' וק\"ש אבל מי",
      "segment_ids": [
