      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלילה זהו כשעומד יחידי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באישון לילה ואפלה: <b>שיר של</b>",
      "segment_ids": [
