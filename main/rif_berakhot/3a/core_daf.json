      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שרגיל להתפלל בבית מדרשו ואינו רגיל",
      "segment_ids": [
