      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לילך לבהכ\"נ דאיכא למיחש דילמא טריד",
      "segment_ids": [
