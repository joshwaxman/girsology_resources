    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומפרש ואזיל שאותו שיר של",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פגעים הוא יושב בסתר עליון",
      "segment_ids": [
