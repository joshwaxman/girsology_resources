  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב הרא\"ש פרש\"י אם דילג ברכה ואח\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נזכר בה אומרה אף שלא במקומה ולא נהירא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דהא אמרי' לעיל בפרק תפלת השחר שמעון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הפקולי תקן י\"ח ברכות על הסדר לפני ר\"ג",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ביבנה ובפ\"ב דמגילה מפרש טעמא לכולהו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למה נסדרו כסדר הזה ועוד תנן במגילה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הקורא את המגילה למפרע לא יצא ותנא וכן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בהלל וק\"ש ותפלה ופרשב\"ם ז\"ל אין להם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סדר שאם טעה ודילג ברכה א' ולבסוף נזכר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ששכח יתחיל מאותה ברכה שטעה בה ויאמר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מכאן ואילך הכל על הסדר ואין צריך לחזור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאתה חונן כמו שחוזר בראשונות לראש ובג'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחרונות לעבודה וראיה לדבר מדתניא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בתוספתא דמכלתין הקורא את שמע וטעה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והשמיט בה פסוק א' לא יתחיל ויקרא אותו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פסוק עצמו אלא מתחיל מאותו פסוק וגומר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עד סוף וכן בהלל וכן במגילה ותניא נמי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בפרק ב' דמגילה שאם השמיט פסוק א'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במגילה חוזר וקורא כל הסדר מאותו פסוק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואילך והתם משוה יחד סדר תפלה ומגילה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וק\"ש ונ\"מ להך פירושא בתענית צבור שש\"ץ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קובע ברכה לעצמו ואומר עננו בין גואל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לרופא אם שכח ולא אמרה במקומה אינו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אומרה כי היה צ\"ל אח\"כ כל הברכות על",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הסדר והויא ברכה לבטלה אבל לפי' רש\"י",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אומרה במקום שנזכר ואין בה ברכה לבטלה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכן אם שכח ולא אמר המלך המשפט בין ר\"ה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ליוה\"כ דאמרי' לעיל דמחזירין אותו לפי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רש\"י יאמר אותה ברכה במקום שנזכר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולפירוש רשב\"ם יתחיל מהשיבה שופטינו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ויאמר על הסדר עכ\"ל: <b>ב</b> רש\"י פירש ואם",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        2,
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דלג אחד מן האמצעיות שאומרה במקום שנזכר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דלא כבעמוד וכן כתב רב האי וה\"ה אם טעה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ש\"צ בעננו או יחיד בהמלך המשפט ותוספות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומיימוני וסמ\"ג פסקו כהרי\"ף: <b>לשון ריא\"ז</b>",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טעה בברכות אמצעיות חוזר לתחלת ברכה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שטעה בה וגומר כל התפלה כסדר משם ולהלן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואם שנה סדר הברכות ולא אמרן כסדרן הרי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא כמתפלל תפלתו למפרע ולא יצא כמו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שביארו ר' יצחק ומז\"ה: <b>ג</b> עיין סוף פרק",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        5,
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קמא דבבא קמא שדרו של אדם לאחר שבע שנה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נעשה נחש והוא דלא כרע במודים מדה כנגד",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מדה שהיה לו לכרוע ולזקוף כנחש ולא עשה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כן לכן נעשית שדרו כנחש: <b>ד</b> מיי' כתב",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבצבור אין כורעין הרבה והטור כתב על",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דברי מיימוני ואינו משמע כן בירושלמי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאיתא התם מעשה באחד ששחה יותר מדאי",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והעבירו רבי יוחנן משמע דקאי דוקא אש\"צ",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דלא שייך העברה אלא בש\"צ ומטעם זה אין",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ליחיד להתפלל אא\"כ יכול לגמור קודם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיגיע ש\"צ למודים כדי שלא יהא נראה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ככופר אם אינו משתחוה עם הצבור ואם",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התחיל והגיע ש\"צ למודים והוא באמצע אחת",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מן הברכות ישחה אבל אם הוא בתחלת ברכה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "או בסופה לא ישחה אלא באבות או בהודאה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והא דתניא הכורע בהודאה ה\"ז מגונה",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מוקמינן לה בהודאה שבהלל ושבברכת המזון.",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טור:",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        8
      ]
    }
  ],
