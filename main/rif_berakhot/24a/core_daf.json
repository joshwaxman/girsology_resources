  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "רשאי: <b><big>גמ'</big></b> תנו רבנן <i data-commentator=\"Mishneh Torah, Prayer and the Priestly Blessing\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>העובר לפני התיבה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צריך לסרב ואם אינו מסרב דומה לתבשיל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין בו מלח ואם מסרב יותר מדאי דומה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לתבשיל שהקדיחתו מלח כיצד יעש' ראשונה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסרב שניה מהבהב שלישית פושט רגליו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויורד אמר רב הונא <i data-commentator=\"Mishneh Torah, Prayer and the Priestly Blessing\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>טעה בשלש ראשונות",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוזר לראש באמצעיות חוזר לאתה חונן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באחרונות חוזר לעבודה ורב אסי אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמצעיות <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>אין להם סדר הא שמעתא פסקו בה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קמאי הלכתא כרב אסי ואמרי אע\"ג דאקשינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה לרב הונא מהא דתנן מהיכן הוא מתחיל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתחלת הברכה שטעה ופריק בגמרא מאי מתחלת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכה שטעה זה מתחלת אתה חונן וכו' דכחדא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכה דמיין ההוא פירוקא שינויא בעלמא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא ולא סמכינן אשינויא ולא מפקינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתא מפשטה ודאי דהכין היא מילתא אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיהו חזינן לגאון דאמר היכא דטעה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באמצעיות כגון ששכח ברכה מן האמצעיות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואידכר לה לאחר שעבר את מקומה כיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דקאמר רב אסי אין להם סדר אומרה במקום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שזוכרה ודיו ואנן קשיא לן האי מימרא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דגאון דהא בהדיא גרסינן <span class=\"bavli-ref\" data-bavli-ref=\"(לעיל דף כח:)\" data-bavli-daf=\"28b\" data-bavli-scope=\"לעיל\" data-bavli-index=\"0\"></span>שמעון הפקולי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הסדיר שמונה עשרה ברכות לפני רבן גמליאל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על הסדר ביבנה וגרסיגן במגלה <span class=\"bavli-ref\" data-bavli-ref=\"(דף יז.)\" data-bavli-daf=\"17a\" data-bavli-index=\"1\"></span>בענין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקורא את המגלה למפרע לא יצא (שם ע\"ב)",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנא וכן בהלל וכן בק\"ש וכן בתפלה תפלה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנא להו דתניא שמעון הפקולי הסדיר שמונה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשרה ברכות על הסדר ושמעינן מהא דהיכא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלא אמרן על הסדר לא יצא ואם כן היכי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרינן היכא דשכח ברכה במקומה ובירך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכה של אחריה ואחר כך נזכר שטעה שאומרה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במקום שזוכרה ודיו הלא בטל את הסדר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכות ונמצא כמברך למפרע ועוד הא תני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהדיא בהאי תוספתא דכתיב בה קרא את",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המגלה וטעה והשמיט בה פסוק אחד לא יחזיר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויקרא אותו הפסוק בפני עצמו אלא מתחיל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאותו הפסוק וגומר עד סוף וכן בהלל וכן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתפלה וכן בק\"ש ואי אמרת דאמר רב אסי אם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טעה והשמיט ברכה אחת ואחר כך נזכר שטעה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאומרה במקום שזוכרה ודיו אם כן הוה ליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב אסי פליג אמתניתא וליכא למימר הכי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאי הוה רב אסי פליג אמתניתא הוה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותבינן ליה תיובתא מינה ומדלא אותבינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליה מינה שמעי' דלא פליג רב אסי על הא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתא אלא דרב אסי לחוד ודמתניתא לחוד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והא דאמר רב אסי אין להם סדר לאו למימרא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאין להם סדר כלל אלא דלא למהוי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>כשלש",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשונות וכשלש אחרונות דאילו שלש",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשונות היכא דטעה בחדא מינייהו ואפילו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשלישית חוזר לראש וכן בשלש אחרונות אבל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באמצעיות היכא דטעה בברכה ונזכר לאחר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שעבר את מקומה אינו חוזר לאתה חונן אלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לתחלת אותה ברכה שטעה בה ורב הונא סבר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבאמצעיות חוזר לאתה חונן דסבירא ליה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמצעיות כולהו כחדא ברכה דמיין ולית",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלכתא כוותיה: <b><big><i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>מתני'</big></b> אלו ברכות שאדם",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>שוחה בהן באבות תחלה וסוף בהודאה תחלה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וסוף ואם בא לשחות בסוף כל ברכה וברכה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובתחלת כל ברכה וברכה מלמדין אותו שלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישחה: <b><big>גמ'</big></b> <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>אמר ר' תנחום אמר ר' יהושע בן",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לוי המתפלל צריך שיכרע עד שיתפקקו כל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוליות שבשדרה עולא אמר עד <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>שיראה איסר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כנגד לבו רבי חנינא אומר כיון שנענע",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בראשו שוב אינו צריך רבא אמר והוא דמצער",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נפשיה ומתחזי כמאן דכרע: ירושלמי פרק",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאימתי <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">הל\"ה</i><i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>הכל <i data-commentator=\"Tur\" data-label=\"⚬\"></i>שוחין עם שליח הצבור",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהודאה רבי זעירא אמת ובלבד במודים <span class=\"bavli-ref\" data-bavli-ref=\"(דף לד:)\" data-bavli-daf=\"34b\" data-bavli-index=\"2\"></span>תניא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכורע בהודאה של הלל ובהודאה של ברכת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המזון הרי זה מגונה: גרסינן בפרק הוציאו",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו את הכף ואת המחתה <span class=\"bavli-ref\" data-bavli-ref=\"(דף נג:)\" data-bavli-daf=\"53b\" data-bavli-index=\"3\"></span>אמר ר' אלכסנדרי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יהושע בן לוי <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>המתפלל צריך",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיפסיע שלש פסיעות",
      "segment_ids": [
        9
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>טעה</b> בג' ראשונות חוזר לראש אומרים רבני צרפת ז\"ל שאם טעה בר\"ה ולא הזכיר זכרנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "באבות או מי כמוך בתחיית המתים שחוזר לראש התפלה וזה תימה דכיון שאינו מעיקר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "התפלה למה חוזר הברכה בעבור זה ואפי' לדבריהם אינו חוזר הברכה אלא בר\"ה ויוה\"כ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בלבד שהן עיקר הדין והחתימה ויש בהם קרבן מוסף אבל בימים שבנתים נראה דדברי הכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין מחזירין אותו. מפי מורי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרב נר\"ו: <b>ורב</b> אסי אמר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמצעיות אין להם סדר רבינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האי גאון ורש\"י ז\"ל פירשו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין להם סדר כלל ואם טעה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושכח ברכה אחת ואחר שאמר ב'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכות או ג' נזכר ששכח אותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א\"צ לחזור לתחלת הברכה שטעה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בה אלא אומרה במקום שזוכרה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולדבריהם אם שכח ג\"כ בהשיבה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שופטינו ולא אמר המלך המשפט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין צריך לחזור להשיבה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שופטינו אלא אומר ברכת השיבה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שופטינו אחר הברכה שנזכר בה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והרי\"ף ז\"ל הקשה על זה דא\"כ",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוה ליה קורא הברכות למפרע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובהדיא אמרי' הקורא את המגילה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למפרע לא יצא וכן בק\"ש וכן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתפלה ולא מצית לדחות ולומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דה\"מ לכתחלה אבל בדיעבד כגון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה ששכח ונזכר אח\"כ יצא דהא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן בתוספתא בהדיא הקורא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את המגילה והשמיט בה פסוק א'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך לחזור מאותו פסוק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואמרינן התם וכן בתפלה דמשמע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאפי' בדיעבד אם טעה ושכח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הברכה או שטעה ולא אמר המלך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המשפט בברכת השיבה שופטינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוזר לתחלת הברכה שטעה בה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומאי דאמרינן אין להם סדר ר\"ל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין להם סדר כמו שלש ראשונות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושלש אחרונות דאילו בראשונו'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובאחרונות חוזר לראש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובאמצעיות אינו חוזר לאתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חונן אלא לתחלת ברכה שטעה בה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדמפרש ואזיל בהלכות: <b>אלו</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכות שאדם שוחה בהם באבות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תחלה וסוף יש נותנים סמך לדבר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדכתיב ואקוד ואשתחוה לה'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואברך את ה' אלהי אדוני אברהם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשמע כשאברך אליו אקוד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואשתחוה דהיינו ב' פעמים:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מלמדין</b> אותו שלא ישחה אית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרי משום דמיחזי כיוהרא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמחזיק עצמו כאדם כשר יותר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משאר הצבור א\"נ מפני שנראה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סותר תקנת חכמים ופורש ממה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהצבור עושין. ומדקאמר בסוף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל ברכה וברכה למדו מקצת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המפרשים דדוקא בתחלת ברכה או",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסוף ברכה אמרו שלא ישחה אבל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באמצע הברכה שוחה שכיון שאין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרך לשחות באבות ובמודים אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתחלה וסוף בלבד והוא אינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שוחה בענין שידמה שמוסיף על",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מה שתקנו חכמים מותר ומזה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הטעם נוהגין בר\"ה וביוה\"כ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשחות בזכרנו ובמי כמוך: <b>עד</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שיתפקקו כל חוליות שבשדרה.</b>",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר שישחה כל כך שיבלטו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוליות השדרה לאחריו והוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלשון פקק הגפן שר\"ל קשר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבגפן שבולט לחוץ: <b>עד</b> שיראה",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איסר כנגד לבו פירש\"י ז\"ל דכל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כך צריך לשחות שחברו העומד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כנגדו לא יכול לראות כנגד לבו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא כשיעור איסר בלבד ורבינו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האי גאון ז\"ל פירש שצריך",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שישחה כל כך שאם היה איסר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עומד בקרקע כנגד לבו שהשוחה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו יראה אותו ועוד פירש",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שישחה כ\"כ עד שהטבור שעומד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כנגד לבו יעשה גומא ויראה כמו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איסר שכן הוא בשעה שאדם שוחה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהטבור נכנס כלפי פנים ונעשה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גומא קטנה כמו איסר שהוא קטן:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הכורע</b> <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>בהודאה של הלל ובהודאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של ברכת המזון הרי זה מגונה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פי' בהודאה של הלל בהודו לה'",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאומרים בהלל ובהודאה של ברכת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המזון על הכל ה' אלהינו אנו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מודים לך ומכאן נראה שהמנהג",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנוהגים קצת בני אדם לשחות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כשאומרים בנשמת כל חי ולך לבדך אנחנו מודים שאינו נכון שהרי נראה בכאן ששאר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כריעות אין לו לכרוע אלא אותם שתקנו חכמים ומה שהזכיר אלו בלבד ולא הזכיר הודאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "של נשמת כל חי מפני שאין אמירת נשמת כל חי מבורר כמו הלל וברכת המזון אלא מנהג",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הגאונים לפיכך לא הזכיר אלא אלו אבל ה\"ה לכל שאר הודאות שאין כורעין בהם אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהודאה של תפלה בלבד. מפי מורי הרב נר\"ו:",
      "segment_ids": [
        6
      ]
    }
  ],
