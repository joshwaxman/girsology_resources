  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואיכא</b> למידק בזאת התקנה שתקן ר' כשראתה ב' ימים שתשב ששה והם והלא די בה' והם שאפילו היא נדה סגי לה בשתשב שבעה עם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ימי הראיה והתשובה בזה מפני שחשש כי פעמים תראה יום הראשון בימי זיבתה ויום השני בימי נדותה ונמצא שהיום הראשון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהיה בימי הזיבה אינו בכלל שבעה ימי נדותה שצריך שבעה מיום שראתה דם בימי הנדות ואם לא היתה מונה אלא ה' בלבד נמצא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלא ספרה לימי הנדות אלא ששה בלבד עם יום הראיה שיום ראיה ראשונה אינו בכלל המנין כמו שאמרנו ולפי' התקין ו' והם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדי לצאת מזה הספק שאמרנו:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שאפילו רואות טפת דם כחרדל</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> י\"מ שהחומרא היתה מפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיתה מראה הדם כעין החרדל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואין זה נראה דמה חומרא היתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זו שזה מן הדין הוא דהא בהדיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קי\"ל במס' נדה שדם כמראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החרדל מטמא והחומרא ג\"כ אינה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שהיה מועט כחרדל שזה אף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא מן הדין כדתנן (ד' מ.)",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומטמאה בכל שהוא אלא פשר הדבר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא כך שאם היה אומר דם סתם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו אומרים שאין בזה חומרא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל כך מפני ששלשה בתים הם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באשה חדר עליה ופרוזדור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכשהדם מרובה אפשר שמהיום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלשה ימים נעקר ויצא ביום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשון מעט בבית הפנימי וביום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השני נעקר <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>מעט ויצא בבית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האמצעי ועכשיו ביום השלישי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתקבץ הכל בבית החיצון ואע\"פ",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו מן הדין שיחוש האדם לדם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבפנים אלא כשבודקת ורואה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בבית החיצון אפילו הכי כיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאפשר שיהיה בזה הענין היינו אומרים שראוי לחוש וא\"כ אין בזה חומרא גדולה שהרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אפשר נעקר הדם מהיום ג' ימים ודין הוא שנדון אותה כמו זבה גדולה ותשב ז' ימים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נקיים אבל כשהדם הוא מועט רחוק הדבר לומר ששלשה משהויין היו ובכל יום ויום נעקר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משהו אחד וקא משמע לן שאע\"פ שהוא דבר רחוק שדבר מועט <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>כל כך שיהיה נעקר מהיום שלשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ימים אפ\"ה החמירו על עצמן ודנו אותו כאילו נעקר לגמרי ויושבת עליו ז' נקיים ואומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רבינו יצחק ז\"ל שהאשה שלא ראתה דם אלא יום א' או ב' ימים בלבד ושמשה הלילה הסמוכה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ליום שראתה צריכה שתשב ג' ימים תחלה ושתמנה ז' ימים נקיים אח\"כ מפני שבודאי פולטת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שכבת זרע אחר התשמיש וש\"ז סמוך לג' ימים של תשמיש מטמא מפני שמסריח אבל מג' ימים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואילך אינו מסריח (אם לא) שנקלט ונעשה עובר ובמס' נדה (דף כב.) מפרש דבעיא ז'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ימים נקיים לגמרי בלא שכבת זרע ואם לא תשב תחילה ג' ימים סמוך לתשמיש נמצא שפולטת בתוך הז' ימים ואינם נקיים לגמרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואית דבעי מימר שטומאת שכבת זרע אינה אלא לענין אכילת תרומה בלבד שהיא חמורה יותר ואין זה נכון שהענין הזה כתוב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במסכת נדה ומה טעם נקל ונאמר שלא נאמר גבי נדה אלא גבי תרומה אלא ודאי הדין הוא כמו שכתבתי. מפי מורי הרב נר\"ו:",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מערים</b> אדם על תבואתו ומכניסה במוץ שלה כדי שתהא בהמתו אוכלת ופטורה מן המעשר פי' מן התורה אינו חייב לא בתרומה ולא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במעשר אלא היכא דהיא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>דגן דכתיב ראשית דגנך וכל זמן שאינה דגן כשרואה פני הבי' אינו חייב במעשר ולפיכך אמר שיכול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "האדם להערים בתבואתו ולהכניסה לבית קודם שתהיה דגן בין בשבלי' בין לאחר שדשו אותה כל זמן שלא נמרחה לגמרי שעדיין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קצת מהתבן מעורב בתוכה וכיון שראתה פני הבית בפטור אוכלת בהמתו ממנו ואפילו אכילת קבע דאין אכילת קבע לבהמה אבל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "האדם אינו יכול לאכול ממנה אכילת קבע כל זמן שלא תרם אותה ולא עישרה ואפילו לאחר שנמרחה ונעשית דגן לגמרי נראה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מהירושלמי שיכול להערים ולפוטרה כשיערב בה תבן דגרסינן התם תני ר' הושעיא מרבה אדם דגן בתבן ומערים אותו לפטרו מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המעשרות הנה נראה שאף לאחר שהוא דגן גמור יכול לפוטרו מיהו צ\"ע אם צריך שיערב בו כל כך תבן שירבה על הדגן ואית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרי שאפי' האדם אוכל ממנו אכילת קבע ומאי דנקט כדי שתהא בהמתו אוכלת לאו דוקא אלא אורחא דמילתא נקט ואין זה נכון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלל דבהדיא אמרי' במסכת י\"ט (דף יג.) הכניס שבולין לעשות מהם עיסה אוכל מהן אכילת עראי משמע דדוקא אכילת עראי התירו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לו לאכול הא אכילת קבע אסור עד שיתרום ויעשר: <b>המקיז דם לבהמת קדשים אסור בהנאה ומועלין בו.</b> כלומר מועלין בו מן",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "התורה אבל לאחר שחיטה אין מועלין בו אלא מדרבנן דכיון שנתכפר בדם ודאי אין מועלין בו כדקיימא לן אין לך דבר שנעשית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מצותו ומועלין בו וכי היכי דאין מועלין בו לאחר כפרה ה\"נ אין מועלין בו קודם כפרה כיון שנשחטה הבהמה דכיון שראוי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לכפרה כמי שכפר דמי ויש ספרים שכתוב בהם ומועלין בו מדרבנן וזה טעות דודאי לא אמרו שמעילתו מדרבנן בלחוד אלא אחר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שחיטה שהוא ראוי לכפר כדכתבינן אבל קודם שחיטה ודאי מועלין בו מן התורה לדברי הכל דכגוף הבהמה דיינינן ליה והכי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמרינן בתמורה (ד' לא.) כיון דרבי בה כגופה הוי ותו דאם איתא דמועלים בו מדרבנן קאמר מה בא להשמיענו רב <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>הושעי'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאפי' אחר שחיטה מצינו לדברי הכל שמועלים בו מדרבנן כדאמרי' בהדיא כל הדמים מוציאין אותם לנחל קדרון ונמכרים לגננים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לזבל ומועלין בהם הנה שבפירוש אמרו שמועלין בהם אחר כפרה שאם לא נתן הגנן הדמים מעל מדרבנן וא\"כ מהו החידוש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמשמיענו רב הושעיא שקודם שחיטה מועיל מדרבנן אלא ודאי ומועלין בו בלבד גרסי' ור\"ל מועלין בו מן התורה כדכתבינן וכן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מצינו הגי' בנוסחאות מדוייקות. מפי מורי הרב נר\"ו: <b>רבנן</b> עבדי כמתני' ורב שימי בר אשי עביד כברייתא דתניא אין עומדין",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "להתפלל לא מתוך שיחה ולא מתוך שחוק ולא מתוך קלות ראש ולא מתוך דברים בטלים אלא מתוך דבר הלכה שכן מצינו בנביאים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הראשונים שסיימו דבריהם בדברי שבח ותנחומים וכן תאני מארי וכו' זו היא גירסתו של הרב אלפסי ז\"ל ורבי' יונתן ז\"ל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פירשה שלא יעמוד להתפלל אלא מתוך דבר הלכה פסוקה דאילו בהלכה שאינה פסוקה הא אמרי' לעיל דאסור ומה דאמרינן דרב שימי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עביד כברייתא וכו' ר\"ל שאע\"פ שהיה מתפלל בכובד ראש עדיין היה מחזר להתפלל מתוך הלכה פסוקה כמו שאומר בברייתא ורבנן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא היו חוששין לחזר אחר הלכה פסוקה אלא היו מתפללין מתוך כובד ראש כמתני' ואין גירסא זו ולא הפירוש נראים למורי הרב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נר\"ו חדא דלא שייך למימר שלא יעמוד אדם להתפלל אלא מתוך הלכה ולא יפטר מחבירו אלא מתוך הלכה מטעם שסיימו הנביאים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבריהם בדברי שבח ותנחומים וכי כל שאר הדברים של הנביאים אינם ג\"כ דברי תורה וכיון שהכל הוא דברי תורה מה טעם הוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לומר שמפני הסיום שהוא של שבח לא יתפלל ולא יפטר מחבירו אלא מתוך הלכה ומה שפי' שר\"ל מתוך דבר הלכה פסוקה ג\"כ אי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אפשר שהרי לא הזכיר בכאן הלכה פסוקה כמו שהזכיר למעלה אלא דבר הלכה סתם ועוד דאמרינן בסמוך וכן אל יפטר אדם מחבירו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא מתוך דבר הלכה ובודאי אינו ר\"ל הלכה פסוקה דבשלמא גבי תפלה אמרו הלכה פסוקה כדי שלא יחשוב בה בשעת תפלה ויוכל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לכוין בתפלתו אלא כשיפטר מחבירו מאי איריא הלכה פסוקה אפי' הלכה שאינה פסוקה על כן נראה דלא גרסי' מתוך דבר הלכה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלל אלא הנכון כגירסת הספרים שגורסין ולא מתוך שחוק ולא מתוך קלות ראש ולא מתוך דברים בטלים ולא מתוך עצלות ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מתוך עצבות אלא מתוך שמחה שנא' ועתה קחו לי מנגן וכו' שכן מצינו בנביאים הראשונים שסיימו דבריהם בדברי שבח <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>ותנחומין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולא גרסי' וכן תאני מארי אל יפטר אדם מחברו אלא מתוך דבר הלכה שמתוך כך זוכרו שזה דבר אחר בפני עצמו הוא וכ\"ה פי'",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הענין שלא יתפלל מתוך עצלות ומתוך עצבות שבעוד שיהיה עצב או עצל אינו יכול לכוין כראוי דעצלה תפיל תרדמה ולפיכך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כשרואה שהוא עומד בענין שלא יוכל לכוין מותר לו לשמוח כדי שיתקן איבריו שיהיו ראוים לעבודת הבורא ואע\"פ שאמרנו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למעלה שהשמחה היא אסורה זו היא מותרת ששמחה של מצוה היא כיון שעל ידה באה העבודה שהרי מצינו ג\"כ שע\"י השמחה היתה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "השכינה שורה דכתיב ועתה קחו לי מנגן ומאי דאמר שכן מצינו בנביאים הראשונים שסיימו בדברי שבח ותנחומין ר\"ל שכן מצינו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהנביאים סיימו דבריהם בדברי שבח כדי שעל ידי השבח יזכירו נפלאות הבורא יתברך ורבנן כיון שהיו מתפללין בכובד ראש לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "היו חוששין להתפלל מתוך שמחה אבל רב [שימי] אע\"פ שהיה עושה כמו המשנה היה מחזר שיתפלל לעולם מתוך שמחה כדכתבינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מיהו בירושלמי גרסינן תני לא יעמוד אדם להתפלל אלא מתוך שיחה נאה ולא מתוך שחוק ולא מתוך קלות ראש ולא מתוך דברים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בטלים אלא מתוך דברי תורה שכן מצינו בנביאים הראשונים שסיימו דבריהם בדברי שבח ותנחומין ולפי שיטה זו נצטרך לומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמאי דאמר התם שכן מצינו דלא קאי למאי דאמר מתוך דברי תורה אלא למאי דאמר מעיקרא אלא מתוך שיחה נאה שכן מצינו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בנביאים שסיימו בשיחה נאה כגון שבח ותנחומין ופריך בירושלמי והרי ירמיה שחתם בדברי תוכחה ומהדרינן גם הוא בדברי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נחמות חתם שאין סוף דבריו ארוחת תמיד נתנה לו שהיא מפלת צדקיה אלא במפלת שונאיו חתם דכתיב ככה תשקע בבל ולא תקום",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבסופי' דקרא כתיב עד הנה דברי ירמיה וכן ישעיהו בדברי נחמות חתם דמאי דכתיב והיו דראון לכל בשר כיון שהוא אמור על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הרשעים מפלתם של רשעים טובה ונחמה היא לעולם וכן מאי דכתיב כי אם מאוס מאסתנו אינה תוכחה שכך ר\"ל וכי מאוס מאסתנו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קצפת עלינו כלומר לא היתה השנאה כ\"כ שלא תשיב אלינו ותמאוס אותנו כמו הדבר המאוס שאין אדם רוצה בו כלל אלא קצפת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עלינו ומי שקוצף חוזר ומתרצה. מפי מורי הרב נר\"ו:",
      "segment_ids": [
        4
      ]
    }
  ],
