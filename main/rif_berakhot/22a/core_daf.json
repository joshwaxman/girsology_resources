  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "שבעת ימים נקיים רבא אמר כי הא דאמר רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אושעיא מערים אדם על תבואתו ומכניסה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במוץ שלה כדי שתהא בהמתו אוכלת ופטורה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן המעשר אי נמי כי הא דרב הונא דאמר רב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הונא אמר זעירי המקיז דם לבהמת קדשים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אסור בהנאה ומועלים בו <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>(מדרבנן) רבנן",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עבדי כמתניתין ורב שימי בר אשי עביד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כברייתא דתניא אין עומדין להתפלל לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתוך שיחה ולא מתוך שחוק ולא מתוך קלות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראש ולא מתוך דברים בטלים ולא מתוך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצלות ולא מתוך עצבות אלא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מתוך שמחה של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מצוה וכן אל יפטר אדם מחבירו לא מתוך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיחה ולא מתוך קלות ראש ולא מתוך דברים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בטלים אלא מתוך דבר הלכה שכן מצינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בנביאים הראשונים שסיימו את דבריהם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדברי שבח ותנחומין וכן תאני מארי בריה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרב הונא בריה דר' ירמיה בר אבא לא יפטר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדם מחבירו לא מתוך שיחה ולא מתוך שחוק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא מתוך קלות ראש ולא מתוך דברים בטלים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא מתוך",
      "segment_ids": [
        1
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואיכא</b> למידק בזאת התקנה שתקן ר' כשראתה ב' ימים שתשב ששה והם והלא די בה' והם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאפילו היא נדה סגי לה בשתשב שבעה עם ימי הראיה והתשובה בזה מפני שחשש כי פעמים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תראה יום הראשון בימי זיבתה ויום השני בימי נדותה ונמצא שהיום הראשון שהיה בימי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הזיבה אינו בכלל שבעה ימי נדותה שצריך שבעה מיום שראתה דם בימי הנדות ואם לא היתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מונה אלא ה' בלבד נמצא שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ספרה לימי הנדות אלא ששה בלבד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עם יום הראיה שיום ראיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראשונה אינו בכלל המנין כמו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאמרנו ולפי' התקין ו' והם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדי לצאת מזה הספק שאמרנו:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שאפילו רואות טפת דם כחרדל</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> י\"מ שהחומרא היתה מפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיתה מראה הדם כעין החרדל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואין זה נראה דמה חומרא היתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זו שזה מן הדין הוא דהא בהדיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קי\"ל במס' נדה שדם כמראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החרדל מטמא והחומרא ג\"כ אינה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שהיה מועט כחרדל שזה אף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא מן הדין כדתנן (ד' מ.)",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומטמאה בכל שהוא אלא פשר הדבר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא כך שאם היה אומר דם סתם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו אומרים שאין בזה חומרא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל כך מפני ששלשה בתים הם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באשה חדר עליה ופרוזדור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכשהדם מרובה אפשר שמהיום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלשה ימים נעקר ויצא ביום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשון מעט בבית הפנימי וביום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השני נעקר <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>מעט ויצא בבית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האמצעי ועכשיו ביום השלישי נתקבץ הכל בבית החיצון ואע\"פ שאינו מן הדין שיחוש האדם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לדם שבפנים אלא כשבודקת ורואה בבית החיצון אפילו הכי כיון שאפשר שיהיה בזה הענין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היינו אומרים שראוי לחוש וא\"כ אין בזה חומרא גדולה שהרי אפשר נעקר הדם מהיום ג'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ימים ודין הוא שנדון אותה כמו זבה גדולה ותשב ז' ימים נקיים אבל כשהדם הוא מועט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רחוק הדבר לומר ששלשה משהויין היו ובכל יום ויום נעקר משהו אחד וקא משמע לן שאע\"פ",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא דבר רחוק שדבר מועט <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>כל כך שיהיה נעקר מהיום שלשה ימים אפ\"ה החמירו על עצמן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ודנו אותו כאילו נעקר לגמרי ויושבת עליו ז' נקיים ואומר רבינו יצחק ז\"ל שהאשה שלא ראתה דם אלא יום א' או ב' ימים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בלבד ושמשה הלילה הסמוכה ליום שראתה צריכה שתשב ג' ימים תחלה ושתמנה ז' ימים נקיים אח\"כ מפני שבודאי פולטת שכבת זרע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחר התשמיש וש\"ז סמוך לג' ימים של תשמיש מטמא מפני שמסריח אבל מג' ימים ואילך אינו מסריח (אם לא) שנקלט ונעשה עובר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובמס' נדה (דף כב.) מפרש דבעיא ז' ימים נקיים לגמרי בלא שכבת זרע ואם לא תשב תחילה ג' ימים סמוך לתשמיש נמצא שפולטת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בתוך הז' ימים ואינם נקיים לגמרי ואית דבעי מימר שטומאת שכבת זרע אינה אלא לענין אכילת תרומה בלבד שהיא חמורה יותר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואין זה נכון שהענין הזה כתוב במסכת נדה ומה טעם נקל ונאמר שלא נאמר גבי נדה אלא גבי תרומה אלא ודאי הדין הוא כמו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שכתבתי. מפי מורי הרב נר\"ו: <b>מערים</b> אדם על תבואתו ומכניסה במוץ שלה כדי שתהא בהמתו אוכלת ופטורה מן המעשר פי' מן",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "התורה אינו חייב לא בתרומה ולא במעשר אלא היכא דהיא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>דגן דכתיב ראשית דגנך וכל זמן שאינה דגן כשרואה פני הבי' אינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חייב במעשר ולפיכך אמר שיכול האדם להערים בתבואתו ולהכניסה לבית קודם שתהיה דגן בין בשבלי' בין לאחר שדשו אותה כל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זמן שלא נמרחה לגמרי שעדיין קצת מהתבן מעורב בתוכה וכיון שראתה פני הבית בפטור אוכלת בהמתו ממנו ואפילו אכילת קבע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאין אכילת קבע לבהמה אבל האדם אינו יכול לאכול ממנה אכילת קבע כל זמן שלא תרם אותה ולא עישרה ואפילו לאחר שנמרחה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ונעשית דגן לגמרי נראה מהירושלמי שיכול להערים ולפוטרה כשיערב בה תבן דגרסינן התם תני ר' הושעיא מרבה אדם דגן בתבן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומערים אותו לפטרו מן המעשרות הנה נראה שאף לאחר שהוא דגן גמור יכול לפוטרו מיהו צ\"ע אם צריך שיערב בו כל כך תבן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שירבה על הדגן ואית דאמרי שאפי' האדם אוכל ממנו אכילת קבע ומאי דנקט כדי שתהא בהמתו אוכלת לאו דוקא אלא אורחא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמילתא נקט ואין זה נכון כלל דבהדיא אמרי' במסכת י\"ט (דף יג.) הכניס שבולין לעשות מהם עיסה אוכל מהן אכילת עראי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משמע דדוקא אכילת עראי התירו לו לאכול הא אכילת קבע אסור עד שיתרום ויעשר: <b>המקיז דם לבהמת קדשים אסור בהנאה ומועלין</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בו.</b> כלומר מועלין בו מן התורה אבל לאחר שחיטה אין מועלין בו אלא מדרבנן דכיון שנתכפר בדם ודאי אין מועלין בו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כדקיימא לן אין לך דבר שנעשית מצותו ומועלין בו וכי היכי דאין מועלין בו לאחר כפרה ה\"נ אין מועלין בו קודם כפרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כיון שנשחטה הבהמה דכיון שראוי לכפרה כמי שכפר דמי ויש ספרים שכתוב בהם ומועלין בו מדרבנן וזה טעות דודאי לא אמרו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמעילתו מדרבנן בלחוד אלא אחר שחיטה שהוא ראוי לכפר כדכתבינן אבל קודם שחיטה ודאי מועלין בו מן התורה לדברי הכל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דכגוף הבהמה דיינינן ליה והכי אמרינן בתמורה (ד' לא.) כיון דרבי בה כגופה הוי ותו דאם איתא דמועלים בו מדרבנן קאמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מה בא להשמיענו רב <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>הושעי' שאפי' אחר שחיטה מצינו לדברי הכל שמועלים בו מדרבנן כדאמרי' בהדיא כל הדמים מוציאין אותם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לנחל קדרון ונמכרים לגננים לזבל ומועלין בהם הנה שבפירוש אמרו שמועלין בהם אחר כפרה שאם לא נתן הגנן הדמים מעל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מדרבנן וא\"כ מהו החידוש שמשמיענו רב הושעיא שקודם שחיטה מועיל מדרבנן אלא ודאי ומועלין בו בלבד גרסי' ור\"ל מועלין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בו מן התורה כדכתבינן וכן מצינו הגי' בנוסחאות מדוייקות. מפי מורי הרב נר\"ו: <b>רבנן</b> עבדי כמתני' ורב שימי בר אשי עביד",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כברייתא דתניא אין עומדין להתפלל לא מתוך שיחה ולא מתוך שחוק ולא מתוך קלות ראש ולא מתוך דברים בטלים אלא מתוך דבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלכה שכן מצינו בנביאים הראשונים שסיימו דבריהם בדברי שבח ותנחומים וכן תאני מארי וכו' זו היא גירסתו של הרב אלפסי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל ורבי' יונתן ז\"ל פירשה שלא יעמוד להתפלל אלא מתוך דבר הלכה פסוקה דאילו בהלכה שאינה פסוקה הא אמרי' לעיל דאסור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומה דאמרינן דרב שימי עביד כברייתא וכו' ר\"ל שאע\"פ שהיה מתפלל בכובד ראש עדיין היה מחזר להתפלל מתוך הלכה פסוקה כמו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאומר בברייתא ורבנן לא היו חוששין לחזר אחר הלכה פסוקה אלא היו מתפללין מתוך כובד ראש כמתני' ואין גירסא זו ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הפירוש נראים למורי הרב נר\"ו חדא דלא שייך למימר שלא יעמוד אדם להתפלל אלא מתוך הלכה ולא יפטר מחבירו אלא מתוך הלכה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מטעם שסיימו הנביאים דבריהם בדברי שבח ותנחומים וכי כל שאר הדברים של הנביאים אינם ג\"כ דברי תורה וכיון שהכל הוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דברי תורה מה טעם הוא לומר שמפני הסיום שהוא של שבח לא יתפלל ולא יפטר מחבירו אלא מתוך הלכה ומה שפי' שר\"ל מתוך דבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלכה פסוקה ג\"כ אי אפשר שהרי לא הזכיר בכאן הלכה פסוקה כמו שהזכיר למעלה אלא דבר הלכה סתם ועוד דאמרינן בסמוך וכן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אל יפטר אדם מחבירו אלא מתוך דבר הלכה ובודאי אינו ר\"ל הלכה פסוקה דבשלמא גבי תפלה אמרו הלכה פסוקה כדי שלא יחשוב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בה בשעת תפלה ויוכל לכוין בתפלתו אלא כשיפטר מחבירו מאי איריא הלכה פסוקה אפי' הלכה שאינה פסוקה על כן נראה דלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גרסי' מתוך דבר הלכה כלל אלא הנכון כגירסת הספרים שגורסין ולא מתוך שחוק ולא מתוך קלות ראש ולא מתוך דברים בטלים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולא מתוך עצלות ולא מתוך עצבות אלא מתוך שמחה שנא' ועתה קחו לי מנגן וכו' שכן מצינו בנביאים הראשונים שסיימו דבריהם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בדברי שבח <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>ותנחומין ולא גרסי' וכן תאני מארי אל יפטר אדם מחברו אלא מתוך דבר הלכה שמתוך כך זוכרו שזה דבר אחר בפני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עצמו הוא וכ\"ה פי' הענין שלא יתפלל מתוך עצלות ומתוך עצבות שבעוד שיהיה עצב או עצל אינו יכול לכוין כראוי דעצלה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תפיל תרדמה ולפיכך כשרואה שהוא עומד בענין שלא יוכל לכוין מותר לו לשמוח כדי שיתקן איבריו שיהיו ראוים לעבודת הבורא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואע\"פ שאמרנו למעלה שהשמחה היא אסורה זו היא מותרת ששמחה של מצוה היא כיון שעל ידה באה העבודה שהרי מצינו ג\"כ שע\"י",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "השמחה היתה השכינה שורה דכתיב ועתה קחו לי מנגן ומאי דאמר שכן מצינו בנביאים הראשונים שסיימו בדברי שבח ותנחומין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"ל שכן מצינו שהנביאים סיימו דבריהם בדברי שבח כדי שעל ידי השבח יזכירו נפלאות הבורא יתברך ורבנן כיון שהיו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מתפללין בכובד ראש לא היו חוששין להתפלל מתוך שמחה אבל רב [שימי] אע\"פ שהיה עושה כמו המשנה היה מחזר שיתפלל לעולם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מתוך שמחה כדכתבינן מיהו בירושלמי גרסינן תני לא יעמוד אדם להתפלל אלא מתוך שיחה נאה ולא מתוך שחוק ולא מתוך קלות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ראש ולא מתוך דברים בטלים אלא מתוך דברי תורה שכן מצינו בנביאים הראשונים שסיימו דבריהם בדברי שבח ותנחומין ולפי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שיטה זו נצטרך לומר דמאי דאמר התם שכן מצינו דלא קאי למאי דאמר מתוך דברי תורה אלא למאי דאמר מעיקרא אלא מתוך שיחה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נאה שכן מצינו בנביאים שסיימו בשיחה נאה כגון שבח ותנחומין ופריך בירושלמי והרי ירמיה שחתם בדברי תוכחה ומהדרינן גם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא בדברי נחמות חתם שאין סוף דבריו ארוחת תמיד נתנה לו שהיא מפלת צדקיה אלא במפלת שונאיו חתם דכתיב ככה תשקע בבל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולא תקום דבסופי' דקרא כתיב עד הנה דברי ירמיה וכן ישעיהו בדברי נחמות חתם דמאי דכתיב והיו דראון לכל בשר כיון שהוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמור על הרשעים מפלתם של רשעים טובה ונחמה היא לעולם וכן מאי דכתיב כי אם מאוס מאסתנו אינה תוכחה שכך ר\"ל וכי מאוס",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מאסתנו קצפת עלינו כלומר לא היתה השנאה כ\"כ שלא תשיב אלינו ותמאוס אותנו כמו הדבר המאוס שאין אדם רוצה בו כלל אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קצפת עלינו ומי שקוצף חוזר ומתרצה. מפי מורי הרב נר\"ו:",
      "segment_ids": [
        4
      ]
    }
  ],
