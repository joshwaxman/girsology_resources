  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כל המספר אחר מטתן של תלמידי חכמים וכו'.</b> כלומר שמספר בגנותן ואומר העבירות שעשו",
      "segment_ids": [
        0
