        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יתחילו: העומדין בשורה וכו': <span class=\"bavli-ref\" data-bavli-ref=\"(דף יט:)\" data-bavli-daf=\"19b\" data-bavli-index=\"0\"></span>תנו רבנן",
      "segment_ids": [
        3,
        4
      ]
    },
