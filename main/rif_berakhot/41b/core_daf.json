  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "וכל דבר שחוצץ בטבילה בגוף חוצץ בנטילת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידים בחולין ובקידוש ידים ורגלים במקדש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואסיקנא משום רבי יהושע בן לוי עד לפרק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין לחולין בין לתרומה וכן הלכתא אמר רב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Blessings\" data-label=\"⚬\"></i>נוטל אדם ידיו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>שחרית ומתנה עליהן כל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היום כולו אמר להו רבינא לבני <span class=\"bavli-ref\" data-bavli-ref=\"(שם דף קז.)\" data-bavli-daf=\"107a\" data-bavli-scope=\"שם\" data-bavli-index=\"0\"></span>פקתא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דערכות כגון אתון דלא נפישי לכו מיא משו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידייכו מצפרא ואתנו עילוייהו כולי יומא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איכא דאמרי דוקא בשעת הדחק ופליגא דרב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואיכא דאמרי ואפילו שלא בשעת הדחק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והיינו דרב אמר רבא האי <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Blessings\" data-label=\"⚬\"></i>אריתא דדלאי אין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוטלין ממנה לידים ואין מטבילין בה את",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הידים אין מטבילין בה את הידים דהוו להו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאובין ואין נוטלין בה את הידים דלא אתו",
      "segment_ids": [
        0
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לתרומה עד לפרק.</b> עד קשרי אצבעותיו השלישיים שהם בסוף האצבעות. ובגמ' (דף קו:)",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אמרינן אמר רב יהודה אמר רב עד כאן לחולין עד כאן לתרומה ושמואל אמר ע\"כ בין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לחולין בין לתרומה לקולא ור\"י בן לוי אמר ע\"כ בין לחולין בין לתרומה לחומרא ומפרש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רש\"י ז\"ל פלוגתייהו הכי דרב יהודה אמר שיש הפרש בין חולין ובין תרומה דלחולין סגי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשיטול עד קשרי אצבעותיו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השניים ולתרומה צריך עד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקשרים השלישיים שהם בסוף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האצבעות ושמואל היה מיקל יותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכלם והיה אומר דבין לחולין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין לתרומה סגי כשיטול עד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קשרי אצבעותיו השניים ור\"י בן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לוי היה מחמיר יותר מכלם והיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומר דאפי' לחולין צריך ליטול",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עד קשרי אצבעותיו השלישיים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והלכתא כוותיה. ויש להקשות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפי פירוש זה שמפרש מה ששנינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בברייתא לחולין עד לפרק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתרומה עד לפרק שאינו רצה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לומר בשניהם במקום אחד אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחולין עד הפרק השני שבאצבעות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולתרומה עד לפרק השלישי למה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא הקשה מהבריי' לשמואל ורבי יהושע בן לוי דבשלמא לרב ניחא שהרי מעמיד הוא חילוק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ביניהם כמו הברייתא אלא לשמואל ורבי יהושע שאינן מעמידים חילוק בין חולין לתרומה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קשיא ומתרצי רבני צרפת ז\"ל דהני אמוראי לא היו יודעין הברייתא ומתוך כך לא נתקשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "להם. זו היא שיטת רש\"י ז\"ל. ונמצינו למדים לפי שיטה זו שדי לנטילת ידים עד סוף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האצבעות שהרי ר' יהושע שהיה מחמיר יותר מכולם לא היה מחמיר יותר: <b>אבל</b> מתוך הגירסא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שגורס ר\"ח ז\"ל והרי\"ף ז\"ל למדנו פי' הלכה זו בענין אחר נכון שהם גורסין לחולין עד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לפקק ומפ' פקק הקשרים השלישיים שבסוף האצבעות מלשון (ברכות כח:) עד שיתפקקו כל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חוליות שבשדרה דכמו שבשעה שאדם כורע בולטים החוליות כלפי חוץ כמו כן בשעה שכופף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אצבעותיו בולטים אותם הקשרים כלפי חוץ והכי תנן בכלאים מאימתי מתחילין למנות מפקק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הגפן השני כלומר מאיזה מקום מתחילין למנות הד' אמות שצריך להרחיק כשזורע שם מין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אחר ומפרש מהקשר השני מהגפן וכך הוא פי' הברייתא קידוש ידים במקדש עד לפרק דהיינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במקום חיבור היד והזרוע שהוא סוף היד שזהו הנקרא פרק לחולין עד לפקק עד קשרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אצבעותיו השלישיים שהוא סוף האצבעות לתרומה עד לפרק ר\"ל ג\"כ עד מקום חיבור היד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והזרוע שהוא סוף היד כמו שאמרנו בקידוש ידים שבמקדש ואע\"פ שקידוש שבמקדש ותרומה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיעור אחד להם לא שנה אותם ביחד מפני ששנה תחלה קידוש של מקדש שהוא מן התורה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואח\"כ סמך לו חולין שהוא מצוי יותר ואחר כך תרומה ומה שנחלקו בגמ' רב ושמואל ור'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יהושע ב\"ל הוא בזה שרב היה גורס [בחולין] לפקק ולפיכך היה אומר שיש הפרש בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חולין לתרומה דלחולין עד הקשרים שבסוף האצבעות שבולטים כשאדם כופף אצבעותיו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולתרומה עד הפרק דהיינו סוף היד ושמואל היה מיקל יותר והיה אומר דאפי' לתרומה די",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשיטול עד הקשרים שבסוף האצבעות כמו לחולין [וגורס בשניהם לפקק] ור' יהושע היה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "גורס בכל לפרק והיה אומר דבין לחולין בין לתרומה עד הפרק דהיינו סוף היד לחומרא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומסקנא כוותיה ונמצינו למדים לפי שיטה זו שבשעה שנוטל אדם ידיו צריך ליטול אותם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עד מקום הפרק דהיינו עד מקום חיבור היד והזרוע וכן אומרים רבני צרפת ז\"ל שמצאו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כתוב בהלכות של א\"י נט\"י כל היד ובזה הוא מתורץ מה שמקשים העולם על הרי\"ף ז\"ל למה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא כתב כדברי ר' יהושע ב\"ל לחומרא שמאחר שכתב עד לפרק ממילא שמעינן שהוא לחומרא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ודבר ידוע הוא שהפרק ר\"ל עד סוף היד וסתם הלשון כדי שנבין כי לשון הפרק הוא מורה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "על החומרא מתוך לשונו זה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>הדרך שכתבנו ויש לשאול כיון שהמסקנא כמו הגירסא שהיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "גורס ר' יהושע דאפי' לחולין צריך עד לפרק שהוא סוף היד לחומרא למה לא שנה אותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בברייתא ביחד והוצרך לומר עד הפרק לכל אחד ואחד בפני עצמו י\"ל דתנא חדא חדא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמעינהו וגרסינהו כלומר לא שמע אותם ביחד אלא כל אחד ואחד בפני עצמו ובכל אחד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואחד שמע עד לפרק ולפיכך שנה אותם בברייתא על הדרך ששמע וכיוצא בזה אמרו במס'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קדושין (דף ו.) גבי הרי את מקודשת לי הרי את מיועדת לי וכו' ששנה בט' לשונות ג'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פעמים הרי זו מקודשת ומקשי' לשם למה הוצרך לומר ג' פעמים הלא די בשיאמר כל הט'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לשונות ביחד ויאמר אחר כולם הרי זו מקודשת ומתרץ תלתא תלתא שמעינהו וגרסינהו. מפי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מורי הרב נר\"ו: <b>וכל דבר שחוצץ בטבילה בגוף חוצץ בנט\"י.</b> פי' כגון דיו או שעוה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכיוצא בהן וה\"ה שצריך להסיר הטינוף שבין הצפורן והאצבעות כמו שצריך בטבילה: <b>נוטל</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אדם ידיו שחרית ומתנה עליהם כל היום.</b> ודוקא כששומר את הידים ואינו נוגע בהן בשום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבר של טנוף מועיל התנאי וא\"צ ליטול ידיו כל היום לא בשעת תפלה ולא בשעת אכילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל אם אינו שומר את ידיו אין התנאי מועיל ואפי' היכא שיש לו מים ס\"ל לרב שיכול",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעשות כן כדמפ' בסמוך ומאי דאמר להו רבינא לבני פקתא כגון אתון דלא נפישו לכו מיא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i><i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>ראוי לכם שתכניסו עצמכם בזה הטורח לשמור ידיכם ולהתנות עליהם בבקר ובכאן י\"ל היאך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אומר שבנטילת שחרית יפטר כל היום בתנאי והא תנן ב\"ה אומרים מוזגין את הכוס ואח\"כ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נוטלין לידים וטעמייהו משום דאמרי' (ברכות דף נב:) תכף לנטילה אכילה ויש לומר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דהתם שלא התנה בנטילה של שחרית ונתחייב ליטול בשעת אכילה בזה אמרו תכף לנטילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סעודה דמאחר שנוטל ידיו לאכול יש לו לאכול מיד שלא יסיח דעתו בינתים אבל בזה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו מחויב ליטול בשעת אכילה שהרי שמר אותן מהבקר והתנה עליהם לא אמרו תכף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לנטילה סעודה ויש עוד לשאול מדאמרי' בפסחים (דף קו:) נטל ידיו לא יקדש ור\"ל לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יקדש ואם קידש צריך נט\"י פעם שנית ולמה צריך ליטול ידיו שנית שמאחר שקידש ודאי יש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לו לאכול דאין קידוש אלא במקום סעודה ונמצא שאין תנאי גדול מזה ולמה לא אמרו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיועיל הקידוש כמו שמועיל התנאי. ונראה למורי הרב נר\"ו לתרץ דמן הדין ודאי סגי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בנטילה ראשונה אלא שמאחר שחכמים תקנו לקדש תחלה וליטול אח\"כ והוא לא עשה כפי מה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שתקנו הם קנסו אותו לחזור וליטול ידיו שנית ורבני צרפת ז\"ל מתרצים בענין אחר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמשום הכי הצריכוהו לשם ליטול ידיו שנית מפני מה שאמרו טעם אינו מקדש ואם היינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אומרים דנטל ידיו ויקדש ויאכל מיד וא\"צ ליטול שנית היינו מדמין הנטילה לטעימה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והיינו אומרים כמו שהנטילה היא מעין האכילה ומאחר שנטל ידיו אינו חוזר ונוטל [אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקדש ואוכל] הה\"נ כשטעם קודם הקידוש [דמקדש ואוכל] (אינו חוזר עכשיו <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>ומקדש) וזה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דוחק הוא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ד\" data-order=\"4\"></i>ועוד שלא יתכן לתלות זה בזה דהא חזינן דטעם אינו מקדש אינו הלכה אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הלכה הוא שאע\"פ שטעם מקדש ואם כדבריהם נצטרך לומר דכי היכי דלא הוי הלכה טעם אינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקדש הה\"נ לא הוי הלכה דנטל ידיו לא יקדש ואינו כן דהתם בפסחים משמע בהדיא דהלכה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הוי שאם נטל ידיו לא יקדש ויאכל מיד אלא חוזר ונוטל פעם שנית ושם הארכתי בזה יותר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שבח לאל: <b>ולענין</b> פסקא נראה למורי הרב נר\"ו לפסוק הלכה לקולא כמו הלשון שאומר אפי'",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלא בשעת הדחק כרב ולא מפני שהוא לשון אחרון שאינו נקרא לשון אחרון אלא כשהלשון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הראשון מביא התלמוד בסתם והלשון האחר בלשון איכא דאמרי אבל היכא ששניהם מביא אותם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בלשון איכא דאמרי לא נקרא לשון אחרון אלא הטעם שיש לו לפסוק הלכה כמו הלשון שמיקל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יותר מפני שהנטילה מדרבנן ובשל סופרים הלך אחר המקל. ור\"ח ז\"ל פסק כמו הלשון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמחמיר יותר ותימה הוא על מה סמך שאי אפשר לומר שסמך על מה דאמר רבינא כגון אתון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דלא נפישי מיא דמשמע דוקא אתם שאין לכם מים והוא כמו בשעת הדחק הא אחרים לא שזה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כבר כתבנו למעלה שאינו כן שלא אמר להם אלא מאחר שלא היה להם מים מצוים ראוי ליכנס",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בטורח לשמור ידיהם ונראה שסמך על מאי דאמרי' בגמ' (חולין דף קו.) מים ראשונים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "האכילו בשר חזיר פירוש מעשה היה באדם אחד שלא נטל ידיו קודם האכילה והאכסנאי מתוך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלא נטל ידיו היה סבור שהי' נכרי ונתן לו לאכול בשר חזיר ומפני כך כתב שיש לו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "להחמיר בדבר ואין לו לעשות כן אלא בשעת הדחק מפני זה החשש שהרואה שאוכל בלא נטילה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא ידע שהתנה בנטילה של שחרית ושמר אותם כל היום ויבא להאכילו דברים האסורים מפני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיחשוב שהוא נכרי. מפי מורי הרב נר\"ו: <b>אמר רבא האי אריתא דדלאי אין נוטלין ממנה</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לידים.</b> פירוש אריתא יאור כדמתרגמינן על יאוריהם על אריתיהון ודרך הוא שדולים ממנה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והדולה משליך המים לתוך הצינור ומשם יפרדו המים והולכין מאליהן ומשקין כל הערוגות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שבגן ועכשיו בא רבא להשמיענו שאין להטביל הידים בתוך הצינור דהוו להו שאובין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שנשאבו מן היאור ע\"י הדולה ואינו נוטל שם את ידיו דלא אתו מכח גברא שהרי מאליהן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הולכין בשוקת להשקות את הגן: <b>ואיכא</b> למידק למה לא אסר הנטילה מטעם דלא אתו מכח מנא",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיותר היה לו לאסור מזה הטעם ממה שלא אתא מכח גברא דכח מנא בעי לדברי הכל וכח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "גברא מצינו שהוא מחלוקת דתנן במסכת ידים (סוף פ\"א) חבית מטה על צדה ונוטל [ממנה]",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לידים והקוף נוטל לידים רבי יוסי פוסל בשתיהם הנה שת\"ק סובר דלא בעינן כח גברא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולפיכך היה אומר שמטה החבית כדי שיוכל להוציא המים ונוטל ממנה את ידיו והיה מכשיר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הקוף לנטילת ידים אע\"פ שאין בו תורת אדם ור' יוסי שהיה פוסל בשתיהן היה סובר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבעינן כח גברא וליכא וכיון שמצינו מחלוקת בכח גברא ולא מצינו בכח מנא יותר הל\"ל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הטעם שאין בו מחלוקת. ואומר מורי הרב נר\"ו שקושיא זו היא מתורצת במה שאומר אחר כך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואי מקרב לגבי דוולא דאתי מכח גברא נוטלין ממנה לידים. ור\"ל אם בשעה שאדם דולה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המים מן האריתא ושופך אותם בצינור משים ידיו קרוב למקום השפיכה אע\"פ שאינו משים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותם תחת השפיכה ממש נוטלין ממנו לידים דכל זמן שהם קרובים למקום השפיכה עדיין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מכחו הם באין ודמיא להא דאמרינן במסכת חולין (דף טז.) השוחט במוכני שחיטתו כשרה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והתניא שחיטתו פסולה ומתרצינן ל\"ק כאן בסביבה ראשונה כאן בסביבה שניה ור\"ל שאם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שחט בגלגל של אבן או של עץ והיה סכין או דבר אחר שראוי לשחוט בו תקועה בגלגל והיה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "צואר הבהמה קרוב לגלגל והאדם חוזר הגלגל ובפעם אחת שאדם מחזיר אותו אח\"כ חוזר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מעצמו פעמים רבות ואם שחט בסביבה הראשונה דיינינן ליה כח האדם והשחיטה כשרה אבל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הסביבות האחרות אינם באות מכחו והשחיטה פסולה ה\"נ כשידיו קרובים למקום השפיכה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דיינינן ליה כאילו היו עומדות במקום שפיכת המים עצמן וה\"ל כח גברא ונוטלין ממנו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לידים וכשהן רחוקות לא דיינינן ליה כח גברא ואין נוטלין ממנו לידים ומפני שבסיפא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הוצרך לומר דאתי מכח גברא להשמיענו שאע\"פ שאינן תחת מקום השפיכה עצמה כיון שהם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קרובים למקום השפיכה דכח גברא הוי נקט ברישא כשנוטל רחוק ממקום שפיכה טעמא דלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אתי מכח גברא ולא אמר דלא אתי מכח מנא ואע\"פ שהוא לדברי הכל:",
      "segment_ids": [
        6
      ]
    }
