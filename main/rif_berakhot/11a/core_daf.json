      "right": "0px",
      "left": "",
      "text": "ואע\"פ שעדיין לא נקבר המת ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חל עיקר האבלות אפי' הכי כיון",
