      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתורה ואינו רשאי להחמיר על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו כדכתבינן והוא הדין במי",
      "segment_ids": [
