      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חל עיקר האבלות אפי' הכי כיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שגם זה מפני האבלות הוא הלכה",
      "segment_ids": [
