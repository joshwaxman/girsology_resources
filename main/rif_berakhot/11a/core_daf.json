      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקי\"ל הלכה כדברי המיקל באבל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואע\"פ שעדיין לא נקבר המת ולא",
