        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומר מורי הרב נר\"ו שאין הלכה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כת\"ק דאסר אלא כר\"ג וחייב בכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המצות האמורות בתורה ואפי'",
      "segment_ids": [
