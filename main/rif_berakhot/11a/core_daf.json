    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפניו דמי דכתי' (בראשית כ״ג:ד׳) ואקברה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתי מלפני אטו ההיא שעתא קמיה הוה רמיא",
