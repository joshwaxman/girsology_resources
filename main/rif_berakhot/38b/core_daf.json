  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "על היום ואח\"כ מברך על היין שהיום גורס",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליין שיבא וכבר קדש היום ועדיין יין לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בא ובה\"א מברך על היין ואחר כך מברך על",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היום שהיין גורם לקדושה שתאמר: דבר אחר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכת היין תדירה וברכת היום אינה תדירה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותדיר ושאינו תדיר תדיר קודם: ב\"ש",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים נוטלין לידים ואח\"כ מוזגין את",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכוס וב\"ה אומרים מוזגין את הכוס <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>ואחר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כך נוטלין לידים מאי כוס כוס של קדוש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היום הוא: <b><big>מתני'</big></b> <i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Blessings\" data-label=\"⚬\"></i>בית שמאי אומרים מכבדין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הבית ואחר כך נוטלין לידים ובית הלל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים נוטלין לידים ואחר כך מכבדין את",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית: <b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף נב:)\" data-bavli-daf=\"52b\" data-bavli-index=\"0\"></span>מאי טעמא דבית שמאי משום",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פירורין ובית הלל סברי הכא בשמש תלמיד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חכם עסקינן שמניח פירורין שאין בהן כזית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונוטל פירורין שיש בהן כזית מסייע ליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרבי יוחנן דאמר פירורין שאין בהן כזית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר לאבדן ביד במאי קא מיפלגי בית שמאי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סברי מותר להשתמש בשמש עם הארץ ובית הלל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סברי אסור להשתמש בשמש עם הארץ אמר רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצחק ברבי חנינא אמר רב הונא בכוליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פירקין הלכה כבית הלל בר מהאי דהלכה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כבית שמאי: <b><big>מתני'</big></b> <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>בית שמאי אומרים נר",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומזון ובשמים והבדלה ובית הלל <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>אומרים נר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובשמים ומזון והבדלה: <b><big>גמ'</big></b> איכא מרבוואתא",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מ\"ד דהאי מזון דקתני במתניתין ברכת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המוציא היא ושמיעה ליה מהאי מתניתין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמבדלינן אריפתא וקא מוקים לה למתניתין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במוצאי שבת ליום טוב דכיון דבעי למימר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קידושא אריפתא משלשל לה להבדלה אבתרה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והאי דאיצטריך ליה למימר הכי משום דקשיא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לי' ההיא דאמימר (פסחים קז.) דאיקלע לבי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב אשי ולא הוה להו חמרא לאבדולי ובת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טות ומשום הכי איצטריך לאוקמא להא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>מתניתא במוצאי שבת ליום טוב וקא מוקים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להא דאמימר בשאר ימות השנה כי היכי דלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תיקשי ליה ההיא דאמימר והא מילתא ליתא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלא אשכחן הבדלה על הפת כל עיקר והא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דקתני במתניתין נר ומזון ובשמים והבדלה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאו אברכת המוציא קאי דשמעת מינה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמבדלינן אריפתא אלא אברכת המזון קאי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דהיא שלש ברכות ובהדיא קתני בתוספתא אמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ר' יהודה לא נחלקו בית שמאי וב\"ה על",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכת",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גמ' שהיום גורם ליין שיבא.</b> כלומר שאם לא בעבור השבת לא היינו צריכין להביא יין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לקדש ונמצא שהעיקר תלוי בשבת ועוד שהשבת קודם שכבר קידש היום ועדיין יין לא בא:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שהיין גורם לקידוש שתאמר.</b> והוא הדין שיכול לקדש על הפת והכי קאמר שגם היין גורם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לקידוש שתאמר כמו הפת וכיון שיש לו חשיבות כמו הפת מברכין עליו תחלה: <b>ותדיר</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ושאינו תדיר תדיר קודם.</b> נפקא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לן מקרא (זבחים פט.) מלבד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עולת הבוקר אשר לעולת התמיד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכו' דמשמע אחר שתעשו עולת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התמיד תעשו את אלה: <b>מתני' ב\"ש</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אומרים מכבדין את הבית ואח\"כ</b>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נוטלין לידים וכו'.</b> פירוש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מנהגם היה אחר אכילה קודם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכת המזון לסלק השולחן ולכבד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המקום מן העצמות והפירורין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנפלו שם וב\"ש ס\"ל שמתחלה יש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו לכבד הבית ואח\"כ יטול ידיו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שאם נוטל ידיו תחלה יפלו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המים על הפירורים של הלחם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנפלו תחת השולחן בשעת אכילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דס\"ל שמותר להשתמש בשמש עם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הארץ והשמש לא יחוש לבזוי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אוכלין ולא יחלק בין פירורין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין בהן כזית לפירורין שיש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהן כזית ולפיכך צריך ליזהר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולכבד הבית תחלה ואסיקנא בגמ'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהלכה כב\"ש שמכבדין ואח\"כ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נוטלין ומה שאין אנו נוהגין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עכשיו לעשות כך אומר רבינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יצחק הזקן ז\"ל שזה לא היה אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בימיהם שהיה מנהגם לסלק את",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השולחן קודם ברכה והיו נוטלים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ידיהם במקום שהשולחן היה עומד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם היה נוטל ידיו קודם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיכבדו מקום שהשולחן עומד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המים נופלים על הפירורין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואיכא משום בזוי אוכלין אבל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עכשיו מפני שאין מנהגנו לסלק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את השולחן ונוטלין ידיהן מחוץ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשולחן מקום שאין שם פירורין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא חששו לדבר. והא דאמרי' ב\"ש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סברי מותר להשתמש בשמש עם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הארץ הלכה כב\"ש ונראין הדברים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיותר הוא מותר להשתמש בע\"ה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלהשתמש בת\"ח ובב\"מ (דף עג:)",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרי' שאפי' בבני אדם אחרים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינם שמשין שלו אם אינם יראי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמים מותר להשתמש בהם: <b>מתני'</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ב\"ש אומרים נר ומזון בשמים</b>",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והבדלה וכו'.</b> פירוש הנר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמביאים אותו עכשיו ונהנה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנו מיד יש לו להקדים ואחר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כך המזון מפני שכבר אכל ויש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו להקדים אותה לבשמים והבדלה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וטעם הבשמים במוצאי שבת מפני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנפש יתירה שהיתה לו ממנוחת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שבת והוא מצטער עכשיו כשהלכה אותה מנוחה ממנו ומריח בשמים כדי לישב נשמתו: <b>ובה\"א</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>נר ובשמים מזון והבדלה.</b> דס\"ל לב\"ה שמיד שמברך על הנר מברך על הבשמים שהוא ג\"כ",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מענין השבת שמראה הצער שהיה לו ואח\"כ מזון ואח\"כ הבדלה: <b>ויש</b> לשאול היאך יכול לומר",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמברך <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>ואח\"כ מבדיל דמשמע שמותר לאכול קודם הבדלה ובהדיא אמרי' (פסחים קה. קז.)",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אסור לאדם שיטעום כלום קודם שיבדיל והר\"ן ז\"ל כתב במגלת סתרים שלו דמיירי במי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהתחיל לאכול בשבת מבעוד יום וחשך עליו היום ואין לו אלא כוס אחד ובזה נחלקו ב\"ש",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וב\"ה היאך יסדר אותם אבל אם היה לו יין לברכת המזון ולהבדלה היה מברך על המזון",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בפ\"ע ואח\"כ היה מבדיל כמו שמנהגו כל השנה כולה אבל מפני שאין לו אלא זה הכוס בלבד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וקי\"ל (שם קה:) ברכה טעונה כוס כל היכא שאפשר לאומרה על היין <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>לפיכך אמרו שמפני",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיצא ידי חיוב מהכל שיסדרם כולם על אותו כוס שיש לו ונחלקו ב\"ש על הסדר אם בשמים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קודם למזון או מזון לבשמים אבל ודאי לאכול אחר חשכה קודם הבדלה אסור וכן נראה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שסובר הרי\"ף ז\"ל מתוך הירוש' שהביא בהלכותיו ורבני צרפת הקשו על זה מדחזינן בגמ'",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "(פסחים קו:) שנחלקו אם שכח וטעם קודם הבדלה אם יכול להבדיל אח\"כ אם לא שיש מי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שסובר שאינו מבדיל אח\"כ שכבר עברה שעתה. ויש מי שסובר שאע\"פ שטעם מבדיל אח\"כ ומאן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דסבירא ליה דטעם מבדיל מביא ראיה מזו המשנה דמשמע שאע\"פ שכבר אכל מבדיל אח\"כ ואם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדברי ר\"נ ז\"ל שמעמיד המשנה במי שהיה אוכל וחשך עליו היום מה ראיה היה מביא מזו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המשנה דהכא מתוך כך אמרו שמבדיל מפני שלא טעם אחר חשכה וכ\"ת דמיירי במי שהתחיל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאכול מבעוד יום וחשך עליו היום ונמשך באכילתו עד הערב ומפני אותו המקצת שאוכל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אחר חשכה היה לומד שאע\"פ שטעם מבדיל דהא הכא מבדיל אחר שאכל זה אינו דבהדיא קי\"ל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בפסחים (דף קה) שאע\"פ שמפסיקין לקידוש אין מפסיקין להבדלה ואם היה יושב לאכול",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשבת מבעוד יום וחשך עליו היום גומר סעודתו ואח\"כ מבדיל וכיון שבהיתר הוא אוכל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלא צוו לו להפסיק סעודתו ולהבדיל היאך היה לומד שאם טעם באיסור שיבדיל דהכא מתוך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כך אמרו שמבדיל אחר כך מפני שלא טעם באיסור אלא ודאי בשהתחיל לאכול אחר חשכה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיירי מתניתין ומתוך כך היה למד ממנה שאע\"פ שטעם מבדיל ודקא קשיא לך היאך יכול",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאכול קודם ההבדלה והלא אמרו אסור לאדם שיטעום כלום קודם שיבדיל זהו כשיש לו יין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לב' כוסות להבדלה ולברכת מזון שמאחר שיכול לברך ברכת מזון על הכוס ביין הנשאר לו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טוב הוא שיבדיל קודם האכילה וכי אמרי' הכא שאוכל קודם הבדלה מיירי במי שאין לו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא כוס אחד בלבד ואם יבדיל עליו לא יהיה לו יין לברך בהמ\"ז ומתוך כך התירו לו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיאכל בלא הבדלה כדי שיברך בהמ\"ז על היין וההיא דאמרי' (שם קז.) אמימר איקלע לבי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רב אשי ולא ה\"ל חמרא לאבדולי ובת טות לא מן הדין היה עושה כן דודאי היה יכול",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאכול קודם הבדלה כיון שלא היה לו יין אלא לחומרא עשה אותו: <b>ומשום</b> דקשיא להו",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "למקצת רבוואתא ז\"ל היאך אוכלין קודם הבדלה הוצרכו לפרש דהאי מזון דאמרי במתניתין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אינו ר\"ל בהמ\"ז אלא ברכת המוציא ומעמידין המשנה במי שאין לו יין כלל שאם היה לו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יין היה מבדיל תחלה באותו היין ואח\"כ מברך המוציא ואוכל אלא מתוך שאין לו יין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אמרו שמסדר אותם כולם על הפת בשעת המוציא ואע\"ג דאין מבדילין על הפת הכא איידי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמקדש על הפת מבדיל נמי על הפת ומתוך כך הוצרכו להעמיד המשנה במוצאי שבת לי\"ט",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מפני שסוברים דמאי דאמרי' דאמימר בת טות לא היה עושה כן משום חומרא אלא מן הדין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היה עושה שאסור לאכול קודם הבדלה ואם איתא דמיירי (מתני') בשאר מוצאי שבתות דעלמא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כיון שלא היה לו יין לא היה לו לאכול אלא ודאי במ\"ש ליו\"ט מיירי שחייב לקדש",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולאכול דקי\"ל (שם קא.) אין קידוש אלא במקום סעודה וכיון שיש לו לקדש ולאכול איידי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמקדש על הפת מבדיל נמי על הפת והרי\"ף ז\"ל דחה זו הסברא בהלכותיו דבהדיא אמרי'",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בתוספתא לא נחלקו על בהמ\"ז שבתחלה דמשמע דמזון האמור במשנתנו על ברכת המזון נאמר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ובירושלמי נמי גורס כן ועוד דבירושלמי אומר היה יושב ואוכל דמשמע דמיירי שכבר אכל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדמפרש ואזיל בהלכות:",
      "segment_ids": [
        7
      ]
    }
  ],
