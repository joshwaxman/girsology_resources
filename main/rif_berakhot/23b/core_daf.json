      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"18\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Berakhot 33b:16\" data-ror-ocr=\"וחנון אמה ועל קן צפור מגיעין רממיך\">וחנון אתה ועל קן צפור יגיעו רחמיך</i> <i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Berakhot 33b:16\" data-ror-ocr=\"שאמרת לשלח האם משחקים אומו לפי\"><i class=\"ror-printed-only\" data-ror-ocr=\"האם משחקים אומו לפי\" data-ror-chars=\"16\">°</i></i>"
