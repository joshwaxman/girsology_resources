      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אוכל למחר ולא יום שני ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יום שלישי עד שיבדיל וסמכו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להא דאמרי' (פסחים ק.) ובת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טות ואין זה מתקבל כלל דודאי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר לו לאכול ומאי דאמר ובת",
