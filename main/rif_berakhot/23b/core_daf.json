      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכיון שטעה בשניהם שלא יועיל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו באמירת הבדלה בלבד וצריך",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחזור ולהתפלל ולהבדיל בתפלה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או אמרינן שכמו שאם היה זוכר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קודם שיאכל היה מבדיל על הכוס",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא היה צריך לחזור ולהתפלל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"נ עכשיו א\"צ לחזור ולהתפלל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא המבדיל על הכוס ומסקנא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחוזר ומתפלל דקנסינן ליה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שטעה בשתים והיכא שאין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו יין במה שיבדיל או שאין לו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכר אם מנהג המקום לשתות השכר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקביעות אית דבעי מימר שאינו",
      "segment_ids": [
