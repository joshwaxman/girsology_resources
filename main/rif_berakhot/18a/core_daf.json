      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמתפלל אותה קבעה עליו חובה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
