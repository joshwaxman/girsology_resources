      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכיון שקדש ביום <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ב\" data-order=\"2\"></i>כבר יצא ידי",
      "segment_ids": [
