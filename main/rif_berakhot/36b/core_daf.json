      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהכי אמרינן זכור את יום השבת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקדשו אין לי אלא ביום בלילה",
      "segment_ids": [
