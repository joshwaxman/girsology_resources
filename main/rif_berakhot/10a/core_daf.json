    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא לומר דלשון אסור דקאמרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא קאי אלא אמשמרו בלחוד",
