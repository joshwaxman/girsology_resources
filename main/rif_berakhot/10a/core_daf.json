      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כלל דאורייתא אלא אנינות ומיימוני וה\"ג",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
