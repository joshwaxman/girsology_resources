      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היינו לענין אכילת קדשים כדאיתא בזבחים",
      "segment_ids": [
