      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה בלחישא כי היכי דלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליזלזלו בהטוב והמטיב שהיא",
