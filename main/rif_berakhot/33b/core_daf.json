      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ירושלים בלבד אלא ה\"ה בסוף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאר ברכות דגרסי' התם מ\"ד הרי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה חכם בעונה בסוף ומדקאמר",
      "segment_ids": [
