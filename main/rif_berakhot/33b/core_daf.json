      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסוף סתם משמע שאין הדבר תלוי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בבונה ירושלים מפני שהוא",
