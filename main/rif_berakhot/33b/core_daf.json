      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין שלש ברכות שהן מן התורה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לברכה רביעית שהיא מדרבנן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואין זה נכון שבפירוש נראה",
