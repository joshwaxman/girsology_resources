      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והמטיב לאו דאורייתא כלומר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשהיה מסיים בונה ירושלים היה",
      "segment_ids": [
