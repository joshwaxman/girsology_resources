      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרעה צווי ומצינו ככה יעשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "איוב שהוא הווה ורבים כאלה ורבנן אמרי אינו צריך לחזור פעם אחרת ולומר נברך אלא אחר שענו האחרים ברוך שאכלנו משלו",
      "segment_ids": [
