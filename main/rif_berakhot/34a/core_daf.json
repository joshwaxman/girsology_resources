      "text": "משום דס\"ל שהנברך שאומר תחלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא צווי שאומר לאחרים נברך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאכלנו משלו והשני שחוזר אחר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שענו האחרים אמן הוא הווה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאומר אנו מברכין לבורא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאכלנו משלו שפעמים הוא צווי",
      "segment_ids": [
