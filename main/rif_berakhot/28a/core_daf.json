    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלנו <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>אפ\"ה למדנו מהירושלמי",
      "segment_ids": [
