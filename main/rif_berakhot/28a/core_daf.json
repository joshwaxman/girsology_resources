  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תאני</b> רבי חייא אין מברכין על הפת אלא בשעה שהוא פורס אמר ר' חייא בר אבא הדא אמרת מאן דנסיב פוגלא ומברך עליו והוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא אתי בידיה צריך לברכה עליה זמן תניינות א\"ר תנחום ברבי יודן צ\"ל ברוך שם כבוד מלכותו לעולם ועד שלא להזכיר שם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמים לבטלה ומדקא יליף ממילתיה דרבי חייא שאם נפל חתיכת צנון צריך לחזור ולברך פעם אחרת למדנו שסובר הירושלמי שטעם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ר' חייא אינו אלא מפני חשש שמא תפול מידו ויצטרך לחזור ולברך פעם אחרת ולפיכך היה אומר כן ואע\"ג שבזה חולק עם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התלמוד שלנו <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>אפ\"ה למדנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהירושלמי שמי שבירך על הדבר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונפל מידו ואינו מוצאו צריך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחזור ולברך כשחוזר ואוכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאותו המין: <b>וכן</b> למדנו שמי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבירך ברכה שאינה צריכה יש לו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לומר ברוך שם כבוד מלכותו",
