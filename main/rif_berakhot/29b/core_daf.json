  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא לאחריהם שלא מחמת הסעודה בתוך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הסעודה טעונין ברכה לפניהן ואין טעונין",
