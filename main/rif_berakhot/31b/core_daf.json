        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהנשמה נהנית ממנו ואין הגוף נהנה ממנו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוי אומר זה הריח: תנו רבנן הביאו",
