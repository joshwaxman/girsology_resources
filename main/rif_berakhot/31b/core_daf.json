      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכה בפני עצמו ומברכים עליו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
