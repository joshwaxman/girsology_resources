  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הרואה את חבירו לאחר ל' יום וכו'.</b> דוקא בחבירו ששמח בראייתו אבל בשאר חבירים לא:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לאחר</b> י\"ב חדש מברך מחיה המתים מפני שנשכח מהלב כמו שהמת נשכח לאחר י\"ב חדש דכתיב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נשכחתי כמת מלב הייתי ככלי אובד מה כלי מתיאש אדם ממנו כשאבד אותו ולא מצאו בתוך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "י\"ב חדשים אף המת נשתכח מהלב לאחר י\"ב חודש: <b>והמית אתכם בדין.</b> ואע\"ג דקי\"ל (שבת",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דף נה:) יש מיתה בלא חטא אפ\"ה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דינו דין אמת שהוא יודע כל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרכי איש וכל דרכיו משפט: <b>אם</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בטרודין דיו פעם אחת וכו'.</b>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פי' רבינו חננאל ז\"ל אע\"פ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינן נראין הברקים סמוכין זה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אצל זה אלא עכשיו פעם אחת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואחר שעה פעם אחרת כיון שלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפסקו העננים לגמרי די בברכה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחת אבל אם העננים הראשונים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפסקו ושמים זכו בעיניו אם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוזר ורואה אח\"כ מברך פעם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחרת והוא מלשון ודלף טורד:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הרואה חמה בתקופתה וכו'.</b> פי'",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבר ידוע הוא שלסוף מחזור של",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמונה ועשרים שנה תקופת ניסן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוזרת למקום אשר היה שם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתחילת ברייתה והוא לעולם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בליל רביעי <i data-commentator=\"Hagahot HaBach\" data-label=\"ח\" data-order=\"8\"></i>למחר בבקר וכשרואה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החמה מברך עושה בראשית: <b>לבנה</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בטהרתה.</b> אמר ר\"מ ז\"ל כשתחזור",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלבנה לתחלת מזל טלה בתחלת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החדש ולא תהיה נוטה לא לצפון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא לדרום <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>וכן בכל עת שרואה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מזל טלה עולה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>מקצת אל המזרח",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על כל א' מאלו מברך עושה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[מעשה] בראשית ורבינו יהונתן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכהן ז\"ל כתב ומזלות בעתם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נודע לחכמי הכוכבים אימתי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוזרים למקום שהיו שם בשעת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בריאת העולם: <b>ברוך רוב</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ההודאות ואל ההודאות.</b> נראה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למורי שהטעם שהוצרכו שניהם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שאם היה אומר רוב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההודאות בלבד היינו אומרי'",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מרובן אבל לא מכולן כדאמרי'",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(מגילה טז:) ורצוי לרוב אחיו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא לכל אחיו לפיכך הוצרך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לומר אל ההודאות להורות שהוא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על כולן ואם היה אומר אל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההודאות בלבד היה נראה אל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקצת ההודאות ויש זולתו למקצת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האחרות לפיכך הוצרכו שתיהן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רוב ההודאות להורות על הרוב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואל ההודאות להורות על המיעוט",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנשאר שלא היה מובן מהלשון",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשון: <b>מתני' קנה בית חדש</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו' מברך על הרעה מעין הטובה</b>",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> מפרש בגמ' (דף ס'.) על",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרעה שעתידה להיות טובה אע\"פ",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהטובה תהיה לבסוף יותר מהרעה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כגון ששטף הנהר שדהו ועכשיו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא רעה והוא רואה כי לבסוף",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהיה לו טובה יותר שתזדבל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שדהו אפי' הכי לא יברך הטוב",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והמטיב אלא דיין האמת וכן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מברך על הטובה מעין הרעה ר\"ל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאם הגיע אליו עכשיו טובה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"פ שאפשר שסופה להיות רעה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יותר כגון שמצא מציאה ועכשיו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא טובה וסופו שיקח המלך",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותה וכל שאר ממונו אפ\"ה אינו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מברך אלא הטוב והמטיב באשר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא שם. מפי מורי הרב נר\"ו:",
      "segment_ids": [
        7
      ]
    }
  ],
