  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> הראב\"ד ז\"ל כתב דעל בריות מכוערות לא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יברך אלא פעם ראשונה שהשינוי עיליו גדול",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא יותר לא עליהם ולא על כיוצא בהם עד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיראה מכוערין מהם וכן לענין בריות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טובות ונאות והתוספות והרא\"ש והטור כתבו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שצריך לברך עליהם משלשי' יום לשלשים יום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכתב בשם הראב\"ד דדוקא במי שמצטער עליו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מפני שהוא חיגר או סומא כגון בר ישראל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דומיא דבריות טובות שיש לו הנאה לרואה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל על עובדי ע\"ז אין מברך וצ\"ע דהא גבי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בריות טובות מברך אפי' הן עובדי ע\"ז: <b>ב</b>",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        5,
        13
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הראב\"ד ז\"ל כתב דמברך עליהן תרתי ברוך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        13
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שכחו וברוך עושה בראשית ותוס' ומיימוני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        13
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וסמ\"ג וטור כתבו כרבינו והסכימו שטוב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        13
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לברך שכחו וגבורתו מלא עולם: <b>ג</b> כך נראה",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        13,
        17
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לפי דעת רבינו אבל הטור כתב שהם דברי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        17
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יחיד ותמה על הרמב\"ם שפסק כבעמוד ולדעתי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        17
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כי לא מלאו לבו לחלוק עליו דאיפשר לומר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        17
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כיון דבדברי ר' יהודה איכא אימתי הוי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        17
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כאילו בא לפרש ויכול להיות שהלכה כמותו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        17
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ותפתר דברי ת\"ק בימים קטנים וסמ\"ג נמי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        17
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב כרבינו. ויש תימא על מיימוני מדבריו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        17
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבפירוש המשניות לדבריו שבחיבורו בזה: <b>ד</b>",
      "segment_ids": [
        2,
        3
      ],
      "gemara_segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תמה הטור על דברי העמוד שפסק דכי ליכא",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        18
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שותפות בהדיה דמברך שהחיינו וכן כתב",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        18
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש דמברך הטוב והמטיב כשהשדה הוא שלו",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        18
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומיי' וסמ\"ג כתבו כרבינו: <b>לשון ריא\"ז</b> על",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        18
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הגשמים מברך ברוך הטוב והמטיב והוא שיש",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        18
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו קרקע שהוא משותף באותה הטובה עם שאר",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        18
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעלי קרקעות אבל אם אין לו קרקע מברך כך",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        18
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מודים אנחנו לך: <b>ה</b> כתב סמ\"ג ואפילו",
      "segment_ids": [
        3,
        4
      ],
      "gemara_segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ישנים שהם חדשים לו מברך עליהם שהחיינו",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונראין הדברים דוקא בדברים שהן חשובין",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קצת וכן כתב מורי ואני שמעתי שכתב רב",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שרירא גאון שאין מברכין עליהן אלא בדבר",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הבא מזמן לזמן וכתב שכן מוכיח בפרק בכל",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מערבין וכן כתב רש\"י בשם רב שרירא",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והרא\"ש כתב י\"ל שהכל לפי מה שהוא אדם יש",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עני ששמח בחלוק יותר מעשיר בכלים חשובים",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ועוד כתב הרא\"ש שבשעת קנין יש לו לברך",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אע\"פ שעדיין לא נשתמש בהן שאין הברכה",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא על ידי שמחת הלב שהוא שמח בשעת",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קנייתן: כתב בסמ\"ק שאם קנה לו ולביתו",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מברך גם הטוב והמטיב ירושלמי קנה מברך",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהחיינו נתנו לו במתנה מברך הטוב והמטיב",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיש בו טובה לו ולנותן. לבש מברך מלביש",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ערומים:",
      "segment_ids": [
        4
      ],
      "gemara_segment_ids": [
        19
      ]
    }
  ]
}