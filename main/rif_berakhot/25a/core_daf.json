        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הארץ ומלואה תבל ויושבי בה: ר' לוי רמי",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתיב לה' הארץ ומלואה וכתיב (תהילים",
