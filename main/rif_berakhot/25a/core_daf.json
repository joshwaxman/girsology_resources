  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכה מעל מאי תקנתיה אמר רבא ילך אצל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חכם <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>מעיקרא וילמדנו ברכות כדי שלא יבא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לידי מעילה: אמר רב יהודה אמר שמואל כל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנהנה מן העולם הזה בלא ברכה כאילו נהנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקדשי שמים שנאמר (תהילים כ״ד:א׳) לה'",
