      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ערכין שצריך שיעשו הפדיון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתלוש: <b>מאי תקנתיה אמר רבא</b>",
      "segment_ids": [
