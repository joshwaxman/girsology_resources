      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין ויאמר לאמת ויציב לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יפסיק זה כשקורא הפרשיות על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הסדר דכיון שיש לו להזכיר אני",
