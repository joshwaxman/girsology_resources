      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ור\"ל שכיון ששתה זוגות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהמזיקין שולטין בהם ובא",
      "segment_ids": [
