  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "מקודשת <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מנה <span class=\"bavli-ref\" data-bavli-ref=\"(דף ח:)\" data-bavli-daf=\"8b\" data-bavli-index=\"0\"></span>אין כאן משכון אין כאן והא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתניא קדשה במשכון מקודשת במשכון דאחרים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכדר יצחק דא\"ר יצחק מנין לבעל חוב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקונה משכון שנאמר ולך תהיה צדקה אם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אינו קונה צדקה מנין מכאן לבעל חוב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקונה משכון <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>בני רב הונא בר אבין זבין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ההיא <i data-commentator=\"Tur\" data-label=\"⚬\"></i>אמתא בפריטי ולא הוו בידייהו זוזי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותיבו נסכא עילווה לסוף אייקר אמתא אתו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לקמיה דרב אמי א\"ל פריטי אין כאן נסכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין כאן (תנו רבנן <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Marriage\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Even HaEzer\" data-label=\"⚬\"></i>התקדשי לי במנה נטלתו",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וזרקתו לים או לאור או לכל דבר האבד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אינה מקודשת והוא הדין אם השליכתו לפניו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אינה מקודשת) תנו רבנן התקדשי לי במנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תנם לאבא ולאביך אינה מקודשת (על מנת) שיקבלום לי מקודשת התקדשי לי במנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תנם לפלוני אינה מקודשת (על מנת) שיקבלם לי מקודשת ת\"ר התקדשי לי במנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תנם על גבי הסלע אינה מקודשת ואם היה סלע <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>שלה מקודשת בעי רב ביבי סלע של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שניהם <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i><i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i>מהו תיקו התקדשי לי בככר תנהו לכלב אינה מקודשת ואם היה כלב שלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מקודשת בעי רב מרי כלב הרץ אחריה מאי תיקו וכל תיקו דקדושין צריכה גט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דהוה ליה ספקא דאורייתא ולחומרא עבדינן: התקדשי לי בככר תנהו לעני אינה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מקודשת ואפילו לעני הסמוך עליה מאי טעמא דאמרה ליה כי היכי דמחייבנא ביה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אנא הכי נמי מחייבת ביה את ההוא גברא <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Marriage\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Even HaEzer\" data-label=\"⚬\"></i>דהוה מזבין <span class=\"bavli-ref\" data-bavli-ref=\"(דף ט.)\" data-bavli-daf=\"9a\" data-bavli-index=\"1\"></span>חומרי פתכייתא אתיא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ההיא איתתא אמרה ליה הב לי חד שוכא אמר לה אי יהיבנא לך מקדשת לי אמרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ליה הב מיהבא אמר רב חמא כל הב מיהבא <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>ולא כלום הוא ההוא גברא דהוה קא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מזיג חמרא אתיא ההיא איתתא אמרה ליה אשקיאן אמר לה אי יהיבנא לך מקדשת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לי אמרה ליה אשקיאן אשקויי אמר רב חמא כל אשקיאן אשקויי לאו כלום היא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ההוא גברא דהוה שדי תמרי מדיקלא אתיא ההיא איתתא אמרה ליה שדי לי תרתי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אמר לה אי שדינא לך מקדשת לי אמרה ליה שדי מישדא אמר רב זביד כל שדי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מישדא <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>ולא כלום הוא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ה\" data-order=\"5\"></i>איבעיא להו",
      "segment_ids": [
        5,
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מנה אין כאן משכון אין כאן.</b> כתב הרמב\"ן ז\"ל דאפי' היכא דאמר לה קני משכון זה בשעבוד מנה והתקדשי לי בו ומשכתו אינה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מקודשת דנהי דקניא ליה משכון לההוא שעבודא אינה מקודשת בכך דמנה אין כאן כלומר דעיקר שעבודא דמנה גבי לוה הוא ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גבי אשה ומש\"ה משכון נמי אע\"ג דגבי אשה הוא הרי הוא כאילו משכון אין כאן שאין המשכון אלא להבטחת השעבוד וכיון דמנה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אין כאן גבי אשה משכון נמי אין כאן וכי תימא נהי דשעבודא גבי לוה למה אינה מקודשת באותו שעבוד והא אמרי' בפרק האיש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקדש (דף מז:) המקדש בחוב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאחרים בין במלוה בשטר בין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במלוה על פה מקודשת מדינא אי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאו משום טעמא דלא סמכא דעתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלמא מחיל ליה וכדשמואל דאמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חזר ומחלו מחול והכא ודאי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שייכא ביה מחילה וכיון שכן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היכי אמרינן דמנה אין כאן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איכא למימר דלא דמי דבשלמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקדש במלוה דאחרים לא שייכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[כסף] קידושין גבי מקדש כלל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכיון שקדש את האשה באותה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלוה אין כאן [אצלו ממנה]",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלום משא\"כ במקדש במלוה דידיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמנה אין כאן כלומר דאותו מנה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא מקדש בה אכתי אגיד גביה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכסף קדושין דאגיד גבי בעל לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כסף קדושין הוא אבל הראב\"ד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל פירש דה\"ק מנה אין כאן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהרי לא נתחייב לה בו דמילי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלמא נינהו וכיון דמנה אין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כאן משכון נמי אין כאן דלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קניא ליה למשכון במידי דמאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהבה ליה דקניא לה משכון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>ודכוותה נמי הא דאמרי' בסמוך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פריטי אן כאן נסכא אין כאן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר דכיון שלא נתחייב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפריטי אין השעבוד נתפס על",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנסכא שהוא משכון אבל היכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנתן לה משכון ואמר לה קני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במשכון זה שעבוד מנה והתקדשי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לי בו מקודשת: <b>התם במשכון</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דאחרים.</b> שהיה בידו וקדשה בחוב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שיש לו עליו [ומשום הכי] מקודשת שהמשכון עצמו קנוי לו כדר' יצחק והא דר' יצחק בכל ענין היא אפי' משכנו (שלא) בשעת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלואתו וכמו שכתבתי במקומות אחרים בס\"ד: <b>בפריטי.</b> על מנת לקבל פרוטות נחושת: <b>נסכא.</b> חתיכה של כסף: <b>פריטי אין כאן.</b>",
      "segment_ids": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהתנו עליה הלכך נסכא שהוא משכון אין כאן להיות במקומן לקנות ואילו נתנו הפרוטות היתה קנויה להם דעבד כנעני נקנה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בכסף: <b>ומדאמרינן</b> פריטי אין כאן נסכא אין כאן הביא ראיה הרב אלפס ז\"ל בפרק הזהב דבדברים ומשכון לא קאי באבל אמרו ואף",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על פי שאין מכאן ראיה בירושלמי מפורש כן ויתבאר בפ' הזהב בס\"ד: <b>גרסי בגמ' [דף ח:] התקדשי לי במנה נטלתו וזרקתו לים</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>או לאור או לכל דבר האבד.</b> כלומר בפניו לומר שאינה רוצה: <b>אינה מקודשת.</b> ודייקינן עלה הא שדתינהו קמיה. כלומר במקום",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו אבד הוו קידושי בתמיה והא אמרה ליה שקיל לא בעינא ומפרקינן לא דקא עבדה הכי סברא איבדקיה להאי גברא אי רתחנא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא קמ\"ל: <b>[שם] ת\"ר התקדשי לי במנה תנם לאבא ולאביך אינה מקודשת.</b> מיבעיא קאמר לא מיבעיא היכא דשדיתינהו קמיה דלא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוה קידושין אבל זרקתו לים או לאור אימא מדמיחייבה בהו קידושי קידשה נפשה והאי ולא דמי לתן מנה לפלוני ואקדש אני לך",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דהתם איהי קאמרה ליה מעיקרא אבל כאן משטה היא בו כלומר תן מעותיך לאחרים: <b>שיקבלום לי מקודשת.</b> ואמרינן בגמרא דתנא",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אבא להודיעך כחה דרישא דאע\"ג דאבוה הוא לא גמרה וקדשה נפשה ותנא אביך להודיעך כחה דסיפא דאע\"ג דלאו קרוב הוא סמכא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דעתה עליה דעביד שליחותה: <b>תנם לפלוני אינה מקודשת על מנת שיקבלם לי מקודשת.</b> בגמרא עבדי צריכותא מהנך תרי בבי",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וגרסינן הכי וצריכא דאי אשמעינן אבא ואביך התם הוא דכי אמרה שיקבלום לי הוו קידושי דסמכא דעתה סברה עבדין לי",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שליחותי אבל פלוני אימא לא צריכא ואי אשמעינן פלוני התם הוא דכי אמרה תנם לא הוו קידושי דלא מקרבא דעתה לגביה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למיתבא ליה מתנה אבל אבא ואביך דמקרבא לה דעתה לגבייהו אימר במתנה יהבינהו ניהליה צריכא. ואיכא למידק וליתני אבא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ופלוני אבא להודיעך כחה דרישא פלוני להודיעך כחה דסיפא ואמאי תני אביך ותו ליתנינהו כולהו בחדא בבא תנם לאבא ולאביך",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולפלוני אינה מקודשת ע\"מ שיקבלום לי מקודשת איכא למימר תנא הכי שמעינהו וגרסינהו ודכוותה מתרצינא בגמרא לעיל מהא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "[דף ו.]: <b>ת\"ר התקדשי לי במנה תנם ע\"ג הסלע אינה מקודשת ואם היה סלע שלה מקודשת.</b> פירש\"י ז\"ל לפי שחצרו של אדם קונה",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לו שלא מדעתו והרי הוא כמי שקבלתו ולפי זה הא דבעי רב ביבי סלע של שניהם מהו [אע\"פ] דקיימא לן בפרק הספינה (דף פד:)",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דחצר השותפין אין קונין בו מקח זה מזה הכי קא מיבעיא ליה מי אמרי' דכיון דיש לה חלק בו כי אמרה ליה תנם על גבי הסלע",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דעתה להתקדש ואיהו נמי כיון דניחא ליה לקדשה אקנויי אקני לה מקום <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>באותו הסלע וקני לה או דלמא דכיון דסלע זו אינה",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלה לגמרי <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>דחיא בעלמא הוא: <b>כלב הרץ אחריה.</b> לנשכה מהו ומפרשינן [הך בעיא] בגמ' הכי מי אמרי' בההיא הנאה דקא מצלי לה",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מיניה גמרה ומקניא נפשה או דלמא אמרה ליה חיובי מחייבת לאצולן וסלקא בתיקו ולחומרא ואף ע\"ג דבתנהו לעני פשטינן",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בסמוך דאפי' עני הסמוך לה אינה מקודשת משום דאמרה לי' כי היכי דמחייבנא ביה אנא הכי נמי מחייבת ביה את אפי' הכי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מספקא לן משום דאיפשר דהצלה דגופה חשיבא לה טובא וגמרה ומקניא נפשה: <b>וכתב</b> הרמב\"ן ז\"ל דמאי דאמרי' תנם על גבי סלע",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אינה מקודשת תנהו לכלב אינה מקודשת לאו בחד גוונא נינהו דבתנם על גבי סלע אפי' אמרה ואתקדש אני לך לאו כלום הוא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משום דלאו מידי עבד אפומה אבל בתנהו לכלב אילו אמרה ואתקדש אני לך מקודשת שכיון שהוציא ממון על פיה מקודשת מדין ערב",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וכן בדיני ממונות האומר זרוק מנה לים ואתחייב אני לך חייב שעל פיו הוציא וא\"ת והא אמרי' בפרק השואל (דף צט.) אמר לו",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "השאילני פרתך אמר לו ביד מי הכישה במקל והיא תבא ואמר רב עלה דכיון שיצתה מרשות משאיל שעה אחת ומתה חייב ושמואל",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פליג עליה ואמר דפטור ומשמע התם דרב אשי קאי כשמואל ופסקו הרב אלפסי ז\"ל והר\"ם במז\"ל כשמואל דפטור אלמא דאע\"ג דאמר",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ליה הכישה במקל והיא תבא לא מיחייב מדין ערב י\"ל דהתם היינו טעמא משום דלא אמר ליה בהדיא ואתחייב אני לך הלכך מסתמא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא מיחייב עד שמתחייב שואל בעלמא דהיינו משנכנסה ברשותו אבל היכא דאמר בהדיא ואתחייב אני לך לכולי עלמא מהני מדין",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ערב א\"נ יש לומר התם משום שבידו של משאיל לאהדורה ונמצא שלא הוציא ממון על פיו אבל זרוק מנה לים ואתחייב או אתקדש",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אני לך מתחייב ומתקדשת מדין ערב שעל פיו הוציא זה דעת הרמב\"ן ז\"ל ואחרים כתבו דלעולם לא מיחייב מדין ערב אלא במוציא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ממון מרשותו לרשות אחר בן דעת לפי שבזכותו של זה מתחייב זה מדין ערב אבל במוציא ממון לאיבוד כי הכא אע\"ג דאמר בהדיא",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואתחייב אני לך לא מהני וכן זרוק מנה לים ואתקדש לך לאו כלום הוא וכן דעת קצת חכמי הצרפתים והרשב\"א ז\"ל: <b>ההוא</b> גברא",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דהוה קא מזבין חומרי בוטונ\"ס בלע\"ז שעושין אותו כמין ענק ונושאין אותו בצואריהן למכור: <b>הב לי חד שוכא.</b> מלא חוט: <b>אי</b>",
      "segment_ids": [
        14,
        15,
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>יהיבנא לך מיקדשת לי.</b> בלשון שאלה קאמר לה:",
      "segment_ids": [
        16
      ]
    }
  ],
