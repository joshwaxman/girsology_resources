      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקודשת הרי היא במקום פלוני והלך וקדשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במקום אחר מקודשת המקדש את האשה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>על מנת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין עליה נדרים ונמצאו עליה נדרים אינה",
