      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אביה במדינת הים] תאסר <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>לעולם",
      "segment_ids": [
        1
      ]
    },
    {
