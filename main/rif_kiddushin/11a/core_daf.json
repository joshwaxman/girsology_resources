  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וזוקקין את הנכסים שיש להם אחריות וכו'.</b> מנין לגלגול שבועה מה\"ת שנא' ואמרה האשה אמן אמן ותנן אמן על האלה אמן על",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "השבועה אמן מאיש זה אמן מאיש אחר אמן שלא שטיתי ארוסה ונשואה שומרת יבם וכנוסה. הכי איתא בגמ' ומוכחא גלגול שבועה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מארוסה ונשואה דשקלי' וטרינן ביה טובא ולא אפשר לאוקמה אלא ע\"י גלגול ומוכחין הכי מאמן אמן יתירא: <b>ואיכא</b> למידק ל\"ל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאכוחי מארוסה ונשואה דדייקינן בה טובא היכי דמי הא קתני בהדיא אמן מאיש זה אמן מאיש אחר ומאיש אחר ודאי לא משכחת.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה אלא ע\"י גלגול שהרי לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קינא לה ממנו י\"ל אי מההיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"א הנ\"מ בדברים שראוי להשביע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליהם בעלמא דומיא דאיש אחר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שראוי להשביעה עליו אם קינא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה ממנו אבל בדברים שאין ראוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להשביע עליהן כלל כגון קרקעות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוה אמינ' דאין מגלגלין קמ\"ל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ארוסה שאע\"פ שאין ראוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להשביעה מצד עצמה לעולם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדמפרש בגמ' אפ\"ה מגלגלין",
