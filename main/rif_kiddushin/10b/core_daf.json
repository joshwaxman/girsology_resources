      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמר רבי אלעזר מעשה במירוני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד שבירושלים שהיו לו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלין הרבה וביקש ליתן אותם",
      "segment_ids": [
