    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונתן לה בעת הקדושין משכון על המנה אינה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מקודש' שהרי דעתה להתקדש במנה ומנה אינו",
      "segment_ids": [
