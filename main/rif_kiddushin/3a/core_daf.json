      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נראין לי עיקר דהא ודאי נתן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא ואמרה היא דאמרינן דספיקא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוי משום <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>תלקח אשה לאיש היינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשאמרה כן בשעת נתינה אבל",
