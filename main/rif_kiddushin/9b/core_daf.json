        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גמל במשיכה וחמור בהנהגה אבל גמל בהנהגה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וחמור במשיכה איכא חד מינייהו דלא קני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא ידעינן הי מינייהו קני והי לא קני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הלכך במכר ובמתנה לא קני חד מינייהו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
