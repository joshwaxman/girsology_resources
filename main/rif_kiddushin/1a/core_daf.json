      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחופה אינו קונה להיות כאשתו ור\"ח כתב",
      "segment_ids": [
