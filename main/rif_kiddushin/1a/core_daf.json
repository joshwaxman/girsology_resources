      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לטבול ונמצא שבועל נדה ואפילו הכניסה",
      "segment_ids": [
