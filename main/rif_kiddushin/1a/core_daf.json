      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לידה אמר לה הרי את מקודשת לי וכששמעה",
      "segment_ids": [
