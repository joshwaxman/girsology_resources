      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האמורה בתורה ואפי' לא בא עליה לשם זנות",
      "segment_ids": [
