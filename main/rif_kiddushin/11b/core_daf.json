  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "זה בחליפיו <span class=\"bavli-ref\" data-bavli-ref=\"(דף כח:)\" data-bavli-daf=\"28b\" data-bavli-index=\"0\"></span>(<sup class=\"footnote-marker\">*</sup><i class=\"footnote\"><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>ד\"ת</i> <i class=\"footnote\">מ\"ז</i>רשות הגבוה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בכסף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רשות ההדיוט בחזקה אמירתו לגבוה במסירתו",
      "segment_ids": [
