  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "הרי את מקודשת לי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מעכשיו לאחר שלשים יום",
