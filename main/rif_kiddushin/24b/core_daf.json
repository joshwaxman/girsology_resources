    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יום ובא אחר וקדשה תוך ל' יום אסורה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לשניהם לעולם אא\"כ יתן האחד גט ותהא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מותרת לשני אבל לעלמא אסורה עד שיתנו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שניהם גט ואם אמר לה האחד מעכשיו ולאחר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ל' יום ואמר השני מעכשיו ולאחר עשרים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יום ואמר השלישי מעכשיו ולאחר עשרה ימים",
      "segment_ids": [
        0
