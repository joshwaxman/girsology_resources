    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיד האדון אם יש לו כלי לעשות בו חליפין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
