    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>לא מקני ליה דהא אמר ליה",
