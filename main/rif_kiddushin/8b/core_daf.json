    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו את המעשר דלא מהני <i data-commentator=\"Hagahot HaBach\" data-label=\"ט\" data-order=\"9\"></i>כי היכי",
      "segment_ids": [
