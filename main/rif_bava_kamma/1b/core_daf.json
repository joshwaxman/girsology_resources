      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקמן פ' המניח (דף כט:) אבל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אי אזיק בהדי דקא אזלי מקמי",
