  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> רש\"י פי' דניעו מי האף הליחה שיוצאה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מן החוטם וכיחו הוא רוק הפה ור\"ת פי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דכיחו הוא היוצא מן הגרון בכח וניעו הוא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היוצא מן הפה ע\"י נענועו: <b>ב</b> תמה הרא\"ש",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל על דברי הרב למה הוצרך לפרש דפטירי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משום דאורחייהו הוא הא קרא כתיב ובער",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשדה אחר ודרשינן ולא ברה\"ר ודקדק",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
