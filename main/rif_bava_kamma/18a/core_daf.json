  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "תנן התם <i data-commentator=\"Mishneh Torah, One Who Injures a Person or Property\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>התוקע לחבירו נותן לו סלע ההוא",
      "segment_ids": [
