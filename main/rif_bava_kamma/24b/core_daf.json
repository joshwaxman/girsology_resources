  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> יצאה וחזרה אם לא ידעו הבעלים ביציאתה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פטורין עליה אע\"פ שהזיקה בחזרתה ואסידעו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הבעלים ביציאתה ואע\"פ שחזרה שם שלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מדעתן ששמרה הבעל ונעל בפניה דלת שיכולה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעמוד ברוח מצויה ויצאה וחזרה שם והזיקה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משלם מה שהזיקה הואיל והורגלה לשם יש לו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לשומרה שמירה מעולה שלא תחזור עוד שם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמב\"ה בראיה ז': <b>ב</b> לדברי מיי' פ\"ג מהל'",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נ\"מ משמע שאם לאחר שיצתה מן הגינה בפעם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ראשונה נעל בפניה כראוי ויצאת פעם אתרת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לגינה והוא לא ידע פטור השומר דאע\"פ",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהיה שם פעם אחת בגינה אינו צריך לעולם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאוחזה ולסוגרה בדלת שיכול לעמוד בפני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כל רוח אלא שאם החזירה דרך שם צריך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאוחזה כדי שלא תפיל עצמה שם מכיון שהיא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למודה לצאת שם וכ\"כ שם מ\"מ בשם הרשב\"א",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל אבל הראב\"ד ז\"ל כתב דלא סגי ליה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנעילת דלת כראוי עד שיסגור בפניה בדלת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיכול לעמוד בפני כל רוח וכן משמע לשון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רש\"י ז\"ל וטור ח\"מ סי' שצ\"ד: <b>ג</b> איכא",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        3,
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פלוגתא אי מנכין למזיק עוד מה שמרויח",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ניזק שלא יכחיש שדהו או לא. הרא\"ש ז\"ל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב דלאתר ששמין הנזק שעשה בששים כמו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שביארנו בהל' הפשוטים עדיין פוחתים מזה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ששמין כמה הרויח הניזק שלא הוכחש שדהו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במה שלא נשארו בו הפירות עד שנגמרו כי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כל כמה שעומדין הפירות על האילן כך",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מכחישין אותו שתמיד יונקין לחלוח הגפן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הלכך כל כמה שממהר לקיטתן הוה שבח דאילן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ודשדה הלכך זה שהזיק פירות אלו שהיו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריכין לקרקע עדיין נמצא שהשביח השדה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאילו היו עומדים שם עד שלא היו צריכין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לקרקע היו מכחישין השדה והאילן ומנכין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממנו זה השבא והרמ\"ה ז\"ל פסק דאין מנכין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו כלל מזה והביא הרא\"ש ז\"ל ראיותיו. גם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
