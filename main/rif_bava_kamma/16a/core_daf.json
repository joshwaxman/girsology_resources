      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ורבי יהודה סבר פלגא אבל פחת נבלה כ\"ע לא פליגי דניזק הוי דשמין לנבלה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "כמה שויא בשעת",
      "segment_ids": [
        5
      ]
    }
