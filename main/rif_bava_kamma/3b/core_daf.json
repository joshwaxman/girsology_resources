      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זיבורית אבל הכא שמעון גופיה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי לוקח הוא ומיהו רצה גובה",
