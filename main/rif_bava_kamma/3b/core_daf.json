      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצי דחי ליה גבי לוי לבינונית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג דשעבודיה הוא משום דאפי'",
