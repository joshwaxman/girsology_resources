      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יכולין להוציאה מיד הלוקח הכוונה בזה",
      "segment_ids": [
