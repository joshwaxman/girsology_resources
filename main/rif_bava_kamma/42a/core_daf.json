        1
      ],
      "gemara_segment_ids": [
        1,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וטוח\"מ פי' שנ\"ו אפי' שהלוה על משכון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שוה ק' מאתים זוז טפי מכדי דמי המשכון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אעפ\"כ עשו בו תקנת השוק וצריך ליתן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למלוה המעות שנתן לגנב והראב\"ד ז\"ל ס\"ל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאם הלוהו יותר מכדי דמי המשכון דלא עשו",
