    {
      "width": "380px",
      "right": "275px",
      "text": "במפקיר נזקיו <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Damages to Property\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i>ר' מאיר <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>סבר מפקיר נזקיו",
      "segment_ids": [
        0
