  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> מיי' פ\"ה מהל' חובל ומזיק כתב שהאומר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחבירו סמא עיני קטע ידי ע\"מ שאתה פטור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ה\"ז חייב בה' דברים דודאי לא מחיל איניש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על נזקי גופו דראשי איברים כך פי' המ\"מ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דברי מיי' ז\"ל וכדברי מיי' כתב גם סמ\"ג",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עשין סי' ע' והרא\"ש והתוס' והטוח\"מ סי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תכ\"ז כתבו דאפי' בראשי איברים אם א\"ל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"מ לפטור בפירוש ה\"ז פטור אך צריך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיאמר לו כן בפירוש דאם אמר לו הן בלבד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרי הוא כלאו: <b>ב</b> הרא\"ש ז\"ל כ' דתשלום זה",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היינו בזה האופן שמשלם הדמים כשהיתה שוה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הפרה עם הולד או הרחל עם הגיזה כשעת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הגזילה וישאר הפרה והרחל לגזלן וגם הולד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וגם הגיזה הכל לגזלן משום דקנינהו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשינוי ואין הנגזל יכול לומר החזיר לי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פרה ורחל גופייהו שגזלת ממני ושלם לי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עליהן שבח העיבור וטעינת הגיזה רק גוף",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הפרה והרחל של גזלן ומשלם הדמים שהיה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שוה בשעת הגזילה והוכיח הרא\"ש ז\"ל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דמעוברת וילדה מקרי שינוי בכמה ראיות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"ש באורך. וכ\"כ הנ\"י ז\"ל בשם הר\"ז ז\"ל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דהוי נמי שינוי בגוף הבהמה וכ\"כ הטור",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ח\"מ סי' שנ\"ד וסי' שס\"ב אבל מדברי מיי'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פ\"ב מהל' גזילה מוכח להדיא דגיזה ולידה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לא הוי שינוי מעשה שהרי איהו סבירא ליה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דכל שנשתנית שם הגזילה אפי' בלא יאוש",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קננהו הגזלן התם בריש פ\"ב מהל' גזילה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואח\"כ באותו פרק עצמו דכי ליכא יאוש אבל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גזל פרה מעוברת וילדה אינו קונה גוף",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הפרה וכ\"כ הנ\"י בשם הרא\"ה ז\"ל:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        10
      ]
    }
  ]
