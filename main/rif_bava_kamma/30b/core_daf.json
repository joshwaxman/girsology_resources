      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או שהזיק את שור חבירו בגופו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרך הלוכו שדחפו בלא כונה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהוי תולדה דרגל אבל נזקי קרן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא דלא שכיחא אבל גזלות נראה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכל התלמוד דמילתא דשכיחא",
      "segment_ids": [
