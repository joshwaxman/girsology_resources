    {
      "width": "380px",
      "right": "275px",
      "text": "והלואות אדם באדם <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>נמי שליחותיהו קא",
      "segment_ids": [
        0
