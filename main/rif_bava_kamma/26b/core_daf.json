        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נש דלא מפרסמא נפשיה יתיהבון לבני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אריסיה א\"ל מריה דפקדונא כבר יהבית פלגא",
