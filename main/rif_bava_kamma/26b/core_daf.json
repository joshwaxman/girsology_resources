    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבסוף: <b>תלויה וזבין וכו'.</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכאן משמע דאפילו כשהאונס",
