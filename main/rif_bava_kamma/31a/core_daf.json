      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאב והרא\"ש שם והטור ח\"מ סי' תכ\"ד כתבו",
