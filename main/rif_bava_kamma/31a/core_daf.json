      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קישואין אחר שיתרפא ולכך יאכל הפירו'",
      "segment_ids": [
