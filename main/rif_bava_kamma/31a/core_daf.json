      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרב: <b>ב</b> מיי' פ\"ד מהל' חובל ומזיק כתב",
