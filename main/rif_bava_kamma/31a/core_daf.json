      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעבד ונראה דינתנו לעבד דלמה יזכה בהן",
      "segment_ids": [
