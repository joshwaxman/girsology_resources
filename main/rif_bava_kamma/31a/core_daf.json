      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינה סמוכה על שולחן אביה אין מעשה ידיה",
      "segment_ids": [
