      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכשמחזיר לו הגזילה שמין לו השבח ונוטל",
      "segment_ids": [
