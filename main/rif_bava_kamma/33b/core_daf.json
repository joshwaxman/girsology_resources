      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבח דגזילה דגזלן הוי אפי' שלא נשתנה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אצלו דגזלן כלל מכל מקום הוי שלו לא שנא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבח דאתי ממילא כי האי דלידה וגיזה לא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנא שבח דאתי מחמת הוצאה ל\"ש נתייאשו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הנגזלים קודם שהשביח ל\"ש לא נתייאשו בכל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ענין שבח שע\"ג גזילה דגזלן הוי ונראה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דהיינו טעמא משום תקנת השבים דאילו משום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שינוי תינח פרה ריקנית ונתעברה דאיכא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "העיבור דהוי שינוי לדידיה וכן טיעון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הצמר הוי שינוי לדידיה אלא שאר חפצים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דליכא למימר בהו דאיכא שינוי מאי איכא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למימר אלא ודאי דמשום תקנת השבים הוא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואינו נראה לומר דכל שבח דאתי על הגזילה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותו השבח נקרא שינוי דהא איכא שבח",
      "segment_ids": [
