      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הגזילה שמין לו השבח ונוטל מן הנגזל דהא",
      "segment_ids": [
