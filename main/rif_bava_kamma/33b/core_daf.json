    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבתים [דף לג ב] וטובא איכא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכמה דוכתי ואמרי' נמי בפרק",
      "segment_ids": [
