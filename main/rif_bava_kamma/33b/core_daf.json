      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדי שיקנה אותה הגזלן מ\"מ שבח הגזילה",
      "segment_ids": [
