      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעולם ס\"ל דבדמים מסלקי' ולא בגוף השבח",
      "segment_ids": [
