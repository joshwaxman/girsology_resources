    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> לדברי הרא\"ש שם והטור ח\"מ סי' שנ\"ד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
