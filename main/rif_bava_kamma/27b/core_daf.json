    "lines": [
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"0\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Bava Kamma 70a:4\" data-ror-ocr=\"מילי דלימ ליה גבי האין: ומורכן.\">ליה לשליח מידי דלית ליה גבי האיך: דאמר</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"0\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Bava Kamma 70a:4\" data-ror-ocr=\"מילי דלימ ליה גבי האין: ומורכן.\">ליה</i> <i class=\"ror-line\" data-ror-i=\"1\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Bava Kamma 70a:5\" data-ror-ocr=\"שמרשה אותו: ו א י י ל האיך. נאמן לשליח\"><i class=\"ror-printed-only\" data-ror-ocr=\"שמרשה אותו: ו א י י ל\" data-ror-chars=\"14\">°</i> האיך - נאמן לשליח</i> <i class=\"ror-line\" data-ror-i=\"2\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Kamma 70a:5\" data-ror-ocr=\"לאו בעל דברים לידי את: ו א י כ ס ב ליה\">לאו בעל דברים</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"2\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Kamma 70a:5\" data-ror-ocr=\"לאו בעל דברים לידי את: ו א י כ ס ב ליה\">דידי את: ואי כתב בה למחצה ולשליש</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i>"
      },
      {
        "width": "245px",
