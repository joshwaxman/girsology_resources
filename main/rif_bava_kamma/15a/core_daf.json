    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ראשון דמנפשיה נפל אע\"פ שהיה אנוס בשעת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נפילה אינו טרוד כ\"כ והיה לו לעמוד או",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להזהיר ופושע הוא בזה וחשיב גופו כאדם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המזיק וכן פי' אההיא דר' יוחנן אבל שני",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
