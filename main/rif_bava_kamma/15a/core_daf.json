      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הני חלוקות ועוד דדברי הרמ\"ה בחוטרא",
      "segment_ids": [
