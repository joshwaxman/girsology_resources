      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאמר לסופר כתוב לפלוני שישלח לי מעות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"י פלוני ואח\"כ חתם בדיוקני שלו ועדים",
      "segment_ids": [
