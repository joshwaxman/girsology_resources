  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> מיי' פ\"ה מהל' פקדון כתב דדין זה דמי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לטוענו מאתים והודה לו במקצת ואמר על",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השאר איני יודע שהוא מחויב שבועה ואינו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יכול לישבע ומשלם ה\"נ ישלם הנפקד ויטול",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המפקיד כדבריו בלי שבועה והוא שיטעון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבר שהוא אמוד בו ויש לשומר להחרים על",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מי שלקח ממנו יותר מן הראוי לו והשיגו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הראב\"ד ז\"ל וכתב דאין זה דומה למחויב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבועה ואינו יכול לישבע דלא אמרי' הכי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא כי הוה ליה לידע באותו דבר ופשע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בידיעתו וניכר הדבר דאיערומי קמערים אבל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכא לא הוה ליה לידע שהיו בכיס מאתים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זוז הלכך אע\"פ שטוען לא ידענא אינו בכלל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחויב שבועה ואינו יכול לישבע וכ\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש ז\"ל וטוח\"מ בנו סי' רצ\"א דליכא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחיוביה משום מחויב שבועה ואינו יכול",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לישבע דלא אמר הכי אלא בשיש טענת רמאות",
      "segment_ids": [
