      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כגון נ' ידענא ונ' לא ידענא לפי שהיה לו",
      "segment_ids": [
