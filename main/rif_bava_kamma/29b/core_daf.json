      "text": "<i class=\"footnote\">שמואל</i> <i class=\"footnote\">לצידי</i> <i class=\"footnote\">הדרכים</i> <i class=\"footnote\">א\"ל</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">יהודה</i> <i class=\"footnote\">תנאים</i> <i class=\"footnote\">שחתנה</i> <i class=\"footnote\">יהושע</i> <i class=\"footnote\">אפילו</i> <i class=\"footnote\">בבבל</i> <i class=\"footnote\">א\"ל</i> <i class=\"footnote\">שאני</i>",
