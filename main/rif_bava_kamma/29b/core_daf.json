        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ומהלכין בשבילי הרשות עד שתרד רביעה שניה. ט ומסתלקין לצדדי הדרכים מפני",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יתדות הדרכים. י והתועה בין הכרמים מפסג ועולה מפסג ויורד. ומת מצוה",
      "segment_ids": [
        6,
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "קונה מקומו. <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">מן</i> <i class=\"footnote\">איתמר</i> <i class=\"footnote\">אמר</i> <i class=\"footnote\">רב</i> <i class=\"footnote\">אדא</i> <i class=\"footnote\">אר\"נ</i> <i class=\"footnote\">עד</i> <i class=\"footnote\">אפי'</i> <i class=\"footnote\">בחו\"ל</i> <i class=\"footnote\">אינו</i> <i class=\"footnote\">בגמ'</i> <i class=\"footnote\">שלנו</i>",
      "segment_ids": [
