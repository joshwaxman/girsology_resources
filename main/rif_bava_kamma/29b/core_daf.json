    {
      "width": "655px",
      "right": "275px",
      "text": "<i class=\"footnote\">והכי</i> <i class=\"footnote\">אית'</i> <i class=\"footnote\">בגמ'</i> <i class=\"footnote\">בדף</i> <i class=\"footnote\">פא</i> <i class=\"footnote\">שמואל</i> <i class=\"footnote\">ורב</i> <i class=\"footnote\">יהודה</i> <i class=\"footnote\">הוו</i> <i class=\"footnote\">שקלי</i> <i class=\"footnote\">ואזלי</i> <i class=\"footnote\">באורחא</i> <i class=\"footnote\">חוה</i> <i class=\"footnote\">מסתלק</i>",
