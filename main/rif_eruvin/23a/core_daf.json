        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אתי לאשתכוחי עירוב מיניהו: אמר רב",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה רב לא תני פתוחות זו לזו מאי טעמא",
