  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "חוץ מן המים ומן המלח הנודר <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>במזון מותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במים ובמלח מערבין לנזיר ביין ולישראל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתרומה סומכוס אומר בחולין <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>ולא בתרומה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולכהן בבית הפרס רבי יהודה אומר אפילו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבית <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>הקברות <span class=\"bavli-ref\" data-bavli-ref=\"(דף כז.)\" data-bavli-daf=\"27a\" data-bavli-index=\"0\"></span>מפני שהוא יכול <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>(לצאת) לחוץ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולאכול: <b><big>גמ'</big></b> א\"ר יוחנן אין למדין מן",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכללות ואפי' במקום שנאמר בו חוץ: אמר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבינא ואיתימא רב נחמן בר יצחק אף אנן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמי תנינא בכל מערבין ומשתתפין חוץ מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המים ומן המלח והא איכא כמהין ופטריות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאין מערבין בהן אלא לאו ש\"מ אין למדין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הכללות ואפי' במקום שנאמר בו חוץ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ש\"מ: חוץ מן המים והמלח: ודוקא מים בפני",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצמן ומלח בפני עצמו אבל מים ומלח כאחד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מערבין. <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i><span class=\"bavli-ref\" data-bavli-ref=\"(דף כט.)\" data-bavli-daf=\"29a\" data-bavli-index=\"1\"></span>תניא כל האוכלין מצטרפין לפסול",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הגויה בכחצי פרס וכמזון שתי סעודות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעירוב וכביצה לטמא טומאת אוכלין סבר רב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסף למימר הא <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>דתניא וכמזון שתי סעודות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעירוב עד דאיכא סעודתא מהאי וסעודתא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מהאי א\"ל רבה אפילו למחצה לשליש ולרביע:",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר ליה ההוא מרבנן לרבא תפוחין בכמה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואסיקנא א\"ל רב נחמן תפוחין בקב תניא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ר\"ש בן אלעזר אומר עוכלא תבלין וליטרא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירק וי' אגוזים וה' אפרסקין וב' רמונים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואתרוג אחד <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>וכן לעירוב. פירוש הא דתניא",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עוכלא תבלין וכו' כענין ששנינו במשנתנו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין פוחתין לעני בגורן מחצי קב חטין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>וחצי קב שעורין וכו' תניא ר\"ש בן אלעזר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר יין כדי לאכול בו מזון שתי סעודות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חומץ <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i><i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>כדי לטבל בו <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>זיתים ובצלים כדי לאכול בהן ב' סעודות ויין דאמרן יין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מבושל אבל יין שאינו מבושל מערבין בשתי רביעיות ובצלים נמי דאמרן באמהות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אבל בעלין לא ועלין נמי דאמרן אין מערבין בהן <span class=\"bavli-ref\" data-bavli-ref=\"(דף כט:)\" data-bavli-daf=\"29b\" data-bavli-index=\"2\"></span>דלא אבצול זרתא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ד\" data-order=\"4\"></i>זרתא אבל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אבצול זרתא זרתא מערבין אמר רב יהודה אמר שמואל כל שהוא לפתן כדי לאכול",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בו שתי סעודות וכל שאינו לפתן אלא נאכל כמו שהוא כדי לאכול ממנו שתי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "סעודות בשר חי כדי לאכול ממנו מזון שתי סעודות בשר צלי רבה אמר כדי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לאכול בו שתי סעודות ורב יוסף אמר כדי לאכול ממנו והלכה כרבה: <span class=\"bavli-ref\" data-bavli-ref=\"(דף ל.)\" data-bavli-daf=\"30a\" data-bavli-index=\"3\"></span>אמר רב",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שימי בר חייא מערבין בביצים חיות וכמה אמר ר\"נ בר יצחק סיני אמר שתים:",
      "segment_ids": [
        8
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>חוץ מן המים ומלח.</b> דלאו פרי מפרי הוא ולא גידולי קרקע כדאשכחן בבשר ויין: <b>והנודר</b> מן המזון מפרש בגמ' [דף ל.] לא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאמר יאסר עלי מזון דודאי לא מיקרי מזון אלא חמשת המינין דהן מין דגן דזייני וסעדי אלא כגון שאמר יאסר עלי כל דבר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המשביע אפי' לפי שעה וכל מילי זייני לפי שעה חוץ מן המים ומן המלח: <b>מערבין לנזיר.</b> <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ה\" data-order=\"5\"></i>בין עירובי תחומין בין עירובי",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חצרות: <b>ביין.</b> בשתי רביעיות של לוג יין כדלקמן [דף כט.] דאע\"ג דלדידיה לא חזי חזי לאחריני וכיון דמזונא הוא גבי",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחרים שרו ליה רבנן ולישראל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי בתרומה דהא חזי לכהן:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>סומכוס אומר בחולין ולא</b>",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בתרומה.</b> דמידי דחזי ליה בעינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותרומה לא חזיא [דף ל:] ליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשום ענין שאם ישאל עליו לחכם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר שטעה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ו\" data-order=\"6\"></i>בתורם מזה על זה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפ\"ה אסורה ליה שהרי טבל הוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואין מערבין בטבל דהא לא חזיא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ז\" data-order=\"7\"></i>אבל נזיר ביין לא פליג",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סומכוס דהא אי בעי מיתשל על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נדריה: <b>ולכהן בבית הפרס.</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מערבין לכהן בתרומה [דף לא.]",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומניחו במקום שנחרש בו קבר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומיירי בתרומה שלא הוכשרה אם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא תרומת פירות או תרומת דגן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנילושה במי פירות ואינה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יכולה לקבל טומאה ואע\"ג",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבעינן דוכתא דליהוי איהו מצי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למיזל ולמשקליה ולמיכליה התם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקני שביתה בההיא דוכתא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למיהוי כאילו שכב שם <i data-commentator=\"Hagahot HaBach\" data-label=\"ח\" data-order=\"8\"></i>בבית",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפרס אפ\"ה שפיר דמי דספיקא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרבנן הוא ומותר ליכנס ע\"י",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניפוח דאמרי' [דף ל:] מנפח",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדם בבית הפרס והולך כלומר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שדה שנחרש בה קבר דכולה ספיקא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום עצמות הוא שהבשר כבר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נרקב כמה שנים ועצמות בלא בשר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין מטמאין באהל אלא במגע",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכשמנפח לפני רגליו אם יש עצם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גדול נראה הוא ויזהר שלא יגע",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו ברגליו ואם עצם קטן הוא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נדחה בנפיחה ואינו מסיטו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברגליו ואם מכוסה בעפר אינו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטמא דהא עצם כשעורה אינו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטמא אלא במגע: <b>אבל אין</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מניחין עירובי תחומין לכהן</b>",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בבית הקברות.</b> ואפילו יהיה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חולין לפי שאינו יכול ליכנס",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשם ואם [תאמר והא] אפשר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליכנס בשידה תיבה ומגדל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גדולים שמחזיקין מ' סאה בלח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהם כוריים ביבש דלא מקבלי טומאה דילפי' משק האמור בפ' מדין מה שק מיטלטל מלא וריקן ואינו נקבע אף כל מי שמיטלטל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מלא וריקן ואינו נקבע יצאו אלו שאם יטלטל אדם אותם מלאים ישברו אפילו הכי אין מערבין לו [שם] דסבירא ליה אהל זרוק",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאו שמיה אהל כלומר אהל שאינו קבוע במקום אחד כל הימים וכיון שאין בין הטומאה והשידה והתיבה פותח טפח מיקרי טומאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רצוצה ובוקעת ועולה עד לרקיע ור' יהודה פליג ואמר דמערבין בבית הקברות דסבירא ליה אוהל אע\"פ שהוא זרוק שמיה אהל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואינה בוקעת ומגינה בפני הטומאה אע\"ג דחזינן בבית שהוא מלא עפר וצרורות במסכת סוכה שמביאה לשם אגב גררא ואמרינן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהכלים העומדים על הגג טמאין לא דמי דהתם כיון שאין חלל טפח בבית אין שם אהל כלל אלא כקבר חשבינן ליה לבית אבל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשידה תיבה ומגדל שיש לו חלל גדול אע\"פ שאין בינו ובין הטומאה טפח מגינה ומגינה ואם תאמר היאך יקחנה מעל הקבר שאם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מוציא ידו חוץ לשידה יאהילנה על הקבר מתרץ בגמרא שיכול להביא אצלו בפשוטי כלי עץ שאין ברחבן טפח דלא מקבלי טומאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואינן יכולין להביא אצלו טומאה כיון שאין ברחבן טפח ואפי' יהיה לו רוחב טפח מצד אחד אם יהפכנו לאותו צד שהוא פחות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מטפח אינו מביא את הטומאה לכהן האוחז אותו בידו: <b>גמ' אמר ר' יוחנן אין למדין מן וכו'.</b> כלומר אין לסמוך על לשון",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המשנה שכולל כלל גדול לדברים רבים יחד שאינו חש התנא לפרט הכל והולך אחר הרוב ואע\"פ שנאמר בו חוץ דמשמע שדקדק בדבר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלא הוציא מכלל אלא אלו בלבד: <b>אבל מים ומלח כאחת מערבין.</b> שדרך העולם לעשות ממנו כמין הילמי דתנן במסכת שבת בפ'",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "(בתרא) [שמונה שרצים] [דף קח:] שטובלין בו כדרך שטובלין במורייס הלחם או הבשר ללפת בו הפת: <b>לפסול את הגויה בכחצי</b>",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פרס.</b> אע\"פ שאין אוכלין טמאין מטמאין אדם במגע אפי' הכי אם אכיל מינייהו חצי פרם דהיינו שתי ביצים נפסל גופו מלאכול",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בתרומה כדתניא בפרקא דלקמן [דף פב:] וחצי חציה לפסול בה את הגויה חציה היינו פרס שהוא לשון פרוסה שנחתכה לשנים והם",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ארבע ביצים שהככר השלם יהיה שמונה ביצים וחצי חציה דהיינו חצי פרס הם שתי ביצים ואם אכל בין מלחם ובשר ופירות טמאים",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שיעור חצי פרס נפסל גופו מלאכול בתרומה: <b>וכמזון</b> שתי סעודות לעירוב אע\"פ שאינם ממין אחד: <b>וכן כביצה.</b> בין כל אלו",
      "segment_ids": [
        9,
        10,
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המינין מאוכלין טמאין יטמאו אוכלין טהורין אם יגעו בהם: <b>עד דאיכא סעודה מהאי וכו'.</b> כלומר בעינן שתהא הסעודה אחת",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כולה ממין אחד והשניה ממין אחר אבל משלשת מינין לא יצטרפו: <b>אמר ליה רבא אפי' למחצה לשליש ולרביע.</b> ואפי' ממינין הרבה",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מצטרפין <i data-commentator=\"Hagahot HaBach\" data-label=\"ט\" data-order=\"9\"></i>וכן לעירוב: <b>עוכלא.</b> שמינית של ליטרא מתבלין כגון מפלפלין וכמון והדומה להן שכך צריך לתבל שתי סעודות של",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשר. וליטרא ירק. לשתי סעודות צריך ליטרא ירק ללפת בו את הפת: <b>וכן עשר האגוזים.</b> חמשה <i data-commentator=\"Hagahot HaBach\" data-label=\"י\" data-order=\"10\"></i>אגוזים לכל סעודה וסעודה: <b>יין</b>",
      "segment_ids": [
        14,
        15,
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כדי לאכול בו.</b> מוקים לה לקמן ביין מבושל שטובל בו פתו: <b>בשתי רביעיות.</b> דהיינו חצי לוג לפי שיש בלוג ארבעה רביעיות:",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דלא איבצול זרתא.</b> שלא גדלו להיות ארוכים כזרת שבעוד שהם כל כך קטנים מזיק לאדם הלחות שבו ונקרא בלשון חכמים נחש: <b>כל</b>",
      "segment_ids": [
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שהוא לפתן כדי לאכול בו.</b> לא ממש שתי סעודות דתיהוי כולה סעודתא מההוא מידי בעינן אלא כל מידי לפום חשיבותיה אם לפתן",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאדם רגיל ללפת בו את הפת בעינן שיהא בו כדי ללפת שתי סעודות ואם דבר הרגיל להביא בקנוח סעודה הוא שיעורה בכדי שאדם",
      "segment_ids": [
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רגיל להביא בקינוח שתי סעודות: <b>כדי לאכול ממנו.</b> ממש שתי סעודות: <b>סיני</b> אמר שתים רב יוסף נקרא סיני (ברכות סד.) לפי",
      "segment_ids": [
        19,
        20,
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהיה בקי במשניות ובברייתות ומסודרין בפיו כאילו קבלם מהר סיני מפי משה רבינו:",
      "segment_ids": [
        21
      ]
    }
  ],
