    {
      "width": "380px",
      "right": "275px",
      "text": "וכו': מאי טעמא אמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בס\"י</i> <i class=\"footnote\">הגי'</i> <i class=\"footnote\">רבא</i>רבה",
