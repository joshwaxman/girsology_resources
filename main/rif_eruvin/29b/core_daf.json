    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויכולין להתבלע שם אסור דכיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבגופיה קא שפיך גלה דעתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכוונתו שיצאו לחוץ <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>וגזרינן",
      "segment_ids": [
