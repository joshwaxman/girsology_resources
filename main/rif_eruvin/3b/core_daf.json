  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א לשון ריא\"ז</b> ואע\"פ שהיה ארכו יותר על",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רחבו צריך שיהו שתי חצירות פתוחות לתוכו",
