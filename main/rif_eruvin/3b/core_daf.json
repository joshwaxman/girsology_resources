      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומיי' וסמ\"ג כרבינו : <b>לשון ריא\"ז</b> קורה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
