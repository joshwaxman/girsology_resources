        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קול שיר וש\"ד וגם לא עבד מעשה: <b>ג</b> ור\"ח",
