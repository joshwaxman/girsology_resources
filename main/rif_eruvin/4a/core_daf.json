      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי ליכא למיחש דמיירי דמתוחה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באשלי מלעיל כלומר שקשורה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחבלי' לכותלי המבוי ביתדות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיוצאות מן הכתלים או מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התקרה ואינה יכולה לרבוץ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תחתיה והכי מפרשינן בסוכה [דף",
      "segment_ids": [
        2
      ]
    },
    {
