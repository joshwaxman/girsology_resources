    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למיחש דבקשורה מיירי ולשמא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תרבץ תחתיה וליכא מחיצה עשרה",
      "segment_ids": [
