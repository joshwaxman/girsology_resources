    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>(וכו') אפי' בדבר שיש בו רוח</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חיים.</b> כגון אדם או בהמה ולא",
