        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טעמא דרב דכל שאינו בזה אחר זה אפילו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבת אחת אינו פירוש בשם שאין לו לאדם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לקנות ד' אמות מקום שביתה אחרי שכבר קנה",
