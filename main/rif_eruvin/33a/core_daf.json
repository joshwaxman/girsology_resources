        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אין מצרף לא.</b> מפורש בפי'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המשנה עד סוף ההלכה: <b>מתני'</b>",
      "segment_ids": [
