      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חולייתו גבוהה עשרה טפחים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמצא שהוא מוציא מרה\"י לרה\"י",
      "segment_ids": [
