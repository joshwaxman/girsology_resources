      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רה\"ר <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>לפיכך צריך שתהיה גבוהה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עשרה טפחים החולייא אשר",
      "segment_ids": [
