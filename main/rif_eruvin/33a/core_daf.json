      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סביביו <i data-commentator=\"Hagahot HaBach\" data-label=\"נ\" data-order=\"14\"></i>נמצא שכשמשלשל מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החלון דליו לבור אינו יורד",
      "segment_ids": [
