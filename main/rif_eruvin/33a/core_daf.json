      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרך רה\"ר אבל אם לא היה הבור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רחוק מן הכותל ד' אע\"פ שאין",
      "segment_ids": [
