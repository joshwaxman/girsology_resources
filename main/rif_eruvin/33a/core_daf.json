    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בור ברה\"ר וחולייתו גבוה עשרה</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>טפחים וכו'.</b> מפרש בגמרא שהוא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רחוק מן הכותל ארבעה טפחים",
      "segment_ids": [
