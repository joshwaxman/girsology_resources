      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פטור מרה\"י לרה\"י <i data-commentator=\"Hagahot HaBach\" data-label=\"ס\" data-order=\"15\"></i>באויר מקום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פטור הוא ממלא אבל אם לא היה",
      "segment_ids": [
