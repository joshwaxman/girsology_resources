      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:10\" data-ror-ocr=\"ל פ י שהעשביס נדבקים בקשרי אצבעותיו\">בקשרי אצבעותיו ונתלשין: עוקצא -</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:10\" data-ror-ocr=\"ל פ י שהעשביס נדבקים בקשרי אצבעותיו\">אשפי\"א</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:13\" data-ror-ocr=\"ממכוין מותר: לדבר מצוה. משמיש:\">מתכוין מותר: לדבר מצוה -</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"15\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:13\" data-ror-ocr=\"ממכוין מותר: לדבר מצוה. משמיש:\">תשמיש:</i> <i class=\"ror-line\" data-ror-i=\"16\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:14\" data-ror-ocr=\"ברגלים. לשון תשמיש כ מ ו ש נ א מ ר בין רגליה\">ברגלים - לשון תשמיש <i class=\"ror-talmud-only\" data-ror-chars=\"14\" data-ror-talmud=\"דכתיב (שופטים ה׳:כ״ז)\">°</i> בין</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"16\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:14\" data-ror-ocr=\"ברגלים. לשון תשמיש כ מ ו ש נ א מ ר בין רגליה\">רגליה</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"18\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:15\" data-ror-ocr=\"לא טובים הבנים הנעשים בלא ד ע ת האשה\">לא טובים הבנים הנעשים בלא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"18\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:15\" data-ror-ocr=\"לא טובים הבנים הנעשים בלא ד ע ת האשה\">דעת האשה</i> <i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Eruvin 100b:15\" data-ror-ocr=\"שהיה הבעל אץ ב ר ג ל י ם : הגועל ושוגה.\">שהיה בעלה אץ ברגלים: הבועל</i>"
