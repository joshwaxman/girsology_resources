      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Eruvin 38a:4\" data-ror-ocr=\"מוליכו. השליח (ח) ערב יו״ט שלפני השבת:\">לרוח אחת: מוליכו - השליח: בראשון - ערב</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Eruvin 38a:4\" data-ror-ocr=\"מוליכו. השליח (ח) ערב יו״ט שלפני השבת:\">יו\"ט שלפני השבת:</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Eruvin 38a:4\" data-ror-ocr=\"ומחשיך עליו. ער שיקנה העירוב: ונוטלו\">ומחשיך עליו - עד</i>"
