        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את כולה אלא אם כן עשו חוצה לה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>שיור",
      "segment_ids": [
        4
      ]
    },
