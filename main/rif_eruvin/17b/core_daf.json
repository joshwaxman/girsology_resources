      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדם כולה <i data-commentator=\"Hagahot HaBach\" data-label=\"ט\" data-order=\"9\"></i>והוא משכיר הבתים",
      "segment_ids": [
