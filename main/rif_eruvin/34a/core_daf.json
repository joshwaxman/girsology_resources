        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יש בחלון ד' על ד' אסור מפני שמוציא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מרשות לרשות האי מנעול היכי דמי אי דלית",
