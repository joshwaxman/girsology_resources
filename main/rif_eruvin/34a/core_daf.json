        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהמנעול למעלה מי' מביא מפתח מערב שבת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומניחו במנעול למחר פותח ונועל ומניחו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במקומו דברי ר' מאיר וחכ\"א אף בזמן",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהמנעול למעלה מי' טפחים מביא מפתח מערב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבת ומניחו באסקופה ולמחר פותח ונועל",
