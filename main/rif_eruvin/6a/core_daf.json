        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ביראות לא בבבל ולא בשאר ארצות בורגנין בבבל לא דשכיחי בדקי דמיא בשאר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ארצות נמי לא דשכיחי גנבי פסי ביראות בבבל לא דשכיחי מיא ובחוצה לארץ",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "נמי לא דלא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>שכיחי מתיבתא א\"ל רב חסדא למר בריה דרב הונא בריה דרב ירמיה",
      "segment_ids": [
        5
      ]
    }
