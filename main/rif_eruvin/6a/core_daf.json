        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר שמואל לא הותרו פסי ביראות אלא לבאר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מים חיים בלבד וצריכא דאי אשמועינן הלכה",
