      "right": "0px",
      "left": "",
      "text": "<b>ואין מערבין אחד.</b> ואסורות זו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עם זו בדרך ראש הכותל ודרך",
      "segment_ids": [
