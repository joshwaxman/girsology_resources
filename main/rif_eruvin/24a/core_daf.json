      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו חלון או <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>חורין וסדקין",
