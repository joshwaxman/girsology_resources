      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן חלל ד' בתוך י' לאו כפתח",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא דהא לא ניחא תשמישתיה:",
      "segment_ids": [
