      "left": "",
      "text": "דלמעלה מי' דאמרי' דמערבין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנים דוקא כשהוא חלון בכותל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבחצר שאינה מקורה אבל בכותל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבתוך הבית שהוא מקורה אמרי'",
      "segment_ids": [
