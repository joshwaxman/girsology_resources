    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"נ\" data-order=\"14\"></i>אותה חצר שלפני הטרקלין: <b>וב\"ה</b>",
      "segment_ids": [
