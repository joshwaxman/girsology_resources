      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מבליעו הוא דאמר כאחרים דתניא אחרים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים אפילו עמוק אלפים ורחב חמשים",
