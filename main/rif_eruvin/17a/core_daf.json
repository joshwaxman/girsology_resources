  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "יורד כנגדו <span class=\"bavli-ref\" data-bavli-ref=\"(דף נח:)\" data-bavli-daf=\"58b\" data-bavli-index=\"0\"></span>אבל חוט המשקולת יורד כנגדו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מודדו מדידה יפה וכמה עומקו של גיא אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב יוסף אלפים איתיביה אביי עמוק מאה",
