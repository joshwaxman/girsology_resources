  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גמ' אין בו ד' מאי.</b> כלומר אם אין רוחב הכותל ד' טפחים מי יכולין בני חצרות לעלות למעלה ולאכול עליה כמו שעושין כשיש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ברחבה ארבעה על ארבעה או דילמא לא: <b>אמר רב אויר שתי רשויות שולטת בו.</b> דכיון דלא חשיב למיהוי רשותא בטיל לגבי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תרוייהו ורשות שתי החצרות שולטין בו ואוסרין זה על זה ואפי' על ראשו אסור לטלטולי: <b>ולא יזיז.</b> על הכותל ממקום למקום:",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אפילו כמלא.</b> נימא אחת אפילו פחות מטפח לפי שהוא כמטלטל מרשות לרשות בלא עירוב ולא דמי האי לבקעה או לרשות הרבים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמותר לטלטל חפץ מתחלת ארבע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לסוף ד' דהתם כל אותם פחות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מארבע אמות חדא רשותא הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והכא רשות ראובן ושמעון שולט",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכל טפח וטפח אבל כשרוחב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכותל ארבעה אין רשות אחד מהם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שולט בו והוא הוי רשות היחיד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלא בעלים שמותר לטלטל בכולו:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ורבי יוחנן אמר אלו מעלין</b>",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> אלו מעלין מחצרן לראשן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוא הדין למורידין דמקום",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פטור הוא ובטל לכאן ולכאן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להקל ואפילו כלים ששבתו בבתים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכלים ששבתו בחצר פשיטא הוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא אפי' בשיש בכותל ד' טפחים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר להעלותו שם דהא קי\"ל [דף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צא.] דגגין וחצרות רשות אחת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הן אלא אפי' כלים ששבתו בבתים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאסרינן להעלות לכותל כשיש בה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ד' טפחים דבתים וגגות שתי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רשויות הן כיון שלא עירבו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלי הגגות עם בעלי הבתים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאוסרין זה על זה ואע\"פ שאין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכותל גובה עשרה [אלא] רחב ד'",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואין בו דיורין שיאסרו על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלי בתים אפי' הכי אסור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לטלטל מן הבתים לכותל לפי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שדרך בעל הבית מכאן ובעל הבית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכאן להשתמש בו בזריקה הוי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לזה בזריקה ולזה בזריקה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושניהם אסורין בו אבל להשתמש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למעלה ממש כלים או פירות",
      "segment_ids": [
