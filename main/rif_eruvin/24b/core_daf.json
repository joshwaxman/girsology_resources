      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מכאן מערבין שנים ואין מערבין א': <b><big>גמ'</big></b> אמר רבא ל\"ש",
      "segment_ids": [
        4,
        5
      ]
    }
