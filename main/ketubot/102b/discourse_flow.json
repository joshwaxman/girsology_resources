{"daf":"102b","version":1,"tier":"adjacency","assurance":{"basis":"adjacency over discourse role labels","authoredBy":"rule","humanReviewed":false,"note":"Every edge is inferred from label order, not derived by a solver. See discourse_roles/docs/013 for the measured agreement against SVARA's solver-derived graphs."},"units":[{"label":"א","from":1,"nodes":[{"id":2,"seg":1,"role":"assert.citation","conf":"high","src":"hebrew","speaker":null,"skel":[0,32],"head":"גּוּפָא, אָמַר","text":"גּוּפָא, אָמַר רַב גִּידֵּל אָמַר רַב: ״כַּמָּה אַתָּה נוֹתֵן לְבִנְךָ?"},{"id":14,"seg":5,"role":"probe.attack.objection","conf":"high","src":"hebrew","speaker":null,"skel":[0,55],"head":"אֵיתִיבֵיהּ: הַפִּקְחִין","text":"אֵיתִיבֵיהּ: הַפִּקְחִין הָיוּ כּוֹתְבִין ״עַל מְנָת שֶׁאָזוּן אֶת בִּתֵּךְ חָמֵשׁ שָׁנִים כׇּל זְמַן שֶׁאַתְּ עִמִּי״!"},{"id":15,"seg":5,"role":"respond.answer","conf":"high","src":"english+hebrew","speaker":"Rav Ashi","skel":[55,70],"head":"מַאי ״כּוֹתְבִין״","text":"מַאי ״כּוֹתְבִין״ — אוֹמְרִים."},{"id":16,"seg":6,"role":"probe.question","conf":"high","src":"english","speaker":"Ravina continued","skel":[0,18],"head":"וְקָרֵי לֵיהּ","text":"וְקָרֵי לֵיהּ לַאֲמִירָה כְּתִיבָה?"},{"id":17,"seg":6,"role":"assert.citation","conf":"med","src":"english","speaker":"Rabbi Ḥiyya","skel":[18,78],"head":"אִין, וְהָתְנַן:","text":"אִין, וְהָתְנַן: הַכּוֹתֵב לְאִשְׁתּוֹ ״דִּין וּדְבָרִים אֵין לִי בִּנְכָסַיִיךְ״, וְתָנֵי רַבִּי חִיָּיא: הָאוֹמֵר לְאִשְׁתּוֹ."},{"id":18,"seg":7,"role":"adduce.proof","conf":"med","src":"english+biur","speaker":null,"skel":[0,44],"head":"תָּא שְׁמַע:","text":"תָּא שְׁמַע: אֵין כּוֹתְבִין שְׁטָרֵי אֵירוּסִין וְנִשּׂוּאִין אֶלָּא מִדַּעַת שְׁנֵיהֶם."},{"id":21,"seg":8,"role":"probe.attack.rejection","conf":"high","src":"english+biur","speaker":null,"skel":[0,16],"head":"לָא, שְׁטָרֵי","text":"לָא, שְׁטָרֵי אֵירוּסִין מַמָּשׁ."},{"id":24,"seg":9,"role":"adduce.proof","conf":"med","src":"english+biur","speaker":null,"skel":[0,76],"head":"תָּא שְׁמַע:","text":"תָּא שְׁמַע: מֵתוּ — בְּנוֹתֵיהֶן נִיזּוֹנוֹת מִנְּכָסִים בְּנֵי חוֹרִין, וְהִיא נִיזּוֹנֶת מִנְּכָסִים מְשׁוּעְבָּדִים, מִפְּנֵי שֶׁהִיא כְּבַעֲלַת חוֹב."},{"id":25,"seg":10,"role":"probe.attack.rejection","conf":"high","src":"english+hebrew+biur","speaker":null,"skel":[0,22],"head":"הָכָא בְּמַאי","text":"הָכָא בְּמַאי עָסְקִינַן — בְּשֶׁקָּנוּ מִיָּדוֹ."},{"id":26,"seg":11,"role":"probe.question","conf":"high","src":"english+hebrew+biur","speaker":null,"skel":[0,12],"head":"אִי הָכִי,","text":"אִי הָכִי, בָּנוֹת נָמֵי!"},{"id":27,"seg":11,"role":"respond.answer","conf":"high","src":"english+biur","speaker":null,"skel":[12,29],"head":"בְּשֶׁקָּנוּ לָזוֹ","text":"בְּשֶׁקָּנוּ לָזוֹ וְלֹא קָנוּ לָזוֹ."},{"id":28,"seg":12,"role":"probe.question","conf":"high","src":"english+hebrew+biur","speaker":null,"skel":[0,8],"head":"וּמַאי פַּסְקָא?","text":"וּמַאי פַּסְקָא?"},{"id":29,"seg":12,"role":"respond.answer","conf":"med","src":"biur","speaker":null,"skel":[8,66],"head":"אִיהִי דַּהֲוַאי","text":"אִיהִי דַּהֲוַאי בִּשְׁעַת קִנְיָן — מַהֲנֵי לַהּ קִנְיָן, בָּנוֹת דְּלָא הֲווֹ בִּשְׁעַת קִנְיָן — לָא מַהֲנֵי לְהוּ קִנְיָן."},{"id":30,"seg":13,"role":"probe.question","conf":"high","src":"english+biur","speaker":null,"skel":[0,46],"head":"מִי לָא","text":"מִי לָא עָסְקִינַן דַּהֲוַאי בִּשְׁעַת קִנְיָן, וְהֵיכִי דָּמֵי — כְּגוֹן דְּגָרְשַׁהּ וְאַהְדְּרַהּ!"}],"edges":[{"source":14,"target":2,"type":"attacks","regime":"attack","gap":1,"confidence":"high","basis":"adjacency"},{"source":15,"target":14,"ordinal":1,"type":"answers","regime":"structural","gap":1,"confidence":"high","basis":"adjacency"},{"source":18,"target":17,"type":"supports","regime":"evidence","gap":1,"confidence":"high","basis":"adjacency"},{"source":21,"target":17,"type":"attacks","regime":"attack","gap":2,"confidence":"medium","basis":"adjacency"},{"source":24,"target":17,"type":"supports","regime":"evidence","gap":3,"confidence":"low","basis":"adjacency"},{"source":25,"target":17,"type":"attacks