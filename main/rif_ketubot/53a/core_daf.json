  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>גמ'</big></b> במאי קא מיפלגי אמר שמואל <span class=\"bavli-ref\" data-bavli-ref=\"(דף צד.)\" data-bavli-daf=\"94a\" data-bavli-index=\"0\"></span>כגון",
      "segment_ids": [
        0
      ]
    },
    {
