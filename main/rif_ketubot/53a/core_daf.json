    {
      "width": "380px",
      "right": "275px",
      "text": "שגבה לא גבה [<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">גי'</i> <i class=\"footnote\">ד\"ת</i>והכא בחיישינן שמא",
      "segment_ids": [
