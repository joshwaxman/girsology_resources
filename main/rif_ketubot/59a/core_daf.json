      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאדרבה קשיא היכי פריך התם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדר' יוחנן אדר' יוחנן דהא",
      "segment_ids": [
