    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נהי נמי דמסתבר דכרבה <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>קי\"ל",
