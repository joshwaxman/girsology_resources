  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> וכ\"כ סמ\"ג בשם הרר\"י בר יצחק וכן בשם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ה\"ג ומיי' דאם תפסה מחיים מהניא אף",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לכתובה והאריך בראיות לבאר דבר הזה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולבאר דדוקא למזוני מהניא תפיסה ולא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לכתובה ור\"ח פסק כמר בר רב אשי ופי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דדברי רבינא שאומר דוקא למזוני ולא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לכתובה מיירי בתפיסה דמחיים וכתב סמ\"ג",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דהמסקנא היא כדברי ר\"ח והלכה כמר בר רב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אשי דמועלת תפיסה בין למזוני בין לכתובה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחיים והטור כתב דאפילו תפסה מטלטלין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אפי' לאחר מיתה לא מפקינן מינה אבל לפי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תקנת הגאונים שכתובה נגבית ממטלטלי ה\"ה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נמי מזונות ואפי' לא תפסה ניזונית",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממטלטלין כתב מיי' לפיכך אם הניח נשים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רבות אפי' נשאן זו אחר זו כולן ניזונות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשוה שאין דין קדימה במטלטלין והרמב\"ן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב דאפי' אם ניזונו' ממקרקעי אין בהם",
