  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דאתחזוק אבל לא אתחזוק לאו כל כמיניה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאחזוקי אינשי בפריצי: על מנת שתאמרי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפלוני: ותימא אמר רב יהודה אמר שמואל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דברים של קלון: או שתהא ממלאה ומערה:",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותעביד אמר רב יהודה אמר שמואל שתהא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממלאה ונופצת פירוש אמר לה בשעת תשמיש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתתהפך כדי שתנפץ שכבת זרע ולא תתעבר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במתניתא תנא שתמלא עשרה כדי מים ותערה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאשפה בשלמא לשמואל מש\"ה יוציא ויתן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתובה אלא למתניתא מאי נפקא ליה מינה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תעביד אמר רבה בר בר חנה אמר רבי יוחנן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני שנראית בשוטה: אמר רב כהנא המדיר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את אשתו שלא תשאל ושלא תשאיל נפה וכברה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רחיים ותנור יוציא ויתן כתובה מפני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שמשיאה שם רע בשכנותיה וכן היא שנדרה שלא תשאל ושלא תשאיל נפה וכברה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רחיים ותנור ושלא תארוג בגדים נאים לבנה תצא שלא בכתובה מפני שמשיאתו שם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רע בשכניו: <b><big>מתני'</big></b> ואלו יוצאות שלא בכתובה <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Marriage\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Even HaEzer\" data-label=\"⚬\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>העוברת על דת משה ויהודית ואי",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "זו היא דת משה מאכילתו שאינו מעושר ומשמשתו נדה ואינה קוצה לה חלה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ונודרת ואינה מקיימת ואיזו היא דת יהודית יוצאה וראשה פרוע וטווה בשוק",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ומדברת עם כל אדם אבא שאול אומר אף המקללת יולדיו בפניו ר' טרפון אומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אף הקולנית ואי זו קולנית כל שמדברת בתוך ביתה ושכיניה שומעין את קולה:",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<b><big>גמ'</big></b> מאכילתו שאינו מעושר היכי דמי אי דידע נפרוש אי דלא ידע מנא ידע לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "צריכה דאמרה ליה פלוני בהן תקן לי הכרי ואזל ושייליה ואשתכח שיקרא:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ומשמשתו נדה היכי דמי אי דידע נפרוש אי דלא ידע נסמוך עילוה דאמר רב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חיננא בר כהנא אמר שמואל מנין לנדה שסופרת לעצמה שנאמר (ויקרא יט) וספרה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לה לא צריכא דאמרה ליה פלוני חכם טיהר לי הכתם ואזל שייליה ואשתכח שיקרא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואי בעית אימא כדרב יהודה דאמר רב יהודה הוחזקה נדה בשכנותיה בעלה לוקה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עליה משום נדה: וחלה נמי כגון דאמרה פלוני תקן לי את העיסה ואזל שייליה",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואשתכח שיקרא: ונודרת ואינה מקיימת <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>דאמר מר בעון נדרים בנים מתים: אי זו",
      "segment_ids": [
        7,
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היא דת יהודית יוצאה וראשה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>פרוע ראשה פרוע דאורייתא היא דכתיב (במדבר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ה׳:י״ח) ופרע את ראש האשה ואמר רבי ישמעאל אזהרה לבנות ישראל שלא תצאנה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בפריעת ראש א\"ר יהודה אמר שמואל בקלתה דאורייתא <span class=\"bavli-ref\" data-bavli-ref=\"(דף עב:)\" data-bavli-daf=\"72b\" data-bavli-index=\"0\"></span>קלתה שפיר דמי דת יהודית",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אפילו קלתה נמי אסור א\"ר אסי א\"ר יוחנן קלתה אין בה משום פריעת ראש אמר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אביי ואיתימא רב כהנא מחצר לחצר ודרך מבוי: ירושלמי חצר שהרבים בוקעין",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בו הרי הוא כמבוי מבוי שאין הרבים בוקעין בו הרי הוא כחצר: וטווה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i>בשוק",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אמר רב יהודה אמר שמואל במראה זרועותיה לבני אדם אמר רב חסדא אמר אבימי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בטווה ורד כנגד פניה: ומדברת עם כל אדם אמר רב יהודה אמר שמואל במשחקת",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עם הבחורים: אבא שאול אומר אף המקללת יולדיו בפניו אמר רב יהודה אמר",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שמואל במקללת יולדיו בפני מולידיו <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>שנאמר (בראשית מ״ח:ו׳) ומולדתך אשר",
      "segment_ids": [
        13
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הולדת אחריהם",
      "segment_ids": [
        13
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והך</b> מתני' לרב מיירי במדירה סתם שתלה מזונות או תשמיש בדברים אלו ולשמואל ע\"כ בנדרה היא וקיים לה איהו מתוקמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובשלמא שלא תלך לבית אביה או לבית המשתה בידו להפר דאפשר' דנדרי ענוי נפש נינהו ובבית האבל נמי מפורש בפרק בתרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דנדרים (דף פג:) דעינוי נפש הוא מדכתיב והחי יתן אל לבו אבל תאמרי לפלוני ותמלא עשרה כדי מים לא משמע דמקרי עינוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נפש ולא דברים שבינו לבינה וכיון שכן על כרחין מיירי בשתלתה בדברים אלו מזונות או תשמיש וש\"מ דאע\"ג דאפשר בפרנס",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותשמיש נמי שבת אחד כמאן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאפשר בפרנס דמי אפ\"ה יוציא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויתן כתובה כיון דנדרה היא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקיים לה איהו מטעמא דמסנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סני לה וכמו שכתבנו למעלה:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המדיר את אשתו שלא תשאל כו'.</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרב מפרשה במדירה מנכסיו אם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תשאל אבל לשמואל דאמר אפילו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסתם ימתין קשיא אמאי יוציא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשמע לאלתר תשאל ותאסר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותמתין שמא תמצא פתח וליכא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפרוקא בשנדרה היא וקיים לה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איהו וכדמפרקינן מתני' אליביה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא בתר הכי קאמר וכן היא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנדרה ונ\"ל <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>דשלא תשאל ושלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תשאיל חדא מילתא היא ועיקר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנדר בשלא תשאיל אלא שהמדיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשתו בכך ואוסר לה כליו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהשאלתן אף הוא אין רצונו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שתשאל ומש\"ה נקטינהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתרווייהו עוד נ\"ל שחכמים שמו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דעתה שלא תרצה לשאול ותהא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסורה מנכסיו וכיון שכן משיאה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שם רע שהיא טענה מספקת להוציא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויתן כתובה דלא דמי למאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפרכינן לעיל בגמ' לר' יוסי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא תתקשט ולא תאסר ותתקשט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותאסר שבת אחת משום דהתם איזה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהם שתברור אינו כדאי לומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוציא ויתן כתובה ובתוספות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחקו שלא תשאל היינו שאוסר על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו הנאת כלים שתשאל והיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריכה להבדל כדי שלא תכשילנו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[פי' ולעולם לא תלה בדבר]:",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכן היא שנדרה כו'.</b> לא מיירי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקיים לה איהו דאי לא אמאי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תצא שלא בכתובה דהא קי\"ל (דף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עא.) דהוא נתן אצבע בין שיניה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא הני לאו דברים שבינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבינה ולא נדרי עינוי נפש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נינהו שיהא אפשר להפר וכיון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכן רישא דהמדיר אפשר לאוקמה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנדרה איהי וקיים לה איהו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכגון שתלתה בנדרים אלו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מזונות או תשמיש וקרי לה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המדיר משום דקיומו של נדר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בדידיה תלי ובסיפא תני וכן היא שנדרה לפי שאין כאן אלא נדרה לבד הרשב\"א ז\"ל ובכך עולה תירוץ למה שנדחקו בו בסמוך:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מתני' דת יהודית.</b> שנהגו בנות ישראל אע\"ג דלא כתיבה: <b>וטווה בשוק.</b> בגמ' מפרש: <b>מדברת בתוך ביתה.</b> בגמרא מפרש: <b>גמ' <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>הא</b>",
      "segment_ids": [
        3,
        4,
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דאמרינן דהאכילתו אי דידע.</b> כשאכל: <b>יפרוש.</b> ולא יאכל ואמאי מפסדת כתובתה דודאי אינה יוצאה אלא א\"כ האכילתו ולא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנתכוונה להאכילו אם לא האכילתו והרא\"ה ז\"ל כתב שאפילו נתכונה להאכילו מפסדת כתובתה והכא לישנא דמאכילתו קדייק: <b>ואי</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לא ידע מנא ידע.</b> מי אמר לו אחרי כן שהוא בא לפנינו להוציאה והאי דלא אוקמה במודה כתב הראב\"ד ז\"ל משום דאינה נאמנת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאין אדם משים עצמו רשע ולא נראה דלהפסיד כתובתה ודאי נאמנת דהודאת בעל דין כמאה עדים דמו אלא משום דמילתא דלא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שכיחא היא לא אוקמה בהכי: <b>ואי לא ידע נסמוך עילוה.</b> האי דלא אמר הכא מנא ידע כדאמרינן לעיל משום דהכא <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>מוכח מקרא דמצי",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למסמך עילוה: <b>הוחזקה נדה בשכנותיה.</b> שראוה לובשת בנדי נדות ולבעלה אמרה טהורה אני ושמשה: <b>בעלה לוקה עליה.</b> אם התרו בו",
      "segment_ids": [
        9,
        10,
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וכה\"ג משכחת לה למתניתין דלאחר תשמיש הודיעוהו שכנותי' שהוחזקה נדה. ודאמרינן כגון דקא אמרה איש פלוני כהן תקן לי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "את הכרי ופלוני חכם טהר לי את הדם <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>כדאמרה הכי בעדים דאותו פלוני תקן לה את הכרי ובדשיילוה בעדים והרשב\"א ז\"ל ג\"כ",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כתב שע\"פ כהן וחכם בלבד אינה מפסדת כתובתה דעד אחד הוא אלא דוקא בשאמרה איש פלוני תקן וטהר ביום פלוני ואתו עדים",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואמרו עמנו היה במקום פלוני או לא זזה ידינו מתוך ידו ולא תקן אבל ע\"פ הכחשת הכהן עצמו אינה מפסדת כתובתה דעד אחד",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא ובירושלמי נמי מפורש דכן גרסינן התם וכלהון בעדים פלוני כהן עישר לי פלוני ראה כתמי פלוני קצה לי חלתי פלוני",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חכם התיר לי את נדרי בדקין כולהון ולא משכחין ע\"כ אבל מדברי הרמב\"ן ז\"ל נראה שהכהן והחכם נאמן שכך כתב בפרק שבועות",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "העדות כדאמרינן בכתובות פלוני טהר לי את הכתם אזל שייליה ואשתכח שקרא דאלמא אע\"ג דאיהי מהימנא כיון שאמרה בשם פלוני",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ושייליה ואמר דשקרא הוא לא מהימנא ולא מצית למימר אשתכח שקרא ע\"פ עדים דהא קאמר ואזל שייליה וכן הדין בכל עד מפי עד",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אם בא האחד וכפר אין השני האומר משמו נאמן וכך קבלתי דין זה ע\"כ ואפשר דמאי דאמרינן בירושלמי וכולהון בעדים לא קאי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמאי דקאמר כהן <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>: <b>דאורייתא הוא.</b> ואמאי לא קרי ליה דת משה: <b>אזהרה.</b> מדעבדי' לה הכי לנוולה מדה במדה <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>במה שעשתה להתנאות",
      "segment_ids": [
        11,
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על בועלה מכלל דאסור א\"נ מדכתיב ופרע מכלל דההיא שעתא <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>לא פרוע היא וש\"מ אין דרך בנות ישראל לצאת פרועות ראש: <b>קלתה.</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סל שיש לו מלמטה בית קיבול להולמו בראשה ובית קיבול מלמעלה לתת בו פלך ופשתן: <b>קלתה אין בו משום פריעת ראש.</b> אמרינן",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עלה בגמרא אם כן לא הנחת בת לאברהם אבינו שיושבה תחת בעלה. כלומר אם כן דא\"ר יוחנן דקלתה אין בו משום פריעת ראש",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משמע דבלא קלתה מיהא יש בה משום פריעת הראש ואם כן כולהו נפקן שאין אשה נזהרת בחצרה: <b>ומשנינן מחצר לחצר ודרך מבוי.</b>",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלא שכיחי בה רבים: <b>בטווה ורד כנגד פניה.</b> פי' רבינו שלמה יצחקי ז\"ל טווה בכפה על ירכה וחוט מתרדד כנגד פניה של מטה",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אבל הרב רבינו משה בר מיימון ז\"ל כתב בפרק ארבעה ועשרים מהלכות אישות שמשימה ורד בפדחתה כדרך שעושות הפרוצות:",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>במקללת יולדיו בפני מולידיו.</b> כלומר בפניו דמתני' לא תימא בפניו ממש אלא <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>מקללת אביו של בעל בפני בנו של בעל וסימניך",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אפרים ומנשה וכו' ופסוק זה יהא לך סימן על משנתינו לזכור על ידו דבפניו דמתני' בפני בנו קאמר והוי כאילו בפניו.",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אפרים ומנשה כו' בני בניו כבניו:",
      "segment_ids": [
        18
      ]
    }
  ],
