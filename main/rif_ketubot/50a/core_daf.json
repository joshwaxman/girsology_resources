  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א לשון ריא\"ז</b> ואם הוקירה הבירה והיתה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שוה היום אלף זוז כותבין לו טירפא כי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היכי דשויה כמב\"ה: <b>ב</b> וכופין אותו בכך",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמו שכופים את אביהם בד\"א שהניח להם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אביהם אחריות נכסים שאז נשתעבדו אלו",
      "segment_ids": [
