      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הששי יום ל' לחדש פלוני שעבר וי\"א ביום",
      "segment_ids": [
