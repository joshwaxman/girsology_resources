      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחר שטרך שכתוב בה' בניסן הרי דיני עליך",
      "segment_ids": [
