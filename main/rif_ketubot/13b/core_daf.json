      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תחלל את בתך להזנותה שלא יאמר אדם הואיל",
      "segment_ids": [
