      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא חייבה תורה אונס ומפתה אלא שיתן",
      "segment_ids": [
