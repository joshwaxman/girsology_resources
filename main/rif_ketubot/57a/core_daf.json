      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון שלא הזכירה תוך עשרים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחמש שנה מחלה אותה אלמא",
      "segment_ids": [
