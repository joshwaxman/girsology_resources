      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יקיימנו הרי הוא כנייר חלק שאינו מועיל",
      "segment_ids": [
