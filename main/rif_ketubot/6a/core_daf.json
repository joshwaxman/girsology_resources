      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו כלום ואם נתקיימה חתימת א' מן העדים",
      "segment_ids": [
