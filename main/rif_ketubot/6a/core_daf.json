        3
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היה הוא חייב לאחר ובא בעל חוב לגבות",
      "segment_ids": [
