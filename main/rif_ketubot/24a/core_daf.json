      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעלה לשרתו ומיי' כתב וכל אלו המלאכות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין מחייבין אותה לא בכולן ולא במקצתן",
