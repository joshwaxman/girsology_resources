        1,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכ\"כ מיי' וסמ\"ג והרא\"ש כתב שאם יכולה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להניק שניהם צריכה להניק שניהם אבל אם",
