  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "נשים דבעינן כתיבה לשמה וליכא אבל בשאר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שטרות מודו ליה דאמר רב אסי א\"ר יוחנן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שטר שלוה בו ופרעו אינו חוזר ולוה בו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכבר נמחל שעבודו טעמא דנמחל שעבודו הא",
      "segment_ids": [
