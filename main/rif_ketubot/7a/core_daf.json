  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "שקרא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>עליו ערער והוחזק בב\"ד אינן נאמנין",
