        "text": "<i class=\"ror-line\" data-ror-i=\"3\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"בה ואוסבינך לאינחו. לזהו מנאי כתובה\">ואותבינך לאינתו - שזהו תנאי כתובה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"4\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"לישראל: רבא א מ ר כוי. בממזרת ונתינה\">לישראלית: רבא אמר כו' - בממזרת ונתינה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"כאביי סבירא ליה ללא אישתעבל לה\">כאביי סבירא ליה דלא אשתעבד לה אבל</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"ובאלמנה לכהן גלול פליג עליה ואמר\">באלמנה לכ\"ג פליג עליה ואמר</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"למעיקרא נמי לא מישתעבל לכהנמ ואהלרינך\">מעיקרא לא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"למעיקרא נמי לא מישתעבל לכהנמ ואהלרינך\">אשתעבד לכהנת ואהדרינך</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"אבל לנאסרה מתוך לבר אתר לא נשמעבל\">אבל לנאסרה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"אבל לנאסרה מתוך לבר אתר לא נשמעבל\">מחמת דבר אחר לא נשתעבד</i> <i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"(תנאי) לתנאי כתובה ישראל וכהן שוה\">דתנאי כתובה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"(תנאי) לתנאי כתובה ישראל וכהן שוה\">דישראל וכהן שוין</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Ketubot 52a:1\" data-ror-ocr=\"אלא שהכהן מתנה שאפילו אס תאסר\">אלא שהכהן מתנה עמה</i>"
      },
