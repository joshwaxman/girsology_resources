  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב מיי' בד\"א בעני שבישראל אבל בעשיר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכל לפי עשרו וכבודו ואפי' היה לו לקנות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לה כלי רקמה וכלי זהב היו כופין אותו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכן שכר המדור וכלי הבית ותכשיטין הכל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לפי עשרו וכבודו ואם קצרו ידו ליתן אפי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כעני שבישראל כופין אותו להוציאה ותהיה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עליו הכתובה חוב עד שיעשיר ולא האשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בלבד אלא בניו ובנותיו הקטנים עד בני ז'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חייב ליתן להם כסות המספיק להם וכלי בית",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומדור לשכון בהם ואינו נותן להם לפי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עשרו אלא לפי צרכם זה הכלל כל מי שחייב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במזונותיו בין בחייו בין במותו חייב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ליתן לו כסות וכלי בית ומדור ודין בעל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עם אשתו בטענת הכסות וכלי הבית ושכר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המדור כדינם בטענת המזונות אם הוא אומר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נתתי והיא אומרת לא נתת: <b>ב</b> הא דמציאתה",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לבעלה כתב הרמ\"ה דוקא בניזונית אבל אם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינה ניזונית מציאתה לעצמה כתב הרא\"ש לא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דק דלא משכחת אינה ניזונית אלא באומרת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "איני ניזונית ואיני עושה או שאמר לה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעלה צאי מעשה ידיך במזוניך וכיון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהרשות בידם לומר כן הוו כניזונית",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומציאתה לבעלה: <b>ג</b> כתב הטור ואינה יכולה",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למחול לא על חלקה ולא על חלקו ואם מחלה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינה מחילה ומ\"מ אינו יכול לתובעו אלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בהרשאתה כתב מיי' שהרפוי לבעלה ולא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נהירא להרא\"ש וכתב עוד בד\"א שחבלו בה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחרים אבל אם חבל בה בעלה חייב לשלם לה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיד כל הנזק והצער והבושת ואין לבעל בהם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פירות ואם רצתה ליתן לאחרים הדמים נותנת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכך הורו הגאונים והבעל מרפא כדרך שמרפא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כל חליה והראב\"ד השיג עליו וכתב תימה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא למה ישלם הכל שהרי נוטל בשל אחרים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שליש או ב' שלישים וכשחבל בה איהו למה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ישלם הכל אולי טעה בדברי הגאונים שלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמרו אלא על מה שראוי לקנוס שלא יאכל",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הפירות דבהכי לא תקון רבנן דהוא עשה שלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כהוגן דין הוא שלא יהא חוטא נשכר: <b>לשון</b>",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> מציאת האשה ומעשה ידיה לבעלה כמו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שביארנו לפיכך אם חבלו בה אחרים נותן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החובל שבתה לבעלה שבטול מעשה ידיה הפסד",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הבעל הוא וחייב לרפא את האשה ובשת ופגם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וצער נותן הכל לאשה בין אם היו חבלותיה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בסתר בין אם היו בגלוי ואפי' בפניה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בקונטרס הראיות:",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        6
      ]
    }
  ],
