      "right": "275px",
      "text": "יוחנן הסנדלר אומר חולין: <b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף נט.)\" data-bavli-daf=\"59a\" data-bavli-index=\"1\"></span>אמר שמואל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
