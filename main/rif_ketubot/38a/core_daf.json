        1,
        2
      ],
      "gemara_segment_ids": [
        3,
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דכיון דליכא שיור כלל אין לכלות הקרן",
      "segment_ids": [
