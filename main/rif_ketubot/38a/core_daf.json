        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכפל לבעל: <b>ג</b> ולא נהירא להרא\"ש ז\"ל",
