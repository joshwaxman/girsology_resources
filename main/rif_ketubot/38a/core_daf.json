      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממלא מקום אמו וחוזר להיות קרן ואע\"פ",
      "segment_ids": [
