      "segment_ids": [
        2
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א\"ה.</b> דטעמא משום דתקנתא דידיה הוא ויכול למחול עליה אמאי איצטריך דבי רבי ינאי לאוקמה בכותב לה ועודה ארוסה: <b>אפי'</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>נשואה נמי.</b> ומפרקינן נשואה ידו כידה ורבא אמר ידו עדיפא מידה והארכתי בפירושה בפ' האשה שנפלו לה נכסים: <b>קנו מידו</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מהו.</b> פי' רש\"י ז\"ל דאברייתא דהאומר לחבירו דין ודברים אן לי על שדה זו קאי ומיבעיא לן אי קנו מידו אי אמרינן דמדין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ודברים קנו מיניה או מגופה של קרקע קנו מידו דאין חליפין באין אלא בדבר שיש בו ממש שזה קונה את הסודר ומקנה לו את",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חפץ המכר או המתנה ועל גופה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של קרקע קנו מידו ואסיקנא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמגופה של קרקע קנו מידו והוא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדין בנשואה דמהני לפירות אם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קנו מידו אבל הרי\"ף ז\"ל פירש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמתני' קאי דקתני הכותב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאשתו דין ודברים אין לי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנכסיך דאוכל פירות ואם מתה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יורשה וקא מיבעיא לן אם קנו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מידו אי אמרי' דקנין לטפויי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קא אתי ומגופה של קרקע קנו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מידו שלא יהא לו זכות בקרקע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלל וכיון שכן אינו אוכל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירות ופירוש רש\"י ז\"ל מחוור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יותר ומ\"מ אף לפירוש הרי\"ף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל באומר לחבירו דין ודברים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין לי על שדה זו וקנו מידו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהני והכי איתא בהדיא בפ' ח\"ה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(דף מג.) בההיא דהאומנין אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להן חזקה: <b>וזה שכתב הרי\"ף ז\"ל</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בין בעורר על קניינו ובין</b>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בעומד.</b> היינו משום דבגמ' איכא [מ\"ד] דבעורר דהיינו כשבא המקבל להחזיק מיד ערער",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המסתלק בכי ה\"ג אמרינן דלא סילק עצמו מגופו של קרקע אבל בעומד יום או יומים ואח\"כ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ערער בכה\"ג הוא דאמרינן דהשתא הוא דקהדר ביה ולמדוהו לטעון כך ומסקינן דאפי' בעורר נמי אמרינן דמגופה של קרקע קנו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מידו: <b>ת\"ר אלו הן פירות ואלו הן פירי פירות כו'.</b> גרסי' בגמ' איבעיא להו רבי יהודה פירי פירות דוקא או דילמא עד עולם",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דוקא או דילמא תרוייהו דוקא. כלומר לר' יהודה דתני תרתי ובפירי פירותיהן עד עולם מי אמרי' דפירי פירות דוקא כלומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבהאי לישנא בלחוד סגי לאיסתלוקי מפירי פירות ומפירי דפירי פירות ולא בעי עד עולם ואי כתב בפירותיהן עד עולם ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כתב פירי פירות לא איסתלק מפירי פירות או דילמא עד עולם דוקא ובעד עולם תליא מילתא ופירי פירות לא בעיא למכתב ואי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כתב פירי פירות ולא כתב עד עולם לא איסתלק מפירי דפירי פירות או דילמא תרוייהו דוקא. והוינן עלה אם ת\"ל פירי פירות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דוקא עד עולם למה לי. כלומר ל\"ל לאתנייה במתני' הואיל ולא צריך למכתביה. ומפרקינן הא קמ\"ל דכיון דכתב לה פירי פירות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כמאן דכתב עד עולם דמי. כלומר דה\"ק עד שיכתוב לה בפירי פירותיהן דהיינו עד עולם. ובעינן תו את\"ל עד עולם דוקא פירי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פירות למה לי. כלומר למה לי למתנייה במתני' ליתני ובפירותיהן עד עולם הואיל ובעד עולם תליא מילתא והוא לשון פירות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ופירי פירות. ומפרקי' הא קמ\"ל דאע\"ג דכתב לה פירי פירות אי כתב לה עד עולם אין ואי לא לא. כלומר אין ודאי לא בעי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למכתב מיהו אי לא [תנייה] הוה אמינא דאי כתב פירי פירות הוה ככותב עד עולם להכי תנייה למימר דאפי' כתב פירי פירות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בעינן עד עולם. ובעינן תו ואם ת\"ל תרוייהו דוקא תרתי למה לי. כלומר למכתב בשטרא ומהדרינן צריכא דאי כתב לה פירי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פירות ולא כתב לה עד עולם הוה אמינא פירי פירות הוא דלא אכיל אבל פירי דפירי פירות אכיל להכי איצטריך עד עולם ואי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כתב לה עד עולם ולא כתב לה פירי פירות הוה אמינא לעולם אפירות. כלומר הוה אמינא דה\"ק לא אוכל פירות לעולם לא בשנה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זו ולא בשנים הבאות אבל פירי פירות אוכל דאע\"ג דאפשר דלא איצטריך [דמה לי ראשונה ומה לי שניה ה\"א] דפירותיהן לעולם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משמע אורחא דאינשי לפרושי והוה אמינא דלאו לרבויי פירי פירות אתא ולהכי איצטריך פירי פירות וא\"ת <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>וכי כתב פירי פירות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "[עד עולם נימא] נמי דעד עולם אפירי פירות קאי אבל פירי דפירי פירות אכיל י\"ל דבשלמא אי כתב לה פירותיהן עד עולם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כיון שלא הזכיר פירי פירות כלל אמרי' לא מרבינן מעד עולם מה שלא הזכיר אלא אמרי' דלפירות שהזכיר הוא דאתא אבל כי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כתב לה פירי פירות כיון שהזכיר פירי פירות משמע [עד] עולם שכתב להמשכת פירא דפירי פירות עד עולם הוא דאתא ומהא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמעינן שמה שכותבין בשטרות בביטול כל מודעי אע\"ג דכתב עד עולם לא סגי וצריך למכתב בביטול כל מודעי ומודעי דמודעי עד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עולם. דאי לא. מפרשינן דעד עולם לא קאי אלא אביטול מודעי אבל לא אמודעי דמודעי ואי מסר מודעי על ביטול מודעא עדיין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא נתבטלה: <b>ולענין</b> הלכה קי\"ל כר' יהודה דהא מפרשי' מה הן פירות ומה הן פירי פירות ובעי נמי אי פירי פירות דוקא או",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עד עולם דוקא ובהא דאיבעיא לן אי פירי פירות דוקא או עד עולם דוקא או תרוייהו דוקא כיון דלא איפשיטא בעיין בעינן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תרוייהו ולעולם הוא אוכל פירי פירות עד שיכתוב לה ובפירי פירותיהן עד עולם דבגמ' אמרי' דהאשה הויא בעלת השטר וידה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על התחתונה: <b>וגרסי'</b> תו בגמ' איבעי להו כתב לה דין ודברים אין לי בנכסיך ובפירי פירות מהו שיאכל פירות מפירי פירות",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סליק נפשיה מפירי לא סליק נפשיה א\"ד כ\"ש מפירי ואמרינן פשיטא דמכל מילי סליק נפשיה דאי אמרת מפירי פירא סליק נפשיה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפירי לא סליק נפשיה כיון דאכלינהו לפירי פירי פירות מהיכא. ולטעמיך הא דקתני ר' יהודה אומר לעולם הוא אוכל פירי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פירות כיון דאכלתינהו לפירות פירי פירות מהיכא אלא בדשיירא הכא נמי בדשיירא כלומר אם לא אכלן ומכרן ולקח בהן קרקע",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ועשה פירות סליק מהן נפשו ולא מן הראשונים ולא איפשיטא בעיין הלכך אמרינן דמפירי פירי הוא דסליק נפשיה מפירי לא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סליק נפשיה וכן כתב ר\"ח ז\"ל אבל רבינו האי גאון ז\"ל כ' בספר המקח בשער רביעי ואסיקנא פשיטא מכל מילי סליק נפשיה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומ\"מ מדאמרי' בדשיירא משמע דכי אמרי' לעולם הוא אוכל פירי פירות דוקא בדשיירא ממילא אבל אין הבעל יכול לכופה ליקח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בהן קרקע אלא שהרמב\"ם ז\"ל כתב בפ' כ\"ג מהלכות אישות ילקח בהן קרקע והוא אוכל פירות וסמך לו על התוספתא דתניא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במכילתין ר' יהודה אומר לעולם הוא אוכל פירי פירות כיצד מוכר פירות ולוקח בהן קרקע ויאכל פירות [עיין באשר\"י]:",
      "segment_ids": [
        6
      ]
    }
  ],
