    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו טעמא דלא משום דחיישינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמא הוא זייף הכל <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>ולפי זה אם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותם שטרות שהוא מוציא",
