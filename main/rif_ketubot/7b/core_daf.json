      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהם ואפילו משטר אחד: <b>כותב</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אדם עדותו על השטר.</b> פי' גאון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל כמ\"ש בהלכות ודחה פירושו",
      "segment_ids": [
