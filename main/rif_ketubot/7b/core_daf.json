      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרב אלפסי ז\"ל דאי הכי מאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קמ\"ל רבא היינו מימרא דרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוחנן גופיה ויש לישבו דרבא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אתי לאשמעינן דלא תימא ה\"מ כי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדכרי ליה אחריני דלאו סהדי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום דלא סמוך עלייהו אי לא",
      "segment_ids": [
