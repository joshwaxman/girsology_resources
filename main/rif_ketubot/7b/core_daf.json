      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דילמא סמוך עלויה קמ\"ל דלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומיהו בתוספתא משמע כפירוש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האחר שכתב הריא\"ף ז\"ל ולא",
      "segment_ids": [
