      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טביעות עין שדומות זו לזו]",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל כל שבאין עדים שמקיימים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותם מתוך טביעות עין שיש להם",
      "segment_ids": [
