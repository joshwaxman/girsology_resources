  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> וכ\"כ ר\"ח מעשים בכל יום שאין נפרעין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מנכסים משועבדים אלא בשבועה והר\"ז הלוי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב אם מכר קודם הנאמנות אז אינו מועיל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דלאו כל כמיניה לגרוע כח דלקוחות אחר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמכר להם כבר אבל אם קדם הנאמנות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ללקוחות לא פקע בשביל שמכר נכסיו אח\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכ\"כ הרמ\"ה וי\"א דהיינו דוקא שכתב לה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הנאמנות בשטר וקנו מיניה שאז מועיל אף",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גבי לקוחות משום דאית ליה קלא והרא\"ש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב האידנא דנפישי רמאין נכון להחמיר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כר\"ח וכרב אלפס: <b>ב</b> כתב הטור אפי' היו",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עדים בשעת הפרעון או שכתב לו שובר במה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שפרע ולא אמרי' אי איתא דפרע טפי בעדים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוה פרע ליה כדפרעיה מעיקרא או כתב לו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שובר דשמא נזדמן לו מעיקרא לפרעו בעדים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "או בשובר ואח\"כ פרעו בינו לבינו ואפי'",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דקדק לצרף חשבונו אפי' בפחות משוה פרוטה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא אמרי' כיון שדקדק כולי האי ודאי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קושטא קאמר בד\"א בשאין בו נאמנות אבל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באית ביה נאמנות אע\"פ שלא פירש בו בין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בכולו בין במקצתו אלא האמינו סתם נאמן",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונוטל בלא שבועה וכתב הרא\"ש ז\"ל בתשובה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאם כתב בו פרעון ביני שיטי לא חשיב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כפרעון לחייבו שבועה כתב מיי' אע\"פ",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שפוגם שטרו היה החוב לזמן ותבעו בתוך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זמנו נפרע בלא שבועה עבר זמנו לא יפרע",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא בשבועה ורבינו האי כתב שאפי' בזמנו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לא יפרע אלא בשבועה:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    }
  ]
}