  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "והלכתא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>בלא שבועה והוא דידיע דהני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מטלטלי מחמת מטלטלי קמאי נינהו: יחד לה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארעא בד' מצרנהא בלא שבועה בחד מיצרא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פומבדיתאי אמרי בלא שבועה בני מתא מחסיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרי בשבועה והלכתא בלא שבועה <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>אמר לעדים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתבו וחתמו והבו ליה קנו מיניה לא צריך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאמלוכי ביה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"ב\">ב</span>לא קנו מיניה פומבדיתאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרי לא צריך לאמלוכי ביה בני מתא מחסיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרי צריך לאמלוכי ביה והלכתא צריך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאמלוכי ביה: (<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">מהר\"ם</i> <i class=\"footnote\">ל\"ג</i>ירושלמי א\"ל רב",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לחייא בריה כד אמינא לך הב מידי לפלניא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אי איניש עשיר הוא אמליך בי תנינות ואי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איניש מסכן הוא הב ליה מיד): רבי אלעזר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן עזריה אומר וכו' <span class=\"bavli-ref\" data-bavli-ref=\"(דף נו.)\" data-bavli-daf=\"56a\" data-bavli-index=\"0\"></span>אמר רב נחמן אמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל הלכה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ג\" data-order=\"3\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"1\" data-marker-letter=\"ג\">ג</span>כר' אלעזר בן עזריה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i><span class=\"bavli-ref\" data-bavli-ref=\"(דף נה:)\" data-bavli-daf=\"55b\" data-bavli-index=\"1\"></span><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ownerless Property and Gifts\" data-label=\"⚬\"></i>איתמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתנת שכיב מרע שכתב בה קנין <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">עי'</i> <i class=\"footnote\">אלפס</i>",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">ב\"ב</i> <i class=\"footnote\">דף</i> <i class=\"footnote\">רכט</i>בי רב משמיה דרב אמרי ארכבה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אתרי רכשי ושמואל אמר לא ידענא מה אידון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בה [בי] רב משמיה דרב אמרי ארכבה אתרי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רכשי הרי היא כמתנת בריא והרי היא כמתנת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ש\"מ הרי היא כמתנת בריא שאם עמד אינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חוזר והרי היא כמתנת ש\"מ שאם אמר הלואתו לפלוני הלואתו לפלוני ושמואל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אמר לא ידענא מה אידון ביה שמא לא גמר להקנותו אלא בשטר ואין שטר לאחר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מיתה <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>: <span class=\"bavli-ref\" data-bavli-ref=\"(דף נו.)\" data-bavli-daf=\"56a\" data-bavli-index=\"2\"></span>בעי רבי אבין <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Marriage\" data-label=\"⚬\"></i>נכנסה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ד\" data-order=\"4\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"2\" data-marker-letter=\"ד\">ד</span>לחופה ולא נבעלה מהו חיבת חופה קונה או חיבת",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ביאה קונה ופשטינן דחיבת חופה קונה בעי רב אשי נכנסה לחופה ופירסה נדה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מהו אם תמצא לומר חיבת חופה קונה חופה דחזיא לביאה אין חופה דלא חזיא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לביאה לא או דילמא לא שנא תיקו הילכך אין קונה: <b><big><span class=\"bavli-ref\" data-bavli-ref=\"(דף נד:)\" data-bavli-daf=\"54b\" data-bavli-index=\"3\"></span>מתני'</big></b> רבי יהודה <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Marriage\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Even HaEzer\" data-label=\"⚬\"></i>אומר",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רצה כותב לבתולה מאתים והיא כותבת <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ה\" data-order=\"5\"></i>לו התקבלתי ממך מנה ולאלמנה מנה והיא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כותבת התקבלתי ממך חמשים זוז רבי מאיר אומר כל הפוחת לבתולה ממאתים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ולאלמנה ממנה הרי בעילתו בעילת זנות: <b><big>גמ'</big></b> (<span class=\"bavli-ref\" data-bavli-ref=\"(דף נו:)\" data-bavli-daf=\"56b\" data-bavli-index=\"4\"></span> <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">כ\"ז</i> <i class=\"footnote\">אינו</i> <i class=\"footnote\">מהלכות.</i> <i class=\"footnote\">ד\"ת</i>כל",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הפוחת ואפילו בתנאה אלמא קסבר תנאה בטל ואית לה מאתים וכיון דאמר לה לית",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ליך אלא מנה [לא] סמכה דעתה והוי לה בעילתו בעילת זנות והא שמעינן ליה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לרבי מאיר דאמר כל המתנה על מה שכתוב בתורה תנאו בטל הא מדרבנן תנאו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "קיים קסבר רבי מאיר כתובה דאורייתא) אחתיה דרמי בר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">בר</i> <i class=\"footnote\">חמא</i>",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<i class=\"footnote\">(ג\"א)</i>פפא אינסבה לרב <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">אויא</i> <i class=\"footnote\">(ג\"א)</i>אדא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ו\" data-order=\"6\"></i><span class=\"bavli-ref\" data-bavli-ref=\"(דף נז.)\" data-bavli-daf=\"57a\" data-bavli-index=\"5\"></span>אירכסה כתובתה אתא לקמיה דרב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יוסף אמר ליה הכי אמר רב יהודה אמר שמואל זו דברי רבי מאיר",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בארבע מצרנהא.</b> שייחד לה קרקע וכתב לה ד' מצרים שלה בחייו לעשותה אפותיקי לכתובה ומת נפרעת ממנו בלא שבועה דודאי <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מתפיס לה צררי אחריני: <b>בשבועה.</b> דכיון דלא כתב לה ארבעת המצרים אין זו סמיכה לסמוך עליה והרי היא כמי שלא ייחד ואיכא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למיחש לצררי: <b>אמר לעדים כתבו וחתמו.</b> כגון מתנת קרקע: <b>לא</b> צריך לאמלוכי ביה אם עדיין עומד בדבורו שיכתבו לו דכיון",
      "segment_ids": [
        1,
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דקנו מיניה סתם קנין לכתיבה עומד כך כתב רש\"י ז\"ל [והלכתא צריך לאמלוכי ביה]. וכתב הרב בעל העטור ז\"ל דדוקא במתנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו טעמא משום דכיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבההוא שטרא הוא דמקני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חיישינן דילמא הדר ביה אבל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשטר הלואה שטרא גלויי מילתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלמא הוא וכיון דאמר כתובו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כותבין ונותנין [ואע\"ג דלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קני מיניה] ואע\"ג דבהאי שטרא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבי ממשעבדי הא שעבד נפשיה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל הרב רבינו משה בר מיימון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל כתב בפרק י\"א מהלכות מלוה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולוה לפיכך האומר לעדים הוו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עלי עדים שאני חייב לזה מנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין כותבין עדותן עד שיאמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להם הלוה כתבו שטר וחתמו ותנו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו ואף על פי שיאמר להם כך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריכין להמלך אחר שחתמו בשטר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואחר כך נותנין שטר ביד המלוה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ע\"כ נראה שהוא מפרשה לזו אפי'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשטרי הודאות והלואות וכתב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו הראב\"ד אני קבלתי שלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נאמרה בגמרא אלא בכותב כתובה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאשתו ומוסיף לה אבל בהודאות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והלואות לא צריך לאמלוכי ביה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ע\"כ וכן נראה עיקר ולפיכך לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הזכירו דין זה פרק זה בורר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[דף כט:] והוזכר כאן ואע\"פ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכתוב ברוב הנסחאות הבו ליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא כתוב הבו לה היינו לפי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שדין זה נוהג ג\"כ בנותן מתנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאחר והיינו נמי טעמא דקנו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיניה לא צריך לאימלוכי ביה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום דכיון דמגוף הנקנה עצמו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינו יכול לחזור בו ואע\"ג",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשטרא מצי הדר ביה וה\"נ מוכח",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממאי דאמרינן לא צריך לאמלוכי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביה דמשמע דאי בעי למהדר מצי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדר לא חיישינן להכי דכיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמגוף דבר הנקנה לא מצי הדר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסתמא אף מן השטר לא חיישינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דילמא הדר ביה אבל לא קנו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיניה כיון דמצי למהדר אפי'",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מגוף הדבר הנקנה חיישינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דילמא הדר ביה מהכא משמע דלית לן סברא דירושלמי [שהביאו הר\"ן בריש פרק זה במשנה] דתוספת יהא נקנה אפילו אחר נשואין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "באמירה בעלמא דאם איתא אמאי צריך לאמלוכי ביה וכתבו הרב אב\"ד והראב\"ד ז\"ל דכי אמרינן צריך לאמלוכי ביה דוקא כגון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאמר להם בשעת אירוסין כתבו לה בשעת נשואין דכיון דגלה בדעתו שאינו רוצה שיכתבו מעתה חוששין שמא חזר בו בינתים אבל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "באומר לכתוב לה מעתה אין צריכין לימלך בו דאילו חזר בו הוא רץ אצלם דמידע ידע דכותבין ונותנין דחזקת שליח עושה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שליחותו: <b>הלכה כר' אלעזר בן עזריה.</b> דאזיל בתר אומדנא הילכך אלמנה מן האירוסין אינה גובה אלא מנה ומאתים ומיהו משמע",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאפילו מן המשועבדין גובה אותן אלא שהרב רמב\"ם ז\"ל כתב בפרק עשירי מהלכות אישות שאינה גובה אלא מבני חורין וכבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כתבתי זה למעלה [ריש פרק ד סי' רכו]: <b>ופירסה נדה.</b> ופירש ממנה ומת: <b>הילכך אינה קונה.</b> כיון שכתב כן הרי\"ף ז\"ל סתם",
      "segment_ids": [
        4,
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "משמע שאינו קונה לשום דבר לא ליורשה ולא ליטמא לה וכן כתב הרמב\"ם ז\"ל בפרק עשירי מהלכות אישות אבל אם היתה נדה אע\"פ",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנכנסה לחופה ונתייחד עמה לא גמרו הנשואין והרי היא כארוסה עדיין עד כאן והדבר תימה דכיון דקיימא לן ביבמות [דף",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נז:] דיש חופה לפסולות [כגון אלמנה לכהן גדול וחברותיה] חופת נדה למה לא תקנה לפיכך נראה כדברי האומר דלא איבעיא לן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא לענין תוספת כתובה אבל לשאר דברים קונה: <b>מתני' רבי יהודה אומר כו' והיא כותבת.</b> אע\"פ שלא נתקבלה מוחלת וכותבת",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בלשון שובר: <b>גרסינן</b> בגמרא כל הפוחת ואפילו בתנאה אלמא קסבר תנאו בטל ואית לה וכיון דאמר לה לית ליך אלא מנה לא סמכה",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דעתה והויא ליה בעילתו בעילת זנות והא שמעינן ליה לר\"מ דאמר כל המתנה על מה שכתוב בתורה תנאו בטל הא בדרבנן תנאו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קיים קסבר רבי מאיר כתובה דאורייתא. והכי פי' דמדלא תנא כל בתולה שאין לה מאתים ואלמנה שאין לה מנה הרי זו בעילת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זנות ש\"מ דהכי אשמעינן דאע\"פ שהיא גובה לבסוף דאין תנאו קיים אפ\"ה כיון דמעיקרא אתני קרי ליה בעילת זנות משום דבשעת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ביאה לא הוה סמכה דעתה אכתובה אלמא קסבר תנאו בטל דבלאו הכי לאו רבותא הוא דניתני כל הפוחת ואמאי והא אית ליה לר'",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מאיר דבדרבנן תנאו קיים ומפרקינן דקא סבר ר\"מ כתובה דאורייתא: <b>גמ'</b> אחתיה דרמי בר פפא אירכס <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>שטר כתובה: <b>זו דברי ר\"מ.</b>",
      "segment_ids": [
        8,
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאמר לעיל כל הפוחת לבתולה ממאתים ואפילו בתנאה והתנאי בטל קרי ליה בעילת זנות משום דלא סמכה דעתה וה\"נ לר\"מ הוא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאסור לשהות אשה שאבדה שטר כתובתה ואפי' אית להן <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>דלא מפסדא בהכי דגביא בתנאי ב\"ד מיהו לא סמכה דעתה דאמרה כי תבענא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ליה אמר פרעתיך הילכך בעילת זנות היא:",
      "segment_ids": [
        10
      ]
    }
  ],
