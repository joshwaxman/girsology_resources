        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שניהם להחזירה לו מחזירה וכותב לה כתובת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעולה כמבואר בקונטרס הראיות: <b>ד לשון</b>",
