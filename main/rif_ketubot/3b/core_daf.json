      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נודע לו בראיה ברורה שהיתה בעולה קודם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנתארס' והטעתו לפיכך יש להשביע' בנקיטת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חפץ כדרך כל הנשבעין ונוטלין ואח\"כ תגבה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התוספת אבל היא אין לה להשביעו שלא מצאה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בתולה ואח\"כ תפסיד העיקר שחזקה אין אדם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טורח בסעודה ומפסידה אלא היא תחרים סתם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על מי שטוען עליה שקר ואם רוצה לקיימה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחר שהפסידה כתובתה חוזר וכותב לה מנה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לפי שאסור לשהות עם אשתו שעה אחת בלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתוב' ע\"כ: <b>לשון ריא\"ז</b> ולמה הוא נאמן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בטענה זו חזקה אין אדם טורח בסעודה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומפסידה שאילו היה שונא אותה מתחלה היה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מגרשה ולא היה נזקק לזה הטורח ולזו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ההוצאה בחנם ולא האמינוהו חכמים בטענה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זו אלא להפסידה כתובתה בלבד אבל לא את",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התוספת כדברי הגאונים ול\"נ שאף על",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התוספת נאמן ומשביעין אותו שבועת היסת",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדין כל הכופר ממון לחבירו רצה לקיימה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחזקת בתולה ולכתוב לה כתובת מנה אין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שומעין לו שכל עיקרו לא האמינוהו אלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מפני שמפסיד טורח סעודתו וזה אינו מפסיד",
