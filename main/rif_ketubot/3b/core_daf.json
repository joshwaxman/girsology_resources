        3
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> הכונס את הבתולה ובעל ואמר פתח",
      "segment_ids": [
        3
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פתוח מצאתי ולא היתה בתולה אם היה בחור",
      "segment_ids": [
