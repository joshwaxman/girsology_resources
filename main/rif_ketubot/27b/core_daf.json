  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> והם הולכים לשיטתם שפוסקים מצות יבום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קודמת ור\"ת פסק שמצות חליצה קודמת לפיכך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין דינה כמורדת ולזה הסכים הרא\"ש: <b>לשון</b>",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> וכן היבמה שמרדה ביבם כופין אותו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחלוץ מכח תקנה זו שביאר מז\"ה וכבר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ביארתי שאינה מפסדת מדינא כתובתה כלום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במרדה: <b>ב לשון ריא\"ז</b> אם רוצה לגרשה",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתחלת מרדו ולתת לה כל כתובתה הרשות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בידו ואין מוסיפין על כתובתה כלום ולא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמרו להוסיף על כתובתה אלא כשמורד בה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואינו רוצה לגרשה כמו שביאר מז\"ה: הארוס",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמרד בארוסתו ואינו רוצה לכונסה אין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מוסיפיס לה על כתובתה אלא מחייבין אותו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לזונה מעת שהגיע הזמן לכנוס ואינו כונס",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמו שביארנו למעלה. וכל המורד על אשתו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "או המדיר (על) [את] אשתו אם מתה אשתו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעוד שהוא במרדו ולא נתפייס עמה אין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעלה יורשה הואיל ואינו נוהג בה מנהג",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעל כמו שביאר מז\"ה בפסקיו ואס האשה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מרדה בבעלה ומתה במרדה בעלה יורשה ואע\"פ",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלח היה נוהג בה מנהג אישות: <b>ג</b> עיין",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בהגהות הרא\"ש בהאי פירקין אם שכירות",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "החזן הוי בכלל דמחזי כשכר שבת:",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        3
      ]
    }
  ],
