   ]
  },
  "14": {
   "segId": "Megillah.26b.15",
   "sugya": "megillah_26a_mechirat_beit_hakneset",
   "marks": [
    {
     "type": "proposition",
     "object": "p_mar_zutra_tachrichin",
     "gloss_en": "Mar Zutra: worn scroll-wrappers are made into shrouds for a met mitzva, and that is their interment"
