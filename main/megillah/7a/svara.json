  "1": {
   "segId": "Megillah.7a.2",
   "sugya": "megillah_6b_mani_matnitin_adar",
   "marks": [
    {
     "type": "support",
     "object": "s_kidrav_shmuel_bar_yehuda",
     "kind": "svara",
     "gloss_en": "דאמר רב שמואל בר יהודה: בתחילה קבעוה בשושן, ולבסוף בכל העולם כולו",
     "supports": "p_hashenit_kviat_olam",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_hashenit_mai_avid",
     "kind": "svara",
     "gloss_en": "ורבי אליעזר ברבי יוסי האי השנית מאי עביד ליה? -- the verse RSBG's reason rests on (6b.28) seems to require a second reading",
     "against": "p_ein_korin_beadar_sheni",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_kidrav_shmuel_bar_yehuda",
     "gloss_en": "מיבעי ליה לכדרב שמואל בר יהודה: בתחילה קבעוה בשושן ולבסוף בכל העולם כולו (= p_hashenit_kviat_olam)",
     "answers": "obj_hashenit_mai_avid",
     "restores": "p_ein_korin_beadar_sheni"
    },
    {
     "type": "proposition",
     "object": "p_hashenit_kviat_olam",
     "gloss_en": "REBY needs 'the second' for Rav Shmuel bar Yehuda's teaching (the second letter fixed Purim for the whole world)"
    }
   ]
  },
  "9": {
   "segId": "Megillah.7a.10",
   "sugya": "megillah_6b_mani_matnitin_adar",
   "marks": [
    {
     "type": "support",
     "object": "s_shloshet_alafim",
     "kind": "svara",
     "gloss_en": "והלא כבר נאמר: וידבר שלשת אלפים משל",
     "supports": "p_lo_zu_bilvad",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_al_tosef",
     "kind": "svara",
     "gloss_en": "ואומר: אל תוסף על דבריו",
     "supports": "p_lo_zu_bilvad",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_amru_lo_zu_bilvad",
     "kind": "svara",
     "gloss_en": "אמרו לו: וכי זו בלבד אמר? והלא כבר נאמר וידבר שלשת אלפים משל, ואומר אל תוסף על דבריו -- no reply is recorded",
     "against": "p_chochmat_shlomo",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_chochmat_shlomo",
     "gloss_en": "R' Shimon ben Menasya: [Kohelet does not render the hands impure] because it is Solomon's own wisdom"
    }
   ]
  },
  "10": {
   "segId": "Megillah.7a.11",
   "sugya": "megillah_6b_mani_matnitin_adar",
   "marks": [
    {
     "type": "support_deflection",
     "object": "defl_meimar_tuva_amar",
     "gloss_en": "מאי ואומר? וכי תימא: מימר טובא אמר, דאי בעי — איכתיב, ודאי בעי — לא איכתיב",
     "deflects": "s_shloshet_alafim",
     "refuted": true
    }
   ]
  },
