   "marks": [
    {
     "type": "support_deflection",
     "object": "defl_svara_haman",
     "gloss_en": "דרבי אליעזר — סברא הוא, דלא הוה איניש דחשיב למלכא כוותיה, והאי כי קא מפיש טובא ואמר — אדעתיה דנפשיה קאמר",
     "deflects": "s_vayomer_haman_belibo",
     "refuted": false
    },
    {
     "type": "proposition",
     "object": "p_rava_lechulhu_pircha",
     "gloss_en": "Rava: all of them have a refutation except Shmuel's, which has none ... Shmuel's certainly has no refutation"
    }
   ]
  },
  "15": {
   "segId": "Megillah.7a.16",
   "sugya": "megillah_6b_mani_matnitin_adar",
   "marks": [
    {
     "type": "support_deflection",
     "object": "defl_kerabbi_elazar",
     "gloss_en": "דרבי עקיבא — דלמא כרבי אלעזר, דאמר: מלמד שכל אחד ואחד נדמתה לו כאומתו (= p_elazar_nidmeta)",
     "deflects": "s_nosset_chen",
     "refuted": false
    },
    {
     "type": "proposition",
     "object": "p_elazar_nidmeta",
     "gloss_en": "R' Elazar: it teaches that to each and every one she seemed to be of his own nation"
    }
   ]
  },
