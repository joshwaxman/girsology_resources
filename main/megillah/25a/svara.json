   "marks": [
    {
     "type": "proposition",
     "object": "p_yevarchucha_tovim_minut",
     "gloss_en": "one who says 'may the good bless You' -- this is the way of heresy"
    }
   ]
  },
  "1": {
   "segId": "Megillah.25a.2",
   "sugya": "megillah_24b_haomer_yevarchucha_tovim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_meshatkin_mechane_baarayot",
     "gloss_en": "one who euphemises in the [reading of the] forbidden relations -- they silence him"
    }
   ]
  },
  "2": {
   "segId": "Megillah.25a.3",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "support",
     "object": "s_shtei_reshuyot",
     "kind": "svara",
     "gloss_en": "בשלמא מודים מודים -- דמיחזי כשתי רשויות",
     "supports": "p_meshatkin_modim_modim_mt",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_al_tov_mashma",
     "kind": "svara",
     "gloss_en": "ועל טוב יזכר שמך נמי -- דמשמע על טוב אין ועל רע לא",
     "supports": "p_meshatkin_al_tov_mt",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_tnan_al_haraah",
     "kind": "svara",
     "gloss_en": "ותנן: חייב אדם לברך על הרעה כשם שהוא מברך על הטובה -- the mishna that makes the implied exclusion of the bad objectionable",
     "supports": "p_al_tov_mashma",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_modim_shtei_reshuyot",
     "gloss_en": "'we give thanks, we give thanks' -- because it looks like two authorities"
    }
   ]
  },
  "3": {
   "segId": "Megillah.25a.4",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "support",
     "object": "s_metil_kina",
     "kind": "svara",
     "gloss_en": "חד אמר: מפני שמטיל קנאה במעשה בראשית",
     "supports": "p_meshatkin_kan_tzippor_mt",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_midotav_gezerot",
     "kind": "svara",
     "gloss_en": "וחד אמר: מפני שעושה מדותיו של הקדוש ברוך הוא רחמים, ואינן אלא גזירות",
     "supports": "p_meshatkin_kan_tzippor_mt",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_metil_kina",
     "gloss_en": "because he casts jealousy among the works of creation"
    }
   ]
  },
  "7": {
   "segId": "Megillah.25a.8",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "support",
     "object": "s_telat_mishum_moshe",
     "kind": "svara",
     "gloss_en": "השתא הני תלתא... אנן לא אמרינן להו, ואת אמרת כולי האי!",
     "supports": "p_siyamtinhu_lishvachei",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_mashal_dinrei_kesef",
     "kind": "svara",
     "gloss_en": "משל לאדם שהיו לו אלף אלפי אלפים דינרי זהב... לא גנאי הוא לו?!",
     "supports": "p_siyamtinhu_lishvachei",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_siyamtinhu_lishvachei",
     "gloss_en": "R' Chanina: have you finished your Master's praises? ... and you say all this!"
    }
   ]
  },
  "9": {
   "segId": "Megillah.25a.10",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "support",
     "object": "s_mashal_kli_gadol",
     "kind": "svara",
     "gloss_en": "משל לאדם שמבקשין הימנו כלי גדול ויש לו -- דומה עליו ככלי קטן",
     "supports": "p_legabei_moshe_zutarta",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_michlal_milta_zutarti",
     "kind": "svara",
     "gloss_en": "מכלל דיראה מילתא זוטרתי היא?! -- does it follow that fear of Heaven is a small matter?",
     "against": "p_yira_milta_zutarta",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_legabei_moshe",
     "gloss_en": "אין, לגבי משה רבינו מילתא זוטרתי היא (= p_legabei_moshe_zutarta)",
     "answers": "obj_michlal_milta_zutarti",
     "restores": "p_yira_milta_zutarta"
    },
    {
     "type": "proposition",
     "object": "p_legabei_moshe_zutarta",
     "gloss_en": "yes -- for Moses our teacher it is a small matter"
    }
   ]
  },
  "4": {
   "segId": "Megillah.25a.5",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "objection",
     "object": "obj_vehaa_meshatkin_tnan",
     "kind": "tnan",
     "gloss_en": "אמר ליה אביי: והא משתקין אותו תנן! -- the mishna has this formula silenced. Not answered: ורבה, לחדודי לאביי הוא דבעא (25a.6)",
     "against": "p_rabba_kama_yada",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_ata_chasta_al_kan_tzippor",
     "gloss_en": "the leader before Rabba: 'You had pity on the bird's nest -- have pity and mercy on us!' (the bracketed text adds: 'You had pity on it and its young')"
    }
   ]
  },
  "11": {
   "segId": "Megillah.25a.12",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "objection",
     "object": "obj_meitivi_kofla_meguneh",
     "kind": "meitivi",
     "gloss_en": "מיתיבי: הקורא את שמע וכופלה הרי זה מגונה -- מגונה הוא דהוי, שתוקי לא משתקינן ליה?! reprehensible it is, but they do not silence him?",
     "against": "p_shema_shema_kemodim",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_milta_milta_pesuka_pesuka",
     "gloss_en": "לא קשיא: הא דאמר מילתא מילתא ותני לה, הא דאמר פסוקא פסוקא ותני לה (= p_okimta_milta_milta, p_okimta_pesuka_pesuka)",
     "answers": "obj_meitivi_kofla_meguneh",
     "restores": "p_shema_shema_kemodim"
    },
    {
     "type": "proposition",
     "object": "p_kofla_meguneh",
     "gloss_en": "the baraita: one who reads the Shema and doubles it -- this is reprehensible"
    }
   ]
  },
  "12": {
   "segId": "Megillah.25a.13",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "objection",
     "object": "obj_dilma_lo_kiven_daato",
     "kind": "svara",
     "gloss_en": "אמר ליה רב פפא לרבא: ודלמא מעיקרא לא כוין דעתיה והשתא כוין דעתיה? -- perhaps at first he did not direct his mind and now he did, so why silence him?",
     "against": "p_shema_shema_kemodim",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_chavruta_klapei_shmaya",
     "gloss_en": "חברותא כלפי שמיא? -- if he did not direct his mind, we strike him with a smith's hammer until he does (= p_machinan_bearzafta)",
     "answers": "obj_dilma_lo_kiven_daato",
     "restores": "p_shema_shema_kemodim"
    },
    {
     "type": "proposition",
     "object": "p_machinan_bearzafta",
     "gloss_en": "Rava: familiarity toward Heaven?! if he did not direct his mind, we strike him with a smith's hammer until he directs his mind"
    }
   ]
  },
  "5": {
   "segId": "Megillah.25a.6",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rabba_lechadudei_abaye",
     "gloss_en": "and Rabba -- he wanted to sharpen Abaye"
    }
   ]
  },
  "6": {
   "segId": "Megillah.25a.7",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_shvachim_yeterim",
     "gloss_en": "the leader before R' Chanina: 'the great, mighty and awesome God, the powerful, the strong and the fearless'"
    }
   ]
  },
  "8": {
   "segId": "Megillah.25a.9",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_hakol_bidei_shamayim",
     "gloss_en": "R' Chanina: everything is in the hands of Heaven except fear of Heaven"
    }
   ]
  },
  "10": {
   "segId": "Megillah.25a.11",
   "sugya": "megillah_25a_kan_tzippor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_shema_shema_kemodim",
     "gloss_en": "R' Zeira: one who says 'shema, shema' is like one who says 'modim, modim'"
    }
   ]
  },
  "14": {
   "segId": "Megillah.25a.15",
