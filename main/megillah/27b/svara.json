   "sugya": "megillah_27b_bama_heerachta_yamim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_perida_beit_hamidrash",
     "gloss_en": "R' Perida: in all my days no man preceded me to the beit midrash"
    }
   ]
  },
  "2": {
   "segId": "Megillah.27b.3",
   "sugya": "megillah_27b_ein_mochrin_shel_rabim_leyachid",
   "marks": [
    {
     "type": "objection",
     "object": "obj_shapir_kamru_rabbanan",
     "kind": "svara",
     "gloss_en": "שפיר קאמרי ליה רבנן לרבי מאיר! -- the Sages' 'if so, not even from a large town to a small one' is well said against R' Meir",
     "against": "p_ein_mochrin_rabim_leyachid",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_meikara_kadisha",
     "gloss_en": "ורבי מאיר: מעיר גדולה לעיר קטנה -- מעיקרא קדישא, השתא נמי קדישא; מרבים ליחיד ליכא קדושה -- the town-to-town case keeps its sanctity, the sale to an individual does not",
     "answers": "obj_shapir_kamru_rabbanan",
     "restores": "p_ein_mochrin_rabim_leyachid"
    },
    {
     "type": "proposition",
     "object": "p_rm_meikara_kadisha",
     "gloss_en": "from a large town to a small town: at the outset it was holy, now too it is holy"
    }
   ]
  },
  "1": {
   "segId": "Megillah.27b.2",
   "sugya": "megillah_27b_ein_mochrin_shel_rabim_leyachid",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ein_mochrin_rabim_leyachid",
     "gloss_en": "R' Meir: one may not sell [a holy thing] of the many to an individual"
    }
   ]
  },
  "3": {
   "segId": "Megillah.27b.4",
   "sugya": "megillah_27b_ein_mochrin_shel_rabim_leyachid",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rabbanan_kehai_gavna",
     "gloss_en": "if there is reason for concern, in a case like this [large town to small] too there is reason for concern"
    }
   ]
  },
  "12": {
   "segId": "Megillah.27b.13",
