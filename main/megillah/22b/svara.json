    {
     "type": "support",
     "object": "s_vechen_mikeroa",
     "kind": "svara",
     "gloss_en": "וכן הוא אומר מכרע על ברכיו",
     "supports": "p_keria_al_birkayim",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_shenemar_havo_navo",
     "kind": "svara",
     "gloss_en": "שנאמר הבוא נבוא אני ואמך ואחיך להשתחות לך ארצה",
     "supports": "p_hishtachavaya_pishut",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_kidda_al_apayim",
     "gloss_en": "kidda is [bowing] upon the face"
    }
   ]
  },
  "4": {
   "segId": "Megillah.22b.5",
   "sugya": "megillah_22a_taanit_tzibur_bekama",
   "marks": [
    {
     "type": "objection",
     "object": "obj_mani_matnitin",
     "kind": "tanya",
     "gloss_en": "ולרב אשי מתניתין מני? לא תנא קמא ולא רבי יוסי -- the baraita's TK has one reader on a Tuesday/Wednesday Ninth of Av and three on Monday/Thursday, R' Yosei always three: no one has four",
     "against": "p_ashi_klal_leatuyei_taanit",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_tk_sheni_shlosha",
     "gloss_en": "[the Ninth of Av] falling on a Monday or Thursday -- three read and one reads the haftara"
    }
   ]
  },
  "6": {
   "segId": "Megillah.22b.7",
   "sugya": "megillah_22a_taanit_tzibur_bekama",
   "marks": [
    {
     "type": "objection",
     "object": "obj_behedya",
     "kind": "tnan",
     "gloss_en": "הא בהדיא קתני לה: בראשי חדשים ומועד קורין ארבעה -- the mishna states them explicitly, so the klal does not come to add them",
     "against": "p_klal_leatuyei_rc",
     "state": "live"
    }
   ]
  },
  "11": {
   "segId": "Megillah.22b.12",
