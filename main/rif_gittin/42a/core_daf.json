      "right": "0px",
      "left": "",
      "text": "<b>פ:] זו דברי רבי מאיר.</b> כלומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאית ליה דמשום שלום מלכות",
      "segment_ids": [
