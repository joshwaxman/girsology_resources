      "left": "",
      "text": "טפי מחורבן הבית: <b>גרסי' בגמ'</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>א\"ר יהודה אמר [שמואל] [דף</b>",
      "segment_ids": [
        4
      ]
    },
    {
