      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנאי <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Even HaEzer\" data-label=\"⚬\"></i>כפול הני מילי <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>דאם תשמשי ואם לא",
      "segment_ids": [
        1
      ]
    },
    {
