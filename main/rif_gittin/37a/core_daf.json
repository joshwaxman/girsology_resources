      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מניקתו שתי שנים ר' יהודה אומר <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>שמנה עשר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
