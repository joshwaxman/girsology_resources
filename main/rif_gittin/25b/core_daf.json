      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובנכסיהם ובמס מנה ותבע מהיתומים אחר",
      "segment_ids": [
