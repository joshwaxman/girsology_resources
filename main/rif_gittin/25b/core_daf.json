      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והוציא בנו פנקסו שהוציא בפרנסת היתומים",
      "segment_ids": [
