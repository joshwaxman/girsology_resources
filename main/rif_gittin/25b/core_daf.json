      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מעיד ומלתא פשיטא הוא דמעיד כשאינו מקבל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פרס ואינו נוגע בדבר: עוד שאלה ראובן",
