      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מעיד. [תשובה]. כן כתב ר\"י שאפוטרופא",
      "segment_ids": [
