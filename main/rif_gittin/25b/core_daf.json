      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומפורש בו של יתמי פלוני אם שמעון יכול",
      "segment_ids": [
