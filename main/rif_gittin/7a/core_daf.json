  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ליורשי משלח דקיימא לן דאין קנין למת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכן הלכה: <b>הדרן עלך המביא קמא</b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף טו.)\" data-bavli-daf=\"15a\" data-bavli-index=\"0\"></span>U <b><big>המביא</big></b>",
      "segment_ids": [
        0,
