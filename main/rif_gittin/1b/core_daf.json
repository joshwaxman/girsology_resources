      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לדרשה הן באין. וריצב\"א היה מדקדק כיון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלא יתחייב עליהן בשבת אם יכתוב בלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
