      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לפעוטות אע\"פ שאינה יודעת לשמור גיטה",
      "segment_ids": [
