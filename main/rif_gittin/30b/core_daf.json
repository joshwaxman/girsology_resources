      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומאכילה ומשקה משלה ואין מחייבין אותו",
      "segment_ids": [
