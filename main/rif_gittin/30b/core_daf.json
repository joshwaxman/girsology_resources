      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דע\"י אביה מתגרשת אף קודם שהגיעה",
      "segment_ids": [
