      "left": "",
      "text": "מו:) דמותבינא אמתני' דהמוציא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אשתו משום אילונית דרבי יהודה",
