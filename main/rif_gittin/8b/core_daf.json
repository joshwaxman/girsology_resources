      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמתרץ מתכוין להעמיד דבריו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"נ מוכחא בפרק השולח (דף",
      "segment_ids": [
        0
      ]
    },
