      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לאו ונסתפקת אם מנוי שליחות השני הוי",
      "segment_ids": [
