        1
      ],
      "gemara_segment_ids": [
        0,
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין כח לבעל לבטל גוף הגט ובמס' קדושין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פ' האומר מוכח דאם הבעל ביטל הגט בפירוש",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מודה רב נחמן שבטל וגירסה זו תופס ר\"מ",
      "segment_ids": [
