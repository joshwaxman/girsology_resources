      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתורף בגיטא היינו כדי שלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יזכיר חוץ שפוסל על פה לפני",
      "segment_ids": [
