    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מגזירה אטו בכתב דאילו הוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדינא כי היכי דגזרינן לאחר",
      "segment_ids": [
