        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ארוסה אין חוששין לה <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">וברא\"ש</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">שלא</i> <i class=\"footnote\">לפלוני</i> <i class=\"footnote\">אין</i> <i class=\"footnote\">חוששין</i> <i class=\"footnote\">לה.</i>",
