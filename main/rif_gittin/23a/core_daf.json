      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דמיו: <b>ב</b> וכ\"כ מיי' וכתב הרא\"ש ותמהתי על",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דברי הגאון דמה ענין זה לקנסות שאין",
