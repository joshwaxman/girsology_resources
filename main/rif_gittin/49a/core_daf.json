    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">חניכתו</i> <i class=\"footnote\">וחניכתה</i> <i class=\"footnote\">כשר</i> <i class=\"footnote\">(ג\"א)</i> <i class=\"footnote\">[וכ\"ה</i> <i class=\"footnote\">גי'</i> <i class=\"footnote\">ר\"ח</i>",
