      "right": "275px",
      "text": "כשר איש פלוני עד כשר בן איש פלוני עד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשר איש פלוני בן איש פלוני ולא כתב עד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">במשנה</i> <i class=\"footnote\">שבירושלמי</i> <i class=\"footnote\">הגי'</i> <i class=\"footnote\">וכך</i> <i class=\"footnote\">היו</i> <i class=\"footnote\">נקיי</i>",
      "segment_ids": [
