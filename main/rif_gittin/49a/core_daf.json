    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד יוני ואחד עברי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>כשר כתב סופר ועד",
      "segment_ids": [
        0
      ]
