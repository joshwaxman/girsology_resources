  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף פז:)\" data-bavli-daf=\"87b\" data-bavli-index=\"0\"></span>גט שכתבו עברית <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>ועדיו יונית יונית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ועדיו עברית עד אחד עברי ועד אחד יוני",
      "segment_ids": [
