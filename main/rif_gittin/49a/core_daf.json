      "right": "275px",
      "text": "<i class=\"footnote\">הדעת</i> <i class=\"footnote\">שבירושלמים</i> <i class=\"footnote\">כותבין</i> <i class=\"footnote\">אחר</i> <i class=\"footnote\">תיבות</i> <i class=\"footnote\">כתב</i>",
      "segment_ids": [
