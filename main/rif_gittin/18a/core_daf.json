      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נמי שבועת בטוי ומשני כי קתני שבועה דכי",
      "segment_ids": [
