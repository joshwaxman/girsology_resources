  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> מה שבועה נשבעת שלא התפיסה הבעל צררי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחייה ולא תפסה היא משלו כלום ומיי' כתב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שצריכה לישבע ג\"כ שלא מחלה לו כתובתה או",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלא מכרה לו ונראה שאם כתובתה בידה אינה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריכה לישבע על זה שאילו מחלה לו או",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מכרה היתה מחזרת לו הכתובה ואם היורשים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קטנים והאפוטרופסים רוצים להשביעה והיא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אומרת שאינה רוצה לישבע עד שיגדלו בניה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כי שמא הם ימחלו לה או תתפשר עמהם כתב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש בתשובה אין שומעין לה אלא לא תטול",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כלום עד שתשבע. וששאלת אלמנה שאומרת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעלי נתן לי מנה קודם מותו במתנה גמורה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"מ שלא יכנס לי בכתובתי ועדים אין לה.",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תשובה אם היא מוחזקת במנה כגון שיש ממון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעלה תחת ידיה והיא יכולה לטעון על אותו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממון אין בידי משל בעלי כלום נאמנת ג\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במיגו לומר נתנו לי במתנה ובשבועה אבל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אם היא אינה מוחזקת בממון בעלה אז אינה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נאמנת ומדברי רבינו נראה דאם מכרה או",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נתנה קודם שנשבעה קיים בין ממקרקעי בין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממטלטלי והרא\"ש חלק בין מקרקעי למטלטלי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עיין טור אה\"ע סי' צו: <b>ב</b> וכתב ר\"י",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דהאידנא נהגו להשביע האלמנה בב\"ד דבאותו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ענין שאנו רגילין להשביעה שהיו גוזרין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עליה בחרם ובשבועה שתודה על מה שקבלה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בכתובתה אין העונש מרובה כ\"כ כמו היכא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבשעת שבועה יוצאה שבועה מפיה לשקר דהוי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כעין שבועת שוא דכתיב לא ינקה ולענין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שכנגדו חשוד על השבועה תנא בפרק כל",
