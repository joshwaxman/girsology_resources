      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Gittin 35a:8\" data-ror-ocr=\"לרבנן בקללת ארור ולא נקיט ביליה מילי\">נקיט מידי</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Gittin 35a:8\" data-ror-ocr=\"ואיו עונשה כל כך: לא מגכה כתובתה. משוס\">ואין עונשה כל כך: לא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Gittin 35a:8\" data-ror-ocr=\"ואיו עונשה כל כך: לא מגכה כתובתה. משוס\">מגבי כתובה - משום</i> <i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Gittin 35a:8\" data-ror-ocr=\"לנמנעו מלהשביעה ולא רצה להשביעה תוץ\"><i class=\"ror-printed-only\" data-ror-ocr=\"ולא רצה להשביעה\" data-ror-chars=\"10\">°</i> דנמנעו</i>"
