  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "גבי מתנה דזכות הוא לה זכין לו לאדם שלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפניו: אפילו [היא] עמו במטה אינה",
      "segment_ids": [
