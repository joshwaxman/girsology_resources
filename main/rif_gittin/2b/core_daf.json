      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Gittin 8b:11\" data-ror-ocr=\"ולאחנופי ליה קא אחי ולא לשחרריה טון דלא\">שחרריה כיון דלא</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Gittin 8b:11\" data-ror-ocr=\"א״ל עצמך ונכסי: לעולם הוא בן חורין. (נ) ומאי\">אמר ליה עצמך ונכסיי:</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Gittin 8b:11\" data-ror-ocr=\"א״ל עצמך ונכסי: לעולם הוא בן חורין. (נ) ומאי\">לעולם הוא בן חורין - דמאי</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Gittin 9a:1\" data-ror-ocr=\"דגלי גלי ומאי דלא גלי לא גלי: עד שיאמר\">דגלי גלי</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Gittin 9a:1\" data-ror-ocr=\"דגלי גלי ומאי דלא גלי לא גלי: עד שיאמר\">ומאי דלא גלי לא גלי: עד שיאמר - סתם</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Gittin 9a:1\" data-ror-ocr=\"להמס (ג) אמר לאחל מריבוא דקאמר היינו\">דהתם אמרינן דאחד מריבוא דקאמר</i>"
      },
