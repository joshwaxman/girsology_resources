      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דכיון שרשומן ניכר לפי שעה גזרינן אטו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סיקרא וכיוצא בו ודוקא לכתחלה אבל",
      "segment_ids": [
