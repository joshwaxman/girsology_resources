      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לגבורות וחולה שרוב חולים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחיים אבל זקן שהגיע לגבורות",
      "segment_ids": [
