        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מינייהו לא משוי שליח אלא בב\"ד אמר רבא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושליח בארץ ישראל עושה כמה שלוחים פירוש",
