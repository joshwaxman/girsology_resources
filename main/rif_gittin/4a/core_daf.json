  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>גמ'</big></b> קא פסיק ותני לא שנא מכר ול\"ש <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>מתנה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשלמא מכר מכי יהיב זוזי קמייהו הוא",
