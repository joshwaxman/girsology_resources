      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רבים אע\"פ שיאמר על דעת המקום ויש להם",
      "segment_ids": [
