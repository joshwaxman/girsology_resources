      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וחרמים שהיו מטילים הקהל לא מקרי על דעת",
      "segment_ids": [
