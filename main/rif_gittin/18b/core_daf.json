      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נודרין ומתירין הם בעצמם ומההיא דצריך",
      "segment_ids": [
