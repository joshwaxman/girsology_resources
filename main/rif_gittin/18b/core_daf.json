  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב מיי' שאם נישאת קודם שתשבע הרי זו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נשבעת אחר הנשואין ונוטלת כל זמן שתרצה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל אינה נודרת ונוטלת שמא יפר הבעל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכתב סמ\"ג על שם ר\"י כי נדר על דעת רבים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יועיל בזה וטור כתב אבל אם נישאת אינה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גובה בנדרה שהבעל יפר לה אפי' נדרה על",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דעת רבים ואפי' נתן לה בעלה רשות שתדור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על דעת ב\"ד יכול לחזור ממה שהרשה ויפר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לה: <b>ב</b> כתב הטור נדר על דעת חבירו אין לו",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התרה אלא מדעת אותו שנדר על דעתו ודוקא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנדר על דעתו בשביל שום טובה שעשה לו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמו משה שנדר על דעת יתרו בשביל שהשיא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו בתו אבל אם מעצמו נדר על דעת חבירו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יכולין להתיר לו בלא דעתו ואפי' נדר על",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דעתו בשביל טובה שעשה לו אם בדיעבד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התירו בלא דעתו הויא התרה ומיי' לא חלק",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שכתב ראובן שהשביע לשמעון וענה אמן אין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתירין לשמעון אלא בפני ראובן [וכן אם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נשבע ראובן או נדר שלא יהנה ממנו שמעון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וניחם ונשאל לחכם אין מתירין לו אלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בפני שמעון] ואפי' אם היה שמעון קטן או",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עובד כוכבים כדי שידע הנדור שהתיר זה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נדרו ולכך יהנה לו: <b>ג</b> כתב הטור ואין",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נקרא רבים פחות מג' וכגון שיפרוט אותם",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על דעת פלוני ופלוני ופלוני אבל אם אומר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בכלל על דעת רבים יש לו התרה וכתב סמ\"ג",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשם ר\"ת שאם נדר בפני ג' אפי' לא פרט",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותן רבים שעומדין לפניו קאמר ונדר שנדר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מעצמו על דעת שנים יש לו התרה אפי' בלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דעתם ונדר שהודר ברבים יש לו התרה",
      "segment_ids": [
