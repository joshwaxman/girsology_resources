      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמתחרט ומתיר לו: <b>ד</b> וכ\"כ מיי' חתמו בו",
