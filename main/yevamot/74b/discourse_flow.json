l,"skel":[0,67],"head":"וְתוּ, הָא","text":"וְתוּ, הָא דִּתְנַן: טָבַל וְעָלָה — אוֹכֵל בַּמַּעֲשֵׂר, הֶעֱרִיב שִׁמְשׁוֹ — אוֹכֵל בַּתְּרוּמָה, הֵבִיא כַּפָּרָה — אוֹכֵל בַּקֳּדָשִׁים, מְנָא לַן?"},{"id":15,"seg":7,"role":"probe.question","conf":"high","src":"english+biur","speaker":null,"skel":[0,9],"head":"וְאֵיפוֹךְ אֲנָא?","text":"וְאֵיפוֹךְ אֲנָא?"},{"id":16,"seg":7,"role":"respond.answer","conf":"high","src":"english+biur","speaker":null,"skel":[9,32],"head":"מִסְתַּבְּרָא תְּרוּמָה","text":"מִסְתַּבְּרָא תְּרוּמָה עֲדִיפָא, שֶׁכֵּן מחפ״ז."},{"id":17,"seg":8,"role":"probe.question","conf":"med","src":"biur","speaker":null,"skel":[0,22],"head":"אַדְּרַבָּה: מֵעֶשֶׂר","text":"אַדְּרַבָּה: מֵעֶשֶׂר עֲדִיפָא, שֶׁכֵּן הֲדַ״ס טָ״ב?"},{"id":18,"seg":9,"role":"respond.answer","conf":"high","src":"english+biur","speaker":null,"skel":[0,17],"head":"אֲפִילּוּ הָכִי,","text":"אֲפִילּוּ הָכִי, מִיתָה עֲדִיפָא."},{"id":21,"seg":11,"role":"probe.attack.difficulty","conf":"high","src":"english+biur","speaker":null,"skel":[0,52],"head":"וְאַכַּתִּי, הָנֵי","text":"וְאַכַּתִּי, הָנֵי מִילֵּי הֵיכָא דְּלָאו בַּר כַּפָּרָה, אֲבָל הֵיכָא דְּבַר כַּפָּרָה — עַד דְּמַיְיתֵי כַּפָּרָה!"},{"id":27,"seg":13,"role":"probe.question","conf":"high","src":"english+biur","speaker":null,"skel":[0,9],"head":"וְאֵיפוֹךְ אֲנָא!","text":"וְאֵיפוֹךְ אֲנָא!"},{"id":28,"seg":13,"role":"respond.answer","conf":"med","src":"biur","speaker":null,"skel":[9,31],"head":"מִסְתַּבְּרָא קֹדֶשׁ","text":"מִסְתַּבְּרָא קֹדֶשׁ חָמוּר, שֶׁכֵּן פנקעכ״ס."},{"id":29,"seg":14,"role":"probe.attack","conf":"high","src":"english+biur","speaker":null,"skel":[0,22],"head":"אַדְּרַבָּה תְּרוּמָה","text":"אַדְּרַבָּה תְּרוּמָה חֲמוּרָה, שֶׁכֵּן מחפ״ז?"},{"id":30,"seg":14,"role":"respond.answer","conf":"high","src":"english","speaker":null,"skel":[22,30],"head":"הָנָךְ נְפִישָׁן!","text":"הָנָךְ נְפִישָׁן!"},{"id":31,"seg":15,"role":"respond.answer","conf":"med","src":"biur","speaker":null,"skel":[0,62],"head":"רָבָא אָמַר:",