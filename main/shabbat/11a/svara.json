    }
   ]
  },
  "7": {
   "segId": "Shabbat.11a.8",
   "sugya": "shabbat_11a_mafsikin_likrishma",
   "marks": [
    {
     "type": "support",
     "object": "s_detanya_chaverim",
     "kind": "tanya_kevatei",
     "gloss_en": "דתניא: חברים שהיו עוסקין בתורה מפסיקין לקריאת שמע ואין מפסיקין לתפלה (kind tanya_kevatei: no kind names a bare דתניא)",
     "supports": "p_seifa_divrei_torah",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_hitchilu_ein_mafsikin",
     "gloss_en": "and if they began, they do not interrupt"
    }
   ]
  },
  "8": {
   "segId": "Shabbat.11a.9",
   "sugya": "shabbat_11a_mafsikin_likrishma",
   "marks": [
    {
     "type": "support",
     "object": "s_deamar_rav_adda_ibur",
     "kind": "tanya_kevatei",
     "gloss_en": "דאמר רב אדא בר אהבה, וכן תנו סבי דהגרוניא, אמר רבי אלעזר בר צדוק: כשהיינו עוסקין בעיבור השנה ביבנה לא היינו מפסיקין לא לקריאת שמע ולא לתפלה",
     "supports": "p_okimta_ibur_hashana",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_vehatanya_kesheim",
     "kind": "tanya",
     "gloss_en": "והתניא: כשם שאין מפסיקין לתפלה כך אין מפסיקין לקריאת שמע! -- but a baraita teaches they do not interrupt for the Shema either",
     "against": "p_baraita_chaverim",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_beibur_shana",
     "gloss_en": "כי תני ההיא -- בעיבור שנה (= p_okimta_ibur_hashana)",
     "answers": "obj_vehatanya_kesheim",
     "restores": "p_baraita_chaverim"
    },
    {
     "type": "proposition",
     "object": "p_baraita_kesheim",
     "gloss_en": "just as they do not interrupt for prayer, so they do not interrupt for the recitation of the Shema"
    }
   ]
  },
  "10": {
   "segId": "Shabbat.11a.11",
   "sugya": "shabbat_11a_shoteh_bekarmelit",
   "marks": [
    {
     "type": "proposition",
     "object": "p_lo_yaamod_veyishte",
     "gloss_en": "a person may not stand in the private domain and drink in the public domain, nor stand in the public domain and drink in the private domain"
    }
   ]
  },
  "6": {
   "segId": "Shabbat.11a.7",
