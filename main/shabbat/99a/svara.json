     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_ama_yeteira",
     "gloss_en": "אמתא יתירא הואי דהוה קאי בן לוי -- an extra cubit where a Levite stood to catch slipping beams (= p_ama_yeteira_ben_levi)",
     "answers": "obj_mishkan_chameisre",
     "restores": "p_derech_rhr_mimishkan"
    },
    {
     "type": "proposition",
     "object": "p_derech_rhr_shesh_esre",
     "gloss_en": "we hold that a public-domain road is sixteen cubits [wide]"
    }
   ]
  },
