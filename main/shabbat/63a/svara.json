  "8": {
   "segId": "Shabbat.63a.9",
   "sugya": "shabbat_63a_klei_zayin_limot_hamashiach",
   "marks": [
    {
     "type": "support",
     "object": "s_shenemar_lo_yisa_goi",
     "kind": "svara",
     "gloss_en": "שנאמר: לא ישא גוי אל גוי חרב -- R' Eliezer's own derivation (Isa 2:4), as the baraita reports it",
     "supports": "p_einan_tzrichin",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_amru_lo_v1",
     "kind": "svara",
     "gloss_en": "וכי מאחר דתכשיטין הן לו, מפני מה הן בטלין לימות המשיח? -- if they are ornaments, why will they cease in the days of the Messiah? (as the baraita reports it)",
     "against": "p_tachshit_klei_zayin",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_lefi_sheeinan_tzrichin",
     "gloss_en": "לפי שאינן צריכין, שנאמר לא ישא גוי אל גוי חרב -- they cease because they will not be needed (= p_einan_tzrichin)",
     "answers": "obj_amru_lo_v1",
     "restores": "p_tachshit_klei_zayin"
    },
    {
     "type": "objection",
     "object": "obj_tehevei_lenoi",
     "kind": "svara",
     "gloss_en": "ותהוי לנוי בעלמא! -- though not needed for war, let them remain merely as ornament",
     "against": "p_einan_tzrichin",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_shraga_betihara",
     "gloss_en": "מידי דהוה אשרגא בטיהרא -- like a lamp at noon (= p_shraga_betihara)",
     "answers": "obj_tehevei_lenoi",
     "restores": "p_einan_tzrichin"
    },
    {
     "type": "proposition",
     "object": "p_tachshit_klei_zayin",
     "gloss_en": "R' Eliezer: weapons are ornaments for him"
    }
   ]
  },
  "9": {
   "segId": "Shabbat.63a.10",
   "sugya": "shabbat_63a_klei_zayin_limot_hamashiach",
   "marks": [
    {
     "type": "support",
     "object": "s_shenemar_lo_yechdal_evyon",
     "kind": "svara",
     "gloss_en": "שנאמר: כי לא יחדל אביון מקרב הארץ -- Shmuel's own derivation (Deut 15:11)",
