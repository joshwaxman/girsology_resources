     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_amru_lo_v2",
     "kind": "svara",
     "gloss_en": "ואיכא דאמרי: אמרו לו לרבי אליעזר: וכי מאחר דתכשיטין הן לו, מפני מה הן בטלין לימות המשיח?",
     "against": "p_tachshit_klei_zayin",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_af_limot_hamashiach",
     "gloss_en": "אף לימות המשיח אינן בטלין -- even in the days of the Messiah they do not cease (= p_einan_betelin)",
     "answers": "obj_amru_lo_v2",
     "restores": "p_tachshit_klei_zayin"
    },
