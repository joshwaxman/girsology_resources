","text":"אַרֵישָׁא קָאֵי: וּבֵית הִלֵּל מַתִּירִין בֵּין חַמִּין לְתוֹךְ צוֹנֵן וּבֵין צוֹנֵן לְתוֹךְ הַחַמִּין, וְרַבִּי שִׁמְעוֹן בֶּן מְנַסְיָא אוֹסֵר צוֹנֵן לְתוֹךְ חַמִּין.","source":[{"kind":"tannaitic","cue":"ששנינו"}]},{"seg":7,"from":0,"to":84,"head":"הָאִילְפָּס וְהַקְּדֵרָה","text":"הָאִילְפָּס וְהַקְּדֵרָה שֶׁהֶעֱבִירָן מְרוּתָּחִין — לֹא יִתֵּן לְתוֹכָן תַּבְלִין.","source":[{"kind":"mishna","cue":"במשנה"}]}],"tosafot":[{"role":"probe","conf":"high","raw":"Question","spans":[{"from":17,"to":119,"head":"ואם תאמר"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.42a.t1.s1"},{"role":"respond.answer","conf":"high","raw":"Answer","spans":[{"from":120,"to":250,"head":"וי\"ל דס\"ד"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.42a.t1.s2"},{"role":"assert.interpretation","conf":"med","raw":"Explanation","spans":[{"from":369,"to":477,"head":"ומיהו לפי"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.42a.t1.s4"},{"role":"assert.interpretation","conf":"med","raw":"Explanation (Rashba)","spans":[{"from":755,"to":916,"head":"והשתא אומר"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.42a.t1.s8"},{"role":"probe","conf":"high","raw":"Question","spans":[{"from":955,"to":1030,"head":"אך הקשה"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.42a.t1.s10"},{"role":"assert.interpretation","conf":"med","raw":"Explanation","spans":[{"from":1192,"to":1243,"head":"אפי' בכלי"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.42a.t2.s1"},{"role":"assert.suggestion","conf":"high","raw":"Suggestion","spans":[{"from":1405,"to":1439,"head":"ולא משום"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.42a.t2.s4"},{"role":"probe.attack.rejection","conf":"high","raw":"Rejection #1 (Rashi)","spans":[{"from":1440,"to":1486,"head":"כדפירש בקונטרס"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.42a.t2.s5"},{"role":"probe.attack.rejection","conf":"high","raw":"Rejection #2","spans":[{"from":1487,"to":1548,"head":"ולמאן דאמר