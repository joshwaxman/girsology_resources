    {
     "type": "objection",
     "object": "obj_ravina_chamra",
     "kind": "svara",
     "gloss_en": "לא סבר לה מר להא דאמר רבא: הני בני מחוזא כיון דמפנקי אפילו חמרא נמי מסי להו? ומר נמי הא מפנק! (in the איכא דאמרי version)",
     "against": "p_ra_tzamit_bechamra",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_gav_shani_chamra",
     "gloss_en": "גב היד וגב הרגל שאני (= p_ra_gav_shani), with Rav's ruling adduced",
     "answers": "obj_ravina_chamra",
     "restores": "p_ra_tzamit_bechamra"
    },
    {
     "type": "proposition",
     "object": "p_ra_tzamit_bechamra",
     "gloss_en": "Rav Ashi, by practice (the איכא דאמרי version): he was soaking it in wine"
    }
   ]
