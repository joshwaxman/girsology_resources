  "tosafot": [
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>בְּאַוּוֹנָא דְמַיָּא.</b> אמבטי של",
      "source_ref": "Tosafot on Shabbat 157b:2:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "180px",
      "right": "70px",
      "left": "",
      "text": "מים וכך פירש בערוך:",
      "source_ref": "Tosafot on Shabbat 157b:2:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "<big><b>מְדִידָה דְמִצְוָה, דְּלָאו <span class=\"dh-divergent\">דמצוה</span> מִי</b>",
      "source_ref": "Tosafot on Shabbat 157b:2:2",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "190px",
      "right": "60px",
      "left": "",
      "text": "<b>אֲמוּר? <span class=\"dh-divergent\">כו&#x27;</span>.</b> בפקיקה לא",
      "source_ref": "Tosafot on Shabbat 157b:2:2",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "בעינן של מצוה כדפירש' לעיל",
      "source_ref": "Tosafot on Shabbat 157b:2:2",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "בשילהי כל הכלים (<a href=\"/shabbat/126b\">שבת דף קכו:</a>) אלא",
      "source_ref": "Tosafot on Shabbat 157b:2:2",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "0px",
      "left": "",
      "text": "דווקא במדידה בעינן של מצוה:",
      "source_ref": "Tosafot on Shabbat 157b:2:2",
      "gemara_segment_ids": [
        0
      ]
    }
  ],
