 "sentences": {
  "0": {
   "segId": "Shabbat.7a.1",
   "sugya": "shabbat_6b_bikah_karmelit",
   "marks": [
    {
     "type": "support",
     "object": "s_kiha_karpef",
     "kind": "svara",
     "gloss_en": "וכי הא דאמר עולא אמר רבי יוחנן: קרפף יותר מבית סאתים שלא הוקף לדירה ... הזורק לתוכו חייב",
     "supports": "p_rav_ashi_deit_la_mechitzot",
     "status": "live"
    },
    {
     "type": "objection_answer",
     "object": "ans_rav_ashi_mechitzot",
     "gloss_en": "כגון דאית לה מחיצות (= p_rav_ashi_deit_la_mechitzot)",
     "answers": "obj_vehatnan_bikah",
     "restores": "p_tosefta_bikah_karmelit"
    },
    {
     "type": "proposition",
     "object": "p_rav_ashi_deit_la_mechitzot",
     "gloss_en": "Rav Ashi: [the mishna speaks of a valley] such as has partitions"
    }
   ]
  },
  "1": {
   "segId": "Shabbat.7a.2",
   "sugya": "shabbat_6b_bikah_karmelit",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ulla_karpef_hi",
     "gloss_en": "Ulla [would say]: if it has partitions, would it be called a valley? it is an enclosure!"
    }
   ]
  },
  "4": {
   "segId": "Shabbat.7a.5",
   "sugya": "shabbat_7a_karmelit_gedarim",
   "marks": [
    {
     "type": "schema",
     "object": "kv_itztaba_mibein_haamudim",
     "kind": "kal_vachomer",
     "status": "stands",
     "gloss_en": "למאן דאמר בין העמודים, כל שכן איצטבא -- if between the pillars is a karmelit, the bench all the more"
    },
    {
     "type": "proposition",
     "object": "p_itztaba_taam",
     "gloss_en": "[for the one who said the bench:] it is the bench whose use is inconvenient"
    }
   ]
  },
  "8": {
   "segId": "Shabbat.7a.9",
   "sugya": "shabbat_7a_karmelit_gedarim",
   "marks": [
    {
     "type": "support",
     "object": "s_kiha_shmuel",
     "kind": "svara",
     "gloss_en": "וכי הא דאמר ליה שמואל לרב יהודה: שיננא, לא תיהוי במילי דשבתא למעלה מעשרה",
     "supports": "p_tofeset_ad_asara",
     "status": "live"
    },
    {
     "type": "elimination",
     "object": "e_rav_chisda_kaneh",
     "gloss_en": "והאמר רב חסדא: נעץ קנה ברשות היחיד ... אפילו גבוה מאה אמה חייב, מפני שרשות היחיד עולה עד לרקיע (p_rav_chisda_kaneh, p_ry_ola_ad_larakia)",
     "eliminates": "p_shmuel_ein_ry_lemala",
     "frame": "f_shmuel_lemai_hilcheta",
     "live": true,
     "aliba": null
    },
    {
     "type": "proposition",
     "object": "p_tofeset_ad_asara",
     "gloss_en": "rather: up to ten it is a karmelit; above ten handbreadths it is not a karmelit"
    }
   ]
  },
  "7": {
   "segId": "Shabbat.7a.8",
   "sugya": "shabbat_7a_karmelit_gedarim",
   "marks": [
    {
     "type": "elimination",
     "object": "e_rav_bayit",
     "gloss_en": "ולא? והאמר רב גידל אמר רב חייא בר יוסף אמר רב: בית שאין בתוכו עשרה ... בתוכו אין מטלטלין בו אלא ארבע אמות (p_rav_bayit_betocho) -- an area under ten without a ten-high partition is a karmelit",
     "eliminates": "p_tofeset_mechitza_asara",
     "frame": "f_mai_tofeset_ad_asara",
     "live": true,
     "aliba": null
    },
    {
     "type": "proposition",
     "object": "p_ein_karmelit_pechuta_mearbaa",
     "gloss_en": "there is no karmelit less than four [handbreadths]"
    }
   ]
  },
  "2": {
   "segId": "Shabbat.7a.3",
   "sugya": "shabbat_7a_karmelit_gedarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_tosefta_vehakarmelit",
     "gloss_en": "[the Tosefta lists] 'and the karmelit' among the places that are neither private nor public domain"
    }
   ]
  },
  "3": {
   "segId": "Shabbat.7a.4",
   "sugya": "shabbat_7a_karmelit_gedarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_bein_haamudim_karmelit",
     "gloss_en": "between the pillars is judged as a karmelit"
    }
   ]
  },
  "5": {
   "segId": "Shabbat.7a.6",
   "sugya": "shabbat_7a_karmelit_gedarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_levena_tach_bifaneha",
     "gloss_en": "an upright brick in the public domain: he threw and [the object] stuck to its face -- liable"
    }
   ]
  },
  "6": {
   "segId": "Shabbat.7a.7",
   "sugya": "shabbat_7a_karmelit_gedarim",
   "marks": [
    {
     "type": "proposition",
     "object": "p_levena_gvoha_shlosha",
     "gloss_en": "Abaye and Rava: provided it is three [handbreadths] high"
    }
   ]
