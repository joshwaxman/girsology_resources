   "marks": [
    {
     "type": "objection",
     "object": "obj_merubaot_hlmm",
     "kind": "tanya",
     "gloss_en": "הא נמי הלכה למשה מסיני הוא, דתניא: תפילין מרובעות הלכה למשה מסיני, נכרכות בשערן ונתפרות בגידן",
     "against": "p_ok_sear_gid",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_ok_sear_gid",
     "gloss_en": "rather: for binding them with their hair and sewing them with their sinews"
    }
   ]
  },
