     "object": "obj_abaye_shin",
     "kind": "svara",
     "gloss_en": "והאמר אביי: שי\"ן של תפילין הלכה למשה מסיני (kind svara: the corpus's gap for והאמר)",
     "against": "p_ok_oran",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_ok_oran",
     "gloss_en": "rather: for their leather [of the tefillin]"
    }
   ]
  },
  "3": {
