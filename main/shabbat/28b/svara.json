 "sentences": {
  "0": {
   "segId": "Shabbat.28b.1",
   "sugya": "shabbat_28a_or_behema_temea",
   "marks": [
    {
     "type": "schema",
     "object": "kv_notza_shel_izim",
     "kind": "kal_vachomer",
     "status": "stands",
     "gloss_en": "אתיא בקל וחומר מנוצה של עזים: goats' hair, not impure with negaim, is impure in a corpse-tent; the non-kosher hide, impure with negaim -- is it not right that it be impure in a corpse-tent?"
    }
   ]
  },
  "6": {
   "segId": "Shabbat.28b.7",
   "sugya": "shabbat_28a_or_behema_temea",
   "marks": [
    {
     "type": "support",
     "object": "s_dika_keren_achat",
     "kind": "dika_nami",
     "gloss_en": "מדקאמר קרן אחת היתה לו במצחו, שמע מינה טהור היה",
     "supports": "p_tachash_tahor_haya",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_derav_yehuda_shor",
     "kind": "svara",
     "gloss_en": "דאמר רב יהודה: שור שהקריב אדם הראשון קרן אחת היתה לו במצחו -- a one-horned creature offered on the altar",
     "supports": "p_tachash_tahor_haya",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_shenaemar_makrin",
     "kind": "svara",
     "gloss_en": "שנאמר ותיטב לה' משור פר מקרין מפריס -- Rav Yehuda's own verse",
     "supports": "p_shor_adam_keren_achat",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_makrin_tartei",
     "kind": "svara",
     "gloss_en": "מקרין תרתי משמע! -- 'makrin' implies two horns",
     "against": "p_makrin_verse",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_makren_ktiv",
     "gloss_en": "מקרן כתיב -- it is written [defectively] makren",
     "answers": "obj_makrin_tartei",
     "restores": "p_makrin_verse"
    },
    {
     "type": "proposition",
     "object": "p_tachash_tahor_haya",
     "gloss_en": "since he said it had one horn on its forehead, conclude that it was pure"
    }
   ]
  },
  "1": {
   "segId": "Shabbat.28b.2",
   "sugya": "shabbat_28a_or_behema_temea",
   "marks": [
    {
     "type": "objection",
     "object": "obj_tefillin_behedya",
     "kind": "svara",
     "gloss_en": "תפילין בהדיא כתיב בהו: למען תהיה תורת ה' בפיך -- מן המותר בפיך (kind svara: no kind names 'it is written explicitly')",
     "against": "p_ok_tefillin",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_ok_tefillin",
     "gloss_en": "for what law is Rav Yosef's teaching? for tefillin"
    }
   ]
  },
  "2": {
