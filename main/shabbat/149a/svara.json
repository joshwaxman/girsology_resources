     "gloss_en": "וכדרב נחמן אמר רבה בר אבוה: מפני מה אמרו מראה של מתכת אסורה -- מפני שאדם עשוי להשיר בה נימין המדולדלין",
     "supports": "p_marah_shel_matechet_okimta",
     "status": "live"
    },
    {
     "type": "objection_answer",
     "object": "a_marah_shel_matechet",
