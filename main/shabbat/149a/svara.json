  "3": {
   "segId": "Shabbat.149a.4",
   "sugya": "shabbat_149a_mone_min_haktav",
   "marks": [
    {
     "type": "proposition",
     "object": "p_nm_kotel_mitatei",
     "gloss_en": "rather, the difference: writing on a wall, low -- on 'lest he erase' we are concerned, on 'lest he read' not: a wall is not mistaken for a document"
