     "gloss_en": "מאי שנא הקבועה בכותל -- דאדהכי והכי מידכר, שאינו קבוע נמי אדהכי והכי מידכר!",
     "against": "p_r_meir_marah_kvua",
     "state": "answered"
    }
   ]
  },
  "6": {
   "segId": "Shabbat.149a.7",
   "sugya": "shabbat_149a_mone_min_haktav",
   "marks": [
    {
     "type": "elimination",
     "object": "e_mai_shna_hacha",
     "gloss_en": "מאי שנא הכא ומאי שנא הכא -- [in ink] there is no difference between wall and tablet",
     "eliminates": "p_baraita_tavla_bidyo",
     "frame": "f_baraita_kotel_tavla",
     "live": true,
     "aliba": null
    },
    {
     "type": "proposition",
     "object": "p_baraita_tavla_chakuk",
     "gloss_en": "is it not engraved [writing], and it teaches: from writing on the wall but not from writing on a tablet or board"
    }
   ]
  },
  "8": {
   "segId": "Shabbat.149a.9",
   "sugya": "shabbat_149a_mone_min_haktav",
   "marks": [
    {
     "type": "elimination",
     "object": "e_lichush_shema_yimchok",
     "gloss_en": "ליחוש שמא ימחוק! -- low writing could be erased, so R' Acha would not permit it",
