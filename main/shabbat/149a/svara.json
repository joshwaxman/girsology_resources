     "status": "live"
    },
    {
     "type": "objection_answer",
     "object": "a_rabba_tannaei",
     "gloss_en": "אלא לעולם דכתיב אכותל ומידלי, ודקא קשיא לך דרבה -- דרבה תנאי היא (= p_rabba_tannaei)",
     "answers": "obj_kotel_midalei",
     "restores": "p_nm_kotel_midalei"
    },
    {
     "type": "proposition",
     "object": "p_rabba_tannaei",
     "gloss_en": "Rabba's [dictum] is a tannaitic dispute"
    }
   ]
  },
  "9": {
