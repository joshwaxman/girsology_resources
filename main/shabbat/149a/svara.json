     "kind": "dika_nami",
     "gloss_en": "עם בניו ועם בני ביתו אין -- ועם אחר לא",
     "supports": "p_im_acher_lo",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_kidrav_yehuda_shmuel",
     "kind": "svara",
     "gloss_en": "מאי טעמא? כדרב יהודה אמר שמואל: בני חבורה המקפידין זה על זה עוברין משום מדה ומשום משקל ומשום מנין ומשום לווין ופורעין ביום טוב",
     "supports": "p_im_acher_lo",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_im_acher_lo",
     "gloss_en": "with his children and his household, yes; with another, no"
    }
   ]
  },
  "7": {
