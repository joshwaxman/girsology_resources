    {
     "type": "objection_answer",
     "object": "ans_kama_deefshar",
     "gloss_en": "כמה דאפשר לשנויי משנינן",
     "answers": "obj_ini_tdry",
     "restores": "p_lo_bemarde_ela_besakin"
    },
    {
     "type": "proposition",
     "object": "p_shachach_pat_shalosh_seudot",
     "gloss_en": "the baraita: [if] he forgot bread in the oven and the day was sanctified over it, one rescues food for three meals"
