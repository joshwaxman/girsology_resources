   "marks": [
    {
     "type": "support",
     "object": "s_shene_emar_im_ein_lecha",
     "kind": "svara",
     "gloss_en": "שנאמר: אם אין לך לשלם למה יקח משכבך מתחתיך -- the 'bed' taken is his wife",
     "supports": "p_nedarim_ishto",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_shene_emar_al_titen",
     "kind": "svara",
     "gloss_en": "שנאמר: אל תתן את פיך... וחבל את מעשה ידיך",
     "supports": "p_nedarim_banim",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_maaseh_yadav_banav",
     "kind": "svara",
     "gloss_en": "איזה הן מעשה ידיו של אדם? הוי אומר בניו ובנותיו -- 'the work of your hands' that is destroyed is the children",
     "supports": "p_nedarim_banim",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_nedarim_ishto",
     "gloss_en": "R' Natan: for the sin of vows a man's wife dies"
    }
   ]
  },
  "2": {
   "segId": "Shabbat.32b.3",
   "sugya": "shabbat_32a_baavon_metim",
   "marks": [
    {
     "type": "support",
     "object": "s_kedaamran",
     "kind": "svara",
     "gloss_en": "בשלמא למאן דאמר בעון נדרים -- כדאמרן: the vows position has the verse cited above (Eccl 5:5)",
     "supports": "p_nedarim_banim",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_mai_kraa_bitul_torah",
     "kind": "svara",
     "gloss_en": "אלא למאן דאמר בעון ביטול תורה מאי קראה? דכתיב: לשוא הכיתי את בניכם מוסר לא לקחו",
     "supports": "p_bitul_torah_banim",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_rnby_lashav",
     "kind": "svara",
     "gloss_en": "למאן דאמר בעון נדרים נמי מהכא: לשוא הכיתי את בניכם -- על עסקי שוא",
     "supports": "p_nedarim_banim",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_rebbi_nedarim_kaamar",
     "kind": "tanya",
     "gloss_en": "מכדי רבי יהודה הנשיא היינו רבי, ורבי בעון נדרים קאמר?! -- R' Yehuda HaNasi is Rebbi, and Rebbi (in the 32b.2 baraita) says children die for vows",
     "against": "p_bitul_torah_banim",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_batar_dishmaah",
     "gloss_en": "בתר דשמעה מרבי אלעזר ברבי שמעון -- he said 'vows' after he heard it from R' Elazar b'R' Shimon",
     "answers": "obj_rebbi_nedarim_kaamar",
     "restores": "p_bitul_torah_banim"
    },
    {
     "type": "proposition",
     "object": "p_bitul_torah_banim",
     "gloss_en": "for the sin of neglecting Torah [children die]"
    }
   ]
  },
