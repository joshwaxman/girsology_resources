    }
   ]
  },
  "15": {
   "segId": "Shabbat.59b.16",
   "sugya": "shabbat_59b_tabaat_chotam",
   "marks": [
    {
     "type": "support",
     "object": "s_ha_yesh_chotam",
     "kind": "svara",
     "gloss_en": "הא יש עליה חותם -- חייבת: the mishna exempts [only] a ring with no seal, so one with a seal makes her liable",
     "supports": "p_yesh_chotam_chayevet",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_alma_lav_tachshit",
     "kind": "svara",
     "gloss_en": "אלמא לאו תכשיט הוא -- since she is liable, it is not an ornament",
     "supports": "p_tabaat_chotam_lav_tachshit",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_isha_tabaat_bli_chotam",
     "gloss_en": "[a woman may not go out] with a ring that has no seal on it"
    }
   ]
  },
  "18": {
   "segId": "Shabbat.59b.19",
   "sugya": "shabbat_59b_tabaat_chotam",
   "marks": [
    {
     "type": "support",
     "object": "s_tanya_r_nechemya_chotam",
     "kind": "tanya_kevatei",
     "gloss_en": "דתניא... שהיה רבי נחמיה אומר: בטבעת הלך אחר חותמה (kind tanya_kevatei: no kind names a bare דתניא)",
     "supports": "p_matnitin_r_nechemya",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_matechet_chotam_almog_tmea",
     "gloss_en": "[a ring] of metal whose seal is of coral is impure"
    }
   ]
  },
  "16": {
   "segId": "Shabbat.59b.17",
   "sugya": "shabbat_59b_tabaat_chotam",
   "marks": [
    {
     "type": "objection",
     "object": "obj_rominhu_tachshitei_nashim",
     "kind": "tnan",
     "gloss_en": "ורמינהו: תכשיטי נשים טמאים... וטבעת בין שיש עליה חותם בין שאין עליה חותם -- there a ring even with a seal is a woman's ornament",
     "against": "p_tabaat_chotam_lav_tachshit",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_tachshitei_nashim_tmeim",
     "gloss_en": "women's ornaments are [susceptible to] impurity"
    }
   ]
  },
  "17": {
   "segId": "Shabbat.59b.18",
   "sugya": "shabbat_59b_tabaat_chotam",
   "marks": [
    {
     "type": "objection_answer",
     "object": "ans_r_zeira_tannaim",
     "gloss_en": "לא קשיא: הא רבי נחמיה, הא רבנן -- our mishna is R' Nechemya's, the Kelim mishna the Rabbis' (= p_matnitin_r_nechemya, p_kelim_rabanan)",
     "answers": "obj_rominhu_tachshitei_nashim",
     "restores": "p_tabaat_chotam_lav_tachshit"
    },
    {
     "type": "proposition",
     "object": "p_matnitin_r_nechemya",
     "gloss_en": "R' Zeira: this [our mishna] is R' Nechemya"
    }
   ]
  }
 }
}