   "sugya": "shabbat_63b_birit_etzada",
   "marks": [
    {
     "type": "support_deflection",
     "object": "defl_mai_maaseh_kaaved",
     "gloss_en": "בשלמא התם קא בעו לה לקלא וקעביד מעשה, הכא מאי מעשה קעביד? -- there the sound is wanted and does something; here the chain does nothing",
