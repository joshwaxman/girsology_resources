     "status": "live"
    },
    {
     "type": "support",
     "object": "s_kihai_rav_sheshet",
     "kind": "svara",
     "gloss_en": "רב ששת רמי לה לאמתיה מונינא ארישא",
     "supports": "p_lemirma_eimta",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_kihai_r_abba",
