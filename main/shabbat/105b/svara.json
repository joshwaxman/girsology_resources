     "gloss_en": "רבי אבא תבר נכתמא",
     "supports": "p_lemirma_eimta",
     "status": "live"
    },
    {
     "type": "objection_answer",
     "object": "ans_lemirma_eimta",
     "gloss_en": "לא צריכא, דקא עביד למירמא אימתא אאינשי ביתיה -- where he does it to cast fear on his household (= p_lemirma_eimta)",
     "answers": "obj_mi_shrei",
     "restores": "p_avin_metaken"
    },
    {
     "type": "proposition",
     "object": "p_lemirma_eimta",
     "gloss_en": "it is needed only where he does it to cast fear on his household"
    }
   ]
  },
