    {
     "type": "objection",
     "object": "obj_tnan_kamea_sheino_mumche",
     "kind": "tnan",
     "gloss_en": "והא אנן תנן: ולא בקמיע שאינו מומחה -- הא מומחה, שפיר דמי! -- the mishna implies that a proven amulet is fine",
     "against": "p_lo_bekamea_af_mumche",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_hacha_nami_sheino_mumche",
     "gloss_en": "הכא נמי שאינו מומחה (= p_okimta_sheino_mumche)",
     "answers": "obj_tnan_kamea_sheino_mumche",
     "restores": "p_lo_bekamea_af_mumche"
    },
    {
     "type": "proposition",
     "object": "p_lo_bekamea_af_mumche",
     "gloss_en": "the baraita: nor [may an animal go out] with an amulet, even if it is proven"
    }
   ]
  },
  "2": {
   "segId": "Shabbat.53b.3",
   "sugya": "shabbat_53b_kamea_vetzaar_behema",
   "marks": [
    {
