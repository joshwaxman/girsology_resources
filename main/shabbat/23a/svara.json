 "sentences": {
  "0": {
   "segId": "Shabbat.23a.1",
   "sugya": "shabbat_22a_mener_lener",
   "marks": [
    {
     "type": "support",
     "object": "s_mideka_mevarchinan",
     "kind": "svara",
     "gloss_en": "ועוד, מדקא מברכינן אשר קדשנו במצותיו וצונו להדליק נר של חנוכה -- שמע מינה הדלקה עושה מצוה (no תא שמע or דיקא נמי marks it; kind svara)",
     "supports": "p_hadlaka_osa_mitzva",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_ashashit",
     "gloss_en": "R' Yehoshua ben Levi: a lantern that was burning all day long -- at the conclusion of Shabbat one extinguishes and relights it"
    }
   ]
  },
  "1": {
   "segId": "Shabbat.23a.2",
   "sugya": "shabbat_22a_mener_lener",
   "marks": [
    {
     "type": "support",
     "object": "s_hashta_hadlaka",
     "kind": "svara",
     "gloss_en": "והשתא דאמרינן הדלקה עושה מצוה -- a lighting by a deaf-mute, imbecile or minor is nothing",
     "supports": "p_cheresh_lo_yatza",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_rybl_nashim",
     "kind": "svara",
     "gloss_en": "דאמר רבי יהושע בן לוי: נשים חייבות בנר חנוכה, שאף הן היו באותו הנס",
     "supports": "p_isha_madlika",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_cheresh_lo_yatza",
     "gloss_en": "if a deaf-mute, an imbecile or a minor lit it, he has done nothing"
    }
   ]
  },
  "2": {
   "segId": "Shabbat.23a.3",
   "sugya": "shabbat_23a_achsenai_ner_chanuka",
   "marks": [
    {
     "type": "proposition",
     "object": "p_achsenai_chayav_ner_chanuka",
     "gloss_en": "Rav Sheshet: a lodger is obligated in the Chanuka light"
    }
   ]
  },
  "5": {
   "segId": "Shabbat.23a.6",
   "sugya": "shabbat_23a_birkat_ner_chanuka",
   "marks": [
    {
     "type": "objection",
     "object": "obj_venimot_nes",
     "kind": "svara",
     "gloss_en": "ונימעוט נס! -- then let him omit [the blessing of] the miracle instead",
     "against": "p_memaet_zman",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_nes_kol_yomei",
     "gloss_en": "נס כל יומי איתיה -- the miracle is there all the days",
     "answers": "obj_venimot_nes",
     "restores": "p_memaet_zman"
    },
    {
     "type": "proposition",
     "object": "p_madlik_tzarich_levarech",
     "gloss_en": "Rav: one who lights the Chanuka light must bless"
    }
   ]
  },
  "6": {
   "segId": "Shabbat.23a.7",
   "sugya": "shabbat_23a_birkat_ner_chanuka",
   "marks": [
    {
     "type": "objection",
     "object": "obj_heichan_tzivanu",
     "kind": "svara",
     "gloss_en": "והיכן צונו? -- and where did He command us?",
     "against": "p_nusach_ner_chanuka",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_lo_tasur",
     "gloss_en": "מלא תסור (= p_makor_lo_tasur)",
     "answers": "obj_heichan_tzivanu",
     "restores": "p_nusach_ner_chanuka"
    },
    {
     "type": "objection_answer",
     "object": "a_sheal_avicha",
     "gloss_en": "שאל אביך ויגדך זקניך ויאמרו לך (= p_makor_sheal_avicha)",
     "answers": "obj_heichan_tzivanu",
     "restores": "p_nusach_ner_chanuka"
    },
    {
     "type": "proposition",
     "object": "p_nusach_ner_chanuka",
     "gloss_en": "what does he bless? 'who has sanctified us with His commandments and commanded us to light the Chanuka light'"
    }
   ]
  },
  "7": {
   "segId": "Shabbat.23a.8",
   "sugya": "shabbat_23a_birkat_ner_chanuka",
   "marks": [
    {
     "type": "objection",
     "object": "obj_meitiv_rav_amram",
     "kind": "meitivi",
     "gloss_en": "מתיב רב עמרם: הדמאי... ומפרישין אותו ערום -- ואי אמרת כל מדרבנן בעי ברכה, הכא כי קאי ערום היכי מברך? והא בעינן והיה מחניך קדוש, וליכא (= p_beracha_machanecha_kadosh)",
     "against": "p_kol_derabanan_bei_beracha",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_abaye_vadai_safek",
     "gloss_en": "ודאי דדבריהם בעי ברכה, ספק דדבריהם לא בעי ברכה (= p_vadai_derabanan_bei_beracha, p_safek_derabanan_lo_bei_beracha)",
     "answers": "obj_meitiv_rav_amram",
     "restores": "p_kol_derabanan_bei_beracha"
    },
    {
     "type": "proposition",
     "object": "p_kol_derabanan_bei_beracha",
     "gloss_en": "every rabbinic [mitzva] requires a blessing"
    }
   ]
  },
  "8": {
   "segId": "Shabbat.23a.9",
   "sugya": "shabbat_23a_birkat_ner_chanuka",
   "marks": [
    {
     "type": "objection_answer",
     "object": "a_rava_rov_measrin",
     "gloss_en": "רוב עמי הארץ מעשרין הן (= p_rov_amei_haaretz_measrin)",
     "answers": "obj_meitiv_rav_amram",
     "restores": "p_kol_derabanan_bei_beracha"
    },
    {
     "type": "objection",
     "object": "obj_yom_tov_sheni",
     "kind": "svara",
     "gloss_en": "והא יום טוב שני דספק דבריהם הוא, ובעי ברכה!",
     "against": "p_safek_derabanan_lo_bei_beracha",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_shelo_yezalzelu",
     "gloss_en": "התם כי היכי דלא ליזלזלו בה (= p_yom_tov_sheni_shelo_yezalzelu)",
     "answers": "obj_yom_tov_sheni",
     "restores": "p_safek_derabanan_lo_bei_beracha"
    },
    {
     "type": "proposition",
     "object": "p_yom_tov_sheni_bei_beracha",
     "gloss_en": "but the second festival day is a doubtful [matter] of their words, and it requires a blessing"
    }
   ]
  },
  "10": {
   "segId": "Shabbat.23a.11",
   "sugya": "shabbat_23a_chatzer_shnei_ptachim",
   "marks": [
    {
     "type": "support",
     "object": "s_detanya_r_shimon_chashad",
     "kind": "svara",
     "gloss_en": "דתניא, אמר רבי שמעון: בשביל ארבעה דברים אמרה תורה להניח פאה בסוף שדהו... ומפני החשד",
     "supports": "p_chaishinan_lechashad",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_chaishinan_lechashad",
     "gloss_en": "we are concerned about suspicion"
    }
   ]
  },
  "9": {
