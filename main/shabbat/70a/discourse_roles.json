, ״הַדְּבָרִים״,","text":"״דְּבָרִים״, ״הַדְּבָרִים״, ״אֵלֶּה הַדְּבָרִים״ — אֵלּוּ שְׁלֹשִׁים וָתֵשַׁע מְלָאכוֹת שֶׁנֶּאֶמְרוּ לְמֹשֶׁה בְּסִינַי.","source":[{"kind":"verse","cue":"נאמר"}]},{"seg":3,"from":243,"to":330,"head":"תַּלְמוּד לוֹמַר:","text":"תַּלְמוּד לוֹמַר: ״לֹא תְבַעֲרוּ אֵשׁ״ — הַבְעָרָה בַּכְּלָל הָיְתָה, וְלָמָּה יָצָאת?","source":[{"kind":"verse","cue":"שנאמר"}]},{"seg":3,"from":330,"to":511,"head":"— לְהַקִּישׁ","text":"— לְהַקִּישׁ אֵלֶיהָ וְלוֹמַר לָךְ: מָה הַבְעָרָה שֶׁהִיא אַב מְלָאכָה וְחַיָּיבִין עָלֶיהָ בִּפְנֵי עַצְמָהּ, אַף כֹּל שֶׁהִיא אַב מְלָאכָה — חַיָּיבִין עָלֶיהָ בִּפְנֵי עַצְמָהּ.","source":[{"kind":"verse","cue":"הכתוב"}]},{"seg":4,"from":75,"to":138,"head":"דְּתַנְיָא: הַבְעָרָה","text":"דְּתַנְיָא: הַבְעָרָה — לְלָאו יָצָאת, דִּבְרֵי רַבִּי יוֹסֵי.","source":[{"kind":"verse","cue":"שנאמר"}]},{"seg":5,"from":79,"to":235,"head":"דְּתַנְיָא, רַבִּי","text":"דְּתַנְיָא, רַבִּי יוֹסֵי אוֹמֵר: ״וְעָשָׂה מֵאַחַת מֵהֵנָּה״, פְּעָמִים שֶׁחַיָּיבִים אַחַת עַל כּוּלָּן, וּפְעָמִים שֶׁחַיָּיבִין עַל כׇּל אַחַת וְאַחַת.","source":[{"kind":"verse","cue":"נאמר"}]},{"seg":5,"from":235,"to":393,"head":"וְאָמַר רַבִּי","text":"וְאָמַר רַבִּי יוֹסֵי בְּרַבִּי חֲנִינָא: מַאי טַעְמָא דְּרַבִּי יוֹסֵי, ״אַחַת״ ״מֵאַחַת״, ״הֵנָּה״ ״מֵהֵנָּה״ — אַחַת שֶׁהִיא הֵנָּה, הֵנָּה שֶׁהִיא אַחַת.","source":[{"kind":"verse","cue":"נאמר"}]}],"tosafot":[{"role":"probe","conf":"high","raw":"Question","spans":[{"from":34,"to":96,"head":"ואם תאמר"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.70a.t1.s1"},{"role":"respond.answer","conf":"high","raw":"Answer","spans":[{"from":97,"to":192,"head":"וי\"ל דאי"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.70a.t1.s2"},{"role":"probe","conf":"high","raw":"Question","spans":[{"from":297,"to":366,"head":"תימה א\"כ"}],"source":"dafyomi_tosafot","source_record_id":"shabbat.70a.t2.s1"},{"role":"respond.answer","conf":"high","raw":"Answer","spans":[{"from":367,"to":476,"head":"ויש לומר"}],"source":"dafyomi