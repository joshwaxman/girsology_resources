   "marks": [
    {
     "type": "objection",
     "object": "obj_binyan_chaklaa",
     "kind": "svara",
     "gloss_en": "מאי טעמא בכותל לא, משום דמיחזי כבונה? הא בנין חקלאה הוא! -- the only reason to forbid the wall would be that it looks like building, and that is a field-labourer's building",
     "against": "p_abaye_kotel_asur",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_binyan_chaklaa",
     "gloss_en": "Rava: [wiping mud on a wall] is a field-labourer's building"
    }
   ]
  },
  "18": {
