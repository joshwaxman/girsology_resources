  "5": {
   "segId": "Shabbat.141a.6",
   "sugya": "shabbat_141a_pugla_vetit",
   "marks": [
    {
     "type": "support",
     "object": "s_shma_mina_kash",
     "kind": "svara",
     "gloss_en": "since the mishna permits moving the straw with his body, שמע מינה moving from the side is not called moving",
     "supports": "p_tmh_lav_tiltul",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_tninan_dla_krn",
     "kind": "tnan",
     "gloss_en": "תנינא דלא כרב נחמן: the mishna lets him move the straw with his body -- moving a thing from the side is permitted, against Rav Nachman's prohibition of pulling the radish where it moves the earth",
     "against": "p_rn_pugla_milemata_asur",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_tmh_lav_tiltul",
     "gloss_en": "the school of Rav: conclude from it that moving [a thing] from the side is not called moving"
    }
   ]
  },
  "8": {
   "segId": "Shabbat.141a.9",
   "sugya": "shabbat_141a_pugla_vetit",
   "marks": [
    {
     "type": "objection",
     "object": "obj_ki_nachit",
     "kind": "svara",
     "gloss_en": "אי הכי, כי קא נחית נמי, קא דחי כחו ארבע אמות, ואסיר! -- if so, when he goes down too his force pushes [the water] four cubits, and it should be forbidden",
     "against": "p_ry_sachi_reason",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_kocho_lo_gazru",
     "gloss_en": "כחו בכרמלית לא גזרו (= p_kocho_bekarmelit_lo_gazru)",
     "answers": "obj_ki_nachit",
     "restores": "p_ry_sachi_reason"
    },
    {
     "type": "proposition",
     "object": "p_kocho_bekarmelit_lo_gazru",
     "gloss_en": "[what moves by] his force in a karmelit -- they did not decree [about it]"
    }
   ]
  },
  "10": {
   "segId": "Shabbat.141a.11",
