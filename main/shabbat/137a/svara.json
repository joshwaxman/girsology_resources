   "sugya": "shabbat_136b_androginos_lo_lakol",
   "marks": [
    {
     "type": "support",
     "object": "s_af_anan_tenina_para",
     "kind": "mesaya",
     "gloss_en": "אף אנן נמי תנינא: R' Yehuda disqualifies a woman and an androginos from sanctifying the purification water -- שמע מינה",
     "supports": "p_lo_lakol_zachar",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_hakol_kesherim_lekadesh",
     "gloss_en": "the mishna: all are fit to sanctify [the purification water] except a deaf-mute, an imbecile and a minor"
    }
   ]
  },
  "2": {
   "segId": "Shabbat.137a.3",
   "sugya": "shabbat_136b_androginos_lo_lakol",
   "marks": [
    {
     "type": "objection",
     "object": "obj_mai_shna_mila",
     "kind": "svara",
     "gloss_en": "ומאי שנא מילה? -- if R' Yehuda does not treat the androginos as male in all respects, why does circumcision differ?",
     "against": "p_ry_matir_androginos",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_hamol_lachem_kol_zachar",
     "gloss_en": "משום דכתיב המול לכם כל זכר (= p_kol_zachar_mila)",
     "answers": "obj_mai_shna_mila",
     "restores": "p_ry_matir_androginos"
    },
    {
     "type": "proposition",
     "object": "p_kol_zachar_mila",
     "gloss_en": "[circumcision differs] because it is written 'circumcise for yourselves every male' (Gen 17:10)"
    }
   ]
  },
  "0": {
   "segId": "Shabbat.137a.1",
   "sugya": "shabbat_136b_androginos_lo_lakol",
   "marks": [
    {
