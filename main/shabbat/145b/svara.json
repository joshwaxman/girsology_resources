     "restores": "p_ed_mipi_ed_bechor_kasher"
    },
    {
     "type": "ruling",
     "object": "r_halacha_ed_mipi_ed_bechor",
     "gloss_en": "והלכתא: עד מפי עד כשר לבכור",
