   "marks": [
    {
     "type": "support",
     "object": "s_kasavar_ein_kli_nital",
     "kind": "svara",
     "gloss_en": "קסבר אין כלי ניטל אלא לדבר הניטל בשבת -- the egg is not movable, so no vessel may be moved for it",
     "supports": "p_ein_kofin_kli_al_beitza",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_yitzchak_kol_hani",
     "kind": "meitivi",
     "gloss_en": "איתיביה כל הני תיובתא -- all the preceding sources (the tevel barrel, the sparks, the bowl over the lamp, the beam, the leak, the chick basket) were raised against him: in each a vessel is moved for something not movable",
     "against": "p_ein_kli_nital_ela_ledavar_hanital",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_tzarich_limkomo",
     "gloss_en": "ושני: בצריך למקומו -- where he needs the vessel's place [so its moving is already permitted]; the text names no answerer",
     "answers": "obj_yitzchak_kol_hani",
     "restores": "p_ein_kli_nital_ela_ledavar_hanital"
    },
    {
     "type": "proposition",
     "object": "p_ein_kofin_kli_al_beitza",
     "gloss_en": "R' Yitzchak: just as one may not place a vessel under a hen to receive its egg, so one may not overturn a vessel over it so it does not break"
    }
   ]
  },
