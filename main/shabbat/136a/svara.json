    {
     "type": "objection",
     "object": "obj_lipalgu_achila",
     "kind": "svara",
     "gloss_en": "אי הכי, אדמיפלגי לענין טומאה וטהרה, ליפלגי לענין אכילה! -- if so, let them dispute about eating instead of about impurity",
     "against": "p_abaye_mai_lav",
     "state": "live"
    }
   ]
  },
  "8": {
