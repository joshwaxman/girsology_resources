     "kind": "mah_nafshach",
     "status": "stands",
     "gloss_en": "מלין אותו ממה נפשך: if alive, he circumcises properly; if not, he is [merely] cutting flesh -- either way the circumcision may proceed"
    },
    {
     "type": "objection_answer",
     "object": "ans_mimanafshach",
     "gloss_en": "מלין אותו ממה נפשך (= mn_malin_safek_nefel, p_adda_malin)",
     "answers": "obj_heichi_mahalinan",
     "restores": "p_lo_shaha_safek"
    },
    {
     "type": "proposition",
     "object": "p_adda_malin",
     "gloss_en": "Rav Adda bar Ahava: one circumcises him whichever way you take it: if he is alive, he circumcises properly; and if not, he is cutting flesh"
    }
   ]
  },
  "10": {
