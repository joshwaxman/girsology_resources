   "marks": [
    {
     "type": "objection",
     "object": "obj_heichi_mahalinan",
     "kind": "svara",
     "gloss_en": "מימהל היכי מהלינן ליה! -- if he is a doubt, how do we circumcise him?",
     "against": "p_lo_shaha_safek",
     "state": "answered"
    }
   ]
  },
  "2": {
   "segId": "Shabbat.136a.3",
   "sugya": "shabbat_135a_imo_temea_leida",
   "marks": [
    {
     "type": "objection",
     "object": "obj_safek_ben_shiva",
     "kind": "svara",
     "gloss_en": "ואלא הא דתניא ... אין מחללין עליו את השבת, אמאי? נימהליה ממה נפשך!",
     "against": "p_baraita_safek_ben_shiva",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_baraita_safek_ben_shiva",
     "gloss_en": "the baraita: [a child] doubtfully of seven months, doubtfully of eight -- one does not desecrate Shabbat for him"
    }
   ]
  },
  "3": {
   "segId": "Shabbat.136a.4",
   "sugya": "shabbat_135a_imo_temea_leida",
   "marks": [
    {
     "type": "objection_answer",
     "object": "ans_machshirei_mila",
     "gloss_en": "מימהל הכי נמי מהלינן ליה; לא נצרכה אלא למכשירי מילה, ואליבא דרבי אליעזר (= p_mar_okimta)",
     "answers": "obj_safek_ben_shiva",
     "restores": "p_baraita_safek_ben_shiva"
    },
    {
     "type": "proposition",
     "object": "p_mar_mimhal",
     "gloss_en": "Mar breih deRavina [with Rav Nechumei bar Zecharya]: the circumcision itself -- indeed we circumcise him"
    }
   ]
  },
  "6": {
