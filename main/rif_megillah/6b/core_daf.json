  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> ומשום שיש בו פירושים שונים צריך לצאת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
