      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין כבוד צבור להיות כפופים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לברכתו ואם תאמר דהכא משמע",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דדוקא קטן הא גדול שהביא שתי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שערות עובר לפני התיבה ונושא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את כפיו ואלו בסוף פ' קמא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחולין (דף כד:) תניא נתמלא",
      "segment_ids": [
