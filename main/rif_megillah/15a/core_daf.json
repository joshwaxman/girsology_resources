      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זקנו ראוי לעשותו ש\"צ ולירד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפני התיבה ולישא את כפיו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלמא אפי' גדול עד שיתמלא את",
      "segment_ids": [
