  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "השחר כשר: (דף כ ע\"ב) כל היום כשר לקרות",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את המגילה. לקרות את ההלל. לתקיעת שופר.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולנטילת לולב. ולתפלת המוספין.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולמוספין. ולוידוי הפרים. ולוידוי מעשר.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולוידוי יום הכפורים. לסמיכה. לשחיטה.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לתנופה. להגשה. [לקמיצה]. להקטרה.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למליקה. ולקבלה. ולהזיה. ולהשקאת סוטה.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולעריפת עגלה. ולטהר את המצורע. כל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלילה כשר לקצור את העומר ולספירת העומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והקטר חלבים ואברים זה הכלל דבר שמצותו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביום כשר כל היום וכל דבר שמצותו בלילה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשר כל הלילה: <b>סליקו להו הקורא את</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>המגילה</b> בני <i data-commentator=\"Mishneh Torah, Prayer and the Priestly Blessing\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>העיר שמכרו רחובה של עיר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לוקחין בדמיו בהכ\"נ בהכ\"נ לוקחין תיבה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תיבה לוקחין מטפחות מטפחות (דף כו ע\"א)",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לוקחין ספרים ספרים לוקחין תורה אבל אם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכרו תורה לא יקחו ספרים ספרים לא יקחו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מטפחות מטפחות",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כל היום כשר לקרות המגילה וכו' ולתפלת המוספין ולמוספין.</b> ואע\"ג דאמרינן (פסחים נט.) שאין לך דבר קודם לתמיד של שחר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואמרי' נמי [שם נח.] עליה השלם כל הקרבנות כולם וכיון שכן זמן המוספין אינו אלא בין תמיד של שחר לתמיד של בין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הערבים אפ\"ה כיון שאם הקדימוהו קודם תמיד של שחר או אחרוהו אחר תמיד של בין הערבים כשרים שפיר מצי תני דמצותן כל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "היום ותמידין לא תני הכי משום דתמידין אין זמנם כל היום דזמן תמיד של שחר ליתא אלא עד ארבע שעות או עד חצות וזמן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמיד של בין הערבים ליתא אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משש שעות ומחצה ולמעלה ומש\"ה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא תני פסחים שאין זמנן אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין הערבים אבל קודם לכן לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואע\"ג דתנן זה הכלל כל שמצותו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביום כשר כל היום הרי אמרו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין למדין מן הכללות ואפילו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקום שנאמר בהן חוץ ועוד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאנן לא אמרינן אלא כל דבר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמצותו ביום סתם אבל תמידים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופסחים כבר פירש בהן הכתוב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעה מיוחדת: <b>ולוידוי פרים.</b> פר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העלם דבר של צבור ופר כהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משיח שמתודין עליהן: <b>ולוידוי</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מעשר.</b> בשנה שלישית שמתודה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדכתיב בערתי הקדש מן הבית:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ולוידוי בכורים.</b> כשמביא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכורים מתודה כדכתיב הגדתי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היום לה' אלהיך: <b>ולוידוי יום</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הכפורים.</b> שמתודה כהן גדול",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדכתיב באחרי מות: <b>ולסמיכה.</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדכתיב וסמך: <b>ולשחיטה.</b> של קרבן: <b>ולתנופה.</b> דכתיב והניף הכהן: <b>להגשה.</b> שהיה מגיש",
      "segment_ids": [
        5,
        6,
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מנחת סוטה בחודו של מזבח כדאיתא בסוטה: <b>לקמיצה.</b> כדכתיב וקמץ מן המנחה: <b>להקטרה.</b>",
      "segment_ids": [
        8,
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הקטרת הקומץ דכתיב והקטיר המזבחה: <b>ולמליקה.</b> כדכתיב בקרבן העוף ומלק: <b>ולקבלה.</b> לקבל",
      "segment_ids": [
        10,
        11,
        12
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דם הקרבן: <b>להזייה.</b> בין להזאת דמים בין להזאת מי חטאת: <b>ולטהר את המצורע.</b> כדכתיב",
      "segment_ids": [
        12,
        13,
        14
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ביום טהרתו וכל הני יליף בגמ' בהדיא: <b>כל הלילה כשר לקצירת העומר.</b> שהיה נקצר",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בלילה: <b>ולהקטר חלבים ואמורים.</b> שלא נתעכלו ביום וכל הנך דמתני' דוקא נינהו אינהו",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דקתני בהו ביום [ביום] ולא בלילה והני דקתני בהו בלילה בלילה ולא ביום וא\"כ קצירת",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "העומר אינה אלא בלילה ולא ביום לעיכובא דס\"ל להאי תנא דנקצר ביום פסול ורבי אלעזר",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ברבי שמעון הוא דס\"ל הכי בפרק רבי ישמעאל במנחות ששנינו שם [דף עא.] נקצר ביום",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כשר ודוחה את השבת והקשו שם והא תנן כל הלילה כשר לקצירת העומר זה הכלל דבר",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמצותו ביום כשר כל היום דבר שמצותו בלילה כשר כל הלילה קתני לילה דומיא דיום מה יום בלילה לא אף דלילה ביום לא אמר",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רבא לא קשיא הא רבי הא רבי אלעזר ברבי שמעון וכו' כלומר דמתני' רבי אלעזר בר' שמעון דאיהו סבירא ליה נקצר ביום פסול",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וכן יש שם משניות אחרות דאתו אליביה דקתני התם שקצירתו דוחה את השבת וכיון דדוחה את השבת ע\"כ זמן קצירתו לעכובא",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בלילה ולא ביום שאם נקצר ביום כשר אם כן משמע שאם נקצר שלא כמצותו כשר וא\"כ היה לו לקצור מע\"ש כדאמרי' התם ואי סלקא",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דעתך נקצר שלא כמצותו כשר אמאי דוחה את השבת נקצריה מע\"ש אבל ההיא מתני' אחריתי דתנן התם בסוף פרקין [דף עא.] נקצר",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ביום כשר ודוחה את השבת כרבי ודוחה את השבת דקתני אוקים לה התם [שם עב:] להקרבה וכיון דהתם בפרק רבי ישמעאל פליגי",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סתמי אי קצירת לילה מעכבת או לא משמע דקי\"ל כסתם מתני' דהכא קתני לה גבי הלכתא פסיקתא ואע\"ג דההיא דפרק רבי ישמעאל",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במנחות דסתם לן תנא כר' אתניא בדוכתא וסתמא בדוכתא עדיפא הא איכא נמי סתמא אחרינא התם דאתיא כר' אלעזר בר' שמעון",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ועוד הביאו ראיה בתוס' דקצירת העומר דוחה את השבת וממילא שמעינן דאינה אלא בלילה וכדכתיבנא דאמרינן התם בפ\"ק דמועד",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קטן [דף ג:] א\"ר שמעון בן פזי אריב\"ל משום בר קפרא ר\"ג ובית דינו נמנו על שני פרקים אלו והתירום כלומר של תוספת",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שביעית ומפרש רב אשי התם דר\"ג ובית דינו סבירא להו כר' ישמעאל דאמר עשר נטיעות ערבה ונסוך המים הלמ\"מ מה ערבה ונסוך",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המים בזמן שבהמ\"ק קיים אף עשר נטיעות נמי אינה נוהגת אלא בזמן שבהמ\"ק קיים אבל בזמן הזה לא שאין תוספת שביעית נוהג",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בזמן הזה ולפיכך אמרו שם דלר' ישמעאל בחריש ובקציר לא מידריש לתוספת שביעית דהא מהלכה גמרינן לה אלא אתי לאידך דרבי",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ישמעאל דאמר מה חריש רשות אף קציר רשות יצא קציר העומר שהיא מצוה ודוחה את השבת ומשמע דהכי קי\"ל דמדאמרינן נמנו",
      "segment_ids": [
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וגמרו משמע שנתברר להם הדבר וכיון שקצירת העומר דוחה את השבת ע\"כ אינה אלה בלילה לעכוב כמ\"ש למעלה: <b>ומכאן</b> סמך ר\"ת",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל שאם לא ספר בלילה אינו סופר ביום דקצירה וספירה כי הדדי נינהו כדאמרי' בגמ' [מכילתין דף כא.] דאמר מר קצירה",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וספירה בלילה והבאה ביום ואיכא נוסחי דגרסינן במתני' לקצירת העומר ולספירת העומר ועוד דודאי לדברי הכל ספירה אינה",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא בלילה דהא גמרינן לה בפרק רבי ישמעאל [דף סו.] משבע שבתות תמימות תהיינה אימתי הן תמימות בזמן שהוא מונה מבערב",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וכיון שכן מנא תיתי שאם לא ספר בלילה שיספור ביום אבל בה\"ג כתב שאם לא בירך בלילה מברך למחר ור\"ת ז\"ל דחה דבריו",
      "segment_ids": [
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולפיכך טוב שאם לא ספר בלילה שיספור ביום בלא ברכה: <b>זה הכלל דבר שמצותו ביום כשר כל היום מצותו בלילה כשר כל הלילה.</b>",
      "segment_ids": [
        17,
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמרו בגמ' זה הכלל דיום לאתויי סדור בזיכין וסלוק בזיכין כלומר בזיכי לבונה שהיו מניחין עם לחם הפנים וזה הכלל",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלילה לאיתויי אכילת פסחים כר\"ע דסבר לה הכי ודלא כר\"א בן עזריה דאמר בברייתא עד חצות ואע\"ג דהאי סתמא כר\"ע איכא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סתמא בפ\"ק דברכות כר\"א בן עזריה כדדייקינן התם [דף ט.] אילו אכילת פסחים לא קתני וכן נמי בפרק איזהו מקומן דתנן התם",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "[דף נו:] הפסח אינו נאכל אלא בלילה ואינו נאכל אלא עד חצות וכיון שכן לא פסיקא לן הלכתא כמאן ולפיכך צריך להזהר שלא",
      "segment_ids": [
        18
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאכול מצת מצוה שבלילי פסחים אחר חצות: <b>וכן בהלל.</b> שבלילי פסחים החמירו בתוס' שלא לקרותו אחר חצות: <b>סליקו להו הקורא</b>",
      "segment_ids": [
        18,
        19,
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>את המגילה בני העיר שמכרו רחובה של עיר לוקחין בדמיו בית הכנסת.</b> שצריכין לעלות בדמיו ורחוב הוא מקום שמתכנסין בו",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בתעניות אחרונות ומוציאין שם את התיבה ומתפללין בו כדאיתא בתענית [דף טו.]: <b>בית הכנסת לוקחין תיבה.</b> מכרו בהכ\"נ",
      "segment_ids": [
        20,
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לוקחין בדמיו תיבה שהוא מקום שמניחין בו ס\"ת שאנו קורין ארון והוא קדוש יותר מבהכ\"נ: <b>תיבה לוקחין מטפחות.</b> מטפחות",
      "segment_ids": [
        21,
        22
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ס\"ת דקדישי טפי: <b>מטפחות לוקחין ספרים.</b> נביאים וכתובים ואפילו במטפחות ס\"ת מיירי דנביאים וכתובים קדישי טפי ממטפחות",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תורה והכי איתא בירושלמי מטפחות לוקחין ספרים אפילו מטפחות תורה וחומשים לוקחין בהם נביאים וכתובים ובסיפא דספרים",
      "segment_ids": [
        23
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא יקחו מטפחות גרסינן נמי התם אפילו נביאים וכתובים אין לוקחין בהם מטפחות תורה וחומשין: <b>ספרים לוקחין תורה.</b> שאם",
      "segment_ids": [
        23,
        24
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מכרו נביאים וכתובים לוקחין ס\"ת ותו ליכא לעלויי: <b>אבל אם מכרו ספר תורה לא יקחו ספרים.</b> נביאים וכתובים משום דאין",
      "segment_ids": [
        24,
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מורידין בקדושת דמים הא תורה לוקחין מיהו איבעיא לן בגמרא [דף כז.] אי שרי לכתחילה למכור ס\"ת ישן ליקח בו חדש או",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אסור כיון דליכא לעילויי ולא איפשיטא ונקטי בה רבוותא לחומרא ומדאבעיא לן בס\"ת דליכא לעלויי בה מכלל דפשיטא לן",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבהנך אחריני דאיכא לעלויי בהו אסור למכרן וליקח כיוצא בהן וכתוב בספר המאור כתב הר\"ר אפרים ז\"ל הא מתניתין קשיא",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רישא אסיפא דכולה רישא שמעינן מינה היכא דלא מעלי אסור וסיפא אבל אם מכרו תורה לא יקחו ספרים שמעינן מינה דלא בעינן",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לעלויי וכיון דקשיא רישא אסיפא ליכא למשמע מינה אי מעלין דוקא או מורידין דוקא אלא מדקאמר לקמן בענין ס\"ת כיון דלא",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מעלי ליה אסור אלמא מעלין דוקא ואיידי דתנא רישא ספרים לוקחין בדמיהן תורה דדוקא תורה ולא ספרים תנא נמי סיפא ספרים",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא יקחו מטפחות ולעולם אפי' ספרים לא יקחו בדמיהן אלא תורה ע\"כ ובודאי דמגמרא הכי משמע דעילויא בעינן דע\"כ לא",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "איבעיא לן אלא בס\"ת דלא מצי לעילויי אלמא משמע דכל היכא דמצי לעלויי מעלינן ומיהו אכתי מבעיא לן היכי משמע הכי",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ממתניתין ואמאי נקט תרי גווני דדיוקא דחד סתר לדיוקא דאידך ונראה לי דתנא הכי קתני בבא דרישא קמ\"ל דכל מידי דאפשר",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ביה עלויא מעלינן ליה וסיפא דלא יקחו מש\"ה לא נקטה בשוין משום דאם איתא דמותר למכור ס\"ת ישן ליקח בו חדש אשמעינן",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ברישא דסיפא דספרים הוא דלא יקחו [בדמי] תורה הא תורה בתורה שפיר דמי משום דמשמע לן דתנא לא מיירי באיסורא דמכרו",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ס\"ת שלא כדין אי נמי משום דאי לא שרית ליה למעבד הכי הוה לן למימר שתבטל מכירתן ומשום חד מהני טעמי דייק בגמ' דהא",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תורה בתורה שפיר דמי <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>ומש\"ה איצטריך למנקט ברישא דסיפא אבל מכרו תורה לא יקחו ספרים ואם תמצא לומר דאסור למכור ס\"ת",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ישן ליקח בו חדש קמ\"ל דאע\"פ שמכרוהו שלא כדין <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ב\" data-order=\"2\"></i>מכירתן מכירה ספרים הוא דלא יקחו הא תורה שפיר דמי ומכרן קיים ועוד",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלא תאמר כיון דבעינן עלויא ובס\"ת לא מצינן למעבד עלויא נמצא שמה שראוי לאותה קדושה ראשונה א\"א להתקיים במה שנקח",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בדמיה וכיון שכן קדושה חדשה היא זו ואפילו ספרים אנו יכולין ליקח מהם קמ\"ל דלא הלכך בכל חד גוונא מגווני דבעיין",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "איצטריך לאתחולי ולמתני מכרו תורה אל יקחו ספרים וכיון דבגרועי אתחיל נקטינהו לכולהו נמי בגרוע ספרים אל יקחו",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מטפחות ומטפחות לא יקחו תיבה ואה\"נ דבשוין נמי אסור:",
      "segment_ids": [
        25
      ]
    }
  ],
