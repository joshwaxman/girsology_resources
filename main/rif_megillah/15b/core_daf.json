        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לן ועמא דבר להקרות אף ליחיד ורבינו פרץ",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב כסמ\"ג וכתב עליו הטור ולא נהירא: <b>ג</b>",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פי' אמן שעונים אחר ברכת מודים ומכאן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "246px",
      "right": "0px",
