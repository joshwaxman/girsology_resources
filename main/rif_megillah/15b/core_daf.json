      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב ש\"ד לקרות גם ליחיד: <b>לשון ריא\"ז</b> ואם",
