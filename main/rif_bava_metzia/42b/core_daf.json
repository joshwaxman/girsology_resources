    {
      "width": "380px",
      "right": "275px",
      "text": "הרבית ר' יוסי אומר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ד\"ת</i> <i class=\"footnote\">מ\"ז</i>(עובד",
