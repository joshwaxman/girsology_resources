      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צנועים היא תקנתא כדי שלא יהא אדם נכשל",
      "segment_ids": [
