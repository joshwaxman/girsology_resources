      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעלים עלייהו והלכך חשיב כאילו מכרו",
      "segment_ids": [
