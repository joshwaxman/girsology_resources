      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואח\"כ טבח פטור מתשלומי ד' וה' דודאי שם",
      "segment_ids": [
