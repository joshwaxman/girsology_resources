  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "הלכתא <i data-commentator=\"Mishneh Torah, Agents and Partners\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i>(<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">כל</i> <i class=\"footnote\">זה</i> <i class=\"footnote\">אינו</i> <i class=\"footnote\">מהל'</i> <i class=\"footnote\">הרי\"ף</i> <i class=\"footnote\">ז\"ל</i>",
