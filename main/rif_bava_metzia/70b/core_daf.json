  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "לית ליה האי סברא והא רבא אפיק זוגא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דסרבלא וספרא דאגדתא מיתמי בדברים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העשויין להשאיל ולהשכיר אמר לך רבא מי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמי התם בזוגא דסרבלא עביד איניש דמשאיל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומוגר הוא הכא בסכינא דאשכבתא לאו מידי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעביד לאושולי ולאגורי הוא כיון דמיפגמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קפדי אינשי ולא מושלי <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>והלכתא כרבא: מהא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעתא שמעינן דמאן <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>דמפקיד גבי חברי מידי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מדברים העשויין להשאיל ולהשכיר או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אושליה לדידיה וידיע ההוא מידי ההוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דיליה בסהדי ואע\"ג דאפקדיה או אושליה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלאו באפי סהדי ואמר הלה לקוח הוא בידי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "או משכון הוא בידי אינו נאמן ואפי' <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>מת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ההוא דאיתפקיד <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>גביה וטענו בניה דלקוח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא או משכון הוא גבי אבוהון לא מהימני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכי היכי דאבוהון לא מהימן הוא הדין נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אינון לא מהימני כי הא דרבא דאפיק זוגא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דסרבלא וספרא דאגדתא מיתמי בדברים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העשויין להשאיל ולהשכיר ושמעינן נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מכללא דאי אפקדיה או אושלי לחבריה באפי סהדי אע\"ג דליתיה לההוא מידי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מדברים העשויים להשאיל ולהשכיר ואמר חזרתיו ולקחתיו ממנו אינו נאמן דלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "איצטריכא הא דשלח ר' חנינא בר אבין אלא היכא דלא אושליה ולא אוגריה באפי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "סהדי אבל היכא דאוגריה או אושליה באפי סהדי אע\"ג דליתיה מדברים העשויין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "להשאיל ולהשכיר הא איכא סהדי דשאלה גביה הוא הילכך אי אמר חזרתיו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ולקחתיו ממנו אינו נאמן ובהדיא גרסינן בפ' חזקת הבתים <span class=\"bavli-ref\" data-bavli-ref=\"(דף מו.)\" data-bavli-daf=\"46a\" data-bavli-index=\"0\"></span>מותיב ר\"נ בר יצחק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אומן אין לו חזקה הא אחר יש לו חזקה היכי דאמי אי דאיכא עדים אחר אמאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יש לו חזקה אלא לאו דליכא עדים ושמעינן מינה דהיכא דאיכא עדים דיהביה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ניהליה להאי מנא באפייהו <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>אפילו אחר שאינו אומן אין לו חזקה וכבר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ביררנוהו <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בסוף</i> <i class=\"footnote\">פרק</i>בפ' המפקיד וכן הלכתא ואע\"ג דחזינן למקצת רבוואתא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דסבירא להו דהאי דשלח רבי חנינא דברים העשויין להשאיל ולהשכיר ואמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לקוחין הן בידי אינו נאמן ורבא נמי דאפיק זוגא דסרבלא וספרא דאגדתא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מיתמי בדברים העשויין להשאיל ולהשכיר במי שטענוהו כלים המונחין תחת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כנפיו הוא <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ב\" data-order=\"2\"></i>מהא שמעתא שמעינן דלאו הכי מילתא דאי איתיה להאי סברא לא הוה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מקשינן עליה דרבא <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>כדאמרי' בסכינא דאשכבתא יכול לטעון עד כדי דמיה מהא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דאפיק זוגא דסרבלא וספרא דאגדתא מיתמי בדברים העשויין להשאיל ולהשכיר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>(הם הכא נמי) ואע\"ג דמקשינן מינה ה\"ל לפרוקי מי דמי התם בשטענוהו <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>כלים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הניטלין תחת כנפיו הכא לא ומדלא פריק הכי אלא קפריק התם עביד איניש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דמושיל הכא כיון דמיפגמא לא מושלי אינשי שמעינן דהאי דשלח רבי חנינא בר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אבין אכולי עלמא הוא וכן הלכתא <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>: <b>סליק פרק המקבל <big><span class=\"bavli-ref\" data-bavli-ref=\"(דף קטז:)\" data-bavli-daf=\"116b\" data-bavli-index=\"1\"></span>הבית</big></b> <i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Neighbors\" data-label=\"⚬\"></i>והעליה של שנים",
      "segment_ids": [
        2,
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שנפלו שניהם חולקין בעצים ובאבנים ובעפר ורואין אלו אבנים ראויות להשתבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היה א' מהן מכיר מקצת אבניו נוטלן ועולות מן החשבון: <b><big>גמ'</big></b> מדקתני סיפא",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רואין אלו אבנים ראויות להשתבר מכלל דאיכא למיקם עלה דמילתא אי בחבט'",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נפל אי בחבסא נפל אי הכי רישא נמי אמאי חולקין ניחזי אי בחבטא נפל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "[עלייתא איתבור]",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>זוגא דסרבלא.</b> מספרים לגזוז בהן בגדי צמר וספרא דאגדתא אע\"ג דשאר ספרים עשוים טפי להשאיל כדאמרינן בכתובות (דף נ.)",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הון ועושר בביתו וכו' זה הכותב ספרים ומשאילן אבל ספרי דאגדתא הוא מתורה שבעל פה ולא ניתן ליכתב אלא משום עת לעשות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לה' מ\"מ גם זה עשוי להשאיל ובהגוזל בתרא (דף קיד:) גבי המכיר כליו וספריו דמשמע שאין עשויין להשאיל מדלא מהימנינן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לו במגו דהשאלתים לך תירץ ר\"ת ז\"ל שיש חלוק בבני אדם לפי דעתו שהוא רגיל להשאיל ספריו ולמי שהוא רגיל להשאיל וההיא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבב\"ק מיירי בידוע שאינו רגיל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להשאיל ספריו: <b>מיתמי.</b> שהבעלים",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הביאו עדים שהיו שלהם והיו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טוענים השאלנום לאביהם של אלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפקינהו רבא מינייהו משום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דברים העשויין להשאיל ולהשכיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם איתא דיכול לטעון לקוח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא בידי יתמי כי לא טענו נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אנן טענינן להו: <b>סליק פרק</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המקבלהבית והעלייה.</b> כגון שני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחים שחלקו אחד נטל בית ואחד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נטל עלייה שעל גביו והאבני'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של חומת הבית מן תקרת הבית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התחתונה שהיא קרקע של עלייה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמעלה של עליון והימנה ולמטה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של תחתון: <b>שניהם חולקין.</b> מפרש",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתוספתא בד\"א בזמן שהיו שניהם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שוים אבל היה אחד מהם גדול",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואחד מהם קטן זה נוטל לפי שלו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וזה נוטל לפי שלו וכן אפילו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין שניהם שוין אלא שכל אחד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומר שלי היה גבוה נמי חולקין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון שאין לנו עדים של מי היה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבוה דא\"א בענין אחר וא\"ת מאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קמ\"ל דבשניהם שוין יחלוקו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פשיטא הא קמ\"ל דחולקין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשבורות ובשלמות ולא נאמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון שרוב הכתלים נופלים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחבטה הא נמי בחבטה נפל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ועליונות נשברו אלא כיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאפשר דבחבסה נפל חולקים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[בשבורות ושלמות:ורואין אלו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבנים ראויות להשתבר. כלומר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם ידוע היאך נפלה שמין אלו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראויות להשתבר]. אבל בידוע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאחד גדול ואחד קטן אותו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחלקו מרובה נוטל יותר מן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ו\" data-order=\"6\"></i>השבורות ולא אמרינן ממון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המוטל בספק הוא וחולקין [דאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחבטה כולהו שבורות דמר ואי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחבסה כולהו שבורות דמר ודין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא שיחלוקו] אף על פי שחלקו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של אחד מהם מרובה כדתניא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בברייתא דפירקין ומייתי לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בירושלמי באלין אבנים ונגנבו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחצה לזה כלומר [דבאבנים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפירקין תנא בברייתא שאם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נגנבו] חולקין בשוה אף על פי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהאחד גדול חלקו מחברו משום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהתם בכל אחת שנוטל איכא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למיחש אם הן מן המרובות ובשעה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנוטל הספק שוה בכל אחת ואחת <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ג\" data-order=\"3\"></i>הלכך כל אחת הוא ממון המוטל בספק וחולקים אבל הכא אין הספק שוה שאם העליון מרובה אפילו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נפל בחבטה יותר הן אותן שנשארו שלמות מאבנים שלו לפי שהן מרובות ממה שישארו משל תחתון אי נמי נפל בחבטה ומשום הכי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קאמר ששמין זה הספק שאינו שוה וכל אחד מהם נוטל לפי שלו אבל מה שהן ראויין להשתבר בזה ובזה שהוא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ז\" data-order=\"7\"></i>ספק שוה חולקין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשוה אע\"פ שחלקו של אחד מהם מרובה וכן הוכיחו המפרשים ז\"ל מן הירושלמי דשור שנגח ארבעה וחמשה דאמרינן התם תאני וכן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנים שהטילו לכיס זה מנה וזה מאתים ונגנבו <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ד\" data-order=\"4\"></i>חולקין לפי דמים רבי יוסי בר בון בשם רב הונא סלקת מתניתא הנבללין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והנחפנין לפי חשבון פירוש דכי קתני מתני' ואם בלל וחפן לפי חשבון לאו דבעינן להו לתרוייהו אלא בחדא מינייהו בלחוד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סגי שאם בלל תחלה אע\"פ שלא חפן אלא נטל אחד אחד הולכין אחר הרוב לפי חשבון <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ה\" data-order=\"5\"></i>הלכך מעות מעשר שני וחולין שנתפזרו ולקט",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחד אחד לא אמרינן לפי חשבון כיון שמתחלה לא היו מעורבין ובשעת נטילה לא חפן ליקח הרבה בבת אחת [ולפיכך תולין לומר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלפי של מעשר שני ומשום חומרא אבל בשנים] שהטילו לכיס כיון שהן מעורבין חולקין לפי חשבון ובאלין אבנים שנגנבו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חולקין בשוה לפי שגסות הן ובשעת נטילה אינן נחפנות וגם לא נתערבו מתחלה כלל שמעינן מהכא דהא דאמרינן ממון המוטל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בספק חולקין אפילו היכא שיש לאחד יותר ממה שיש לחבירו: <b>ורואין אלו אבנים כו'.</b> אם יש אבנים שבורות שם שאבנים של",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לבנים היו וזה אומר שלמות שלי רואין אלו אבנים ראויות להשתבר אם של עליון אם של תחתון הכל לפי המפולת אם נחבט הבית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מיסודו ונפל תחתיו החומה במקומה יש לדעת שהתחתונות נשברו ולכך נפלה בית ואם נחבט הכותל להלן כמקל שהוא עומד זקוף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ונפל שהעליונו של כותל נפל להלן הרבה העליונות נשברו שנפלו מגובה רב והתחתונות שנפלו ממקום נמוך שלמות: <b>מקצת אבניו.</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלימות: <b>[נוטלן] ועולות לו מן החשבון וכו'.</b> שחבירו יטול אחרות כנגדן ובגמ' מפרש מה יטול כנגדן שלמות או שבורות: <b>גמ'</b>",
      "segment_ids": [
        5,
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מכלל דאיכא וכו'.</b> מפולת זה היאך נפלה אי בחבס' <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ח\" data-order=\"8\"></i>כבר פירשנו חבסא וחבטא:",
      "segment_ids": [
        7
      ]
    }
