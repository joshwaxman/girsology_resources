      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פטור ואם הוחמה חייב בבקעה והוליכה בהר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אם הוחלקה חייב ואם הוחמה <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>פטור ואם מחמת",
