        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר' חנינא אומר שמתה מחמת <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>אובצנא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">רבה</i>",
      "segment_ids": [
