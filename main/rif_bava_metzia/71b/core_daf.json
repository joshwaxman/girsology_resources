      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דא\"ל עלייה שעל גבי בית זה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפילו הכי מספקא ליה משום",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דגם העלייה העליונה בכלל בית",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה וכל מה ששייר לעצמו קרא",
      "segment_ids": [
