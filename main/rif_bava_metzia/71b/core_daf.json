      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממקומן וקי\"ל כרבנן דהכא",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון דבשוכר ומשכיר איירי",
      "segment_ids": [
