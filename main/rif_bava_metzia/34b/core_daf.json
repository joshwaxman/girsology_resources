    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחבירו מנה והלך ועמד לו על גורנו ואמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו תן לי את מעותי שאני רוצה ליקח בהן",
