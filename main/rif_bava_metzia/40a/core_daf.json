      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "text": "עמלו ומזונו איכא <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>בינייהו ביצים מוזרות ת\"ר מקום שנהגו להעלות",
      "segment_ids": [
        4
      ]
