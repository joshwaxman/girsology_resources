      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סאה בסאה והרמב\"ן ז\"ל כתב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלישנא נמי הכי דייקא דאי לא",
