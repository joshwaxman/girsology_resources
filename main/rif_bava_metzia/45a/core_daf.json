      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל חכמים אומרים לוה סתם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופורע סתם וכתבו הגאונים ז\"ל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבכלל לשון זה דלווין סתם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משמע נמי דלווין סאה בסאה על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שער שבשוק וכתב הרשב\"א ז\"ל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאין נראה כאותם המפרשים ז\"ל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שפירשו דלווין סתם לאפוקי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היכא דקבע לו זמן לפרעון משום",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחוששין שמא ישתנה השער",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בינתים דודאי קביעות הזמן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתועלת הלוה הוא שאין המלוה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יכול לכופו אלא אם בא לוה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפרוע תוך זמנו רשאי <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ל\" data-order=\"12\"></i>וכתב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבינו האי גאון ז\"ל בתשובה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשאלת ככר שהוא דבר מועט לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעינן שער שבשוק שאע\"פ שאין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לזה יש לזה מידי דהוה אזבל כל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימות השנה ובמסכת שבת פרק",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שואל אדם (דף קמח:) מוכיח כן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמוקי לה בדלא קייצי דמי וכן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתב הראב\"ד ז\"ל דאע\"פ שאין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לזה שרו רבנן משום דמילתא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זוטרתי היא ושכיח לאזופי חדא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחברתה א\"נ משום דלא קפדי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכנים אהדדי בהא מילתא: <b>בני</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חבורה.</b> הולכים בדרך או יושבים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בבית אחד איש לסעודת עצמו:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המקפידים זה על זה.</b> להלוות זה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את זה במדה ובמשקל ובמנין:",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עוברים.</b> בשבתות וימים טובים:",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ומשום לווין ופורעין.</b> דתנן במסכת שבת [שם א] ובלבד שלא יאמר [לו] הלויני והתם מפרש טעמא שלא יכתבו והטעם שכיון",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמקפידים זה על זה אי אפשר שלא יתכוונו לדברים אלו אבל לשמא יתיקר הככר כהלל אין עוברים על זה משום דככרות וכיוצא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בזה אע\"פ שאין לזה יש לזה ושרי כמו בהלויני עד שיבא בני וכו' והתם מותר אפילו אם יתיקר בינתים דכיון שיש לו לא גזור",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רבנן לאסור משום רבית כדפירש רש\"י ז\"ל: <b>תלמידי חכמים.</b> כ' הרנב\"ר ז\"ל דדוקא בעסקי סעודה ובדבר מועט דגמרי ויהבי לשם",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מתנה וכדא\"ל שמואל לאבוה בר איהי הלויני מאה פלפלין במאה ועשרים ואריך שאין אני מקפיד למנות הגרעינים. והא דא\"ל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הלויני מאה במאה ועשרים לא שיאמר לו לעשות כן אלא שאם הוסיף בשעת פרעון עד חומש מותר שכל כיוצא בזה לתלמיד חכם דרך",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כבוד הוא ושרי אבל עם הארץ [לשם] רבית הוא [נותן] ואסור: <b>ואריך.</b> וטוב ודומה לו בספר עזרא (עזרא ד׳:י״ד) וערות מלכא",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא אריך לנא למחזי שפירושו וגנות המלך אין יפה לנו לראות: <b>ומסקינן</b> הכא בגמ' שאסור לאדם להלוות לבניו ולבני ביתו",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ברבית כדי (שיטעמו צער) [שלא יטעו אחר] רבית ולא ירגילו בו משום דשמא ייטב בעיניהם השכר וירגילו בו. בירושלמי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובתוספתא דב\"ק תניא יפה כח הדיוט מכח הקדש נזקין להדיוט ואין נזקין להקדש רבית ואונאה להדיוט ואין רבית ואונאה",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "להקדש וכתב הריטב\"א ז\"ל בפרק הנזקין דהיינו דוקא הקדש גמור אבל הקדש עניים יש לו רבית ואונאה: <b>מתני' נכש.</b> תולש",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עשבים רעים מתוך טובים: <b>עדור.</b> חפור: <b>גריד.</b> לשון יובש שהארץ יבשה ואין הגשמים יורדים: <b>רביעה.</b> כדאמר פרק קונם [דף סג.",
      "segment_ids": [
        12,
        13,
        14,
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"ש] גשמים שירדו ז' ימים זה אחר זה ולא פסקו יש בהם כדי רביעה (תענית דף ו:) א\"ר אבהו מאי לשון רביע שרובע את",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקרקע כדרב יהודה מטרא בעלה דארעא שנאמר כי כאשר ירד הגשם והשלג וכו': <b>כל ימי גריד אחד הם.</b> ולא דקדקו בדבר לחוש שמא",
      "segment_ids": [
        15,
        16
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יום אחד ארוך או קשה מחבירו: <b>אבל לא יאמר וכו'.</b> פעמים שזה קשה מזה ויש כאן אגר נטר ליה בשכר שממתין לו על פעולתו עד",
      "segment_ids": [
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אותו הזמן הוא מקבל עליו מלאכה שהיא קשה מזו: <b>אבל לא יאמר לו חרוש וכו'.</b> שימי רביעה קשין למלאכה בשדות: <b>לא תתן ולא</b>",
      "segment_ids": [
        17,
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תקח וכו'.</b> כל חד וחד מאי דשייך ביה כדמפרש בגמרא: <b>גמ' עובר בכולן.</b> בכל הני דכתיבי במתני' הוא נותן בנשך בשעת הלואה",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והוא לוקח בשעת פרעון והוא נושכו כשתובעו ודוחקו והוא שם עליו נשך בשעת פיסוק התנאי והוא נותן מכשול ללוה להעבירו",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על לא תשיך לאחיך שהוא אזהרה ללוה:",
      "segment_ids": [
        20
      ]
    }
  ],
