    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא דקאמרי <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"כ\" data-order=\"11\"></i>דאין צריך קציצת",
      "segment_ids": [
