        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחכמים לאו אככרות לבד <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"י\" data-order=\"10\"></i>אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו אמר הלויני כור חיטין",
