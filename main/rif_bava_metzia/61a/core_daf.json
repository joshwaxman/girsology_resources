    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שוכר הימך שדה בית האילן אני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שוכר הימך יבש המעיין ונקצץ",
      "segment_ids": [
