      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעותיו באים על פתח החנות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהקיפו שם ואם הלך למקום אחר",
      "segment_ids": [
