    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והבתים אין מצויים לשכור צריך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להודיעו כל שנים עשר חדש כיון",
