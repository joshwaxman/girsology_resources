    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וש\"מ <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ז\" data-order=\"7\"></i>דכיון דאיכא כחישות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמיירי דוקא אחר שהשרישו",
