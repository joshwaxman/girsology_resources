\"rif-span rif-parallel\" data-gemara-from=\"101b:7\"><span class=\"rif-variant\" data-subtype=\"suffix\" data-vilna=\"לְהוֹדִיעַ,\">להודיעו</span> דא&quot;ל אי אודעתן הוה טרחנא ומותיבנא איניש מעליא אמר רב אסי אם נכנס יום אחד בימות הגשמים מהני שלשים יום אינו יכול להוציאו מן החג ועד הפסח אמר רב הונא ואם בא לרבות <span class=\"rif-variant\" data-subtype=\"suffix\" data-vilna=\"בְּדָמֶיהָ\">בדמים</span> מרבה</span> <span class=\"rif-span rif-addition\">והוא דאייקור בתי אבל</span> <span class=\"rif-span rif-parallel\" data-gemara-from=\"101b:9\">לא <span class=\"rif-variant\" data-subtype=\"prefix\" data-vilna=\"דְּאִיַּיקּוּר\">אייקור</span> בתי</span> <span class=\"rif-span rif-addition\">לא</span>"
  }
