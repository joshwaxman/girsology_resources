      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהודה כיון שהיא <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>מרובה אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא ארבי יוחנן בן נורי והא",
