    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עכברים אינן נחסרים כל כך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכולי האי לא אכלי עכברים",
