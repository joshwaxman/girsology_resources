      "right": "275px",
      "text": "אי איסתפק מינייהו וידע כמה איסתפק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מינייהו חזינן דידיה כמה הוו ודחבריה",
