      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריכה קנין דהיינו שניהם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריכין להקנות זה לזה זה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימחול החצי וזה ישלם החצי",
      "segment_ids": [
