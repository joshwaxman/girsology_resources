    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמחסר להנאת עצמו אבל אם אינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נהנה בו אלא כגון השופך יין",
