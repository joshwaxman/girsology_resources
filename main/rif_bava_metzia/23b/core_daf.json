        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאילו מסברא אין לחייב שולח",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יד אלא כשמחסר מחברו מקצת אז",
