      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דיין אמר חייב אתה חשוב כמו צא ויהיה",
      "segment_ids": [
