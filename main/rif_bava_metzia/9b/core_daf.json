        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תן לו וטבח או מכר את\"כ הוי גזלן עליו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ה\"נ יש לו דין גזלן לכל מילי כמו שיתבאר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פיסולו לכמה דברים ומיהו יש פוסקים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרי האידנא לא ידעי אינשי לחלק בין",
      "segment_ids": [
