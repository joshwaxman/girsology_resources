      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 19a:14\" data-ror-ocr=\"וליתנה ולהורישה לאתר ע ו ל : ואי לא לא\">לא</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 19a:15\" data-ror-ocr=\"הויא מחנה. בממיה כל שכן לאי יהיב\">קני - בתמיה כל שכן דאם יהיב</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 19a:15\" data-ror-ocr=\"ליה עכשיו ג ו ף ופירות מעכשיו לקני ט פ י :\">ליה גוף</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 19a:15\" data-ror-ocr=\"ליה עכשיו ג ו ף ופירות מעכשיו לקני ט פ י :\">ופירות במעכשיו דקני טפי</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 19a:15\" data-ror-ocr=\"מ ר ע לא ז ט א אלא לאתר מימה רמתמת\">מרע לא קניא</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 19a:15\" data-ror-ocr=\"מ ר ע לא ז ט א אלא לאתר מימה רמתמת\">לו אלא לאחר מיתה דמחמת</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 19a:15\" data-ror-ocr=\"מיתה הוא מצוה: הא אמר מנו נותטן.\">מיתה הוא מצווה:</i>"
      },
