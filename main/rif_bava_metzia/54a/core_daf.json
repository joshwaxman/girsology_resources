        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואם לאו פטור אמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">הוא</i> <i class=\"footnote\">בשם</i> <i class=\"footnote\">רבה</i>",
