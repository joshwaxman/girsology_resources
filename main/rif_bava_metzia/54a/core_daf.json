    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין זה אונס וכ\"כ הרמב\"ם ז\"ל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פ\"ג מהל' שכירות. אם יכול",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להציל כו' ואם אין הדבר ידוע",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב לשלם: <b>גמ' ארי ודרס.</b> ארי",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרכו לדרוס הבהמה במקום",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמוצאה ודרך הזאב לטורפה חיה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומוליכה במקום שהוא בטוח ושם",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הורגה: <b>אם היה יכול להציל.</b>",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברועים ובמקלות ואם לאו פטור",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דעת הריא\"ף ז\"ל דאפילו עאל",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעידנא דלא עיילי אינשי ולא",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמע קול אריה אומדים אותו ואם",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינו יכול <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ט\" data-order=\"9\"></i>להציל פטור כיון",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא בא האונס מחמת הפשיעה",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאין זה תחבולה לינצל מאונס",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה כלל אבל הראב\"ד ז\"ל כתב",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיינו דוקא כשמתה מחמת מלאך",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המות אז הוא פטור משום דאין",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תחבולה לינצל אבל מחמת ארי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמאי פטור כיון דעאל בעידנא",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלא עיילי אינשי ה\"ל",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעיולינהו בהדיה דאילו",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עיילינהו לא מטא ליה פסידא",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלום הלכך חייב ונראה שדברי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרשב\"א ז\"ל נוטה לדעתו ולפ\"ז",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הא דאמרי' הכא פטור היינו",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא דעאל בעידנא דעיילי",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינשי: <b>ולא קדם חייב.</b> ומשלם",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכל כיון שלא קדם דפושע הוא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפילו אם היה מציל היה נוטל",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכר המצילין מבעל הבית מ\"מ",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עכשיו שפשע אין מנכין לו כלום",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכן היה נראה לכאורה וכן נראה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלשון הרמב\"ם ז\"ל פ\"ג מהל'",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכירות אלא שהראב\"ד ז\"ל כתב",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו בהשגות דבר זה צריך",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירוש שאינו משלם כל דמי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבהמות אלא מנכין לו השכר",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיה צריך לשכור רועים להציל:",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אלא ששומר חנם.</b> יש לו לקדם בחנם ולא לשכור אנשים משלו וש\"ש יש לו לשכרם: <b>עד כדי דמיהן.</b> של בהמות: <b>והיכן מצינו וכו'.</b>",
      "segment_ids": [
        13,
        14,
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דקא רמית עליה לשכור אנשים משלו: <b>דהדר שקיל.</b> תירוצא הוא כלומר לא יפרע כלום משלו דהדר שקיל מבעה\"ב: <b>ונפקא מיניה.</b>",
      "segment_ids": [
        15,
        16,
        17
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וא\"ת א\"כ מה ירויח בעה\"ב אם יתן כדי דמיהן: <b>לטירחא יתירתא.</b> שלא יצטרך לחזור לקנות בהמות: <b>כושרא דחיותא.</b> כושר הבהמות",
      "segment_ids": [
        17,
        18,
        19
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמכיר בהם ולמודות בביתו: <b>הא מסר נפשיה.</b> הלסטים ע\"מ כן בא או להרוג או יקח ממון אבל הרועה אין לו למסור נפשו על כך",
      "segment_ids": [
        19,
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והא דאמרינן פטור משמע דאפילו תפס בעל הבהמה דמי בהמתו מן הרועה בפניו או בפני עדים <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"י\" data-order=\"10\"></i>מפקינן מיניה כדאיתא פרקא קמא",
      "segment_ids": [
        20
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמכילתין: <b>מתני' סיגפה.</b> עינה אותה ברעב או העמידה בקיץ בחמה ובחורף בצנה לענות נפש (במדבר ל) מתרגמינן לסגפא נפשא:",
      "segment_ids": [
        20,
        21
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עלתה לראשי צוקין וכו' אונס.</b> פירשה הריא\"ף ורש\"י ז\"ל בשתקפתו ועלתה וכדאוקימנא לה פרק המפקיד [דף לו:] ואע\"ג דלא",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צריכינן לאוקמוה התם הכי אלא לאביי דאמר שכל שתחלתו בפשיעה וסופו באונס חייב אע\"פ שאין האונס בא מהפשיעה אבל לרבא",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דהלכתא כוותיה דאמר פטור לא צריך תקפתו היינו משום דרבא אמר לעיל [שם] הכי אליבא דרבה דסבר דכל דנטר כדנטרי אינשי",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פטור דאליביה הוא דפליגי אביי ורבא אבל אנן דלא סבירא לן כרבה אלא מחייבינן אי שריג חדא מינייהו במיא משום טעמא",
      "segment_ids": [
        22
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאיבעי לאעבורי חדא חדא לא משכחת לה הרי זה אונס אלא בשתקפתו ועלתה כן העלו המפרשים בשם הרמב\"ן ז\"ל: <b>צוקין.</b> הרים",
      "segment_ids": [
        22,
        23
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חדים וגבוהים: <b>גמ' מתנה שומר חנם להיות חייב כשואל.</b> דכל תנאי שבממון תנאו קיים הן לחיוב כי הכא הן לפטור כי מתני':",
      "segment_ids": [
        23,
        24
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אפילו תימא שלא קנה.</b> וקי\"ל כרבי יוחנן דלא בעיא קנין דכיון דכבר הוא בחיוב השומרים יכול להתנות אפילו בדברים",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "להתחייב יותר אבל בדבר שלא היה בדין השומרים כלל בעינן קנין כדאמרינן פרק הזהב [דף נח.] גבי השוכר את הפועל לשמור",
      "segment_ids": [
        25
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "את הזרעים: <b>מתני' תנאו בטל.</b> בדבר שאינו של ממון: <b>שיש מעשה בתחלתו.</b> שהקדים מעשה שעליו לעשות לתנאו שהוא שואל ממנו",
      "segment_ids": [
        25,
        26,
        27
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כגון הרי מעשה זה שלך על תנאי שתעשה לי דבר פלוני דלא דמי לתנאי בני ראובן אם יעברו ונתתם היינו תנאי קודם למעשה:",
      "segment_ids": [
        27
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תנאו בטל.</b> והרי המעשה קיים ואף על פי שלא קיים בעל התנאי את התנאי: <b>כל שא\"א.</b> בגמרא מפרש לה: <b>גמ' זו דברי רבי יהודה</b>",
      "segment_ids": [
        28,
        29,
        30
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בן תימא.</b> דקאמר שאפשר לקיימו הא אי אפשר לקיימו תנאו בטל והמעשה קיים:",
      "segment_ids": [
        30
      ]
    }
  ],
