        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להו דליקו ברשותי <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>דכל היכא דאזלי שבקו",
      "segment_ids": [
        0
