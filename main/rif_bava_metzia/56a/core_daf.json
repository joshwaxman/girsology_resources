  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> שאלה להרא\"ש ז\"ל ראובן השאיל חפץ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לשמעון והפסידו אמר שמעון לראובן השבע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמה היה שוה ואפרענו לך והשיב בעל החפץ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השבע אתה ואפסד. תשובה ישבע בעליו ויפרע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שכנגדו על פי שבועתו ואם לא ישבע לא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יפרע שכנגדו ואינו נקרא מחויב שבועה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואינו יכול לישבע שמשלם. והשואל חמור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לרכוב עליו שלוחו ומת בדרך והדבר ספק אם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחמת מלאכה מת או לאו ה\"ז פטור מתשלומין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דהא אין החיוב בא על השואל רק עד שעת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האונסין ובשעת האונסין ספק הוא דלמא מתה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחמת מלאכה שהרי זה כאומר איני יודע אם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הלויתני אם לאו אבל השואל חמור לרכוב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא עליו ונתן לשלוחו ששינה מדעת המשאיל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומת החמור בדרך ביד השליח והדבר מסופק",
      "segment_ids": [
