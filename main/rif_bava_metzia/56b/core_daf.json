        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שישבע אם הוא כדבריו שלא מתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השאולה [דהכי הוה עדיף טפי",
