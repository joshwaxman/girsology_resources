  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "משלם גרסינן בפרק הגוזל [ומאכיל] <span class=\"bavli-ref\" data-bavli-ref=\"(דף קיב.)\" data-bavli-daf=\"112a\" data-bavli-index=\"0\"></span>אמר",
