  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>[גרסי' בגמ'] זה אומר שאולה וזה אומר שכורה ישבע השוכר וכו'.</b> ואמאי מה שטענו לא הודה לו ומה שהודה לא טענו אמר עולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"י גלגול דא\"ל אשתבע לי מיהת דכדרכה מתה ומגו דמשתבע דכדרכה מתה משתבע נמי דשכורה מתה: <b>מה שטענו לא הודה לו.</b> לפום",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פשטא דמתני' דלא מיירי אלא באחת שאולה קא מקשה דכיון שטענו בשאולה והוא לא הודה לו בה אלא הודה לו במה שלא טענו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דהיינו שכורה א\"כ ה\"ל כשני מינים שאם טען לו במין אחד והודה לו במין אחר אין בו חיוב שבועה וה\"נ דכוותה משום דהוה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סלקא דעתך דהאי ישבע הוא",
