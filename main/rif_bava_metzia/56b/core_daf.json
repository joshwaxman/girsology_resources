        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שישיב על טענתו ואפילו לרב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נחמן ועיין בתוספות] ולענין",
