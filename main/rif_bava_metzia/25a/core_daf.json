      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "או שלא היתה מעוברת ונתעברה אצלו וילדה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבית שמאי סברי <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>משלם אותה ואת גזותיה",
