      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתב הרנב\"ר ז\"ל בחדושיו ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ערער בדבר: <b>לימא קסבר וכו'.</b>",
      "segment_ids": [
