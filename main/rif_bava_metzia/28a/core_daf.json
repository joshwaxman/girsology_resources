      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא יהיב טעמא למילתיה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ו\" data-order=\"6\"></i>משום",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכחליפין דמו: <b>לא רב הונא כר'</b>",
