        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידיע פחתה זוזי לא ידיע פחתייהו אמר רבא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Creditor and Debtor\" data-label=\"⚬\"></i>שרי ליה לאיניש למימר ליה לחבריה הילך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארבעה זוזי ואוזפיה לפלניא זוזי לא אסרה",
