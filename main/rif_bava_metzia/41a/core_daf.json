    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדרי בעינייהו שרי דלא הוי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כאגר נטר ליה אלא אגר",
