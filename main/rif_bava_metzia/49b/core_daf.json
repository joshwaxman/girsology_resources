        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני שהקטנית מחלקת: <b><big>גמ'</big></b> והיכא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>דלא שני",
