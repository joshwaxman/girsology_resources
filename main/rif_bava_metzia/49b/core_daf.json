        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "משלמי דתרוייהו פשעי א\"ר <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>נחמן המוכר <i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Sales\" data-label=\"⚬\"></i>פרה לחבירו <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>וא\"ל פרה זו <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>נשכנית היא",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רבצנית היא בעטנית היא והיה בה מום אחר וסנפו בין המומין <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>האלו הרי זה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מקח טעות מום זה ומום אחר אין זה מקח טעות פירוש פרה זו לא היתה לא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רבצנית ולא נשכנית ולא בעטנית אבל היה בה מום אחר שאינו ניכר ומנאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "המוכר עם אלו המומין שאינן בה אע\"פ שהזכירו לו ומנאו בתוך אלו המומין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הרי זה מקח טעות שהוא אומר לו כשראיתי שאינה נשכנית ולא רבצנית ולא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בעטנית אמרתי כשם שאין אלו המומין בה כך זה המום האחר אינו בה ולהשביח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דעתי הוא אומר לי כך הלכך ה\"ז מקח טעות ואינו יכול לומר לו כבר הודעתיך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אבל הראהו מום אחר שהוא ניכר ונראה לעינים ואמ לו פרה זו יש בה מום זה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ויש בה עוד מום פלוני ולא היה נראה לעין אין זה מקח טעות שהרי לא הטעהו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ולא אמר לו אלא מומין שבה תניא כותיה דר' יוחנן המוכר שפחה לחבירו ואמר",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לו שפחה זו שוטה היא נכפית היא שעמומית היא היה בה מום אחר וסנפו בין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "המומין הרי זה מקח טעות מום זה ומום אחר אין זה מקח טעות אמר ליה רב אחא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בריה דרבא לרב אשי <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">עי'</i> <i class=\"footnote\">כ\"מ</i> <i class=\"footnote\">פט\"ו</i> <i class=\"footnote\">מהל'</i> <i class=\"footnote\">מכירה</i> <i class=\"footnote\">הל\"ז</i>היו בה כל המומין הללו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ג\" data-order=\"3\"></i>מאי <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>אמר ליה רב מרדכי לרב אשי הכי אמרינן משמיה דרבא <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>היו בה כל המומין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הללו <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>אין זה מקח טעות:",
