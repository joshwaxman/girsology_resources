      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בבא לצאת ידי שמים וראיה דתנן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרק הגוזל בתרא (דף קיח.) אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איני יודע אם גזלתיך ואם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפקדת אצלי פטור ואוקימנא לה",
      "segment_ids": [
