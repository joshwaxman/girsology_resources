  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דינא דלא הוי לא כשומר שכר ולא כשומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנם אלא כההוא דאמר לחבריה הא ביתא קמך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבל האי מעשה דיהבו ליה זוזי אשומשמי",
      "segment_ids": [
