  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "שבחא: ומאי דפייש ליה ללוקח מהוצאה לא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקיל מיני' כלום לא מבע\"ח ולא ממוכר דהא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איכא פסידא גביה מעיקרא דליכא שבחא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כנגדה: <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">עי'</i> <i class=\"footnote\">עוד</i> <i class=\"footnote\">ברי\"ף</i> <i class=\"footnote\">פרק</i> <i class=\"footnote\">המקבל</i> <i class=\"footnote\">סימן</i>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">תקע\"ד</i>הדין כללא דשמעינן מהא שמעתא בדינא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבע\"ח בהדי לוקח. ועוד שמעינן מינה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדיניה דלוקח בהדי גזלן ונגזל. דהיכא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דזבין לוקח ארעא מגזלן ואשבחה ואתא נגזל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאפוקה מיניה דלוקח דינא הוא דשקיל לה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נגזל ולשבחא דאית בה וחזינא ליה לשבחא אי הוי יתר על הוצאה שקיל לה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "להוצאה מנגזל דשבח הוצאה גביה דנגזל הוא ואיהו מתהני ביה. ומאי דפייש",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ליה משבחא שקיל ליה מגזלן שכך <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>כותב לו אנא איקום ואישפי ואידכי וכו'.",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "וה\"מ בשלא הכיר בה שאינה שלו אבל הכיר בה שאינה שלו ולקחה אין לו אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הוצאה בלבד מנגזל ומאי דפייש <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>מן שבחא פסיד ליה ולא שקיל ליה מיניה כלום",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כדאמר רבא הכיר בה שאינה שלו ולקחה מעות יש לו שבח אין לו. ואם הוצאה",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יתירה על השבח אין לו הוצאה אלא שיעור שבח מנגזל ולא שקיל מיניה דגזלן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כלום אלא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>קרנא דשקיל מיניה בעידן זביני בלחוד בין הכיר בה שאינה שלו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ולקחה בין לא הכיר בה דהא איכא פסידא גביה מעיקרא: ואיכא מאן דאמר הא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דשמואל <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>שינויא <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>דחיקא היא ולא סמכינן עלה ולעולם נוטל הלוקח ההוצאה מבע\"ח",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כפשוטה דהא מתניתא דלא גרע מיורד לשדה חבירו שלא ברשות דקיימא לן שמין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לו וידו על התחתונה ואנן מסתברא לן דלא דמי לוקח ליורד לשדה חבירו שלא",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ברשות דיורד לשדה חבירו שלא ברשות ונטעה שלא ברשות אדעתא דשקיל ממרא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דארעא הוא דמשבח בה בגופיה ובממוניה אבל לוקח כי מפיק ממוניה או משבח",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בידיה לאו אדעתא דשקיל ליה מבע\"חהוא דעבד הכי אלא אדעתא דאי מפיק לה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בע\"ח מיניה הדר עליה דמוכר ושקיל מיניה כוליה ממונא בין קרנא בין הוצאה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בין שבחא דאתי ממילא והיינו דקא מסייע ליה רבא לשמואל ואמר תדע דבע\"ח",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "גובה את השבח שכך כותב לו מוכר ללוקח אנא איקום ואישפי ואידכי ואמרוק",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "זביגי אילין אינון ועמליהון וצבי זבינא דנא וקביל עלוהי ופירוש עמליהון",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שבחא דמשבח לוקח בידיה דהדר שקיל ליה מיניה דמוכר וכל שכן שבחא דמשבח",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בממוניה דלא שקיל אלא מיניה דמוכר לפום הדין תנאה דקביל עלוהי ומהאי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "טעמא לא שקיל ליה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>מבע\"ח היכא דמסיק ביה במוכר שיעור ארעא ושבחא והרי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מתנה דלא כתיב בה האי תנאה לא טריף בע\"ח שבחא דיליה ושמעת מיניה דמשום",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הדין תנאה הוא דטריף בע\"ח <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>שבחא בין שבחא דאתי ממילא בין שבחא דאתי מחמת",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הוצאה: אמר שמואל בע\"ח גובה את השבח <span class=\"bavli-ref\" data-bavli-ref=\"(דף יד: טו.)\" data-bavli-daf=\"29a\" data-bavli-index=\"0\"></span>שבח אין פירות לא פירוש הני פירות",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דלא גבי להו בע\"ח פירות דאכל להו לוקח נינהו אי נמי פירות דתלישי אבל",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "פירי דאיתנהו האידנא מיחברי בארעא גבי להו בע\"ח והיינו דאמרינן והא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מעשים בכל יום וקא מגבי שמואל אפילו בשבח המגיע לכתפים <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ג\" data-order=\"3\"></i>והם הפירות",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>שהגיעו ליבצר ולהינטל על הכתף <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>: <span class=\"bavli-ref\" data-bavli-ref=\"(דף טו:)\" data-bavli-daf=\"15b\" data-bavli-index=\"1\"></span>בעא מיניה שמואל מרב הלוקח שדה מחבירו",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ונמצאת שאינה שלו דמקחו בטל <i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Sales\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Robbery and Lost Property\" data-label=\"⚬\"></i>אם חזר המוכר ולקחה מבעלים הראשונים מהו",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מקחו קיים או לא א\"ל מה מכר לו ראשון לשני כל זכות שתבא לידו כלומר",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">ברא\"ש</i> <i class=\"footnote\">העתיק</i> <i class=\"footnote\">כיון</i> <i class=\"footnote\">[וכ\"ה</i> <i class=\"footnote\">בד\"ס]</i>ביום שחזר הגזלן ולקחה מנגזל וקנאה <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ד\" data-order=\"4\"></i>קנין",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "גמור נתקיימה ביד הלוקח שלקחה מגזלן דכי זבנה <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>לוקח <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ד\" data-order=\"4\"></i>שלקחה מגזלן בכל זכות",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שתבא לידיה זבנה ניהליה. מ\"ט מר",
      "segment_ids": [
        11,
        12
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>איתמר המוכר שדה לחבירו ונמצאת שאינה שלו.</b> שאינה של מוכר שהיתה גזולה בידו והנגזל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בא ומוציאה מיד הלוקח: <b>יש לו מעות.</b> ללוקח מן המוכר: <b>ויש לו שבח.</b> אם השביח את",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הקרקע קודם שהוציאה נגזל מידו גובה הלוקח השבח בין שבחא דממילא כגון דיקלא ואלים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "[ארעא] ואסקא שרטון בין שבחא דמחמת הוצאה במה שהוא יתר על ההוצאה אבל שבח דכנגד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוצאה לא דמנגזל קא שקיל ליה.",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפילו לא השביח אלא מה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהכסיף הגזלן וכגון שכשגזלה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה הקרקע (עמו) משובחת כמו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיא עכשיו אלא שהגזלן הכסיפה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשגזלה ועכשיו הלוקח החזירו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליושנו בשבחו אפ\"ה שקיל אותו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבח מנגזל והדר נגזל ומשתעי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דינא בהדי גזלן כ\"כ הראב\"ד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל אע\"פ שאין פרש\"י ז\"ל כן:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אמר</b> רבא הלכתא פסק כרב ופריש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לנו דהלכתא כוותיה אף בשלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירש הלוקח לגזלן בשעת מכירה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאם יטרפוה ממנו יתחייב לתת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו השבח שישביח בקרקע. נמצא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיכא דלא הכיר בה מיחייב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוכר ללוקח באחריות שבחא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשטרפה בע\"ח או כשטרפה נגזל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודיניהם שוים לגמרי אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשהוזל הקרקע יפה כח האחריות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היכא דטריף לה נגזל מהיכא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דטריף לה בע\"ח שאם מכרה במנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוזלה ועמדה בחמשים אי טריף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה בעל חוב אינו נותן לו אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חמשים כשיעור של עכשיו אבל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמצאת שאינה שלו כגון דאיגלאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מילתא שלא היתה מכורה מעולם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זוזי הלואה נינהו גביה וכיון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שטרפה ממנו מחזיר את כלן:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הכיר בה לוקח.</b> שהקרקע זו אינו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של מוכר שגזולה היא אצלו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו הכי לוקחה: <b>שבח אין לו.</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהמעות שנותן לו ודאי <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ה\" data-order=\"5\"></i>דלאו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשום מכירה יהיב להו אלא לשם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פקדון גמר ויהיב להו (ולהכי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמר ויהיב להו) ואע\"ג שלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הזכיר פקדון כלל אלא מכירה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואי הוה שקיל שבח היה נראה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרבית וכשקיל שכר מעותיו.",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומיהו לאו פקדון גמור נינהו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאם נאנסו נאנסו ללוקח דלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גרע ממפקיד מעות אצל שולחני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרינן בפרק המפקיד (דף מג.)",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שישתמש בהן ולפיכך אם נאנסו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב באחריותן לפי שכל מי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהפקיד מעות אצל חנוני על דעת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיוציאם הוא מפקידם אף כאן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לוקח זה על דעת שיוציאם מוכר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתנם לו ורשאי להשתמש בהם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלכך אם נאנסו חייב באחריותן:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ודעת</b> הרז\"ה ודעת הרשב\"א ז\"ל דכי אמרינן הכא שבח אין לו ה\"מ בשאין לו קרקע ולא קנו מידו הא אם קנו מידו או שיש לו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קרקע היכא שכתב לו האחריות אפילו שבח יש לו משמע דס\"ל ז\"ל דכל היכא שיש לו לגזלן קרקע אחר שיגבנו הלוקח כנגד קרקע",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זה ושבחו שטרפו ממנו הנגזל בכי ה\"ג לא מיחזי כרבית כיון דלאו לשום הלואה נתנה לו וכן הדין כשקנו מידו [על השבח דהוי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המוכר מיחייב משעת המכר] קודם (שהוא שומר) שכר המתנה במעות [ובכי האי גוונא] לא מיחזי כרבית אלא שהרנב\"ר ז\"ל כתב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו מחוור בעיניו דכיון דהכיר ומעות הללו לפקדון דומיא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ו\" data-order=\"6\"></i>דמלוה יהבינהו [ניהליה] אף על פי שפירש לו את השבח אין לו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא כמתנה על שכר המעות: <b>ואחריות טעות סופר וכו'.</b> לאו דוקא בשטרי הוא דקאמרינן אלא אפילו מוכר שדהו בעדים דקי\"ל",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "(ב\"ב דף מא:) דגובה מנכסים משועבדים אף על פי שלא פירשו אחריות כלל גובה שאין אחריות צריך לפרש וכמו שכתבנו למעלה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וכן כתבו הרשב\"א והרנב\"ר ז\"ל והכי מוכח ההיא דמכר לו בית מכר לו שדה פרק חזקת הבתים [דף מג:] והוי יודע [כי] שלשה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מיני אחריות הם אחריות דנפשיה אחריות דמחמתיה אחריות דעלמא אחריות דנפשיה כגון שיש [לו] זכות בקרקע זה שמכר כי ההיא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרינן בפרק מי שהיה נשוי (דף צא:) <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ז\" data-order=\"7\"></i>סבר רמי בר חמא למימר איהו במקום אימיה קאי אמר ליה רבא נהי דאחריות דאימיה לא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קביל עלויה אחריות דנפשיה מי לא קביל עלויה וכדאיתא התם. אחריות דמחמתיה כגון בעל חוב דידיה. אחריות דעלמא כגון",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נמצאת שאינה שלו ושלשה מיני אחריות הללו זה למעלה מזה ולפיכך כתב הרב האי גאון ז\"ל בספר המקח דנהי דמסתמא אחריות",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "טעות סופר הוא ואע\"פ שלא פירש כולם בכלל היכא שפירש אחד מהם הרי הוא כאילו מיעט אותו שלמעלה ממנו ולפיכך אם פירש לו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחריות דנפשיה הרי הוא כאילו מיעט אותו דמחמתיה ולמעלה ממנו ואם פירש דמחמתיה הרי מיעט דעלמא שהוא למעלה ממנו אבל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פירש דעלמא. דמחמתיה ודנפשיה שהם למטה ממנו בכלל ואם פירש דמחמתיה נהי שאין דמעלמא בכללו שהוא למעלה ממנו. דנפשיה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא למטה ממנו בכלל שכל מה שהוא למטה ממה שפירש אפילו תאמר שאינו כאילו נתרבה בפירוש [מיהו] לא נתמעטה וחזר הדבר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לדינו דאחריות טעות סופר הוא וכאילו לא נכתב כלל אבל במתנה דאחריות לאו טעות סופר הוא צריך לפרש את כולן הא קבל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עליו אחד ממיני אחריות שזכרנו אין לך בו אלא פירושו בלבד אבל לא של מעלה ממנו ושלמטה ממנו אלו דברי גאון ז\"ל כמו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שכתבם הרמב\"ן ז\"ל וביאר טעמן כדי לישבן ולהולמן הרנב\"ר ז\"ל: <b>בעא מיניה שמואל מרב חזר ולקחה מבעלים הראשונים מהו.</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "פירוש חזר ולקחה לוקח קרקע מגזלן שמקחו בטל אם חזר גזלן ולקחה מבעלים הראשונים לאחר שמכרה ללוקח מהו להיות הוא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במקום בעלים כאילו לקחה אחר ויוציאנה מן הלוקח: <b>א\"ל</b> לא מצי לאפוקי <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ח\" data-order=\"8\"></i>כשמכרה לו מכר לו כל זכות שתבוא לידו בה וכשלקחה",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא לקח אלא לאוקמה קמי לוקח שתהא מקוימת בידו ודוקא בלא הכיר בה הא בהכיר בה לא קנה דלא שייך למימר הני טעמא דלא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ניחא ליה וכו' כדלקמן: <b>מ\"ט.</b> כלומר במה קנאה דהא דבר שלא בא לעולם הוא:",
      "segment_ids": [
        9,
        10
      ]
    }
  ],
