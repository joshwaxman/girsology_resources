  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אבל אינו דומה.</b> ואומדים להם כמה אדם רוצה לפחות משכרו ויהיה בטל משיטרח כל היום ויטול יותר ויתנו לו כפי הראוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לעומד בטל וכגון שאין מוצאין עכשיו להשכיר עצמן אבל אם יכולים להשכיר עצמן אחר שחזרו מן השדה אומר להם השכירו עצמכם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וראיה דאמרינן לקמן [דף עט:] גבי השוכר את הספינה ופרקה בחצי הדרך דאי משכח לאוגרה אין לו עליו אלא תרעומת וה\"נ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תניא בתוספתא [פרק ז] השוכר את הפועל וגמר חרישו בחצי היום והראה לו בשל חבירו יכול לומר לו או פרנס לי מלאכה מתוך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלך או תן לי מה שעשיתי אלמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאפי' התחיל במלאכה כל שהוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מראה לו מלאכה בשל חבירו אינו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יכול לתובעו אלא כמה שעשה:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בד\"א שלא התחילו במלאכה.</b> לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקט הכא הלכו כדלעיל משום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהשתא מיירי בחזרה דפועלים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופועלים כשחוזרים בהם בדבר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו אבד אין חייבים לשלם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלום מכיסם אלא מחשבין להם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במה שעשו לפרוע מה שיפסיד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעה\"ב ולפיכך נקט הכי: <b>בד\"א</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין לבעל הבית על הפועלים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא תרעומת כשלא עשו מקצת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלאכה אבל עשו מקצת מלאכה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחלוקת ר' דוסא וחכמים דלר'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוסא דקי\"ל כוותי' בקבלן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדלקמן מפסידים ממון מה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהתחילו במלאכה: <b>שמין להם מה</b>",
      "segment_ids": [
