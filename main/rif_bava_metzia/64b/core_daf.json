    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b><i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>.</b> אמר אם באתי ליקח אצלם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יסלקוני אקנה אני בית סאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באמצע ואהיה אני מצרן לכל רוח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואקנה אני לכל צד ולא יוכלו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לסלקוני מן <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ז\" data-order=\"7\"></i>המצר ומן המותר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכל צד הלכך מהשתא מסלקינן",
      "segment_ids": [
