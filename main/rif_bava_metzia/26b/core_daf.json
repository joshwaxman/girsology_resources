      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היה צריך לזה דדברי הגאון מתישבים שפיר",
      "segment_ids": [
