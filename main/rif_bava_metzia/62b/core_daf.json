  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דילמא פרעיה דקי\"ל המפקיד אצל חברו בשטר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואמר לו החזרתי לך נאמן והאי דלא אמר",
