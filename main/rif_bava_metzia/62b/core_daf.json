        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביה ואזל ליה לדוכתא אחריתי ובעא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למפלגיה לההוא עיסקא או זוזי דעיסקא קמי",
