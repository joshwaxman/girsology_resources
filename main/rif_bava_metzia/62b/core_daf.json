        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "החזרתי בדאיתיה בחיים אימור מלאך המות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אנסיה ולהכי לא גבי ליה מיתמי <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>והיכא",
