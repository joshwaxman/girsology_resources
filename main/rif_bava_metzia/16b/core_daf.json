      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 30b:4\" data-ror-ocr=\"שם רואין כ״כ ואינו בוש: ולא בעיר.\">בוש: ואין דרכו</i> <i class=\"ror-gap\" data-ror-gap=\"1\">⋯</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 30b:4\" data-ror-ocr=\"בעיא היא אס הוא חייב להתחיל בהשבה\"><i class=\"ror-printed-only\" data-ror-ocr=\"בעיא היא אס הוא\" data-ror-chars=\"12\">°</i> <i class=\"ror-talmud-only\" data-ror-chars=\"18\" data-ror-talmud=\"מהו - שיתחייב להשיבה: לא מיחייב\">°</i> - להתחיל</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 30b:4\" data-ror-ocr=\"בעיא היא אס הוא חייב להתחיל בהשבה\">בהשבתה</i> <i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 30b:4\" data-ror-ocr=\"בשדה ו ט ו ן דאימייב והזיזה ממקומה מתחייב\">בשדה: וכיון דאיחייב -</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"12\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 30b:4\" data-ror-ocr=\"בשדה ו ט ו ן דאימייב והזיזה ממקומה מתחייב\">שהזיזה ממקומה חייב</i> <i class=\"ror-line\" data-ror-i=\"13\" data-ror-conf=\"medium\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 30b:4\" data-ror-ocr=\"א ף בעיר כמו בהכישה: עוען ופורק. משא\"><i class=\"ror-printed-only\" data-ror-ocr=\"כמו בהכישה: עוען ופורק.\" data-ror-chars=\"14\">°</i> אף בעיר:</i>"
      },
