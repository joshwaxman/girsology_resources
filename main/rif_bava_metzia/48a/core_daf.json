      "left": "",
      "text": "ליה זוזי ליום פלוני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאיצטריכו ליה זבן דאילו לא",
