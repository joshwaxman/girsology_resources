      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהכי לא זבן וכ\"כ ר\"ח ז\"ל:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דאמר רבא וכו' לא קני.</b> הסכימו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האחרוני' ז\"ל לפירוש הגאונים",
      "segment_ids": [
