      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"14\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 100a:21\" data-ror-ocr=\"הילך הוא. זה שמורה עליו מוכן הוא\">ליטלו</i> <i class=\"ror-gap\" data-ror-gap=\"4\">⋯</i> <i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 100b:1\" data-ror-ocr=\"מה שטענו (לו) לא הודה לו. י ע ל כסות\">מכרתי לך: כסות מה</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"19\" data-ror-conf=\"high\" data-ror-by=\"\" data-ror-ref=\"Rashi on Bava Metzia 100b:1\" data-ror-ocr=\"מה שטענו (לו) לא הודה לו. י ע ל כסות\">שטענו לא הודה לו - ועל כסות</i>"
      },
