    {
      "width": "380px",
      "right": "275px",
      "text": "עליו הראיה אמר ר' חייא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">אי'</i> <i class=\"footnote\">בר</i>",
