        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמיד לעין כל: <b>ארעא נמי.</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירוש כשבא בטענת קרקע שאומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקוחה היא בידי יהא נאמן לגבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירי מהאי טעמא דלא חציף וכו'",
      "segment_ids": [
