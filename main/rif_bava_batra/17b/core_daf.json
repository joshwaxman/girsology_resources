      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעלות: <b>לגדור.</b> גבי תמרים שייך",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשון גדירה כמו מסיקה בזיתים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בצירה בענבים: <b>ואיגדריה</b>",
      "segment_ids": [
