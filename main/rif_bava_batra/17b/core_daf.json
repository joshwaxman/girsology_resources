  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "א\"ר זביד ואם טען נאמר לפירות ירדתי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאמן מי לא אמר רב יהודה האי מאן דנקיט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מגלא ותובילא ואמר בעינא למיגזריה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לדיקלא <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>דפלניא דזבניה ניהלי מהימן מ\"ט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא חציף איניש למיגזר דיקלא דלא דיליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ה\"נ לא חציף איניש דאכיל פירי דלא דיליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אי הכי אפילו ארעא נמי ארעא אמרינן ליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחוי שטריך פירי נמי אמרינן ליה אחוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שטריך שטרא לפירי לא עבדי אינשי ההוא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דא\"ל <i data-commentator=\"Mishneh Torah, Plaintiff and Defendant\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>לחבריה מאי בעית בהאי ארעא א\"ל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מינך זבינתה ואכלתה שני חזקה אייתי חד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סהדא דאכלה תלת שנין סבור רבנן קמיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאביי למימר היינו <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>סברא דר' אמי דההוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גברא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>דחטף נסכא מחבריה אתא לקמיה דר'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמי הוה יתיב רבי אבא קמיה אזל אייתי חד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סהדא דמחטף חטפה מיניה א\"ל אין חטפי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודידי חטפי אמר ר' אמי <span class=\"bavli-ref\" data-bavli-ref=\"(דף לד.)\" data-bavli-daf=\"34a\" data-bavli-index=\"0\"></span>היכי לידיינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דייני להאי דינא לישלם ליכא תרי סהדי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליפטריה איכא חד סהדא לישתבע דלא חטף הא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קא מודה דאין חטפי ודידי חטפי א\"ל רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבא הוה ליה מחויב שבועה ואינו יכול",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לישבע וכל המחויב שבועה ואינו יכול",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לישבע <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>משלם אמר ליה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>מי דמי התם חד סהדא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאורועי קא אתי אי איכא סהדא אחרינא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהדיה מפקינן לה מיניה הכא חד סהדא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לסיועיה קא אתי אי איכא חד סהדא אחרינא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גביה מוקמינן לה בידיה אלא אי דמי ודאי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הא דר' אבא לחד סהדא ולתרתי שנין ולפירי כגון ראובן דא\"ל לשמעון האי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ארעא גזלתה מינאי ואכלתה תרתי שנין א\"ל שמעון מינך זבינתה ואכלתה שני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חזקה אזל אייתי חד סהדא דאכל תרתי שנין אילו אתו תרי סהדי דאכל תרתי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שנין הוה מחויב לאהדורי ארעא ופירי כדר\"נ דאמר הדרא ארעא והדרי פירי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "והשתא דלא אתי אלא חד סהדא אמרינן היכי נעביד נימא ליה אהדר פירי נמי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ליכא תרי סהדי דאכל ב' שנין ליפטריה איכא חד סהדא דאכל",
      "segment_ids": [
        2
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אי טעין ואמר לפירות ירדתי וכו'.</b> כלומר מתחלה אי לא טעין מינך זבינתה אלא לפירות ירדתי כדין אריס או שמכרת אותם לי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לזמן ידוע נאמן בשבועת היסת ודוקא בפירות שאכל כבר אבל לאכול מכאן ולהבא לא דא\"כ כל אדם ירד לתוך שדה חבירו ואומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לפירות ירדתי דהשתא ליכא למימר לא חציף איניש כדאמרינן בסמוך (דהיינו דוקא משום שאינו נאמן לומר כן) <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ח\" data-order=\"8\"></i>דכיון שיכול",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "להוציאו בעל השדה ועכ\"ז ירד אמרי' לא חציף דודאי היה ירא מלירד אם לא היה אמת כדבריו אבל אם היה נאמן לאכול מכאן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולהבא בטענה זו לא ישוב מפני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל: <b>תובילא.</b> סל לתת בו התמרים",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או חבל לעלות: <b>לגדור.</b> גבי",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמרים שייך לשון גדירה כמו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסיקה בזיתים בצירה בענבים:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואיגדריה לדיקלא וכו'.</b> אע\"ג",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהכא אפשר דמשום דכיון דאמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כן קודם שיגדור הוא דנאמן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאל\"כ כדבריו היה ירא שלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימנענו בעליו אבל הכא שכבר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אכל מ\"ט יהא נאמן אפ\"ה איכא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למימר דכיון דמשיך כל כך זמן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אכילתו כמ\"ד מתחלה דמי שהרי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה אוכל תמיד לעין כל: <b>ארעא</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נמי.</b> פירוש כשבא בטענת קרקע",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאומר לקוחה היא בידי יהא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נאמן לגבי פירי מהאי טעמא דלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חציף וכו' <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ט\" data-order=\"9\"></i>אבל לא מקשה שיהא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נאמן בגוף הקרקע דהא דמי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למכאן ולהבא ואף לגבי פירי לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהימן אלא במה שכבר אכל: <b>אחוי</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שטרך.</b> לאו דוקא דהא טעין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאכלה ג' שנים ולא מזדהר אלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או עדים שהחזקת או שטרך דהוה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לך לאזדהורי כיון שאין לך עדי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חזקה: <b>ההוא דא\"ל לחבריה וכו'.</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ארעא ודאי הדרא למריה כיון",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלית לה שני עדים אבל פירי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאי דלא ידעינן שאכל אלא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהודאת פיו אלא שיש בו נמי עד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד: <b>נסכא.</b> חתיכת כסף בלא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צורה: <b>ליכא תרי סהדי.</b> ועד א'",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינו מחייבו אלא שבועה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להכחישו ואין לנו בו אלא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שישבע להכחיש העד או שישלם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומשום הכי אינו נאמן לישבע",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דדידיה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"י\" data-order=\"10\"></i>חטף כי היכי דלא מצי",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למימר הכי אי איכא שני עדים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דודאי היו מחייבין אותו ממון לפי שהתורה האמינה <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"כ\" data-order=\"11\"></i>לעד א' להאי כשנים לענין ממון: <b><i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ל\" data-order=\"12\"></i>ה\"ל גזלן.</b> כלומר כגזלן כיון שמודה",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לדברי העד שחטפו ואינו נאמן לומר דידי חטפי לפי שנעמיד ממון בחזקת מי שהיה מוחזק בו: <b>הוי</b> מחוייב שבועה שאינו יכול",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לישבע שהרי מודה שחטף וליכא למימר ניהמניה במגו דאי בעי אמר החזרתי והיה נאמן בשבועה כי אמר נמי דידי חטפי יהא נאמן",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשבועה די\"ל דמיירי כשהנסכא יוצאה עכשיו מתחת ידו לפנינו דליכא מגו וכן השיב הרמ\"ה ז\"ל לרמב\"ן ז\"ל דאפילו גזלן נאמן",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לומר החזרתי והוכיחו מסוגיא דפרק האשה שנתארמלה [ריש דף יח.] דמקשה וליתני ומודה ר' יהושע וכו' ואילו גזלן לא היה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נאמן הוה מצי לאוקמי וליתני באומר לחבירו מנה גזלתי והחזרתי לך שהיה נאמן שהפה שאסר הוא הפה שהתיר והוי אתי שפיר",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "סיפא דליתני הכי ואם יש עדים שגזל והוא אומר החזרתי אינו נאמן אלא ודאי משמע שהיה נאמן והכא כדתירצנו: <b>ומחויב שבועה</b>",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שאינו יכול לישבע משלם.</b> וכתב הרנב\"ר ז\"ל דכי קאמרינן דמשלם בלא שבועה שכנגדו קאמר דדוקא גבי חשוד הוא דאמר (שבועות",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דף מד:) שישבע כנגדו שאינו חשוד [דאי לא תימא הכי לא שבקת חיי לחשוד אבל הכא לא] ויש לו ראיה בפרק שבועת העדות:",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מוקמינן ליה בידיה.</b> הלכך אע\"פ דהדרא ארעא דידעינן שהיא למערער וזה המחזיק אין לו עדים לא הדרי פירי דלא ידעינן אלא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפיו שאסר והוא הפה שהתיר דהעד כמאן דליתא דמי כיון דלסיועי קאתי: <b>לחד סהדא ולתרתין שנין <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"מ\" data-order=\"13\"></i>.</b> דהשתא לאורועי ליה אתי",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "העד שהעיד שלא החזיק שני חזקה ודמי ממש לנסכא דר' אבא דליכא תרי סהדי לחיובי לשלם הפירות: <b>למפטרי אי אפשר דאיכא חד</b>",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>סהדא.</b> דאכל ולא [יכול] לישבע שלא אכל להכחיש העד שהרי מודה שאכל אלא הוי מחויב שבועה שאינו יכול לישבע וישלם וכתב",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הריא\"ף ז\"ל בהלכותיו דאי ליכא אפילו חד סהדא דאכל והוא אמר מינך זבינתה ואכלתה שני חזקה והאי א\"ל מגזל גזלתיה מינאי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואכילתה תרתין שני משתבע ליה מרי ארעא דלא זבינת לך מידי ומהדר <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ו\" data-order=\"6\"></i>ולא מחייב לאהדורי ליה פירי דכיון דליכא סהדי דאכלה",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תרתי שנין אלא איהו קאמר אכלי משתבע שבועת היסת דליכא גביה דחבריה מידי מהני פירי דאכל ומהדר ליה ארעא ומפטר עכ\"ל:",
      "segment_ids": [
        14
      ]
    }
  ],
