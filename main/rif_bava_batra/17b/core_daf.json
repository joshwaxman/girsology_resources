      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון דמשיך כל כך זמן אכילתו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמ\"ד מתחלה דמי שהרי היה אוכל",
