      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ט\" data-order=\"9\"></i>אבל לא מקשה שיהא נאמן בגוף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקרקע דהא דמי למכאן ולהבא",
      "segment_ids": [
