      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Batra 11a:1\" data-ror-ocr=\"כלאמרינן בגיטין מפרנסין עניי עובד\">מפרנסין עניי עובדי</i> <i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Batra 11a:1\" data-ror-ocr=\"כוכבים עם עניי ישראל מפני לרט שלום:\">כוכבים עם עניי</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Batra 11a:1\" data-ror-ocr=\"כוכבים עם עניי ישראל מפני לרט שלום:\">ישראל מפני דרכי שלום: אתה אמרת</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"8\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Batra 11a:1\" data-ror-ocr=\"כוכבים עם עניי ישראל מפני לרט שלום:\">כו'</i> <i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Batra 11a:7\" data-ror-ocr=\"מתני&quot; טרקלין ומור!. מיני פלטרין הן:\"><i class=\"ror-talmud-only\" data-ror-chars=\"11\" data-ror-talmud=\"נפשות חכם בהאי קרא:\">°</i> מתני' טרקלין ומורן - מיני</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"9\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Batra 11a:7\" data-ror-ocr=\"מתני&quot; טרקלין ומור!. מיני פלטרין הן:\">פלטין: בית</i> <i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Batra 11a:8\" data-ror-ocr=\"ניס השלתין. מתוך שיש לו מעין [נ] וצדן\">השלחין - מתוך שיש לו</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"10\" data-ror-conf=\"high\" data-ror-ref=\"Rashi on Bava Batra 11a:8\" data-ror-ocr=\"ניס השלתין. מתוך שיש לו מעין [נ] וצדן\">מעיין ובידו</i> <i class=\"ror-line\" data-ror-i=\"11\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Bava Batra 11a:8\" data-ror-ocr=\"להשקותו ממיל אס אין בו ט׳ קבין\">להשקותו תדיר אם אין</i>"
      },
