      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דדאיר איהו דמי ועלתה לו חזקה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואע\"ג דלא דר ביה המשכיר הזה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו חד יומא דאע\"ג דהיכא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמכרה לאחר בעינן דדר ביה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לוקח ראשון חד יומא כדאיתא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקמן [דף מא:] התם הוא משום",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשני לאו מחמת שליחותו של",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראשון דר שם והסכים הרשב\"א",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל עם האומרים שבשכירות זה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינה צריכה שטר שכיון ששוכרין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלו דרו ג' שנים אע\"פ שלא",
      "segment_ids": [
