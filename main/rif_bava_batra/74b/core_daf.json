  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים הבעל מת ראשון ואח\"כ מתה האשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ב\"ש אומרים יחלוקו וב\"ה אומרים הנכסים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחזקתן וכתובת האשה בחזקת יורשי הבעל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונכסים הנכנסין והיוצאין עמה בחזקת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יורשי אשה: <b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף קנח:)\" data-bavli-daf=\"158b\" data-bavli-index=\"0\"></span>בחזקת מי ר' אלעזר אומר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחזקת יורשי אשה ור' יוחנן אמר בחזקת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יורשי הבעל תני בר קפרא הואיל והללו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באין לירש והללו באין לירש יחלוקו וכן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הילכתא הא דקאמרי ב\"ה הנכסים בחזקתן פירש רבינו האי גאון ז\"ל דאינון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נכסי איתתא דלא ידיעי אי מנכסי כתובה נינהו ואי מנכסי מלוג דאינון נכסים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הנכנסים והיוצאין עמה אינון ובהון איפליגו רבי אלעזר ור' יוחנן ובר קפרא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "וקא פסק הילכתא כבר קפרא חדא דהוה מסקנא דשמעתא ועוד דהוא רביה דרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יוחנן וקי\"ל דאין הלכה כתלמיד במקום הרב ואיכא מ\"ד הני נכסי דקאמרי ב\"ה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בחזקתן נכסי צאן ברזל אינון וכתובה מאי דקביל הבעל על נפשיה מדיליה כגון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תוספת ועיקר כתובה דהוא מנה מאתים ונכסים הנכנסין והיוצאין אינון נכסי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מלוג ומסתברא לן דהאי פירושא טפי עדיף ומסתבר מההוא פירושא קמא: <b><big>מתני'</big></b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נפל הבית עליו ועל אמו",
      "segment_ids": [
        2
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בש\"א יחלוקו.</b> שהרי שניהן טוענין מחמת ירושה יורשי הבעל אומרים מתה האשה ראשונה ובעלה יורשה ויורשי אשה אומרים הבעל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מת ראשון וכיון שאין לה בנים ממנו אנחנו נירש אותה א\"כ הוי ממון המוטל בספק וחולקין: <b>וב\"ה אומרים נכסים.</b> שהכניסה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עמה בנדוניתה וקבלם הבעל על עצמו ואחריותן עליו הם בחזקתן פרש\"י בגמ' בחזקת שניהם ויחלוקו אותם מפני ששניהם שוין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בהם שהרי עקרן מן האשה ואחריותן על הבעל: <b>וכתובה.</b> דהיינו עיקר כתובה ותוספת בחזקת יורשי הבעל מפני שהוא ממון הנוטל",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הבעל והמוציא מחבירו עליו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראיה: <b>ונכסים הנכנסים</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והיוצאים עמה.</b> שהם נכסי מלוג",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם ממון האשה שאין לבעל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגופן כלום בחזקת יורשי האשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והרוצה להוציא מידה עליו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להביא הראיה: <b>גמ'</b> וכיון שכל",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד יש לו דין להחזיק בהם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלכך יחלוקו כדפי' במתני'",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והכי הלכתא כבר קפרא וכן כתב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבינו אלפסי ז\"ל: <b>מתני' וכו'.</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפל הבית על רחל ובנימין ואין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרחל בן אחר לא מיעקב ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאחר ואם היה ברור שמתה היא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראשונה היה בנימין יורש ואחי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנימין מלאה לבנימין אבל אם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מת בנימין ראשון כיון שהיתה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כבר אלמנה היה אביה זוכה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחלקה וה\"ה שאר יורשיה שהן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יורשים במקום בן ובזה חולקין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולפיכך בין בית שמאי ובין בית הלל מודים דיחלוקו וכתב רבינו שמואל ז\"ל דאם היה לה בן אחר מאיש אחר שיורש במקום בן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "זה נמי לא אמרינן יחלוקו משום דיוסף [בנה מאיש אחר] טוען ודאי בחצי הנכסים דאפילו מתה היא תחלה לא יירש בנימין אלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חצי הנכסים אם כן יוסף טוען שכל הנכסים שלו שבנימין מת ראשון והוי ודאי יורש במקצתן ואחי בנימין אינן טוענין אלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בעבור חציין. ואותו חצי ספק הוא ולא אתי ספק ומוציא מידי ודאי ומייתי ראיה מפרק החולץ [דף לח.] מיבם יבמתו תוך שלשה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חדשים שמת בעלה וילדה לסוף שבעה חדשים שהוא ספק שמא בן תשעה לראשון שמא בן שבעה לאחרון ואחר כן מת אבא כשהספק טוען",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אנא בריה דמיתנא ויש לי חצי הנכסים והיבם טוען את ברי וכולן שלי אמרינן התם שהדין עם היבם משום שטוען בצד מה ודאי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דהיינו בחצי והוא הדין הכא והלכתא דנכסים בחזקתן:",
      "segment_ids": [
        5
      ]
    }
  ],
