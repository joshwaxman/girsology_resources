  },
  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים הבעל מת ראשון ואח\"כ מתה האשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ב\"ש אומרים יחלוקו וב\"ה אומרים הנכסים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחזקתן וכתובת האשה בחזקת יורשי הבעל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונכסים הנכנסין והיוצאין עמה בחזקת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יורשי אשה: <b><big>גמ'</big></b> <span class=\"bavli-ref\" data-bavli-ref=\"(דף קנח:)\" data-bavli-daf=\"158b\" data-bavli-index=\"0\"></span>בחזקת מי ר' אלעזר אומר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחזקת יורשי אשה ור' יוחנן אמר בחזקת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יורשי הבעל תני בר קפרא הואיל והללו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באין לירש והללו באין לירש יחלוקו וכן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הילכתא הא דקאמרי ב\"ה הנכסים בחזקתן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פירש רבינו האי גאון ז\"ל דאינון נכסי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איתתא דלא ידיעי אי מנכסי כתובה נינהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואי מנכסי מלוג דאינון נכסים הנכנסים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והיוצאין עמה אינון ובהון איפליגו רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אלעזר ור' יוחנן ובר קפרא וקא פסק הילכתא כבר קפרא חדא דהוה מסקנא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דשמעתא ועוד דהוא רביה דרבי יוחנן וקי\"ל דאין הלכה כתלמיד במקום הרב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואיכא מ\"ד הני נכסי דקאמרי ב\"ה בחזקתן נכסי צאן ברזל אינון וכתובה מאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דקביל הבעל על נפשיה מדיליה כגון תוספת ועיקר כתובה דהוא מנה מאתים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ונכסים הנכנסין והיוצאין אינון נכסי מלוג ומסתברא לן דהאי פירושא טפי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עדיף ומסתבר מההוא פירושא קמא: <b><big>מתני'</big></b> נפל הבית עליו ועל אמו",
      "segment_ids": [
        1,
        2
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בש\"א יחלוקו.</b> שהרי שניהן טוענין מחמת ירושה יורשי הבעל אומרים מתה האשה ראשונה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ובעלה יורשה ויורשי אשה אומרים הבעל מת ראשון וכיון שאין לה בנים ממנו אנחנו נירש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותה א\"כ הוי ממון המוטל בספק וחולקין: <b>וב\"ה אומרים נכסים.</b> שהכניסה עמה בנדוניתה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וקבלם הבעל על עצמו ואחריותן עליו הם בחזקתן פרש\"י בגמ' בחזקת שניהם ויחלוקו אותם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני ששניהם שוין בהם שהרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עקרן מן האשה ואחריותן על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבעל: <b>וכתובה.</b> דהיינו עיקר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתובה ותוספת בחזקת יורשי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבעל מפני שהוא ממון הנוטל מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבעל והמוציא מחבירו עליו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראיה: <b>ונכסים הנכנסים</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והיוצאים עמה.</b> שהם נכסי מלוג",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם ממון האשה שאין לבעל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגופן כלום בחזקת יורשי האשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והרוצה להוציא מידה עליו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להביא הראיה: <b>גמ'</b> וכיון שכל",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד יש לו דין להחזיק בהם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלכך יחלוקו כדפי' במתני'",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והכי הלכתא כבר קפרא וכן כתב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבינו אלפסי ז\"ל: <b>מתני' וכו'.</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפל הבית על רחל ובנימין ואין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרחל בן אחר לא מיעקב ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאחר ואם היה ברור שמתה היא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראשונה היה בנימין יורש ואחי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנימין מלאה לבנימין אבל אם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מת בנימין ראשון כיון שהיתה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כבר אלמנה היה אביה זוכה בחלקה וה\"ה שאר יורשיה שהן יורשים במקום בן ובזה חולקין ולפיכך בין בית שמאי ובין בית הלל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מודים דיחלוקו וכתב רבינו שמואל ז\"ל דאם היה לה בן אחר מאיש אחר שיורש במקום בן זה נמי לא אמרינן יחלוקו משום דיוסף",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "[בנה מאיש אחר] טוען ודאי בחצי הנכסים דאפילו מתה היא תחלה לא יירש בנימין אלא חצי הנכסים אם כן יוסף טוען שכל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הנכסים שלו שבנימין מת ראשון והוי ודאי יורש במקצתן ואחי בנימין אינן טוענין אלא בעבור חציין. ואותו חצי ספק הוא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולא אתי ספק ומוציא מידי ודאי ומייתי ראיה מפרק החולץ [דף לח.] מיבם יבמתו תוך שלשה חדשים שמת בעלה וילדה לסוף שבעה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חדשים שהוא ספק שמא בן תשעה לראשון שמא בן שבעה לאחרון ואחר כן מת אבא כשהספק טוען אנא בריה דמיתנא ויש לי חצי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הנכסים והיבם טוען את ברי וכולן שלי אמרינן התם שהדין עם היבם משום שטוען בצד מה ודאי דהיינו בחצי והוא הדין הכא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והלכתא דנכסים בחזקתן:",
      "segment_ids": [
        5
      ]
    }
  ],
