      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחר שלא יהיה בו המתנה ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכתיבה ומהאי טעמא גופא צריך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להזכיר מקום שנמסרו בו הדברים",
