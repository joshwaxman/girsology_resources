      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיניה אלא כשעומדין עדיין תוך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זמן הפרעון אבל לאחר זמנו אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כותבין שמא פרע וכן דעת הרא\"ה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל והרשב\"א ז\"ל סובר דכתבינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל היכא שלא מיחה בהם הלוה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ע\"כ: <b>יומא דאקניתו.</b> יום שנתנה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו המתנה או מכר המכירה דאיכא",
      "segment_ids": [
