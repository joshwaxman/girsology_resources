        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומקום שנכתוב בו שאם לא יכתוב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא אחד מהם מיחזי כשיקרא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומיפסל כדמוכח בגיטין (דף פ.)",
