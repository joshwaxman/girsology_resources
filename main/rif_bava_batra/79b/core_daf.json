      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל כשלא נכתב כלל הקנין אינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גובה מנכסים משועבדים דהא",
