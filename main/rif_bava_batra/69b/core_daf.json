  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שכתב כל נכסיו.</b> כלומר וקנו מיניה או בשטר וכדפירשנו לעיל אינו חוזר אם עמד מחליו דחיישינן שכבר שייר לעצמו דשמא יש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לו נכסים במדינה אחרת ואע\"ג דהוה לן לאוקמי ממונא בחזקת מריה דספק הוא אם יש לו נכסים במדינה אחרת אם לאו מ\"מ כיון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאוקימנא מתני' באומר [כל נכסיי משמע דהכא מיירי באומר שדה פלוני] [לפלוני] ושדה פלוני לפלוני ומדקאמר הכי ולא קאמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כל נכסי מוכח מילתא שפיר דאית ליה נכסים במקום אחר ואפילו כשמחלק נכסיו לשנים או לג' בני אדם שאז מוכרח לומר כן שדה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פלוני לפלוני מ\"מ אורחא דש\"מ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמגלה דעתיה מעיקרא כשמחלק כל",
      "segment_ids": [
