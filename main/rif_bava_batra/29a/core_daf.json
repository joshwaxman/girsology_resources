        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחד דמעייל אדעתא דכורי פתח חד בבא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדעתא דארעא ההיא איתתא דאכלה דיקלא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתפשיחא תליסר שנין אתא ההוא גברא קא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רפיק תותיה פורתא אתא לקמיה דלוי ואמרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לה קמיה דמר עוקבא אוקמה בידיה אתיא קא",
