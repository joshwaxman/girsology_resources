      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לארעיה אדעתא דארעא קני אדעתא דכורי לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קני היכי דמי אי דעבד תרי בבי חד דמפיק",
