      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "טיפין הרכינה <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i>ומיצת המדה הרי זה של מוכר החנוני [אינו] חייב להטיף לו",
      "segment_ids": [
