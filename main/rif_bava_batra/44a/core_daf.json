        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין דקה בין גסה במשיכה הא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירשו בגמרא [כאן דף פו:]",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאני בהמה דמסרכא כלומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנועצת צפרניה בקרקע ואינה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרכה להגביה כלל. הרי\"ף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהלכותיו הביא נמי הא דאמרינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקדושין [דף כו.] דמטלטלין אף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על פי שאין נקנין אלא במשיכה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או בהגבהה וכדאמרן מ\"מ אגב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרקע מיקנו בקניית קרקע כדתנן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התם נכסים שאין להם אחריות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקנין עם נכסים שיש להם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחריות בכסף בשטר ובחזקה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מנה\"מ אמר קרא ויתן להם אביהם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתנות רבות לכסף ולזהב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמגדנות עם ערי מצורות אשר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביהודה. איבעיא להו מי בעינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צבורין ואסיקנא צבורין לא בעי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אגב וקני בעי. פי' לא בעינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהו המטלטלין צבורין בתוך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקרקע ממש ומ\"מ צריך המקנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לומר לקונה [קנה לך] האי ארעא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקני לך אגבה הך מטלטלי דאית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לי במקום פלוני וכיון דקנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לההיא ארעא קנה נמי להנהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלי כל היכא דאיתנהו:",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עישור שאני עתיד למוד בו.</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשמגיע שנה שלישית חייב אדם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקרוא שם למעשר ראשון לתתו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ללוי ולמעשר עני לתתו למי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיזכה בו לעניים ואע\"פ שאינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מופרש עדיין מן החולין והתם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רישא דמילתא הכי הוא דר\"ג",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וזקנים היו באים בספינה והגיע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנה שלישית ואמר ר\"ג עשור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאני עתיד למוד נתון ליהושע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיה לוי ומקומו מושכר לו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והרי זה היה שדה במכר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומטלטלין במתנה אבל שדה במכר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומטלטלי לאחד הוא בעיא דלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איפשיטא: <b>הא</b> דאמרינן דקנה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלין אגב ארעא היינו היכא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דנתן דמי כולן א\"נ היכא דקנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שדות הרבה דבחזקה באחד קנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחריני ה\"מ בשנתן דמי כולן. ע\"כ מהרי\"ף ז\"ל: <b>מתני' עד שלא נתמלאת המדה וכו'.</b> ומוקמינן לה בגמ' במדת סרסור ולפיכך עד",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלא נתמלאת המדה למוכר דברשות מוכר קיימא למדוד ולמכור ומשנתמלאת היא ללוקח עד שיערה המדה לתוך כליו וחייבין עליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אם נשברה שלא מחמת מלאכה ושלא באונס ואם אינה של סרסור אלא שהוא מודד שנותנין לו שכר על המדידה נעשה כשומר שכר על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "החבית וחייב בשמירתה ואם נשברה נשברה לו ובלבד שלא יהיה נמי באונס גמור אלא כעין גניבה ואבידה ואם החבית של סרסור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והיא מושאלת למוכר או ללוקח ונשברה אע\"ג שאינו אונס גמור נשברה לו מפני שהיא שאלה בבעלים מפני שהסרסור נשכר להם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למדוד וכן אם הסרסור קנאה מהמוכר למכור תכף ללוקח ומרויח בה ומדד אותה ברשותיה קיימא ולא אמרינן שליחותיה דלוקח קא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עביד אלא ודאי ברשות סרסור קיימא לגמרי ואם נשברה נשברה לו עד שיגמר מדידתה: <b>וחייב</b> להטיף אחר שעירה הכלי ג' טיפין",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפני מה שנדבק בדופני המדה ובשוליו: <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>והרכינה (והיינו מה שנשאר עדיין בדופני הכלי) ומיצה מה שנשאר עדיין בשולי הכלי",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנתמצה שם הרי הוא של מוכר מפני שהלוקח מתיאש ממנו כדאיתא בגמרא: <b>וחנוני</b> אין חייב להטיף מפני רבוי הלוקחים ממנו שלא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יתעכבו שם כל כך: <b>גרסינן</b> בגמרא האי מדה דמאן אילימא מדה דלוקח עד שלא נתמלאת המדה למוכר מדה דלוקח היא ואלא מדה",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמוכר משנתמלאת המדה ללוקח מדה דמוכר היא אמר רבי אלעא אמר רב במדת סרסור ורישא מדה בלא סרסור וסיפא מדה בסרסור",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עצמו הרכינה ומיצת הרי היא של מוכר א\"ר אבהו א\"ר יוחנן משום יאוש בעלים נגעו בה:",
      "segment_ids": [
        8
      ]
    }
  ],
