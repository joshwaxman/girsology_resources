      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהלכותיו הביא נמי הא דאמרינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקדושין [דף כו.] דמטלטלין אף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על פי שאין נקנין אלא במשיכה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או בהגבהה וכדאמרן מ\"מ אגב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרקע מיקנו בקניית קרקע כדתנן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התם נכסים שאין להם אחריות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקנין עם נכסים שיש להם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחריות בכסף בשטר ובחזקה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מנה\"מ אמר קרא ויתן להם אביהם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתנות רבות לכסף ולזהב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמגדנות עם ערי מצורות אשר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביהודה. איבעיא להו מי בעינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צבורין ואסיקנא צבורין לא בעי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אגב וקני בעי. פי' לא בעינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהו המטלטלין צבורין בתוך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקרקע ממש ומ\"מ צריך המקנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לומר לקונה [קנה לך] האי ארעא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקני לך אגבה הך מטלטלי דאית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לי במקום פלוני וכיון דקנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לההיא ארעא קנה נמי להנהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלי כל היכא דאיתנהו:",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עישור שאני עתיד למוד בו.</b>",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשמגיע שנה שלישית חייב אדם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקרוא שם למעשר ראשון לתתו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ללוי ולמעשר עני לתתו למי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיזכה בו לעניים ואע\"פ שאינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מופרש עדיין מן החולין והתם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רישא דמילתא הכי הוא דר\"ג",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וזקנים היו באים בספינה והגיע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנה שלישית ואמר ר\"ג עשור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאני עתיד למוד נתון ליהושע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהיה לוי ומקומו מושכר לו והרי זה היה שדה במכר ומטלטלין במתנה אבל שדה במכר ומטלטלי לאחד הוא בעיא דלא איפשיטא: <b>הא</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרינן דקנה מטלטלין אגב ארעא היינו היכא דנתן דמי כולן א\"נ היכא דקנה שדות הרבה דבחזקה באחד קנה אחריני ה\"מ בשנתן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמי כולן. ע\"כ מהרי\"ף ז\"ל: <b>מתני' עד שלא נתמלאת המדה וכו'.</b> ומוקמינן לה בגמ' במדת סרסור ולפיכך עד שלא נתמלאת המדה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למוכר דברשות מוכר קיימא למדוד ולמכור ומשנתמלאת היא ללוקח עד שיערה המדה לתוך כליו וחייבין עליה אם נשברה שלא מחמת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מלאכה ושלא באונס ואם אינה של סרסור אלא שהוא מודד שנותנין לו שכר על המדידה נעשה כשומר שכר על החבית וחייב בשמירתה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואם נשברה נשברה לו ובלבד שלא יהיה נמי באונס גמור אלא כעין גניבה ואבידה ואם החבית של סרסור והיא מושאלת למוכר או",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ללוקח ונשברה אע\"ג שאינו אונס גמור נשברה לו מפני שהיא שאלה בבעלים מפני שהסרסור נשכר להם למדוד וכן אם הסרסור קנאה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מהמוכר למכור תכף ללוקח ומרויח בה ומדד אותה ברשותיה קיימא ולא אמרינן שליחותיה דלוקח קא עביד אלא ודאי ברשות סרסור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קיימא לגמרי ואם נשברה נשברה לו עד שיגמר מדידתה: <b>וחייב</b> להטיף אחר שעירה הכלי ג' טיפין מפני מה שנדבק בדופני המדה",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובשוליו: <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>והרכינה (והיינו מה שנשאר עדיין בדופני הכלי) ומיצה מה שנשאר עדיין בשולי הכלי שנתמצה שם הרי הוא של מוכר",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפני שהלוקח מתיאש ממנו כדאיתא בגמרא: <b>וחנוני</b> אין חייב להטיף מפני רבוי הלוקחים ממנו שלא יתעכבו שם כל כך: <b>גרסינן</b>",
      "segment_ids": [
        6,
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בגמרא האי מדה דמאן אילימא מדה דלוקח עד שלא נתמלאת המדה למוכר מדה דלוקח היא ואלא מדה דמוכר משנתמלאת המדה ללוקח",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מדה דמוכר היא אמר רבי אלעא אמר רב במדת סרסור ורישא מדה בלא סרסור וסיפא מדה בסרסור עצמו הרכינה ומיצת הרי היא של",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מוכר א\"ר אבהו א\"ר יוחנן משום יאוש בעלים נגעו בה:",
      "segment_ids": [
        8
      ]
    }
  ],
