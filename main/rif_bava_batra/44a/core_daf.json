    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכן העלו רבוותא ובבהמה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפסיקנא כרבנן דברייתא דאמרי",
