      "right": "0px",
      "left": "",
      "text": "לפסול אותו דלא שייך קפידא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במאי דלא סליקא <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>דעתיה כלל",
