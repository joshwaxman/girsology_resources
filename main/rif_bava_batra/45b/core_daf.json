        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">ורביעית</i> <i class=\"footnote\">וחצי</i> <i class=\"footnote\">תומן</i> <i class=\"footnote\">ועוכלא</i> <i class=\"footnote\">על</i>",
