    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמכרות עמה פתוחות לכאן ולכאן אלו ואלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמכרות עמה ר' אליעזר אומר המוכר את",
