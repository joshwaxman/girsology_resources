      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודות בלבד הלכך צריך ליקח לו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרך ומ\"מ מודה ר\"ע אם אמר לו",
