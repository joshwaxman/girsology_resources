      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדי שיתקיימו בו מימיו: <b>האחין</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שחלקו.</b> בית או שדה כלקוחות הן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמאן דקפיד בלוקח ואמר דבעין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רעה מכר לו המוכר הוא הדין",
      "segment_ids": [
