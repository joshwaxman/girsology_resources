      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדרך דמש\"ה הוא דקאמר דאל\"כ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פשיטא דבור ודות לא היתה בכלל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המכר כיון דלא כתב ליה מארעית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תהומא וכו': <b>גמ' בבנין.</b>",
      "segment_ids": [
        0,
