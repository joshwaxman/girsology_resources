      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרמ\"ה דוקא דא\"ל פירות סתם ולא א\"ל אלו",
