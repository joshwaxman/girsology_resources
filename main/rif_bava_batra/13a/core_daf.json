      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טובי העיר דאל\"כ היה יכול ליקח ע\"י עובד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כוכבים ויאמר כי בשביל המתנה הוא ליקח",
      "segment_ids": [
