      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"ג בתקנות שצריך שיפרע תחלה במעות או",
      "segment_ids": [
