      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומיהו דוקא קודם שיפרעו הקהל המס למלך",
      "segment_ids": [
