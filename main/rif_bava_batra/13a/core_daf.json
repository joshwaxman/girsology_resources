        "text": "<i class=\"ror-line\" data-ror-i=\"5\" data-ror-conf=\"high\" data-ror-by=\"Rashi\" data-ror-ref=\"Rashi on Bava Batra 24b:9\" data-ror-ocr=\"ולא קרירא. שזה סומך על זה אף כאן דמי\">כאן דמי</i> <i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-by=\"Rashi\" data-ror-ref=\"Rashi on Bava Batra 24b:9\" data-ror-ocr=\"האילן מי יתנם אם באת להטיל על בני\">האילן מי יתנם אם</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"6\" data-ror-conf=\"high\" data-ror-by=\"Rashi\" data-ror-ref=\"Rashi on Bava Batra 24b:9\" data-ror-ocr=\"האילן מי יתנם אם באת להטיל על בני\">באת להטילם על בני</i> <i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-by=\"Rashi\" data-ror-ref=\"Rashi on Bava Batra 24b:9\" data-ror-ocr=\"העיר כל א׳ יאמר ממני לא יתחיל ונמצא\">העיר כל</i>"
      },
      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"7\" data-ror-conf=\"high\" data-ror-by=\"Rashi\" data-ror-ref=\"Rashi on Bava Batra 24b:9\" data-ror-ocr=\"העיר כל א׳ יאמר ממני לא יתחיל ונמצא\">אחד אומר ממני לא יתחילו</i>"
      },
