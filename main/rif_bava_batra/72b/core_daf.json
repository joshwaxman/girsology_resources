  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> גבי קטן שמכר יראה מדברי הרא\"ש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבמקרקעי אין מקחו מקח ואין ממכרו ממכר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עד שיגדיל ומשהגדיל דהיינו משהביא שתי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שערות אחר שהיה בן י\"ג שנים אם חריף",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ופקח ויודע בטיב משא ומתן אז דינו כגדול",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לכל דבר ומקחו מקח וממכרו ממכר בין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במקרקעי בין במטלטלי אפי' שירש מאביו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל אם לאו חריף הוא אז לא הוי ממכרו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממכר בקרקע שירש מאביו אע\"פ שאינו שוטה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עד שיהיה בן כ' שנים שלמים ויביא ב'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שערות ואפי' אם הביא תוך שנת כ' עדיין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינו יכול למכור ומיהו אם קנה קרקע מקחו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מקח ואם הוא בן כ' ולא הביא ב' שערות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עדיין חשוב קטן ואינו יכול למכור עד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיהיה בן ל\"ו שנים בד\"א כשלא היו לו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סימני סריס אבל אם היו לו סימני סריס",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיד כשהוא בן כ' חשוב גדול ויכול למכור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל אם קנה קרקע או ניתן לו במתנה יכול",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למוכרו מיד לאחר שהגדיל אפי' אינו יודע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בטיב משא ומתן ורי\"ף כתב דאפי' בנכסים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שקנה אינו יכול למכור עד שיגדיל אא\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יודע בטיב משא ומתן ובנכסי אביו אפי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יודע בטיב משא ומתן אינו יכול למכור עד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיהיה בן כ' והרא\"ש לא הסכים לדבריו אלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לסברא ראשונה וכתב הרמ\"ה איכא מרבוותא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאמרי דוקא בנכסי אביו דשכיחא עבדי רבנן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תקנתא שלא ימכור עד שיהיה בן כ' ולאו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנכסי שאר מורישיו וכתב הוא שאין חילוק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בין נכסי אביו לשאר מורישיו וכן נמי אם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נתנו לו אביו במתנת ש\"מ שהוא בירושה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דינו כירושה אבל אם נתנו לו במתנת בריא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דינו כשאר נכסים שקנה או נתנו לו במתנה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכתב לו אע\"ג דמכר קודם שנתברר שהוא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גדול כגון קודם כ' ולא הביא שתי שערות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא נולדו לו סימני סריס ולאחר זמן הביא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שתי שערות שעתה נתברר שעכשיו הגדיל אין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מכירתו כלום עד עתה שקטן היה מ\"מ אם",
      "segment_ids": [
