      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נתברר שהוא סריס כגון בן עשרים שלא הביא",
      "segment_ids": [
