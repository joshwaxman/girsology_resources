  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א כתב ריא\"ז</b> אמר לו זכה אתה והחמור קנה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחצה כדברי מז\"ה ול\"נ שלא קנה כלום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמבואר בקונט' הראיות: <b>ב</b> היכא שמת והניח",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בנים גדולים והשביחו הנכסים כתב הראב\"ד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הא דפלגינן בין שבח הנכסים מחמת נכסים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בין שהשביחום משלהם דוקא כשניזונים יחד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתפיסת הבית אבל אם אין ניזונים יחד אין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לו רשות לירד ולהשביח ואפי' השביח מחמת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עצמו אינו נוטל אלא כאדם שיורד שלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ברשות דידו על התחתונה ואם יאמר ראו מה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הניח לנו אבינו הרי אנו עושין ואוכלים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כל השבח שהשביחו בכל הנכסים אפי' בחלק",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האחין הוא של עצמן ואפי' שהשביתו מחמת",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הנכסים אע\"ג דשאר שותף אין לו בשבח אלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כשאר אריס אפי' אמר לעצמי אני עושה שאני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכא דכיון שהן אחין ולא נשתתפו תחלה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אדעתא להרויח ושתקו כשאמר להם לעצמי אני",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עושה ודאי מחלו ולמה לא יטול כל השבח",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ור\"ח פי' שצריך שיאמר בפני ב\"ד לעצמי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אני עושה והרא\"ש כתב שאם הם כולם גדולים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "א\"צ שיאמר בפני ב\"ד רק בפני עדים אבל אם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יש בהן קטנים צריך שיאמר בפני ב\"ד ואם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זה שהשביח ת\"ח ואין דרכו ליבטל מללמוד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולטרוח בעבור אחרים הרי הוא כאילו פירש",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעצמי אני עושה והרמב\"ם כתב אפי' אמר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעצמי אני עושה השבח לאמצע אא\"כ השביח",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחמת הוצאה שהוציא משלו אבל אם שבחו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחמת נכסים השבח לאמצע והרא\"ש כתב כסברא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ראשונה וכן השיג עליו הראב\"ד וי\"א דהאי",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דינא לא הוי אלא בגדולים וקטנים אבל אם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כולם גדולים והשביחו מקצת גדולים הנכסים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לא השביחו לאמצע אלא נוטלים כדין אריס",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחלק האחרים וכן אם אמר לעצמי אני עושה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין מועיל בכולם גדולים אבל הרא\"ש כתב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאין חילוק בין גדולים וקטנים ובין כולם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גדולים והשביחו מקצת גדולים ל\"ש לענין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שכל השבח לאמצע כשהשביחו סתם ול\"ש שיטלו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כל השבח לעצמן כשפירשו: <b>כתב ריא\"ז</b> היו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כל האחים גדולים שראוים להשביח נכסיהם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והלכו מקצתן והשביחו הנכסים אע\"פ שגילו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דעתם בב\"ד שלא בפני אחיהם ואמרו כל מה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאנו עושים לעצמנו אנו עושים הרי אלו לא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השביחו לעצמן ואין כל הפירות שלהם שהיה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להם להודיע לאחיהם והיו משביחים גם הם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עמהם ולפיכך אם השביחו מקצת הנכסים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השביחו לאמצע שהרי לא חלקו ונוטלים שכרם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחלק אחיהם כדין היורד לתוך שדה חבירו:",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        8
      ]
    }
  ]
