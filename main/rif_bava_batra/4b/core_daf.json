    {
      "width": "380px",
      "right": "275px",
      "text": "מצינא דאטרח <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>לא קא מיתדר לי אמר ליה",
      "segment_ids": [
