      "text": "<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">ליתא</i> <i class=\"footnote\">ד'</i> <i class=\"footnote\">תיבות</i> <i class=\"footnote\">אלו</i> <i class=\"footnote\">חוק</i> <i class=\"footnote\">לך</i> <i class=\"footnote\">בארעא</i>",
      "segment_ids": [
