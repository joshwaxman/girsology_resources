      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לצפון וזה לחצי גגו לדרום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומעדיף מעט יותר כדי שלא יראו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה לזה להדיא הלכך מאן דבעי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למפתח חלונותיו לרה\"ר ואית",
      "segment_ids": [
