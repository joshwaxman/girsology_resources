    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i class=\"footnote\">חסדא</i> <i class=\"footnote\">בפומבדינתא</i> <i class=\"footnote\">מ\"ל</i> <i class=\"footnote\">משמיה</i> <i class=\"footnote\">דר\"כ</i> <i class=\"footnote\">ואמרי</i>",
      "segment_ids": [
