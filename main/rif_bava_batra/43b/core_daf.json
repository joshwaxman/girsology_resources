      "width": "380px",
      "right": "275px",
      "text": "נקנין אלא במשיכה אמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">וכ\"ה</i> <i class=\"footnote\">ברא\"ש</i> <i class=\"footnote\">רבה</i>",
      "segment_ids": [
