        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שמואל לא שנו אלא בשטר מתנה אבל במכר לא קנה עד שיתן לו דמים",
      "segment_ids": [
        4
      ]
    }
