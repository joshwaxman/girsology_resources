      "right": "275px",
      "text": "<i class=\"footnote\">אבל</i> <i class=\"footnote\">בגמ'</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">בסורא</i> <i class=\"footnote\">מתנו</i> <i class=\"footnote\">לה</i> <i class=\"footnote\">משמיה</i> <i class=\"footnote\">דרב</i>",
      "segment_ids": [
