      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושניה [של אייר] ותירץ רב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כהנא דברייתא פירוש דמתני'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא דאמר במתני' בריכה ראשונה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו לאמה אבל ה\"ה דלבתה",
      "segment_ids": [
