        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ג' זוגות אמה ובתה ובת בתה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכל אחת עם חברתה כי זוגות הם",
      "segment_ids": [
