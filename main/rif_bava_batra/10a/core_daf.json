  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> שיעור גובה שעל הכירים אינו מפורש וכ'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרמ\"ה שהוא ח' טפחים השליש של שיעור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התנור כמו שלגבי שיעור המעזיבה בעלייה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הוא בכירה שליש של שיעור. התנור כן הוא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בגובה של גבה והרשב\"ם כתב כיון שבכירה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין פתיחה ע\"ג אלא מן הצד ואין שלהבת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עולה ממנה וא\"צ להרחיק אלא בשביל החום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בין מלמעלה בין מלמטה סגי בב' טפחים ועל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כן כתב שתנור שלנו שפתחן מן הצד בין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מלמעלה בין מלמטה שיעורו ג\"ט ולא נהירא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להרא\"ש אלא תנורים שלנו כיון שהם גדולים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריך להרחיק יותר מד' אמות וה\"ר יהודה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ברצלוני כתב ג\"כ כיון שבתנור שיש עליו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחיצות ואינו יכול לעלות כל כך צריך ד\"א",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גובה כ\"ש בכירה שאין עליה מחיצות שצריך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ד\"א ובתנור של נחתומין צריך שיהא עובי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המעזיבה ד\"ט וכירה של נחתומין ג\"ט ואם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הזיק אחר שהרחיק כשיעור חייב לשלם ונראה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאפי' כל אדם בביתו חייב להרחיק שיעורין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הללו מפני השכנים שמעכבים עליו וכ\"כ ה\"ר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ישעיה. כתב ה\"ר ישעיה דכל הנך הרחקות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ששנינו גבי כותל קאי בכותל של לבנים אבל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "של אבנים אינו ניזוק בכל אלה וכן יראה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מדברי רש\"י והר\"ר יונה כתב דאפי' בכותל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "של אבנים נמי מיירי. כתב מיי' לא יחפור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אדם לא בור ולא שיח ולא מערה ולא יעשה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בריכת מים לשרות בו בגדים לכבוס בצד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתלו של חבירו אא\"כ הרחיק מן הכותל ג\"ט",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וסד בסיד לכותל הבור או לכותל מקוה המים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "או לכותל האדמה מצד חבירו כדי שלא יבלעו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בו המים ויזיק לחבירו ומקום שהכובס מכה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שם על הבגדים כדי שיתלבנו צריך להרחיק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ד' אמות מפני שנתזין למרחוק ע\"כ ובגמ'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מסיק דמכותל בורו שנינו פי' דכל הני",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מתניין בענין ריחוקו מכותל בורו של",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חבירו ולא איירי בהרחקתו מכותל דעלמא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומ\"מ לטור מסתבר שצריך להרחיק גם מכותל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חבירו דטפי מזיקו הנך ממי רגלים שצריך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להרחיקן ג\"ט:",
      "segment_ids": [
