  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב רבינו שהשטר נקנה באגב קרקע ואפי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לדבריו פי' הרא\"ש בתשובה שצריך לומר לו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על פה קני לך איהו וכל שעבודיה ולא מהני",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אגב אלא שא\"צ כתיבה אבל ע\"פ צריך לאומרו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכ\"כ הרמב\"ן שנקנה אגב קרקע ואין צריך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עדים לענין הקנין אבל צריך עדים לענין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "התביעה שהרי הנתבע יאמר לו מי לימא לן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דבעל דברים דידי את שמסרו לך וכו' כמ\"ש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "באורך בפ\"ו מהלכות מכירה אבל ר\"ח כתב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שצריך להביא ראיה וגם אינו נקנה באגב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכן דעת הרא\"ש ור\"י אבן מג\"ש אומר דאפי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למאן דבעי כתיבה א\"צ להביא ראיה ונאמן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לומר שטר כתוב היה לי ואבד ור\"י כתב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כיון שדרך לעשות על אותיות שטר צריך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להביא ראיה ואינו נאמן לומר שטר היה לי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואבד ואינו נקנה נמי אגב קרקע: <b>ב</b> הא",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאמר מכר את הצמד לא מכר את הבקר ואין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הדמים ראיה לומר אין הצמד שוה כל כך בלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הבקר אלא אם טעה בכדי שהדעת טועה יש בו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אונאה או ביטול מקח כדין כל לוקח ואם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "טעה בכדי שאין הדעת טועה הוי מתנה כך",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פסק רשב\"ם ור\"ח והרמ\"ה ורב האי כתב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהדמים ראיה לבטל המקח אם טעה בכדי שאין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הדעת טועה והרא\"ש כתב כדברי רשב\"ם ז\"ל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וכתב הרשב\"ם אפי' אם היו קשורים ביחד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינן מכורין אבל ה\"ר יוסף הלוי כתב דוקא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כשאינן קשורים אבל אם קשורין מכורים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והכי מסתברא ואם הכל קורין לבקר צמד לא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מיבעיא אם אין קורין לצמד לבדו צמד עד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיפרשו צמד לבדו והוא מכר לו צמד סתם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פשיטא שהכל מכור אפי' בלא הודעת דמים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא אפי' אם הכל קורין לצמד לבדו ג\"כ",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צמד סתם כיון שהכל קורין ג\"כ לבקר צמד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמרי' הדמים מודיעים ואפי' אם אין הכל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קורין לצמד בקר אלא הרוב קורין לצמד בקר",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב הרמ\"ה שהדמים מודיעים כיון דאיכא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "רוב והודעת דמים והא דאמרי' שאין הדמים",
      "segment_ids": [
