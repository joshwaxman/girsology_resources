      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>זו היא טעמא דאביי ורבא ומיהו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא אזביני <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"נ\" data-order=\"14\"></i>אבל בגיטא ומתנתא",
      "segment_ids": [
