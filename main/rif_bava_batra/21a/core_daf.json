      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ור\"י כתב בשם רב האי שאין רגילין לכתוב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במתנת ש\"מ מתנת פרהסיא ואין חוששין בה",
      "segment_ids": [
