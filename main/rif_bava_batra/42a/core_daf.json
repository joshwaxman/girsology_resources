      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דברשותו הוא קונה דסימטא הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בליטה סמוכה לרה\"ר ויש רשות",
      "segment_ids": [
