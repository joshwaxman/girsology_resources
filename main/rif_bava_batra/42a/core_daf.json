      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא דלא בריאן: <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"י\" data-order=\"10\"></i>כיון דלית ביה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא ב' מינים א' אדום ואחד",
