  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> כתב הרא\"ש ויראה דאפי' פחות משתות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אסור להונות אם יש בו שוה פרוטה כיון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיודע שאין מקחו שוה כך רחמנא אמרה אל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תונו בכל שיש בו שווי ממון הזהירה תורה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלא יונה את חבירו אלא שחכמים אמרו עד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שתות הוי מחילה לפי שכן הוא דרך מקח",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וממכר שאין הלוקח והמוכר יכולים לכוין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דמי המקח בצמצום ודרך העולם למחול טעות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עד שתות אבל אם המוכר בקי בערך ממכרו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואין הלוקח בקי כל כך או אם הלוקח תגר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובקי בערך המקח יותר מהמוכר אל יונו זה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "את זה אם לא שפירש חוץ ממטבע שכל זמן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלא הגיע לכדי אונאה מותר לכתחלה להוציא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ביפה שגם אחר יקבלנו מידו ואין בו הפסד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כלל או שמא כיון דדרך מקח וממכר בכך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ופעמים הלוקח חפץ במקח ומוסיף עליו דמים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יותר מכדי שויו ופעמים שהמוכר מזלזל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בממכרו לפי שאין חפץ זה ערב עליו או",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא דחוק למעות הלכך עד שתות הוי בכלל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מקח ואין כאן אונאה כלל וירא שמים יוצא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ידי שניהם: וכתב רבינו בפ' הזהב דאם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המתאנה חפץ במקחו ואינו שואל אונאתו אין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המאנה יכול לבטלו וכ\"כ מיי' אבל רבינו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יונה כתב אפי' אם אין המתאנה תובע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אונאתו יכול המאנה לבטלו שכל זמן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהמתאנה יכול לחזור המאנה יכול ג\"כ",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לחזור דכיון שהאונאה יתר על שתות אין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המקח ראוי להתקיים והוי כמו נושא ונותן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בדברים בלא משיכה ואם המתאנה נתרצה במקח",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין יכול לחזור בו אח\"כ וכן אם נתאנה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לוקח ביותר על שתות ושהה בכדי שיראה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לתגר או לקרובו אע\"פ דאמרו רבנן מוכר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעולם חוזר הכא אינו יכול לחזור כיון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנתקיים המקח גבי לוקח שנתאנה והכי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מסתבר להרא\"ש ז\"ל: כתב הרא\"ש ואם נתעצל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא חקר לידע אם נתאנה בלא עכוב אונס",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מוחל אונאתו ע\"כ ויש לדקדק בלשונו שאם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מכירו שאירעו אונס יכול לחזור בו עדיין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בד\"א בלוקח שהרי מקחו בידו ויכול",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להראותו אבל מוכר שנתאנה חוזר לעולם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו יודע ערך ממכרו עד שיזדמן לו מקח",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כאותו שמכר ונודע לו שטעה וכתב מיי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לפיכך היה המקח דבר שאין בו שינוי והוא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כולו שוה כגון פלפלים וכיוצא בו ה\"ז",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינו חוזר אלא עד כדי שישאל בשער שבשוק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בלבד ע\"כ. שאלה להרא\"ש הא דאמרי' מוכר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לעולם חוזר עד מתי יהיה זה ועוד שאפשר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאדם דחוק לפי שעה ומכר שוה סלע בדינר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מחמת דחקו וכשיזדמנו לו מעות יחזור וכן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פעמים שהשער משתנה. תשובה. דע שמפני",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שינוי השער אינו יכול לחזור וגם אם זלזל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במכירותו יותר מכדי שהדעת טועה שניכר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שמפני דחקו הוצרך לזלזל אינו יכול לחזור",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כי ידע ומחיל: <b>ב כתב ריא\"ז</b> היו הפירות",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחצירו של לוקח חצירו קנה לו ואע\"פ שהיו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
