    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>דסמקא צפרא ופניא והא דלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חזיא ליה כוליה יומא נהורין",
