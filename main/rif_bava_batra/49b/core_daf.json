      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שישארו למוכר וכן נראה מדברי הרא\"ש שכתב",
      "segment_ids": [
