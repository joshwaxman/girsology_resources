  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מצר ראובן מזרח ומערב ומצר שמעון צפון ודרום כו'.</b> דאי לא אמר לו המוכר אלא שדה שמצרניו ראובן ושמעון היה יכול ליתנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חצי השדה לבד באלכסון דהא הוה שפיר מצר אחד ראובן ומצר אחד שמעון אבל כשאמר לו רוחין תרתין על כרחו יתן לו כל השדה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וכן הדין הוא אם מצר ראובן מזרח ודרום ומצר שמעון מערב וצפון שהיה יכול ליתן לו אלכסון <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"צ\" data-order=\"18\"></i>אחר שהם מצרנים בו: <b>מי שמכר</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שדהו ומצר לו השלשה מצרים והרביעי לא מצר לו קנה הכל חוץ ממצר רביעי.</b> ולא אמרינן כי היכי דשייר ברוח רביעי ה\"נ שייר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכוליה שדה ושיתן לו תלם אחד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כנגד ג' המצרים לבד וכל מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבתוכה ישאר למוכר אלא אמרי'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כולו מכר לו חוץ ממצר רביעי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיינו רביע השדה כנגד אותו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצר רביעי והיינו כשאינו",
