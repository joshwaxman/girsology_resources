  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> קטן שלוה מאחרים כתב הרמ\"ה שחייב לשלם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כשיגדיל וה\"ר יונה הסב שאינו חייב לשלם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאם נפרעין ממנו לכשיגדיל יבזבז כל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממונו בקטנותו והרא\"ש חילק בדבר וכתב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאם ידוע שלוה לצורך מזונותיו נפרעין",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ממנו אפי' כשהוא קטן כמו בפעוטות שמקחן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מקח וממכרן ממכר במטלטלין משום כדי חייו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גם הלואתו הלואה ונפרעין ממנו כדי שימצא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מי שילונו בשעת דחקו אבל אם אין ידוע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלוה להו לצורך מזונותיו אין מעשיו כלום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואין נפרעין ממנו לכשיגדיל: <b>ב</b> רשב\"ם כתב",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        1,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שקונין מש\"מ אפי' בשבת שזה הקנין אינו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריך משמע מדבריו אבל אם יש נפקותא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקנין כגון שכתב כל נכסיו ומפרש שלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יחזור בו אף אם יעמוד שאז מועיל הקנין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין קונין בשבת אבל הרא\"ש כתב דאפ\"ה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קונין ממנו בשבת (שנתן) דכיון שכתב כל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נכסיו מדאגת מיתה הוא נותן ואיכא למיחש",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לטירוף דעת אם לא יעשו כדבריו אבל אם",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
