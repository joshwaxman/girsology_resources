  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א כתב ריא\"ז</b> ואם היו שוים בשילוש יכתבו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סימן כגון שכותבין פלוני הארוך פלוני",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "האדום וכיוצא בהם ואם כתבו שטר על אותו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו כהן יכתבו פלוני הישראל ואם כתבו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סתם הרי זה ספיקא בידי אם יש לפרש הסתם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "על אותו שאינו כהן או יש לומר שעל הכהן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתוב סתם שהרי אם לא היו שמותיהן שוים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גם על הכהן ראוי לכתוב סתם כמבואר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בקונטרס הראיות ונראה בעיני שראוי לילך",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בזה אחר המנהג שאם דרך המקום לכתוב על",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הכהן שהוא כהן וזה כתוב סתם דברידוע שעל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותו שאינו כהן נכתב ואם אין שם אחר אלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זה שהוא כהן אינו יכול להשמט ולומר שלא",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתבו עליו: <b>ב</b> גבי ערבות נראה פשוט פ'",
      "segment_ids": [
        0,
        1
      ],
      "gemara_segment_ids": [
        0,
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הגוזל קמא דראובן שבא להלוות מעות",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לשמעון ושאל ללוי עליו אם הוא אמיד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וראוי להלוות לו וא\"ל לוי שהוא טוב",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואח\"כ נמצא ששמעון לא היו לו נכסים",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונאבדה ההלואה אם אמר לו ראובן לשמעון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "חזי דעלך קא סמיכנא חייב שמעון בכל",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ההפסד אבל אם לא אמר ליה חזי דעלך קא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סמיכנא פליגי כפי מה שכתב שם הגהת הרא\"ש",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בשם רבינו יואל חייב שמעון בכל ההפסד",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אפי' לא אמר ליה חזי דעלך קא סמיכנא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולדברי רבינו אפרים אינו חייב שמעון בזה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ההפסד הואיל ומצי משתמיט מלהלוות לו אלא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שנראה מדבריו דאי אמר ליה חזי דעלך קא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סמיכנא חייב שמעון באותו ההפסד וכן הדין",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בראובן שבא ליקח משכון והראהו לשמעון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וא\"ל שהוא טוב כמו שכתוב שם בהג\"ה להדיא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונמצא שהוא רע ומ\"מ היכא שהראה המשכון",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולקחו פטור הלוה מן ההפסד ההוא שמגיע",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למלוה במשכון ההוא דכיון דהראהו מסתמא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדי לפטור הלוה מן ההפסד הראהו ואין לו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "למלוה דין רק עם מי שהראהו לו: <b>כתב</b>",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ריא\"ז</b> נטל זה המעות בידו מיד המלוה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונתנה ללוה אין לו למלוה על הלוה כלום",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אלא [על] זה שנטל המעות מידיו ונראה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בעיני שזה דינו כנושה בחבירו וחבירו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בחבירו ואע\"פ שאמרו שמוציאין מן הלוה",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "השני ונותנן לנושה כל זמן שהנושה יכול",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לגבות מן הלוה הראשון שלוה ממנו אין לו",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לנושה על הלוה השני כלום כמבואר בקונטרס",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הראיות: <b>ג</b> גבי הא דאמר לא יתבע מהערב",
      "segment_ids": [
        1,
        2
      ],
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תחלה כתב רב נחשון גאון אמר הערב תנו לי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זמן ואביאנו לב\"ד אי ידיע היכן הוא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יהבינן ליה זמן כשיעורן דא יתי ואי דלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ידיע יהבינן ליה זמן ל' יום ומשיביאנו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לב\"ד יפטר הערב עד שישבע הלוה שאין לו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מה לפרוע הביאו ערב שבת בין השמשות",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ובמוצאי שבת ברח לא נפטר הערב וכל זמן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שלא בא הלוה יכול הערב לטעון לא אפרע לך",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עד שתביא ראיה שלא פרעך ואם התנה המלוה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "עם הערב שיהיה נאמן לומר כל זמן שלא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פרעו הכל לפי תנאו ואם אמר המלוה ממי",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שארצה אפרע כתב הרב יוסף הלוי שיכול",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ליפרע מן הערב תחלה אפי' אם יש לו נכסים",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ללוה אבל ר\"ת פי' אע\"פ שאמר ממי שארצה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אפרע לא יפרע מן הערב תחלה כל זמן שיש",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "קרקע ללוה אפי' היא זיבורית אלא היו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כותבין אדרכתא על נכסי הלוה ומורידין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אותו לנכסיו אפי' אם היו משועבדין גובה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מהלקוחות קודם שיגבה מן הערב אבל אם אין",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ללוה קרקע ידוע אז יתבע הערב וא\"צ לחזר",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אחר הלוה אולי יתן מטלטלין דלהכי מהני",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מה שהתנה ממי שארצה אפרע דמספיקא לא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מטרחינן ליה לילך אחר הלוה וכן כתב",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש ואם אמר בפירוש ממי שארצה אפרע",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תחלה * צ\"ל ודאי יכול לתבוע לערב תחלה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ואפי' יש נכסים ללוה והראב\"ד כתב שאפי'",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אמר בפירוש ממי שארצה אפרע תחלה לא יתבע",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כו' כ\"ה בטוח\"מ סי' קנ\"ט. לא יתבע לערב",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תחלה אם יש נכסים ללוה והרא\"ש כתב כסברא",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ראשונה: <b>כתב ריא\"ז</b> ונראה בעיני שאם היה",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתוב בשטרו שיהיה לו רשות לטרוף ולמשכן",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מנכסי הלוה עד שיגבה חובו הכל לפי תנאו",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ויכול לטרוף מנכסי הלוה אע\"פ שלא תבע",
      "segment_ids": [
        2
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הלוה תחלה:",
