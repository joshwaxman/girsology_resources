        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">תני</i> <i class=\"footnote\">רבה</i> <i class=\"footnote\">בר</i> <i class=\"footnote\">חנינא</i> <i class=\"footnote\">קמיה</i> <i class=\"footnote\">דר\"נ</i>",
