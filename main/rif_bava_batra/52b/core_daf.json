      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משפט וטעמא מדאיצטריכי תרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קראי ביום וחקת משפט משמע",
      "segment_ids": [
