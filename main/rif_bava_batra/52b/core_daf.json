      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נחלה כגון שאם צוה בפני ג'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"פ שלא קבלם לשם דייני'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סתמא נעשים דיינים וכל מה",
      "segment_ids": [
