  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ובני אחיות נוחלין ולא מנחילין <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>תניא בני",
      "segment_ids": [
        0
      ]
    },
    {
