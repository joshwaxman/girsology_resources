      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיאמרו טול אתה זה בכך ואתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה בכך יטול ואין א' מן",
