      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מרע לדעת ר\"ח אבל רב האי והרי\"ף פסקו",
      "segment_ids": [
