  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה בעל <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכו.)\" data-bavli-daf=\"126a\" data-bavli-index=\"0\"></span>אמר רב אסי <i data-commentator=\"Mishneh Torah, Inheritances\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>בכור שנטל חלק בפשוט",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויתר מאי ויתר רב פפי משמיה דרבא אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויתר בכל הנכסים <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>קסבר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>יש לו לבכור קודם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חלוקה ומדאחיל בהא אחיל בכולהו רב פפא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משמיה דרבא אמר ויתר באותה שדה קסבר אין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו לבכור קודם חלוקה ומאי דאתא לידיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחיל ואידך לא אחיל <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכו:)\" data-bavli-daf=\"126b\" data-bavli-index=\"1\"></span>ושלחו מתם בכור שמכר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודם חלוקה לא עשה ולא כלום אלמא אין לו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבכור קודם חלוקה והילכתא יש לו לבכור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודם חלוקה מר זוטרא מדרישבא פליג בהדי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחוה בצנא דפלפלי <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>אתו לקמיה דרב אשי א\"ל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הואיל וויתרתה במקצת ויתרתה בכל הנכסים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולן: חזינן מאן דפסק הילכתא כרבי דאמר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בכור נוטל פי שנים במלוה ואייתי ליה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראיה מהא דאיפסיקא הילכתא דיש לו לבכור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודם חלוקה <i data-commentator=\"Hagahot HaBach\" data-label=\"ג\" data-order=\"3\"></i>שמעינן דאע\"ג דלא מטא לידיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמאן דמטא לידיה דמי הילכך הילכתא כרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמר בכור נוטל פי שנים במלוה והאי סברא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאו דסמכא הוא דלא איפסיקא הילכתא דיש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו לבכור קודם חלוקה אלא במאי דאתא לידי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבוה ואיתיה השתא ברשותיה אבל מלוה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דליתיה ברשותיה לא שייכא בהא מילתא כלל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכן כתב רבינו האי גאון זצ\"ל כי האי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סברא: <b><big>מתני'</big></b> <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i>האומר <span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"1\" data-marker-letter=\"ב\">ב</span>איש פלוני בני בכור",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא יטול פי שנים איש פלוני בני לא יירש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עם אחיו לא אמר כלום שהתנה על מה שכתוב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתורה: <b><big>גמ'</big></b> <i data-commentator=\"Hagahot HaBach\" data-label=\"ד\" data-order=\"4\"></i>לימא מתני' דלא כר' יהודה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאי כרבי יהודה האמר בדבר שבממון תנאו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קיים גבי הרי את מקודשת ע\"מ שאין לך עלי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שאר כסות ועונה אפילו תימא ר' יהודה ע\"כ לא קאמר רבי יהודה התם אלא משום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דידעה ומחלה אכל הכא לא מחיל <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>: א\"ר יוסף אמר <i data-commentator=\"Mishneh Torah, Inheritances\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i>איש פלוני בני בכורי הוא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נוטל פי שנים בכור הוא אינו נוטל פי שנים דילמא בוכרא דאימא קאמר ההוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דאתא לקמיה דר' חנינא א\"ל מוחזק אני בזה שהוא בכור א\"ל מנא ידעת דבכור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הוא דכי הוה אתו לקמיה דאבוה אמר להו זילי <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>לגבי שכחת ברי דבוכרא הוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ומסי רוקיה ודילמא בוכרא דאימא הוא גמירי בוכרא דאבא מסי רוקיה בוכרא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דאימא לא מסי רוקיה: אמר רבי אמי בכור שנקרע ונמצא זכר אינו נוטל פי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שנים דאמר קרא (דברים כ״א:ט״ו) והיה הבן הבכור לשנואה עד שיהא בן משעת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הויה <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכז.)\" data-bavli-daf=\"127a\" data-bavli-index=\"2\"></span>אמימר אמר אף אינו ממעט בחלק בכורה שנאמר (דברים כ״א:ט״ו) וילדו לו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בנים עד שיהא בן משעת לידה רב שיזבי אמר אף אינו נימול לשמונה שנאמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "(ויקרא י״ב:ב׳) אשה כי תזריע וילדה זכר וביום השמיני ימול עד שיהא זכר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "משעת לידה אמר רבה תניא כוותיה דרבי אמי בן ולא טומטום בכור ולא ספק. בן",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ולא טומטום כדרבי אמי בכור ולא ספק לאפוקי מדדרש רבא",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אמר</b> רב אסי כיון שנוטל חלק כפשוט ולא מיחה לפני שנים לומר זה שאני נוטל כפשוט לא מפני שמחלתי א\"כ מחל וכי היכי שמחל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בנכסים מועטים אלו כן הויא לכל הנכסים שאינו נוטל שוב חלק בכורה כלל בכל הנכסים הנשארים לחלוק דבכור מתנה קרייה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רחמנא וכמי שמוחל במתנה הוא וכל הבכורה חדא מתנה היא וכיון שמחל במקצתה מחל בכולה וכן אמר ליה רב [אשי] למר זוטרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ששתק ונטל חלק כפשוט בסל של פלפלין ההיא מחילה הויא מחילה אף לשאר נכסים שלא הגיעו עדיין לידו. דהלכתא [דף קכו:] יש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבכור קודם חלוקה דבשעה שמת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האב זכה בחלק הבכורה הילכך אם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחלה או מכרה הויא מחילה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומכירה כיון שמת האב ואע\"פ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעדיין אינה הבכורה בידו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומיהו לענין מחילה ומכירה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא כמי שאינו רוצה לקבל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המתנה שייך למימר כן דיש כח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בידו למחול ולמכור קודם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיקבלנה כמי שאינו רוצה לקבלה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל לזכות בשבח שהשביח קודם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהגיע לידו כגון שלפופי והוו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמרי לא דעד דמטיא לידיה לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הויא מתנה: <b>גרסי'</b> בגמרא [דף",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קכו.] ההוא בכור דאזל וזבין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנכסי דידיה והפשוט מקמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דליפלוג בהדי פשוט אזול יתמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בני פשוט למיכל תמרי מחונהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקוחות אמרו ליה קריביה דיתמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא מסתייה דזבנתין לנכסייהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא מימחי נמי מחיתו להו אתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקמי' דרבא אמר להו לא עשה לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלום רב פפא סבר לא עשה ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלום בכולהו ורב פפי סבר דוקא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפלגא אבל חלק בכורה מכורה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והלכתא כרב פפי דסבר יש לו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבכור קודם חלוקה: <b>הבכור</b> מכר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל הנכסים חלקו וחלק אחיו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפשוט בלא רשותו לדעת שיתן לו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המעות ופסק רבא דחלק אחיו אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו למכור ולאו כלום הוא אבל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חלק בכורתו מכורה כמו שאמרנו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דיש לו לבכור קודם חלוקה וכל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכן חלק פשיטותו שיכול למכור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אף על פי שלא הוברר עדיין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חלקו מ\"מ ידוע הוא שיש לו חלק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו חלק איך שיעלה יכול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למכור וכן דעת כל המפרשים ז\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא כן פירש הר\"ש ז\"ל והלכתא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יש לו לבכור קודם חלוקה והא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפסקינן בבכורות (דף נב.) אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו לבכור קודם חלוקה התם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לענין שבח שהשביחו נכסים אחרי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כן אבל הכא לענין הגוף המוחזק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כן כתב הריטב\"א בשם הר\"י ז\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>: <b>מתני'</b> אע\"ג דכי קאמר לא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יטול זה או לא יירש זה ודאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממילא היה השאר לאחיו והיה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדין שיהיו דבריו קיימין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דקי\"ל כר' יוחנן בן ברוקא [דף קל.] דאם אמר על מי שראוי ליורשו זה יירש כל נכסי דבריו קיימין מ\"מ כיון שאמר בלשון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא יירש או לא יטול משמע כמתנה על מה שכתוב בתורה כי התורה אמרה שיתן לבכור פי שנים ושינחיל את בניו ומיהו אם סיים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בדבריו ואמר אלא שאר בני יירשו כל הנכסים דבריו קיימין לרבי יוחנן בן ברוקא דאמר אפילו בלשון ירושה מהני אלא שהבכור",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אינו מסולק מחלק בכורתו דאפילו רבי יוחנן ב\"ב מודה שלשון ירושה אינו מסלק אלא חלק פשיטות מדכתיב לא יוכל לבכר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובלשון מתנה אם נתן נכסיו לאחד מן האחין לכ\"ע דבריו קיימין שהרי בחייו אין לבניו בנכסים כלום ואפילו חלק בכורה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הפסיד הבכור כיון דאמר לשון מתנה א\"כ מצי יהיב למאן דבעי וכיון שנתן לאחר מיתה לא נשאר כלום כדי שיצטרך להנחילם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואפילו ר' יהודה דאמר בדבר שבממון תנאו קיים אמרינן הכא דלא מצי מתני משום דהכא לא מצי מחיל דבר שלא בא לידו של בן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אינו יכול למוכרו ולא למוחלו ואפילו הוי מצי מחיל ודאי לן דלא מחל ואע\"פ ששותק כדי שלא יכעיס אביו הוא דעביד ודאמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על אחד מן הפשוטין שיטול פי שנים נוטל הבכור פי שנים כדינו ומן השאר נוטל הפשוט פי שנים גם כן ויש אומרים שאינו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נוטל החלק היתר אלא במוחזק כדין הבכור כיון דאפקיה בהאי לישנא וזה דעת מורי נר\"ו ויש חולקין על זה. הריטב\"א ז\"ל:",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כשאמר</b> בכורי הוא נאמן וכדמפרש לקמן דאפילו ידעינן ביה שנולד אחר בנים אחרים אפ\"ה לאב הימניה רחמנא דאמר יכיר וא\"כ",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הראשונים ממזרין הם אבל כשאמר בכור הוא אינו נוטל פי שנים אם מת האב כיון שלא בירר לומר בכורי דדילמא בוכרא דאימיה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קאמר ואפילו ממון המוטל בספק לא הוי כיון שהממון בחזקת הבנים האחרים הוה הוא מוציא מחבירו ועליו הראיה: <b>מסי רוקיה.</b>",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מרפא רוקו למי שחושש בעיניו: <b>דכי אתו.</b> אותן החוששין בעיניהם לקמי אביו וכו' ואם קורהו אביו בכור גמור במסיח לפי",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תומו בכור הוא ונוטל פי שנים. הריטב\"א ז\"ל: <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>כיון דמשעה שנולד לא ידעינן אם זכר הוא שהרי סימניו היו מכוסין בבשר",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ורחמנא אמר שיהיה ניכר שהוא בן בצאתו מרחם אמו ולפיכך אם פשוט הוא הטומטום אינו ממעט בחלק בכורה כיצד אם הם ג' אחין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בכור וב' פשוטין ואחד מהפשוטין טומטום והניח אביהם ו' מנין יסתלק הטומטום מהם כאילו אינו ויחלקו הבכור והפשוט הששה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מנין נמצא שיגיע לחלק הבכור ד' מנין שהוא פי שנים יקח לעצמו ב' מנין שהם חלק בכורתו וב' המנין הנשארים יערבו אותם",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עם ב' המנין שהגיעו לחלק הפשוט ואותן ד' מנין יחלוקו בין שלשתם בשוה עם הטומטום נמצא שיגיע לחלק כל אחד מנה ושליש",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מנה נמצאו ביד הבכור ג' מנין ושליש נמצא שמרויח זה השליש משום סלוק הטומטום: <b>וביום השמיני.</b> דדרשינן אפילו בשבת הלכך",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא ידחה שבת כיון שאינו בן משעת לידה והיינו דאמר רב שיזבי אינו נימול לשמונה:",
      "segment_ids": [
        8
      ]
    }
  ],
