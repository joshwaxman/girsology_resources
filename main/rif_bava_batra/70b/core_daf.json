      "text": "<i class=\"footnote\">נכסי</i> <i class=\"footnote\">כו'</i> <i class=\"footnote\">כ\"ז</i> <i class=\"footnote\">בגמ'</i> <i class=\"footnote\">וברא\"ש</i> <i class=\"footnote\">ועי'</i> <i class=\"footnote\">פלפולא</i> <i class=\"footnote\">חריפת'</i> <i class=\"footnote\">על</i> <i class=\"footnote\">קיצור</i> <i class=\"footnote\">פסקי</i> <i class=\"footnote\">הרא\"ש</i> <i class=\"footnote\">אות</i>",
      "segment_ids": [
