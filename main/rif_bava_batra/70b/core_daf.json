    {
      "width": "655px",
      "right": "275px",
      "text": "<i class=\"footnote\">לרב</i> <i class=\"footnote\">שמואל</i> <i class=\"footnote\">בר</i> <i class=\"footnote\">אחא</i> <i class=\"footnote\">אגב</i> <i class=\"footnote\">אסיפאדביתיה</i> <i class=\"footnote\">כי</i> <i class=\"footnote\">אתא</i> <i class=\"footnote\">נפק</i> <i class=\"footnote\">לאפיה</i> <i class=\"footnote\">עד</i> <i class=\"footnote\">תווך</i> <i class=\"footnote\">שטרי</i> <i class=\"footnote\">איקרט</i>",
