  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>סבר</b> רב פפא למימר דבנכסים אלו לא תזכה אשתו במותר כתובתה דאע\"ג דלא מחלה בנכסים דעתיד למקני <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ה\" data-order=\"5\"></i>ודאי מינייהו תגבה מותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כתובתה מיהו בהני נכסים כבר מחלה ולא שקלה בהו וא\"ל רב כהנא שהיא לעולם לא מחלה בנכסים הראויים לבא לבעלהמאיזה צד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שיהיו דנכסי הבת הוא דמחלה אבל נכסי בעלה לעולם לא מחלה וכי היכי דאילו הדר קני שקלא השתא נמי שקלא: <b>ההוא דפלגינהו</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וכו' לית לה אלא דיקלא.</b> דבשאר נכסי מחלה שהיתה שותף עם הבנים ואמר ליה רב יימר דאי מחלה בכל הנכסים נמי מחלה אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודאי משמע שאתה מודה דכל היכא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאשתייר נכסי לא אמרינן דמחלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום שעשאה שותף כיון שהיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רואה נכסים שאפשר לגבות מהם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אם כן לא תימא נמי דמחלה בכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוץ מדקל זה דכיון דסליק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדעתא למגבא לא מחלה כלל אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סברה יעשו בית דין שומא על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקל זה ואם אינו שוה כמותר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתובתי אז אערער על הנכסים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחילק דכל היכא דאשתייר נכסים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפי' כל שהם דעתה עליהם ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחלה: <b>האי לישנא דאמר אלא</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>למאן.</b> הוי כאלו אמר נכסי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפלוני דאם ראוי ליורשו נוטלו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום ירושה ואם אינו ראוי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליורשו הוי מתנה כלומר כאילו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמר לו בלשון ירושה או בלשון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתנה וסבר רב אדא בר אהבה דהא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דנפקא מינה בין אם הוא משום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ירושה או אם הוא משום מתנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא לענין מזונות אלמנתו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקי\"ל (כתובות דף צה:) אלמנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניזונית מנכסי יתומים אבל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינה ניזונית (גיטין דף מח:)",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מנכסים משועבדים משום דמזונות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוה דבר שאין להם קצבה ולא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יכלי לקוחות להזהר כל כך הלכך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני תיקון העולם תקנו שלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תהיה ניזונית ממכר ומתנה מפני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהם נכסים משועבדים וסבר רב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדא בר אהבה דאם ראויים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליורשו היינו נכסי יתומים ואם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינם ראויים ליורשו היינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתנה שהם נכסים משועבדים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינה ניזונית מהם וא\"ל רבא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהך מתנה שאינה אלא מדרבנן כל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכן הוא דאלמנתו ניזונית ממנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>דאין קנין לאחר מיתה כיון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין המקנה יכול להקנות ומתנת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ש\"מ אינה אלא לאחר מיתה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותקנתא דרבנן היא דליהוי מתנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כי היכי שלא תטרף דעתו עליו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומזונות אלמנה הוי נמי תקנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרבנן והך תקנתא לא תדחה תקנת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מזונות הקודמת <i data-commentator=\"Hagahot HaBach\" data-label=\"ח\" data-order=\"8\"></i>ומכל שכן מה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ירושה דאורייתא אינה דוחה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותה מתנה שהיא כירושה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ו\" data-order=\"6\"></i>[דרבנן] דהיינו לאחר מיתה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומדרבנן לא כ\"ש וכיון שאין לה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דין משועבדין מלוה על פה גובה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנה ודעת ר\"י ז\"ל דמטלטלי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[דמתנת] שכיב מרע לא משתעבדי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבע\"ח דלא תקנו הגאונים ז\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא ביורשים בלבד וזה הנראה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו וכן דעת מורי הרשב\"א ז\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נ\"ר וריטב\"א ז\"ל ומיהו אם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היורשין אחר שזכו או מקבלי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתנה אילו מכרו או נתנו במתנת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בריא הפסידה והיינו דאמרינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכתובות [דף סט.] מכרו או",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משכנו מוציאין לפרנסה ואין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוציאין למזונות ברם נראין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדברים דבמתנה שהיתה מחיים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג שהיא מדרבנן כיון שאינה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כירושה יש לה דין מתנה בעלמא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיא כמשועבדין ובע\"ח לא יגבה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנה אלא מן היורשים וכתב ה\"ר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יונה ז\"ל דהיינו כשפירש המתנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולא פירש חלק היורשים אבל אם אמר תנו מאתים זוז לפלוני בני ומאתים זוז לפלוני שאינו ראוי ליורשו ודאי בנו קודם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהקדימו ואם יצא עליו שטר חוב גובה מאותו איש נכרי דהא הוה מצי למימר ד' מאות זוז לבני ולפלוני אבל אם אין המספר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שוה כגון מנה לאחד ומאתים לאחר דינן שוה וגובה מכולן כאחד ולשון הרמב\"ם ז\"ל גבי מזונות אלמנה פי\"ט מהל\"א נתן כל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נכסיו במתנה לאחרים הואיל ומתנת ש\"מ אינה קונה אלא לאחר מיתה כמו שיתבאר הרי המתנה וחיוב נכסים בתנאים אלו באים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כאחד ולפיכך אלמנתו ובנותיו ניזונות מנכסיו אבל במזונות בנותיו תפס עליו הראב\"ד ז\"ל ואמר דמזונות אלמנה כיון דמחיים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תפשה לה לא פקע שעבודיה אבל לגבי מזון הבנות כמשועבדין נינהו אלא אימא דנפקותא דאם ראוי ליורשו או לא הוא להא דרב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחא שאם אמר האי לישנא דאלא למאן ואמר ואחריו לפלוני רואין אם ראשון ראוי ליורשו אין לשני במקום ראשון כלום שהרי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא כמתנה על מה שכתוב בתורה שהתורה אמרה שאין לנחלה הפסק כדאמרינן ובן אין לו ודרשינן עיין עליו הלכך אע\"פ שהתנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בפירוש תנאו בטל אבל אם אינו ראוי הוי לשון מתנה ודבריו קיימין:",
      "segment_ids": [
        2
      ]
    }
  ],
