        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמסתייעי מינה איכא עלייהו תיובתא דאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתין פליגא עליה דרב אדא בר אהבה הוה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבא מותיב עליה מינה ומדלא אותבה עליה",
