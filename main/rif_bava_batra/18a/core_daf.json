  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "לישתבע דכל מקום ששנים מחייבין אותו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממון עד א' מחייב אותו שבועה כי אמרי'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמי <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>א' לשבועה ה\"מ היכא דקא כפר במאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דקא מסהיד סהדא אבל האי <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>קאמר אין אכלי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודידי אכלי הא ודאי דמי לדרבי אבא דאמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ה\"ל מחויב שבועה ואינו יכול לישבע וכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המחויב שבועה ואינו יכול לישבע משלם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והיכא דליכא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\"><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>וכ\"ה</i> <i class=\"footnote\">הב\"ח</i>[אפילו] חד סהדא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאכל והוא אמר מינך זבינתה ואכלתה שני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חזקה והאי א\"ל מיגזל גזלתה ארעא מינאי",
