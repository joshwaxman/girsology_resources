      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויקח שלו: <b>אזל לא אשכח <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ח\" data-order=\"8\"></i>.</b> אירע",
      "segment_ids": [
