        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואכלתה תרתין שנין משתבע ליה מרי ארעא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלא זביני לך מידי ומהדר ליה ארעא ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחויב לאהדורי ליה פירי דכיון דליכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סהדי דאכלה תרתי שנין אלא איהו קאמר אין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אכלי ודידי אכלי ותלת שני חזקה אכלי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משתבע שבועת היסת דליכא גביה לחבריה",
