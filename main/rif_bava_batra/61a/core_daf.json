    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכי לזרוזינהו הוא דעבד:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתני' הכותב נכסיו לאחרים.</b>",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלשון מתנה אע\"פ שמה שעשה",
      "segment_ids": [
