        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו מברא בישא לברא טבא וכ\"ש מברא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לברתא דלא ידעת מהי מינייהו נפק זרעא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעליא ירושלמי אמר רבי אבא בר ממל הכותב",
