      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[דף קעד.] כל מקום ששנה רשב\"ג",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במשנתנו הלכה כמותו היינו",
      "segment_ids": [
