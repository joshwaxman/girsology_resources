        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקל אין נותנין להן אלא שקל ואם אמר אם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתו יירשו אחרים תחתיהם בין שאמר תנו",
