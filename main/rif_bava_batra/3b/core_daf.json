      {
        "width": "245px",
        "text": "<i class=\"ror-line\" data-ror-i=\"14\" data-ror-conf=\"medium\" data-ror-ref=\"Rashi on Bava Batra 6a:9\" data-ror-ocr=\"הקורות כדפרישיח לא הוי חזקה לראובן\">קורות כמו שפירשתי לא הויא חזקה</i>"
      },
