      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וטעמא מפני שאין אלו זוכין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשטר אלא באמירה ולא גרעה האי",
      "segment_ids": [
