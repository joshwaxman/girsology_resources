    {
      "width": "380px",
      "right": "275px",
      "text": "[<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">גי'</i> <i class=\"footnote\">ד\"ת</i> <i class=\"footnote\">[וכ\"ה</i> <i class=\"footnote\">הב\"ח]</i> <i class=\"footnote\"></i>אבל <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>בדקה מכר את",
      "segment_ids": [
        1
      ]
