      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרם משום דמרוחקין השורות טפי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונחשבת כל שורה ושורה בפני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמה ואנן בעינן כדפירשנו",
      "segment_ids": [
