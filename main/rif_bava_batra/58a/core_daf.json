      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זה דאפי' ליכא הכא מתנה דאחר קנו האחיות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דיחלקו לשון מתנה הוא ודבריו קיימים",
      "segment_ids": [
