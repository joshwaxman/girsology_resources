  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "כולן מאי טעמא אמר רב אשי בההיא הנאה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דקא צייתי להדדי גמרי ומקני להדדי איתמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>שני אחין שחלקו ובא להן אח ממדינת הים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב אמר בטלה מחלוקת ושמואל אמר מקמצין:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "א\"ל <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>רבה לר\"נ ולרב דאמר בטלה מחלוקת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלמא הדר דינא אלא מעתה הני בי תלתא",
