        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיכא שלא מכר הראשון ולא נתן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא ששעבד ואפי' באפותיקי",
      "segment_ids": [
