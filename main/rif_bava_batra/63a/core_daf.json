      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובמשכונא ומת (יורד) [יורש]",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השני ואין חוב זה גובה ממנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל שלא מכר ונתן ממש זוכה בהם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחריך אם לא החליט לו מחיים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכן דעת שני רבותי. הריטב\"א",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל: <b>איזהו רשע.</b> שמפסיד ולא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו והוא ערום שנתקיימה עצתו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום דקי\"ל כרשב\"ג: <b>זה המשיא</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עצה.</b> לראשון למכור בנכסים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמפסיד לשני ועושה כנגד כוונת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנותן: <b>אמר</b> המחבר המשיאו עצה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקרא רשע לפי שהוא חוטא ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו אבל המוכר עצמו איסורא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עביד אבל רשע לא מיקרי:",
