        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפרק מי שמת <i data-commentator=\"Hagahot HaBach\" data-label=\"ו\" data-order=\"6\"></i><sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בד\"ק</i> <i class=\"footnote\">אמר</i> <i class=\"footnote\">רבא</i> <i class=\"footnote\">אר\"נ</i>אמר רב",
