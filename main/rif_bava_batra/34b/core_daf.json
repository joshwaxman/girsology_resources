  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה ריבעא כמו הנותן בבור חלק סתם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנותנין ליה ריבעא וכן הלכתא פירוש בור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זה בור של מים הוא אם אמר תנו חלק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפלוני בבור סתם ולא א\"ל לא לחבית ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לזולתה יהבינן ליה רביע <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>שאין דרך בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדם לומר חלק סתם על פחות מרביע אבל אם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר תנו לו בו חלק לחבית נותנין לו חלק",
