      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחרינא דסלקא בתיקו וכיון דלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איפשיטא נקטינן מיניה חומרא",
