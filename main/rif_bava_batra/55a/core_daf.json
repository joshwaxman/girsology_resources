  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רב הונא לירתיה ואפילו לירתי ירתיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ורב ענן אמר לירתיה ולא לירתי ירתיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלחו מתם הלכתא כרב ענן ולאו מטעמיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הילכתא כוותיה דבעל לא ירית ולאו מטעמיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאי אית לה ברא ירית [ובעל היינו טעמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלא ירית] משום דהוי ליה ראוי ואין <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>הבעל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוטל בראוי כבמוחזק מכלל דרב הונא סבר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבעל נוטל בראוי כבמוחזק א\"ר אלעזר דבר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זה נפתח בגדולים ונסתיים בקטנים כל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האומר אחריך כאומר מעכשיו דאמי ולית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הילכתא כוותיה ודייקינן מינה טעמא דאמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחריך הוא דהוי ראוי הא אמר מעכשיו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מוחזק הוי וירית",
      "segment_ids": [
        0
      ]
    }
  ],
  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אמר</b> המחבר ואי קשיא להאי גרסא למה ליה לנותן למימר ובתרה לירתה פשיטא דיורשיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יורשין אותה הא לא קשיא כלל שאילו לא אמר ליורשיה האי סבתא היתה יכולה למכור ולתת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואפילו לכתחלה והשתא אפילו לרשב\"ג אסור לה למכור ואינה רשאה לכתחלה <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>ועוד כי בעלי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חובותיה של זקנה היו גובין מיורשיה ועכשיו אינם גובים שאינם יורשים אלא מכח הנותן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשעבוד אינו מכר לענין זה וגם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אילו נתנה לה סתם ונתנה במתנת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכיב מרע מתנתה מתנה ועכשיו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינה מתנה שכבר קדמו אחריך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדאיתא לקמן [שם] וזה ברור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומיהו גם המפרשים שפירשו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמעכשיו הוא כדפירש' דמסתמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כי אמר ובתרה לירתה או ואחריך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפלוני ר\"ל מעכשיו דאי בלאחר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיתה זה היכי ירית לה ואפילו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "[הכי] הוי ראוי לדידהו הם נמי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מודים דכשאמר בפירוש מעכשיו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלשון הרב ז\"ל שירית בעל ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטעם הרב אלא משום יתורא דלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך ליה למימר מעכשיו דבלאו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכי נמי משמע הכי אלא ודאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "להכי אתא לומר שיהיה כמהיום כדי שיזכה בו בעל דהא קי\"ל כר' עקיבא דדריש יתור לשון לעיל בפרק המוכר את הבית [דף סד.]",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גבי בור ודות ואע\"ג דאמרינן לעיל [דף סט:] דאם מכר שדה משמע כל האילנות ואם כתב דקלין ותאלין הוצין וציצין שופרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דשטרא הוא דמשמע דלא דרשי יתורא נראה לי לחלק דהכא מה שפירש ממש היה נשמע בלא פירוש לא פחות ולא יותר וכן הוא בבור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ודות אבל גבי שדה אינו מוכרח שישמע במכירת השדה כל האילנות אלא בשדה זה אבנים וענינים אחרים שפירש לעיל [דף סח:]",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואע\"פ שמדינא נמי נכלל בו כל האילנות מ\"מ אפשר לערער בו על כן הוי שופרא דשטרא והיאך גירסא שכתבנו נכסי לסבתא ובתרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לירתה היא הנכונה ולא גרסינן ובתרה לירתאי דלירתאי הוי כאילו שייר לעצמו ואז לא אמרינן דאם זבנה זביניה זביני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כדאמרינן בסוף פירקין [דף קלז:] דעד כאן לא קאמר רשב\"ג דאם קדם ראשון ומכר מה שמכר מכר אלא לאחר אבל לעצמו לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלעולם מניח לעצמו גוף הקרקע ואינו נותן אלא הפירות וא\"כ לא הוי ראוי והוה ירית בעל ואנן אמרינן הכי דלא ירית:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>גרסינן</b> בגמ' [דף קכו.] אמר רב הונא אמר רב אסי בכור שמיחה מיחה אמר רבה מסתברא טעמיה דרב אסי בענבים שבצרום זיתים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומסקום אבל דרכום לא ורב יוסף אמר אפילו דרכום מעיקרא ענבי והשתא חמרא כדאמר רב עוקבא ליתן לו דמי היזק ענביו הכא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נמי ליתן לו דמי היזק ענביו: <b>שמיחה.</b> ואמר לאחיו תנו לי חלקי בנכסים ואני אשביח חלקי ונתעצלו אחיו ולא חלקו ושבחו",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כגון שבצרו ענבים ומסקו זיתים השביחו בחלקו בעבורו כיון שאין בו שינוי אלא שנותן להם הוצאה כדין יורד לתוך שדה חברו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלא ברשות הא דרכום כיון דמעיקרא ענבים והשתא יין כיון דאישתני והשביח מחמת היתומים אינו נוטל בו פי שנים ומשמע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "טעמא דמילתא דכיון דאינו נוטל מדינא במה שהשביחו היתומים אלא מפני שמיחה די אם נוטל משום מחאתו במה שהיה נמצא בידו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומוחזק בו קודם לכן אבל יין שלא היה נמצא בידו כן אינו נוטל אפילו אם מיחה אלא דוקא דמי היזק ענבים כגון שאם נשפך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "היין יפרעו לו ענביו בצורין ולא מחוברין או אפילו אינו נשפך יכול לטעון שיפרעו לו דמי ענביו שהיה רוצה אותם לעשות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מהם צמוקים שישוו יותר כיון שדרכו אותם בלא מצותו לאו כל כמינייהו דליפסדו ליה בידים:",
      "segment_ids": [
        2
      ]
    }
  ],
