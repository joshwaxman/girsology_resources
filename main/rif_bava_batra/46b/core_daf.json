    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סתם שאין לו מעות או מטלטלין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קודם שיפרענו בקרקע [או כל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היכא] דפרע במטלטלין ע\"פ שומת",
