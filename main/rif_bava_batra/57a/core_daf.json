  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אבא לרב יוסף בר חמא היה יודע לו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעדות קרקע עד שלא נסתמא ונסתמא פסול",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושמואל אמר כשר אפשר דמיכוין מצרנהא אבל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גלימא לא ורב ששת אמר אפילו גלימא אפשר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמיכוין מדת ארכו ורחבו אבל נסכא לא ורב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פפא אמר אפילו נסכא אפשר דמיכוין מדת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משקלותיו מיתיבי היה יודע לו בעדות עד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא נעשה חתנו ונעשה חתנו פיקח ונתחרש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פיתח ונסתמא שפוי ונשתטה פסול אבל היה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יודע לו בעדות עד שלא נעשה חתנו ונעשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חתנו ומתה בתו פיקח ונתחרש וחזר ונתפקח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שפוי ונשתטה וחזר ונשתפה פיתח ונסתמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחזר ונתפתח כשר <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>זה הכלל כל שתחלתו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בכשרות וסופו בכשרות כשר <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכח:)\" data-bavli-daf=\"128b\" data-bavli-index=\"0\"></span>ותיובתא דכולהו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תיובתא: שלח ליה ר' אבא לר\"י בר חמא",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האומר על תינוק בין הבנים בכור הוא נאמן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כר' <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>יהודה ור' יוחנן אמר אינו נאמן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרבנן: שלח ליה רבי אבא לרב יוסף בר חמא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האומר <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Even HaEzer\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Ownerless Property and Gifts\" data-label=\"⚬\"></i>תטול אשתי כא' מן הבנים נוטלת כא'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הבנים אמר רבא <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>בנכסים של עכשיו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובבנים הבאים לאחר מיכן: שלח ליה ר' אבא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרב יוסף בר חמא המוציא שטר <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Creditor and Debtor\" data-label=\"⚬\"></i>חוב על",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חבירו מלוה אומר לא נפרעתי כלום ולוה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר פרעתי מחצה והעדים מעידין שפרעו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולו. נשבע <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>וגובה מחצה מנכסים בני חורין",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבל מנכסים משועבדים לא מאי טעמא אמרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לקוחות אנן אעדים סמכינן ואפילו לרבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עקיבא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>דאמר משיב אבדה הוה הני מילי היכא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דליכא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>שטרא <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"ב\" data-order=\"2\"></i>אכל היכא דאיכא <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">עדים</i>שטרא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אירתותי מירתת מתקיף לה מר בר רב אשי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדרבה אפילו לר\"ש בן אלעזר דאמר מודה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "במקצת הטענה הוה הני מילי היכא דליכא עדים דקא מסייעי ליה אבל היכא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דאיכא עדים דקא מסייעי ליה ודאי משיב אבדה הוה דרש מר זוטרא משמיה דרב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שימי בר אשי הילכתא ככל הני שמעתתא כדשלח ליה רבי אבא לרב יוסף בר חמא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בגמ'</i> <i class=\"footnote\">איתא</i> <i class=\"footnote\">א\"ל</i> <i class=\"footnote\">רבינא</i> <i class=\"footnote\">לרב</i> <i class=\"footnote\">אשי</i> <i class=\"footnote\">דר\"נ</i> <i class=\"footnote\">כו'</i> <i class=\"footnote\">(ג\"א)</i>א\"ל רבינא למר זוטרא דרב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "נחמן מאי א\"ל אין גובין מתנינן לה וכן אמר ר\"נ אין גובין ואלא הילכתא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לאפוקי מאי <span class=\"bavli-ref\" data-bavli-ref=\"(דף קכט.)\" data-bavli-daf=\"129a\" data-bavli-index=\"1\"></span>אי",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ו\" data-order=\"6\"></i>במסכת ערכין בפ' השיג יד (דף יז:) מפרש לה מדכתיב והוא עד או ראה או ידע אם לא יגיד בעינן ראיה והגדה בכשרות והא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דבמביא גט [דף כג.] <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ז\" data-order=\"7\"></i>הכשיר כל שתחלתו וסופו בדעת ואע\"פ <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ח\" data-order=\"8\"></i>שנשתנה התם קיום שטרות דרבנן והקילו בה רבנן משום עגונא:",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בעינן שיהא תחלתו וסופו בכשרות.</b> כגון שמתה בתו ולא נשתייר בנים ממנה הא איכא בן או בת <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ט\" data-order=\"9\"></i>אכתי בפסולו עומד וכולהו הני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מפסלי אפי' לעדות קרקע דמודו כולהו דכיון דיכול לכוין המצרים וכ\"ש בגלימא ונסכא דפליגי אי מדה הוי סימן ואי משקל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוי סימן ומיהו נפקא לן מהא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפסלינן למדה ולמשקל משום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבעינן תחלתו וסופו בכשרות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משמע דבכה\"ג שהוא כשר נאמן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומפקינן מיניה הגלימא או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החתיכה של כסף וה\"נ מסקינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באלו מציאות (דף כח.) דמדה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומשקל הוי סימן ומתמהי רבוותא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהרי יש לחוש לרמאים בהרבה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צדדים שיתן אדם סימני כלי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חבירו בכליו הדומה לו ואח\"כ",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יתבע כלי חברו בעדי סימנין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שראו בידו גלימא זו קודם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאותו זמן שעדי התובע מעידין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו ולהוציא ממון היה ראוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחוש לכל זה לכך נראה להם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאיירי כגון שהנתבע טוען",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חזרתי לו אותו כלי שהעדים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעידין עליו הסימנין וכיון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאנו רואין בכלי שהוא עתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בידו אותם הסימנים לאו כל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הימנו לומר החזרתיו לך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומוציאין אותה מידו מפורש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעיל: <b>קמ\"ל</b> ר' אבא דלישנא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שתטול מתנה הוא ואע\"ג דאמר לה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כאחד מן הבנים שהחלוקה להם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כירושה ה\"ק שתטול היא במתנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כאחד מן הבנים בירושה ואיירי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין בבריא בין בשכיב מרע אלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבבריא לא סגיא באמירה בעלמא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא בקנין גמור ובשכיב מרע",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באמירה בעלמא ואשמועינן ר'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבא דלא אבדה כתובתה בשביל זו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמתנה היא לטפויי לה דאע\"ג",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דנראה שעשאה שותף בין הבנים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואמר ר\"נ לקמן דכיון שעשאה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שותף בין הבנים אבדה כתובתה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"מ במחלק כל נכסיו אבל זה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינו מחלק כל נכסיו אלא מתנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלמא הוא דיהיב לה לטפויי לה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפיכך אמר רבא דבנכסים של",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עכשיו דוקא תטול ולפי הבנים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שימצאו בעת החלוקה שהיא אחר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מיתתו שלפיהם נחלוק שיעור נכסיו של עכשיו תטול היא כאחד מהם ולא שתטול מנכסים אלו כפי חלק שיטלו הם מהנכסים שימצאו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאחר מיכן נמצא שאם ירבו הבנים תמעט חלקה מפני שאין דעתו ליתן לה אלא כפי הבנים שיהיו בעת החלוקה ואין להקשות כיון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנותן לה כפי הבנים שיולדו הוה ליה כחמור דאמרינן פרק מי שמת [דף קמג.] דלא קנה דשאני הכא שמקנה להם בדין מכח",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ירושתה שיירשו אז ולאו כחמור נינהו וכן תירץ הגאון ר' מתתיה ז\"ל. ולפי הסברא היה נראה ג\"כ שאם ימעטו הבנים שירבה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חלקה דהא לא איכוין איהו אלא שאם יש לו בנים יותר שלא יפסידו בשבילה אבל כשנתמעטו תחלוק היא עם הבנים חלק כחלק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מאותן הנכסים של עכשיו וכן כתב רשב\"ם ומיהו הרשב\"א ז\"ל כתב דהם מוחזקין בירושה הנשארת מהאחין שמתו הלכך הוה היא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מוציאה והמוציא מחבירו עליו הראיה ואינה נוטלת דשמא כך אמר לה תטול אחר מותו כמו שראוים עכשיו ליטול אחד מהבנים וכן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דעת הרא\"ה ז\"ל דלעולם ידה על התחתונה ואם יש מחלוקת בשעת מיתה אם היו לו נכסים אלו בשעת מתנה על המקבל מתנה להביא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ראיה כי הנכסים בחזקת יורשין הם וכן כל כיוצא בזה הריטב\"א ורבו ז\"ל: <b>אפילו לר\"ע דאמר.</b> גבי סלעים או דינרין הכתוב",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשטר המלוה והמלוה אומר שהם חמש והלוה אומר שלש ואמר ר' עקיבא התם דלוה לא הוי מודה מקצת אלא פטור הוא משבועה משום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמשיב אבדה הוא הני מילי שהשטר והעדים לא מוכחין טפי משני סלעים דתפשת מועט תפשת והוה בעי למימר שנים הוו הלכך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כשאומר שלש משיב אבדה הוי אבל הכא דאיכא שטרא מכל החוב וגם העדים ראו שלא פרעו כולו רתותי מרתת למימר שפרעו שמא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יכחישוהו העדים כשיבואו להעיד הלכך לא הוי משיב אבדה וחייב לישבע כדין כל מודה מקצת ואע\"ג דבאו העדים אחר כן להעיד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שפרע כולו הודאתו טפי היא דכמאה עדים דמי ואם תאמר מכל מקום כיון שמעידין שפרע לפחות חציה אמאי ישבע הא איכא עדים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בדבר ויש לומר טעם שהוכחשו העדים מפיו שהרי הודה במקצת והם העידו שפרע הכל ומכל מקום לא חשבינן להו כמאן דליתנהו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כדי שלא נאמינהו אף בשבועה כדין כל חוב שהוא בשטר שהרי אפשר לומר שהם זכורין מן הענין יותר ממנו וכיון דהכחשה ולאו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הכחשה הוא אין סומכין לא על העדות לגמרי ולא על השטר לגמרי אלא מספיקא נדון כאילו לא היו לא עדים ולא שטר ומודה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מקצת הטענה ישבע: <b>הלכה לאפוקי מאי.</b> דאי ליכא מאן דפליג פשיטא דהלכתא היא: <b>אי לאפוקי מדרבא.</b> דאמר לעיל דשלישי כשר",
      "segment_ids": [
        3,
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "להעיד אף לראשון מוסיף הוא על דברי רבי אבא ורבי אבא לא פליג עליה בהא אלא כך שאלוהו ועל מה ששאלוהו השיב ולאפוקי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ממאן דפסיל בפרק זה בורר (דף כח.) שלישי בשני אבל אין ה\"נ דהוה מכשיר אף בראשון כרבא מהא משמע דהלכתא כרבא:",
      "segment_ids": [
        5
      ]
    }
  ],
