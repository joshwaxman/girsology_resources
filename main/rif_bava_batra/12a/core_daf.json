      "right": "275px",
      "text": "גרמא הוא אמר רב טובי בר קיסנא אמר רב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתנה אמר רב זאת אומרת גרמא בנזקין אסור",
