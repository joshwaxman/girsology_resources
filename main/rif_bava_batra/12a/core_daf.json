  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בהדי דמנח ליה קפצה ויתבא ארישא <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>והא",
      "segment_ids": [
        0
      ]
    },
    {
