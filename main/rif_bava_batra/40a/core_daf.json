      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אא\"כ א\"ל הוא וכל מה שעליו או כל מה",
      "segment_ids": [
