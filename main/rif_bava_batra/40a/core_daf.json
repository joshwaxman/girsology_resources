      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ושק ודסקיא אפי' אם הם עליו אינן מכורים",
      "segment_ids": [
