      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דראובן מי בעי להרחיק טפי או לא ואמרי'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הא דתנן לא יחפור וכו' תנא בא\"י קאי",
      "segment_ids": [
