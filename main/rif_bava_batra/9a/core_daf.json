      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בה\"כ והרחיק ג' טפחים ואכתי מפסיד לבירא",
      "segment_ids": [
