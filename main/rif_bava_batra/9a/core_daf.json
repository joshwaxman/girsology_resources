      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ותנא בור סמוך לבור ולא בור סמוך לבאר",
      "segment_ids": [
