  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא קנייה היורש לההיא גזילה דכמאן דלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נפקא לה <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>גזלן מרשות (גזלן) דמי דליכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שינוי רשות ומחייב היורש לאהדורי גזילה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעינה למארה ליכא לאקשויי דהא ליכא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאוקמה ביורש משום דלא מצי שמעון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאסהודי ליורש דניחא ליה דהדרא ליה הפרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והטלית והוי ליה נוגע בעדותו אלא אליבא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרמי בר חמא דאמר רשות יורש כרשות לוקח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמי ואישתני ליה רשות גבי יורש כדאישתני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גבי לוקח וקנייה יורש לההיא גזילה דהוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה יאוש ושינוי רשות <i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>כדקאני לה לוקח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאי איכא למימר אמאי לא קא מוקמית לה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביורש ועוד קשיא ליה לאביי מפני",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאחריותה עליו ומפני שאין אחריותה עליו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני שחוזרת ואינה חוזרת מבעי ליה פירוש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאי בלוקח מגזלן עסקינן והאי דאינו מעיד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשדה ובית משום דניחא ליה דהדרי ליה והא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמעיד בפרה וטלית משום דלא הדרא ליה אי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכי האי דקתני (סיפא) מפני שאחריותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליו ואין אחריותה עליו מפני שחוזרת לו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ואינה חוזרת לו מבעי ליה לתנא למיתני ומדלא תאני תנא הכי שמעינן דלאו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בלוקח מגזלן עסקינן ובטיל ליה פירושא דרב ששת ופרישנא למתניתין כדרבין",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בר שמואל דאמר רבין בר שמואל משמיה דשמואל המוכר שדה לחבירו שלא באחריות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אין מעיד לו עליה מפני שמעמידה בפני בעל חובו אבל פרה וטלית לא מבעיא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "<span class=\"bavli-ref\" data-bavli-ref=\"(דף מד:)\" data-bavli-daf=\"44b\" data-bavli-index=\"0\"></span>סתמא דלא משתעבדא ליה לבעל חובו ולא הדרא ליה דמעיד לו עליה המוכר שהרי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אין מעמידה בפני בעל חובו אלא אפילו עשאה אפותיקי נמי לבעל חוב ומכרה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מעיד לו עליה דהא לא משתעבדא ליה לבעל חובו ולא הדרא ליה כד מזבין לה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "כדרבא דאמר רבא <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Creditor and Debtor\" data-label=\"⚬\"></i>עשה <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>עבדו אפותיקי ומכרו בע\"ה גובה ממנו שורו וחמורו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אפותיקי ומכרו אין בע\"ח גובה ממנו מאי טעמא האי אית ליה קלא והאי לית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ליה קלא ואקשינן אי לא חיישת לפרה וטלית <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>ואפילו עשאה אפותיקי לבע\"ח משום",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דלא משתעבדא ליה ולא הדרא ליה כדרבא ליחוש דילמא אקנייה לההיא פרה וטלית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לבע\"ח דידיה אגב מקרקעי קנין גמור ולא ליסהיד ליה ללוקח עלה דניחא ליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "משום דהדרא לבע\"ח דידיה כדרבה דאמר <sup class=\"footnote-marker\">*</sup><i class=\"footnote\">בדפו\"י</i> <i class=\"footnote\">רבא</i>רבה <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Creditor and Debtor\" data-label=\"⚬\"></i>אקני ליה מטלטלי <i data-commentator=\"Shiltei HaGiborim\" data-label=\"ב\" data-order=\"2\"></i>אגב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מקרקעי גבי מקרקעי וגבי מטלטלי ואמר רב חסדא והוא דכתב ליה דלא כאסמכתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ודלא כטופסי דשטרי ופרקינן הכא במאי עסקינן דמעיד לו עליה ולא חיישינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "להכי <i data-commentator=\"Hagahot Chavot Yair\" data-label=\"א\" data-order=\"1\"></i>כגון שלקח אותה פרה או אותו טלית ומכרה לאלתר דלא שהתה (לה) גביה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דליחוש דילמא אקנייה לבע\"ח דידיה ואקשינן <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>וליחוש דילמא דאיקני א\"ל לבע\"ח",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דידיה כדכתבינן האידנא שקניתי ושעתיד אני לקנות הילכך אע\"ג דלקח ומכר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לאלתר קנייה בעל חוב מעידנא דזבנה וכיון דזבין לה לאו דידיה קא מזבין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "והדרא לה לבעל חוב ולפום הכין לא יעיד לו עליה שהרי מעמידה בפני בעל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "חובו ומדלא חיישת להכי דקתני מעיד לו עליה שמעת מינה דאקנה וקנה ומכר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ב\" data-order=\"2\"></i>דאיבעיא לן בפרק מי שמת ולא איפשיטא בהדיא לא ממתניתין ולא מברייתא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תפשוט מהאי דתניא דלא קנה ופרקינן הכא במאי עסקינן כגון דקא אמרי עדים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ידענא ביה בההוא דלא הות ליה ארעא מעולם דהא ליכא למיחש דילמא אקנייה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בדאיקני אגב ארעא ומשום הכין מעיד לו עליה ואקשינן והאמר רב פפא אע\"ג",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דאמור רבנן המוכר שדה לחבירו שלא באחריות ובא בעל חוב וטרפה אינו חוזר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "עליו נמצאת שאינו שלו חוזר עליו הכא נמי אע\"ג דהאי פרה או חמור כד מזבין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לה לא טריף לה בעל חובו ולא הדרא ליה כיון דכי נפקא האי פרה",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מפני שחוזרת לו מיבעי ליה.</b> דלא מצינו אחריות בתלמוד [אלא במוכר ולא] כמו שאתה צריך לפרשו לפירוש רב ששת שאחריותו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וזכותו של נגזל עליו דלוקח כדי להוציא הקרקע אח\"כ מידו אלא סתם אחריותו [עליו שבכל הגמרא] חוזר על המוכר: <b>אלא</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כדרבין.</b> אע\"ג דדינא הכי כרב ששת מ\"מ ברייתא לא ניחא לישנא בפירוש לאוקמוה בגזלן ולא מיבעיא בסתמא. דלא הדרא ליה ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוי נוגע בעדות שהרי אין בע\"ח גובה ממנה: <b>אפותיקי.</b> שיחדו לו ליפרע ממנה לשון פה תהא קאי אם לא יפרע לו לזמן פלוני",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפ\"ה אינו טורף מן הלקוחות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמטלטלי לבע\"ח לא משתעבדי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום דלית להו קלא ולא יוכלו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקוחות ליזהר ואם יטרפנו בע\"ח",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין לך אדם שיקח מטלטלין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחברו וכתבו המפרשים ז\"ל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמדקאמר סתם מכר לו פרה וכו'",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעיד לו עליה מפני שאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחריותה עליו משמע דאפילו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עשאו אפותיקי בשטר אינו גובה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנו מטעמא דאמרן דלית ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קלא. וכתב הרשב\"א ז\"ל דהיינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא מן הלקוחות אבל מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היורשין דאין קול מעלה ומוריד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לגבייהו אפילו לא עשאו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפותיקי אלא שכתב לו מקרקעי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומטלטלי דינו לגבות מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היורשין מן הדין <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"ב\" data-order=\"2\"></i>ואנן צריכין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ג\" data-order=\"3\"></i>לתקנת הגאונים ז\"ל. <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ד\" data-order=\"4\"></i>שמעינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהכא כדפי' הרשב\"א ז\"ל דהיכא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהגזלן מכרו באחריות לא הוי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שינוי רשות ולא קני ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושמעינן דמכל מקום [גזלן]",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב בדמיה: <b>וניחוש דילמא</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו' מטלטלי וכו'.</b> כששעבד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המוכר נכסיו לבעל חובו שעבד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטלטלי אגב מקרקעי וכי היכי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחייל לשעבודא אמקרקעי חייל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי אמטלטלי והוי נוגע בעדות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפני שמעמידה וכו': <b>דלא</b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כאסמכתא.</b> פירש הרמב\"ן ז\"ל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דטעמא משום דאמרינן נכסוהי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבר איניש אינון ערבין ביה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וערב אסמכתא הוא דהכי אמר ליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אם לא יפרע לך הלוה אני אפרע",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותך וכל דאי לא קני אלא דערב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בההיא הנאה דמהימן ליה גמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומשעבד נפשיה אבל מטלטלי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסמכתא היא דמלוה א לא סמיך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא אמקרקעי והוי כמאן דאמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה שאם לא ימצא קרקעות יפרע",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן המטלטלין ומשום הכי צריך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למכתב דלא כאסמכתא לגלויי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דעיקר שעבודיה אמטלטלין נמי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא ולפי זה כל היכא דכתב ליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעכשיו לא צריך למכתב דלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כאסמכתא דכל דכתב ליה מעכשיו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לית ביה משום אסמכתא כדאיתא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרק איזהו נשך (דף סו:):",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ודלא כטופסי.</b> כתב הוא ז\"ל בשם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגאון רבינו סעדיה ז\"ל שהוצרך",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכתוב כן לומר שלא יהו כטופסי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשטרות שמראין שיד בעל השטר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על התחתונה אלא דכל לשון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסופק בו תהא ידו על העליונה:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלקח ומכר לאלתר.</b> וליכא למיחש",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ששעבד אותם בינתים שהרי לא היה לו פנאי ללוות לכך לא הוי נוגע בעדות כיון שאינו יכול להעמידה בפני בעל חובו: <b>וניחוש</b>",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דילמא כששעבד נכסיו לבעל חובו כתב ליה ודעתיד אנא למקני ובכה\"ג יכול לגבות בעל חובו והוי נוגע בעדות וכיון דלא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חיישינן להכי שמעת מינה וכו' והבעיא היא דלא איפשיטא קמן פרק מי שמת (דף קנז.) תפשוט לך מהאיך ברייתא דקתני מכר פרה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מעיד עליה דאפילו אמר דאיקני לא קנה: <b>דלא הויא ליה ארעא.</b> כלומר לעולם אימר לך דמהכא לא תפשוט ולעולם קנה והא דהכא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לא חיישינן להכי משום דאיכא עדים דאמרי כל ימיו היה רגיל אצלנו ולא ידענו שהיה לו קרקע מעולם הילכך איך יקנה לו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מטלטלי אגב מקרקעי אם לא היה לו קרקע מעולם ושמעינן מהכא מדאיצטריך למימר מעולם ולא אמר שלא היו לו קרקעות בשעה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שקנה מטלטלין אלו ששעבודא קמא חייל אמטלטלי שיקנה אפילו לאחר שמכר הקרקע ודעת הרמב\"ן ז\"ל לומר הטעם לפי שכל שכתב",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאקני שוב אין יכול לחזור בו אפילו קודם שקנה אלמא משעה ראשונה חייל שעבודיה אע\"ג דבפירות דקל (ב\"מ דף סו:) כל שלא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "באו לעולם יכול לחזור ומיהו הרשב\"א ז\"ל חולק בדין זה שהוא סובר שאף הכותב דאקני קודם שקנה יכול לחזור בו ומ\"מ מודה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא ז\"ל דכל שלא חזר בו בשעה ראשונה חייל [שעבודיה] כדשמעינן מהכא דאיצטריך למימר מעולם. וא\"ת כיון דאפשר דאין לו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קרקע מפני מה נהגו לכתוב כן <i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"ה\" data-order=\"5\"></i>בכל אדם אע\"פ שאין יודעין לו קרקע. כתב הרמב\"ן ז\"ל דכל שיש בית הכנסת בעירו שלקחו רבים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "או בית הקברות של רבים סגי דבקרקע כל שהוא סגיא כדמוכח פ\"ק דקדושין (דף כו:) וכן אמרינן הכא דלא ה\"ל [ארעא] מעולם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאין במקומו אלא ביהכ\"נ של יחיד ולכל אחד קבר ידוע לעצמו וזה אין לו: <b>נמצא שאינה שלו חוזר עליו.</b> שהלוקח חוזר על",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המוכר כשטרפו מערער א\"כ למה יעיד הרי נוגע הוא בעדות דניחא ליה שתשאר בידו כדי שלא יחזור עליו:",
      "segment_ids": [
        9
      ]
    }
  ],
