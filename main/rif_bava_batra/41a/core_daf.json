      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתחלקה הארץ אלא ליוצאי מצרים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודמי לטפלים דאמרינן בפרק יש",
      "segment_ids": [
