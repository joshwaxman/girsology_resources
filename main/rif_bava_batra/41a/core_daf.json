      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גרים נמי לא נטלו חלק בארץ",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומאי שנא י\"ל דגרים שהם בני",
      "segment_ids": [
