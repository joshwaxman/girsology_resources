      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אברהם ראויים לירושה שלהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובני נחלה נינהו אלא שלא",
      "segment_ids": [
