      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכיון דאיפסיק בירושלמי כרבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהודה קי\"ל כוותיה וכן פסק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרמב\"ם ז\"ל וכתבו המפרשים",
      "segment_ids": [
