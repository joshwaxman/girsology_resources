    {
     "type": "objection_answer",
     "object": "a_lichtov_shor_kesev_vaez",
     "gloss_en": "אם כן ליכתוב קרא אך בכור שור כשב ועז; בכור בכור למה לי? אלא לאו ש״מ (= p_lichtov_shor_kesev_vaez)",
     "answers": "obj_ryhg_emurin",
     "restores": "p_ach_bechor_shor_makor"
    },
    {
     "type": "proposition",
     "object": "p_lichtov_shor_kesev_vaez",
     "gloss_en": "for RYHG: had the verse meant only the portions it would write 'the firstborn of an ox, lamb and goat'; the repeated 'firstborn' teaches that it must be an ox and its firstborn an ox"
    }
   ]
