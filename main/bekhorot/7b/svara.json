 "sentences": {
  "2": {
   "segId": "Bekhorot.7b.3",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "support",
     "object": "s_tnitua_v2",
     "kind": "mesaya",
     "gloss_en": "תניתוה: היוצא מן הטמא טמא -- והני נמי מטמא קאתי (version 2, through ika_damri)",
     "supports": "p_sheshet_asur_mitamei_ka_atei",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_sheshet_asur_mitamei_ka_atei",
     "gloss_en": "Rav Sheshet [version 2]: you learned it -- that which comes out of the impure is impure, and these too come from the impure"
    }
   ]
  },
  "5": {
   "segId": "Bekhorot.7b.6",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "support",
     "object": "s_detanya_r_yaakov",
     "kind": "tanya_kevatei",
     "gloss_en": "דתניא, רבי יעקב אומר: אך את זה תאכלו... אבל אתה אוכל מה שעוף טמא משריץ... זה דבש דבורים",
     "supports": "p_yaakov_dubsha_rachmana_shariyeh",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_yaakov_ein_ochel_sheretz_of_tamei",
     "gloss_en": "R' Ya'akov: 'yet this you may eat of all flying swarming things' (Lev 11:21) -- this you eat, and you do not eat an impure flying swarming thing"
    }
   ]
  },
  "9": {
   "segId": "Bekhorot.7b.10",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "support",
     "object": "s_dika_tahor_machshava",
     "kind": "dika_nami",
     "gloss_en": "טהור -- אלמא בעי מחשבה",
     "supports": "p_gazin_baei_machshava",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_tanya_nami_bechavarto",
     "kind": "tanya_nami_hachi",
     "gloss_en": "תניא נמי הכי: דבש בכוורתו מטמא טומאת אוכלין שלא במחשבה",
     "supports": "p_gazin_baei_machshava",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_gazin_baei_machshava",
     "gloss_en": "the stam: 'pure' -- so [gazin- and wasp-honey] requires intent [to become susceptible to impurity as food]"
    }
   ]
  },
  "11": {
   "segId": "Bekhorot.7b.12",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "support",
     "object": "s_pirsha_balma",
     "kind": "svara",
     "gloss_en": "מאי טעמא? פירשא בעלמא הוא",
     "supports": "p_huna_or_chamor_mutar",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_huna_or_chamor_mutar",
     "gloss_en": "Rav Huna: the skin that comes over the face of a donkey [at birth] is permitted"
    }
   ]
  },
  "12": {
   "segId": "Bekhorot.7b.13",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "support",
     "object": "s_chisda_mesaya",
     "kind": "mesaya",
     "gloss_en": "אמר ליה רב חסדא: תניא דמסייע לך -- the skin over a human's face, alive or dead, is pure; מאי לאו both alive or both dead?",
     "supports": "p_huna_or_chamor_mutar",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_baraita_or_adam_tahor",
     "gloss_en": "the baraita: the skin that comes over the face of a human, whether alive or dead, is pure -- is it not [that] both he and his mother are alive, or both he and his mother are dead?"
    }
   ]
  },
  "13": {
   "segId": "Bekhorot.7b.14",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "support_deflection",
     "object": "defl_chai_veimo_meta",
     "gloss_en": "לא, בין הוא חי ואמו מתה, בין הוא מת ואמו חיה -- only one of them alive",
     "deflects": "s_chisda_mesaya",
     "refuted": true
    }
   ]
  },
  "3": {
   "segId": "Bekhorot.7b.4",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "objection",
     "object": "obj_dvash_dvorim_v1",
     "kind": "meitivi",
     "gloss_en": "מיתיבי: bees' honey is permitted because it is gathered in and not drawn from their bodies -- so what merely passes through is not 'of the impure'",
     "against": "p_sheshet_asur_mina_detamei",
     "state": "answered"
    },
    {
     "type": "objection",
     "object": "obj_dvash_dvorim_v2",
     "kind": "meitivi",
     "gloss_en": "the same מיתיבי, against Rav Sheshet's answer in the איכא דאמרי version",
     "against": "p_sheshet_asur_mitamei_ka_atei",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_baraita_dvash_einan_mematzot",
     "gloss_en": "the baraita: why did they say bees' honey is permitted? because they gather it into their bodies and do not draw it from their bodies"
    }
   ]
  },
  "4": {
   "segId": "Bekhorot.7b.5",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "objection_answer",
     "object": "ans_kerabbi_yaakov_v1",
     "gloss_en": "הוא דאמר כרבי יעקב, דאמר: דובשא רחמנא שרייה -- honey is a scriptural exception, not a case of what passes through",
     "answers": "obj_dvash_dvorim_v1",
     "restores": "p_sheshet_asur_mina_detamei"
    },
    {
     "type": "objection_answer",
     "object": "ans_kerabbi_yaakov_v2",
     "gloss_en": "הוא דאמר כרבי יעקב",
     "answers": "obj_dvash_dvorim_v2",
     "restores": "p_sheshet_asur_mitamei_ka_atei"
    },
    {
     "type": "proposition",
     "object": "p_sheshet_kerabbi_yaakov",
     "gloss_en": "the stam: he [Rav Sheshet] spoke according to R' Ya'akov"
    }
   ]
  },
  "1": {
   "segId": "Bekhorot.7b.2",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_susim_lo_shatu",
     "gloss_en": "[version 2] horses' and camels' urine raised no question because people do not drink it; the question was the donkey's, which people drink and which is good for jaundice"
    }
   ]
  },
  "6": {
   "segId": "Bekhorot.7b.7",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_yaakov_mashritz_mutar",
     "gloss_en": "rather: the impure flying thing you do not eat, but you do eat what an impure flying thing swarms out -- and what is that? bees' honey"
    }
   ]
  },
  "7": {
   "segId": "Bekhorot.7b.8",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_yaakov_gazin_asur",
     "gloss_en": "might one [include] even the honey of gazin and wasps? you said: no"
    }
   ]
  },
  "8": {
   "segId": "Bekhorot.7b.9",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_baraita_gazin_tahor_umutar",
     "gloss_en": "the baraita: the honey of gazin and wasps is pure and permitted to eat"
    }
   ]
  },
  "10": {
   "segId": "Bekhorot.7b.11",
   "sugya": "bekhorot_7a_mei_raglayim_chamor",
   "marks": [
    {
     "type": "proposition",
     "object": "p_chalei_beiei",
     "gloss_en": "the discharges of a fallow deer: the Rabbis thought to say they are eggs and forbidden"
    }
   ]
  },
  "15": {
   "segId": "Bekhorot.7b.16",
   "sugya": "bekhorot_7b_dag_shebala",
   "marks": [
    {
     "type": "support",
     "object": "s_dika_chazinei",
     "kind": "dika_nami",
     "gloss_en": "טעמא דחזיניה דבלע -- inferred from the mishnah's שבלע",
     "supports": "p_taama_dachazinei",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_dika_ashrotzei",
     "kind": "dika_nami",
     "gloss_en": "הא לא חזיניה דבלע -- אמרי: אשרוצי אשריץ",
     "supports": "p_lo_chazinei_ashrotzei",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_taama_dachazinei",
     "gloss_en": "the stam: the reason [it is permitted] is that we saw it swallow"
    }
   ]
  },
  "16": {
   "segId": "Bekhorot.7b.17",
   "sugya": "bekhorot_7b_dag_shebala",
   "marks": [
    {
     "type": "support",
     "object": "s_menalan_detanya",
     "kind": "tanya_kevatei",
     "gloss_en": "מנלן? דתניא: דג טמא משריץ, דג טהור מטיל ביצים",
     "supports": "p_lo_chazinei_ashrotzei",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_ihu_ashrotzei",
     "kind": "svara",
     "gloss_en": "אי הכי, כי חזינא דבלע אמרינן: האי איעכלא, והאי אשרוצי אשריץ! -- even when seen swallowing, say the swallowed one was digested and this one was spawned",
     "against": "p_mishna_tahor_bemeei_tamei_mutar",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_baraita_tamei_mashritz",
     "gloss_en": "the baraita: an impure fish spawns [live young]; a pure fish lays eggs"
    }
   ]
  },
  "18": {
   "segId": "Bekhorot.7b.19",
   "sugya": "bekhorot_7b_dag_shebala",
   "marks": [
    {
     "type": "support",
     "object": "s_ashi_rov",
     "kind": "svara",
     "gloss_en": "רוב דגים במינן משריצין -- therefore it is as if swallowed before us",
     "supports": "p_ashi_kemi_shebala_lefaneinu",
     "status": "live"
    },
    {
     "type": "objection_answer",
     "object": "ans_ashi_rov",
     "gloss_en": "רוב דגים במינן משריצין, וכמי שבלע לפנינו דמי",
     "answers": "obj_ihu_ashrotzei",
     "restores": "p_mishna_tahor_bemeei_tamei_mutar"
    },
    {
     "type": "proposition",
     "object": "p_ashi_rov_dagim_beminan",
     "gloss_en": "Rav Ashi: most fish spawn [only] their own kind"
    }
   ]
  },
  "17": {
   "segId": "Bekhorot.7b.18",
   "sugya": "bekhorot_7b_dag_shebala",
   "marks": [
    {
     "type": "objection_answer",
     "object": "ans_sheshet_hareii",
     "gloss_en": "כגון שמצאו דרך הריעי",
     "answers": "obj_ihu_ashrotzei",
     "restores": "p_mishna_tahor_bemeei_tamei_mutar"
    },
    {
     "type": "objection_answer",
     "object": "ans_pappa_beit_habliah",
     "gloss_en": "כגון שמצאו דרך בית הבליעה",
     "answers": "obj_ihu_ashrotzei",
     "restores": "p_mishna_tahor_bemeei_tamei_mutar"
    },
    {
     "type": "objection_answer",
     "object": "ans_nachman_shalem",
     "gloss_en": "כגון שמצאו שלם",
     "answers": "obj_ihu_ashrotzei",
     "restores": "p_mishna_tahor_bemeei_tamei_mutar"
    },
    {
     "type": "proposition",
     "object": "p_sheshet_derech_hareii",
     "gloss_en": "Rav Sheshet: [the mishnah speaks] where it was found in the way of the excrement"
    }
   ]
  },
  "14": {
   "segId": "Bekhorot.7b.15",
   "sugya": "bekhorot_7b_dag_shebala",
   "marks": [
    {
     "type": "proposition",
     "object": "p_mishna_tahor_bemeei_tamei_mutar",
     "gloss_en": "the mishnah: an impure fish that swallowed a pure fish -- [the pure fish] is permitted to eat"
    }
   ]
  },
  "19": {
   "segId": "Bekhorot.7b.20",
   "sugya": "bekhorot_7b_dag_tamei_mashritz",
   "marks": [
    {
     "type": "proposition",
     "object": "p_dag_tamei_mashritz",
     "gloss_en": "an unclean fish spawns; a clean fish lays eggs"
    }
   ]
  }
 }
}