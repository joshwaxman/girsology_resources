  },
  "17": {
   "segId": "Bekhorot.40a.18",
   "sugya": "bekhorot_40a_galgal_eino_agol",
   "marks": [
    {
     "type": "objection",
     "object": "obj_rminhu_mapelet",
     "kind": "tnan",
     "gloss_en": "ורמינהו: the Nidda mishna, with R' Yochanan's reason for R' Meir, says an animal's eyeball is round like a person's -- so how can a round eyeball be not its usual manner, and a blemish?",
     "against": "p_lav_orcheih",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_lav_orcheih",
     "gloss_en": "is this to say that [a round eyeball] is not its [an animal's] usual manner?"
    }
   ]
  },
  "15": {
   "segId": "Bekhorot.40a.16",
   "sugya": "bekhorot_40a_galgal_eino_agol",
   "marks": [
    {
     "type": "proposition",
     "object": "p_mishna_galgal_agol_mum",
     "gloss_en": "[an animal] whose eyeball is round like a person's -- the later court said: it is a blemish"
