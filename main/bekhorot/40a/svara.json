     "object": "p_mishna_chamesh_raglayim",
     "gloss_en": "[an animal] with five legs [is blemished]"
    }
   ]
  },
  "4": {
   "segId": "Bekhorot.40a.5",
   "sugya": "bekhorot_40a_chasurei_beitzim_kisin",
   "marks": [
    {
     "type": "proposition",
     "object": "p_mishna_ein_lo_beitzim",
     "gloss_en": "the mishna: [an animal that] has no testicles [is blemished]"
    }
   ]
  },
  "5": {
   "segId": "Bekhorot.40a.6",
   "sugya": "bekhorot_40a_chasurei_beitzim_kisin",
   "marks": [
    {
     "type": "proposition",
     "object": "p_chasurei_mechasra",
     "gloss_en": "the mishna is lacking and teaches thus: if it does not have two testicles in two sacs but in one sac, or alternatively two sacs and one testicle -- it is a blemish"
    }
   ]
  },
  "6": {
   "segId": "Bekhorot.40a.7",
   "sugya": "bekhorot_40a_chasurei_beitzim_kisin",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ry_shnei_kisin_beyadua",
     "gloss_en": "R' Yishmael: if it has two sacs, it is known that it has two testicles"
    }
   ]
  },
  "16": {
   "segId": "Bekhorot.40a.17",
   "sugya": "bekhorot_40a_eino_nikar_mechamat_atzmo",
   "marks": [
    {
     "type": "objection",
     "object": "obj_eino_nikar_mi_havei_muma",
     "kind": "svara",
     "gloss_en": "אינו ניכר, מי קא הוי מומא? -- if it is not conspicuous, is it a blemish?",
     "against": "p_mishna_nishbar_etzem",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_pappa_mechamat_melacha",
     "gloss_en": "אינו ניכר מחמת עצמו, אבל ניכר מחמת מלאכה (= p_pappa_mechamat_melacha)",
     "answers": "obj_eino_nikar_mi_havei_muma",
     "restores": "p_mishna_nishbar_etzem"
    },
    {
     "type": "proposition",
     "object": "p_pappa_mechamat_melacha",
     "gloss_en": "Rav Pappa: not conspicuous on its own account, but conspicuous on account of work"
    }
   ]
  },
  "14": {
   "segId": "Bekhorot.40a.15",
   "sugya": "bekhorot_40a_eino_nikar_mechamat_atzmo",
   "marks": [
    {
     "type": "proposition",
     "object": "p_mishna_nishbar_etzem",
     "gloss_en": "the bone of its foreleg or of its hind leg was broken, even though it is not conspicuous [it is a blemish]"
    }
   ]
  },
  "19": {
   "segId": "Bekhorot.40a.20",
