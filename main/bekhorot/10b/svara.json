     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_lo_ratza_rs_matir",
     "gloss_en": "the baraita: if he will not redeem it he breaks its neck from behind with a cleaver and buries it, and it is forbidden in benefit -- R' Yehuda; R' Shimon permits"
    }
   ]
  },
