   "marks": [
    {
     "type": "schema",
     "object": "kv_bidei_adam",
     "kind": "kal_vachomer",
     "status": "stands",
     "gloss_en": "if it is possible to be exact by the hand of Heaven, all the more so by the hand of man"
    },
    {
     "type": "proposition",
     "object": "p_efshar_shamayim",
     "gloss_en": "it is possible to be exact by the hand of Heaven"
    }
   ]
  },
  "2": {
   "segId": "Bekhorot.17b.3",
   "sugya": "bekhorot_17b_letzamtzem_bidei_adam",
   "marks": [
    {
     "type": "support",
     "object": "s_ts_chut_hasikra",
     "kind": "ta_shema",
     "gloss_en": "ואי אמרת אי אפשר לצמצם בידי אדם, זימנין דקא יהיב עליונים למטה ותחתונים למעלה -- the red line presumes man can find the exact middle",
     "supports": "p_efshar_adam",
     "status": "rejected"
    },
    {
     "type": "support_deflection",
     "object": "defl_demarvach",
     "gloss_en": "דמרווח בה פורתא -- one widens [the line] a little",
     "deflects": "s_ts_chut_hasikra",
     "refuted": false
    },
    {
     "type": "proposition",
     "object": "p_chut_hasikra",
     "gloss_en": "a red line girds [the altar] in the middle, to divide between the upper bloods and the lower bloods"
    }
   ]
  },
  "3": {
   "segId": "Bekhorot.17b.4",
   "sugya": "bekhorot_17b_letzamtzem_bidei_adam",
   "marks": [
    {
     "type": "support",
     "object": "s_ts_midat_kelim",
     "kind": "ta_shema",
     "gloss_en": "תא שמע ממדת כלים, ממדת מזבח -- the Torah's exact measures presume man can be exact",
     "supports": "p_efshar_adam",
     "status": "rejected"
    },
    {
     "type": "support_deflection",
     "object": "defl_rachmana_amar_avid",
     "gloss_en": "שאני התם, דרחמנא אמר עביד, ובכל היכי דמצית למיעבד ניחא ליה -- ״הכל בכתב מיד ה׳ עלי השכיל״ (I Divrei HaYamim 28:19)",
     "deflects": "s_ts_midat_kelim",
     "refuted": false
    }
   ]
  },
  "4": {
   "segId": "Bekhorot.17b.5",
   "sugya": "bekhorot_17b_letzamtzem_bidei_adam",
   "marks": [
    {
     "type": "support",
     "object": "s_ts_rav_ketina",
     "kind": "ta_shema",
     "gloss_en": "חלקו לשנים והן שוין -- שניהן טמאים, לפי שאי אפשר לצמצם: a division by man's hand is held not to be exact",
     "supports": "p_ein_efshar_adam",
     "status": "rejected"
    },
    {
     "type": "support_deflection",
     "object": "defl_rav_kahana_gumot",
     "gloss_en": "שאני כלי חרס הואיל ויש בו גומות -- earthenware is different, since it has indentations",
     "deflects": "s_ts_rav_ketina",
     "refuted": false
    },
    {
     "type": "proposition",
     "object": "p_chilko_shneihem_temeim",
     "gloss_en": "if one divided it in two and they are equal -- both are impure, because it is impossible to be exact"
    }
   ]
  },
  "5": {
   "segId": "Bekhorot.17b.6",
   "sugya": "bekhorot_17b_letzamtzem_bidei_adam",
   "marks": [
    {
     "type": "support",
     "object": "s_ts_shtei_eglot",
     "kind": "ta_shema",
     "gloss_en": "שתיהן מביאות שתי עגלות... מאי טעמא? לאו משום דקסבר בידי אדם אפשר לצמצם, וקרובה ואפילו קרובות?",
     "supports": "p_efshar_adam",
     "status": "rejected"
    },
    {
     "type": "proposition",
     "object": "p_re_shtei_eglot",
     "gloss_en": "[a corpse] found exactly between two towns -- both bring two heifers; the words of R' Eliezer"
    }
   ]
  },
  "7": {
   "segId": "Bekhorot.17b.8",
   "sugya": "bekhorot_17b_letzamtzem_bidei_adam",
   "marks": [
    {
     "type": "support_deflection",
     "object": "defl_re_kryhg",
     "gloss_en": "לא, רבי אליעזר סבר לה כרבי יוסי הגלילי, דאמר אפשר לצמצם בידי שמים וכל שכן בידי אדם -- so his view says nothing of the Rabbis'",
     "deflects": "s_ts_shtei_eglot",
     "refuted": false
    }
   ]
  },
  "6": {
   "segId": "Bekhorot.17b.7",
