                ],
                "source_text": "(שהרי קדושין כבר אין יכול לשנות בזבח) [צ\"ל שהן קדושין כבר אין יכול לשנות ולדן לזבח - שיטה מקובצת כתב יד]",
                "deleted_reading": "(שהרי קדושין כבר אין יכול לשנות בזבח)",
                "reading": "שהן קדושין כבר אין יכול לשנות ולדן לזבח",
                "attribution": "שיטה מקובצת כתב יד",
                "rule": "adjacent_parenthesis_or_insertion",
                "decision_note": null,
                "output_span": [
