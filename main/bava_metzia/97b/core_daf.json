        4
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "מָנֶה לִי בְּיָדְךָ, וְהַלָּה אוֹמֵר: אֵינִי יוֹדֵעַ – חַיָּיב.",
      "segment_ids": [
