        1
      ]
    },
    {
      "right": "275px",
      "width": "380px",
      "text": "בְּיוֹם שֶׁהָיְתָה שְׂכוּרָה מֵתָה, בְּשָׁעָה שֶׁהָיְתָה",
      "segment_ids": [
        1
