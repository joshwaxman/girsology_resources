  "rashi": [
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>בְּשָׁעָה שֶׁהָיְתָה שְׁאוּלָה מֵתָה.</b> קאי",
      "source_ref": "Rashi on Bava Metzia 97b:1:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "אשאלה חצי היום ושכרה חצי יום:",
      "source_ref": "Rashi on Bava Metzia 97b:1:1",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>חַיָּיב</b> לשלם דברי ושמא ברי עדיף:",
      "source_ref": "Rashi on Bava Metzia 97b:1:2",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>יִשָּׁבַע הַשּׂוֹכֵר.</b> ולקמן פריך מה שטענו",
      "source_ref": "Rashi on Bava Metzia 97b:3:1",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "לא הודה לו והיכא כתובה שבועה זו:",
      "source_ref": "Rashi on Bava Metzia 97b:3:1",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>יַחְלוֹקוּ</b> קסבר ממון המוטל בספק",
      "source_ref": "Rashi on Bava Metzia 97b:4:1",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "חולקין: <b><span class=\"dh-divergent\">גמ&#x27;</span> רַב הוּנָא וְרַב יְהוּדָה</b>",
      "source_ref": "Rashi on Bava Metzia 97b:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>אָמְרִי: חַיָּיב</b> ברי ושמא ברי עדיף:",
      "source_ref": "Rashi on Bava Metzia 97b:6:1",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>פָּטוּר</b> אוקי ממונא בחזקת מריה ולא",
      "source_ref": "Rashi on Bava Metzia 97b:6:2",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "תפקיע מספיקא: <b>שֶׁיֵּשׁ עֵסֶק שְׁבוּעָה</b>",
      "source_ref": "Rashi on Bava Metzia 97b:7:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "<b>בֵּינֵיהֶן.</b> שנתחייב לו שבועה בטענתו והוא",
      "source_ref": "Rashi on Bava Metzia 97b:7:1",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "250px",
      "right": "",
      "left": "0px",
      "text": "אינו יכול לישבע דהא אינו יודע קאמר:",
      "source_ref": "Rashi on Bava Metzia 97b:7:1",
      "gemara_segment_ids": [
        6
      ]
    }
  ],
