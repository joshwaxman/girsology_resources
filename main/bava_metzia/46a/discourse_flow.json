xt":"אֵיתִיבֵיהּ רַבִּי אַבָּא לְעוּלָּא: הֲרֵי שֶׁהָיוּ חֲמָרָיו וּפוֹעֲלָיו תּוֹבְעִין אוֹתוֹ בַּשּׁוּק, וְאָמַר לַשּׁוּלְחָנִי: תֵּן לִי בְּדִינָר מָעוֹת וַאֲפַרְנְסֵם, וַאֲנִי אַעֲלֶה לְךָ יָפֶה דִּינָר וּטְרֵיסִית מִמָּעוֹת שֶׁיֵּשׁ לִי בְּבֵיתִי."},{"id":23,"seg":6,"role":"respond.conclusion.accepted","conf":"high","src":"hebrew","speaker":null,"head":"שְׁמַע מִינַּהּ.","text":"שְׁמַע מִינַּהּ."},{"id":25,"seg":8,"role":"adduce.proof","conf":"med","src":"english","speaker":null,"head":"תָּא שְׁמַע:","text":"תָּא שְׁמַע: כׇּל הַנַּעֲשֶׂה דָּמִים בְּאַחֵר, כֵּיוָן שֶׁזָּכָה זֶה – נִתְחַיֵּיב זֶה בַּחֲלִיפִין."}],"edges":[{"source":4,"target":3,"type":"attacks","regime":"attack","gap":1,"confidence":"high","basis":"adjacency"},{"source":5,"target":4,"ordinal":1,"type":"answers","regime":"structural","gap":1,"confidence":"high","basis":"adjacency"},{"source":7,"target":6,"ordinal":1,"type":"answers","regime":"structural","gap":1,"confidence":"high","basis":"adjacency"},{"source":10,"target":9,"ordinal":1,"type":"concludes","regime":"structural","gap":1,"confidence":"high","basis":"adjacency"},{"source":16,"target":11,"type":"attacks","regime":"attack","gap":1,"confidence":"high","basis":"adjacency"},{"source":23,"target":16,"ordinal":1,"type":"concludes","regime":"structural","gap":1,"confidence":"high","basis":"adjacency"},{"source":25,"target":23,"type":"supports","regime":"evidence","gap":1,"confidence":"high","basis":"adjacency"}]}]}