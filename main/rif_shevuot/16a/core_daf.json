    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ת\"ר כתב אל\"ף למ\"ד מאלהים ירד ה\"א מה'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הרי זה אינו נמחק שיץ דל\"ת משד\"י צד\"י בית מצבאות הרי זה נמחק ר' יוסי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אומר צבאות כולו נמחק לפי שלא נקרא הקב\"ה צבאות אלא על שם צבאות ישראל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אמר שמואל אין הלכה כרבי יוסי ת\"ר כל הטפל לשם בין מלפניו בין מלאחריו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ה\"ז נמחק לפניו כיצד לה' ל' נמחק בה' ב' נמחק וה' ואו נמחק לאחריו כיצד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אלהינו נ\"ו נמחק אלהיכם כ\"ם נמחק אלהיהם ה\"ם נמחק אחרים אומרים",
      "segment_ids": [
        1
      ]
    }
