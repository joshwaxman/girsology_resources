      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלהיך אלהיכם אהיה אל\"ף דל\"ת יו\"ד ה\"א",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שדי צבאות הרי אלו אין נמחקין אבל הגדול",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הגבור והנורא האדיר החזק האמיץ חנון",
