      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דפשיטא הוא דאשה שהיא בחזקת טהורה כגון",
      "segment_ids": [
