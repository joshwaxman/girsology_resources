      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כמ\"ש מהרי\"ף ז\"ל בהגה\"ת תשב\"ץ וכ\"ש זאת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
