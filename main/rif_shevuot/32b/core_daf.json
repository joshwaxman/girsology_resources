        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשופטני עסקינן ה\"ק ואלו נשבעין שלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בטענת ברי אלא בטענת שמא השותפין ובו'",
