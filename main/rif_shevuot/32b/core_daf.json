    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פועלין מכניס לו פירות ומוציא לו פירות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומאי שנא הני משום דמורו התירא והוא שיש",
