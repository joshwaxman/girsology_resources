  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא פקדנו אחי כשם שאין היתומים נשבעין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא פקדנו אבא וגובין מן היתומים כך אין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האח נשבע שלא שלא פקדנו אחי וגובה מן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היתומים וכן הלכה: <b><big>מתני'</big></b> ואלו <i data-commentator=\"Mishneh Torah, Agents and Partners\" data-label=\"⚬\"></i><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Shulchan Arukh, Choshen Mishpat\" data-label=\"⚬\"></i>נשבעין",
      "segment_ids": [
