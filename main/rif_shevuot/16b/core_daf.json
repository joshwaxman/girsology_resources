      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תנאו: <b>בו האמנת דברים כלומר</b>",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שראוים לענות אמן על דבר תפלה</b>",
      "segment_ids": [
        6
      ]
    },
    {
