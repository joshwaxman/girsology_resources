      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "להטמין אבל דברים שדרכן להטמין נאמן ושאין דרכן להטמין לא אמרן אלא באיניש דלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צניע אבל באינש דצניע היינו",
