    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא מיחוור דהא מוכח לקמן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעובדא דרב יימר דתלמיד חכם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעיד מיושב ובשלמא אי אמרת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבכולהו אינשי בדיעבד עדותן",
