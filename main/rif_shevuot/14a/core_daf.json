      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תורה עדיף <i data-commentator=\"Hagahot HaBach\" data-label=\"ח\" data-order=\"8\"></i>ואי אמרת בעלמא",
      "segment_ids": [
