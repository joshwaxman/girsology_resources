      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו בדיעבד עדותן בטלה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תלמיד חכם היאך מושיבין אותו",
