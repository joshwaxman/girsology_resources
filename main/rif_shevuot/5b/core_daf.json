        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבידי שמים אי מה מעין <i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><span class=\"ein_mishpat_marker\" data-ein-mishpat-id=\"0\" data-marker-letter=\"א\">א</span>מטהר בכל שהוא אף",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
