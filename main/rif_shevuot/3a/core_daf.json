  "rashi": [
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ת\"ר ואשה כי תהיה זבה.</b> בריי' היא בת\"כ מכאן אמרו בת יום א' לנדה בת עשרה ימים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לזיבה פירוש כיון דלא הויא זבה וכו' ומיהו בפ' בנות כותים [דף לב.] לא יליף מואשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דנדה אלא בת יום א' לנדה בלבד אבל בת עשרה ימים לזיבה מייתי לה מואשה דזבה: <b>יכול</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כל מראה זוב תהא טמאה ת\"ל דם.</b> כלומר אדום דדם אדום הוא כדמפרש בפ' כל היד [דף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יט.] מדכתיב ויראו מואב מנגד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את המים אדומים כדם. שהוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומר דמיה. תרי דמיה כתיבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרשה כדמפרש ואזיל ומינייהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרשינן ד' מיני דמים הן האדום",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והשחור דשחור נמי אדום הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא שלקה וד' אחריני כולהו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אית בהו מראה אדמימות. וב\"ש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי דאמרי אף כמימי תילתן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכמימי בשר צלי אית להו נמי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ד' מיני דמים טמאים בלחוד אלא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דסבירא להו דכי היכי דאמרינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשחור אדום הוא אלא שלקה הני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי מלקא לקו והכי מפרש בפ'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל היד (דף יט.) והכי מיתניא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' התם חמשה דמים הם טמאים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באשה האדום והשחור וכקרן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרכום וכמימי אדמה וכמזוג ב\"ש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומרים אף כמימי תלתן וכמימי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר צלי וב\"ה מטהרין הירוק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עקביא בן מהללאל מטמא וחכמים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטהרין א\"ר מאיר אם אינו מטמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום כתם יטמא משום משקה ר'",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוסי אומר לא כך ולא כך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושיילינן התם בגמרא ב\"ה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מטהרין היינו ת\"ק [כלומר]",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמר חמשה דמים טמאים באשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומשמע ותו לא ומהדרינן איכא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בינייהו לתלות כלומר דלת\"ק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חמשה דמים טמאים ודאי אבל",
      "segment_ids": [
