        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בא לנעול אלא לפתוח אם אתה אומר ימים י'",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אינן אלא מאה אלא מאתים",
      "segment_ids": [
        4
      ]
    }
