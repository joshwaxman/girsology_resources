      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמימי תלתן וכמימי בשר צלי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תולין וב\"ה מטהרין לגמרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושיילינן תו [יט:] חכמים",
      "segment_ids": [
