  "shiltei": [
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א</b> והאשה אשר כמה ימים לאחר לידתה שמשר",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מטתה בחזקת טהור' ומיד לאחר התשמיש מצאה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דם הבא מן המקור בודאי והלכה אחר החקירה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומצאה כי החלוק שהסירה מעליה קודם תשמיש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היה מלא דם שאין ספק שודאי שמשה נדה נ\"ל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מאחר שהי' תוך כ\"ד חדש ללידת הולד שאינה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריכה בדיקה דדמיה מסולקין ממנה אפי' מת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הולד או גמלתו כדאיתא פ\"ק דנדה והכי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פסקו פסקי הלכות מיי' פ\"ד מהל' מטמאי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "משכב ומושב ועיין בטור י\"ד סימן קפ\"ד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וסימן קפ\"ט שהאריך בזה לבאר דכל כ\"ד חדש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אינה צריכה בדיקה א\"כ ה\"ל כימים הרחוקים",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "מן הוסת דקי\"ל דבכה\"ג כל ששמשה שלא בימי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "וסתה שאינה צריכה בדיקה אפי' אירע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבשוגג שמשה נדה כה\"ג כמו נדון דידן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פטורה היא ואינה צריכה כפרה כמו שכתב",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המרדכי בשבועות בראשו בשם מהר\"ם ובהגהות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"י מדורא הוסיף לומר בשם מהר\"ם ז\"ל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאסור לומר שהיא צריכה דא\"כ יהא לבו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "נוקפו ולא דמי לההיא שכתב המרדכי פ'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ידיעות הטומאה בשם מהר\"ם ז\"ל שכ' כיון",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שהאשה הודיעתו בשעת תשמיש שהדם יצא מן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "המקור ולא פירש באבר מת שגג באיסור כרת",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והוא חייב כפרה ולא האשה כי אנוסה היתה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אבל בנדון דידן והכא בכה\"ג שלא הרגישה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כלל בטומאתה עד אחר תשמיש ולא היתה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריכה בדיקה שניהם פטורין דאונסים הוו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "והכי כתב מיי' להדיא פרק ה' מהלכות",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שגגות פטורין בכה\"ג אולם מה שאמרת אם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "צריכה להמתין ג' חדשים להבחין בין זרע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לזרע לדעת אם נתעברה והולד יש בו חשש",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "פגם אם נתעברה שהוא בן נדה או לא נ\"ל",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דאע\"ג דמצינו שחשו חכמים לתקנה זו",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כדאיתא פ' החולץ ופרק אף על פי בגרושה",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להצריכה שלשה חדשים להבחנת הזרע וכן גבי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "גר וגיורת איש ואשתו שנתגיירו הצריכום",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ג' חדשים להבחנת הזרע להבחין בין זרע",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "246px",
