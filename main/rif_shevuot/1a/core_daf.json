        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ר\"ש אומר שעירי רגלים מכפרין אבל לא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שעירי ראשי חדשים ועל מה שעירי ראשי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חדשים מכפרין על הטהור שאכל טמא ר\"מ",
