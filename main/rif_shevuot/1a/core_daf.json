        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בה ידיעה בתחלה ויש בה ידיעה בסוף שעיר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנעשה בחוץ ויום הכפורים מכפר <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>וכל שאין",
      "segment_ids": [
        0
