      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אא\"כ הגיע לעונת הפועטות וכן היא מסקנת",
      "segment_ids": [
