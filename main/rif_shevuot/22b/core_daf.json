      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "הרא\"ש כתב מיימ' אין נשבעין על טענת קטן",
      "segment_ids": [
