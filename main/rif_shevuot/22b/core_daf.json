      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כתב מיי' והרמב\"ן כתב שבין היסת בין",
      "segment_ids": [
