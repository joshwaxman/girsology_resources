      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שבועת הנשבעין ונוטלים אין נשבעין לו",
      "segment_ids": [
