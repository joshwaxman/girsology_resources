      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היון וטיט היוצרין וגץ יוני אי זה הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טיט היון זה טיט הבורות שנאמר (תהילים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מ׳:ג׳) ויעלני מבור שאון מטיט היון:",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואלו שאינן חוצצין קילקי הראש ובית השחי",
