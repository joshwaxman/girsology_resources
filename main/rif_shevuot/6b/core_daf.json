    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<sup class=\"footnote-marker\">*</sup><i class=\"footnote\">רפ\"ט</i> <i class=\"footnote\">דמקואות</i>אלו חוצצין באדם חוטי צמר",
      "segment_ids": [
        1
      ]
    },
    {
