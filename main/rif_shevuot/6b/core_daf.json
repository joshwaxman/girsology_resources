      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעין <i data-commentator=\"Hagahot HaBach\" data-label=\"א\" data-order=\"1\"></i>וגלד שחוץ לעין וגלד שחוץ למכה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והרטיה שעליה ושרף היבש וגלדי צואה שעל",
