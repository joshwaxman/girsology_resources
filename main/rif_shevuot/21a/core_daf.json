      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דכיון דמסהדי דבתורת פרעון דההי' הלואה יהבינהו ניהליהו סהדותיהו לאו סהדותא הוא דלפרעון דההיא הלואה כפסולין דמו",
      "segment_ids": [
