  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "לומר שעורים דבעינן עד שיהא פיו ולבו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שוין אבל אם גמר בלבו להוציא פת חטים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והוציא פת סתם אסור בפת חטים דפת חטים",
