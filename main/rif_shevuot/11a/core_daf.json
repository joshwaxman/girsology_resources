      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיינו לא אוכל חמץ וא\"כ למה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לי דכתבה להך הרעה דהטבה היא",
      "segment_ids": [
