      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לענין מצוה והא כתבה דקיום",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המצוה הוא העיקר ואפילו בלא",
      "segment_ids": [
