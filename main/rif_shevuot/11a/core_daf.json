      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גופה הטבה היא. והכי פירושא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מה הטבה לעצמו דהיינו אוכל",
      "segment_ids": [
