      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלילי פסח אף הרעה דלא אוכל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינה בביטול מצוה כגון לא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אוכל מצה אלא בקיום מצוה",
      "segment_ids": [
