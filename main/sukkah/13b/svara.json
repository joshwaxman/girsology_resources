     "kind": "svara",
     "gloss_en": "והא אגידי מתתאי! -- but they are still bound below",
     "against": "p_tzrifei_deurbanei",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_dsharei_lehu",
     "gloss_en": "דשרי להו -- he unties them (= p_dsharei_lehu)",
