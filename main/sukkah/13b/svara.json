     "restores": "p_tzrifei_deurbanei"
    },
    {
     "type": "proposition",
     "object": "p_tzrifei_deurbanei",
     "gloss_en": "R' Abba: willow huts, once their top ties are undone, are valid"
    }
   ]
  },
  "3": {
