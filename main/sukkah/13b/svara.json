     "restores": "p_tzrifei_deurbanei"
    },
    {
     "type": "proposition",
     "object": "p_eged_lo_letaltel",
     "gloss_en": "Rav Huna b. R' Yehoshua: any binding not made for carrying is not called a binding"
    }
   ]
  },
  "11": {
