h","speaker":null,"head":"וְהָכְתִיב: ״מְאַחֵז","text":"וְהָכְתִיב: ״מְאַחֵז פְּנֵי כִּסֵּא פַּרְשֵׁז עָלָיו עֲנָנוֹ״, וְאָמַר רַבִּי תַּנְחוּם: מְלַמֵּד שֶׁפֵּירַשׂ שַׁדַּי מִזִּיו שְׁכִינָתוֹ וַעֲנָנוֹ עָלָיו!"},{"id":12,"seg":2,"role":"respond.answer","conf":"high","src":"english","speaker":null,"head":"לְמַטָּה מֵעֲשָׂרָה.","text":"לְמַטָּה מֵעֲשָׂרָה."},{"id":13,"seg":3,"role":"probe.question","conf":"high","src":"english+kih","speaker":null,"head":"מִכׇּל מָקוֹם","text":"מִכׇּל מָקוֹם ״מְאַחֵז פְּנֵי כִּסֵּא״ כְּתִיב!"},{"id":14,"seg":3,"role":"respond.answer","conf":"high","src":"english+kih","speaker":null,"head":"אִישְׁתַּרְבּוֹבֵי אִישְׁתַּרְבַּב","text":"אִישְׁתַּרְבּוֹבֵי אִישְׁתַּרְבַּב לֵיהּ כִּסֵּא עַד עֲשָׂרָה, וּנְקַט בֵּיהּ."},{"id":15,"seg":4,"role":"probe","conf":"high","src":"kih","speaker":null,"head":"בִּשְׁלָמָא אָרוֹן","text":"בִּשְׁלָמָא אָרוֹן תִּשְׁעָה, דִּכְתִיב: ״וְעָשׂוּ אֲרוֹן עֲצֵי שִׁטִּים אַמָּתַיִם וָחֵצִי אׇרְכּוֹ וְאַמָּה וָחֵצִי רׇחְבּוֹ וְאַמָּה וָחֵצִי קוֹמָתוֹ״."},{"id":16,"seg":4,"role":"probe.question.source","conf":"high","src":"hebrew","speaker":null,"head":"אֶלָּא כַּפּוֹרֶת","text":"אֶלָּא כַּפּוֹרֶת טֶפַח, מְנָלַן?"},{"id":17,"seg":4,"role":"respond.answer","conf":"high","src":"english+kih","speaker":null,"head":"דְּתָנֵי רַבִּי","text":"דְּתָנֵי רַבִּי חֲנִינָא: כׇּל הַכֵּלִים שֶׁעָשָׂה מֹשֶׁה, נָתְנָה בָּהֶן תּוֹרָה מִדַּת אׇרְכָּן וּמִדַּת רׇחְבָּן וּמִדַּת קוֹמָתָן."},{"id":19,"seg":5,"role":"respond.answer","conf":"high","src":"english","speaker":null,"head":"צֵא וּלְמַד","text":"צֵא וּלְמַד מִפָּחוּת שֶׁבַּכֵּלִים, שֶׁנֶּאֱמַר: ״וְעָשִׂיתָ לּוֹ מִסְגֶּרֶת טֹפַח סָבִיב״, מָה לְהַלָּן טֶפַח, אַף כָּאן טֶפַח."},{"id":20,"seg":5,"role":"probe.question","conf":"high","src":"english+kih","speaker":null,"head":"וְנֵילַף מִכֵּלִים","text":"וְנֵילַף מִכֵּלִים גּוּפַיְיהוּ!"},{"id":21,"seg":5,"role":"respond.answer","conf":"high","src":"english+kih","speaker":null,"head":"תָּפַשְׂתָּ מְרוּבֶּה","text":"תָּפַשְׂתָּ מְרוּבֶּה — לֹא תָּפַשְׂתָּ, תָּפַשְׂתָּ מוּעָט — תָּפַשְׂתָּ."},{"id":22,"seg":6,"role":"probe.question","conf":"high","src":"english+kih","speaker":null,"head":"וְנֵילַף מִצִּיץ,","text":"וְנֵילַף מִצִּיץ, דְּתַנְיָא: צִיץ דּוֹמֶה כְּמִין טַס שֶׁל זָהָב, וְרָחָב שְׁתֵּי אֶצְבָּעוֹת וּמוּקָּף מֵאֹזֶן לְאֹזֶן, וְכָתוּב עָלָיו שְׁתֵּי שִׁיטִין: ׳יוֹד הֵא׳ מִלְּמַעְלָה, וְ׳קֹדֶשׁ לָמֶד׳ מִלְּמַטָּה."},{"id":24,"seg":7,"role":"respond.answer","conf":"high","src":"english+kih","speaker":null,"head":"דָּנִין כְּלִי","text":"דָּנִין כְּלִי מִכְּלִי, וְאֵין דָּנִין כְּלִי מִתַּכְשִׁיט."},{"id":25,"seg":8,"role":"adduce.proof","conf":"med","src":"english","speaker":null,"head":"וְנֵילַף מִזֵּר.","text":"וְנֵילַף מִזֵּר."},{"id":26,"seg":8,"role":"probe","conf":"high","src":"kih","speaker":null,"head":"דְּאָמַר מָר:","text":"דְּאָמַר מָר: זֵר מַשֶּׁהוּ!"},{"id":27,"seg":8,"role":"respond.answer","conf":"high","src":"kih","speaker":null,"head":"דָּנִין כְּלִי","text":"דָּנִין כְּלִי מִכְּלִי, וְאֵין דָּנִין כְּלִי מֵהֶכְשֵׁר כְּלִי."},{"id":28,"seg":8,"role":"probe","conf":"high","src":"english+hebrew+kih","speaker":null,"head":"אִי הָכִי,","text":"אִי הָכִי, מִסְגֶּרֶת נָמֵי הֶכְשֵׁר כְּלִי הוּא!"},{"id":29,"seg":8,"role":"probe.question","conf":"high","src":"english+kih","speaker":null,"head":"מִסְגַּרְתּוֹ לְמַטָּה","text":"מִסְגַּרְתּוֹ לְמַטָּה הָיְתָה."},{"id":30,"seg":9,"role":"probe","conf":"high","src":"english+hebrew+kih","speaker":null,"head":"הָנִיחָא לְמַאן","text":"הָנִיחָא לְמַאן דְּאָמַר מִסְגַּרְתּוֹ לְמַטָּה הָיְתָה, אֶלָּא לְמַאן דְּאָמַר מִסְגַּרְתּוֹ לְמַעְלָה הָיְתָה, מַאי אִיכָּא לְמֵימַר?"},{"id":32,"seg":10,"role":"respond.answer","conf":"high","src":"kih","speaker":null,"head":"אֶלָּא: דָּנִין","text":"אֶלָּא: דָּנִין דָּבָר שֶׁנָּתְנָה בּוֹ תּוֹרָה מִדָּה מִדָּבָר שֶׁנָּתְנָה בּוֹ תּוֹרָה מִדָּה, וְאַל יוֹכִיחוּ צִיץ וְזֵר, שֶׁלֹּא נִתְּנָה בָּהֶן תּוֹרָה מִדָּה כְּלָל."},{"id":33,"seg":11,"role":"respond.answer","conf":"high","src":"kih","speaker":"R. Hun