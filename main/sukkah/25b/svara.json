     "gloss_en": "וליכלו בסוכה וליחדו בסוכה -- let them eat and rejoice in the sukkah",
     "against": "p_taama_lemichdei",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_ein_simcha_ela_bachupa",
