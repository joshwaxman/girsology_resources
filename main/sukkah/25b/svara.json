    {
     "type": "support",
     "object": "s_at_hu_dmichayvat",
     "kind": "svara",
     "gloss_en": "מדאמר ליה רחמנא ליחזקאל פארך חבוש עליך -- את הוא דמיחייבת, אבל כולי עלמא פטירי",
     "supports": "p_avel_patur_tefillin",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_at_hu_dmichayvat",
     "gloss_en": "since the Merciful One said to Ezekiel 'bind your splendour upon you' (Yechezkel 24:17) -- you are obligated, but everyone else is exempt"
    }
   ]
  },
  "6": {
