     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_bainan_kafut",
     "gloss_en": "בעינא כפות וליכא -- we require kafut (p_kappot_kafut), and there is none",
     "answers": "obj_eima_charuta",
     "restores": "p_kappot_hu_lulav"
    },
    {
     "type": "proposition",
     "object": "p_kappot_hu_lulav",
     "gloss_en": "this 'kappot temarim' is [the] lulav -- the identification Ravina questions and Rav Ashi defends"
    }
   ]
  },
  "9": {
