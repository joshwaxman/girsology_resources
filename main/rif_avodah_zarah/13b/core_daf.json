  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בפרק כל הבשר אסור לבשל בחלב <span class=\"bavli-ref\" data-bavli-ref=\"(חולין דף קטז:)\" data-bavli-daf=\"116b\" data-bavli-scope=\"חולין\" data-bavli-index=\"0\"></span>: <b><big>מתני'</big></b>",
      "segment_ids": [
