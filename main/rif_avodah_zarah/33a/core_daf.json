      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שיעור כדי שיפתחנה כולה ויסתמנה ותנגב",
      "segment_ids": [
