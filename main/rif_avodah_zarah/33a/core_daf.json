      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "להצריך ב' חותמו' ואין להקל: כתב הרשב\"א",
      "segment_ids": [
