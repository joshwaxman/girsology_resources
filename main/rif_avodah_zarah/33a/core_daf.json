      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "יראה מדברי הרא\"ש ומ\"מ עתה נוהגים",
      "segment_ids": [
