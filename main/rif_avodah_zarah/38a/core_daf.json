      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היין מיד דכי היכי שנאסר הכלי ע\"י עובד",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
