      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ז\"ל ואין בדבר ספק כלל וכבר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתבתי למעלה מה שנראה לי דהא",
      "segment_ids": [
