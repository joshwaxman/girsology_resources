      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשיל מאי עביד ואלא דכי לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהפך ביה לא בשיל אמאי מותר",
      "segment_ids": [
