      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמר ר' <i data-commentator=\"Hagahot HaBach\" data-label=\"ז\" data-order=\"7\"></i>יוחנן דוקא בפת שלנו",
      "segment_ids": [
