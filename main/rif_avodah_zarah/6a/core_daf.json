      "right": "0px",
      "left": "",
      "text": "אפילו במותר לו ומתוך כך בא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לידי [נקיות אפילו במחשבה",
