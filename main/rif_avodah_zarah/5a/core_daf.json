      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ביניהם לפי שהעובדי כוכבים מגינים עליהם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ונלחמים נגד האויבים ולא נאסר למכור כלי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "זיין לעובדי כוכבים אלא כשהיו עובדי",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "כוכבים נלחמים עם ישראל. אין מוכרים להם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דובים ואריות ולא כל דבר שיש בו נזק",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "לרבים לפי שהיו מזיקין בהם את ישראל וכן",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
