      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "אין בונין עמהן מיני בנינים שדנים בהם",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דיני נפשות לפי שעשויין להזיק בהן את",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ישראל ונראה בעיני שלא אמרו כל אלו אלא",
      "segment_ids": [
