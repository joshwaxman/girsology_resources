        0
      ],
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "דמיירי במעיין שאינו של עבודת כוכבים",
      "segment_ids": [
