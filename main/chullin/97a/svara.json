    },
    {
     "type": "proposition",
     "object": "p_ry_kolef_ad_chelbo",
     "gloss_en": "an incident before R' Yochanan in the synagogue of Maon, a kid roasted with its fat; he said: one peels and eats until he reaches its fat"
    }
   ]
