 "sentences": {
  "3": {
   "segId": "Chullin.136a.4",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "schema",
     "object": "gs_netina_matanot_rava",
     "kind": "gezera_shava",
     "status": "blocked",
     "gloss_en": "איכא למימר ילף נתינה נתינה מראשית הגז -- as there partnership is not [obligated], so here partnership is not"
    },
    {
     "type": "defeater_verse",
     "object": "ex_zovchei_hazevach",
     "gloss_en": "כתב רחמנא מאת זובחי הזבח -- 'those [pl.] who slaughter' includes partners",
     "verse": "דברים יח,ג",
     "blocks": "gs_netina_matanot_rava",
     "withdrawn": false,
     "answered": false
    }
   ]
  },
  "4": {
   "segId": "Chullin.136a.5",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "defeater_objection",
     "object": "pr_adraba_teruma_matanot",
     "gloss_en": "טעמא דכתב רחמנא מאת זובחי הזבח, הא לאו הכי הוה אמינא לילף מראשית הגז? אדרבה נילף מתרומה!",
     "verse": null,
     "blocks": "gs_netina_matanot_rava",
     "withdrawn": false,
     "answered": false
    }
   ]
  },
  "14": {
   "segId": "Chullin.136a.15",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "schema",
     "object": "gs_netina_matanot_ilai",
     "kind": "gezera_shava",
     "status": "stands",
     "gloss_en": "מאי טעמא [דרבי אלעאי]? ילף נתינה נתינה מראשית הגז -- as there partnership is not, so here partnership is not"
    },
    {
     "type": "objection",
     "object": "obj_rav_chanina_matanot",
     "kind": "tanya",
     "gloss_en": "ליתנהו להני כללי, דתניא: בהמת השותפין חייבת במתנות, ורבי אלעאי פוטר",
     "against": "p_rava_ilai_matanot",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_matanot_shutafin_chayavin",
     "gloss_en": "the baraita: an animal of partners is obligated in the gifts"
    }
   ]
  },
  "17": {
   "segId": "Chullin.136a.18",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "schema",
     "object": "gs_netina_teruma_reishit_hagez",
     "kind": "gezera_shava",
     "status": "stands",
     "gloss_en": "ילף נתינה נתינה מתרומה: מה תרומה בארץ אין בחוצה לארץ לא, אף ראשית הגז בארץ אין בחוצה לארץ לא"
    }
   ]
  },
  "18": {
   "segId": "Chullin.136a.19",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "defeater_objection",
     "object": "pr_teruma_tovelet",
     "gloss_en": "אמר ליה אביי: אי מה תרומה טובלת, אף ראשית הגז טובלת?",
     "verse": null,
     "blocks": "gs_netina_teruma_reishit_hagez",
     "withdrawn": false,
     "answered": true
    },
    {
     "type": "defeater_answer",
     "object": "ans_meireishito_veeilach",
     "gloss_en": "אמר קרא וראשית גז צאנך תתן לו -- you have in it only from its first [setting aside] onward",
     "answers": "pr_teruma_tovelet",
     "restores": "gs_netina_teruma_reishit_hagez",
     "aliba": null
    }
   ]
  },
  "19": {
   "segId": "Chullin.136a.20",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "defeater_objection",
     "object": "pr_mita_vachomesh",
     "gloss_en": "[Abaye:] אי מה תרומה חייבים עליה מיתה וחומש, אף ראשית הגז?",
     "verse": null,
     "blocks": "gs_netina_teruma_reishit_hagez",
     "withdrawn": false,
     "answered": true
    }
   ]
  },
  "20": {
   "segId": "Chullin.136a.21",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "defeater_answer",
     "object": "ans_bo_alav",
     "gloss_en": "אמר קרא ומתו בו, ויסף עליו -- 'upon it' and not upon the first shearing, 'in it' and not in the first shearing",
     "answers": "pr_mita_vachomesh",
     "restores": "gs_netina_teruma_reishit_hagez",
     "aliba": null
    }
   ]
  },
  "21": {
   "segId": "Chullin.136a.22",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "defeater_objection",
     "object": "pr_rishon_vesheni",
     "gloss_en": "[Abaye:] אי מה תרומה ראשון ושני אחריה, אף ראשית הגז ראשון ושני אחריה!",
     "verse": null,
     "blocks": "gs_netina_teruma_reishit_hagez",
     "withdrawn": false,
     "answered": true
    },
    {
     "type": "defeater_answer",
     "object": "ans_reishit_bilvad",
     "gloss_en": "אמר קרא ראשית -- you have in it only a first [portion] alone",
     "answers": "pr_rishon_vesheni",
     "restores": "gs_netina_teruma_reishit_hagez",
     "aliba": null
    }
   ]
  },
  "16": {
   "segId": "Chullin.136a.17",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "support",
     "object": "s_vehatanya_ilai_matanot",
     "kind": "svara",
     "gloss_en": "אין, והתניא: רבי אלעאי אומר מתנות אין נוהגין אלא בארץ",
     "supports": "p_yose_nb_ken",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_ilai_matanot_rak_baaretz",
     "gloss_en": "R' Ilai: the gifts apply only in the Land"
    }
   ]
  },
  "24": {
   "segId": "Chullin.136a.25",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "support",
     "object": "s_ein_mitztarfot_ilai",
     "kind": "svara",
     "gloss_en": "הא דרבי אלעאי -- the baraita 'they do not combine' is R' Ilai's",
     "supports": "p_ilai_ein_chadash_al_yashan",
     "status": "live"
    },
    {
     "type": "objection_answer",
     "object": "ans_ha_ilai_ha_rabbanan_a",
     "gloss_en": "והתניא: אין מצטרפות! אלא שמע מינה: הא דרבי אלעאי, והא דרבנן",
     "answers": "obj_shtei_rechelot",
     "restores": "p_ilai_ein_chadash_al_yashan"
    },
    {
     "type": "proposition",
     "object": "p_baraita_ein_mitztarfot",
     "gloss_en": "but it is taught: they do not combine"
    }
   ]
  },
  "26": {
   "segId": "Chullin.136a.27",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "support",
     "object": "s_teruma_gadel_bifetur",
     "kind": "svara",
     "gloss_en": "וגבי תרומה מנלן? דתניא: ...משהביאה שליש רבי עקיבא מחייב בתוספת, וחכמים פוטרין",
     "supports": "p_teruma_gadel_bifetur_patur",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_suria_ad_shlish_chayav",
     "gloss_en": "a Jew who bought a field in Syria from a gentile: before [the produce] reached a third -- obligated"
    }
   ]
  },
  "12": {
   "segId": "Chullin.136a.13",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "objection",
     "object": "obj_rav_bivi_bechora",
     "kind": "tanya",
     "gloss_en": "ליתנהו להני כללי, דתניא: בהמת השותפין חייבת בבכורה, ורבי אלעאי פוטרה",
     "against": "p_rava_ilai_bechora",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_leitnehu_klalei",
     "gloss_en": "these rules [Rava's list of R' Ilai's concessions] do not hold"
    }
   ]
  },
  "13": {
   "segId": "Chullin.136a.14",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "objection",
     "object": "obj_bekarchem",
     "kind": "svara",
     "gloss_en": "והא כתיב בקרכם וצאנכם!",
     "against": "p_ilai_bechora_bekarkha",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_dekulhu_yisrael",
     "gloss_en": "דכולהו ישראל -- [the plural speaks] of all Israel",
     "answers": "obj_bekarchem",
     "restores": "p_ilai_bechora_bekarkha"
    },
    {
     "type": "proposition",
     "object": "p_ilai_bechora_bekarkha",
     "gloss_en": "R' Ilai's reason: it is written 'your herd and your flock'"
    }
   ]
  },
  "15": {
   "segId": "Chullin.136a.16",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "objection",
     "object": "obj_nilaf_mitruma",
     "kind": "svara",
     "gloss_en": "ואי סלקא דעתך בתרומה מיחייב, נילף נתינה נתינה מתרומה! אלא שמע מינה בתרומה נמי פוטר (= p_ilai_teruma_patur)",
     "against": "p_rava_ilai_teruma",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_ilai_teruma_patur",
     "gloss_en": "rather, conclude from it: in teruma too he [R' Ilai] exempts [partners]"
    }
   ]
  },
  "23": {
   "segId": "Chullin.136a.24",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "objection",
     "object": "obj_shtei_rechelot",
     "kind": "tanya",
     "gloss_en": "והתניא: היו לו שתי רחלות... שתים ושלש שנים אין מצטרפות -- הא חמש מצטרפות [over the years: new with old]",
     "against": "p_ilai_ein_chadash_al_yashan",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_baraita_shtei_rechelot",
     "gloss_en": "the baraita: he had two ewes, sheared and set aside, sheared and set aside, two or three years -- they do not combine"
    }
   ]
  },
  "27": {
   "segId": "Chullin.136a.28",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "objection",
     "object": "obj_tzono_ligzoz",
     "kind": "tnan",
     "gloss_en": "והתנן: הלוקח גז צאן גוי פטור מראשית הגז -- הא צאנו לגזוז חייב!",
     "against": "p_ilai_gadel_bifetur",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_ilai_gadel_bifetur",
     "gloss_en": "[Abaye:] so the first shearing too: what grew under obligation is obligated, under exemption exempt -- and if you say so indeed [for R' Ilai]"
    }
   ]
  },
  "0": {
   "segId": "Chullin.136a.1",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rabba_derech_biatkha",
     "gloss_en": "Rabba: [beitekha teaches] by way of your entry -- from the right"
    }
   ]
  },
  "1": {
   "segId": "Chullin.136a.2",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rava_ilai_maaser",
     "gloss_en": "ma'aser: though 'the tithe of your grain' is written, the Merciful One wrote 'your [pl.] tithes'"
    }
   ]
  },
  "2": {
   "segId": "Chullin.136a.3",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rava_ilai_matanot",
     "gloss_en": "the gifts: though 'and he shall give' is written (one could learn netina/netina from the first shearing), the Merciful One wrote 'from those [pl.] who slaughter the slaughter'"
    }
   ]
  },
  "5": {
   "segId": "Chullin.136a.6",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rava_din_im_hatabach",
     "gloss_en": "[then 'those who slaughter' is] for Rava's teaching: the claim [for the gifts] is against the butcher"
    }
   ]
  },
  "6": {
   "segId": "Chullin.136a.7",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rava_ilai_bikkurim",
     "gloss_en": "bikkurim: though 'your land' is written, the Merciful One wrote 'the first fruits of all that is in their land'"
    }
   ]
  },
  "7": {
   "segId": "Chullin.136a.8",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_artzekha_chutz_laaretz",
     "gloss_en": "then why 'your land'? to exclude outside the Land"
    }
   ]
  },
  "8": {
   "segId": "Chullin.136a.9",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rava_ilai_tzitzit",
     "gloss_en": "tzitzit: though 'your covering' is written, the Merciful One wrote 'on the corners of their garments throughout their generations'"
    }
   ]
  },
  "9": {
   "segId": "Chullin.136a.10",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_talit_sheula_patur",
     "gloss_en": "Rav Yehuda: a borrowed cloak is exempt from tzitzit for all thirty days"
    }
   ]
  },
  "10": {
   "segId": "Chullin.136a.11",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rava_ilai_maakeh",
     "gloss_en": "ma'akeh: though 'for your roof' is written, the Merciful One wrote 'if any man fall from it'"
    }
   ]
  },
  "11": {
   "segId": "Chullin.136a.12",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_gagekha_batei_knesiyot",
     "gloss_en": "then what does 'your roof' come for? to exclude synagogues and study halls"
    }
   ]
  },
  "22": {
   "segId": "Chullin.136a.23",
   "sugya": "chullin_135a_shutfut_bereishit_hagez",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ilai_ein_chadash_al_yashan",
     "gloss_en": "[Abaye:] as teruma, not from new on behalf of old -- so the first shearing? [Rava:] yes"
    }
   ]
  }
 }
