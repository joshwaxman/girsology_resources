    {
     "type": "proposition",
     "object": "p_bahadei_deshalif",
     "gloss_en": "needed where it clawed and they cut off its hand: lest you say it casts its venom as it claws, it teaches that it casts its venom as it withdraws"
    }
   ]
  },
  "9": {
   "segId": "Chullin.53a.10",
   "sugya": "chullin_52b_derusat_chatul",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rav_ari_shvarim",
     "gloss_en": "Rav: a lion entered among the oxen and a claw was found in the back of one of them -- we are not concerned that the lion clawed it"
    }
   ]
  },
  "12": {
