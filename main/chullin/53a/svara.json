    {
     "type": "support",
     "object": "s_rav_letaameih",
     "kind": "svara",
     "gloss_en": "ורב לטעמיה, דאמר: אין חוששין לספק דרוסה",
     "supports": "p_rav_ari_shvarim",
     "status": "live"
    },
    {
     "type": "objection_answer",
     "object": "a_okei_tora",
     "gloss_en": "איכא למימר הכי ואיכא למימר הכי -- אוקי תורא אחזקיה; it is a doubtful clawing, and Rav holds no concern for that (= p_okei_tora_achezkei)",
     "answers": "obj_adraba_shvarim",
     "restores": "p_reason_nitchakech"
    },
    {
     "type": "proposition",
     "object": "p_okei_tora_achezkei",
     "gloss_en": "one can say this and one can say that -- leave the ox on its presumption; it is a doubtful clawing"
    }
   ]
  },
  "4": {
   "segId": "Chullin.53a.5",
   "sugya": "chullin_52b_derusat_chatul",
   "marks": [
    {
     "type": "objection",
     "object": "obj_tnan_netz_beof_hadak",
     "kind": "tnan",
     "gloss_en": "והאנן תנן: ודרוסת הנץ בעוף הדק! -- the mishna names only the hawk",
     "against": "p_shear_ofot_yesh",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_bedichvatei",
     "gloss_en": "דרוסת הנץ בדכוותיה, ואינך בדזוטרא מינייהו -- the hawk on its like, the others on what is smaller than them",
     "answers": "obj_tnan_netz_beof_hadak",
     "restores": "p_shear_ofot_yesh"
    },
    {
     "type": "objection_answer",
     "object": "a_bidrabi_minei",
     "gloss_en": "ואיכא דאמרי: דרוסת הנץ בדרבי מיניה, ואינך בדכוותייהו -- the hawk even on what is larger than it, the others on their like",
     "answers": "obj_tnan_netz_beof_hadak",
     "restores": "p_shear_ofot_yesh"
    },
    {
     "type": "proposition",
     "object": "p_mishna_netz_beof_hadak",
     "gloss_en": "the mishna: clawed by a hawk -- in a small bird"
    }
   ]
  },
  "5": {
