     "gloss_en": "איני? והא כי אתא רב דימי אמר: מעשה ודרס שועל רחל... ואמרו: יש דרוסה",
     "against": "p_shimi_ein_shual",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_safra_chatul",
     "gloss_en": "ההוא חתול הוה -- that was a cat",
     "answers": "obj_beit_hini_v1",
     "restores": "p_shimi_ein_shual"
    },
    {
     "type": "proposition",
     "object": "p_shimi_ein_shual",
     "gloss_en": "Rav Shimi bar Ashi: a fox does not claw"
    }
   ]
  },
