     "kind": "svara",
     "gloss_en": "כי בלע היתרא מאי הוי? סוף סוף האי היתרא דאתי לידי איסורא הוא, דאיסורא קאכיל",
     "against": "p_abaye_heter_bala",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_rava_efshar_litaameih",
     "gloss_en": "Rava: this one can be tasted, and that one cannot be tasted"
