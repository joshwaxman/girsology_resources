     "kind": "svara",
     "gloss_en": "ומאי שנא מדמא דבשרא? -- how is it different from the meat's own blood?",
     "against": "p_bei_dugei",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_shachen_kafei",
     "gloss_en": "דמא דבשרא -- שכן, דמא דכבדא -- קפי: the meat's blood sinks, the liver's floats",
