     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_abaye_heter_bala",
     "gloss_en": "Abaye: this [radish] absorbed something permitted, and that [bowl] absorbed something forbidden"
    }
   ]
  },
  "8": {
