   "sugya": "chullin_52a_neekru_tzlaot",
   "marks": [
    {
     "type": "objection",
     "object": "o_rav_nami_gistra",
     "kind": "svara",
     "gloss_en": "והא רב נמי גיסטרא קאמר? -- but Rav too is speaking of a gistra [and calls it only tereifa]",
     "against": "p_rav_tzela_vechulya",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_tzela_belo_chulya",
     "gloss_en": "כי קאמר רב -- צלע בלא חוליא (= p_rav_reading_belo_chulya; replaced at 52a.10 by צלע וחצי חוליא, p_rav_reading_vachatzi_chulya)",
     "answers": "o_rav_nami_gistra",
     "restores": "p_rav_tzela_vechulya"
    },
    {
     "type": "proposition",
     "object": "p_rav_reading_belo_chulya",
     "gloss_en": "stam: when Rav said [rib and vertebra -- tereifa], [he meant] a rib without the vertebra"
    }
   ]
  },
  "9": {
   "segId": "Chullin.52a.10",
   "sugya": "chullin_52a_neekru_tzlaot",
   "marks": [
    {
     "type": "objection",
     "object": "o_vehaa_tzela_vechulya",
     "kind": "svara",
     "gloss_en": "והא צלע וחוליא קאמר? -- but he said 'a rib and a vertebra'! (the reading is not defended; the stam moves to צלע וחצי חוליא)",
     "against": "p_rav_reading_belo_chulya",
     "state": "live"
    },
    {
     "type": "proposition",
     "object": "p_rav_reading_vachatzi_chulya",
     "gloss_en": "stam: [Rav meant] a rib and half a vertebra"
    }
   ]
  },
  "10": {
   "segId": "Chullin.52a.11",
   "sugya": "chullin_52a_neekru_tzlaot",
