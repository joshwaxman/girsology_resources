    {
     "type": "objection",
     "object": "o_eitivei_tziv_yad",
     "kind": "meitivi",
     "gloss_en": "איתיביה: one touching a hair opposite [the flesh] is impure -- is it not because it is a handle?",
     "against": "p_rl_nima_lav_yad",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_tziv_vesaara_tamei",
     "gloss_en": "the mishna (124a): a hide with an olive-bulk of flesh -- one who touches a strand coming out of it, or a hair opposite it, is impure"
    }
   ]
  },
  "18": {
   "segId": "Chullin.119b.19",
   "sugya": "chullin_117b_shomrim_veyadot",
   "marks": [
    {
     "type": "objection_answer",
     "object": "ans_lo_mishum_shomer",
     "gloss_en": "לא, משום שומר -- [and shomer atop shomer? חלחולי מחלחל, the hair penetrates to the flesh]",
     "answers": "o_eitivei_tziv_yad",
     "restores": "p_rl_nima_lav_yad"
    },
    {
     "type": "proposition",
     "object": "p_tziv_mishum_shomer",
     "gloss_en": "the stam: no -- because [the hair] is protection"
    }
   ]
  },
  "21": {
