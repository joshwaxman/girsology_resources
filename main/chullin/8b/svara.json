     "restores": "p_okimta_chadasha"
    },
    {
     "type": "proposition",
     "object": "p_meshamshei_az_ad_sheyeavdu",
     "gloss_en": "[a new knife] is an accessory of idol worship, and accessories of idol worship are not forbidden until they are used"
    }
   ]
