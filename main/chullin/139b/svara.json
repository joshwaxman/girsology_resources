  "1": {
   "segId": "Chullin.139b.2",
   "sugya": "chullin_138b_shiluach_bemukdashin",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rh_arakhin_af_belo_alai_chayav",
     "gloss_en": "Rav Hamnuna (as corrected): all agree with regard to valuations that even though he did not say 'upon me', he is liable, as it is written 'and he shall give your valuation': it is non-sacred in your hand until it reaches the treasurer"
    }
   ]
  },
  "5": {
   "segId": "Chullin.139b.6",
   "sugya": "chullin_139b_ki_yikkare_ken",
   "marks": [
    {
     "type": "support",
     "object": "s_mikan_amru_chayav",
     "kind": "svara",
     "gloss_en": "מכאן אמרו -- birds whose nest is not in one's hand are obligated",
     "supports": "p_shovach_pardes_chayav",
     "status": "live"
    },
    {
     "type": "support",
     "object": "s_mikan_amru_patur",
     "kind": "svara",
     "gloss_en": "מכאן אמרו -- birds nesting in the house, and yonei hardesiyot, are exempt",
     "supports": "p_bayit_hardesiyot_patur",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_ma_derech",
     "gloss_en": "'before you on the way' says: as on a road its nest is not in your hand, so [the law applies to] whatever's nest is not in your hand"
    }
   ]
  },
  "7": {
   "segId": "Chullin.139b.8",
   "sugya": "chullin_139b_ki_yikkare_ken",
   "marks": [
    {
     "type": "support",
     "object": "s_hanoten_bayam",
     "kind": "svara",
     "gloss_en": "שנאמר הנותן בים דרך -- the sea is called 'a way'",
     "supports": "p_rav_ken_bayam",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_lefanecha_maradu",
     "gloss_en": "rather, 'before you' -- to include those that were before you and rebelled"
    }
   ]
  },
  "8": {
   "segId": "Chullin.139b.9",
   "sugya": "chullin_139b_ki_yikkare_ken",
   "marks": [
    {
     "type": "objection",
     "object": "obj_ken_bashamayim",
     "kind": "svara",
     "gloss_en": "אלא מעתה, מצא קן בשמים, דכתיב דרך נשר בשמים, הכי נמי דמיחייב בשילוח הקן?",
     "against": "p_rav_ken_bayam",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "ans_derech_stama",
     "gloss_en": "דרך נשר איקרי, דרך סתמא לא איקרי -- the sky is called 'the way of an eagle', not 'a way' unqualified",
     "answers": "obj_ken_bashamayim",
     "restores": "p_rav_ken_bayam"
    },
    {
     "type": "proposition",
     "object": "p_derech_nesher_bashamayim",
     "gloss_en": "as it is written: 'the way of an eagle in the sky' (Prov 30:19)"
    }
   ]
  },
  "3": {
   "segId": "Chullin.139b.4",
   "sugya": "chullin_139b_ki_yikkare_ken",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ki_yikkare_bemeora",
     "gloss_en": "'shalle'ach teshallach' might suggest one must go round mountains and hills to find a nest; 'ki yikkare' teaches: [only] when it happens before you"
    }
   ]
  },
  "4": {
   "segId": "Chullin.139b.5",
   "sugya": "chullin_139b_ki_yikkare_ken",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ken_mikol_makom",
     "gloss_en": "'nest' -- a nest in any case"
    }
   ]
  },
  "6": {
   "segId": "Chullin.139b.7",
   "sugya": "chullin_139b_ki_yikkare_ken",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ki_yikkare_prat_limzuman",
     "gloss_en": "'ki yikkare' excludes the readily available"
    }
   ]
  },
  "9": {
   "segId": "Chullin.139b.10",
   "sugya": "chullin_139b_ki_yikkare_ken",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ken_berosho",
     "gloss_en": "a nest found on a man's head -- what is it? Rav Mattana: 'and earth upon his head' (II Sam 15:32)"
    }
