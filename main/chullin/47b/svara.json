     "state": "answered"
    },
    {
     "type": "elimination",
     "object": "e_hainu_nikva",
     "gloss_en": "אילימא מבחוץ -- היינו ניקבה! (= p_hainu_nikva)",
     "eliminates": "p_chasra_mibachutz",
