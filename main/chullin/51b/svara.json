     "tension": false
    },
    {
     "type": "ruling",
     "object": "hil_amda_requires_bedika",
     "gloss_en": "והלכתא: ... ועמדה ולא הלכה -- צריכה בדיקה",
     "prop": "p_amda_requires_bedika",
     "tension": false
    },
    {
     "type": "ruling",
     "object": "hil_halcha_exempt_bedika",
     "gloss_en": "ואם הלכה -- אפילו בדיקה נמי לא צריכה (as Rav, against Rav Chiyya bar Ashi)",
     "prop": "p_halcha_exempt_bedika",
     "tension": false
    },
    {
     "type": "proposition",
     "object": "p_hil_bidla_yada",
     "gloss_en": "the ruling: where it fell from the roof unawares [-- stood and did not walk: inspection, not twenty-four hours; walked: not even inspection]"
