   "sugya": "chullin_51a_risukei_evarim",
   "marks": [
    {
     "type": "support",
     "object": "s_hachi_amar_rav_tziporen",
     "kind": "svara",
     "gloss_en": "מנא לך הא? אמר להו: הכי אמר רב: צפרניו נועץ עד שמגיע לארץ",
     "supports": "p_tora_nafal_shakal",
     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_tora_nafal_shakal",
     "gloss_en": "a bull fell and the sound of its groan was heard; Rav Yitzchak bar Shmuel bar Marta went in and took of the choicest cuts"
    }
   ]
  },
  "12": {
   "segId": "Chullin.51b.13",
