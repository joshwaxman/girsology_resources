    {
     "type": "support_deflection",
     "object": "defl_dofen_tinok",
     "gloss_en": "הכא במאי עסקינן, כגון שיצא דרך דופן -- here it is one born by caesarean",
     "deflects": "s_mesaya_tinok_ben_yom",
     "refuted": false
    }
   ]
  },
  "2": {
   "segId": "Chullin.51b.3",
   "sugya": "chullin_51a_risukei_evarim",
   "marks": [
    {
     "type": "support",
     "object": "s_ts_egel_beyom_tov",
     "kind": "ta_shema",
     "gloss_en": "תא שמע: עגל שנולד ביום טוב -- שוחטין אותו ביום טוב",
     "supports": "p_rn_beit_harechem",
     "status": "rejected"
    },
    {
     "type": "support_deflection",
     "object": "defl_dofen_egel",
     "gloss_en": "הכא נמי, כגון שיצא דרך דופן -- here too, born by caesarean",
     "deflects": "s_ts_egel_beyom_tov",
     "refuted": false
    },
    {
     "type": "proposition",
     "object": "p_egel_beyom_tov",
     "gloss_en": "the baraita: a calf born on Yom Tov may be slaughtered on Yom Tov"
    }
   ]
  },
  "3": {
   "segId": "Chullin.51b.4",
   "sugya": "chullin_51a_risukei_evarim",
   "marks": [
    {
     "type": "support",
     "object": "s_ts_mumo_imo",
     "kind": "ta_shema",
     "gloss_en": "תא שמע: ושוין שאם נולד הוא ומומו עמו, שזה מן המוכן",
     "supports": "p_rn_beit_harechem",
     "status": "rejected"
    },
    {
     "type": "support_deflection",
     "object": "defl_dofen_bechor",
     "gloss_en": "וכי תימא הכא נמי שיצא דרך דופן -- and if you say here too, born by caesarean",
     "deflects": "s_ts_mumo_imo",
     "refuted": true
    },
    {
     "type": "proposition",
     "object": "p_mumo_imo_muchan",
     "gloss_en": "the baraita: and all agree that if it [a firstborn] was born with its blemish, it is of what is prepared [for Yom Tov]"
    }
   ]
  },
  "4": {
   "segId": "Chullin.51b.5",
   "sugya": "chullin_51a_risukei_evarim",
   "marks": [
    {
     "type": "support_deflection",
     "object": "defl_hifris_al_karka",
     "gloss_en": "הכא במאי עסקינן, שהפריס על גבי קרקע -- here it spread itself out on the ground",
     "deflects": "s_ts_mumo_imo",
     "refuted": false
    }
   ]
  },
  "6": {
