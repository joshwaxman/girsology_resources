    {
     "type": "objection",
     "object": "obj_meitivi_teruma",
     "kind": "meitivi",
     "gloss_en": "מיתיבי: if there is no priest there, he hires a cow and brings the teruma, because of the loss of teruma",
     "against": "p_rav_sheshet_lo_leorvim",
     "state": "answered"
    },
    {
     "type": "proposition",
     "object": "p_baraita_teruma_hefsed",
     "gloss_en": "one does not bring teruma from threshing floor to town or from wilderness to settlement; and if there is no priest there, he hires a cow and brings it, because of the loss of teruma"
    }
   ]
  },
