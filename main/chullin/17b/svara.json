   "sugya": "chullin_17a_pegimot_sakin",
   "marks": [
    {
     "type": "support",
     "object": "s_hacha_nami_mirvach",
     "kind": "svara",
     "gloss_en": "מי לא אמר ר' זירא אמר שמואל ליבן סכין... ואמרינן בית השחיטה מרווח רווח -- הכא נמי בית השחיטה מרווח רווח",
     "supports": "p_tlata_ruchata_lo_tzricha",
     "status": "live"
    },
    {
     "type": "objection",
     "object": "obj_haika_tzdadin",
     "kind": "svara",
     "gloss_en": "וקשיא לן: האיכא צדדין! -- the sides of the white-hot knife burn [the simanim]",
     "against": "p_liben_sakin_kasher",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_mirvach_ravach",
     "gloss_en": "ואמרינן: בית השחיטה מרווח רווח (= p_beit_hashechita_mirvach)",
     "answers": "obj_haika_tzdadin",
     "restores": "p_liben_sakin_kasher"
    },
    {
     "type": "proposition",
     "object": "p_tlata_ruchata_lo_tzricha",
     "gloss_en": "Rav Yeimar: on the three sides it does not need [examination]"
    }
   ]
  },
  "1": {
   "segId": "Chullin.17b.2",
   "sugya": "chullin_17a_pegimot_sakin",
   "marks": [
    {
     "type": "objection",
     "object": "obj_mai_shna_meruach_achat",
     "kind": "svara",
     "gloss_en": "מאי שנא משתי רוחות... מרוח אחת נמי, חורפא דסכינא מחליש, מורשא בזע! -- with one side too, the knife's edge weakens and the notch tears",
     "against": "p_def_mesuchsechet",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_dkaem_areisha",
     "gloss_en": "דקאים ארישא דסכינא -- where the notch is at the head of the knife (= p_dkaem_areisha)",
     "answers": "obj_mai_shna_meruach_achat",
     "restores": "p_def_mesuchsechet"
    },
    {
     "type": "objection",
     "object": "obj_sof_sof",
     "kind": "svara",
     "gloss_en": "סוף סוף, כי אזלא מחלשא, כי אתיא בזעה! -- going it weakens, coming back it tears",
     "against": "p_dkaem_areisha",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_holich_velo_hevi_17b",
     "gloss_en": "כגון שהוליך ולא הביא (= p_holich_velo_hevi_17b)",
     "answers": "obj_sof_sof",
     "restores": "p_dkaem_areisha"
    },
    {
     "type": "proposition",
     "object": "p_dkaem_areisha",
     "gloss_en": "[the one-side notch is] where it stands at the head of the knife"
    }
   ]
  },
  "3": {
   "segId": "Chullin.17b.4",
   "sugya": "chullin_17a_pegimot_sakin",
   "marks": [
    {
     "type": "objection",
     "object": "obj_rava_mesuchsechet",
     "kind": "svara",
     "gloss_en": "אמרת לן משמיה דרבא מסוכסכת פסולה, והא אמר רבא מסוכסכת כשרה! (amoraic-memra contradiction; kind svara under protest)",
     "against": "p_rava_mesuchsechet_pasul",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_holich_vehevi",
     "gloss_en": "לא קשיא: כאן שהוליך והביא, כאן שהוליך ולא הביא (= p_kan_holich_vehevi, p_kan_holich_velo_hevi)",
     "answers": "obj_rava_mesuchsechet",
     "restores": "p_rava_mesuchsechet_pasul"
    },
    {
     "type": "proposition",
     "object": "p_rava_mesuchsechet_pasul",
     "gloss_en": "(as Rav Ashi reported in Rava's name) mesuchsechet -- invalid"
    }
   ]
  },
