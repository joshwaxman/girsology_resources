     "kind": "meitivi",
     "gloss_en": "מיתיבי: דג טהור שמלחו עם דג טמא -- מותר. מאי לאו שהיו שניהן מלוחין?",
     "against": "p_rava_hatemeim",
     "state": "answered"
    },
    {
     "type": "objection_answer",
     "object": "a_tahor_maliach_tamei_tafel",
     "gloss_en": "לא, כגון שהיה טהור מליח וטמא תפל (= p_okimta_tahor_maliach)",
