     "restores": "p_rava_hatemeim"
    },
    {
     "type": "proposition",
     "object": "p_baraita_seifa",
     "gloss_en": "the seifa: but if the kosher one was salted and the non-kosher one unsalted [-- permitted]"
    }
   ]
  },
