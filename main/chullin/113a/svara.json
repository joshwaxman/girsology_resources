     "restores": "p_rava_hatemeim"
    },
    {
     "type": "proposition",
     "object": "p_baraita_dag_tahor_mutar",
     "gloss_en": "a kosher fish that one salted with a non-kosher fish -- permitted"
    }
   ]
  },
  "3": {
