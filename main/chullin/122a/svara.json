     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_akiva_lo_shna_chaya_sakin",
     "gloss_en": "R' Akiva's reason is that the hide nullifies them -- no difference whether an animal flayed it or a knife"
    }
   ]
  },
  "1": {
