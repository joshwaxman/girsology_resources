{"entryId":"1229","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:1229:1","sourceSha256":"3567d40cb6daa3d673c0ca95ae486710ffa33f1bcbabd0d73cac579f14f2fb9f","englishSha256":"1ff5f5a8770a50ee1174197dedbe918c8f0a8496d3689939463c5e078981f1be","citations":[{"id":"1229:1:citation-01","he":[15,31],"en":[20,30],"target":{"url":"https://www.sefaria.org/Eruvin_59b.11"},"reference":"Eruvin 59b:11","assessment":"The elders name Chiyya bar Assi who used to include the entire town.","evidence":[{"reference":"Eruvin 59b:11","target":{"url":"https://www.sefaria.org/Eruvin_59b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"1229:1:citation-02","he":[32,53],"en":[43,53],"target":{"url":"https://www.sefaria.org/Taanit_18a.9"},"reference":"Taanit 18a:9","assessment":"The leaf explicitly names bar Assi transmitting Rav, with the patronymic distinct from bar Ashi.","evidence":[{"reference":"Taanit 18a:9","target":{"url":"https://www.sefaria.org/Taanit_18a.9"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"inlineHebrew":[0,1],"holds":[],"notes":[{"text":"Both sources explicitly name Chiyya bar Assi. Eruvin recounts the custom of including the whole town. Taanit records his ruling in Rav’s name. This is a distinct patronymic from bar Ashi in the preceding entry.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Taanit 18a:9","target":{"url":"https://www.sefaria.org/Taanit_18a.9"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Eruvin 59b:11","target":{"url":"https://www.sefaria.org/Eruvin_59b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"entryEvidence":[]}
