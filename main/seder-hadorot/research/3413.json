{"entryId":"3413","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:3413:1","sourceSha256":"08e5a3659351f993d12e73f22ddbaf701d478f2539abee7170f913243ad93556","englishSha256":"be0f0fc9129c4f9717dd40c1399208331d6bc5ec247a77eb23a3ae578236927f","citations":[{"id":"3413:1:link-019","he":[51,67],"en":[85,109],"target":{"url":"https://www.sefaria.org/Chullin_18b.12"},"reference":"Chullin 18b:12","assessment":"The checked Bavli has Ravina relay Rav Shemen’s statement about Mar Zutra, spelling the place Sovra.","evidence":[{"reference":"Chullin 18b:12","target":{"url":"https://www.sefaria.org/Chullin_18b.12"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3413:1:link-020","he":[68,80],"en":[111,121],"target":{"url":"https://www.sefaria.org/Niddah_36a.16"},"reference":"Niddah 36a:16","assessment":"The checked Niddah reads of Sikhra and explicitly reports Mar Zutra’s visit. Preserve the local form and Ravina’s mediation.","evidence":[{"reference":"Niddah 36a:16","target":{"url":"https://www.sefaria.org/Niddah_36a.16"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"inlineHebrew":[0,1],"holds":[],"notes":[{"text":"Hullin reads מסוברא (of Sovra). The checked Niddah reads מסכרא (of Sikhra).","references":[],"urls":[]}],"comparisonEvidence":[]}],"entryEvidence":[]}
