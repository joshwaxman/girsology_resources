{"entryId":"2836","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2836:1","sourceSha256":"bdaa82f67e5379f57af0715872a23b16c94c48775e02c1463d1d96a86de1718e","englishSha256":"74820fa5ae426176e26f976c5366164efd18dafc160f247f915df398ce4b7a88","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"Megillah explicitly names Yonatan son of Uzziel for the prophetic Targum. Heilprin’s fuller Yonatan notice uses the same name. Keep the bare Uzziel heading.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Megillah 3a:4","target":{"url":"https://www.sefaria.org/Megillah_3a.4"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 1869:1","target":{"entry":1869,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
