{"entryId":"1531","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:1531:1","sourceSha256":"069ef5e510aad5ee6437d2473d95e3c2eea843a7b7b01b11a87ee8950e1487de","englishSha256":"2787996b10109e687ffcb12e46eb8fa1444a2d2b2f21770fb20f6fbd60b5b41f","citations":[{"id":"1531:1:citation-01","he":[9,39],"en":[38,50],"target":{"url":"https://www.sefaria.org/Menachot_34b.7"},"reference":"Menachot 34b:7","assessment":"The passage explicitly reports Chananyah transmitting from Yochanan.","evidence":[{"reference":"Menachot 34b:7","target":{"url":"https://www.sefaria.org/Menachot_34b.7"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"1531:1:citation-02","he":[41,78],"en":[126,136],"target":{"url":"https://www.sefaria.org/Eruvin_51a.16"},"reference":"Eruvin 51a:16","assessment":"Pappa reports that Rava tested them. His quotation of their answer repeats Chananyah’s teaching; they are distinct voices.","evidence":[{"reference":"Eruvin 51a:14","target":{"url":"https://www.sefaria.org/Eruvin_51a.14"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Eruvin 51a:16","target":{"url":"https://www.sefaria.org/Eruvin_51a.16"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"inlineHebrew":[0,1],"holds":[],"notes":[{"text":"Menachot identifies Yochanan as the authority. Eruvin gives distinct voices for Pappa, Rava, the respondents, and the quoted Chananyah.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Menachot 34b:7","target":{"url":"https://www.sefaria.org/Menachot_34b.7"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Eruvin 51a:14","target":{"url":"https://www.sefaria.org/Eruvin_51a.14"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Eruvin 51a:16","target":{"url":"https://www.sefaria.org/Eruvin_51a.16"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"entryEvidence":[]}
