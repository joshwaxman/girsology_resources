{"entryId":"2868","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2868:1","sourceSha256":"e3b8e1b01a622d875a0613aea2f6be9c9147ea53c27da300210a396c100643d2","englishSha256":"8ce758fc2cb727d8a8729fb722e0e062ffeb7f450bb6dfd3cb09a23701223e28","citations":[{"id":"2868:1:link-01","he":[47,61],"en":[74,86],"target":{"url":"https://www.sefaria.org/Berakhot_44a.6"},"reference":"Berakhot 44a:6","assessment":"Berakhot gives the two men as married to Rav Ḥisda’s daughters.","evidence":[{"reference":"Berakhot 44a:6","target":{"url":"https://www.sefaria.org/Berakhot_44a.6"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"2868:1:link-02","he":[79,93],"en":[107,118],"target":{"url":"https://www.sefaria.org/Arakhin_25a.11"},"reference":"Arakhin 25a:11","assessment":"Arakhin expressly names Mar Ukva bar Ḥama on water-filled hollows.","evidence":[{"reference":"Arakhin 25a:11","target":{"url":"https://www.sefaria.org/Arakhin_25a.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"2868:1:link-03","he":[113,127],"en":[149,160],"target":{"url":"https://www.sefaria.org/Zevachim_55b.4"},"reference":"Zevachim 55b:4","assessment":"The source explicitly gives Mar Ukva bar Ḥama quoting R. Yose son of R. Ḥanina.","evidence":[{"reference":"Zevachim 55b:4","target":{"url":"https://www.sefaria.org/Zevachim_55b.4"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"2868:1:link-04","he":[144,163],"en":[205,236],"target":{"url":"https://www.sefaria.org/Bava_Metzia_65a.11"},"reference":"Bava Metzia 65a:11","assessment":"Chapter Eizehu Neshekh has the exact objection on 65a as an alternate attribution to Rav Ukva. The pinned Hebrew preserves the discrepant 48a.","evidence":[{"reference":"Bava Metzia 65a:11","target":{"url":"https://www.sefaria.org/Bava_Metzia_65a.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"2868:1:link-05","he":[190,205],"en":[300,312],"target":{"url":"https://www.sefaria.org/Ketubot_94b.8"},"reference":"Ketubot 94b:8","assessment":"The named judges hear the two parties separately.","evidence":[{"reference":"Ketubot 94b:8","target":{"url":"https://www.sefaria.org/Ketubot_94b.8"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"inlineHebrew":[0,1,2,3,4],"holds":[],"notes":[{"text":"Berakhot gives the two men as married to Rav Ḥisda’s daughters.","references":[],"urls":[]},{"text":"Arakhin expressly names Mar Ukva bar Ḥama on water-filled hollows.","references":[],"urls":[]},{"text":"The source explicitly gives Mar Ukva bar Ḥama quoting R. Yose son of R. Ḥanina.","references":[],"urls":[]},{"text":"The subject omitted in Heilprin’s abbreviated continuation is explicit in the source.","references":[],"urls":[]},{"text":"Chapter Eizehu Neshekh has the exact objection on 65a as an alternate attribution to Rav Ukva. The pinned Hebrew preserves the discrepant 48a.","references":[],"urls":[]},{"text":"The inspected Bavli initially names his brother Rami and supplies Ukva as the alternative objector.","references":[],"urls":[]},{"text":"The named judges hear the two parties separately.","references":[],"urls":[]},{"text":"The full passage maps each brother to a distinct tribunal.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Berakhot 44a:6","target":{"url":"https://www.sefaria.org/Berakhot_44a.6"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Arakhin 25a:11","target":{"url":"https://www.sefaria.org/Arakhin_25a.11"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Zevachim 55b:4","target":{"url":"https://www.sefaria.org/Zevachim_55b.4"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Bava Metzia 65a:11","target":{"url":"https://www.sefaria.org/Bava_Metzia_65a.11"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Ketubot 94b:8","target":{"url":"https://www.sefaria.org/Ketubot_94b.8"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"e