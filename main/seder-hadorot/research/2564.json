{"entryId":"2564","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2564:1","sourceSha256":"1f0378a9488f79fdafd7475d6ac1d28a01b395f0bfd9108ddb9643a2baa88771","englishSha256":"b2ec143552dd8f6bec3466d25490c65737d7a22611dd01750fbf3b9ea0881872","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"Ketubot expressly names Rav Kahana holding beer belonging to the orphan Rav Mesharshya bar Ḥilkai. This supports the contemporaneity claim without implying any family tie.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Ketubot 100b:17","target":{"url":"https://www.sefaria.org/Ketubot_100b.17"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"entryEvidence":[]}
