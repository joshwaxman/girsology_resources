{"entryId":"2843","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2843:1","sourceSha256":"b560f6749dcdefc755e5564351ce363b4ca3eedc3075482e2a83a85cfbd4a9ac","englishSha256":"5a23479d245614f4a9ae1f343238a0a0cafb8a474884925ed8be3e0b77334f03","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"The other Heilprin entry documents the expanded Aḥa patronymic without proving a common father for all the listed forms.","references":[],"urls":[]},{"text":"The Bena’ah notice names the same patronymic and preserves the Ravina alternative on Beitzah.","references":[],"urls":[]},{"text":"Both formal versions have headings. Keep them distinct and preserve the root’s or.","references":[],"urls":[]},{"text":"The patronymic is explicit in Beitzah, alongside the textual relation reported by the reciprocal notices.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Seder HaDorot 325:1","target":{"entry":325,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Seder HaDorot 757:1","target":{"entry":757,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Beitzah 3b:3","target":{"url":"https://www.sefaria.org/Beitzah_3b.3"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 3117:1","target":{"entry":3117,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Seder HaDorot 3165:1","target":{"entry":3165,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Seder HaDorot 3209:1","target":{"entry":3209,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
