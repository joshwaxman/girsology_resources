{"entryId":"2895","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2895:1","sourceSha256":"6b876bcbb286c1965524ba28049939bf329e12090531ef92e31b95eab6f09cec","englishSha256":"5daef3df7ec2f6ce3e0cd8194477ad8d01f4143b6a0d1796126a81c4c584ad70","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"Bekhorot explicitly calls Ḥizkiyah the father of Ikkesh, with the plene/defective difference in the name. The reciprocal Heilprin father entry cites precisely this testimony.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Bekhorot 38a:3","target":{"url":"https://www.sefaria.org/Bekhorot_38a.3"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 1216:1","target":{"entry":1216,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
