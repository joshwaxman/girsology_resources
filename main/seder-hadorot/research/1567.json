{"entryId":"1567","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:1567:1","sourceSha256":"1e7e1798f4c37b08508ca12f3c1ea0f1f6f570245bc2d1c49bf545a9006027b4","englishSha256":"5c9f0c90273b76a60652f7191795574af3897bdf8d14ec468fbf5fefa54d3351","citations":[{"id":"1567:1:citation-01","he":[0,17],"en":[9,31],"target":{"url":"https://www.sefaria.org/Sukkah_42a.6"},"reference":"Sukkah 42a:6","assessment":"Sukkah names Rav Shmuel bar Chattai. Gittin has the parallel chain with Achittai. Heilprin records that variant under the alternate heading.","evidence":[{"reference":"Sukkah 42a:6","target":{"url":"https://www.sefaria.org/Sukkah_42a.6"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Gittin 39b:17","target":{"url":"https://www.sefaria.org/Gittin_39b.17"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 3367:1","target":{"entry":3367,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"inlineHebrew":[0],"holds":[],"notes":[{"text":"Sukkah gives bar Chattai, while Gittin has bar Achittai in the parallel transmission chain. The reciprocal Heilprin entry preserves the differing names and queries an additional name in the chain.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Sukkah 42a:6","target":{"url":"https://www.sefaria.org/Sukkah_42a.6"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Gittin 39b:17","target":{"url":"https://www.sefaria.org/Gittin_39b.17"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 3367:1","target":{"entry":3367,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
