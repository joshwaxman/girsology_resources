{"entryId":"3157","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:3157:1","sourceSha256":"ed6e44251d441844eeb65b54426db92763fa501b5949c7a6557b39d3b54d5a0d","englishSha256":"6ecd34b33cc08b96a4e91343252d3c1ff31a695ccae730278d89e5ae255ff5cc","citations":[{"id":"3157:1:link-001","he":[12,27],"en":[19,45],"target":{"url":"https://www.sefaria.org/Berakhot_2b.2"},"reference":"Berakhot 2b:2","assessment":"Rabbah bar Rav Sheila gives the nighttime interpretation.","evidence":[{"reference":"Berakhot 2b:2","target":{"url":"https://www.sefaria.org/Berakhot_2b.2"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-002","he":[28,43],"en":[47,58],"target":{"url":"https://www.sefaria.org/Chullin_132b.8"},"reference":"Chullin 132b:8","assessment":"Rabbah bar Rav Sheila reports the duration of Rav Hisda’s ban.","evidence":[{"reference":"Chullin 132b:8","target":{"url":"https://www.sefaria.org/Chullin_132b.8"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-003","he":[62,68],"en":[77,89],"target":{"url":"https://www.sefaria.org/Shabbat_120b.14"},"reference":"Shabbat 120b:14","assessment":"The checked folio reads Rava bar Rav Sheila.","evidence":[{"reference":"Shabbat 120b:14","target":{"url":"https://www.sefaria.org/Shabbat_120b.14"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-004","he":[70,77],"en":[91,95],"target":{"url":"https://www.sefaria.org/Shabbat_156a.10"},"reference":"Shabbat 156a:10","assessment":"The witness gives Rava bar Rav Sheila and the additional prediction.","evidence":[{"reference":"Shabbat 156a:10","target":{"url":"https://www.sefaria.org/Shabbat_156a.10"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-005","he":[79,93],"en":[97,108],"target":{"url":"https://www.sefaria.org/Menachot_87a.17"},"reference":"Menachot 87a:17","assessment":"The name Rava bar Rav Sheila occurs three times, at verses 17–19 of the digital folio.","evidence":[{