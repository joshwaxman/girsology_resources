_58a.13"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Berakhot 58a:14","target":{"url":"https://www.sefaria.org/Berakhot_58a.14"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 3287:1","target":{"entry":3287,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]},{"id":"3157:1:link-011","he":[268,323],"en":[500,509],"target":{"url":"https://www.daat.ac.il/daat/vl/yohasin-zakut/yohasin-zakut09.pdf#page=43"},"reference":"Sefer Yuhasin, Treatise II, London 1857, p. 187","assessment":"The London Yuhasin mentions the flogging and miracle in the Rabbah bar Sheila notice and recounts the judicial episode under R. Sheila. The editor's note at p. 187 points out the confusion. The Bavli explicitly names R. Sheila.","evidence":[{"reference":"Sefer Yuhasin, Treatise II, London 1857, p. 187","target":{"url":"https://www.daat.ac.il/daat/vl/yohasin-zakut/yohasin-zakut09.pdf#page=43"},"witness":"Sefer Yuhasin, Treatise II, London 1857, p. 187"},{"reference":"Sefer Yuhasin, Treatise II, London 1857, p. 189","target":{"url":"https://www.daat.ac.il/daat/vl/yohasin-zakut/yohasin-zakut09.pdf#page=45"},"witness":"Sefer Yuhasin, Treatise II, London 1857, p. 189"},{"reference":"Berakhot 58a:13","target":{"url":"https://www.sefaria.org/Berakhot_58a.13"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-012","he":[268,323],"en":[510,536],"target":{"url":"https://www.daat.ac.il/daat/vl/yohasin-zakut/yohasin-zakut09.pdf#page=45"},"reference":"Sefer Yuhasin, Treatise II, London 1857, p. 189","assessment":"The London Yuhasin mentions the flogging and miracle in the Rabbah bar Sheila notice and recounts the judicial episode under R. Sheila. The editor's note at p. 187 points out the confusion. The Bavli explicitly names R. Sheila.","evidence":[{"reference":"Sefer Yuhasin, Treatise II, London 1857, p. 189","target":{"url":"https://www.daat.ac.il/daat/vl/yohasin-zakut/yohasin-zakut09.pdf#page=45"},"witness":"Sefer Yuhasin, Treatise II, London 1857, p. 189"},{"reference":"Sefer Yuhasin, Treatise II, London 1857, p. 187","target":{"url":"https://www.daat.ac.il/daat/vl/yohasin-zakut/yohasin-zakut09.pdf#page=43"},"witness":"Sefer Yuhasin, Treatise II, London 1857, p. 187"},{"reference":"Berakhot 58a:13","target":{"url":"https://www.sefaria.org/Berakhot_58a.13"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-013","he":[326,560],"en":[573,1052],"target":{"url":"https://www.sefaria.org/Chagigah_15b.11"},"reference":"Chagigah 15b:11","assessment":"The complete passage identifies Rabbah as questioner and Elijah as respondent. The image is a pomegranate. Heilprin’s account of God heeding Rabbah is explanatory rather than an additional clause within the Bavli quotation.","evidence":[{"reference":"Chagigah 15b:11","target":{"url":"https://www.sefaria.org/Chagigah_15b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-014","he":[562,590],"en":[1053,1089],"target":{"url":"https://www.sefaria.org/Taanit_8b.11"},"reference":"Taanit 8b:11","assessment":"Rabbah bar Sheila gives the complete saying comparing a day of rain to a day of judgment.","evidence":[{"reference":"Taanit 8b:11","target":{"url":"https://www.sefaria.org/Taanit_8b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-015","he":[592,640],"en":[1093,1108],"target":{"url":"https://www.sefaria.org/Bava_Metzia_85a.8"},"reference":"Bava Metzia 85a:8","assessment":"Bavli and the checked Glick Ein Yaakov both give Rabbah bar Rav Sheila. The alternative “Mar” may represent another Ein Yaakov edition. Preserve the reported emendation and seek that witness.","evidence":[{"reference":"Bava Metzia 85a:8","target":{"url":"https://www.sefaria.org/Bava_Metzia_85a.8"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Ein Yaakov (Glick Edition), Bava Metzia 7:7","target":{"url":"https://www.sefaria.org/Ein_Yaakov_%28Glick_Edition%29%2C_Bava_Metzia_7.7"},"witness":"En Jacob, translated by SH Glick, 1916"}]},{"id":"3157:1:link-016","he":[677,741],"en":[1215,1336],"target":{"url":"https://www.sefaria.org/Shabbat_7a.8"},"reference":"Shabbat 7a:8","assessment":"Bavli preserves דבי; the local emendation is recorded but not substituted.","evidence":[{"reference":"Shabbat 7a:8","target":{"url":"https://www.sefaria.org/Shabbat_7a.8"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-017","he":[742,796],"en":[1337,1379],"target":{"url":"https://www.sefaria.org/Ketubot_40a.7"},"reference":"Ketubot 40a:7","assessment":"Ketubot has R. Zeira reporting Rabbah; Gittin has R. Zeira reporting R. Abba. The rest of the chains match.","evidence":[{"reference":"Ketubot 40a:7","target":{"url":"https://www.sefaria.org/Ketubot_40a.7"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Gittin 26b:11","target":{"url":"https://www.sefaria.org/Gittin_26b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-018","he":[742,796],"en":[1380,1391],"target":{"url":"https://www.sefaria.org/Gittin_26b.11"},"reference":"Gittin 26b:11","assessment":"Ketubot has R. Zeira reporting Rabbah; Gittin has R. Zeira reporting R. Abba. The rest of the chains match.","evidence":[{"reference":"Gittin 26b:11","target":{"url":"https://www.sefaria.org/Gittin_26b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Ketubot 40a:7","target":{"url":"https://www.sefaria.org/Ketubot_40a.7"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-019","he":[797,819],"en":[1417,1441],"target":{"url":"https://www.sefaria.org/Gittin_81b.19"},"reference":"Gittin 81b:19","assessment":"R. Zeira reports Rabbah bar Sheilta.","evidence":[{"reference":"Gittin 81b:19","target":{"url":"https://www.sefaria.org/Gittin_81b.19"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-020","he":[842,916],"en":[1490,1501],"target":{"url":"https://www.sefaria.org/Ketubot_40a.7"},"reference":"Ketubot 40a:7","assessment":"The two chains are connected. R. Abba or Rabbah reports Rav Hamnuna, who reports Rav Adda in Rav’s name.","evidence":[{"reference":"Ketubot 40a:7","target":{"url":"https://www.sefaria.org/Ketubot_40a.7"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Gittin 26b:11","target":{"url":"https://www.sefaria.org/Gittin_26b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-021","he":[842,916],"en":[1502,1517],"target":{"url":"https://www.sefaria.org/Gittin_26b.11"},"reference":"Gittin 26b:11","assessment":"The two chains are connected. R. Abba or Rabbah reports Rav Hamnuna, who reports Rav Adda in Rav’s name.","evidence":[{"reference":"Gittin 26b:11","target":{"url":"https://www.sefaria.org/Gittin_26b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Ketubot 40a:7","target":{"url":"https://www.sefaria.org/Ketubot_40a.7"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3157:1:link-022","he":[842,862],"en":[1546,1583],"target":{"entry":1052,"paragraph":1},"reference":"Seder HaDorot, Tanaim and Amoraim 1052:1","assessment":"The pointer leads to Heilprin's Rav Hamnuna the Elder entry with both chains. The catalogue's compressed syntax continues through Rav Adda.","evidence":[{"reference":"Seder HaDorot 1052:1","target":{"entry":1052,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]},{"id":"3157:1:link-023","he":[927,950],"en":[1647,1701],"target":{"url":"https://www.sefaria.org/Ketubot_104b.10"},"reference":"Ketubot 104b:10","assessment":"The widow brought R. Hiyya the Tall before Rabbah bar Sheila for judgment. Heilprin's short phrase records his appearance and the cross-reference spells out how it arose.","evidence":[{"reference":"Ketubot 104b:10","target":{"url":"https://www.sefaria.org/Ketubot_104b.10"},"witness":"William Davidson Edition - Voca