{"entryId":"2600","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2600:1","sourceSha256":"9cedcea7282cdffeb037d08bc3b72e2714d3213619eb3973f58b154675450824","englishSha256":"092058c380e281319b4b54b1c30ee2a55b90821b5c45fe35ab70aaa7746d0380","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"The direct Bavli names Ashyan bar Nadvakh, and Heilprin repeats it in the related Ashyan article. Preserve Ashyan’s bare form here.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Bava Batra 22b:7","target":{"url":"https://www.sefaria.org/Bava_Batra_22b.7"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 652:1","target":{"entry":652,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
