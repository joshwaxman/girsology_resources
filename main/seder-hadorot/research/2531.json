{"entryId":"2531","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2531:1","sourceSha256":"fc7abf5abeeead0bd966a4f3042d61cb1d39b21df90661199df6ed937c619208","englishSha256":"e6ced49882a9808ff5e0adb34f8bbc88811729a899f64770ee4de7ac516e6ead","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"Yoma expressly names Rav Giddel bar Menashe of Birei deNaresh. The corresponding Giddel entry also gives the name and place, with a different spelling.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Yoma 81b:11","target":{"url":"https://www.sefaria.org/Yoma_81b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 858:1","target":{"entry":858,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
