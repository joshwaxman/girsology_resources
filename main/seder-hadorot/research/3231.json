{"entryId":"3231","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:3231:1","sourceSha256":"664ff669a95d54f9c24a07196f9b67a529864eac04d94c6151d4bf6270b5d174","englishSha256":"79fa1b7f1fc51ce98c1042d303ed3070d6562b2def71f96a91c44d82647ff5aa","citations":[{"id":"3231:1:link-001","he":[16,61],"en":[20,108],"target":{"url":"https://www.sefaria.org/Taanit_9a.4"},"reference":"Taanit 9a:4","assessment":"Taanit explicitly names Rami bar Hama.","evidence":[{"reference":"Taanit 9a:4","target":{"url":"https://www.sefaria.org/Taanit_9a.4"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3231:1:link-002","he":[62,116],"en":[112,123],"target":{"url":"https://www.sefaria.org/Shabbat_32b.8"},"reference":"Shabbat 32b:8","assessment":"The checked Shabbat rendering records both Rav and Hama in parentheses and brackets. Preserve the gloss’s Rav reading as its own witness.","evidence":[{"reference":"Shabbat 32b:8","target":{"url":"https://www.sefaria.org/Shabbat_32b.8"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3231:1:link-003","he":[117,163],"en":[245,297],"target":{"url":"https://www.sefaria.org/Makkot_23b.11"},"reference":"Makkot 23b:11","assessment":"Makkot names Rami bar Rav.","evidence":[{"reference":"Makkot 23b:11","target":{"url":"https://www.sefaria.org/Makkot_23b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3231:1:link-004","he":[172,210],"en":[370,422],"target":{"url":"https://www.sefaria.org/Zevachim_62b.8"},"reference":"Zevachim 62b:8","assessment":"The checked Zevahim apparatus carries both patronymics, and Yoma has Yehezkel.","evidence":[{"reference":"Zevachim 62b:8","target":{"url":"https://www.sefaria.org/Zevachim_62b.8"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Yoma 58b:12","target":{"url":"https://www.sefaria.org/Yoma_58b.12"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3231:1:link-005","he":[219,264],"en":[453,507],"target":{"url":"https://