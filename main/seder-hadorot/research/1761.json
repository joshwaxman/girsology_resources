w.sefaria.org/Ritva_on_Yoma_18a.3"},"witness":"Chiddushei HaRitva, Berlin, 1860."}]},{"raw":"בחכמה ובמנין או באחת מהם","reason":"The exact numerical criterion in this priestly setting remains unspecified.","evidence":[{"reference":"Ritva on Yoma 18a:4","target":{"url":"https://www.sefaria.org/Ritva_on_Yoma_18a.4"},"witness":"Chiddushei HaRitva, Berlin, 1860."},{"reference":"Mishnah Eduyot 1:5","target":{"url":"https://www.sefaria.org/Mishnah_Eduyot_1.5"},"witness":"Torat Emet 357"},{"reference":"Bartenura on Mishnah Eduyot 1:5:3","target":{"url":"https://www.sefaria.org/Bartenura_on_Mishnah_Eduyot_1.5.3"},"witness":"Torat-Emet"},{"reference":"Rambam on Mishnah Eduyot 1:5:1","target":{"url":"https://www.sefaria.org/Rambam_on_Mishnah_Eduyot_1.5.1"},"witness":"Vilna Edition"}]}],"notes":[{"text":"Ritva’s third answer adds wealth to the criteria, while Heilprin abridges it to wisdom and number. Sifrei Zuta records the questions separately. The exact Yuchasin pointer is open.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Yevamot 61a:6","target":{"url":"https://www.sefaria.org/Yevamot_61a.6"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Eikhah Rabbah 1:47","target":{"url":"https://www.sefaria.org/Eikhah_Rabbah_1.47"},"witness":"Midrash Rabbah -- TE"},{"reference":"Yoma 18a:10","target":{"url":"https://www.sefaria.org/Yoma_18a.10"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Rashi on Yoma 18a:10:1","target":{"url":"https://www.sefaria.org/Rashi_on_Yoma_18a.10.1"},"witness":"Vilna Edition"},{"reference":"Tosafot on Yoma 18a:10:1","target":{"url":"https://www.sefaria.org/Tosafot_on_Yoma_18a.10.1"},"witness":"Vilna Edition"},{"reference":"Tosafot Yeshanim on Yoma 8b:1","target":{"url":"https://www.sefaria.org/Tosafot_Yeshanim_on_Yoma_8b.1"},"witness":"Vilna Edition"},{"reference":"Kiddushin 66a:11","target":{"url":"https://www.sefaria.org/Kiddushin_66a.11"},"witness":"William Davidson Edition - Vocalize