amin erred.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Yevamot 76b:3","target":{"url":"https://www.sefaria.org/Yevamot_76b.3"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Sotah 9a:9","target":{"url":"https://www.sefaria.org/Sotah_9a.9"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Tosefta Kiddushin 5:6","target":{"url":"https://www.sefaria.org/Tosefta_Kiddushin_5.6"},"witness":"Tosefta Kidushin - Machon Mamre"}]}],"entryEvidence":[]}
