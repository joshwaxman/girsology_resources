{"entryId":"2743","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2743:1","sourceSha256":"f6f3dc6806ec11e3bedb8515ff5f60f122459f765d39baeacd0be0441456e918","englishSha256":"498d3d1a69a51151d2a89e3f26e74edc3fb061940872c3c0299a0546e9a1d2ca","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"Pesaḥim explicitly names Rav Ḥiyya son of Rav Natan. Retain Heilprin’s R. title for this occurrence.","references":[],"urls":[]},{"text":"Yevamot explicitly names Rav Kahana son of Rav Natan. Do not treat the local roster as independent evidence that the three fathers are one person.","references":[],"urls":[]},{"text":"Pesaḥim explicitly names Rav Mesharshya son of Rav Natan as Ravina’s source.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Pesachim 41a:21","target":{"url":"https://www.sefaria.org/Pesachim_41a.21"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 1268:1","target":{"entry":1268,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Yevamot 60b:13","target":{"url":"https://www.sefaria.org/Yevamot_60b.13"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 2302:1","target":{"entry":2302,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Pesachim 115a:3","target":{"url":"https://www.sefaria.org/Pesachim_115a.3"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 2573:1","target":{"entry":2573,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
