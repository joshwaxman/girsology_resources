{"entryId":"2860","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2860:1","sourceSha256":"86bd17a00acf973c20304a90e802b9be0ac482ea7a2e33166614afd908ba1bfd","englishSha256":"f7727b4a863a2769f2fadde560ae9d14c7b7071cb0391e882f5b62c93edb5dca","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"Chullin attests Mari bar Mar Ukva by patronymic.","references":[],"urls":[]},{"text":"Berakhot attests Rav Natan bar Mar Ukva, reporting Rav Yehudah. Heilprin has an abbreviated title. Neither patronymic identifies its Mar Ukva with a specific bearer.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Chullin 43b:11","target":{"url":"https://www.sefaria.org/Chullin_43b.11"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Berakhot 13b:16","target":{"url":"https://www.sefaria.org/Berakhot_13b.16"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"entryEvidence":[]}
