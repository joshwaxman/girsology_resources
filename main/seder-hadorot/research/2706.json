{"entryId":"2706","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2706:1","sourceSha256":"c2ee874af197611ed1f2ecc57872656c6ab6588a5f5ef510916da333b1b86678","englishSha256":"9a2f093e04b0ca294de73459d5261fc65b5d4dffb76d5c31c306bf4743af6198","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"The four internal notices support expansion of the heading’s patronymic. Entries for Yannai and Yaakov qualify siblinghood, and Shemuel’s entry separately reports a bare Naḥman variant. No kinship inference added.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Seder HaDorot 1249:1","target":{"entry":1249,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Seder HaDorot 2071:1","target":{"entry":2071,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Seder HaDorot 2109:1","target":{"entry":2109,"paragraph":1},"witness":"Pinned Warsaw digital witness"},{"reference":"Seder HaDorot 3350:1","target":{"entry":3350,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
