{"entryId":"2967","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2967:1","sourceSha256":"34d623360af6caaab39f0ba03f2dc53645c23f7757b33d968ee4a78875ad9aab","englishSha256":"57cd9f7b796643026e5bac1286b4e61d390e4cef2bdede6710b3efd7defe4ac7","citations":[{"id":"2967:1:link-001","he":[21,34],"en":[28,38],"target":{"url":"https://www.sefaria.org/Zevachim_4a.18"},"reference":"Zevachim 4a:18","assessment":"Direct Rav Pinḥas son of Rav Ammi.","evidence":[{"reference":"Zevachim 4a:18","target":{"url":"https://www.sefaria.org/Zevachim_4a.18"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"2967:1:link-002","he":[36,57],"en":[69,82],"target":{"url":"https://www.sefaria.org/Zevachim_7b.5"},"reference":"Zevachim 7b:5","assessment":"The passage records Rav Ashi asking Rav Pinḥas to clarify his position.","evidence":[{"reference":"Zevachim 7b:5","target":{"url":"https://www.sefaria.org/Zevachim_7b.5"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"2967:1:link-003","he":[121,138],"en":[231,280],"target":{"url":"https://www.sefaria.org/Pesachim_100a.2"},"reference":"Pesachim 100a:2","assessment":"The explicit visit to Rav Pinḥas’s lecture occurs at Pesahim 100a:2, with alternate speaker names.","evidence":[{"reference":"Pesachim 100a:2","target":{"url":"https://www.sefaria.org/Pesachim_100a.2"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"2967:1:link-004","he":[163,178],"en":[328,340],"target":{"url":"https://www.sefaria.org/Ketubot_85a.1-2"},"reference":"Ketubot 85a:1-2","assessment":"The adjoining segments name Rav Pappa, Rav Huna son of Rav Yehoshua, and Rav Pinḥas bar Ammi together.","evidence":[{"reference":"Ketubot 85a:1-2","target":{"url":"https://www.sefaria.org/Ketubot_85a.1-2"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Ketubot 85a:2","target":{"url":"https://www.sefaria.org/Ketubot_85a.2"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"inlineHebrew":[0,1,2,3],"holds":[],"notes":[{"text":"Direct Rav Pinḥas son of Rav Ammi.","references":[],"urls":[]},{"text":"The exact segment attests the question from Rav Ashi.","references":[],"urls":[]},{"text":"Present witness puts Marimar before Rav Yeimar and preserves the statement to Mar Zutra. Retain Heilprin’s order with a textual note.","references":[],"urls":[]},{"text":"The two named figures are present in the preceding segment; Rav Pinḥas encounters both.","references":[],"urls":[]},{"text":"The passage records Rav Ashi asking Rav Pinḥas to clarify his position.","references":[],"urls":[]},{"text":"The explicit visit to Rav Pinḥas’s lecture occurs at Pesahim 100a:2, with alternate speaker names.","references":[],"urls":[]},{"text":"The received Bavli reverses the order of the alternatives. Retain Heilprin’s order and report the difference.","references":[],"urls":[]},{"text":"The adjoining segments name Rav Pappa, Rav Huna son of Rav Yehoshua, and Rav Pinḥas bar Ammi together.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Zevachim 4a:18","target":{"url":"https://www.sefaria.org/Zevachim_4a.18"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Zevachim 7b:5","target":{"url":"https://www.sefaria.org/Zevachim_7b.5"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Pesachim 100a:2","target":{"url":"https://www.sefaria.org/Pesachim_100a.2"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Ketubot 85a:1-2","target":{"url":"https://www.sefaria.org/Ketubot_85a.1-2"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Ketubot 85a:2","target":{"url":"https://www.sefaria.org/Ketubot_85a.2"},"witness":"William Davidson Edition - Vocalized Aramaic"}]}],"entryEvidence":[]}
