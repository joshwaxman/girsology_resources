{"entryId":"2732","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:2732:1","sourceSha256":"de1e53c090e2afb100910cbe15e28219b980801fb0b4250b29f7904e235fd293","englishSha256":"9e3c5ee1a9619408dfe41d98b0125a49ab1c005f8d5e35396e2d6be7fbdae549","citations":[],"inlineHebrew":[],"holds":[],"notes":[{"text":"The Bavli gives Abba Shaul bar Nash followed by the alternative bar Ramash, and Heilprin records both in the fuller entry. Retain the shorter local notice.","references":[],"urls":[]}],"comparisonEvidence":[{"reference":"Niddah 25b:3","target":{"url":"https://www.sefaria.org/Niddah_25b.3"},"witness":"William Davidson Edition - Vocalized Aramaic"},{"reference":"Seder HaDorot 3262:1","target":{"entry":3262,"paragraph":1},"witness":"Pinned Warsaw digital witness"}]}],"entryEvidence":[]}
