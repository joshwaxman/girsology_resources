{"entryId":"1467","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:1467:1","sourceSha256":"5a4617e6c7a4a0d95baaaf4561ce43c4faa80d32fba654816b2b69db75a8b5f5","englishSha256":"315691a7b5760b5e73454e820739c08ce6a6b15916a21886cc2aef86e9d97eaf","citations":[{"id":"1467:1:citation-01","he":[31,73],"en":[42,54],"target":{"url":"https://www.sefaria.org/Menachot_48a.9"},"reference":"Menachot 48a:9","assessment":"Menachot has Chanina Tirta teaching before Yochanan.","evidence":[{"reference":"Menachot 48a:9","target":{"url":"https://www.sefaria.org/Menachot_48a.9"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"1467:1:citation-02","he":[74,88],"en":[100,133],"target":{"url":"https://www.sefaria.org/Rashi_on_Menachot_48a.9.1"},"reference":"Rashi on Menachot 48a:9:1","assessment":"Rashi’s lemma reads Torata and explains it as a place-name.","evidence":[{"reference":"Rashi on Menachot 48a:9:1","target":{"url":"https://www.sefaria.org/Rashi_on_Menachot_48a.9.1"},"witness":"Vilna Edition"}]},{"id":"1467:1:citation-03","he":[90,135],"en":[135,146],"target":{"url":"https://www.sefaria.org/Temurah_29a.7"},"reference":"Temurah 29a:7","assessment":"Temurah 29a has Rav Chananyah Tritaa teaching on an animal set aside for idolatry.","evidence":[{"reference":"Temurah 29a:7","target":{"url":"https://www.sefaria.org/Temurah_29a.7"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"1467:1:citation-04","he":[137,155],"en":[189,198],"target":{"url":"https://www.sefaria.org/Temurah_31a.9"},"reference":"Temurah 31a:9","assessment":"Temurah 31a has R. Chanina Tritaa teaching on nursing hot milk.","evidence":[{"reference":"Temurah 31a:9","target":{"url":"https://www.sefaria.org/Temurah_31a.9"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"1467:1:citation-05","he":[291,337],"en":[234,244],"target":{"url":"https://www.sefaria.org/Keritot_9a.29"},"reference":"Keritot 9a:29","assessment":"The contrast between Tosafot and the Keritot lemma c