{"entryId":"3347","paragraphs":[{"sourceId":"heilprin:sefaria-warsaw:ta:3347:1","sourceSha256":"6767feb9ff15c284e1f9b54a7f89a0587317cfd38f09837dd889150dd312be6b","englishSha256":"8b22ecefc5f804fa9033b78376c4e894bc61a6002949a21de7d547776249bd8b","citations":[{"id":"3347:1:link-001","he":[23,35],"en":[27,44],"target":{"url":"https://www.sefaria.org/Rosh_Hashanah_18a.10"},"reference":"Rosh Hashanah 18a:10","assessment":"This reading has Rav Shmuel bar Inya (איניא) in Rav’s name.","evidence":[{"reference":"Rosh Hashanah 18a:10","target":{"url":"https://www.sefaria.org/Rosh_Hashanah_18a.10"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3347:1:link-002","he":[36,49],"en":[46,57],"target":{"url":"https://www.sefaria.org/Megillah_3b.1"},"reference":"Megillah 3b:1","assessment":"This folio has Unya (אוניא) for the teaching about Torah study and offerings.","evidence":[{"reference":"Megillah 3b:1","target":{"url":"https://www.sefaria.org/Megillah_3b.1"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3347:1:link-003","he":[51,70],"en":[66,75],"target":{"url":"https://www.sefaria.org/Megillah_29a.2"},"reference":"Megillah 29a:2","assessment":"The checked Megillah 29a reads Inya (איניא), where Heilprin records Unya. Keep the reported form.","evidence":[{"reference":"Megillah 29a:2","target":{"url":"https://www.sefaria.org/Megillah_29a.2"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3347:1:link-004","he":[72,91],"en":[83,91],"target":{"url":"https://www.sefaria.org/Yoma_21b.7"},"reference":"Yoma 21b:7","assessment":"The checked Yoma has Inya (איניא). Heilprin groups this under Inni, the form directly attested in Ketubot.","evidence":[{"reference":"Yoma 21b:7","target":{"url":"https://www.sefaria.org/Yoma_21b.7"},"witness":"William Davidson Edition - Vocalized Aramaic"}]},{"id":"3347:1:link-005","he":[92,109],"en":[93,119],"target":{"url":"https://www.sefaria.org/Ketubot_17a.12"},"reference":"Ketubot 17a:12","assessm