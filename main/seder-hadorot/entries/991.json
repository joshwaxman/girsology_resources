{"schemaVersion":1,"id":"991","chapter":991,"name":"הונא בריה דרב נחמן","letter":"ה","editionVersion":"v0014","witnesses":[{"sourceKind":"sefaria_digital_warsaw","sourceLabel":"Hebrew · Warsaw digital witness","sourceUrl":"https://www.sefaria.org/Seder_HaDorot,_Tanaim_and_Amoraim.991","versionTitle":"Warsaw, 1878–1882 (saved digital metadata)","transcriptionStatus":"frozen_digital_witness_not_scan_collated","translationTextSha256":"fea597f7a4609a87d4c14bd34eac2e4aedd992c1b6aad8792ce462cbdb1031de","text":"הונא בריה דרב נחמן ונקרא ג\"כ רב הונא בר נחמן והונא מר בר נחמן. רב פפא נשק ראשו ונתן לו בתו, הוריות (י\"ב ב'). ורב הונא בר חיננא חולין (מ\"ט ב') וע\"ש ופליגי על רבא. וא\"ל מר זוטרא ברב נחמן. מר הונא בריה דרב נחמן אמר לרב אשי ב\"מ (מ\"ז א'):","paragraphs":[{"id":"heilprin:sefaria-warsaw:ta:991:1","number":1,"ref":"Seder HaDorot, Tanaim and Amoraim 991:1","text":"הונא בריה דרב נחמן ונקרא ג\"כ רב הונא בר נחמן והונא מר בר נחמן. רב פפא נשק ראשו ונתן לו בתו, הוריות (י\"ב ב'). ורב הונא בר חיננא חולין (מ\"ט ב') וע\"ש ופליגי על רבא. וא\"ל מר זוטרא ברב נחמן. מר הונא בריה דרב נחמן אמר לרב אשי ב\"מ (מ\"ז א'):","textSha256":"fea597f7a4609a87d4c14bd34eac2e4aedd992c1b6aad8792ce462cbdb1031de","notes":[],"holds":[]}]}],"translations":[{"language":"en","label":"English translation","path":"translations/en/991.json","sha256":"2efb39461ac55fc643c8341d8ddf9c5404367550bbc3996a5a53644b463620bc","sourceTextSha256":"fea597f7a4609a87d4c14bd34eac2e4aedd992c1b6aad8792ce462cbdb1031de"}],"apparatus":{"path":"apparatus/991.json","sha256":"9c8788a0ebaaa910e9e67846e2a66fee65ddab9b5fbb5acb3cfe129aa0316edc"},"holdCount":0,"qualificationCount":0,"researchHoldCount":2,"research":{"path":"research/991.json","sha256":"bc61c3a481bf02e8da7c71e1d4f6b94eb8d4d9ed32d3e75bd657c1fcefa8bda7"}}
