{"schemaVersion":1,"id":"186","chapter":186,"name":"רבין בר אבא","letter":"ר","editionVersion":"v0014","witnesses":[{"sourceKind":"sefaria_digital_warsaw","sourceLabel":"Hebrew · Warsaw digital witness","sourceUrl":"https://www.sefaria.org/Seder_HaDorot,_Tanaim_and_Amoraim.186","versionTitle":"Warsaw, 1878–1882 (saved digital metadata)","transcriptionStatus":"frozen_digital_witness_not_scan_collated","translationTextSha256":"fe70a6d5fd493accf7eadcd9ffa9dab37566a04525019b3cc495b18b67b3ee1a","text":"רבין בר אבא ואמרי לה ר' אבין בר שבא. משעלו ר' חייא ובניו מבבל לא\"י פסקו הזיקין והזועות ורוחות ורעמים ולא החמיץ יינם ולא לקה פשתנם חולין (פ\"ו א'):","paragraphs":[{"id":"heilprin:sefaria-warsaw:ta:186:1","number":1,"ref":"Seder HaDorot, Tanaim and Amoraim 186:1","text":"רבין בר אבא ואמרי לה ר' אבין בר שבא. משעלו ר' חייא ובניו מבבל לא\"י פסקו הזיקין והזועות ורוחות ורעמים ולא החמיץ יינם ולא לקה פשתנם חולין (פ\"ו א'):","textSha256":"fe70a6d5fd493accf7eadcd9ffa9dab37566a04525019b3cc495b18b67b3ee1a","notes":["The cessation of natural disturbances, unsoured wine and undamaged flax are reported traditions; source scope and pronouns are retained."],"holds":[]}]}],"translations":[{"language":"en","label":"English translation","path":"translations/en/186.json","sha256":"929d526d9a12a8cb2d6764f392cc3ad7370fe5f1471df34bfce3a63a88a69b95","sourceTextSha256":"fe70a6d5fd493accf7eadcd9ffa9dab37566a04525019b3cc495b18b67b3ee1a"}],"apparatus":{"path":"apparatus/186.json","sha256":"ff3ccd3ba335d79a335f5fef5ec53459d5e642dafd3cd7f0932fb4cc9f74ab9a"},"holdCount":0,"qualificationCount":0,"researchHoldCount":0,"research":{"path":"research/186.json","sha256":"2d495a4f2037b150e089e091b4bfa158d9eef5aa61ee0356a0a40de602ebbb08"}}
