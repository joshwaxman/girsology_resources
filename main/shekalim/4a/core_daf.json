  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ואלו שחייבין בקלבון לוים וישראלים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגרים ועבדים משוחררים אבל לא כהנים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונשים ועבדים וקטנים השוקל על יד כהן על",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יד האשה על יד עבד על יד קטן פטור ואם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקל על ידו ועל יד חבירו חייב בקלבון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד ורבי מאיר אומר שני קולבנות הנותן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סלע ונוטל שקל חייב שני קולבנות השוקל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על יד עני ועל יד שכינו ועל יד בן עירו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פטור ואם הלוון חייב האחין השותפין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחייבין בקלבון פטורין ממעשר בהמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכשחייבין במעשר בהמה פטורין מן הקלבון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכמה הוא קלבון מעה כסף דברי רבי מאיר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחכמים אומרים חצי מעה <b>גמ׳</b> אף על פי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאמרו כו׳ הא לתבוע אין תובעין הכא את",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר תובעין והכא את אמר אין תובעין כאן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשהביא שתי שערות וכאן בשלא הביא שתי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שערות הנכרי והכותי כו׳ אמר רבי בא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תיפתר כמאן דאמר כותי כנכרי דאתפלגין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כותי כנכרי דברי רבי רבן שמעון בן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גמליאל אומר כותי כישראל לכל דבר אמר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי לעזר מתניתין בנכרים הא בכותים לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותני כן אדם לרבות את הגרים מכם להוציא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את המומרים מתניתין פליגי על רבי אלעזר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין מקבלין מידם קני זבין וזבות קני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יולדות וכי יש קני זבין וזבות בנכרים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא רישא בנכרים וסיפא בכותים כן הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רישא בנכרים וסיפא בכותים אמר רבי יוחנן",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתחלה אין מקבלים מהן לא דבר מסוים ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר שאינו מסוים ובסוף מקבלין מהן דבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאינו מסוים ואין מקבלין מהן דבר מסוים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמעון בן לקיש אמר בין בתחילה בין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בסוף אין מקבלין מהן לא דבר מסוים ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר שאינו מסוים מתניתא פליגי על רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן אין מקבלין מהן הקדש ונדבה לבדק",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית פתר לה בין בתחלה בין בסוף ובלבד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר מסוים רבי שמעון בן לקיש אמר בין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתחלה ובין בסוף אין מקבלין מהם לא דבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסוים וכו׳ מתניתא פליגי על רבי שמעון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן לקיש דתני הכל שוין שהן נודרין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונידרין פתר לה עולה ניחא נודרין עולה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נידרין עולה (לא) אלא כשאמר ישראל הרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עלי עולה ושמע נכרי ואמר מה שאמר זה עלי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואינו מביא עמו נסכים ומותר נסכים לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לכלי שרת אינון נמצא מביא דבר מסויים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התיב רבי יוסי בר רבי בון והא תנינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נערכין ועורכין לא לבדק הבית אינון היך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מה דאת אמר תמן לשמים הוא מתכוין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומאיליהן הן באין לבדק הבית כן את אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אף הכא לשמים הוא מתכוין",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מתני' <b>קיני זבין וזבות.</b> תורים ובני יונה שזבין וזבות מביאין ובכותים איירי אבל בעכו\"ם אין זבין וזבות: <b>כל שהוא נידר</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ונידב מקבלין מידן.</b> דכתיב איש איש לרבות עכו\"ם שנודרים נדרים ונדבות כישראל: <b>וכן מפורש על ידי עזרא.</b> כשרצו הכותים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לסייען ושלחו להם נבנה עמכם כי ככם נדרוש לאלקיכם השיבו להם לא לכם ולנו לבנות בית בשותפות לאלקינו ולכם אין חלק",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צדקה וזכרון בירושלים: <b>קולבון.</b> כלומר דבר קל ומועט שמוסיפים על מחצית השקל כשרוצין ליקח מן השלחני ב' חצאי שקלים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעד שקל שלם: <b>השוקל ע\"י אשה</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו' פטור.</b> כגון שהלוה להם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון דפטורין הן לא מחייבו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקלבון ואי לא הלוה להם אלא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שפורע בשבילם אפי' שוקל בשביל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בר חיובא פטור מן הקלבון",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדלקמן: <b>ואם שקל על ידו וע\"י</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חבירו.</b> בשהלוהו איירי ושוקל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקל שלם מחצית השקל בשבילו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומחצית השקל שמלוה לחבירו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב קולבון אחד דסבר הנותן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחצית השקל הקצוב בתורה פטור",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הקלבון וב' ששקלו שקל שלם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין נותנין אלא קלבון אחד:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רבי מאיר אומר שני קלבונות.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דסובר ר\"מ השוקל מחצית השקל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב בקלבון הלכך שנים ששקלו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקל שלם חייב ב' קלבונות:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הנותן סלע.</b> דהיינו שקל שלם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשלחני של הקדש ונוטל ממנו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחציתו ושקל האמור כאן היינו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחצית השקל: <b>נותן ב' קלבונות.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש בגמ': גמ' <b>הא לתבוע אין</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תובעין.</b> מדקתני אם שקלו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקבלין מידן משמע אם שקלו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעצמן מקבלין אבל אין תובעין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהן וקשיא הכא אמרינן שאין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תובעין וברישא תנן אין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממשכנין נשים ועבדים וקטנים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשמע אבל תובעין מיהת: <b>כאן.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רישא איירי בקטן שהביא שתי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שערות ותובעין וסיפא בקטן שלא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הביא שתי שערות דאפי' תובעין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי לא: <b>תיפתר.</b> תפרש דמתני'",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אתיא כמ\"ד דכותי כעכו\"ם לפיכך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין מקבלין ממנו: <b>דאיתפלגון.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפליגי: מתני' בעכו\"ם. דוקא",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא דאין מקבלין מידן אבל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכותיים מקבלין: <b>ותני כן.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותניא נמי הכי: <b>אדם.</b> כי יקריב",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכם קרבן ודרשינן אדם לרבות",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את הגרים וקשיא למה לי קרא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תיפוק ליה דלא גרע מעכו\"ם",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאיתרבו מאיש איש שנודרים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נדרים ונדבות אלא לאשמועינן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא דכתיב מכם למעט מומרים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דוקא מומרים מישראל אבל מגרים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפי' ממומרים מקבלין והכי",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמר מכם בכם חילקתי אבל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגרים לא ואי לא כתיב אדם ה\"א",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכם חילקתי ולא באומות כדאיתא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרק קמא דחולין והשתא מכותים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אף על פי שחזרו לסורם מקבלין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהן. וא\"ת הא אדם גבי נדבה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב וע\"כ לומר דשקלים לנדבה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמיין אם כן למה אין מקבלין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעכו\"ם דהא כתיב איש איש י\"ל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכתיב גבייהו דבר אל בני ישראל ויקחו לי תרומה: ופריך <b>מתני' פליגא וכו'.</b> כלומר",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סיפא דמתני' קשיא לר\"א: <b>וכי יש קיני זבים בעכו\"ם.</b> הא בני ישראל כתיבי בפרשה אלא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ודאי דסיפא בכותים שהיו גרים וכיון שחזרו לסורם קא משמע לן דאין מקבלין מהן וקשיא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רישא בעכו\"ם וסיפא בכותים: <b>ומשני והא כיני.</b> כלומר יהי כן רישא בעכו\"ם וסיפא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בכותים: <b>בתחלה.</b> בתחלת הבנין אין מקבלין מהן שום דבר דשמא לרפיון המלאכה מתכוונים:",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ובסוף.</b> לחזק את בדקיו: <b>ה\"ג מקבלין מהן דבר שאינו מסויים ואין מקבלין מהם דבר</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מסוים.</b> וה\"פ דבר שאינו מסויים כגון מים ומלח ודבר מסויים דבר שנראה בעין אין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקבלין מהן דגנאי הוא ועוד שמתפארים בו: <b>הקדש נדבה לבדק הבית.</b> ולא מפליג בין תחלה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לסוף ובין דבר מסויים לשאינו מסויים: <b>ה\"ג ובלבד דבר מסוים.</b> וה\"פ ברייתא איירי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דוקא בדבר מסויים: מתני'. דפ\"ק דערכין קשיא על רשב\"ל: <b>הכל שוין וכו'.</b> ברישא תנן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עכו\"ם רמ\"א נערך אבל לא מעריך רי\"א מעריך אבל לא נערך זה וזה מודים שנודרין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונידרין ונודרין היינו דמי פלוני עלי ונידרין דמי עצמו עלי או שאמרו אחרים דמי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פלוני עלי והכל לבדק הבית שמעינן דמקבלין מהן: <b>ומשני פתר לה.</b> הא דנודרין ונידרין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היינו עולות אבל לבדק הבית לא: ופריך <b>הניחא נודרין.</b> איכא לאוקמי בעולה אלא נידרין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ליכא למימר בעולה דאם הישראל מדירו שיתן עולה מי ישמע לו העכו\"ם: <b>ומשני לא בשאמר</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הישראל וכו'.</b> וה\"ז כאלו הישראל מדירו שהרי ע\"י נדר. הישראל הוא מתחייב: ופריך",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואינו מביא.</b> העכו\"ם עם העולה נסכים בתמי' וכיון שצריך להביא נסכים אי אפשר שלא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יהי' מותר ותנן לקמן מותר הנסכים לכלי שרת: <b>ומשני נמצא מביא דבר מסויים.</b> כלומ'",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וליטעמך הא אף לר' יוחנן קשיא הרי מביא דבר מסויים דכלי שרת דבר מסויים הן: <b>התיב</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ר\"י בר' בון.</b> לתרוצי לרבי יוחנן: <b>וערכין לא לבדק הבית אינון.</b> בתמיה ותיקשי לך",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מתני' גופא: <b>היך מה וכו'.</b> ע\"כ לומר דהתם לא מיקרי דבר מסויים כיון דלבו לשמים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר לגבוה ואנן לבדק הבית יהבינן ליה ה\"נ במותר הנסכים כיון שהוא נותנן להקריבן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לגבוה וממילא ניתותרו ויהבינן להו לבדק הבית לא מיקרי דבר מסויים: <b>מה עבד לה</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>רשב\"ל.</b> דערכין ומותר נסכים לדבר שאינו מסויים מיהא דמיין דקאסר רשב\"ל: <b>נבנות בית</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וגו'.</b> דדוקא אבנין הבית קפיד קרא אבל אכלי שרת וה\"ה שאר צרכי הבית לא קפיד קרא:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מעתה.</b> דקאמרת כיון דכתיב לבנות בית אבנין הבית קפיד קרא א\"כ ה\"ה לצרכי ירושלים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אין מקבלין מהן כדכתיב שאין להם חלק בירושלים:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
