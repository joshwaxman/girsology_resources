  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ואלו שחייבין בקלבון לוים וישראלים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגרים ועבדים משוחררים אבל לא כהנים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונשים ועבדים וקטנים השוקל על יד כהן על",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יד האשה על יד עבד על יד קטן פטור ואם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקל על ידו ועל יד חבירו חייב בקלבון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד ורבי מאיר אומר שני קולבנות הנותן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סלע ונוטל שקל חייב שני קולבנות השוקל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על יד עני ועל יד שכינו ועל יד בן עירו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פטור ואם הלוון חייב האחין השותפין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחייבין בקלבון פטורין ממעשר בהמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכשחייבין במעשר בהמה פטורין מן הקלבון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכמה הוא קלבון מעה כסף דברי רבי מאיר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחכמים אומרים חצי מעה <b>גמ׳</b> אף על פי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאמרו כו׳ הא לתבוע אין תובעין הכא את",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר תובעין והכא את אמר אין תובעין כאן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשהביא שתי שערות וכאן בשלא הביא שתי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שערות הנכרי והכותי כו׳ אמר רבי בא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תיפתר כמאן דאמר כותי כנכרי דאתפלגין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כותי כנכרי דברי רבי רבן שמעון בן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גמליאל אומר כותי כישראל לכל דבר אמר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי לעזר מתניתין בנכרים הא בכותים לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותני כן אדם לרבות את הגרים מכם להוציא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את המומרים מתניתין פליגי על רבי אלעזר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין מקבלין מידם קני זבין וזבות קני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יולדות וכי יש קני זבין וזבות בנכרים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא רישא בנכרים וסיפא בכותים כן הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רישא בנכרים וסיפא בכותים אמר רבי יוחנן",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתחלה אין מקבלים מהן לא דבר מסוים ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר שאינו מסוים ובסוף מקבלין מהן דבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאינו מסוים ואין מקבלין מהן דבר מסוים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמעון בן לקיש אמר בין בתחילה בין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בסוף אין מקבלין מהן לא דבר מסוים ולא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר שאינו מסוים מתניתא פליגי על רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן אין מקבלין מהן הקדש ונדבה לבדק",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית פתר לה בין בתחלה בין בסוף ובלבד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר מסוים רבי שמעון בן לקיש אמר בין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתחלה ובין בסוף אין מקבלין מהם לא דבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסוים וכו׳ מתניתא פליגי על רבי שמעון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן לקיש דתני הכל שוין שהן נודרין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונידרין פתר לה עולה ניחא נודרין עולה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נידרין עולה (לא) אלא כשאמר ישראל הרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עלי עולה ושמע נכרי ואמר מה שאמר זה עלי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואינו מביא עמו נסכים ומותר נסכים לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לכלי שרת אינון נמצא מביא דבר מסויים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התיב רבי יוסי בר רבי בון והא תנינן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נערכין ועורכין לא לבדק הבית אינון היך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מה דאת אמר תמן לשמים הוא מתכוין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומאיליהן הן באין לבדק הבית כן את אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אף הכא לשמים הוא מתכוין",
      "segment_ids": [
        4
      ]
    }
  ],
