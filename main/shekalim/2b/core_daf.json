  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אל כולה כאחת היא באה ולמה אמרו בשלשה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרקים כדי לעשות פומבי לדבר רבי יהודה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר פזי בשם רבי הן נקרא ולא נבעת לטובה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל נדיב לב לרעה ויתפרקו כל העם וגומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לטובה ויוצא משה את העם לרעה ותקרבון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלי כלכם לטובה אז ישיר משה ובני ישראל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרעה ותשא כל העדה וגו׳ אמר רבי חייא בר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבא אכן השכימו השחיתו וכל השחתה שהיו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושין בהשכמה היו עושין אותה אמר רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבא בר אחא אין את יכול לעמוד על אופיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של אומה זו נתבעין לעגל ונותנין נתבעין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למשכן ונותנין תנא רבי יוסי בר חנינא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדא מתניתא ועשית כפורת זהב טהור יבא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב של כפורת ויכפר על זהב של עגל רבי",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חגי בשם רבי שמואל בר נחמן שלש תרומות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאמרו בפרשה זאת תרומת אדנים ותרומת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקלים ותרומת המשכן דבר אל בני ישראל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויקחו לי תרומה וגו׳ זו תרומת אדנים מאת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל איש אשר ידבנו לבו תקחו את תרומתי זו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תרומת שקלים וזאת התרומה אשר תקחו מאתם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זו תרומת המשכן תרומת המשכן למשכן מה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שירצו יעשו תרומת שקלים לקרבן מה שירצו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יעשו כדי שיהא יד כולן שוה תרומת אדנים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאדנים העשיר לא ירבה והדל לא ימעיט אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אבון אף בפרשה הזאת נאמר בה שלש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תרומות מחצית השקל תרומה לה׳ יתן תרומת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ה׳ לתת את תרומת ה׳ בטו בו קורין את",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המגילה בכרכים לא כן אמר רבי חלבו רב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הונא רב בשם רבי חייא רבה הכל יוצאין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בארבעה עשר שהוא זמן קריאתה לא בא אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ללמדך שכל המצות הנוהגות באדר שני אינן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוהגות באדר ראשון רבי יוסה ורבי אחא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוון יתבין אמר רבי יוסה לרבי אחא לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסתברא אלא לשעבר אבל לבא לא והא תני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקום שנהגו לקרותה שני ימים קורין אותה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שני ימים אמר ליה אוף אנא סבר כן אמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי מנא ויאות אילו משקרייא בארבעה עשר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוזר וקרייא בחמישה עשר שמא אין שומעין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו אם את אומר כן נמצאת עוקר זמן כרכים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בידך תני רבן שמעון בן גמליאל אומר",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מצוות הנוהגות באדר שני אינן נוהגות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בראשון חוץ מהספד ותענית שהן שווין בזה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובזה רבי בא רבי ירמיה בשם רב רבי סימון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי יהושע בן לוי הלכה כרבן שמעון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן גמליאל רב הונא רבה דצפורין אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנהיג רבי חנינא בציפורין כהדא דרבן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעון בן גמליאל לא אמר אלא הנהיג (אבל)",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הא להלכה לא אבל לענין שטרות כותבין אדר",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשון ואדר שני סתם רבי יוסי אומר אדר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשון",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הן נקרא ולא נבהת.</b> איך אפשר לקרות פסוקים אלו בלא בעיתה ורעדה: <b>לטובה.</b> לנדבת משכן לא הביאו כולם אלא כל נדיב לב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הביאו: <b>לרעה.</b> במעשה עגל כתיב ויתפרקו כל העם: <b>לטובה.</b> במתן תורה כתיב ויוצא משה את העם ולא יצאו מעצמן: <b>לרעה.</b> בשילוח",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מרגלים ותקרבון אלי מעצמן: <b>אז ישיר משה.</b> וע\"י התעוררת משה השירו גם בני ישראל: <b>לרעה.</b> בביאת מרגלים ותשא כל העדה אתי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קולם מעצמם: <b>אכן השכימו השחיתו.</b> כלומר גם הנביא צפניה הוכיחן כיוצא בזה השחתה עשו בהשכמה והטוב לא עשו בהשכמה שגבי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עגל כתיב וישכימו ממחרת וגבי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נדבת המשכן כתיב והם הביאו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אליו עוד נדבה בבקר בבקר ולא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהשכמה ממש: <b>אופיא.</b> דעתם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומנהגם של אומה זו: <b>נתבעין</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לעגל.</b> כשתבעו מהם זהב לעגל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתנו וכשתבעו למשכן נתנו: <b>הדא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתניתא.</b> פליגא על ר' בא דלכך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתנו למשכן כדי לכפר על מעשה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עגל: <b>בפרשה זאת.</b> היא פרשת",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויקחו לי תרומה: <b>מה שירצו</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יעשו.</b> לצרכי המשכן יהיה לאיזה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צורך שיהיה וגם כמה שהיו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רוצים היו יכולים ליתן: <b>מה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שירצו יעשו.</b> לאיזה קרבן שהיו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריכין וכן מבקרין מומין היו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לוקחין שכרן מתרומת הלשכה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכמה שהיו רוצים היו יכולים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליתן ובלבד שיהא יד כולם שוה:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תרומת אדנים לאדנים.</b> דוקא ולא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשאר דברים: <b>אף בפרשה הזאת.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיא פרשת כי תשא: <b>הכל יוצאין</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בי\"ד.</b> אפילו כרכים שהוא עיקר",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זמן קריאתה והא דתנן כרכים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קורין בט\"ו היינו אם רצו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משא\"כ עיירות אסורים לקרות",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בט\"ו דכתיב ולא יעבור: <b>לא בא</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אלא ללמדך כו'.</b> כלומר ולא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תיקשי לך א\"כ דהכל יוצאין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בי\"ד בזמניהם ל\"ל דבבבלי ריש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מגילה אמרינן בזמניהם בא ללמד",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שזמנו של זה לא כזמנו של זה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקאמר הש\"ס דלר' חלבו בא ללמד",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיכול לקרות' באחד מהזמנים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באדר ראשון או בשני ובמגילה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פ\"ק הגירסא לא בא אלא ללמדך",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהמצות נוהגות בשני ואיכא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפרושי דה\"ק בזמניהם אתי ללמד",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא יקראו אלא בזמנם דהיינו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באדר שני והא ודאי דלר' חלבו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קשיא מתני' דתני בט\"ו קורין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את המגינה בכרכים דמשמע מינה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחיובא הוא שיקראו דוקא בט\"ו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א\"נ הכי קשיא ליה דבמתני'",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משמע שאין קורין אלא באדר שני",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דומיא דאינך: <b>הוון יתיבין.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוה קשיא להו מתני' לר'",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חלבו: <b>ה\"ג לא מסתברא אלא</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לשעברי אבל להבא לא.</b> וה\"פ הא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דר\"ח אינו אלא לשעבר אם קרא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכרכים בי\"ד שיצא אבל לכתחלה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך לקרות בט\"ו ומתניתין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איירי בלכתחלה: ופריך <b>והא תני</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מקום שנהגו לקרות שני ימים.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו במקום שמסופקים אם הוא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרך או כפר ואס\"ד שהכל יוצאין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בי\"ד למה קורין שני ימים: <b>א\"ל</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אף אנא סובר כן.</b> שאינו יוצא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בי\"ד: <b>ויאות.</b> בתמיה וכי שפיר קפריך דקאמר שאף הוא סובר כן. ל\"א ויאות וספיר קאר\"ח",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולא קשיא מהך ברייתא: <b>שמא אין שומעין לו.</b> וכי מוחין בידו: <b>אם אומר את כן.</b> שעיר",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהיא ספק כרך אם קראו בי\"ד שאסורין לקרות בט\"ו עקרת זמן הכרכים בידיך ולא ידענו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא ספק ובטלת תקנת חכמים שאמרו שהכרכים יקראו בט\"ו לחלוק כבוד לא\"י וכין שאין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מוחין בידן לא קשיא לר' חלבו דלכך קורין שני ימים אע\"פ שיצאו בקריאת י\"ד כיון דלא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אפשר: <b>מצות הנוהגות באדר שני.</b> כגון סדר פרשיות ומקרא מגילה ומתנות לאביונים: <b>שהן</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שוין בזה ובזה.</b> שבי\"ד ובט\"ו שבראשון נמי אסור בהספד ובתענית. לא אמר אלא הנהיג.",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבל אין מורין כן: <b>כותבין אדר הראשון ואדר השני.</b> כלומר ולא אמרינן דאדר ראשון שבט",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיקרי אלא שניהן הן אדר וכותבין בשטרות אדר. אלא שבאדר שני כותבין אדר תניין:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כותבין תי\"י.</b> שהיא ראשי תיבות תניין וסגי בזה:",
      "gemara_segment_ids": [
        5
      ]
    }
  ],
  "tosafot": [],
  "reserved_columns": [
    {
      "role": "tiklin_chadtin",
      "state": "added",
      "label_he": "פני משה",
      "label_en": "Penei Moshe",
      "side": "left",
