        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ליה.</b> כלומר את\"ל דשלימה שחרית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושלימה בין הערבים: <b>ג' לוגין</b>",
