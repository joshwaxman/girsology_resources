  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בר בא ולא יאות הוא מקשה אתא רבי יעקב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר אחא רבי אבהו בשם רבי יוחנן דבר תורה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא שתהא באה מן הצבור הייתי אומר יגבו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לה (מן היורשין) התקינו שתהא באה מתרומת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלשכה רבי יוסה אמר רבי יוחנן בעי מהו",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלימה בשחרית ושלימה בין הערבים או",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלימה בשחרית ובטילה בין הערבים כד תהא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פשיטא ליה דכתיב מנחת תמיד שלשת לוגין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מה הן שלשת לוגין שחרית ושלשת לוגין בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הערבים או לוג ומחצה שחרית ולוג ומחצה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין הערבים אמר רבי חזקיה אוף הדא צריכה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה שני קומצין מה הן שני קומצין בשחרית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושני קומצין בין הערבים או קומץ אחת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשחרית וקומץ אחת בין הערבים אמר רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסה כלום למדו לקומץ לא ממנחת חוטא מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להלן שני קומצין אף כאן שני קומצין (מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמן צריכה ליה אף הכא צריכה ליה) אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חזקיה כלום למדו שלשת לוגין לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתמיד של בין הערבים מה להלן שלשת לוגין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אף כאן שלשת לוגין ומה תמן צריכה ליה אף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאן צריכה ליה שלא יהיה כו׳ רבי שמעון",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר נחמן בשם רבי יונתן בדין היה שימעלו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בה והן גזרו שלא ימעלו בה והא תני חטאת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלמד שמועלין בה בה מועלין ואין מועלין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באפרה אמר רבי אבהו בראשונה היו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משתקשקין בה ונותנין אותה על גבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכותיהן וגזרו שימעלו בה כיון שנגדרו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גזרו שלא ימעלו בה ועל הקינין כו׳ האשה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הזאת במה היא מתכפרת אמר רבי יצחק תנאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית דין הוא המספק את הקינין הוא מספק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הפסולות ואת האובדות הדרן עלך פרק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעות שנמצאו <b>הלכה א <big>מתני׳</big></b> כל הרוקין",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנמצאין בירושלים טהורין, חוץ משל שוק",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העליון, דברי רבי מאיר. רבי יוסי אומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשאר כל ימות השנה שבאמצע טמאין שבצדדין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טהורין ובשעת הרגל שבאמצע טהורין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבצדדין טמאין מפני שהמעוטין מסתלקין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לצדדין כל הכלים הנמצאין בירושלם דרך",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירידה לבית הטבילה טמאין ודרך עליה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טהורין שלא כירידתן עלייתן דברי רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאיר רבי יוסי אומר כולן טהורין חוץ מן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הסל והמגריפה והמריצה המיוחדין לקברות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "סכין שנמצאת בארבעה עשר שוחט בה מיד בשלשה עשר שונה ומטביל קופיץ בזה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ובזה שונה ומטביל חל ארבעה עשר להיות בשבת שוחט בה מיד",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
