      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחרית ושלימה בין הערבים: <b>ה\"ג</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ושלימה בין הערבים או שלימה</b>",
      "gemara_segment_ids": [
