      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מה הן.</b> דלעשירית האיפה היה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכה\"ג מביא ג' לוגין וקמיבעיא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה כשמת כה\"ג והיתה המנחה",
