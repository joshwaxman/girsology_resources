        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כהן גדול מביא ב' קומצין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבונה ומקריב אחד מהן בשחרית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואחד בין הערבים ואמר רבי",
      "gemara_segment_ids": [
