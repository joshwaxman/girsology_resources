      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלימה בשחרית ושלימה בין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הערבים אם מביא כל פעם ב'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קומצין או דלמא בקומץ אחד",
      "gemara_segment_ids": [
