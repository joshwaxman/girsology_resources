  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ומביא קטורת ומחלל עליהן ונותנים אותה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאומנין בשכרן אותן המעות מה יעשה בהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אומר אומר אני ינתנו לבית גרמו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולבית אבטינס שהיו בקיאין בפיטום הקטורת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובמעשה לחם הפנים אמר רבי שמואל בר רב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצחק והן שיהו חייבין להן מעות משעה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשונה רבי חייה בר בא בעי לא היו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייבין להן מעות משעה הראשונה אתא רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בא בשם רבי חייה בשם רבי יוסי מקייצין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהן את המזבח רבי בא בר כהן בעי קומי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסה מחלפא שיטתיה דרבי חייא בר בא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמן צריכה ליה וכה פשיטא ליה הא דצריכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה בכלי שרת הא דפשיטא ליה בקיץ למזבח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאיתפלגון פיטמה בחולין רבי יוסי בי רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנינה אמר פסולה רבי יהושע בן לוי אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשירה מה טעמא דרבי יוסי בי רבי חנינה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודש היא שתהא הווייתה בקודש מה טעמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבי יהושע בן לוי קודש היא שתהא באה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתרומת הלשכה אמר רבי יוסי בי רבי בון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אתיא דרבי יוסי בן חנינה כשמואל ודרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע בן לוי כרבי יוחנן דתנינן המקדיש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נכסיו והיו בהן דברים ראוין לקרבנות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צבור רבי יוחנן אמר קטורת אמר רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הושעיה תיפתר באומן משל בית אבטינס שהיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוטל בשכרו קטורת ודרבי יוסי בי רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנינה כשמואל דאמר רב הונא בשם שמואל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכתשת עשו אותה ככלי שרת לקדש אמר רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי בי רבי בון אמרה רבי חונא קומי רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי דבר שקדש בכלי שרת נפדה אמר ליה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא דשמואל היא דשמואל אמר קל הוא במותר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאיתפלגון הותירו תמימים שמואל אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נפדין כתמימים ורבי יוחנן אמר נפדין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כפסולי המוקדשים הותירו שעירים על דעתיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דשמואל אם עולה נפדית לא כל שכן חטאת על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעתיה דרבי יוחנן אמר רבי זעירא ירעו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי שמואל בר רב יצחק מקייצין בהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את המזבח וקשיא יש חטאת שקריבה עולה אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסה שנייא היא שאין קרבנות צבור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נקבעין אלא בשחיטה אמר רבי חייא תנאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית דין הוא על המותר שיקרבו עולות",
      "segment_ids": [
        1
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' <b>ולא נמצא הקדש מתחלל</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עלהקדש.</b> דקס\"ד דמחללין על שכר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האומנין שעשו מלאכת הקדש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואותן מעות נמי קדש הן. ל\"א",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"ג לא נמצא ההקדש מתחלל על",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המלאכה וכ\"ה בתוספתא דמעילה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"פ כיון שאין בה ממש אין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחללין עליה: <b>על הבניין.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקי\"ל בונין בחול ואחר כך",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקדישין וכשקינין מן האומנין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותנין להן בעד הבניין ובעד",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השבח יחד: <b>אותן המעות.</b> שחיללו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו הקטרת והיה בראשונה לצורך",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האומנין מה יעשו בהן: <b>ינתנו</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לבית גרמו וכו'.</b> שמקבלין שכרן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתרומת הלשכה: <b>והן וכו'.</b> והוא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהו חייבין להן לבית גרמו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעות משנה שעברה דאי משנה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבאה אף שכרן באה מתרומה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חדשה: <b>בעי.</b> שאל אם לא היו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכו' מה יעשו במעות הראשונות:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תמן צריכא ליה.</b> מעיקרא מיבעיא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה והשתא פשיטא ליה דר' בא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשם ר' חייא בר בא אמר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למילתייהו: <b>ומשני הן צריכא</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ליה.</b> הא דקמבעיא ליה אם הן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באין לכלי שרת כשירי הלשכה או",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהוו להו כמותר תרומת הלשכה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל לקיץ המזבח ודאי באין דאף",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר תרומת הלשכה לקיץ המזבח",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באה: <b>דאיתפלגון.</b> דפליגי ר\"י",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ב\"ח ור\"י ב\"ל: <b>פיטמה.</b> לקטורת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלי חול: <b>קדש היא.</b> קדש תהיה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכם: <b>שתהא הווייתה בקדש.</b> שכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשיה לא יהיו אלא בקדש: <b>שתהא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>באה מתרומת הלשכה.</b> אבל א\"צ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעשותה בקודש: <b>דתנינן.</b> בסיפא:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המקדיש נכסיו.</b> וקי\"ל סתם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקדשות לבדק הבית: <b>והיו בהן</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דברים ראוין לקרבנות ציבור.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכל המקדיש דבר הראוי למזבח",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אינו יוצא מידי מזבח לעולם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והראוי לקרבן יחיד מוכרין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו ליחיד והראוי לקרבן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ציבור שאי אפשר להקריבו. כך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דצריך לקנות מקופת הלשכה הלכך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נותנין אותן לאומנין בשכרן: <b>רבי יוחנן אמר.</b> הא דתנן והיו בהן דברים ראוין לקרבנות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ציבור היינו קטורת דאי בהמה הא תני לה בסיפא והיא ראויה ליחיד כמו לציבור ואי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יינות ושמנים וסלתות הא תני להו אלא קטרת דאינה ראויה אלא לציבור אלמא עושין קטרת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מחולין ובחוץ וקשיא לר\"י ב\"ח: <b>באומן של בית אבטינס.</b> שהיה נוטל בשכרו מותר הקטרת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שניתותר אלא שהיו לוקחין ממנו אח\"כ ולא הספיקו ליקח עד שהוקדשה ולעולם בקדש נעשית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכר\"י ב\"ח: <b>מכתשת.</b> ששחקו בה הקטרת היתה כלי שרת לקדש דכל מעשיה בקדש: <b>דבר שקדש</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בכלי שרת נפדה.</b> בתמיה ואנן תנן נותנין אותה לאומנין בשכרן: <b>א\"ל ולאו שמואל היא.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר מאן אמרה להך שמעתתא שמואל ושמואל הוא דאמר שהקילו במותר קדשים: <b>דאיתפלגון.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דפליגי שמואל ור\"י: <b>הותירו תמידין.</b> שלקחו ממעות ציבור מתרומת הלשכה דתנן בערכין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אין פוחתין מששה טלאים מבוקרין בלשכת הטלאים וכשמגיע ר\"ח ניסן לא היו מקריבין שוב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קרבנות ציבור ממעות התרומה של אשתקד שנאמר חדש בחדשו חדש והבא קרבנות מתרומה חדשה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונמצא בכל שנה ושנה ד' טלאים בלשכת הטלאים ממעות התרומה הישינה והיינו שהותירו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלא הוצרכו להקריבו בשנה שעברה: <b>שמואל אמר נפדין כתמימין.</b> להכשירן בשנה זו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומחללין אותן על מעות חולין ואותן המעות ילכו למותר התרומה הישינה וכיון שיצאו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לחולין חוזרין ולוקחין אותן מתרומה חדשה ויקרבו בשנה זה ואע\"ג שאין בהמת קדשי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יחיד מתחללת בלא מום כדקי\"ל מואם כל בהמה טמאה דאמר מר בבעלי מומין שנפדו הכתוב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מדבר אילו של ציבור נפדין דלב ב\"ד מתנה עליהן ובלא חולין אי אפשר לפדותן ממעות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תרומה חדשה שאין הקדש מתחלל על הקדש: <b>נפדין כפסולי המוקדשין.</b> וירעו עד שיסתאבו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וימכרו ויפלו דמיהן לנדבה דקדושת הגוף שבהן להיכן הלכה ואינן מתחללין בלא מום:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הותירו שעירים.</b> שקנו הציבור מתרומת הישנה כגון שעיר של ר\"ח אדר שנאבד ונמנא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בניסן: <b>אם עולה נפדית.</b> להקריבה עולה ואע\"ג שאם מניחין אותה לרעות עד שיסתאב נמי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמיה נופלין לקיץ המזבח להקריב עולה אפ\"ה נפדית להקריבה עצמה עולה: <b>לא כ\"ש חטאת.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאם מניחין אותה שאינה קריבה אלא עולה: <b>ר\"ז אומר ירעו.</b> השעירים כמו העולות:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מקייצין בהן.</b> בשעירים שנתותרו משנה לשנה את המזבח כשהמזבח בעל מקריבין אותן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לנדבות ציבור: <b>וקשיא יש חטאת קריבה עולה.</b> דשעירי הציבור חטאת הן וקיץ המזבח עולות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הן: <b>שנייא היא.</b> שאני קרבנות ציבור שאינן נקבעין לשם מה שיהיו אלא בשחיטתן וכל זמן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהן חיים רשות ביד ציבור לשנותן למה שירצו: <b>תנאי ב\"ד על המותרות.</b> אפי' חטאת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיקריבו עולות אבל שאר חטאות של צבור אין משתנין להיות עולות:",
      "gemara_segment_ids": [
        1
      ]
    }
  ],
