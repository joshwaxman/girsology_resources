  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ומביא קטורת ומחלל עליהן ונותנים אותה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאומנין בשכרן אותן המעות מה יעשה בהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אומר אומר אני ינתנו לבית גרמו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולבית אבטינס שהיו בקיאין בפיטום הקטורת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובמעשה לחם הפנים אמר רבי שמואל בר רב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצחק והן שיהו חייבין להן מעות משעה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשונה רבי חייה בר בא בעי לא היו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייבין להן מעות משעה הראשונה אתא רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בא בשם רבי חייה בשם רבי יוסי מקייצין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהן את המזבח רבי בא בר כהן בעי קומי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסה מחלפא שיטתיה דרבי חייא בר בא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמן צריכה ליה וכה פשיטא ליה הא דצריכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה בכלי שרת הא דפשיטא ליה בקיץ למזבח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאיתפלגון פיטמה בחולין רבי יוסי בי רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנינה אמר פסולה רבי יהושע בן לוי אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשירה מה טעמא דרבי יוסי בי רבי חנינה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודש היא שתהא הווייתה בקודש מה טעמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבי יהושע בן לוי קודש היא שתהא באה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתרומת הלשכה אמר רבי יוסי בי רבי בון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אתיא דרבי יוסי בן חנינה כשמואל ודרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע בן לוי כרבי יוחנן דתנינן המקדיש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נכסיו והיו בהן דברים ראוין לקרבנות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צבור רבי יוחנן אמר קטורת אמר רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הושעיה תיפתר באומן משל בית אבטינס שהיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוטל בשכרו קטורת ודרבי יוסי בי רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנינה כשמואל דאמר רב הונא בשם שמואל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכתשת עשו אותה ככלי שרת לקדש אמר רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יוסי בי רבי בון אמרה רבי חונא קומי רבי יוסי דבר שקדש בכלי שרת נפדה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אמר ליה ולא דשמואל היא דשמואל אמר קל הוא במותר דאיתפלגון הותירו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תמימים שמואל אמר נפדין כתמימים ורבי יוחנן אמר נפדין כפסולי המוקדשים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הותירו שעירים על דעתיה דשמואל אם עולה נפדית לא כל שכן חטאת על דעתיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "דרבי יוחנן אמר רבי זעירא ירעו אמר רבי שמואל בר רב יצחק מקייצין בהן את",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "המזבח וקשיא יש חטאת שקריבה עולה אמר רבי יוסה שנייא היא שאין קרבנות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "צבור נקבעין אלא בשחיטה אמר רבי חייא תנאי בית דין הוא על המותר שיקרבו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עולות",
      "segment_ids": [
        1
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' <b>ולא נמצא הקדש מתחלל</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עלהקדש.</b> דקס\"ד דמחללין על שכר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האומנין שעשו מלאכת הקדש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואותן מעות נמי קדש הן. ל\"א",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"ג לא נמצא ההקדש מתחלל על",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המלאכה וכ\"ה בתוספתא דמעילה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"פ כיון שאין בה ממש אין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחללין עליה: <b>על הבניין.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקי\"ל בונין בחול ואחר כך",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקדישין וכשקינין מן האומנין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותנין להן בעד הבניין ובעד",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השבח יחד: <b>אותן המעות.</b> שחיללו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו הקטרת והיה בראשונה לצורך",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האומנין מה יעשו בהן: <b>ינתנו</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לבית גרמו וכו'.</b> שמקבלין שכרן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתרומת הלשכה: <b>והן וכו'.</b> והוא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהו חייבין להן לבית גרמו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעות משנה שעברה דאי משנה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבאה אף שכרן באה מתרומה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חדשה: <b>בעי.</b> שאל אם לא היו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכו' מה יעשו במעות הראשונות:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תמן צריכא ליה.</b> מעיקרא מיבעיא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה והשתא פשיטא ליה דר' בא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשם ר' חייא בר בא אמר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למילתייהו: <b>ומשני הן צריכא</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ליה.</b> הא דקמבעיא ליה אם הן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באין לכלי שרת כשירי הלשכה או",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהוו להו כמותר תרומת הלשכה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל לקיץ המזבח ודאי באין דאף",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר תרומת הלשכה לקיץ המזבח",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באה: <b>דאיתפלגון.</b> דפליגי ר\"י",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ב\"ח ור\"י ב\"ל: <b>פיטמה.</b> לקטורת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכלי חול: <b>קדש היא.</b> קדש תהיה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכם: <b>שתהא הווייתה בקדש.</b> שכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשיה לא יהיו אלא בקדש: <b>שתהא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>באה מתרומת הלשכה.</b> אבל א\"צ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעשותה בקודש: <b>דתנינן.</b> בסיפא:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המקדיש נכסיו.</b> וקי\"ל סתם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקדשות לבדק הבית: <b>והיו בהן</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דברים ראוין לקרבנות ציבור.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכל המקדיש דבר הראוי למזבח",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אינו יוצא מידי מזבח לעולם והראוי לקרבן יחיד מוכרין אותו ליחיד והראוי לקרבן ציבור שאי אפשר להקריבו. כך דצריך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לקנות מקופת הלשכה הלכך נותנין אותן לאומנין בשכרן: <b>רבי יוחנן אמר.</b> הא דתנן והיו בהן דברים ראוין לקרבנות ציבור",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "היינו קטורת דאי בהמה הא תני לה בסיפא והיא ראויה ליחיד כמו לציבור ואי יינות ושמנים וסלתות הא תני להו אלא קטרת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דאינה ראויה אלא לציבור אלמא עושין קטרת מחולין ובחוץ וקשיא לר\"י ב\"ח: <b>באומן של בית אבטינס.</b> שהיה נוטל בשכרו מותר",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקטרת שניתותר אלא שהיו לוקחין ממנו אח\"כ ולא הספיקו ליקח עד שהוקדשה ולעולם בקדש נעשית וכר\"י ב\"ח: <b>מכתשת.</b> ששחקו בה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקטרת היתה כלי שרת לקדש דכל מעשיה בקדש: <b>דבר שקדש בכלי שרת נפדה.</b> בתמיה ואנן תנן נותנין אותה לאומנין בשכרן: <b>א\"ל</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ולאו שמואל היא.</b> כלומר מאן אמרה להך שמעתתא שמואל ושמואל הוא דאמר שהקילו במותר קדשים: <b>דאיתפלגון.</b> דפליגי שמואל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ור\"י: <b>הותירו תמידין.</b> שלקחו ממעות ציבור מתרומת הלשכה דתנן בערכין אין פוחתין מששה טלאים מבוקרין בלשכת הטלאים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וכשמגיע ר\"ח ניסן לא היו מקריבין שוב קרבנות ציבור ממעות התרומה של אשתקד שנאמר חדש בחדשו חדש והבא קרבנות מתרומה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חדשה ונמצא בכל שנה ושנה ד' טלאים בלשכת הטלאים ממעות התרומה הישינה והיינו שהותירו שלא הוצרכו להקריבו בשנה שעברה:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שמואל אמר נפדין כתמימין.</b> להכשירן בשנה זו ומחללין אותן על מעות חולין ואותן המעות ילכו למותר התרומה הישינה וכיון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שיצאו לחולין חוזרין ולוקחין אותן מתרומה חדשה ויקרבו בשנה זה ואע\"ג שאין בהמת קדשי יחיד מתחללת בלא מום כדקי\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מואם כל בהמה טמאה דאמר מר בבעלי מומין שנפדו הכתוב מדבר אילו של ציבור נפדין דלב ב\"ד מתנה עליהן ובלא חולין אי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אפשר לפדותן ממעות תרומה חדשה שאין הקדש מתחלל על הקדש: <b>נפדין כפסולי המוקדשין.</b> וירעו עד שיסתאבו וימכרו ויפלו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמיהן לנדבה דקדושת הגוף שבהן להיכן הלכה ואינן מתחללין בלא מום: <b>הותירו שעירים.</b> שקנו הציבור מתרומת הישנה כגון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שעיר של ר\"ח אדר שנאבד ונמנא בניסן: <b>אם עולה נפדית.</b> להקריבה עולה ואע\"ג שאם מניחין אותה לרעות עד שיסתאב נמי דמיה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נופלין לקיץ המזבח להקריב עולה אפ\"ה נפדית להקריבה עצמה עולה: <b>לא כ\"ש חטאת.</b> שאם מניחין אותה שאינה קריבה אלא עולה:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ר\"ז אומר ירעו.</b> השעירים כמו העולות: <b>מקייצין בהן.</b> בשעירים שנתותרו משנה לשנה את המזבח כשהמזבח בעל מקריבין אותן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לנדבות ציבור: <b>וקשיא יש חטאת קריבה עולה.</b> דשעירי הציבור חטאת הן וקיץ המזבח עולות הן: <b>שנייא היא.</b> שאני קרבנות ציבור",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאינן נקבעין לשם מה שיהיו אלא בשחיטתן וכל זמן שהן חיים רשות ביד ציבור לשנותן למה שירצו: <b>תנאי ב\"ד על המותרות.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אפי' חטאת שיקריבו עולות אבל שאר חטאות של צבור אין משתנין להיות עולות:",
      "gemara_segment_ids": [
        1
      ]
    }
  ],
