  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "חורי יהודה כן עלו לראש גגותיהן ונפלו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומתו הדא הוא דכתיב משא גיא חזיון מה לך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איפוא כי עלית כולך לגגות תשואות מלאה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עיר הומיה וגו׳ <b>הלכה ג <big>מתני׳</big></b> שלשה עשר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלחנות היו במקדש. שמונה של שייש בבית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המטבחיים, שעליהן מדיחין את הקרביים.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושנים במערב הכבש אחד של שייש ואחד של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כסף על של שייש נותנין את האברים ועל של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כסף כלי שרת ושנים באולם מבפנים על פתח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית אחד של שייש ואחד של זהב על של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שייש נותנין לחם הפנים בכניסתו ועל של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב ביציאתו שמעלין בקודש ולא מורידין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד של זהב מבפנים שעליו לחם הפנים תמיד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>גמ׳</b> תני על של כסף רבי יוסי בשם רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל בר רב יצחק רבי חנניה מטי בה בשם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוחנן לית כאן של כסף מפני שהוא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מרתיח לא כן תני זה אחד מן הנסים שנעשו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבית המקדש שכשם שהיו מניחין אותו חום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כך היו מוציאין אותו חום שנאמר לשום לחם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חם ביום הלקחו רבי יהושע בן לוי אמר אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מזכירין מעשה נסים בעון קומי רבי אילא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא היה שם לחם מהו להניחו לשבת הבאה אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לון כתיב ונתת על השולחן לחם פנים לפני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמיד לחם פנים אפילו פסול עשרה שלחנות",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשה שלמה דכתיב ויעש שולחנות עשרה וינח",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהיכל חמשה מימין וחמשה משמאל אין תימר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חמשה בדרום וחמשה בצפון והלא אין השלחן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשר אלא בצפון שנאמר ואת השלחן תתן על",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צלע צפון מה תלמוד לומר חמשה מימין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחמשה משמאל אלא חמשה מימין שלחנו של",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משה וחמשה משמאלו אף על פי כן לא היה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסדר אלא בשל משה בלבד שנאמר את השלחן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אשר עליו לחם הפנים רבי יוסי בי רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אומר על כולן היה מסדר שנאמר את",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השולחנות ועליהם לחם הפנים תני מזרח",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומערב היו נתונין דברי רבי רבי אלעזר בי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמעון אומר צפון ודרום היו נתונין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאן דאמר מזרח ומערב ניחא כולהן ראויין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשירות מאן דאמר צפון ודרום נמצא שלחן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדרום",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מתני' <b>על של שיש מניחין את האברים.</b> אחר הנתוח מסדרין אותן על השלחן עד שיעלום הכהנים ובגמרא מפרש למה לא עשאו של",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כסף או של זהב: <b>ועל של כסף.</b> כלי שרת שמוציאין בכל בוקר שלשה ותשעים כלי שרת כדתנן בתמיד: <b>נותנין לחם הפנים בכניסתו.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחר שנאפה עד שיסדרוהו על השלחן: <b>ועל של זהב ביציאתו.</b> והיה מונח שם עד זמן חילוק: <b>שמעלין בקדש ולא מורידין.</b> דכיון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שסלקוהו מעל השלחן של זהב אין מורידין אותו להניחו בשל כסף: גמ' <b>תני על של כסף.</b> אותן של אולם אחד היה של כסף ואחד",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של זהב על של כסף היו נותנין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכניסתו דאין עניות במקום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עשירות: <b>לית כאן של כסף.</b> לא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה באולם של כסף אלא כדתנן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתני' דשל כסף מרתיח ומתחמם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלח' ויש לחוש שיתעפש: ופריך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לא כן תני זה אחד מן הניסים</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> שהיה נשמר חום הלחם עד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעת סילוקו בשבת הבא א\"כ לא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה מתעפש אפי' היו מניחין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו על שלחן של כסף: <b>אין</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מזכירין מעשה ניסים.</b> כלומר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין סומכין על הנס ועושין הכל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא יתעפש בדרך הטבע: <b>לא היה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שם לחם.</b> לסדר בשבת ובתוך ימי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השבוע נזדמן להם מהו להניחם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלסדר עד שבת הבאה או דלמא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג שהוא פסול דכל שלא עברה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו שבעה ימים על השלחן פסול",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא מ\"מ לקיים מצות לחם הפנים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפני תמיד אין להניחו בלא לחם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א\"נ לא היה שם לחם לערוך ביום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השבת מהו להניח הלחם הראשון",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על השלחן שהרי לא יתקלקל גם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשבת הבאה מיהו פסול הוא משום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לינה: <b>לפני תמיד.</b> שיהו תמיד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפני ה' אע\"פ שהן פסולין:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עשרה שולחנות עשה שלמה.</b> דכתיב",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויעש שולחנות עשרה וגו': <b>אין</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תימר חמשה בדרום וכו'.</b> ומימין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו מימין הפתח ומשמאל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו משמאלו של פתח שהפתח",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היתה באמצע ההיכל בכותל מזרחי",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א\"נ מימין היינו דרום שנקרא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימין ומדרום נקרא ימין צפון",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקרא שמאל: <b>אלא.</b> של משה באמצע",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה' מימינו וחמשה משמאלו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכולן בצפון ההיכל: <b>את השלחן.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשון יחיד: <b>על כולם היה מסדר.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פעמים בזה ופעמים בזה: <b>מזרח</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומערב היו נתונין.</b> השולחנות",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראשו אחד למזרח ואחד למערב",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיינו אורכו לאורך הבית:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כולהון ראויין לשירות.</b> ואיכא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למימר על כולם היה מסדר: <b>נמצא</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלחן בדרום.</b> וה\"פ שלחן ארכו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ב' אמות הרי הוא עשרים אמה לעשרה שלחנות וההיכל כולו אינו אלא עשרים אם כן חמשה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלחנות בדרום: <b>ומנורה בצפון.</b> ל\"ג: <b>משוך מן הכותל בשתי אמות כלפי צפון.</b> שיהו שני",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כהנים הנושאים ב' סדרים הולכין זה בצד זה ותוס' גורסין משוך ב' אמות ומחצה: <b>באמצע</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הבית.</b> היינו באמצע ההיכל כשלא נחשב בית קדשי קדשים עמו ההיכל ארכו ארבעים ובית",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קדשי קדשים ארכו עשרים אמה והמזבח היה עומד בתחלת עשרים אמה של ההיכל המערביים:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>משליש הבית.</b> של צד מזרח: <b>ולפנים.</b> לצד מערב והיינו כשנחשב בית קדשי קדשים עמו:",
      "gemara_segment_ids": [
        3
      ]
    }
  ],
