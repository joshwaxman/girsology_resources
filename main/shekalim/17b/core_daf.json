  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "חורי יהודה כן עלו לראש גגותיהן ונפלו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומתו הדא הוא דכתיב משא גיא חזיון מה לך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איפוא כי עלית כולך לגגות תשואות מלאה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עיר הומיה וגו׳ <b>הלכה ג <big>מתני׳</big></b> שלשה עשר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלחנות היו במקדש. שמונה של שייש בבית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המטבחיים, שעליהן מדיחין את הקרביים.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושנים במערב הכבש אחד של שייש ואחד של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כסף על של שייש נותנין את האברים ועל של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כסף כלי שרת ושנים באולם מבפנים על פתח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית אחד של שייש ואחד של זהב על של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שייש נותנין לחם הפנים בכניסתו ועל של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב ביציאתו שמעלין בקודש ולא מורידין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד של זהב מבפנים שעליו לחם הפנים תמיד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>גמ׳</b> תני על של כסף רבי יוסי בשם רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל בר רב יצחק רבי חנניה מטי בה בשם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוחנן לית כאן של כסף מפני שהוא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מרתיח לא כן תני זה אחד מן הנסים שנעשו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבית המקדש שכשם שהיו מניחין אותו חום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כך היו מוציאין אותו חום שנאמר לשום לחם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חם ביום הלקחו רבי יהושע בן לוי אמר אין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מזכירין מעשה נסים בעון קומי רבי אילא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא היה שם לחם מהו להניחו לשבת הבאה אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לון כתיב ונתת על השולחן לחם פנים לפני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמיד לחם פנים אפילו פסול עשרה שלחנות",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עשה שלמה דכתיב ויעש שולחנות עשרה וינח בהיכל חמשה מימין וחמשה משמאל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אין תימר חמשה בדרום וחמשה בצפון והלא אין השלחן כשר אלא בצפון שנאמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואת השלחן תתן על צלע צפון מה תלמוד לומר חמשה מימין וחמשה משמאל אלא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חמשה מימין שלחנו של משה וחמשה משמאלו אף על פי כן לא היה מסדר אלא בשל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "משה בלבד שנאמר את השלחן אשר עליו לחם הפנים רבי יוסי בי רבי יהודה אומר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "על כולן היה מסדר שנאמר את השולחנות ועליהם לחם הפנים תני מזרח ומערב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היו נתונין דברי רבי רבי אלעזר בי רבי שמעון אומר צפון ודרום היו נתונין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מאן דאמר מזרח ומערב ניחא כולהן ראויין לשירות מאן דאמר צפון ודרום נמצא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שלחן בדרום",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' <b>על של שיש מניחין את</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>האברים.</b> אחר הנתוח מסדרין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותן על השלחן עד שיעלום",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכהנים ובגמרא מפרש למה לא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עשאו של כסף או של זהב: <b>ועל</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>של כסף.</b> כלי שרת שמוציאין בכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בוקר שלשה ותשעים כלי שרת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדתנן בתמיד: <b>נותנין לחם</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הפנים בכניסתו.</b> אחר שנאפה עד",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיסדרוהו על השלחן: <b>ועל של</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>זהב ביציאתו.</b> והיה מונח שם עד",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זמן חילוק: <b>שמעלין בקדש ולא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מורידין.</b> דכיון שסלקוהו מעל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השלחן של זהב אין מורידין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו להניחו בשל כסף: גמ' <b>תני</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>על של כסף.</b> אותן של אולם אחד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה של כסף ואחד של זהב על של",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כסף היו נותנין בכניסתו דאין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עניות במקום עשירות: <b>לית כאן</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>של כסף.</b> לא היה באולם של כסף",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא כדתנן במתני' דשל כסף",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מרתיח ומתחמם הלח' ויש לחוש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיתעפש: ופריך <b>לא כן תני זה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אחד מן הניסים וכו'.</b> שהיה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נשמר חום הלחם עד שעת סילוקו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשבת הבא א\"כ לא היה מתעפש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפי' היו מניחין אותו על שלחן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של כסף: <b>אין מזכירין מעשה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ניסים.</b> כלומר אין סומכין על",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנס ועושין הכל שלא יתעפש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדרך הטבע: <b>לא היה שם לחם.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לסדר בשבת ובתוך ימי השבוע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נזדמן להם מהו להניחם מלסדר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עד שבת הבאה או דלמא אע\"ג",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא פסול דכל שלא עברה עליו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבעה ימים על השלחן פסול הוא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מ\"מ לקיים מצות לחם הפנים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפני תמיד אין להניחו בלא לחם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "א\"נ לא היה שם לחם לערוך ביום השבת מהו להניח הלחם הראשון על השלחן שהרי לא יתקלקל גם בשבת הבאה מיהו פסול הוא משום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לינה: <b>לפני תמיד.</b> שיהו תמיד לפני ה' אע\"פ שהן פסולין: <b>עשרה שולחנות עשה שלמה.</b> דכתיב ויעש שולחנות עשרה וגו': <b>אין</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תימר חמשה בדרום וכו'.</b> ומימין היינו מימין הפתח ומשמאל היינו משמאלו של פתח שהפתח היתה באמצע ההיכל בכותל מזרחי א\"נ",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מימין היינו דרום שנקרא ימין ומדרום נקרא ימין צפון נקרא שמאל: <b>אלא.</b> של משה באמצע וה' מימינו וחמשה משמאלו וכולן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בצפון ההיכל: <b>את השלחן.</b> לשון יחיד: <b>על כולם היה מסדר.</b> פעמים בזה ופעמים בזה: <b>מזרח ומערב היו נתונין.</b> השולחנות ראשו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אחד למזרח ואחד למערב דהיינו אורכו לאורך הבית: <b>כולהון ראויין לשירות.</b> ואיכא למימר על כולם היה מסדר: <b>נמצא שלחן</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
