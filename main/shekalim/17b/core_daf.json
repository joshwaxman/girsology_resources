    {
      "role": "tiklin_chadtin",
      "state": "added",
      "label_he": "פני משה",
      "label_en": "Penei Moshe",
      "side": "left",
      "width": "245px",
      "right": "0px",
      "left": "0px",
      "top": 770,
      "height": 706,
      "basis": "scan",
      "top_frac": 0.4339,
      "height_frac": 0.5661,
      "printed_y": [
        409.5,
        787.9
      ],
      "printed_body_y": [
        119.5,
        787.9
      ],
      "note_he": "תוספת שלנו. פני משה אינו נדפס בדף זה כלל — במלבן הזה הדפיסו תקלין חדתין, שאינו מצוי במהדורה דיגיטלית. הטקסט מספריא (פיוטרקוב תרנ״ח–תר״ס), ואינו חלק מצורת הדף הנדפסת.",
      "note_en": "OUR ADDITION. Penei Moshe is not printed on this leaf at all — this rectangle is where the press set Tiklin Chadtin, which is in no digital edition. The text is Sefaria's (Piotrków, 1898-1900) and is not part of the printed page.",
      "printed_work_he": "תקלין חדתין",
      "printed_work_en": "Tiklin Chadtin",
      "source_ref": "Penei Moshe on Jerusalem Talmud Shekalim",
      "lines": [
        {
          "width": "216px",
          "text": "מתני' <b>שלשה עשר שולחנות</b>"
        },
        {
          "width": "216px",
          "text": "<b>היו במקדש וכו' שעליהן</b>"
        },
        {
          "width": "216px",
          "text": "<b>מדיחין את הקרביים.</b> של"
        },
        {
          "width": "216px",
          "text": "הקדשים שלאחר שמדיחין"
        },
        {
          "width": "216px",
          "text": "אותן בלשכת המדיחין כדתנן"
        },
        {
          "width": "216px",
          "text": "בפרק בתרא דמדות לשכת"
        },
        {
          "width": "216px",
          "text": "המדיחין ששם היו מדיחין"
        },
        {
          "width": "216px",
          "text": "קרבי הקדשים וחוזרין"
        },
        {
          "width": "216px",
          "text": "ומדיחין אותן על השלחנות"
        },
        {
          "width": "216px",
          "text": "וכדתנן בפ\"ד דתמיד נטל את"
        },
        {
          "width": "216px",
          "text": "הקרביים ונתנן למי שזכה"
        },
        {
          "width": "216px",
          "text": "בהן להדיחן והכרס מדיחין"
        },
        {
          "width": "216px",
          "text": "אותה בבית מדיחין כל צרכה"
        },
        {
          "width": "216px",
          "text": "והקרביים מדיחין אותן"
        },
        {
          "width": "216px",
          "text": "שלשה פעמים במיעוטה על"
        },
        {
          "width": "216px",
          "text": "שלחנות של שייש שבין"
        },
        {
          "width": "216px",
          "text": "העמודים וכלומר הכרם שיש"
        },
        {
          "width": "216px",
          "text": "בה טינוף הרבה מדיחין"
        },
        {
          "width": "216px",
          "text": "אותה בלשכת המדיחין כל"
        },
        {
          "width": "216px",
          "text": "צרכה ובפני עצמה שלא תטנף"
        },
        {
          "width": "216px",
          "text": "להקרביים ביותר ומדיחין"
        },
        {
          "width": "216px",
          "text": "אותה שם לגמרי והקרביים"
        },
        {
          "width": "216px",
          "text": "אחר שהודחו בבית המדיחין"
        },
        {
          "width": "216px",
          "text": "חוזרין להדיחן עוד לא"
        },
        {
          "width": "216px",
          "text": "פחות משלשה פעמים על"
        },
        {
          "width": "216px",
          "text": "השלחנות של שייש ומפני"
        },
        {
          "width": "216px",
          "text": "שהן דקין ואין הרעי יוצא"
        },
        {
          "width": "216px",
          "text": "מהן אלא בדוחק ולפיכך"
        },
        {
          "width": "216px",
          "text": "מדיחין וחוזרין ומדיחין:"
        },
        {
          "width": "216px",
          "text": "<b>ושנים במערב הכבש וכו' על</b>"
        },
        {
          "width": "216px",
          "text": "<b>של שייש נותנין את</b>"
        },
        {
          "width": "216px",
          "text": "<b>האברין.</b> אחר הנתוח וסודרן"
        },
        {
          "width": "216px",
          "text": "אותן על השלחן עד שיעלום"
        },
        {
          "width": "216px",
          "text": "הכהנים על הכבש ומשם"
        },
        {
          "width": "216px",
          "text": "להמזבח ולא היו עושין"
        },
        {
          "width": "216px",
          "text": "אותו של כסף ואף שאין"
        },
        {
          "width": "216px",
          "text": "עניות במקום עשירות משום"
        },
        {
          "width": "216px",
          "text": "שהכסף מרתיח ושלא יסריחו"
        },
        {
          "width": "216px",
          "text": "והשייש מצנן הוא ולא היו"
        },
        {
          "width": "216px",
          "text": "סומכין על הנס כדחשיב"
        },
        {
          "width": "216px",
          "text": "בפ\"ה דאבות עשרה נסים"
        },
        {
          "width": "216px",
          "text": "וכו' שלא הסריח בשר הקדש"
        },
        {
          "width": "216px",
          "text": "מעולם והכי אמר בגמרא:"
        },
        {
          "width": "216px",
          "text": "<b>ועל של כסף.</b> היו נותנין"
        },
        {
          "width": "216px",
          "text": "כלי שרת כדתנן בפ\"ג דתמיד"
        },
        {
          "width": "216px",
          "text": "שבכל יום בבקר קודם"
        },
        {
          "width": "216px",
          "text": "לשחיטת התמיד נכנסו ללשכת"
        },
        {
          "width": "216px",
          "text": "הכלים והוציאו משם תשעים"
        },
        {
          "width": "216px",
          "text": "ושלשה כלי כסף וכלי זהב:"
        },
        {
          "width": "216px",
          "text": "<b>ושנים באולם מבפנים.</b> של"
        },
        {
          "width": "216px",
          "text": "האולם ועל פתח הבית: <b>על</b>"
        },
        {
          "width": "216px",
          "text": "<b>של שייש נותנין לחם הפנים</b>"
        },
        {
          "width": "216px",
          "text": "<b>בכניסתו.</b> אחר שנאפה עד"
        },
        {
          "width": "216px",
          "text": "שיסדרו אותו בפנים על"
        },
        {
          "width": "216px",
          "text": "השלחן הטהור: <b>ועל של זהב</b>"
        },
        {
          "width": "216px",
          "text": "<b>ביציאתו.</b> של הלחם שהיה על"
        },
        {
          "width": "216px",
          "text": "השלחן משבת העבר והיה"
        },
        {
          "width": "216px",
          "text": "מונח שם עד שיתחלק"
        },
        {
          "width": "216px",
          "text": "להכהנים: <b>שמעלין בקדש ולא</b>"
        },
        {
          "width": "216px",
          "text": "<b>מורידין.</b> דמכיון שסלקו"
        },
        {
          "width": "216px",
          "text": "אותו מעל שלחן של זהב"
        },
        {
          "width": "216px",
          "text": "שמבפנים שוב אין מורידין"
        },
        {
          "width": "216px",
          "text": "אותו להניחו לא על של כסף"
        },
        {
          "width": "216px",
          "text": "ולא על אחר אלא על של"
        },
        {
          "width": "216px",
          "text": "זהב: גמ' <b>תני.</b> בחדא"
        },
        {
          "width": "216px",
          "text": "ברייתא על של כסף היו"
        },
        {
          "width": "216px",
          "text": "נותנין את האברין: <b>לית</b>"
        },
        {
          "width": "216px",
          "text": "<b>כאן של כסף.</b> סמי מכאן"
        },
        {
          "width": "216px",
          "text": "מהברייתא דטעותא היא ואין"
        },
        {
          "width": "216px",
          "text": "נותנין על של כסף מפני"
        },
        {
          "width": "216px",
          "text": "שהוא מרתיח ומחמם אותן"
        },
        {
          "width": "216px",
          "text": "ויסריחו: <b>לא כן תני.</b> במס'"
        },
        {
          "width": "216px",
          "text": "אבות גבי בשר הקדש שלא"
        },
        {
          "width": "216px",
          "text": "הסריח מעולם וכן בלחם"
        },
        {
          "width": "216px",
          "text": "הפנים שנינו בברייתא זה"
        },
        {
          "width": "216px",
          "text": "אחד מן הנסים וכו' ואמאי"
        },
        {
          "width": "216px",
          "text": "הוצרכו ליתן אותו בכניסתו"
        },
        {
          "width": "216px",
          "text": "על של שיש כדקתני במתני':"
        },
        {
          "width": "216px",
          "text": "<b>אין מזכירין מעשה נסים.</b>"
        },
        {
          "width": "216px",
          "text": "וכלומר שאין סומכין על"
        },
        {
          "width": "216px",
          "text": "הנס: <b>לא היה שם לחם.</b> שלא"
        },
        {
          "width": "216px",
          "text": "מצאו לעשות לחם הפנים"
        },
        {
          "width": "216px",
          "text": "לסדר מהאפוי מחדש לשבת זו"
        },
        {
          "width": "216px",
          "text": "מהו להניחו להלחם שסידרו"
        },
        {
          "width": "216px",
          "text": "בשבת שעברה ויהא נשאר"
        },
        {
          "width": "216px",
          "text": "מונח עד לשבת הבאה שיהיה"
        },
        {
          "width": "216px",
          "text": "להם לחם אחר: <b>תמיד.</b> משמע"
        },
        {
          "width": "216px",
          "text": "שלא יהא השלחן בלא לחם"
        },
        {
          "width": "216px",
          "text": "ואפי' הוא פסול וכגון זה"
        },
        {
          "width": "216px",
          "text": "שסידרו כמצותו בשבת שעברה"
        },
        {
          "width": "216px",
          "text": "ונפסל בלינה כדתנינן בסוף"
        },
        {
          "width": "216px",
          "text": "פרק שתי הלחם מניחין אותו"
        },
        {
          "width": "216px",
          "text": "ולשבת הבאה יעשו לחם אחר:"
        },
        {
          "width": "216px",
          "text": "<b>עשרה שולחנות וכו'.</b>"
        },
        {
          "width": "216px",
          "text": "כדכתיב בד\"ה ויעש שלחנות"
        },
        {
          "width": "216px",
          "text": "עשרה וגו' ומפרש מאי"
        },
        {
          "width": "216px",
          "text": "מימין ומשמאל דקאמר אין"
        },
        {
          "width": "216px",
          "text": "תימר שהניח חמשה בדרום"
        },
        {
          "width": "216px",
          "text": "שהוא ימין וכו' והלא אין"
        },
        {
          "width": "216px",
          "text": "השלחן כשר אלא בצפון"
        },
        {
          "width": "216px",
          "text": "כדכתיב אלא חמשה מימין"
        },
        {
          "width": "216px",
          "text": "שלתנו של משה וה' משמאלו"
        },
        {
          "width": "216px",
          "text": "שהיה של משה באמצע וכולן"
        },
        {
          "width": "216px",
          "text": "בצד צפון היו נתונים: <b>אף</b>"
        },
        {
          "width": "216px",
          "text": "<b>על פי כן לא היה מסדר.</b>"
        },
        {
          "width": "216px",
          "text": "לחם הפנים אלא על של משה"
        },
        {
          "width": "216px",
          "text": "בלבד שנאמר במלכים ואת"
        },
        {
          "width": "216px",
          "text": "השלחן וגו' ועל של משה"
        },
        {
          "width": "216px",
          "text": "קאי משמע לעולם עליו הוא"
        },
        {
          "width": "216px",
          "text": "הלחם הפנים ולא על אחר:"
        },
        {
          "width": "216px",
          "text": "<b>על כלם היה מסדר שנאמר.</b>"
        },
        {
          "width": "216px",
          "text": "בד\"ה ויעש שלמה את כל"
        },
        {
          "width": "216px",
          "text": "הכלים וגו' ואת השלחנות"
        },
        {
          "width": "216px",
          "text": "ועליהם לחם הפנים ופלוגתא"
        },
        {
          "width": "216px",
          "text": "זו גריס בתוספתא דמנחות"
        },
        {
          "width": "216px",
          "text": "פי\"א: <b>תני.</b> בברייתא"
        },
        {
          "width": "216px",
          "text": "אחריתא דפליגי היכן היו"
        },
        {
          "width": "216px",
          "text": "אותן השולחנות נתונים:"
        },
        {
          "width": "216px",
          "text": "<b>מ\"ד מזרח ומערב ניחא.</b>"
        },
        {
          "width": "216px",
          "text": "דלהאי מ\"ד היו כולם בצד"
        },
        {
          "width": "216px",
          "text": "צפון וכולהון ראוין"
        },
        {
          "width": "216px",
          "text": "לשירות לסדר לחם הפנים"
        },
        {
          "width": "216px",
          "text": "עליהן וכהאי דר' יוסי בר'"
        },
        {
          "width": "216px",
          "text": "יהודה אלא למ\"ד צפון"
        },
        {
          "width": "216px",
          "text": "ודרום היו נתונים נמצא"
        },
        {
          "width": "216px",
          "text": "היו מהשלחנות בדרום שהרי"
        },
        {
          "width": "216px",
          "text": "הבית ששים אמות ארכו"
        },
        {
          "width": "216px",
          "text": "ועשרים רחבו והשלחנות כל"
        },
        {
          "width": "216px",
          "text": "אחד ואחד אמתים ארכו וא\"כ"
        },
        {
          "width": "216px",
          "text": "חמשה בצפון וחמשה בדרום"
        },
        {
          "width": "216px",
          "text": "היו. והיינו נמי דמסיים"
        },
        {
          "width": "216px",
          "text": "ומנורה בצפון וכלומר"
        },
        {
          "width": "216px",
          "text": "דמעתה אין מקום למנורה"
        },
        {
          "width": "216px",
          "text": "כנגדו בדרום והא תני"
        },
        {
          "width": "216px",
          "text": "השלחן היה נתון מחצי הבית"
        },
        {
          "width": "216px",
          "text": "ולפנים וכו' לארכו של"
        },
        {
          "width": "216px",
          "text": "היכל ומשוך מן הכותל כלפי"
        },
        {
          "width": "216px",
          "text": "הצפון לרוחב הבית מזבח"
        },
        {
          "width": "216px",
          "text": "הזהב וכו' חולק את הבית"
        },
        {
          "width": "216px",
          "text": "לארכו דמחציו ולפנים היה"
        },
        {
          "width": "216px",
          "text": "נתון ומשוך קימעא כלפי"
        },
        {
          "width": "216px",
          "text": "הצפון: <b>וכולהן היו נתונין</b>"
        },
        {
          "width": "216px",
          "text": "<b>משליש הבית ולפנים.</b> כלומר"
        },
        {
          "width": "216px",
          "text": "כשאתה חושב אורך ההיכל"
        },
        {
          "width": "216px",
          "text": "בלבד שהיה ארבעים אמה"
        },
        {
          "width": "216px",
          "text": "ומלבד עשרים שהן לקדש"
        },
        {
          "width": "216px",
          "text": "הקדשים והשלחנות היו"
        },
        {
          "width": "216px",
          "text": "נתונים באותן עשרים של"
        },
        {
          "width": "216px",
          "text": "היכל של צד קדש הקדשים"
        },
        {
          "width": "216px",
          "text": "הרי הן מחצי הבית ולפנים"
        },
        {
          "width": "216px",
          "text": "וכשאתה חושב כל האורך עם"
        },
        {
          "width": "216px",
          "text": "עשרים של קדש הקדשים והרי"
        },
        {
          "width": "216px",
          "text": "הן ששים אמה הרי הן"
        },
        {
          "width": "216px",
          "text": "נתונים משליש הבית ולפנים"
        },
        {
          "width": "216px",
          "text": "קתני מיהת שלא היה מן"
        },
        {
          "width": "216px",
          "text": "השלחן בצד דרום וקשיא"
        },
        {
          "width": "216px",
          "text": "למ\"ד צפון ודרום מונחין:"
        }
      ],
