      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבועה דאין נשבעין על",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההקדשות: <b>משום שבועת תקנה.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדאורייתא פטור לגמרי ורבנן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא דתיקון לה שלא יזלזלו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשמירת ההקדשות: <b>ה\"ג ע\"ד דר\"י</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ניחא נשבעין לגזברין ואם לאו</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נשבעין לבני העיר משום שבועת</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>התקנה אלא לר\"א נשבעין לבני</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>העיר ובני העיר שוקלין אחרים</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תחתיהן הדא היא דר\"ש אלא</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נשבעין לגזברין גזברין מאי</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עבידתייהו.</b> וה\"פ לר\"א כיון",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאין הגזברין חייבין באחריות",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקלים אלו א\"כ הקדשות נינהו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואין נשבעין על ההקדשות כאלו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכ\"ע: <b>ומשני נשבעים לבני</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>העיר.</b> ליטול שכרן במעמד",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגזברין מפני שההפסד על",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההקדש: <b>אע\"פ שקיבלו וכו'.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדר' יוחנן קאי דקאמר דשבועה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זו תקנת חכמים היא שאין הקדש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוצא בלא שבועה הלכך אפילו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קיבלו אנשי העיר עליהן ואמרו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הואיל ואנו משלמין אין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רצונינו שישבע השליח שהוא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נאמן לנו אין שומעין להן שאין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקדש יוצא בלא שבועה: <b>חייב</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>באחריותו.</b> אפילו לאחר שנתרמה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התרומה עד שימסרנו לגזבר:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הקדש ברשות גבוה בכל מקום</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שהוא.</b> ואפילו קודם שנתרמה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פטור: <b>ובני העיר שוקלין</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תחתיהן.</b> ואס\"ד בי גזא דרחמנא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא אף קודם שנתרמה יהיו בני",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העיר פטורין: <b>ומשני לא עוד</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היא משום שבועת התקנה.</b> אף זו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן התקנה שלא יזלזלו בהקדשות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וישלחו אותן ע\"י שליח אלא כל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד יביא שקלו בעצמו לשם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמצוה בו יותר מבשלוחו: <b>תני</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הראשונים וכו'.</b> אנמצאו או",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהחזירום הגנבים קאי דהשתא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שניהם לפנינו: <b>אלו ששילחו בני</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>העיר תחלה.</b> הן הראשונים:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וחורנה אמר.</b> ואידך אמר: מתני' <b>על ידו.</b> בשבילו והלך השליח ושקלו בשביל עצמו: <b>אם</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>נתרמה התרומה.</b> קודם ששקל בשביל עצמו: <b>מעל.</b> דמיד שנתרמה התרומה על העתיד לגבות היה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "זה השקל שנתן לו חבירו לשקול עליו ברשות הקדש וכשנתנו בשביל עצמו נהנה מן ההקדש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ובגמ' מפרש מה נהנה: <b>השוקל שקלו מן ההקדש.</b> שהיו בידו מעות שהקדישן לבדק הבית",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכסבור שהן של חולין ושקל מהן שקלו ונתרמה התרומה וקנה בהמה באותה תרומה והקריבוה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אז נתחייב השוקל קרבן מעילה אבל לא קודם לפי שאין מעילה אלא במוציא מן ההקדש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לחולין אבל המוציא מהקדש להקדש אף על פי שנהנה אינו מועל אלא אחר שעשה מעשה בהקדש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "השני: <b>יאכל כנגדן.</b> בגמרא מפרש לה: גמ' <b>אנן תנינן.</b> ברישא דמתניתין אם נתרמה התרומה",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ותנאי דבי רבי תנו אף ברישא וקרבה הבהמה ולא פליגי דתנא דידן סמיך אסיפא שמפרש בה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מעילת שניהם (והרא\"פ הגיה ללא צורך): <b>ה\"ג אר\"א דלא כר\"ש דר\"ש אומר.</b> לקמן ספ\"ד:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מיד היה מקבל מעותיו.</b> ר\"ש פליג אהא דתנן התם המספק אינו מקבל את מעותיו עד שיהא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המזבח מרצה ור\"ש סובר דמיד היה מקבל את מעותיו ולא חיישינן שמא יארע בהן פסול",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונמצא ההקדש נפסד מפני שהכהנים זריזין הן שאפילו לא קרבה הבהמה אלא שקנו אותה כבר",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יצאו המעות לחולין ומעל: <b>וקשיא.</b> אמתניתין למה מעל אילו מי שגנב עולתו של חבירו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ושחטה סתם ודאי לבעלים הראשונים מכפרת א\"כ ה\"נ גבי שקלים כשניתנו ללשכה אינו ניכר",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "השקל של מי הוא והוא נתרם סתם לשם מי שהוא וחוזר השקל לבעלים הראשונים ולמה יהא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חייב קרבן מעילה: <b>במסויים.</b> שניכר וידוע שהוא של שני ואיירי שעשה כמו שעשו של בית",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "רבן גמליאל כדתנן לקמן פ\"ג שהיה מתכוין וזורקו לקופה: ופריך <b>וחש לומר וכו'.</b> למה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הוא מביא קרבן מעילה דלמא לא נקנה בהמה משקל זה אלא ניתותר בקופה הגדולה והן שירי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הלשכה: <b>וכי יש מעילה בשירים.</b> בתמיה: <b>אלא כר\"מ וכו'.</b> וכי נוקים סתמא דמתניתין כר\"מ",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דסובר יש מעילה בשיריים ולית הלכתא כוותיה אלא כר\"י דפליג עליה: <b>ומשני עוד היא</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>במסויים וכו'.</b> כלומר כבר אוקימנא לה במסויים וכבית ר\"ג א\"כ איכא למימר שידוע",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמשקל זה קנו בהמה: <b>מה נהנה.</b> ולמה תנן שמביא קרבן מעילה דמחי דנהנה דקעביד מצוה",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לאו הנאה היא דמצות לאו ליהנות ניתנו: <b>כמי שנהנה.</b> שהציל עצמו בממון ההקדש ונהנה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשקל הזה: <b>כל שהוא קדש אין קדושה.</b> אחרת חל עליו הילכך שקל זה ששקל מעות מעשר שני",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אינו קדוש כלל לשם קרבנות: <b>כיצד הוא עושה.</b> אם שקל שקלו ממעשר שני או משביעית:",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והשאר.</b> מעות הראשונות שנתן לשם מחצית השקל נעשין שקלים שהרי כחולין הן עכשיו:",
      "gemara_segment_ids": [
        6
      ]
    }
  ],
