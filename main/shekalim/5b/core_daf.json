  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "תחתיהן משום שבועת תקנה אלא לרבי לעזר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נשבעים לבני העיר הדא היא דרבי שמעון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נשבעים לגזברים גזברים מאי עבידתייהו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נשבעים לבני העיר במעמד גזברים כי היכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלא לחשדינהו אי נמי דלא נשוו להו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פושעים אף על פי שקבלו בני העיר לשלם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין ההקדש יוצא בלא שבועה הפריש שקלו",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואבד רבי יוחנן אמר חייב באחריותו עד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שימסרנו לגזבר רבי שמעון בן לקיש אומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקדש ברשות הגבוה בכל מקום שהוא מתניתא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פליגא על רבי שמעון בן לקיש נשבעין לבני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העיר ובני העיר שוקלין תחתיהם לא עוד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היא משום שבועת תקנה תני הראשונים",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נופלים לתקלין חדתין והשניים נופלין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לתקלין עתיקין אלו הן הראשונים ואלו הן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השניים רבי פנחס בי רבי חייא ורבי אבא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מרי חד אמר אלו ששלחו בני העיר תחלה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחרנה אמר אלו שהגיעו לידי גזברין תחלה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>הלכה ב <big>מתני׳</big></b> הנותן שקלו לחבירו לשקול",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על ידו, ושקלו על ידי עצמו. אם נתרמה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התרומה – מעל, השוקל שקלו מן ההקדש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונתרמה התרומה וקרבה הבהמה מעל ממעשר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שני ומדמי שביעית יאכל כנגדן <b>גמ׳</b> השוקל",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כו׳ אנן תנינן אם קרבה הבהמה ותני דבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אם נתרמה התרומה מאן תנא אם נתרמה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התרומה רבי שמעון היא דאמר רבי שמעון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיד היה מקבל מעותיו והכהנים זריזים הן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וקשיא אילו הגונב עולתו של חבירו ושחטו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סתם סתמא לא לשם בעלים הראשונים מכפרת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יודן תיפתר במסוים משל בית רבן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גמליאל שהיה מתכוין ודוחפו לתוך הקופה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחש לומר שמא לשיריים הן נופלין וכי יש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעילה בשירים אלא כרבי מאיר דרבי מאיר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר מועלין בשיריים עוד היא במסוים של",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית רבן גמליאל שהיה מתכוין ותורמו לשמו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מה נהנה אמר רבי אבין בשם רבנן דתמן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכיון שבית דין ראוין למשכן ולא משכנו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמו שנהנה ממעשר שני וכו׳ דכתיב אך בכור",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אשר יבכר לה׳ בבהמה לא יקדיש איש אתו כל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהוא קודש אין קדושה חלה [עליו] כיצד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא עושה מביא סלע של חולין ואומר מעות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעשר שני בכל מקום שהן יהו מחוללין על",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סלע זו ואותה סלע נתפס לשם מעשר שני",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והשאר נעשו שקלים",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
