  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "סתם אדר שני תניין מתקנין את הדרכים ואת",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרחובות ואת מקוות המים ועושין כל צרכי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרבים אלו הן צרכי הרבים דנין דיני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממונות ודיני נפשות דיני מכות ופודין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ערכין וחרמים והקדישות ומשקין את הסוטה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושורפין את הפרה ועורפין עגלה ערופה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ורוצעין עבד עברי ומטהרין את המצורע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומפרקין את המנעל מעל גבי המים ואין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחזירין אותן תמן תנינן משקין בית",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השלחין ומציינין על הקברות לא כבר ציינו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאדר ותיפתר שירד שטף של גשמים ושטפו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויוצאין אף על הכלאים לא כבר יצאו מאדר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תיפתר שהיתה השנה אפילה ואין הצמחין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נכרים מניין לציון רבי ברכיה רבי יעקב",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר בת יעקב בשם רבי חונייא דברת חוורין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסה אמרי לה רבי יעקב בר אחא בשם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חונייא דברת חוורין רבי חזקיה רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עוזיאל בריה דרב חונייא דבית חוורן בשם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חונייא דבית חוורן וטמא טמא יקרא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כדי שתהא הטומאה קוראה לך בפיה ואומרת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לך פרוש רבי אילא בשם רבי שמואל בר נחמן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ועברו העוברים בארץ וראה עצם אדם ובנה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אצלו ציון עצם מיכן שמציינין על העצמות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדם מיכן שמציינין על השדרה והגלגולת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובנה מיכן שמציינין על גבי אבן קבועה אם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר את על גבי אבן תלושה אף היא הולכת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומטמא במקום אחר אצלו למקום טהרה ציון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיכן לציון ומצא אבן אחת מצויינת אף על",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פי שאין מקיימין כן המאהיל עליה טמא אני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר מת מצויין והיה נתון תחתיה היו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתים המאהיל עליהן טהור וביניהן טמא אם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היה חורש בינתיים הרי הן כיחידיות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביניהן טהור וסביבותיהן טמא תני אין",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מציינין על הבשר שמא נתעכל הבשר רבי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסטא בר שונם בעא קומי רבי מנא ולא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמצא מטמא טהרות למפרע אמר ליה מוטב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיתקלקלו בו לשעה ואל יתקלקלו בו לעולם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>הלכה ב <big>מתני׳</big></b> אמר רבי יהודה: בראשונה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו עוקרין ומשליכין לפניהן, משרבו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עוברי עבירה – היו משליכין לדרכים,",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התקינו שיהו מפקירין את כל השדה. <b>גמ׳</b>",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יהודה כו׳ תני אמר רבי יהודה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בראשונה היו עוקרין ומשליכין לפניהן",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והיו שמחים שתי שמחות אחת שהיו מנכשין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שדותיהן ואחת שהיו נהנין מן הכלאים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משרבו עוברי עבירה היו משליכין על",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדרכים אף על פי כן היו שמחים שהיו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנכשין שדותיהן התקינו שיהו מפקירין כל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השדה כולה ומניין שהפקר בית דין הפקר",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכתיב וכל אשר לא יבא לשלשת הימים בעצת",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השרים והזקנים יחרם כל רכושו והוא יבדל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקהל הגולה מניין שהיא פטורה מן המעשרות",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יונתן בריה דרב יצחק בר אחא שמע לה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הדא אין מעברין את השנה לא בשביעית",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא במוצאי שביעית ואם עיברוה הרי זו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעוברת וחודש אחד שהוא מוסיף לא פטור",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממעשרות הוא עד כדון שביעית מוצאי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שביעית מאי אמר רבי בון שלא לרבות",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באיסור חדש רבי זעירא בשם רבי אלעזר הדא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאת אמר עד שלא התיר רבי להביא ירק",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחוצה לארץ לארץ אבל משהתיר רבי להביא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירק מחוצה לארץ לארץ היא שביעית היא של",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאר שני שבוע תני אין מעברין וכו׳ אמר",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי מנא הדא דאת אמר בראשונה שהיו השנים",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתקנן אבל עכשיו שאין השנים כתקנן היא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שביעית היא שאר שני שבוע תני של בית רבן",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גמליאל עיברוה במוצאי שביעית מיד אמר",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אבון אין מן הדא לית את שמע מינה",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום שמור את חדש האביב שומריהו שיביאו",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחידושו והיידא אמרה דא גדיש שלא לוקט",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תחתיו כל הנוגעות בארץ הרי הן של עניים",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואמר רבי אמי",
      "segment_ids": [
        11
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומשקין את הסוטות.</b> בודקין אם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראויה לשתות: <b>ומפרקין את</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המנעול מע\"ג אימום וכו'.</b> לאו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צורכי רבים היא אלא סיומא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתוספתא היא ובחול המועד",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איירי דמותר לפרק המנעול מע\"ג",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדפוס שאין זה מעשה אומן אבל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסור להחזירו שצריך אומן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואסור במועד: <b>תמן תנינן.</b> פ\"ק",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמ\"ק. משקין בית השלחין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומציינין את הקברות ויוצאין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אף על הכלאים במועד: ופריך <b>לא</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כבר ציינו באדר.</b> כדתנן במתני'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמה צריך תו לציין במועד:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ושטפו.</b> לציון הראשון וצריך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ציון אחר: <b>לא כבר יצאו באדר.</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמה להו לצאת שנית במועד:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואין הצמחין.</b> של הכלאים היו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניכרין כולן בחמשה עשר באדר:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מניין.</b> רמז לציון הקברות",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקרא: <b>טומאה קוראת וכו'.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר עושים סימנים על הטומאה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדי שיהיה מרגיש ופורש: <b>ועברו</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>העוברים וגו'.</b> בנבואת יחזקאל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב שלעתיד יעשו ישראל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ציונים על עצמות הפגרים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המושלכין ופשטיה דקרא הציון",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא שיטלו אותו משם ויקברנו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגיא המון גוג מ\"מ רמז הוא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבא הכתוב להזהיר וללמד שיהא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדם עושה ציון שיפרישו מפני",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הטומאה: <b>עצם.</b> קדריש כולא קרא:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>על העצמות.</b> אע\"פ שנתעכל הבשר",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאכתי מטמא באהל ואיירי בשיש",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהן רובע הקב אע\"פ שאינן לא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רוב בנין ולא רוב מנין: <b>על</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>השדרה ועל הגלגולת.</b> אע\"פ",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינן אלא עצם אחד: <b>ע\"ג אבן</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>קבועה.</b> על הקבר לאפוקי אבן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המתגלגל דהכי משמע לישנא דקרא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובנה שהוא מחובר בבנין: <b>אף</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היא הולכת.</b> ומתגלגלת למקום",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחר ויאמרו שהטומאה היא שם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומטהרים טמאות ומטמאים טהרות",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא כדין: <b>למקום טהרה.</b> מדלא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב ובנה עליו ציון משמע",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאפילו על מקום טהרה שאצלו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מציינין דאל\"כ אינו מרגיש עד",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיבוא על הציון וכבר נטמאו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הטהרות לכך מרחיקין מקצת",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשיבוא על הציון מרגיש בטומאה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלפניו ואינו הולך לשם: <b>מכאן</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לציון.</b> שעושין סימן: <b>ה\"ג תני</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מצא אבן וכו' אע\"פ שאינו</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רשאי.</b> שהרי צריך להרחיק הציון",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הטומאה כל שהוא כדפרישית",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסמוך וכשהטומאה תחת האבן הרי",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל האבן מטמא באהל: <b>ה\"ג אני</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אומר מת קמצוץ והיה נתון</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תחתיה וכ\"ה במ\"ק.</b> וה\"פ מת",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמרגלותיו מונחים אצל ראשו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונקבר שלא כדרכו ולא היה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחזיק מקומו יותר מן האבן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלזה ואפילו האבן קטן: <b>קמצוץ.</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פי' שנקמץ ואינו מחזיק הרבה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחבירו בפסחים פ' כיצד צולין",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דף פ\"ו: <b>היו שתים.</b> אבנים",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצויינות וריוח ביניהן: <b>עליהן</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>טהור.</b> שאני אומר מפני הטומאה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שביניהן ציינו עליהן: <b>אם היה</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חורש בינתיים.</b> המקום שבין שני",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האבנים היה חרוש: <b>הרי הן</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כיחידות וביניהון טהור.</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמסתמא לא היה שם טומאה שאין",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חורשין מקום הטמא: ה\"ג",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותחתיהן טמא: <b>שמא נתעכל הבשר.</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמצא מטמא טהרות שלא כדין:",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ולא נמצא מטמא טהרות למפרע.</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל זמן שלא נתעכל והוא לא ידע",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויעבור עליו ומפסיד טהרותיו:",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מוטב שיתקלקלו בו לשעה.</b> עד",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיתעכל: <b>ואל יתקלקלו בו</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לעולם.</b> דכשיעשו ציון יסברו",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעולם שעדיין הטומאה שם וישרפו עליו קדשים שיעברו עליו בשוגג או בלילה: מתני'",
      "gemara_segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>משרבו עוברי עבירה.</b> מפרש בגמרא: גמ' <b>שהיו מנכשין שדותיהן.</b> דכשנוטלין הכלאים מאליו",
      "gemara_segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היה מתנכש: <b>שהיו נהנין מן הכלאים.</b> שמשליכין לפני בהמתן: <b>וכל אשר לא יבא.</b> בעזרא",
      "gemara_segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כתיב: <b>מנין שהיא פטורה מן המעשרות.</b> שביד ב\"ד להפקיר שדה שתהא פטורה מן המעשרות:",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לא בשביעית.</b> לפי שמאריכין עליהן איסור עבודת קרקע ויד הכל שולטת על הספיחין ולא",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ימצאו לקרב העומר ושתי הלחם: <b>ולא במוצאי שביעית.</b> בשמינית לפי שכלה הישן ומאריכין",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עליהן איסור חדש וכדמפרש בסמוך: <b>וחדש אחד.</b> שחכמים מוסיפין בעיבורם בשביעית וכי",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אינו פוטרים הפירות ממעשרות ואס\"ד הפקר ב\"ד אינו פוטר ממעשרות למה יהא מעובר אם",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עיברוהו בשביעית: <b>עד כדון שביעית.</b> הניחא שביעית שאין מעברין משום שתי הלחם והעומר",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכדפרישית: <b>מוצאי שביעית.</b> מאי טעמא אין מעברין ואיידי דאייתי להך ברייתא פירשה",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולקמן מסיק פירכא לראיה זו דמייתי מינה דב\"ד מפקירין: <b>עד שלא התיר ר' להביא ירק</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מח\"ל לארץ.</b> שחששו שמא יביא עמהן גוש מארץ העמים שמטמא במגע ובמשא ויטמא טהרות של",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "א\"י: <b>אבל משהתיר ר' להביא ירק.</b> וכ\"ש תבואה: <b>היא שביעית היא של שאר שני שבוע.</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דלעולם מותר לעבר שהרי לא יאכלו הספיחין שיוכלו להביא תבואה מח\"ל: <b>שהיו השנים</b>",
      "gemara_segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כתיקנן.</b> וישראל שרוין על אדמתן ובהמ\"ק קיים אבל בזמן הזה שאין בה\"מ קיים והארץ",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ביד עכו\"ם אין חילוק בין שביעית לשאר שני שבוע דלעולם מעברין אפי' בשביעית: <b>אין</b>",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מן הדא וכו'.</b> אדלעיל קאי דר' יונתן דייק דהפקר ב\"ד פוטר מן המעשר וקאמר ר' אבון",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמהא ליכא למשמע דמדאורייתא מוסיפין חדש העיבור אלא דבשביעית מדחין אותו ואם",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עיברוהו עשו כדינא דאורייתא ועברו אתקנת חכמים: <b>שמרהו.</b> שיבא החודש הזה בחידושו",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולולי הוספת החדש הזה היה חג פסח לפעמים בימות החמה ופעמים בימות הגשמים:",
      "gemara_segment_ids": [
        10
      ]
    }
