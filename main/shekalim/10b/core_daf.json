        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמשליכין אל תוך שריפת הפרה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"ה לעץ ארז ואזוב אלא נקט",
