  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>הלכה ב <big>מתני׳</big></b> פרה, ושעיר המשתלח, ולשון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של זהורית – באין מתרומת הלשכה. כבש פרה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכבש שעיר המשתלח ולשון שבין קרניו ואמת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המים וחומות העיר ומגדלותיה וכל צרכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העיר באין משירי הלשכה אבא שאול אומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כבש פרה כהנים גדולים עושין משל עצמן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר שירי לשכה מה היו עושין בהן לוקחין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהן יינות שמנים וסלתות והשכר להקדש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דברי רבי ישמעאל רבי עקיבא אומר אין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משתכרין בשל הקדש אף לא משל עניים מותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התרומה מה היו עושין בה רקועי זהב ציפוי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבית קודש הקדשים רבי ישמעאל אומר מותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפירות קיץ המזבח מותר תרומה לכלי שרת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי עקיבא אומר מותר תרומה לקיץ המזבח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר נסכים לכלי שרת רבי חנניה סגן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכהנים אומר מותר נסכים קיץ המזבח מותר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התרומה לכלי שרת זה וזה לא היו מודים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפירות <b>גמ׳</b> כבש פרה כו׳ רבי ישמעאל בר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נחמן בשם רבי יונתן שלש לשונות הן של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שעיר בסלע של מצורע בשקל של פרה בשתי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סלעים רבי חוניה דברת חוורין רבי בא בר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זבדא בשם רבי שמעון בן חלפתא של פרה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשתי סלעים ומחצה ואית דמפקין לישנא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעשרה זוז רבי יהודא בשם רבי שמואל",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלמידי חכמים המלמדין את הכהנים הלכות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחיטה הלכות קבלה הלכות זריקה נוטלין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכרן מתרומת הלישכה רבי יצחק בר רדיפה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי אימי מבקרי מומי קדשים נוטלין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכרן מתרומת הלישכה רבי אחא רבי תנחום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר חייא בשם רבי שמלאי מגיהי ספר העזרה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוטלין שכרן מתרומת הלשכה גידל בר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בנימין בשם רבי אסי שני דייני גזילות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוטלין שכרן מתרומת הלשכה שמואל אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נשים האורגות בפרוכת נוטלין שכרן מתרומת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלשכה רב חונה אמר מתרומת בדק הבית מה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פליג שמואל עבד ליה כקרבן רב הונא עבד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לה כבנין אמר רבי חזקיה תנא רבי יהודה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדגדות הקטרת וכל קרבנות הצבור באין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתרומת הלשכה מזבח הזהב וכל כלי שרת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באין ממותר נסכים מזבח העולה וההיכל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והעזרות באין משירי הלשכה חוץ לעזרות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באין מלשכת בדק הבית והא תני אבני המזבח",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ההיכל והעזרות מועלין בהן וכי יש מעילה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשיריים אלא כרבי מאיר דרבי מאיר אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מועלין בשיריים אמר רבי חייא כלום אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי מאיר אלא בתוך שנתו והכא חוץ לשנתו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אנן קיימין אמר רבי חזקיה תנא רבי יהודה גדגניות השלחן והמנורה והמזבחות",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "והפרוכת מעכבים את הקרבנות דברי רבי מאיר וחכמים אומרים אין לך מעכב את",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הקרבן אלא הכיור והכן בלבד ולא כן אמר רבי אליעזר ורבי יוסי בן חנינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תריהון אמרין כל הן דכתיב נכח מעכב צלע אינו מעכב ואמר רבי שמואל בר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נחמן בשם רבי יונתן ואפילו צלע מעכב ואמר רבי אילא בשם",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
