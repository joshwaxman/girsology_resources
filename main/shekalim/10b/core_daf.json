        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשון של זהורית לבד לחלק בין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשון של זהורית זה ללשון של",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעיר המשתלח: <b>כבש פרה.</b> שהיו",
