      "right": "0px",
      "left": "",
      "text": "<b>לעזאזל באין מתרומת הלשכה.</b> אף",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על גב דפרה אינה נשחטת בעזרה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
