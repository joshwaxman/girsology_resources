      "left": "0px",
      "top": 539,
      "height": 1321,
      "basis": "scan",
      "top_frac": 0.1908,
      "height_frac": 0.8092,
      "printed_y": [
        221.7,
        784.8
      ],
      "printed_body_y": [
        88.9,
        784.8
      ],
      "note_he": "תוספת שלנו. פני משה אינו נדפס בדף זה כלל — במלבן הזה הדפיסו תקלין חדתין, שאינו מצוי במהדורה דיגיטלית. הטקסט מספריא (פיוטרקוב תרנ״ח–תר״ס), ואינו חלק מצורת הדף הנדפסת.",
      "note_en": "OUR ADDITION. Penei Moshe is not printed on this leaf at all — this rectangle is where the press set Tiklin Chadtin, which is in no digital edition. The text is Sefaria's (Piotrków, 1898-1900) and is not part of the printed page.",
      "printed_work_he": "תקלין חדתין",
      "printed_work_en": "Tiklin Chadtin",
      "source_ref": "Penei Moshe on Jerusalem Talmud Shekalim",
      "lines": [
        {
          "width": "216px",
          "text": "גמ' <b>ר' זעירא שאל ר'</b>"
        },
        {
          "width": "216px",
          "text": "<b>אושעיא כמה היא שיעורן של</b>"
        },
        {
          "width": "216px",
          "text": "<b>הקופות.</b> כצ\"ל וכך הוא"
        },
        {
          "width": "216px",
          "text": "בריש פרק מפנין דהתם היא"
        },
        {
          "width": "216px",
          "text": "דקאי השאלה דר' זעירא"
        },
        {
          "width": "216px",
          "text": "דתנינן מפנין אפי' ד' וה'"
        },
        {
          "width": "216px",
          "text": "קופות וכמה שיעורן של"
        },
        {
          "width": "216px",
          "text": "הקופות. וכך הוא נשנה"
        },
        {
          "width": "216px",
          "text": "בריש פרק המוציא יין"
        },
        {
          "width": "216px",
          "text": "ומשולש עוד בריש פרק ערבי"
        },
        {
          "width": "216px",
          "text": "פסחים ועל זה השיבו נלמוד"
        },
        {
          "width": "216px",
          "text": "סתום דהתם מן המפורש דהכא"
        },
        {
          "width": "216px",
          "text": "דסתם קופות שנשנה שם ג\"כ"
        },
        {
          "width": "216px",
          "text": "של ג' ג' סאין הן וכה\"ג"
        },
        {
          "width": "216px",
          "text": "אמרינן נמי שם וכן הכא"
        },
        {
          "width": "216px",
          "text": "לקמן על שאמרו במתני' יין"
        },
        {
          "width": "216px",
          "text": "כדי מזיגת הכוס ושאלו רבי"
        },
        {
          "width": "216px",
          "text": "זעירא וכמה הוא שיעור"
        },
        {
          "width": "216px",
          "text": "הכוסות והשיבו ילמד סתום"
        },
        {
          "width": "216px",
          "text": "מן המפורש דתני רבי חייה"
        },
        {
          "width": "216px",
          "text": "ארבע כוסות של פסח ישנן"
        },
        {
          "width": "216px",
          "text": "רביעית יין האיטלקי: <b>תני</b>"
        },
        {
          "width": "216px",
          "text": "<b>בשלש קופות וכו' שהן תשעה</b>"
        },
        {
          "width": "216px",
          "text": "<b>סאין.</b> שבאלו הג' קופות"
        },
        {
          "width": "216px",
          "text": "תורמין: <b>שהן עשרים ושבע</b>"
        },
        {
          "width": "216px",
          "text": "<b>סאין.</b> על כרחך לא קאי האי"
        },
        {
          "width": "216px",
          "text": "שהן אכל ג' פרקים של"
        },
        {
          "width": "216px",
          "text": "התרומה ולומר שבין הכל"
        },
        {
          "width": "216px",
          "text": "כ\"ז סאין הן שהרי מסיים"
        },
        {
          "width": "216px",
          "text": "ואומר תורמין את הלשכה"
        },
        {
          "width": "216px",
          "text": "משמע דבכל זמן וזמן"
        },
        {
          "width": "216px",
          "text": "התרומה היה שם כ\"ז סאין"
        },
        {
          "width": "216px",
          "text": "ואי אתה מוצא כן אא\"כ"
        },
        {
          "width": "216px",
          "text": "נפרש שהיו שם עוד שלש"
        },
        {
          "width": "216px",
          "text": "קופות גדולות שכל אחת"
        },
        {
          "width": "216px",
          "text": "ואחת מחזקת תשע סאין ובהן"
        },
        {
          "width": "216px",
          "text": "היתה תרומת הלשכה ועליהן"
        },
        {
          "width": "216px",
          "text": "קאמר שהן כ\"ז סאין ולפי"
        },
        {
          "width": "216px",
          "text": "שמהן היו תורמין בכל פעם"
        },
        {
          "width": "216px",
          "text": "ופעם באותן ג' קופות"
        },
        {
          "width": "216px",
          "text": "קטנות של ג' ג' סאין"
        },
        {
          "width": "216px",
          "text": "כדפרישית במתני' ועוד"
        },
        {
          "width": "216px",
          "text": "אפרש לקמן בהלכה ד' בס\"ד:"
        },
        {
          "width": "216px",
          "text": "<b>וכתוב עליהן.</b> על אלו ג'"
        },
        {
          "width": "216px",
          "text": "קופות הקטנות וכו' ומפני"
        },
        {
          "width": "216px",
          "text": "מה כתוב עליהן וכו' לומר"
        },
        {
          "width": "216px",
          "text": "אין מסתפק מן הראשונה"
        },
        {
          "width": "216px",
          "text": "קודם לשניה. כלומר שאין"
        },
        {
          "width": "216px",
          "text": "מסתפק מן הראשונה מעט מעט"
        },
        {
          "width": "216px",
          "text": "ממנה וחוזר לשניה"
        },
        {
          "width": "216px",
          "text": "ולשלישית ולאח\"כ יסתפק"
        },
        {
          "width": "216px",
          "text": "עוד מעט מן הראשונה"
        },
        {
          "width": "216px",
          "text": "ואחריה מן השניה ואחריה"
        },
        {
          "width": "216px",
          "text": "מן השלישית והכל במעט מעט"
        },
        {
          "width": "216px",
          "text": "מהן עד שיכלו לא יעשה כן"
        },
        {
          "width": "216px",
          "text": "וזהו דקאמר אין מסתפק מן"
        },
        {
          "width": "216px",
          "text": "הראשונה קודם לשנייה"
        },
        {
          "width": "216px",
          "text": "וכלומר שירצה להסתפק מעט"
        },
        {
          "width": "216px",
          "text": "מהראשונה קודם להשנייה"
        },
        {
          "width": "216px",
          "text": "ומן השנייה מעט קודם"
        },
        {
          "width": "216px",
          "text": "להשלישית ואח\"כ יחזור"
        },
        {
          "width": "216px",
          "text": "חלילה אלא כך יעשה יסתפק"
        },
        {
          "width": "216px",
          "text": "מן הראשונה עד שתכלה כולה"
        },
        {
          "width": "216px",
          "text": "ואח\"כ הוא שיתחיל להסתפק"
        },
        {
          "width": "216px",
          "text": "מן השנייה וכן כשתכלה"
        },
        {
          "width": "216px",
          "text": "השניה אז יסתפק מן"
        },
        {
          "width": "216px",
          "text": "השלישית ולפי פירוש הזה"
        },
        {
          "width": "216px",
          "text": "הוא ממש כמו שנשנה"
        },
        {
          "width": "216px",
          "text": "בתוספתא שלמה ראשונה"
        },
        {
          "width": "216px",
          "text": "מוציאין מן השניה וכו'"
        },
        {
          "width": "216px",
          "text": "וכמו שהבאתי בפירוש"
        },
        {
          "width": "216px",
          "text": "המשנה: <b>תמן תנינן המוציא</b>"
        },
        {
          "width": "216px",
          "text": "<b>יין וכו'.</b> כל הסוגיא זו"
        },
        {
          "width": "216px",
          "text": "כתובה היא לעיל ריש פרק"
        },
        {
          "width": "216px",
          "text": "המוציא עד א\"ל רב אבדומה"
        },
        {
          "width": "216px",
          "text": "נחיתה ויאות ר' יהודה"
        },
        {
          "width": "216px",
          "text": "מוריינא דנשייא הוה. וכאן"
        },
        {
          "width": "216px",
          "text": "נדפס זה בערבובי האותיות"
        },
        {
          "width": "216px",
          "text": "והתיבות וע\"ש ותמצא הכל"
        },
        {
          "width": "216px",
          "text": "מבואר בבאר היטב בס\"ד:"
        }
