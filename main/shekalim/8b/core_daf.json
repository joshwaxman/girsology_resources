  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "נלמוד סתום מן המפורש דתניא בשלש קופות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של שלש שלש סאין שהן תשעה סאין שהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשרים ושבע סאין תורמין את הלשכה וכתוב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליהן אלף בית גימל מפני מה כתוב עליהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלף בית גימל לומר מסתפק מן הראשונה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודם לשניה ומן השניה קודם לשלישית תמן",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנינן המוציא יין כדי מזיגת הכוס רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זעירא שאל את רבי יאשיה כמה שיעורן של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כוס אמר ליה נלמד סתום מן המפורש דתני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חייא ארבע כוסות שאמרו ישנן רביעית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של יין באיטלקי אמר רבי יוסי בר אבין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום רבי יוחנן דרבי יהודה היא דתני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמים כדי גמיע רבי יהודה אומר כדי לשוף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהן את הקילור יין כדי גמיע רבי יהודה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר כדי מזיגת הכוס מזוג בכמה נשמעינה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הדא מים כדי גמיע רבי יהודה אומר כדי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשוף בהן את הקילור יין כדי גמיע רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אומר כדי מזיגת הכוס הדא אמרה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מזוג כדי מזיגת הכוס כמה שיעורן של כוס",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אבין אמר טיטרטון ורביע מהו לשתותן",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בכרך אחד מדאמר רבי מנא אמר רבי יוסי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלל אם שמען בבית הכנסת יצא הדא אמרה אם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתאן בכרך אחד יצא מהו לשתותן בפיסקן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום אמרו שישתה לא כדי שישתה ולא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שישתכר אם שתה בפיסקן אף הוא אינו משתכר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מהו לצאת ביין של שביעית תני רב אושעיא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוצאין ביין של שביעית מהו לצאת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקונדיטין מדתני בר קפרא קונדיטין כיין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדא אמרה יוצאין ביין קונדיטין מהו לצאת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביין מזוגין מדתני רב חייא ארבעה כוסות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאמרו יוצאין בהן בין חיין ובין מזוגין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובלבד שיהא בהן טעם ומראה יין אמר רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירמיה מצוה לצאת ביין אדום שנאמר אל תרא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יין כי יתאדם כי יתן בכוס עינו וגו׳",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תאני מבושל כמתובל מהו לצאת ביין מבושל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יונה יוצאין ביין מבושל רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יונה לטעמיה דרבי יונה כד הוה שתי ארבע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כסי דפסחא הוה חזיק רישא עד חגא חמיתיה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חדא מטרוניתא אפוי נהירין אמרה סבא סבא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חדא מהני תלת מלין אית בך או דשתוי חמרא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את או דמלוי בריבית את או דמגדל חזירי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את אמר ליה תיפח רוחא דההיא איתתא דחדא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאלין תלת מיליא לית בי אלא אולפני שכיח",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לי דהכי כתיב חכמת אדם תאיר פניו רבי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבהו אתי לטבריא חמוניה תלמידוי דרבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן אפוי נהורין אמרון תלמידים לרבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן אשכח רבי אבהו סימא אתא לגביה אמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה מאי אורייתא חדתא שמעת אמר ליה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תוספתא עתיקא קרא עליה חכמת אדם תאיר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פניו אמר רבי חנין לוגא דאורייתא תמונתא",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עתיקא דמורייסא דציפורי אמר רבי יונה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחכמנא לה דבית רבי ינאי הוה מכילין בה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבש תני חצי שמינית טברנית",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גמ' <b>כמה הוא שיעורן של קופות.</b> אהא דתנן בפ' מפנין אפילו ד' וה' קופות של תבן וכו' קאי כמה מדות תהא מכילה הקופה:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>נלמד סתום מן המפורש.</b> דבמתניתין תנן בקופות של ג' ג' סאין היו תורמין ה\"ה קופות דמפנין בשל ג' סאין איירי: <b>תני בג'</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>קופות וכו'.</b> על אותן קופות שתרמו בהן בראשונה מן הלשכה קאי וכדפרישית במתניתין וקאמר שהן היו של ט' סאין כל אחת",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומהן היו תורמין ג' פעמים ג' קופות של ג' ג' סאין כפירוש הרמב\"ם: <b>לומר ליסתפק וכו'.</b> כדפרישית במתניתין: <b>תמן תנינן.</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשבת פרק המוציא יין כמה הוא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיעורן של כוסות. כוס הנזכר",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתניתין כמה שיעורו: <b>ישנן</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רביעית של יין האיטלקי.</b> דלכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כוס סגי ברובע רביעית יין כדי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שימזגנו ויעמוד על רביעית דכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חמרא דלא דרי על [חד] תלת מיא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאו חמרא ה\"ה כוס דמתניתין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכוס של רובע רביעית איירי:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מזוג בכמה.</b> יהא חייב מי בעינן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רביעית שלם או סגי בכדי גמיעה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(בפחות מזה): <b>מים רי\"א כדי</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מזיגת הכוס.</b> והיינו ג' חלקי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רביעית ה\"נ במזוג שיעור בכדי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמיעה: (אמר המגיה ובמסכת שבת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתב הבעל קרבן עדה וז\"ל הדא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרה מזוג כדי מזיגת הכוס.",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"פ כדרך בני אדם למזוג",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו רביעית שלם דאי ס\"ד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפחות מרביעית א\"כ ביין סגי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפחות מרובע רביעית שהרי אם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימזגנו עם מים יהיה לו שיעור",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חשוב אלא ודאי דרביעית שלם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעינן): <b>כמה הוא שיעורן של</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כוסות.</b> אנו שאין ידוע לנו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיעורו של רביעית האיטלקי במה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נשער כוס של פסח: <b>טיטרטון</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ורביע.</b> מדה ששמה טיטרטון כולה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ועוד רביעית המדה הזאת תוסיף",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליה ותמצא רביעית של תורה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלם: <b>מהו לשתותן.</b> כל הארבע",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כוסות בכרך אחד בזה אחר זה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלי הפסק בינתים: <b>בהלל.</b> של",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לילי פסחים אם שמעה בבית",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכנסת שכך היה מנהגם לומר הלל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלילי פסחים בבה\"כ זכר למקדש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאמרו הלל בשעת עשיית הפסח",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בבה\"מ וקאר\"י אם כיוון לבו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לצאת בקריאה זו יצא וא\"צ",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאומרו עוד בביתו: <b>הדא אמרה.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זאת אומרת שאם שתאן בבת אחת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יצא שהרי אין דבר מפסיק בין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלישי לרביעי: <b>מהו לשתותן</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מפוסקין.</b> פירוש מהו שיהא מותר",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להפסיק בשתיית כוס אחד כמה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פעמים: ה\"ג כלום אמרו שישתה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא שישתכר: <b>אם שותה הוא</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מפוסקין אף הוא אינו משתכר.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל אם ישתה בפעם אחת דוקא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא משתכר דיין מגרונו שבע:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מהו לצאת ביין של שביעית.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון דלא קרינן ביה לכם וקס\"ד",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דארבע כוסות בעינן לכם כמו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצה וכי היכא דאין יוצאין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במצה כן אין יוצאין בארבע",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כוסות או לא: <b>בקונדיטין.</b> יין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש בו בשמים: <b>מהו לצאת</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מזוגין.</b> יותר מג' חלקים: <b>והוא</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שיהא בהן טעם יין.</b> משמע דאפי'",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עד ששה חלקים מים יוצאין בו:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ה\"ג מבושל כדי תבל.</b> צריך שיהא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מבושל שיתן בו הבישול טעם כתבלין אבל מבושל יותר מדאי לא: <b>וחזיק רישיה.</b> וכאיב ליה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ראשו עד עצרת לכך הכשיר במבושל שאינו מזיק כל כך: <b>חמתיה וכו'.</b> ראתה אותו אשה אחת",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משרי ארמיים שפניו מאירין: <b>חדא מן תלת וכו'.</b> א' מג' דברים אלו בך: <b>או מלוה</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בריבית.</b> שאין לו דאגת פרנסתו: <b>או מגדל חזירין.</b> שמרויח הרבה: <b>אלא אילפני שכיח לי.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תלמודי מצוי בידי. ל\"א שמצוי לו לחדש דברים בתורה והן מאירין פניו: <b>חמוניה.</b> ראו",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותו: <b>אשכח רבי אבהו.</b> מציאה לכך פניו צהובין: <b>תוספתא עתיקתא.</b> תוספתא ישנה שלא ראה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותה מימיו מצא וראה בה דברים חדשים ושמח בה:",
      "gemara_segment_ids": [
        5
      ]
    }
  ],
