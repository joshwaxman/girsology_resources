  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "נלמוד סתום מן המפורש דתניא בשלש קופות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של שלש שלש סאין שהן תשעה סאין שהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשרים ושבע סאין תורמין את הלשכה וכתוב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליהן אלף בית גימל מפני מה כתוב עליהן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלף בית גימל לומר מסתפק מן הראשונה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודם לשניה ומן השניה קודם לשלישית תמן",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנינן המוציא יין כדי מזיגת הכוס רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זעירא שאל את רבי יאשיה כמה שיעורן של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כוס אמר ליה נלמד סתום מן המפורש דתני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חייא ארבע כוסות שאמרו ישנן רביעית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של יין באיטלקי אמר רבי יוסי בר אבין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום רבי יוחנן דרבי יהודה היא דתני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמים כדי גמיע רבי יהודה אומר כדי לשוף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהן את הקילור יין כדי גמיע רבי יהודה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר כדי מזיגת הכוס מזוג בכמה נשמעינה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הדא מים כדי גמיע רבי יהודה אומר כדי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשוף בהן את הקילור יין כדי גמיע רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אומר כדי מזיגת הכוס הדא אמרה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מזוג כדי מזיגת הכוס כמה שיעורן של כוס",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אבין אמר טיטרטון ורביע מהו לשתותן",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בכרך אחד מדאמר רבי מנא אמר רבי יוסי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלל אם שמען בבית הכנסת יצא הדא אמרה אם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתאן בכרך אחד יצא מהו לשתותן בפיסקן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום אמרו שישתה לא כדי שישתה ולא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שישתכר אם שתה בפיסקן אף הוא אינו משתכר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מהו לצאת ביין של שביעית תני רב אושעיא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוצאין ביין של שביעית מהו לצאת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקונדיטין מדתני בר קפרא קונדיטין כיין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדא אמרה יוצאין ביין קונדיטין מהו לצאת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביין מזוגין מדתני רב חייא ארבעה כוסות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאמרו יוצאין בהן בין חיין ובין מזוגין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובלבד שיהא בהן טעם ומראה יין אמר רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירמיה מצוה לצאת ביין אדום שנאמר אל תרא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יין כי יתאדם כי יתן בכוס עינו וגו׳",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תאני מבושל כמתובל מהו לצאת ביין מבושל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יונה יוצאין ביין מבושל רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יונה לטעמיה דרבי יונה כד הוה שתי ארבע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כסי דפסחא הוה חזיק רישא עד חגא חמיתיה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חדא מטרוניתא אפוי נהירין אמרה סבא סבא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חדא מהני תלת מלין אית בך או דשתוי חמרא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את או דמלוי בריבית את או דמגדל חזירי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את אמר ליה תיפח רוחא דההיא איתתא דחדא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מאלין תלת מיליא לית בי אלא אולפני שכיח לי דהכי כתיב חכמת אדם תאיר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "פניו רבי אבהו אתי לטבריא חמוניה תלמידוי דרבי יוחנן אפוי נהורין אמרון",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "תלמידים לרבי יוחנן אשכח רבי אבהו סימא אתא לגביה אמר ליה מאי אורייתא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חדתא שמעת אמר ליה תוספתא עתיקא קרא עליה חכמת אדם תאיר פניו אמר רבי",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חנין לוגא דאורייתא תמונתא עתיקא דמורייסא דציפורי אמר רבי יונה וחכמנא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לה דבית רבי ינאי הוה מכילין בה דבש תני חצי שמינית טברנית",
      "segment_ids": [
        6
      ]
    }
  ],
