  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ובשעת הרגל שהבשר מרובה אף איברים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותרות <b>גמ׳</b> לא צורכה דלא בהר הבית קודש",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי בא רבי חייה בשם רבי יוחנן חזקה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין הכהן מוציא מן הלשכה מעות עד שהוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחללן על הבהמה בשר שנמצא כו׳ רבי לעזר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי הושעיה הסיע דעת טעון עיבור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורה אמר רבי הושעיה מתניתין אמרה כן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תעובר צורתו ויצא לבית השריפה אמר רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי ויאות לאכלו אין את יכול שמא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נתקלקל צורתו לפום כן צריך מימר תעובר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורתו ויצא לבית השריפה נמצא בגבולין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כו׳ רבי קריספא בשם רבי יוסי ברבי חנינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איברים נבילות לוקין עליהן משום נבילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתא אמרה כן איברי נבילות וחתיכות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותרות חתיכות מותרות לא ממש ודכוותה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איברים נבילות לוקין עליהן משום נבילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי קריספא בשם רבי יוסי ברבי חנינה אם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היו מחרוזות מותרות תשע חנויות מוכרות בשר נבילה ואחת מוכרת בשר שחוטה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נתחלפו לו חושש ולנמצאת הולכין אחר הרוב תשע חנויות מוכרות בשר שחוטה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואחת מוכרת בשר נבילה נתחלפו לו חושש ולנמצאת הולכין אחר הרוב אמר רבי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יוחנן הנמצא ביד גוי כנמצא בפלטיא רבי לעזר בי רבי חגיי הוה מסמך לרבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מנא חמא לחד ארמאי מקטע מן סוסיה ומפיק לברא אמר ליה הדא היא דאמר רבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יוחנן הנמצאה ביד גוי כנמצא בפלטיא אמר ליה כן אמר רבי יוסי רבי והן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שראו אותו יוצא ממקולין של ישראל חד בר נש בציפורין אזיל בעי מיזבון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "קופד מן טבחא ולא יהב ליה אמר ליה לחד רומיי ואייתי ליה אמר ליה לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נסבית על כרחיה אמר ליה ולאו בשר דנבילה יהבית ליה רבי ירמיה בשם רבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "חנינה מעשה בא לפני רבי ואמר לא כולא מיניה מיסר מקולין דציפורין רב נחת",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לתמן חמתון מקילין וחמר עליהן חד בר נש אזיל",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' ופריך <b>לא צורכא.</b> לא ה\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתנא למתני אלא בהר הבית קדש",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דודאי מתרומת הלשכה נפל שהרי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין אדם רשאי לכנוס לשם במעות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צרורין בסדינן: <b>חזקה שאין</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הכהן.</b> הגזבר אין מוציא מעות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הלשכה אלא אם כן נתחלל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלכך כל הנמצא בהר הבית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חולין: <b>הסיע דעת.</b> היסח הדעת",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הקדשים אע\"ג דפסולין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעונין עיבור צורה קודם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שריפתו: מתניתא אמרה כן כלומר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' נמי דייקי: <b>ויאות.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתמיה וכי שפיר קאמרת דלמא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתני' אין הטעם משום היסח",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדעת דכל שהוא בעזרה לא מיקרי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היסח הדעת דליכא למיחש לשום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טומאה והכא היינו טעמא דפסול",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמא כבר נתעברה צורתו לפיכך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעון עיבור צורה ודאי אבל כל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנפסל בהיסח הדעת בודאי אפי'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עיבור צורה אין צריך: <b>לוקין</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עליה משום נבילה.</b> דודאי נבלה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא: <b>חתיכות מותרות לא ממש.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמותרות לאכול ה\"נ איברים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נבלות נבלות ממש דלוקין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עלייהו: <b>אם היו מחרוזות.</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קשורות זו בזו מותרות דודאי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפלו מיד אדם בשוגג: <b>נתחלפו</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לו.</b> אינו יודע איזו היא:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חושש.</b> ומספיקא אסורות כולן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל אין לוקין עליו דכל קבוע",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמחצה על מחצה דמי: <b>ולנמצאות</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הולכין אחר הרוב.</b> דכל דפריש מרובא פריש וכודאי טריפה הוא ולוקין עליו וכן אם הרוב כשירות אם פריש מותר אפילו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "באכילה: <b>הנמצא ביד עכו\"ם.</b> בשר הנמצא ביד עכו\"ם כאילו נמצא ברה\"ר אם רוב טבחי ישראל מותר: <b>הוה מסמך.</b> היה סמיך על רבי",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מנא וראה עכו\"ם א' חותך בשר מן הסוס ויוצא לחוץ: <b>א\"ל הא דאר\"י הנמצא ביד עכו\"ם כנמצא ברה\"ר.</b> ומותר אמאי ניחוש דלמא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מן בהמתו חתך ואפי' מקולין וטבחי ישראל נינהו יש לאוסרו: <b>א\"ל.</b> הכי אר\"י רבי והוא שראו העכו\"ם יוצא מן המקולין של",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ישראל אז סמכינן להתירו: <b>חד בר נש וכו'.</b> אדם אחד בציפורי הלך ליקח בשר מן הטבח ולא נתן לו: <b>א\"ל.</b> לחד עכו\"ם שיקח לו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והביא לו: <b>א\"ל.</b> האי בר נש לטבח לא לקחתי בע\"כ ממך שהעכו\"ם הביא לי: <b>אמר.</b> הטבח ולאו בשר נבילה מכרתי להעכו\"ם: <b>מעשה</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>זה בא לפני רבי.</b> ושאל לו אם נאמן הטבח לאסרו: <b>ואמר.</b> רבי לאו כל כמיניה לאסור מקולין דציפורי וכיון שלא הכריזו טריפה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בו ביום הבשר מותר:",
      "gemara_segment_ids": [
        5
      ]
    }
  ],
