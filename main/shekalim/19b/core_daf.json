  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ובשעת הרגל שהבשר מרובה אף איברים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותרות <b>גמ׳</b> לא צורכה דלא בהר הבית קודש",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי בא רבי חייה בשם רבי יוחנן חזקה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין הכהן מוציא מן הלשכה מעות עד שהוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחללן על הבהמה בשר שנמצא כו׳ רבי לעזר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי הושעיה הסיע דעת טעון עיבור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורה אמר רבי הושעיה מתניתין אמרה כן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תעובר צורתו ויצא לבית השריפה אמר רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי ויאות לאכלו אין את יכול שמא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נתקלקל צורתו לפום כן צריך מימר תעובר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורתו ויצא לבית השריפה נמצא בגבולין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כו׳ רבי קריספא בשם רבי יוסי ברבי חנינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איברים נבילות לוקין עליהן משום נבילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתא אמרה כן איברי נבילות וחתיכות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותרות חתיכות מותרות לא ממש ודכוותה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איברים נבילות לוקין עליהן משום נבילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי קריספא בשם רבי יוסי ברבי חנינה אם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו מחרוזות מותרות תשע חנויות מוכרות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשר נבילה ואחת מוכרת בשר שחוטה נתחלפו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו חושש ולנמצאת הולכין אחר הרוב תשע",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנויות מוכרות בשר שחוטה ואחת מוכרת בשר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נבילה נתחלפו לו חושש ולנמצאת הולכין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחר הרוב אמר רבי יוחנן הנמצא ביד גוי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כנמצא בפלטיא רבי לעזר בי רבי חגיי הוה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסמך לרבי מנא חמא לחד ארמאי מקטע מן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סוסיה ומפיק לברא אמר ליה הדא היא דאמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוחנן הנמצאה ביד גוי כנמצא בפלטיא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר ליה כן אמר רבי יוסי רבי והן שראו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו יוצא ממקולין של ישראל חד בר נש",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בציפורין אזיל בעי מיזבון קופד מן טבחא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא יהב ליה אמר ליה לחד רומיי ואייתי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה אמר ליה לא נסבית על כרחיה אמר ליה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולאו בשר דנבילה יהבית ליה רבי ירמיה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי חנינה מעשה בא לפני רבי ואמר לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולא מיניה מיסר מקולין דציפורין רב נחת",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לתמן חמתון מקילין וחמר עליהן חד בר נש",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אזיל",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גמ' ופריך <b>לא צורכא.</b> לא ה\"ל לתנא למתני אלא בהר הבית קדש דודאי מתרומת הלשכה נפל שהרי אין אדם רשאי לכנוס לשם במעות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צרורין בסדינן: <b>חזקה שאין הכהן.</b> הגזבר אין מוציא מעות מן הלשכה אלא אם כן נתחלל הלכך כל הנמצא בהר הבית חולין: <b>הסיע</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דעת.</b> היסח הדעת מן הקדשים אע\"ג דפסולין טעונין עיבור צורה קודם שריפתו: מתניתא אמרה כן כלומר מתני' נמי דייקי:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ויאות.</b> בתמיה וכי שפיר קאמרת דלמא במתני' אין הטעם משום היסח הדעת דכל שהוא בעזרה לא מיקרי היסח הדעת דליכא למיחש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשום טומאה והכא היינו טעמא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפסול שמא כבר נתעברה צורתו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפיכך טעון עיבור צורה ודאי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל כל שנפסל בהיסח הדעת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בודאי אפי' עיבור צורה אין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך: <b>לוקין עליה משום נבילה.</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דודאי נבלה היא: <b>חתיכות</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מותרות לא ממש.</b> דמותרות לאכול",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"נ איברים נבלות נבלות ממש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלוקין עלייהו: <b>אם היו</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מחרוזות.</b> קשורות זו בזו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותרות דודאי נפלו מיד אדם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשוגג: <b>נתחלפו לו.</b> אינו יודע",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איזו היא: <b>חושש.</b> ומספיקא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אסורות כולן אבל אין לוקין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו דכל קבוע כמחצה על מחצה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמי: <b>ולנמצאות הולכין אחר</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הרוב.</b> דכל דפריש מרובא פריש",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכודאי טריפה הוא ולוקין עליו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכן אם הרוב כשירות אם פריש",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר אפילו באכילה: <b>הנמצא ביד</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עכו\"ם.</b> בשר הנמצא ביד עכו\"ם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כאילו נמצא ברה\"ר אם רוב טבחי",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישראל מותר: <b>הוה מסמך.</b> היה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סמיך על רבי מנא וראה עכו\"ם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א' חותך בשר מן הסוס ויוצא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחוץ: <b>א\"ל הא דאר\"י הנמצא ביד</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עכו\"ם כנמצא ברה\"ר.</b> ומותר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמאי ניחוש דלמא מן בהמתו חתך",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואפי' מקולין וטבחי ישראל",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נינהו יש לאוסרו: <b>א\"ל.</b> הכי",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אר\"י רבי והוא שראו העכו\"ם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוצא מן המקולין של ישראל אז",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
