  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ובשעת הרגל שהבשר מרובה אף איברים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותרות <b>גמ׳</b> לא צורכה דלא בהר הבית קודש",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי בא רבי חייה בשם רבי יוחנן חזקה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין הכהן מוציא מן הלשכה מעות עד שהוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחללן על הבהמה בשר שנמצא כו׳ רבי לעזר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי הושעיה הסיע דעת טעון עיבור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורה אמר רבי הושעיה מתניתין אמרה כן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תעובר צורתו ויצא לבית השריפה אמר רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי ויאות לאכלו אין את יכול שמא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נתקלקל צורתו לפום כן צריך מימר תעובר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורתו ויצא לבית השריפה נמצא בגבולין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כו׳ רבי קריספא בשם רבי יוסי ברבי חנינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איברים נבילות לוקין עליהן משום נבילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתא אמרה כן איברי נבילות וחתיכות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותרות חתיכות מותרות לא ממש ודכוותה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איברים נבילות לוקין עליהן משום נבילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי קריספא בשם רבי יוסי ברבי חנינה אם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו מחרוזות מותרות תשע חנויות מוכרות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשר נבילה ואחת מוכרת בשר שחוטה נתחלפו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו חושש ולנמצאת הולכין אחר הרוב תשע",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנויות מוכרות בשר שחוטה ואחת מוכרת בשר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נבילה נתחלפו לו חושש ולנמצאת הולכין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחר הרוב אמר רבי יוחנן הנמצא ביד גוי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כנמצא בפלטיא רבי לעזר בי רבי חגיי הוה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסמך לרבי מנא חמא לחד ארמאי מקטע מן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סוסיה ומפיק לברא אמר ליה הדא היא דאמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוחנן הנמצאה ביד גוי כנמצא בפלטיא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר ליה כן אמר רבי יוסי רבי והן שראו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו יוצא ממקולין של ישראל חד בר נש",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בציפורין אזיל בעי מיזבון קופד מן טבחא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא יהב ליה אמר ליה לחד רומיי ואייתי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה אמר ליה לא נסבית על כרחיה אמר ליה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולאו בשר דנבילה יהבית ליה רבי ירמיה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי חנינה מעשה בא לפני רבי ואמר לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולא מיניה מיסר מקולין דציפורין רב נחת",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לתמן חמתון מקילין וחמר עליהן חד בר נש",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אזיל",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' ופריך <b>לא צורכא.</b> לא ה\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתנא למתני אלא בהר הבית קדש",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דודאי מתרומת הלשכה נפל שהרי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין אדם רשאי לכנוס לשם במעות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צרורין בסדינן: <b>חזקה שאין</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הכהן.</b> הגזבר אין מוציא מעות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הלשכה אלא אם כן נתחלל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלכך כל הנמצא בהר הבית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חולין: <b>הסיע דעת.</b> היסח הדעת",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הקדשים אע\"ג דפסולין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעונין עיבור צורה קודם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שריפתו: מתניתא אמרה כן כלומר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' נמי דייקי: <b>ויאות.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתמיה וכי שפיר קאמרת דלמא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתני' אין הטעם משום היסח",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדעת דכל שהוא בעזרה לא מיקרי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היסח הדעת דליכא למיחש לשום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טומאה והכא היינו טעמא דפסול",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמא כבר נתעברה צורתו לפיכך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעון עיבור צורה ודאי אבל כל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנפסל בהיסח הדעת בודאי אפי'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עיבור צורה אין צריך: <b>לוקין</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עליה משום נבילה.</b> דודאי נבלה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא: <b>חתיכות מותרות לא ממש.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמותרות לאכול ה\"נ איברים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נבלות נבלות ממש דלוקין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עלייהו: <b>אם היו מחרוזות.</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קשורות זו בזו מותרות דודאי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפלו מיד אדם בשוגג: <b>נתחלפו</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לו.</b> אינו יודע איזו היא:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חושש.</b> ומספיקא אסורות כולן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל אין לוקין עליו דכל קבוע",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמחצה על מחצה דמי: <b>ולנמצאות</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הולכין אחר הרוב.</b> דכל דפריש",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מרובא פריש וכודאי טריפה הוא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולוקין עליו וכן אם הרוב",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשירות אם פריש מותר אפילו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באכילה: <b>הנמצא ביד עכו\"ם.</b> בשר",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנמצא ביד עכו\"ם כאילו נמצא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברה\"ר אם רוב טבחי ישראל",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר: <b>הוה מסמך.</b> היה סמיך על",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבי מנא וראה עכו\"ם א' חותך",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר מן הסוס ויוצא לחוץ: <b>א\"ל</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הא דאר\"י הנמצא ביד עכו\"ם כנמצא ברה\"ר.</b> ומותר אמאי ניחוש דלמא מן בהמתו חתך ואפי'",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקולין וטבחי ישראל נינהו יש לאוסרו: <b>א\"ל.</b> הכי אר\"י רבי והוא שראו העכו\"ם יוצא מן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המקולין של ישראל אז סמכינן להתירו: <b>חד בר נש וכו'.</b> אדם אחד בציפורי הלך ליקח בשר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מן הטבח ולא נתן לו: <b>א\"ל.</b> לחד עכו\"ם שיקח לו והביא לו: <b>א\"ל.</b> האי בר נש לטבח לא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לקחתי בע\"כ ממך שהעכו\"ם הביא לי: <b>אמר.</b> הטבח ולאו בשר נבילה מכרתי להעכו\"ם: <b>מעשה</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>זה בא לפני רבי.</b> ושאל לו אם נאמן הטבח לאסרו: <b>ואמר.</b> רבי לאו כל כמיניה לאסור",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקולין דציפורי וכיון שלא הכריזו טריפה בו ביום הבשר מותר:",
      "gemara_segment_ids": [
        5
      ]
    }
