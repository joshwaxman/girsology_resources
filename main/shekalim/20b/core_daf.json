  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "עולות אמר רבי זעירא כמה דאת אמר תמן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנאי בית דין הוא על המותרות שיקרבו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עולות כן את מר אוף הכא תנאי בית דין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא על האובדות שיקרבו עולות אמר רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי לרבי יעקב בר אחא אין זה מזיד אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה מכיון שהוא תנאי בית דין אין זה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מזיד אמר רבי יסא עד דאנא תמן שמעית קל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב יהודה שאל לשמואל הפריש שקלו ומת אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה יפלו לנדבה ומותר עשירית האיפה שלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוחנן אמר יוליכם לים המלח רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר אמר יפלו לנדבה עשירית האיפה של",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כהן גדול רבי יוחנן אמר חוצה אותה ואחר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כך מקדשה רבי שמעון בן לקיש אמר מקדשה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואחר כך חוצה אותה מתניתא פליגי על רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן מקריב מחצה ומחצה אבד פתר לה שכן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו מעות ילכו לים המלח מתניתא פליגי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על רבי שמעון בן לקיש נמצאו שני חצאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קריבין ושני חצאין אבודין ותני עלה מחצה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשון ומחצה שני תעובר צורתן ויצאו לבית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השריפה פתר לה כרבי ישמעאל דאמר עשרון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקדש כשהכהן מתקרב תחילה לעבודה מביא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשירית האיפה שלו ועובדה בידו אחד כהן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדול ואחד כהן הדיוט שעבדו עד שלא הביאו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשירית האיפה שלהם עבודתן כשירה רבי מנא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעי מימר בו ביום שנתקרב תחילה לעבודה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בו ביום נתמנה להיות כהן גדול מביא שתים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחת לחינוכו ואחת לחובת היום תופיני",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשעת הבאה תופיני ואין בשחרית תופיני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והא תנינן העמידו עושה חביתין לעשות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חביתין אמר רבי חייא בר אחא לעשות חמין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרבוכה תופיני רבי יסא בשם רבי חנינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מטגנה ואחר כך אופה אותה רבי אחא בשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חנינה אופה אותה ואחר כך מטגנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תופיני תאפנה נא רבי אומר תאפינה נאה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי דוסא אומר תאפנה ריבה אתיין אלין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פלגוותא כהינין פלגוותא מאן דאמר תאפינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאה כמאן דאמר אופה ואחר כך מטגנה ומאן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמר תאפינה נא כמאן דאמר מטגנה ואחר כך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אופה לא סוף דבר שמת אלא אפילו נטמא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואפילו נדחה ממום תני רבי יהודה בר פזי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר דליה ואפילו נדחה ממום מנין לכהן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדול שמת ולא מינו אחר תחתיו שתהא מנחתו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קריבה משל יורשים תלמוד לומר מבניו יעשה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותה יכול יביאנה לחציים תלמוד לומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותה כולה אמרתי דברי רבי יהודה רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעון אומר אינה באה אלא משל צבור שנאמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חק עולם מי שהברית כרותה לו כליל תקטר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כליל להקטרה כהן גדול שמת וכו׳ רבי בא",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר ממל בעי מחלפה שיטתיה דרבי שמעון תמן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר משל יורשין והכא אמר משל צבור אמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חייה",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עד דאנא תמן.</b> כשהייתי בבבל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמעתי ששאל ר\"י לשמואל הפריש",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקלו ומת מה יעשה בו: <b>מותר</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עשירית האיפה של כה\"ג.</b> כגון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהפריש מעות לעשירית האיפה של",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היום וניתותר שאינו ראוי למחר",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מה יעשה בו: <b>יוליכם לים המלח.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא נהנין ולא מועלין בו: <b>חוצה</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אותה ואח\"כ מקדשה.</b> אבל הכלי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמודדין בו העשרון לא היה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קודש: <b>מקדשה.</b> כל העשרון",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעשרון: <b>ה\"ג מקריב מחצה ומחצה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אבד.</b> כ\"ה במנחות פרק התכלת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואיירי כגון שנטמא מחצה של",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין הערביים שמביא עשרון שלם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחוציהו ומקריב מחצה ומחצה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבד שמעינן דאינה קדושה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחצאין אלא כולו בבת אחת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכיון דלא צריך למחצה השני",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכבר נתקדש הרי הוא אבד וקשיא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לר\"י: <b>שכן אפי' מעות.</b> שניתותר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשירית האיפה סובר ר\"י שילכו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לים המלח דה\"ל מותר עשירית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיפה וכדאמר ר\"י בסמוך וכ\"ש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הסולת שניתותר: ה\"ג מתניתא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פליגא על ר\"י נמצאו וכו':",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נמצאו ב' חציין וכו'.</b> קאי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אכה\"ג שהקריב מחצה שחרית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומינו אחר תחתיו מביא עשרון",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלם וחוצהו ומקריב ומחצה אבד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמצאו ב' חצאין אובדין וב'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חצאים קריבין: <b>תעובר צורתו.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויפסול בלינה וקשיא לר\"י למה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה עיבור צורה ולמה יוצא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבית השריפה הא לא נתקדש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעולם ואי משום מותר עשירית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיפה יוליכם לים המלח אבל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שריפה לא צריך: <b>פתר לה.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למתני' כר\"י דאמר עשרון מקדש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכיון שצריך ליתנו לתוך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העשרון כדי לחצותו דלכ\"ע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למצוה צריך להביא עשרון שלם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מביתו כדי לחצותו א\"כ כבר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתקדש ויוצא לבית השריפה:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כשהכהן מתקרב תחלה לעבודה.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו יום חינוכו צריך להביא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עשירית האיפה משלו שנאמר זה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבן אהרן ובניו אשר יקריבו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה' ביום המשח אותו עשירית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיפה וגו' ובניו היינו כהנים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדיוטים: <b>ועובד בידו.</b> הוא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו מקריבם: <b>בו ביום נתקרב</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בתחלה לעבודה.</b> כהן שלא עבד כל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימיו ונתמנה להיות כהן גדול:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מביא שתים.</b> שתי מנחות מעשירי'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיפה: <b>אחת לחינוכו.</b> ככהן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדיוט: <b>ואחת לחובת היום.</b> שהוא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חביתי כ\"ג שמקריב בכל יום:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תופיני.</b> כתיב מרבכת תביאנה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תפיני וקדריש בשעת הבאה אז תאפנה אבל לא בלילה שלפניו: <b>ואין בשחרית תופיני.</b> היינו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קודם עלות השחר לא יאפו אותן: ופריך <b>והא תנינן.</b> בתמיד פ\"ק: <b>העמידו עושי חביתין.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשחרית קודם עלות השחר לעשותו חביתין. ושמעינן שבלילה היתה נאפית: <b>ומשני לעשות</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>חמין.</b> לרככם העמידוהו אז אבל לאפות לא היו אופין עד עלות השחר (ודברי ה\"ר אליהו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פולדא בסוגיא זו אינן מחוורים): <b>מטגנה.</b> במחבת ואח\"כ אופה אותה בתנור: <b>תיאפנה נא.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשעת אפייתה בתנור תהא נא כמו אל תאכלו ממנה נא כלומר תהא מבושלת קצת ולא כל צרכה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והיינו טגון דבהא מודו כ\"ע דתרווייהו בעינן דכתיב על מחבת בשמן וכתב תופיני:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תיאפנה רכה.</b> אפיות הרבה אופה ומטגנה ואופה: <b>תיאפנה נוי.</b> בשעת אפייתה בתנור תהא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נאה ואם מטגנה תחלה הרי היא שחורה מן השמן ומן המחבת: <b>אתיין אילין פלגוותא וכו'.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר פלוגתא דאמוראי אתיין כפלוגתא דהנך תנאי וכדמסיק: <b>לא סוף דבר שמת.</b> לאו דוקא",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שמת כה\"ג מביא השני עשרון שלם מביתו אלא אפי' נטמא הכה\"ג נמי הדין כן: <b>ואפי' נדחה</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ממום.</b> בעיי' היא אם נדחה הכה\"ג מחמת מום אם קרב מחציתו או משל שני ופשיט מהא דתני",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ריב\"פ מברדליה דאפי' נדחה ממום מביא השני עשרון שלם מביתו: <b>ת\"ל והכהן המשיח תחתיו</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מבניו יעשה אותה.</b> דמשל יורשים קריבה עד שיעמוד אחר: <b>יכול יקריבו.</b> היורשים לחצאין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כמו שהיה אביהן עושה: <b>אותה כולה.</b> וה\"ק כשהאחד מבניו יקריב לאחר שמת אביו יעשה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותה כולה ולא חציה: <b>ממי שהבריות שלו.</b> ממי שהעולם שלו וקס\"ד דהיינו מתרומת הלשכה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שכבר הקדישו הציבור לשמים: <b>כליל להקטרה.</b> שלא יעשו ממנה שיריים לאכילה. ל\"א",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיקטירו שלימה ולא לחצאין כל זמן שהיא קריבה משל ציבור דקריבה שלימה לא פליגי בה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ר\"י ור\"ש:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
