  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "עולות אמר רבי זעירא כמה דאת אמר תמן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנאי בית דין הוא על המותרות שיקרבו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עולות כן את מר אוף הכא תנאי בית דין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא על האובדות שיקרבו עולות אמר רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי לרבי יעקב בר אחא אין זה מזיד אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה מכיון שהוא תנאי בית דין אין זה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מזיד אמר רבי יסא עד דאנא תמן שמעית קל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב יהודה שאל לשמואל הפריש שקלו ומת אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה יפלו לנדבה ומותר עשירית האיפה שלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוחנן אמר יוליכם לים המלח רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר אמר יפלו לנדבה עשירית האיפה של",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כהן גדול רבי יוחנן אמר חוצה אותה ואחר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כך מקדשה רבי שמעון בן לקיש אמר מקדשה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואחר כך חוצה אותה מתניתא פליגי על רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן מקריב מחצה ומחצה אבד פתר לה שכן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו מעות ילכו לים המלח מתניתא פליגי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על רבי שמעון בן לקיש נמצאו שני חצאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קריבין ושני חצאין אבודין ותני עלה מחצה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראשון ומחצה שני תעובר צורתן ויצאו לבית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השריפה פתר לה כרבי ישמעאל דאמר עשרון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקדש כשהכהן מתקרב תחילה לעבודה מביא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשירית האיפה שלו ועובדה בידו אחד כהן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדול ואחד כהן הדיוט שעבדו עד שלא הביאו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשירית האיפה שלהם עבודתן כשירה רבי מנא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעי מימר בו ביום שנתקרב תחילה לעבודה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בו ביום נתמנה להיות כהן גדול מביא שתים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחת לחינוכו ואחת לחובת היום תופיני",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשעת הבאה תופיני ואין בשחרית תופיני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והא תנינן העמידו עושה חביתין לעשות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חביתין אמר רבי חייא בר אחא לעשות חמין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרבוכה תופיני רבי יסא בשם רבי חנינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מטגנה ואחר כך אופה אותה רבי אחא בשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חנינה אופה אותה ואחר כך מטגנה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תופיני תאפנה נא רבי אומר תאפינה נאה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי דוסא אומר תאפנה ריבה אתיין אלין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פלגוותא כהינין פלגוותא מאן דאמר תאפינה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאה כמאן דאמר אופה ואחר כך מטגנה ומאן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמר תאפינה נא כמאן דאמר מטגנה ואחר כך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אופה לא סוף דבר שמת אלא אפילו נטמא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואפילו נדחה ממום תני רבי יהודה בר פזי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר דליה ואפילו נדחה ממום מנין לכהן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדול שמת ולא מינו אחר תחתיו שתהא מנחתו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קריבה משל יורשים תלמוד לומר מבניו יעשה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותה יכול יביאנה לחציים תלמוד לומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותה כולה אמרתי דברי רבי יהודה רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעון אומר אינה באה אלא משל צבור שנאמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חק עולם מי שהברית כרותה לו כליל תקטר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כליל להקטרה כהן גדול שמת וכו׳ רבי בא",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר ממל בעי מחלפה שיטתיה דרבי שמעון תמן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר משל יורשין והכא אמר משל צבור אמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חייה",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עד דאנא תמן.</b> כשהייתי בבבל שמעתי ששאל ר\"י לשמואל הפריש שקלו ומת מה יעשה בו: <b>מותר עשירית האיפה של כה\"ג.</b> כגון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהפריש מעות לעשירית האיפה של היום וניתותר שאינו ראוי למחר מה יעשה בו: <b>יוליכם לים המלח.</b> לא נהנין ולא מועלין בו:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>חוצה אותה ואח\"כ מקדשה.</b> אבל הכלי שמודדין בו העשרון לא היה קודש: <b>מקדשה.</b> כל העשרון בעשרון: <b>ה\"ג מקריב מחצה ומחצה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אבד.</b> כ\"ה במנחות פרק התכלת ואיירי כגון שנטמא מחצה של בין הערביים שמביא עשרון שלם וחוציהו ומקריב מחצה ומחצה אבד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמעינן דאינה קדושה לחצאין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא כולו בבת אחת וכיון דלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך למחצה השני שכבר נתקדש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרי הוא אבד וקשיא לר\"י: <b>שכן</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אפי' מעות.</b> שניתותר מעשירית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיפה סובר ר\"י שילכו לים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המלח דה\"ל מותר עשירית האיפה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכדאמר ר\"י בסמוך וכ\"ש הסולת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שניתותר: ה\"ג מתניתא פליגא על",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ר\"י נמצאו וכו': <b>נמצאו ב'</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חציין וכו'.</b> קאי אכה\"ג שהקריב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחצה שחרית ומינו אחר תחתיו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מביא עשרון שלם וחוצהו ומקריב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומחצה אבד נמצאו ב' חצאין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אובדין וב' חצאים קריבין:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תעובר צורתו.</b> ויפסול בלינה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקשיא לר\"י למה ליה עיבור",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צורה ולמה יוצא לבית השריפה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הא לא נתקדש מעולם ואי משום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר עשירית האיפה יוליכם לים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המלח אבל שריפה לא צריך: <b>פתר</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לה.</b> למתני' כר\"י דאמר עשרון",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקדש וכיון שצריך ליתנו לתוך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העשרון כדי לחצותו דלכ\"ע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למצוה צריך להביא עשרון שלם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מביתו כדי לחצותו א\"כ כבר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתקדש ויוצא לבית השריפה:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כשהכהן מתקרב תחלה לעבודה.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו יום חינוכו צריך להביא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עשירית האיפה משלו שנאמר זה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבן אהרן ובניו אשר יקריבו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה' ביום המשח אותו עשירית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיפה וגו' ובניו היינו כהנים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדיוטים: <b>ועובד בידו.</b> הוא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמו מקריבם: <b>בו ביום נתקרב</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בתחלה לעבודה.</b> כהן שלא עבד כל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימיו ונתמנה להיות כהן גדול:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מביא שתים.</b> שתי מנחות מעשירי'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האיפה: <b>אחת לחינוכו.</b> ככהן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדיוט: <b>ואחת לחובת היום.</b> שהוא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חביתי כ\"ג שמקריב בכל יום:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תופיני.</b> כתיב מרבכת תביאנה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תפיני וקדריש בשעת הבאה אז",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תאפנה אבל לא בלילה שלפניו:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואין בשחרית תופיני.</b> היינו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קודם עלות השחר לא יאפו אותן:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופריך <b>והא תנינן.</b> בתמיד פ\"ק:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>העמידו עושי חביתין.</b> בשחרית",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קודם עלות השחר לעשותו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חביתין. ושמעינן שבלילה היתה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נאפית: <b>ומשני לעשות חמין.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרככם העמידוהו אז אבל לאפות",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא היו אופין עד עלות השחר",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(ודברי ה\"ר אליהו פולדא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסוגיא זו אינן מחוורים):",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מטגנה.</b> במחבת ואח\"כ אופה אותה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתנור: <b>תיאפנה נא.</b> בשעת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפייתה בתנור תהא נא כמו אל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תאכלו ממנה נא כלומר תהא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מבושלת קצת ולא כל צרכה והיינו טגון דבהא מודו כ\"ע דתרווייהו בעינן דכתיב על מחבת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשמן וכתב תופיני: <b>תיאפנה רכה.</b> אפיות הרבה אופה ומטגנה ואופה: <b>תיאפנה נוי.</b> בשעת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אפייתה בתנור תהא נאה ואם מטגנה תחלה הרי היא שחורה מן השמן ומן המחבת: <b>אתיין</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אילין פלגוותא וכו'.</b> כלומר פלוגתא דאמוראי אתיין כפלוגתא דהנך תנאי וכדמסיק: <b>לא</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>סוף דבר שמת.</b> לאו דוקא שמת כה\"ג מביא השני עשרון שלם מביתו אלא אפי' נטמא הכה\"ג",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נמי הדין כן: <b>ואפי' נדחה ממום.</b> בעיי' היא אם נדחה הכה\"ג מחמת מום אם קרב מחציתו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "או משל שני ופשיט מהא דתני ריב\"פ מברדליה דאפי' נדחה ממום מביא השני עשרון שלם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מביתו: <b>ת\"ל והכהן המשיח תחתיו מבניו יעשה אותה.</b> דמשל יורשים קריבה עד שיעמוד אחר:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>יכול יקריבו.</b> היורשים לחצאין כמו שהיה אביהן עושה: <b>אותה כולה.</b> וה\"ק כשהאחד מבניו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יקריב לאחר שמת אביו יעשה אותה כולה ולא חציה: <b>ממי שהבריות שלו.</b> ממי שהעולם שלו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וקס\"ד דהיינו מתרומת הלשכה שכבר הקדישו הציבור לשמים: <b>כליל להקטרה.</b> שלא יעשו ממנה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיריים לאכילה. ל\"א שיקטירו שלימה ולא לחצאין כל זמן שהיא קריבה משל ציבור דקריבה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלימה לא פליגי בה ר\"י ור\"ש:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
