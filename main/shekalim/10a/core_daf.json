  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "משל צבור <b>גמ׳</b> מה ראה זמן עצי כהנים והעם",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להימנות אלא בשעה שעלו ישראל מן הגולה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא מצאו עצים בלשכה ועמדו אלו ונתנדבו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצים משל עצמן ומסרום לצבור וקרבו מהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרבנות צבור והתנו עמהן נביאים שביניהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאפילו לשכה מליאה עצים ועמדו אלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונתנדבו עצים משל עצמן שלא יהא קרבן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתקרב אלא משלהן תחילה אמר רבי אחא דרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסה היא דרבי יוסה אומר אף הרוצה מתנדב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שומר חנם רבי יוסי בשם רבי אילא דברי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכל היא מה פליגין בגופו של קרבן אבל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במכשירי קרבן כל עמא מודיי שהוא משתנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרבן יחיד לקרבן צבור תני אשה שעשתה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתונת לבנה כשירה ובלבד שתמסרנה לצבור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי אחא דרבי יוסי היא דרבי יוסי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר אף הרוצה מתנדב שומר חנם רבי יוסי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי אילא דברי הכל היא מה פליגין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בגופו של קרבן אבל במכשירי קרבן כל עמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מודיי שהוא משתנה קרבן יחיד לקרבן צבור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתא פליגי על רבי יוסי אותן הימים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוהגין בשעת קרבן ושלא בשעת קרבן רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי אומר אינן נוהגין אלא בשעת קרבן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בלבד ועוד מן הדא דתניא אמר רבי אליעזר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בי רבי צדוק אנו היינו מבני סנאה בן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בנימין וחל תשעה באב להיות בשבת ודחינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו למוצאי שבת והיינו מתענין ולא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משלימין העומר ושתי הלחם ולחם הפנים וכל",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרבנות הצבור תמן תנינן כל קרבנות היחיד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והצבור באין מן הארץ ומן חוצה לארץ מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "החדש ומן הישן חוץ מן העומר ושתי לחם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין באין אלא מן החדש ומן הארץ רב חונה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי ירמיה דרבי ישמעאל היא דרבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישמעאל אומר אין העומר בא מן הסוריא תמן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנינן עשר קדושות הן ארץ ישראל מקודשת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכל הארצות ומה היא קדושתה שמביאין ממנה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העומר והביכורים ושתי לחם מה שאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מביאין כן מכל הארצות רבי חייא בשם רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירמיה דרבי ישמעאל היא דרבי ישמעאל אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין העומר בא מן הסוריא תמן תנינן רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישמעאל אומר מה חריש רשות אף קציר רשות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצא קציר העומר שהוא מצוה רבי ישמעאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כדעתיה דרבי ישמעאל דאמר אין העומר בא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הסוריא כדעתיה דאמר יצא קציר העומר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהוא מצוה מאן תנא שומרי ספיחין בשביעית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוטלין שכרן מתרומת הלשכה רבי ישמעאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היא אמר רבי יוסה דברי הכל היא לא מצאו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בסוריא מביאין אותן מספיחין שבארץ ישראל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ההן עומר מהו שיזרע בתחילה רבי חייא בר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדא בעי קומי רבי מנא לא נמצא כקומץ על",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השיריים שאינן נאכלין אמר ליה נעשה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כחמשה דברים שהן באין בטומאה ואין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאכלין בטומאה כיצד הוא עושה נוטל מעות",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן השולחני ונותן לקוצרין ולשומרין עד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא יקרב העומר ומביא מעות מתרומת הלשכה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומחללין עליו וטבות כן רבי אחא בשם רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בא כל מה שיתן הן הן דמיו משעה הראשונה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנא אף בפתחי אבנים כן כיצד הוא עושה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נוטל מעות משולחני ונותן לחוצבין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולסתתין עד שלא תינתן על גבי הדימוס",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומשניתן על הדימוס מביא מעות מתרומת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלשכה ומחללין עליה וטבת כן רבי יוסי בי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי בון בשם שמואל כל מה שיתן הן הן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דמיה משעה הראשונה",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' <b>מה ראו וכו'.</b> אמתניתין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפ\"ד דתענית קאי דתנן התם זמן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצי הכהנים והעם תשעה וקשיא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה מה ראו להימנות הא אפילו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל יחיד יכול לנדב עצים כדתנן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקמן פ\"ו: <b>אלא בשעה וכו'.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקמ\"ל שהעצים שלהן קודמין לכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאר עצים שבלשכה: <b>הנביאים</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שביניהן.</b> שהיו באותו הדור",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כגון חגי זכריה ומלאכי ועזרא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונחמיה: <b>אלא משלהן.</b> מעצים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהתנדבו הן: <b>דר\"י היא.</b> הא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרינן שעצים לקרבנות ציבור",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באים משל יחיד אתיא כר' יוסי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמתני': <b>דברי הכל היא.</b> ואפילו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כרבנן דע\"כ לא פליגי רבנן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ור\"י אלא בגופו של קרבן: <b>אבל</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במכשירי קרבן.</b> כגון עצים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקרבנות הכל מודים דמשתנה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיחיד לציבור: <b>כתונת לבנה.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכהן לשרת בו בקדש: <b>צריכה</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>למסור לציבור.</b> מיהו אם מסרה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר לעבוד בו: <b>במכשירי קרבן.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כגון כתונת: <b>ה\"ג מתני' מסייעא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לר' יוסי.</b> וה\"פ מהך ברייתא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמגילת תענית מוכח כדאמר ר'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוסי בשם ר' אילא דד\"ה היא:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בשעת הקרבן.</b> בזמן שבהמ\"ק",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קיים: <b>רי\"א אין נוהגין אלא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בשעת הקרבן.</b> ש\"מ דרבנן דפליגי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליה דר\"י סוברים דנוהג אפילו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא בשעת הקרבן ופשיטא שמודים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיו זמנים להבאת העצים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכמתניתין דתענית: <b>והיינו</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתענין ולא משלימין.</b> מפני",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שי\"ט שלהן היה שבני סנאה בן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנימן הקריבו עצים בעשרה באב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדתנן בתענית פ\"ד וזה היה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודאי אחר החרבן דבזמן הבית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין צום בט\"ב ואס\"ד דלא היו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העצים אלו אלא לצורך קרבנות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יחיד ודינו כקרבן יחיד למה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהיה להן י\"ט אף שלא בשעת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבן בשלמא בשעת קרבן ניחא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאף יחיד שמביא קרבן הוה ליה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כי\"ט כדאמרינן בריש פ' מקום",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנהגו אלא לאחר החרבן מאי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעמא אלא ודאי דאף לקרבנות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ציבור התנדבו אלו ונשאר הי\"ט",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדורות ומסתמא לא פליגי רבנן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמתני' עליה דראב\"צ דקי\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשה רב: מתני'. דתנן שומרי",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ספיחים בשביעית וכו' ש\"מ דאין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העומר ושתי הלחם באין אלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מארץ וכדפרישית במתני' אתיא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כר\"י דאמר שאין העומר בא מח\"ל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאי כר\"י בר' יהודה דאמר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העומר בא מח\"ל ל\"ל שומרי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ספיחים תיפוק ליה שאפשר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להביאו מח\"ל: <b>אין העומר בא מן</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הסוריא.</b> רבותא קמ\"ל דאפילו מן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הסוריא דדמיא לא\"י במקצת אינו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בא וכ\"ש מח\"ל ממש: <b>תמן תנינן.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מנחות פ\"ט: <b>שאין באין אלא מן</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>החדש.</b> דכתיב מנחה חדשה: <b>ומן</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הארץ.</b> דגבי שתי לחם כתיב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממושבותיכם וגבי עומר כתיב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקצרתם את קצירה ולא קציר של",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ח\"ל: <b>תמן תנינן.</b> בפ\"ק דכלים:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והביכורים.</b> דכתיב ולקחת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מראשית כל פרי האדמה אשר תביא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מארצך: <b>תמן תנינן.</b> בפ\"ק",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשביעית: <b>מה חריש רשות.</b> דכתיב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בחריש ובקציר תשבות ודרשינן מה חריש דהוא דוקא רשות שהרי אין לך חריש שיחרוש לשם מצוה דחפילו גבי עומר אם מצא חרוש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אינו חורש אף קציר נמי שהוא רשות הוא דאסור בשבת אבל קציר של מצוה כגון קציר העומר שמצוה לקצור לשם העומר דוחה שבת:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ה\"ג ר\"י כדעתיה דאמר אין העומר בא מסוריא.</b> וכ\"ה במס' שביעית וה\"פ ר\"י לשיטתיה דסובר שאין העומר בא אלא מן הארץ",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואפי' בשביעית קוצרין אותו בארץ דקציר דידיה דוחה שביעית מפני שהוא מצוה וה\"ה דדוחה שבת: <b>ד\"ה היא.</b> ומתני' איירי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בשנת בצורת ולא מצאו תבואה בח\"ל וצריכין להביא מספיחי א\"י: <b>ההן עומר וכו'.</b> האי עומר אם אין שם ספיחים מהו שיזרע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לצרכו לכתחילה בשביעית: <b>לא נמצא.</b> אם נזרע בשביעית כקומץ על שיריים שאינן נאכלין שהרי השיריים אסורין באכילה וקומץ",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שאינו מתיר שיריים לאכילה אינו קומץ: <b>נעשה כחמשה דברים וכו'.</b> דתנן בפ' כיצד צולין ה' דברים באין בטומאה ואינן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נאכלין בטומאה העומר ושתי הלחם וכו' וה\"נ עומר שנזרע בשביעית אין שיריו נאכל כאילו בא בטומאה: <b>כיצד הוא עושה.</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אמתני' קאי דתנן שומרי ספיחין בשביעית נוטלין שכרן מתרומת הלשכה וקשיא איך הקדש יוצא בלא חילול לכך קאמר שמתחילה לא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "היו הקוצרין והשומרין מקבלין שכר מהלשכה אלא משולחני ממעות חולין ואח\"כ קודם הקרבה מחללין ממעות הלשכה: ופריך <b>וטבות</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כן.</b> וכי טוב הוא לעשות כן הרי כשפודה אותו אינו שוה כל כך כמה שהוציאו עליו לשומרין שהרי צריך לנפותו ומשתייר ממנו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הרבה וגם עומר אחד אינו שוה מעו' אלו: <b>כל מה שיתן.</b> הגזבר הן הן דמיו משעה הראשונה וה\"ז כאילו הם נתנו מעות השומרין:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אף בפתחי אבנים כן.</b> המסתתין האבנים לצורך בנין הבית לא היו מקבלין המעות מן הגזברים מיד: <b>לחוצבין.</b> מן ההר: <b>ולסתתין.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "המרבעין האבנים ומחליקן: <b>הדימוס.</b> שורה של בנין: <b>וטבא היא כן.</b> הא לפעמים מתקלקלין האבנים קודם שנתנו לבנין נמצא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "האבנים שנצרכו לבנין אינן שוים כ\"כ כמו השכר שנתנו השלחנות:",
      "gemara_segment_ids": [
        3
      ]
    }
  ],
