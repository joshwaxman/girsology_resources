  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "רב חזקיה בשם רב חסדא תיפתר שפדאן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמימין והוממו רבי יוסה בשם רב חסדא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתא אמרה כן ולדן וחלבן אסור לאחר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פדיונין רבי חזקיה בשם רבי יוסה קדשי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדק הבית שפדאן תמימין יצאו לחולין אין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תימר לא יצאו לחולין היאך קדשי מזבח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חלין על קדשי בדק הבית בעלי מומין קדושת",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המזבח חלה עליהן ליידה מילה לגיזה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולעבודה הפריש נקבה לעולתו ולפסחו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולאשמו עושה תמורה רבי שמעון אומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעולתו עושה תמורה לפסחו ולאשמו אינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושה תמורה רבי שמעון בן יהודה אומר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום רבי שמעון לעולתו ולפסחו ולאשמו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אינו עושה תמורה אמר רבי יוחנן טעמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבי שמעון שכן מצינו נקבה בעוף כשירה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבא עולה ואמר רבי יוחנן טעמא דרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעון בן יהודה אם מין במינו הוא חלוק",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליו כל שכן מין בשאינו מינו איזהו מין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במינו שהוא חלוק עליו כהדא דתני אשם בן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנה והביא בן שתים בן שתים והביא בן שלש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא יצא אמר רבי יוחנן רבי שמעון ורבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע שניהם אמרו דבר אחד כמה דרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע אמר נקבה לעולה לא קידשה אלא הקדש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמים כן דרבי שמעון אמר נקבה לעולה לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קידשה אלא הקדש דמים אין תימר קדשה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קדושת הגוף ירעו אמר רבי [אין] אני רואה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את דברי רבי שמעון בפסח שהמותר פסח בא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלמים ולימא אין אני רואה דברי רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעון באשם שהמותר אשם בא עולה אמר רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבין אם הקדיש פסח בא שלמים גופו קרב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלמים אם הקדיש אשם בא עולה אין גופו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרב עולה מהו כדון ההין אמר הקדש דמים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקדיש וההן אמר הקדש גופו הקדיש רבי",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זעירא בשם רבי שמעון בן לקיש טעמא דרבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע דבר אל אהרן ואל בניו ואל כל בני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל ואמרת אליהם איש איש מבית ישראל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגו׳ אשר יקריב לה׳ לעולה הכל קרב לעולה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרצונכם תמים זכר מנין אפילו נקבות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלמוד לומר בבקר לרבות את נקבות רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצחק בי רבי אלעזר שאל כתיב זכר ואת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרת בבקר לרבות את הנקבות ודכוותה כתיב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמים ואת אמרת בבקר לרבות בעלי מומין מה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביניהון רב אמר שבטא דכדכדא ביניהן רבי",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אליעזר אומר ימכרו כו׳ המין רבי אבהו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בשם רבי שמעון בן לקיש טעמא דרבי אליעזר דבר אל אהרן ואל בניו וגו׳ אשר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יקריבו לה׳ לעולה הכל קרב עולה לרצונכם תמים זכר יכול אפילו עופות תלמוד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לומר בבקר ולא עופות רבי ירמיה ורבי בון בר חייה הוון יתיבון ואמרין תמן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אמר רבי יוחנן טעמא דרבי שמעון שכן נקבה שבעוף כשירה לבא עולה וכא אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הכין",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
