  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי שמעון בן לקיש דבית שמאי היא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאי כבית הלל עניים אוכלים ומעשרין ואמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה רבי יוסי שמענו שהוא פטור ממעשר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דברי הכל משום קנסא <b>הלכה ג <big>מתני׳</big></b> בחמשה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשר בו שולחנות היו יושבין במדינה.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעשרים וחמשה ישבו במקדש, משישבו במקדש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התחילו למשכן. את מי ממשכנין לוים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וישראלים וגרים ועבדים משוחררים אבל לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נשים ועבדים וקטנים וכל קטן שהתחיל אביו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשקול על ידו שוב אינו פוסק אין ממשכנין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הכהנים מפני דרכי שלום אמר רבי יהודה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העיד בן בוכרי ביבנה כל כהן ששוקל אינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוטא אמר לו רבן יוחנן בן זכאי לא כי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא כל כהן שאינו שוקל חוטא אלא שהכהנים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דורשים מקרא זה לעצמן וכל מנחת כהן כליל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תהיה לא תאכל הואיל ועומר ושתי הלחם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולחם הפנים שלנו היאך נאכלין <b>גמ׳</b> אין",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממשכנין את הקטנים הא לתבוע תובעין הדא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתימר בשהביא שתי שערות אבל אם לא הביא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתי שערות לא בדא ולמשכן אין ממשכנין אף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על פי שהביא ב׳ שערות כיני מתניתין אין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממשכנין את הכהנים מפני דרך הכבוד אמר",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יהודה העיד כו׳ אמר רבי ברכיה טעמא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבן יוחנן בן זכאי זה יתנו שנים עשר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבטים יתנו רבי טבי בשם רב המנונא כן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משיבין חכמים לרבי יהודה חטאת יחיד מתה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין חטאת צבור מתה מנחת היחיד קריבה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כליל ואין מנחת הצבור קריבה כליל וקשיא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משיבין לאדם דבר שאינו מודה בו דתנן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין חטאת צבור מתה רבי יהודה אומר תמות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והוא מותיב לן זו לא נדבת יחיד היא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואינון מתיבין ליה כיון שנמסרה לצבור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמי שהוא נדבת צבור כתיב כל העובר על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפקודים רבי יהודה ורבי נחמיה חד אמר כל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעבר בימא יתן וחרנא אמר כל דעבר על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פיקודייא יתן מאן דאמר כל דעבר בימא יתן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסייע לרבן יוחנן בן זכאי מאן דאמר כל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעבר על פיקודייא יתן מסייע לבן בוכרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>הלכה ד <big>מתני׳</big></b> אף על פי שאמרו אין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממשכנין נשים ועבדים וקטנים, אבל אם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקלו מקבלין מידן. הנכרי והכותי ששקלו –",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין מקבלין מהן. ואין מקבלין מידם קני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זבין וקני זבות וקני יולדות, וחטאות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואשמות. זה הכלל כל שנידר ונידב מקבלין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מידן כל שאינו נידר ונידב אין מקבלין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מידן וכן מפורש על ידי עזרא שנאמר לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לכם ולנו לבנות בית לאלהינו",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והיידא אמר דא.</b> והיכן אמר דבר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זה דב\"ד פוטרין מן המעשרות:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>גדיש שלא לוקט.</b> מתני' היא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בריש פ\"ה דפיאה וה\"פ מי שאסף",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והגדיש את העומרים למקום אחד",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתוך השדה שעדיין לא לקטו שם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העניים את הלקט: <b>כל</b> השבלים.",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הנוגעות בארץ הרי הן של</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עניים.</b> דספק לקט הן: <b>ה\"ג דב\"ש</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היא ברם כבית הלל עניים</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מעשרין ואוכלין אמר ר' יוסי</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שמענו שהוא פטור מן המעשרות</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ד\"ה משום קנס.</b> וה\"פ מתני'",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אתיא כב\"ש דאמרי הפקר לעניים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפקר ולפיכך פטורין מן המעשר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל כבית הלל אין לו דין לקט",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחייבין במעשרות ורבי יוסי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמר שמענו שאפילו כב\"ה אתיא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' דכיון דקנסו רבנן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והפקירו השבלים שנוגעות בארץ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרי הוא כהפקר ב\"ד ופטור מן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המעשרות: מתני' <b>שולחנות.</b> שם",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשלחן שלפני השלחני שמקבל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו וכן קורין החלפני שלחני",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכל המשנה: <b>במדינה.</b> בירושלים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וי\"מ בכל ערי ישראל חוץ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לירושלים והיו מחליפין מחצית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השקל לכל מי שצריך: <b>ישבו</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במקדש.</b> לפי שהיה הזמן מתקרב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היו יושבין במקדש כדי שימהרו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להביא ולי\"מ במקדש היינו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בירושלים: <b>התחילו למשכן.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומוציאין העבוט מביתו של מי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא הביא שקלו: <b>לוים.</b> לאפוקי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממ\"ד כל דעבר על פקודייא: <b>אבל</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לא נשים.</b> ונתנו איש כופר נפשו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב ולא אשה: <b>ולא עבדים.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דילפינן לה לה מאשה: <b>וקטנים.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו הביא שתי שערות והוא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פחות מבן עשרים: <b>שוב אינו</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>פוסק.</b> אביו מלשקול בשבילו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאומרין לו מאחר שנתת עליו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השנה שעברה והעמדת עליו זאת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המצוה תן עליו תמיד עד שיגדל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא תפסוק: <b>ואין ממשכנין את</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הכהנים.</b> אע\"פ שחייבין במחצית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השקל: <b>מפני דרכי שלום.</b> מפרש",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמ': <b>כל כהן ששוקל אינו</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חוטא.</b> ואע\"פ שאינו חייב לשקול",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וסד\"א אם שוקל נמצא קרבן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ציבור קרב משל יחיד קמ\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאינו חוטא לפי שהוא מוסרו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לציבור לגמרי: <b>לעצמן.</b> להנאתן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא היא דחייבין לשקול אלא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעומר ושתי הלחם לוקחין משקלי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ישראל לבדן: גמ' <b>הא לתבוע תובעין.</b> מן הנשים ועבדים וקטנים דדוקא אין ממשכנין",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותן: <b>הדא דתימר.</b> שתובעין מן הקטנים דוקא כשהביא שתי שערות אע\"ג שלא הגיע לכלל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שניו: <b>אבל.</b> אם לא הביא שתי שערות. ולא הגיע לכלל שניו אפי' תובעין לא: <b>ולמשכן אין</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ממשכנין עד שיביא שתי שערות.</b> ויגדיל שיגיע לכלל שניו ל\"א ה\"ג ולמשכן אין ממשכנין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עד שיהיה בן כ'. ולפ\"ז ניחא הכל אף הסוגיא דלקמן (הלכה ד'): <b>כיני מתניתא.</b> כן צריך",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לפרש מתני' דדרכי שלום היינו מפני הכבוד לפי שעבודת הקרבנות עליהם וכי היכא דלא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ליתי לאנצויי ולי נראה מפני הכבוד היינו שמחוייבים לנהוג בהם כבוד דכתיב וקדשתו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואיסורא ליכא דכיון דתנאי ב\"ד הוא על העתיד לגבות הם מחלו להכהנים: <b>י\"ב שבטים</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>יתנו.</b> זה בגימטריא שנים עשר והכהנים והלוים בכלל: <b>כן משיבין חכמים לר\"י.</b> דחכמים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סוברים דלריב\"ז מותר להביא משקלי הכהנים עומר ושתי הלחם שלא נאמר וכל מנחת כהן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא במנחת כהן יחיד אבל לא במנחה שיש לו בשותפות עם הציבור: <b>חטאת יחיד מתה וכו'.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כמו דמצינו שיחיד חלוק מציבור שחטאת יחיד מתה ואין חטאת ציבור מתה ה\"נ איכא לחלק",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בין מנחת יחיד למנחת ציבור: <b>וקשיא וכו'.</b> הש\"ס לא סיים למילתיה דר' טבי ומקשי עליה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "א\"נ הא דקאמר בסמוך והוא מותיב לון שינוייה הוא וכאלו קאמר אלא: <b>שאין חטאת וכו'.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מתני' היא בפ\"ו דיומא: <b>והוא משיב להן.</b> וכי שקלים לאו נדבת יתיר הן ולמה יביא מהן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עומר ושתי הלחם: <b>כל דעבר בימא יתן.</b> דהיינו כהנים ולויים וישראלים שכולן עברו בים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סוף. על הפקודים היינו בין אותן שנמנו לבדן בין אותן שנמנו עם ישראל יתנו תרומת",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ה' והא דכתיב בפ' ואלה פקודי וכסף פקודי העדה מאת ככר וגו' דשמעינן דהכהנים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ולויים לא נתנו היינו בתרומת האדנים אבל בתרומת שקלים לקרבנות ציבור הושוו כולן:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כל דעבר על פיקודייא.</b> וכהנים ולויים לא עברו במניין לפני משה אלא הוא הלך לפתחי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אהליהם ומנה אותן:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
