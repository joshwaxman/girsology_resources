  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי שמעון בן לקיש דבית שמאי היא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאי כבית הלל עניים אוכלים ומעשרין ואמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה רבי יוסי שמענו שהוא פטור ממעשר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דברי הכל משום קנסא <b>הלכה ג <big>מתני׳</big></b> בחמשה",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשר בו שולחנות היו יושבין במדינה.",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעשרים וחמשה ישבו במקדש, משישבו במקדש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התחילו למשכן. את מי ממשכנין לוים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וישראלים וגרים ועבדים משוחררים אבל לא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נשים ועבדים וקטנים וכל קטן שהתחיל אביו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשקול על ידו שוב אינו פוסק אין ממשכנין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הכהנים מפני דרכי שלום אמר רבי יהודה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העיד בן בוכרי ביבנה כל כהן ששוקל אינו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוטא אמר לו רבן יוחנן בן זכאי לא כי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא כל כהן שאינו שוקל חוטא אלא שהכהנים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דורשים מקרא זה לעצמן וכל מנחת כהן כליל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תהיה לא תאכל הואיל ועומר ושתי הלחם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולחם הפנים שלנו היאך נאכלין <b>גמ׳</b> אין",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממשכנין את הקטנים הא לתבוע תובעין הדא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתימר בשהביא שתי שערות אבל אם לא הביא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתי שערות לא בדא ולמשכן אין ממשכנין אף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על פי שהביא ב׳ שערות כיני מתניתין אין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממשכנין את הכהנים מפני דרך הכבוד אמר",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יהודה העיד כו׳ אמר רבי ברכיה טעמא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבן יוחנן בן זכאי זה יתנו שנים עשר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבטים יתנו רבי טבי בשם רב המנונא כן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משיבין חכמים לרבי יהודה חטאת יחיד מתה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין חטאת צבור מתה מנחת היחיד קריבה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כליל ואין מנחת הצבור קריבה כליל וקשיא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משיבין לאדם דבר שאינו מודה בו דתנן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאין חטאת צבור מתה רבי יהודה אומר תמות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והוא מותיב לן זו לא נדבת יחיד היא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואינון מתיבין ליה כיון שנמסרה לצבור",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמי שהוא נדבת צבור כתיב כל העובר על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפקודים רבי יהודה ורבי נחמיה חד אמר כל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעבר בימא יתן וחרנא אמר כל דעבר על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פיקודייא יתן מאן דאמר כל דעבר בימא יתן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסייע לרבן יוחנן בן זכאי מאן דאמר כל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דעבר על פיקודייא יתן מסייע לבן בוכרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>הלכה ד <big>מתני׳</big></b> אף על פי שאמרו אין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממשכנין נשים ועבדים וקטנים, אבל אם",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקלו מקבלין מידן. הנכרי והכותי ששקלו –",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין מקבלין מהן. ואין מקבלין מידם קני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זבין וקני זבות וקני יולדות, וחטאות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואשמות. זה הכלל כל שנידר ונידב מקבלין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מידן כל שאינו נידר ונידב אין מקבלין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מידן וכן מפורש על ידי עזרא שנאמר לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לכם ולנו לבנות בית לאלהינו",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והיידא אמר דא.</b> והיכן אמר דבר זה דב\"ד פוטרין מן המעשרות: <b>גדיש שלא לוקט.</b> מתני' היא בריש פ\"ה דפיאה וה\"פ מי שאסף",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והגדיש את העומרים למקום אחד בתוך השדה שעדיין לא לקטו שם העניים את הלקט: <b>כל</b> השבלים. <b>הנוגעות בארץ הרי הן של</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עניים.</b> דספק לקט הן: <b>ה\"ג דב\"ש היא ברם כבית הלל עניים מעשרין ואוכלין אמר ר' יוסי שמענו שהוא פטור מן המעשרות ד\"ה</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>משום קנס.</b> וה\"פ מתני' אתיא כב\"ש דאמרי הפקר לעניים הפקר ולפיכך פטורין מן המעשר אבל כבית הלל אין לו דין לקט",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחייבין במעשרות ורבי יוסי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמר שמענו שאפילו כב\"ה אתיא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' דכיון דקנסו רבנן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והפקירו השבלים שנוגעות בארץ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרי הוא כהפקר ב\"ד ופטור מן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המעשרות: מתני' <b>שולחנות.</b> שם",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשלחן שלפני השלחני שמקבל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליו וכן קורין החלפני שלחני",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכל המשנה: <b>במדינה.</b> בירושלים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וי\"מ בכל ערי ישראל חוץ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לירושלים והיו מחליפין מחצית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השקל לכל מי שצריך: <b>ישבו</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במקדש.</b> לפי שהיה הזמן מתקרב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היו יושבין במקדש כדי שימהרו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להביא ולי\"מ במקדש היינו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בירושלים: <b>התחילו למשכן.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומוציאין העבוט מביתו של מי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא הביא שקלו: <b>לוים.</b> לאפוקי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממ\"ד כל דעבר על פקודייא: <b>אבל</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לא נשים.</b> ונתנו איש כופר נפשו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב ולא אשה: <b>ולא עבדים.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דילפינן לה לה מאשה: <b>וקטנים.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפילו הביא שתי שערות והוא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פחות מבן עשרים: <b>שוב אינו</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>פוסק.</b> אביו מלשקול בשבילו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאומרין לו מאחר שנתת עליו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השנה שעברה והעמדת עליו זאת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המצוה תן עליו תמיד עד שיגדל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא תפסוק: <b>ואין ממשכנין את</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הכהנים.</b> אע\"פ שחייבין במחצית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השקל: <b>מפני דרכי שלום.</b> מפרש",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמ': <b>כל כהן ששוקל אינו</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חוטא.</b> ואע\"פ שאינו חייב לשקול",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וסד\"א אם שוקל נמצא קרבן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ציבור קרב משל יחיד קמ\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאינו חוטא לפי שהוא מוסרו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לציבור לגמרי: <b>לעצמן.</b> להנאתן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא היא דחייבין לשקול אלא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעומר ושתי הלחם לוקחין משקלי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישראל לבדן: גמ' <b>הא לתבוע</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תובעין.</b> מן הנשים ועבדים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקטנים דדוקא אין ממשכנין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותן: <b>הדא דתימר.</b> שתובעין מן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקטנים דוקא כשהביא שתי שערות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג שלא הגיע לכלל שניו:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אבל.</b> אם לא הביא שתי שערות.",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא הגיע לכלל שניו אפי'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תובעין לא: <b>ולמשכן אין</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ממשכנין עד שיביא שתי שערות.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויגדיל שיגיע לכלל שניו ל\"א",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"ג ולמשכן אין ממשכנין עד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהיה בן כ'. ולפ\"ז ניחא הכל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אף הסוגיא דלקמן (הלכה ד'):",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כיני מתניתא.</b> כן צריך לפרש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' דדרכי שלום היינו מפני",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הכבוד לפי שעבודת הקרבנות עליהם וכי היכא דלא ליתי לאנצויי ולי נראה מפני הכבוד",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היינו שמחוייבים לנהוג בהם כבוד דכתיב וקדשתו ואיסורא ליכא דכיון דתנאי ב\"ד הוא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "על העתיד לגבות הם מחלו להכהנים: <b>י\"ב שבטים יתנו.</b> זה בגימטריא שנים עשר והכהנים",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והלוים בכלל: <b>כן משיבין חכמים לר\"י.</b> דחכמים סוברים דלריב\"ז מותר להביא משקלי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הכהנים עומר ושתי הלחם שלא נאמר וכל מנחת כהן אלא במנחת כהן יחיד אבל לא במנחה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיש לו בשותפות עם הציבור: <b>חטאת יחיד מתה וכו'.</b> כמו דמצינו שיחיד חלוק מציבור",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שחטאת יחיד מתה ואין חטאת ציבור מתה ה\"נ איכא לחלק בין מנחת יחיד למנחת ציבור:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וקשיא וכו'.</b> הש\"ס לא סיים למילתיה דר' טבי ומקשי עליה א\"נ הא דקאמר בסמוך והוא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מותיב לון שינוייה הוא וכאלו קאמר אלא: <b>שאין חטאת וכו'.</b> מתני' היא בפ\"ו דיומא:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והוא משיב להן.</b> וכי שקלים לאו נדבת יתיר הן ולמה יביא מהן עומר ושתי הלחם: <b>כל</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דעבר בימא יתן.</b> דהיינו כהנים ולויים וישראלים שכולן עברו בים סוף. על הפקודים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היינו בין אותן שנמנו לבדן בין אותן שנמנו עם ישראל יתנו תרומת ה' והא דכתיב בפ'",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואלה פקודי וכסף פקודי העדה מאת ככר וגו' דשמעינן דהכהנים ולויים לא נתנו היינו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בתרומת האדנים אבל בתרומת שקלים לקרבנות ציבור הושוו כולן: <b>כל דעבר על פיקודייא.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכהנים ולויים לא עברו במניין לפני משה אלא הוא הלך לפתחי אהליהם ומנה אותן:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
