      "left": "0px",
      "top": 1291,
      "height": 617,
      "basis": "scan",
      "top_frac": 0.633,
      "height_frac": 0.367,
      "printed_y": [
        567.0,
        822.6
      ],
      "printed_body_y": [
        126.2,
        822.6
      ],
      "note_he": "תוספת שלנו. פני משה אינו נדפס בדף זה כלל — במלבן הזה הדפיסו תקלין חדתין, שאינו מצוי במהדורה דיגיטלית. הטקסט מספריא (פיוטרקוב תרנ״ח–תר״ס), ואינו חלק מצורת הדף הנדפסת.",
      "note_en": "OUR ADDITION. Penei Moshe is not printed on this leaf at all — this rectangle is where the press set Tiklin Chadtin, which is in no digital edition. The text is Sefaria's (Piotrków, 1898-1900) and is not part of the printed page.",
      "printed_work_he": "תקלין חדתין",
      "printed_work_en": "Tiklin Chadtin",
      "source_ref": "Penei Moshe on Jerusalem Talmud Shekalim",
      "lines": [
        {
          "width": "216px",
          "text": "<b>והיידא אמרה.</b> ומהיכן"
        },
        {
          "width": "216px",
          "text": "שמענו זה דהפקר ב\"ד פטור"
        },
        {
          "width": "216px",
          "text": "מהמעשר: <b>דא.</b> מכאן מהאי"
        },
        {
          "width": "216px",
          "text": "מתני' דפאה שמעינן לה"
        },
        {
          "width": "216px",
          "text": "דקתני גדיש וכו' כדפרישית"
        },
        {
          "width": "216px",
          "text": "לעיל וקאמר עלה ר' אמי"
        },
        {
          "width": "216px",
          "text": "בשם רשב\"ל דב\"ש היא דס\"ל"
        },
        {
          "width": "216px",
          "text": "בפ\"ו שם הפקר לעניים הפקר"
        },
        {
          "width": "216px",
          "text": "גמור הוא אלמא דמשום הפקר"
        },
        {
          "width": "216px",
          "text": "ב\"ד נגעו בה שחכמים"
        },
        {
          "width": "216px",
          "text": "הפקירו ואמרו כל הנוגעות"
        },
        {
          "width": "216px",
          "text": "בארץ הרי הן של עניים"
        },
        {
          "width": "216px",
          "text": "והוי כשאר הפקר ופטור"
        },
        {
          "width": "216px",
          "text": "מהמעשרות: <b>א\"ל רבי יוסי</b>"
        },
        {
          "width": "216px",
          "text": "<b>שמענו שהוא פטור ממעשרות.</b>"
        },
        {
          "width": "216px",
          "text": "בתמיה וכי שמענו השתא"
        },
        {
          "width": "216px",
          "text": "לדידך שיהא לקט זה כשאר"
        },
        {
          "width": "216px",
          "text": "לקט ופטור ממעשרות זה"
        },
        {
          "width": "216px",
          "text": "ודאי לא שמענו וכדמסיק"
        },
        {
          "width": "216px",
          "text": "ואזיל: <b>דברי הכל משום קנס</b>"
        },
        {
          "width": "216px",
          "text": "<b>וכב\"ה וכו'.</b> כלומר עיקר"
        },
        {
          "width": "216px",
          "text": "הדין דהאי מתני' שכל"
        },
        {
          "width": "216px",
          "text": "הנוגעות בארץ הרי הן של"
        },
        {
          "width": "216px",
          "text": "עניים לד\"ה היא ובין ב\"ש"
        },
        {
          "width": "216px",
          "text": "ובין ב\"ה מודים בזה וטעמא"
        },
        {
          "width": "216px",
          "text": "משום קנס הוא שלא היה לו"
        },
        {
          "width": "216px",
          "text": "לעשות גדיש על מקום הלקט"
        },
        {
          "width": "216px",
          "text": "של העניים ולעניין מעשרות"
        },
        {
          "width": "216px",
          "text": "יכילנא מימר לך דלב\"ש"
        },
        {
          "width": "216px",
          "text": "אפשר דס\"ל כשאר הפקר"
        },
        {
          "width": "216px",
          "text": "דיינינן להו דכל שהוא"
        },
        {
          "width": "216px",
          "text": "לעניים פטור הוא אבל לב\"ה"
        },
        {
          "width": "216px",
          "text": "דאמרו בפ\"ו שם כל הפקר"
        },
        {
          "width": "216px",
          "text": "שאינו אלא לעניים לאו"
        },
        {
          "width": "216px",
          "text": "הפקר גמור הוא לפוטרו"
        },
        {
          "width": "216px",
          "text": "ממעשרות עד שיופקר אף"
        },
        {
          "width": "216px",
          "text": "לעשירים כשמיטה אימא אין"
        },
        {
          "width": "216px",
          "text": "הכי נמי כאן דלב\"ה עניים"
        },
        {
          "width": "216px",
          "text": "מעשרין ואוכלין לפי שאותן"
        },
        {
          "width": "216px",
          "text": "שאינן לקט ממש מתחייבין"
        },
        {
          "width": "216px",
          "text": "מדינא במעשרות ומכיון"
        },
        {
          "width": "216px",
          "text": "שנתערבו מעשרין את הכל"
        },
        {
          "width": "216px",
          "text": "וא\"כ אכתי לא שמעינן מידי"
        },
        {
          "width": "216px",
          "text": "מהאי מתני' דהפקר ב\"ד"
        },
        {
          "width": "216px",
          "text": "פטור מן המעשרות: מתני'"
        },
        {
          "width": "216px",
          "text": "<b>בחמשה עשר בו שולחנות</b>"
        },
        {
          "width": "216px",
          "text": "<b>יושבין במדינה.</b> בכל ערי"
        },
        {
          "width": "216px",
          "text": "ישראל היו החלפנים יושבין"
        },
        {
          "width": "216px",
          "text": "שהן מחליפין מחצית השקל"
        },
        {
          "width": "216px",
          "text": "לאנשים שמביאין כל אחד"
        },
        {
          "width": "216px",
          "text": "ממטבע מדינתו ואינו יודע"
        },
        {
          "width": "216px",
          "text": "כמה מהם למחצית השקל"
        },
        {
          "width": "216px",
          "text": "והשלחנות אלו היו תובעין"
        },
        {
          "width": "216px",
          "text": "בנחת כל מי שיתן להם"
        },
        {
          "width": "216px",
          "text": "מקבלין ממנו ומי שלא נתן"
        },
        {
          "width": "216px",
          "text": "אין כופין אותו ליתן:"
        },
        {
          "width": "216px",
          "text": "<b>בעשרים וחמשה בו ישבו</b>"
        },
        {
          "width": "216px",
          "text": "<b>במקדש.</b> וזהו ירושלים נקרא"
        },
        {
          "width": "216px",
          "text": "מקדש וישבו לגבות והתחילו"
        },
        {
          "width": "216px",
          "text": "למשכן למי שאינו רוצה"
        },
        {
          "width": "216px",
          "text": "ליתן ולוקחין עבוטו בעל"
        },
        {
          "width": "216px",
          "text": "כרחו ואפי' כסותו: <b>את מי</b>"
        },
        {
          "width": "216px",
          "text": "<b>ממשכנין לוים וכו'.</b>"
        },
        {
          "width": "216px",
          "text": "ולאפוקי ממ\"ד בהלכה דלקמן"
        },
        {
          "width": "216px",
          "text": "דמפרש כל העובר על"
        },
        {
          "width": "216px",
          "text": "הפקודים כל דעבר על."
        },
        {
          "width": "216px",
          "text": "פקודיא אלא כמ\"ד כל דעבר"
        },
        {
          "width": "216px",
          "text": "בימא יתן: <b>אבל לא נשים.</b>"
        },
        {
          "width": "216px",
          "text": "דכתיב ונתנו איש כופר"
        },
        {
          "width": "216px",
          "text": "נפשו ולא אשה ולא עבדים"
        },
        {
          "width": "216px",
          "text": "שאינן משוחררין שאינן"
        },
        {
          "width": "216px",
          "text": "חייבין אלא במצות שהנשים"
        },
        {
          "width": "216px",
          "text": "חייבות בהן: <b>וקטנים.</b> אין"
        },
        {
          "width": "216px",
          "text": "ממשכנין אותן בשלא הביאו"
        },
        {
          "width": "216px",
          "text": "שתי שערות אבל אם הביאו"
        },
        {
          "width": "216px",
          "text": "שתי שערות הרי הן כגדולים"
        },
        {
          "width": "216px",
          "text": "מבן י\"ג ואילך כמו בכל"
        },
        {
          "width": "216px",
          "text": "מיני חיובין ועונשין"
        },
        {
          "width": "216px",
          "text": "וממשכנין אותם כדאמר"
        },
        {
          "width": "216px",
          "text": "בגמ': <b>שוב אינו פוסק.</b>"
        },
        {
          "width": "216px",
          "text": "מליתן בשבילו בכל שנה"
        },
        {
          "width": "216px",
          "text": "ושנה עד שיגדיל ויתן על"
        },
        {
          "width": "216px",
          "text": "עצמו: <b>ואין ממשכנין את</b>"
        },
        {
          "width": "216px",
          "text": "<b>הכהנים.</b> אע\"פ שתובעין"
        },
        {
          "width": "216px",
          "text": "אותן ליתן אם לא נתנו אין"
        },
        {
          "width": "216px",
          "text": "ממשכנין אותם מפני דרכי"
        },
        {
          "width": "216px",
          "text": "שלום מפני שעבודת הקרבנות"
        },
        {
          "width": "216px",
          "text": "עליהם מוטל וחולקין להם"
        },
        {
          "width": "216px",
          "text": "כבוד ובגמ' אמרו שכך צריך"
        },
        {
          "width": "216px",
          "text": "לשנות במתני' מפני דרך"
        },
        {
          "width": "216px",
          "text": "הכבוד ולפיכך אינו חושב"
        },
        {
          "width": "216px",
          "text": "התנא בסוף פרק הנזקין לזה"
        },
        {
          "width": "216px",
          "text": "בדברים שאמרו שם מפני"
        },
        {
          "width": "216px",
          "text": "דרכי שלום: מתני' <b>אמר רבי</b>"
        },
        {
          "width": "216px",
          "text": "<b>יהודה העיד בן בוכרי</b>"
        },
        {
          "width": "216px",
          "text": "<b>ביבנה כל כהן ששוקל אינו</b>"
        },
        {
          "width": "216px",
          "text": "<b>חוטא.</b> דס\"ל שאינו מחויב"
        },
        {
          "width": "216px",
          "text": "כלל לשקול וס\"ד אמינא"
        },
        {
          "width": "216px",
          "text": "דאינו רשאי לשקול לפי"
        },
        {
          "width": "216px",
          "text": "שמתרומת הלשכה היו באין"
        },
        {
          "width": "216px",
          "text": "ג\"כ העומר ושתי הלחם ולחם"
        },
        {
          "width": "216px",
          "text": "הפנים ויש מהן אכילה"
        },
        {
          "width": "216px",
          "text": "לכהנים ומכיון דכתיב גבי"
        },
        {
          "width": "216px",
          "text": "מנחת כהן כליל תהיה לא"
        },
        {
          "width": "216px",
          "text": "תאכל אלו היו נותנין"
        },
        {
          "width": "216px",
          "text": "שקליהם לתרומת הלשכה לא"
        },
        {
          "width": "216px",
          "text": "היה מותר להם לאכול שירי"
        },
        {
          "width": "216px",
          "text": "העומר ושתי הלחם ולחם"
        },
        {
          "width": "216px",
          "text": "הפנים קמ\"ל דאעפ\"כ אינו"
        },
        {
          "width": "216px",
          "text": "חוטא. ואית דמפרשי דסד\"א"
        },
        {
          "width": "216px",
          "text": "דמכיון שאינו חייב לשקול"
        },
        {
          "width": "216px",
          "text": "אם שוקל נמצא קרבן צבור"
        },
        {
          "width": "216px",
          "text": "קרב משל יחיד קמ\"ל שאינו"
        },
        {
          "width": "216px",
          "text": "חוטא לפי שמוסר אותו"
        },
        {
          "width": "216px",
          "text": "מחצית השקל לצבור לגמרי"
        },
        {
          "width": "216px",
          "text": "ולא חיישינן שמא לא ימסור"
        },
        {
          "width": "216px",
          "text": "יפה יפה: <b>לא כי אלא כל</b>"
        },
        {
          "width": "216px",
          "text": "<b>כהן שאינו שוקל חוטא.</b>"
        },
        {
          "width": "216px",
          "text": "דמיחייב הוא דכתיב כל"
        },
        {
          "width": "216px",
          "text": "העובר על הפקודים ודריש"
        },
        {
          "width": "216px",
          "text": "ליה כל העובר בים סוף יתן"
        },
        {
          "width": "216px",
          "text": "והכל בכלל כהנים לוים"
        },
        {
          "width": "216px",
          "text": "וישראל וכדקאמר בגמר'"
        },
        {
          "width": "216px",
          "text": "להאי מ\"ד: <b>לעצמן.</b> להנאתם"
        },
        {
          "width": "216px",
          "text": "דכתיב כל מנחת כהן וכו'"
        },
        {
          "width": "216px",
          "text": "אבל האי לאו דרשה הוא"
        },
        {
          "width": "216px",
          "text": "דדוקא במנחת כהן לבדו הוא"
        },
        {
          "width": "216px",
          "text": "דאמר קרא כליל תהיה לא"
        },
        {
          "width": "216px",
          "text": "תאכל אבל לא באותה שיש לו"
        },
        {
          "width": "216px",
          "text": "שותפות בה עם הצבור וכן"
        },
        {
          "width": "216px",
          "text": "הלכה שהכהנים ג\"כ חייבים"
        },
        {
          "width": "216px",
          "text": "לשקול ותובעין אותן אבל"
        },
        {
          "width": "216px",
          "text": "אין ממשכנין אותן כדתנינן"
        },
        {
          "width": "216px",
          "text": "במתני' דלעיל: גמ' <b>הא</b>"
        },
        {
          "width": "216px",
          "text": "<b>לתבוע תובעין.</b> כל אלו"
        },
        {
          "width": "216px",
          "text": "שאמרו אין ממשכנין אותן"
        },
        {
          "width": "216px",
          "text": "אבל לתבוע אותם שיתנו"
        },
        {
          "width": "216px",
          "text": "תובעין ואם נתנו נתנו והא"
        },
        {
          "width": "216px",
          "text": "דתנינן לקמן אע\"פ שאמרו"
        },
        {
          "width": "216px",
          "text": "אין ממשכנין נשים ועבדים"
        },
        {
          "width": "216px",
          "text": "וקטנים אם שקלו מקבלין"
        },
        {
          "width": "216px",
          "text": "מידם ומפרש לה התם"
        },
        {
          "width": "216px",
          "text": "דדייקינן הא תובעין אין"
        },
        {
          "width": "216px",
          "text": "תובעין אותן ליתן היינו"
        },
        {
          "width": "216px",
          "text": "בקטן שלא הביא שתי שערות"
        },
        {
          "width": "216px",
          "text": "וכדלקמיה: <b>הדא דתימר</b>"
        },
        {
          "width": "216px",
          "text": "<b>בשהביא שתי שערות.</b> כלומר"
        },
        {
          "width": "216px",
          "text": "וקטן שאמרנו דלתבוע"
        },
        {
          "width": "216px",
          "text": "תובעין אותו היינו בקטן"
        },
        {
          "width": "216px",
          "text": "שלא הגיע לכלל שנים והוא"
        },
        {
          "width": "216px",
          "text": "משנת י\"ג ויום אחד והביא"
        },
        {
          "width": "216px",
          "text": "שתי שערות דלענין שאר"
        },
        {
          "width": "216px",
          "text": "דינים קטן מיקרי ובקטן"
        },
        {
          "width": "216px",
          "text": "כגון זה תובעין אותו: <b>אבל</b>"
        },
        {
          "width": "216px",
          "text": "<b>אם לא הביא שתי שערות לא</b>"
        },
        {
          "width": "216px",
          "text": "<b>בדא.</b> אמרו שתובעין אותו"
        },
        {
          "width": "216px",
          "text": "דמכיון שלא הגיע לכלל"
        },
        {
          "width": "216px",
          "text": "שנים ושתי שערות ג\"כ לא"
        },
        {
          "width": "216px",
          "text": "הביא קטן ממש הוא ואפי'"
        },
        {
          "width": "216px",
          "text": "לתבוע אין תובעין אותו:"
        },
        {
          "width": "216px",
          "text": "<b>ולמשכן.</b> ולענין למשכנו"
        },
        {
          "width": "216px",
          "text": "לעולם בעינן עד שיביא שתי"
        },
        {
          "width": "216px",
          "text": "שערות והיינו אפי' כבר"
        },
        {
          "width": "216px",
          "text": "הגיע לכלל שנים אכתי לאו"
        },
        {
          "width": "216px",
          "text": "גדול מיקרי ועד שיביא שתי"
        },
        {
          "width": "216px",
          "text": "שערות שאז הוא גדול לכל"
        },
        {
          "width": "216px",
          "text": "עונשין שבתורה ולחיובים"
        },
        {
          "width": "216px",
          "text": "וממשכנין אותו עד שיתן:"
        },
        {
          "width": "216px",
          "text": "<b>כיני מתניתא.</b> כן צריך"
        },
        {
          "width": "216px",
          "text": "למיתני במתני' אין"
        },
        {
          "width": "216px",
          "text": "ממשכנין את הכהנים מפני"
        },
        {
          "width": "216px",
          "text": "דרך הכבוד וכדפרישית"
        },
        {
          "width": "216px",
          "text": "במתני': גמ' <b>טעמא דרבן</b>"
        },
        {
          "width": "216px",
          "text": "<b>יוחנן בן זכאי.</b> דאף"
        },
        {
          "width": "216px",
          "text": "הכהנים חייבין דכתיב זה"
        },
        {
          "width": "216px",
          "text": "יתנו למנין זה י\"ב שבטים"
        },
        {
          "width": "216px",
          "text": "יתנו ואף הכהנים בכלל שבט"
        },
        {
          "width": "216px",
          "text": "לוי הן: <b>כן משיבין חכמים</b>"
        },
        {
          "width": "216px",
          "text": "<b>לר' יהודה.</b> שאמר בשם עדות"
        },
        {
          "width": "216px",
          "text": "בן בוכרי וס\"ל כוותיה"
        },
        {
          "width": "216px",
          "text": "דטעמא שאין הכהן בכלל"
        },
        {
          "width": "216px",
          "text": "החיוב משום שהמנחות באין"
        },
        {
          "width": "216px",
          "text": "מתרומת הלשכה והאיך יהיו"
        },
        {
          "width": "216px",
          "text": "שיריים נאכלין לכהנים"
        },
        {
          "width": "216px",
          "text": "וכדפרישית במתני' וחכמים"
        },
        {
          "width": "216px",
          "text": "משיבין לו דלא היא כשם"
        },
        {
          "width": "216px",
          "text": "שמצינו חילוק בין חטאת"
        },
        {
          "width": "216px",
          "text": "יחיד שמתה ובין חטאת"
        },
        {
          "width": "216px",
          "text": "הצבור שהיא רועה כשאירע"
        },
        {
          "width": "216px",
          "text": "איזה פסול ומקריבין אחרת"
        },
        {
          "width": "216px",
          "text": "תחתיה לפי שאין חטאת"
        },
        {
          "width": "216px",
          "text": "הצבור מתה כך הוא במנחות"
        },
        {
          "width": "216px",
          "text": "מנחת יחיד של כהן הוא"
        },
        {
          "width": "216px",
          "text": "שקריבה כליל ואין מנחת"
        },
        {
          "width": "216px",
          "text": "צבור קריבה כליל והן אלו"
        },
        {
          "width": "216px",
          "text": "ששיריהם נאכלין לכהנים"
        },
        {
          "width": "216px",
          "text": "ויש לכהן חלק בהן כדאמרן"
        },
        {
          "width": "216px",
          "text": "במתני': <b>וקשיא.</b> על הא"
        },
        {
          "width": "216px",
          "text": "דאמרו חטאת צבור אינה מתה"
        },
        {
          "width": "216px",
          "text": "ומשיבין כך לר' יהודה וכי"
        },
        {
          "width": "216px",
          "text": "משיבין לאדם דבר שאינו"
        },
        {
          "width": "216px",
          "text": "מודה בו דהא הכי תנינן"
        },
        {
          "width": "216px",
          "text": "לעיל בריש שני שעירי שאין"
        },
        {
          "width": "216px",
          "text": "חטאת צבור מתה ר' יהודה"
        },
        {
          "width": "216px",
          "text": "אומר תמות ולא משני מידי:"
        },
        {
          "width": "216px",
          "text": "<b>והוא מותיב לון תו.</b> וכן"
        },
        {
          "width": "216px",
          "text": "מצינו שהשיב להם עוד ר'"
        },
        {
          "width": "216px",
          "text": "יהודה דכי לא נדבת יחיד"
        },
        {
          "width": "216px",
          "text": "הוא וכלומר דנהי דאמריתו"
        },
        {
          "width": "216px",
          "text": "דלענין מה ששיריים משל"
        },
        {
          "width": "216px",
          "text": "מנחת הצבור נאכלין לכהנים"
        },
        {
          "width": "216px",
          "text": "לא קשיא דלא נאמר פסוק זה"
        },
        {
          "width": "216px",
          "text": "לא תאכל אלא במנחת הכהן"
        },
        {
          "width": "216px",
          "text": "לבדו אבל מ\"מ הא קשיא"
        },
        {
          "width": "216px",
          "text": "דהיאך קרבנות צבור קריבין"
        },
        {
          "width": "216px",
          "text": "משל נדבת יחיד דכיון שאין"
        },
        {
          "width": "216px",
          "text": "הכהן מחוייב לשקול נדבת"
        },
        {
          "width": "216px",
          "text": "יחיד בתרומת הלשכה איכא:"
        },
        {
          "width": "216px",
          "text": "<b>ואינון מתיבין ליה.</b> דהא"
        },
        {
          "width": "216px",
          "text": "נמי לא קשיא דמכיון"
        },
        {
          "width": "216px",
          "text": "שנמסרה לצבור וכו': <b>כל</b>"
        },
        {
          "width": "216px",
          "text": "<b>דעבר בימא יתן ואידך אמר</b>"
        },
        {
          "width": "216px",
          "text": "<b>וכו' מ\"ד כל דעבר בימא</b>"
        },
        {
          "width": "216px",
          "text": "<b>מסייע לרבן יוחנן בן</b>"
        },
        {
          "width": "216px",
          "text": "<b>זכאי.</b> דמחייב לשקול ואידך"
        },
        {
          "width": "216px",
          "text": "מסייע לבן בוכרי וקמ\"ל"
        },
        {
          "width": "216px",
          "text": "דבהאי פלוגתא גופה היא"
        },
        {
          "width": "216px",
          "text": "דפליגי:"
        }
      ],
