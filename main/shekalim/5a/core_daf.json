  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ופעמים שהם פטורים מזה ומזה היך עבידא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חלקו הנכסים ולא חלקו הבהמה חייבין בזה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובזה חלקו הבהמה ולא חלקו את הנכסים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פטורים מזה ומזה אמר רבי מנא הדא דאת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר בשלא היתה הבהמה רוב אבל אם היתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבהמה רוב הן הן עיקר נכסים רבי אבין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי שמי בעי מפני שעשיתן כאדם אחד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אצל מעשר בהמה את פוטרו מן הקלבון אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה לא שניא היא שהוא נותן סלע אחת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלימה מעתה אפילו חלקו וחזרו ונשתתפו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייבין במעשר בהמה ופטורים מן הקלבון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותנינן חייבין בקלבון ופטורין ממעשר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהמה רבי בא בשם אבא בר רב הונא היא שני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחים שירשו את אביהן היא שני גיסין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שירשו את חמיהן לאיכן היו הקלבנות",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נופלין רבי מאיר אומר לשקלים רבי לעזר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר לנדבה רבי שמעון שזורי אומר ריקוע",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב וצפוי לבית קודש הקדשים בן עזאי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר שולחנין היו נוטלין אותן בשכרן ויש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים להוצאת דרכים הדרן עלך פרק באחד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באדר <b>הלכה א <big>מתני׳</big></b> מצרפין שקלים",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לדרכונות מפני משוי הדרך. כשם שהיו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שופרות במקדש כך היו שופרות במדינה. בני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העיר ששלחו את שקליהן ונגנבו או שאבדו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אם נתרמה התרומה נשבעין לגיזברין ואם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאו נשבעין לבני העיר ובני העיר שוקלין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תחתיהן נמצאו או שהחזירום הגנבים אלו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואלו שקלים ואין עולין להן לשנה הבאה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>גמ׳</b> ויעשו אותן מרגליות שמא תזיל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המרגליות ונמצא ההקדש מפסיד כההיא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתנינן תמן וכולן נפדין בכסף ובשוה כסף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוץ משקלים ואין פודין בכלים ואמר רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל בר רב יצחק שמא יזילו הכלים ונמצא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ההקדש מפסיד אוף הכא נמי שמא תזיל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המרגליות נמצא ההקדש מפסיד מתניתא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתקלין חדתין אבל בתקלין עתיקין לא בדא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותני כן עתיקין במקדש ואין עתיקין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במדינה מתני׳ בשומר חינם אבל בשומר שכר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא בדא אמר רבי אבא ואפילו תימר בשומר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכר נגנבו בלסטים מזויין אבדו כמי שטבעה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ספינתו בים אמר רבי יוסטי בי רבי סימון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אתיא כמאן דאמר תורמין על הגבוי ועל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העתיד לגבות ברם כמאן דאמר אין תורמין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא על הגיבוי ועל העתיד לגבות לא בדא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בני העיר ששלחו את שקליהם כו׳ אמר רבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר דרבי שמעון היא דרבי שמעון אומר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קדשים שהוא חייב באחריותן כנכסיו הן אמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוחנן דברי הכל היא משום שבועת תקנה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על דעתיה דרבי יוחנן ניחא נשבעים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לגזברים ואם לאו נשבעים לבני העיר ובני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העיר שוקלים אחרים",
      "segment_ids": [
        5
      ]
    }
  ],
