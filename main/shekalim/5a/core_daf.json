      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פטורין משום לקוח והעתידין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבוא חייבין דלאו כשותפין הן:",
