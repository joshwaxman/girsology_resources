        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לצדקה ויורד לכם גשם מורה ומלקוש בראשון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומה מקיים רבי יוסי לחדשיו יבכר בכל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חודש וחודש יהיה מבכר ועלהו לתרופה רבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן אמר תרפיה מציץ עליה ותרף מזונה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב ושמואל חד אמר להתיר פה שלמעלן וחד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר להתיר פה שלמטן רבי חנינה ורבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע בן לוי חד אמר להתיר פה עקרות וחד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר להתיר פה אלמים ולעמתן בצפון וכו׳",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את מוצא בשעה שעלה נבוכדנאצר לכאן בא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וישב לו בדופני של אנטוכיא ויצאה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סנהדרין גדולה לקראתו ואמרה לו הגיע זמן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית הזה ליחרב אמר להן אותו שהמלכתי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליכם תנוהו לי ואני הולך באו ואמרו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליהויכין מלך יהודה נבוכדנאצר בעי לך",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כיון ששמע מהן כך נטל מפתחות של בית",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המקדש עלה לגגו של היכל אמר לפניו רבונו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של עולם לשעבר היינו נאמנים לך והיו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפתחותיך מסורין לנו עכשיו שאין אנו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאמנים הרי מפתחותיך מסורין לך תרין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמוראין חד אמר זרקן ועוד לא ירדו וחד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר באה כמין יד ונטלתן מידו כיון שראו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' <b>והיכן היו משתחוין.</b> שלש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עשרה השתחויות דתנן לעיל: <b>שער</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>העליון.</b> הר הבית היה משופע",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ועולה ממזרח למערב והשער",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הסמוך למערב הוא שער העליון",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואחריו שער הדלק הוא שער של",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשכת העצים שהיתה בעזרה ודרך",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שם מכניסין עצי המערכה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שדולקין על המזבח: <b>שער</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הבכורות.</b> שמכניסין שם הבכורות",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנשחטים בדרום: <b>המים מפכים.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש בגמ': <b>שער הקרבן.</b> שם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכניסין קדשי קדשים ששחיטתן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בצפון: <b>שער הנשים.</b> שבו הנשים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נכנסות לסמוך על קרבנן א\"נ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעמוד על קרבנן: <b>שער השיר.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרך שם היו מכניסין כלי שיר:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שבו יצא יכניה בגלותו.</b> שנכנס",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבית המקדש להשתחוות וליטול",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רשות כשהלך לגולה לבבל ויצא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרך אותו השער: <b>שער נקנור.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש בפרק א\"ל הממונה:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>פשפשין.</b> שערים קטנים בתוך",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שערים גדולים ואף הם ממנין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלשה עשר שערים ואע\"ג דגם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשער בית המוקד היה לו פשפש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא חשיב ליה לפי שהיה קטן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביותר: גמ' <b>מתני'.</b> אתיא כאבא",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוסי בן יוחנן דאמר י\"ג שערים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היו במקדש אבל לרבנן דאמרי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבעה שערים היו במקדש קשיא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היכן היו משתחוים דקים להו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיו משתחוים שלשה עשר",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השתחויות: <b>ומשני כהאי דתנינן</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תמן.</b> במסכת מדות: <b>כקרני כיילי</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וסיילי.</b> מיני שבלול הם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקרניהם דקים מאוד וקרני",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חגבים עבים מהם וחוט של שתי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עב מהם וחוט של ערב עב ממנו:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מכאן ואילך.</b> מתגבר והולך כמפי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפך: <b>מן הכתף הימנית.</b> מצד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דרום: <b>וימד אלף באמה.</b> המלאך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראה ליחזקאל נחל היוצא מבית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קדשי קדשים תחלתו דק מאוד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והולך וגדל מאוד וכל אלף אמה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אורך משיצא חוץ לירושלים לא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה עמוק:מי אפסים. שהגיעו עד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרסולים: <b>וימד אלף.</b> באמה שנית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והעמיקו עד הברכיים מכאן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואילך וימד אלף אשר לא יוכל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעבור בו שהיו מימיו רדופים:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לבירנין גדולה.</b> ספינה גדולה:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מלשוט.</b> דאפילו בדרך שייטא לא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יכול לעבור בו דרדיפו מיא:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>באתרין.</b> במקומינו קורין לשייט",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחונא: <b>ופרש ידיו וכו'.</b> מייתי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראיה דלשחות היינו לשוט: <b>מיין</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דמתמללין בעלמא.</b> שידברו העולם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו ויראו אותו ל\"א שידברו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העולם בהן מחמת גדולתן: <b>מבית</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דוד ועד יושבי ירושלים.</b> קשיא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה אטו לשאר ישראל אינן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשרים הלכך קאמר מה שהמקור",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הולך מבית דוד ועד יושבי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ירושלים הוא דכשר לאפר פרה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולטבול בהן נדות אבל משם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואילך פסול למי חטאת דמי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תערובות הם ממי גשמים ולחטאת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעינן מים חיים: <b>מי קטפריסות</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הן.</b> הר משופע שמדרונו מחודד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאוד והעבירו המים דרך דף",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנתון במדרון ופסולים גם לנדה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לטבול בהן א\"נ לנדה היינו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זבה: <b>זה ים של סמכו.</b> דשבע",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימים סובבים לא\"י וד' מהם ים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של סמכו ושל טבריא וים המלח",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וים הגדול ומפרש דגלילה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקדמונה הוא ים של סמכו: <b>ים</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הגדול.</b> הוא הים ההולך מא\"י",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למדינת איספנייא: <b>בראשונה.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדור אנוש יצא עד מדינה ששמה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קלבריאה והיא במדינת צרפת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובדור הפלגה יצא עד הסלעים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבמדינת ברבריאה: <b>עד עכו</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תבוא.</b> דריש פה כמו כה: <b>ניחא</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ימא רבא וימא דמלחא.</b> שהוצרך",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המעיין לבא לשם כדי למתקן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמימיהם מלוחים וסרוחים אלא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימא דטבריא וימא דסמכו למה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באו לשם: <b>ומשני לרבות דגתם.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שע\"י מים אלו יתברכו מימיהם",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לגדל דגים הרבה: <b>למינה תהיה</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דגתם.</b> קרא יתירא הוא דפשיטא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלמינה תהיה אלא ללמד דמיני",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מינים משונים שלא היו בתוכם",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקדם יגדלו בהם: <b>מקום הוא</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ששמו ולא ירפאו.</b> וה\"פ ביצאתיו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וגבאיו ומקום ששמו ולא ירפאו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למלח ניתנו ולא יבואו לשם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המים הקדושים: <b>תבואה עושה.</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פי' תבואה גדילה לששה חדשים:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לחדשיו יבכר.</b> האילן יוצא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירותיו לשני חדשים וכיון",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשנים עשר חדשים נעשו שני",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חדשים ה\"ה מה שנעשה בתבואה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעה\"ז בששה חדשים נעשה לעתיד",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחודש א': <b>שהתבואה עשתה בימי</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יואל לט\"ו יום.</b> א\"כ אילנות",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשלשים יום כפל מהתבואה:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בראשון.</b> היינו בר\"ח ניסן ירדו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגשמים וכתיב ובני ציון גילו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושמחו בה' אלהיכם היינו הקרבת",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העומר: <b>ומשני בכל חדש וחדש</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>יהא מבכר.</b> האילן ולחדשיו היינו חדשים דעלמא: <b>תרפיה מציץ עליה.</b> הפירות נראים יותר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מן העלין שבאילנות: ופריך <b>ותרף מזונה.</b> וכי תרף מזון הוא דקאמרת הפירות נראים יותר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מן העלין. ל\"א דרש תרפיה כמו טרף בטי\"ת מלשון מזון וה\"ק משעה שפורח עליה מיד נותן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מזונו שלא כדרך הטבע שהפרח מתאחר לנוץ אחר יציאת העלים ימים רבים והראשון נ\"ל:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>להתיר פה שלמעלן.</b> היינו פה אלמים: <b>פה שלמטן.</b> היינו פה עקרות: <b>את מוצא בשעה שעלה</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>נ\"נ.</b> לא\"י כדי ליקח את יהויכין אחר שהמליכוהו במקום יהויקים אביו ויעצוהו שרי בבל",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לסלקו: <b>זרקן.</b> כלפי מעלה ועוד לא ירדו להראות להם שאינו חפץ בעבודתם: <b>כיון שראו כל</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>חורי יהודה כן.</b> שאין רצון המקום בעבודתם ושנמס לב המלך בקרבו:",
      "gemara_segment_ids": [
        6
      ]
    }
  ],
