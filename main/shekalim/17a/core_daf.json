  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "של ניסוך המים בחג רבי אליעזר בן יעקב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר בו המים מפכים ועתידין להיות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוצאין מתחת מפתן הבית לעומתן בצפון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סמוכים במערב שער יכניה שער הקרבן שער",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנשים שער השיר ולמה נקרא שמו שער יכניה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבו יצא יכניה בגלותו שבמזרח שער נקנור",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושני פשפשין היו לו אחד מימינו ואחד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משמאלו ושנים במערב ולא היה להן שם <b>גמ׳</b>",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתניתין אבא יוסה בן יוחנן היא דאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כנגד שלשה עשר שערים ברם כרבנן שבעה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שערים היו בעזרה על דעתייהו דרבנן היכן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו השתחוואות הללו כי ההיא דתנינן תמן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלש עשרה פרצות היו בו שפרצום מלכי יון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחזרו וגדרום בני חשמונאי וגזרו כנגדן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלש עשרה השתחוואות כתיב והיה ביום ההוא",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצאו מים חיים מירושלים וגו׳ תני מבית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קדשי קדשים עד הפרוכת כקרני סילי וכיליי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן פרוכת עד מזבח הזהב כקרני חגבים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממזבח הזהב עד עזרות כחוט של שתי מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העזרות עד מפתן הבית כחוט של ערב מיכן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואילך כמפי הפך כתיב והנה מים מפכים מן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכתף הימנית בצאת האיש קדים וקו בידו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וימד אלף באמה ויעבירני במים מי אפסים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד קרסולה וימד אלף ויעבירני במים מי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברכים עד ברכייה וימד אלף ויעבירני מי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתנים עד מתנייא מכאן ואילך וימד אלף",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נחל אשר לא אוכל לעבור אפילו לבירנין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדולה אינה יכולה לעבור בו מאי טעמא וצי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדיר לא יעברנו מפני מה כי גאו המים מי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחו מהו מי שחו מלשוט אמר רב חונה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באתרין קרו לשייטא שחונא ופרש ידיו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקרבו כאשר יפרש השוחה לשחות מהו לשחות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יוסי בי רבי בון מיין דמתמללין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעלמא כתיב ביום ההוא יהיה מקור נפתח",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבית דויד וליושבי ירושלם לחטאת ולנידה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמואל בר נחמן בשם רבי יונתן מבית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דוד ועד יושבי ירושלם כשרים לנדה ולחטאת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מכאן ואילך מי תערובות הם כשרים לנדה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ופסולים למי חטאת אמר רבי אלעזר מבית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דוד ועד יושבי ירושלם כשרים לנידה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולחטאת מכאן ואילך מי קטפריסות הן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פסולין לנדה ולחטאת כתיב ויאמר אלי המים",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האלה יוצאים אל הגלילה הקדמונה זה ים של",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סמכו וירדו אל הערבה זה ים של טבריא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובאו הימה זה ים המלח אל הימה המוצאים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זה הים הגדול ולמה נקרא שמו מוצאים כנגד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שתי פעמים שיצא אחד בדור אנוש ואחד בדור",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפלגה רבי לעזר בשם רבי חנינה בראשונה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצא עד קלבריאה ובשניה יצא עד כיפי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברבריאה רבי אחא בשם רבי חנינה בראשונה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצא עד כיפי ברבריאה ובשניה יצא עד עכו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ועד יפו עד פה תבא ולא תוסיף עד עכו תבא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא תוסיף ופה ישית בגאון גליך עד יפו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אשית גאון גליך ניחא ימא רבא וימא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמילחא בשביל למיתקן ימא דטבריא ימא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דסמכו לרבות דגתם דכתיב ביה למינה תהיה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דגתם למיני מינים תהיה דגתם תני אמר רבן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעון בן גמליאל מעשה שהלכתי לציידן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והביאו לפני יותר משלש מאות מיני דגים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתמחוי אחד ונרפאו המים בצאתיו וגבאיו",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא ירפאו למלח ניתנו כתיב ונרפאו המים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואת אמרת ולא ירפאו המים מקום הוא ושמו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא ירפאו כתיב ועל הנחל יעלה על שפתו",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מזה ומזה כל עץ מאכל לא יבול עלהו ולא",
