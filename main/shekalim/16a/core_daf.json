  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "והלא ארון בציון היה מה עבדין ליה רבנן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סכך שהוא כקירוי שעדיין לא נבנה בית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבחירה משנגנז הארון נגנז עמו צנצנת המן",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וצלוחית שמן המשחה ומקלו של אהרן ופרחיו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושקדיו וארגז שהשיבו פלשתים אשם לאלהי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל מי גנזו יאשיהו גנזו כיון שראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכתוב יולך ה׳ אותך ואת מלכך אשר תקים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליך אל גוי אשר לא ידעת אתה ואבותיך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עמד וגנזו הדא הוא דכתיב ויאמר ללוים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המבינים לכל ישראל הקדושים לה׳ תנו את",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארון הקדש בבית אשר בנה שלמה בן דוד מלך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל אין לכם משא בכתף אמר להם אם גולה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא עמכם לבבל אין אתם מחזירין אותו עוד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למקומו אלא עתה עבדו את ה׳ אלהיכם ואת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עמו ישראל פטום שמן המשחה ואתה קח לך",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגו׳ וקידה חמש מאות וגו׳ שהן אלף וחמש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאות מנים שמן זית הין שנים עשר לוג שבו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שולקין את העיקרין דברי רבי מאיר רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אומר שולקן היה במים ונותן שמן על",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גביהן משהיה קולט את הריח היה מעבירו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כדרך שהפטמין עושין הדא הוא דכתיב שמן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משחת קדש וגו׳ תני רבי יהודה בי רבי",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אילעי שמן המשחה שעשה משה במדבר מעשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נסים נעשה בו מתחלה ועד סוף שמתחלה לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היה בו אלא שנים עשר לוג שנאמר שמן זית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הין אם לסוך בו את העיקרין לא היה בו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ספק על אחת כמה וכמה שהאור בולע והעצים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בולעים והיורה בולעת וממנו נמשחו המשכן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכל כליו השולחן וכל כליו המנורה וכל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כליה וממנו נמשחו אהרן כהן גדול ובניו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל שבעת ימי המלואים וממנו נמשחו כהנים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדולים ומלכים מלך בתחלה טעון משיחה מלך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן מלך אין טעון משיחה מאי טעמא קום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משחהו כי זה הוא זה טעון משיחה ואין בנו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טעון משיחה אבל כהן גדול בן כהן גדול",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו עד עשרה דורות טעון משיחה וכולו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קיים לעתיד לבא הדא הוא דכתיב שמן משחת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודש יהיה זה לי לדורותיכם אין מושחין",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המלכים אלא על גבי המעיין שנאמר והרכבתם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את שלמה בני על הפרדה אשר לי והורדתם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו אל גיחון ומשח אותו שם צדוק הכהן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונתן הנביא למלך על ישראל אין מושחין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלך בן מלך אלא מפני המחלוקת מפני מה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמשח שלמה מפני מחלוקתו של אדוניהו יואש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני עתליהו יהואחז מפני יהויקים אחיו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיה גדול ממנו שתי שנים יהוא מפני יורם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא כן כתיב קום משחהו כי זה הוא זה טעון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משיחה ואין מלכי ישראל טעונין משיחה אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהואחז מפני יהויקים אחיו שהיה גדול",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממנו שתי שנים ולא יאשיהו גנזו הדא אמרה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באפרסמון נמשח אין מושחין המלכים אלא מן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקרן שאול ויהוא נמשחו מן הפך היתה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלכותן מלכות עוברת דוד ושלמה נמשחו מן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקרן היתה מלכותן מלכות קיימת אין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מושחין כהנים מלכים אמר רבי יודה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ענתונדרייא על שם לא יסור שבט מיהודה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי חייא בר אדא למען יאריך ימים על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממלכתו הוא ובניו בקרב ישראל מה כתיב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתריה לא יהיה לכהנים הלוים אמר רבי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן הוא יוחנן הוא יהואחז והא כתיב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבכור יוחנן בכור למלכות אמר רבי יוחנן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא שלום הוא צדקיהו והכתיב השלישי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צדקיהו והרביעי שלום שלישי לתולדות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רביעי למלכות צדקיהו שצידק עליו מדת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדין שלום שבימיו שלמה מלכות בית דוד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(ריש לקיש אמר) לא שלום הוה שמיה ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צדקיהו הוה שמיה אלא מתניה הדא הוא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכתיב וימלך מלך בבל את מתניה דודו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תחתיו ויסב את שמו צדקיהו אמר רבי יוחנן",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באמה של ששה טפחים היה הארון עשוי מאן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנא באמה של ששה טפחים רבי מאיר היא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתנן רבי מאיר אומר כל האמות היו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבינונית רבי יהודה אומר אמות הבנין ששה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של כלים חמשה על דעתיה דרבי מאיר דו אמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באמה של ששה טפחים היה הארון עשוי אורכו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של ארון חמשה עשר טפחים דכתיב אמתים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחצי ארכו אמתא אשיתא ואמתא אשיתא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ופלגות אמתא תלתא וארבעה לוחות היו בו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנים שלמים ושנים שבורים דכתיב אשר שברת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושמתם בארון הלוחות היו כל אחד ואחד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארכו ששה טפחים רחבו ששה ותן ארכן של",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לוחות לאורכו של ארון נשתייר שם שלשה",
      "segment_ids": [
