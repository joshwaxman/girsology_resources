  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "והלא ארון בציון היה מה עבדין ליה רבנן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סכך שהוא כקירוי שעדיין לא נבנה בית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבחירה משנגנז הארון נגנז עמו צנצנת המן",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וצלוחית שמן המשחה ומקלו של אהרן ופרחיו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושקדיו וארגז שהשיבו פלשתים אשם לאלהי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל מי גנזו יאשיהו גנזו כיון שראה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכתוב יולך ה׳ אותך ואת מלכך אשר תקים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליך אל גוי אשר לא ידעת אתה ואבותיך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עמד וגנזו הדא הוא דכתיב ויאמר ללוים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המבינים לכל ישראל הקדושים לה׳ תנו את",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארון הקדש בבית אשר בנה שלמה בן דוד מלך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל אין לכם משא בכתף אמר להם אם גולה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא עמכם לבבל אין אתם מחזירין אותו עוד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למקומו אלא עתה עבדו את ה׳ אלהיכם ואת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עמו ישראל פטום שמן המשחה ואתה קח לך",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגו׳ וקידה חמש מאות וגו׳ שהן אלף וחמש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאות מנים שמן זית הין שנים עשר לוג שבו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שולקין את העיקרין דברי רבי מאיר רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אומר שולקן היה במים ונותן שמן על",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גביהן משהיה קולט את הריח היה מעבירו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כדרך שהפטמין עושין הדא הוא דכתיב שמן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משחת קדש וגו׳ תני רבי יהודה בי רבי",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אילעי שמן המשחה שעשה משה במדבר מעשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נסים נעשה בו מתחלה ועד סוף שמתחלה לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היה בו אלא שנים עשר לוג שנאמר שמן זית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הין אם לסוך בו את העיקרין לא היה בו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ספק על אחת כמה וכמה שהאור בולע והעצים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בולעים והיורה בולעת וממנו נמשחו המשכן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכל כליו השולחן וכל כליו המנורה וכל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כליה וממנו נמשחו אהרן כהן גדול ובניו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל שבעת ימי המלואים וממנו נמשחו כהנים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדולים ומלכים מלך בתחלה טעון משיחה מלך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן מלך אין טעון משיחה מאי טעמא קום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משחהו כי זה הוא זה טעון משיחה ואין בנו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טעון משיחה אבל כהן גדול בן כהן גדול",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו עד עשרה דורות טעון משיחה וכולו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קיים לעתיד לבא הדא הוא דכתיב שמן משחת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קודש יהיה זה לי לדורותיכם אין מושחין",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המלכים אלא על גבי המעיין שנאמר והרכבתם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את שלמה בני על הפרדה אשר לי והורדתם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו אל גיחון ומשח אותו שם צדוק הכהן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונתן הנביא למלך על ישראל אין מושחין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלך בן מלך אלא מפני המחלוקת מפני מה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נמשח שלמה מפני מחלוקתו של אדוניהו יואש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני עתליהו יהואחז מפני יהויקים אחיו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיה גדול ממנו שתי שנים יהוא מפני יורם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא כן כתיב קום משחהו כי זה הוא זה טעון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משיחה ואין מלכי ישראל טעונין משיחה אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהואחז מפני יהויקים אחיו שהיה גדול",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממנו שתי שנים ולא יאשיהו גנזו הדא אמרה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באפרסמון נמשח אין מושחין המלכים אלא מן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקרן שאול ויהוא נמשחו מן הפך היתה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלכותן מלכות עוברת דוד ושלמה נמשחו מן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקרן היתה מלכותן מלכות קיימת אין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מושחין כהנים מלכים אמר רבי יודה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ענתונדרייא על שם לא יסור שבט מיהודה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי חייא בר אדא למען יאריך ימים על",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממלכתו הוא ובניו בקרב ישראל מה כתיב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בתריה לא יהיה לכהנים הלוים אמר רבי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן הוא יוחנן הוא יהואחז והא כתיב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבכור יוחנן בכור למלכות אמר רבי יוחנן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא שלום הוא צדקיהו והכתיב השלישי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צדקיהו והרביעי שלום שלישי לתולדות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רביעי למלכות צדקיהו שצידק עליו מדת",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדין שלום שבימיו שלמה מלכות בית דוד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(ריש לקיש אמר) לא שלום הוה שמיה ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צדקיהו הוה שמיה אלא מתניה הדא הוא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכתיב וימלך מלך בבל את מתניה דודו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תחתיו ויסב את שמו צדקיהו אמר רבי יוחנן",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באמה של ששה טפחים היה הארון עשוי מאן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנא באמה של ששה טפחים רבי מאיר היא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דתנן רבי מאיר אומר כל האמות היו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בבינונית רבי יהודה אומר אמות הבנין ששה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של כלים חמשה על דעתיה דרבי מאיר דו אמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באמה של ששה טפחים היה הארון עשוי אורכו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של ארון חמשה עשר טפחים דכתיב אמתים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחצי ארכו אמתא אשיתא ואמתא אשיתא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ופלגות אמתא תלתא וארבעה לוחות היו בו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנים שלמים ושנים שבורים דכתיב אשר שברת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושמתם בארון הלוחות היו כל אחד ואחד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארכו ששה טפחים רחבו ששה ותן ארכן של",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לוחות לאורכו של ארון נשתייר שם שלשה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טפחים",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>נגנז עמו צנצנת המן.</b> דכתיב בארון אשר אועד לך שמה וכתיב בצנצנת המן ותן שמה מלא העומר מן ויליף שמה שמה גזירה שוה:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וצלוחית שמן המשחה.</b> דכתיב בו שמן משחת קודש יהיה זה לי לדורותיכם וכתיב גבי צנצנת למשמרת לדורותיכם ויליף דורות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דורות: <b>ומקלו של אהרן.</b> דכתיב למשמרת לאות לבני מרי ובצנצנת כתיב למשמרת: <b>וארגז שהושיבו פלשתים אשם לאלהי ישראל.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דכתיב תשימו בארגז מצידו אלמא גבי ארון הוה קאי וממילא שמעינן דעמו נגנז: <b>יולך ה' אותך וגו'.</b> ודאג שמא יגלה: <b>תנו את</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הארון הקודש בבית.</b> הא התם הוה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאי אלא גניזה היא: <b>אין אתם</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מחזירין אותו למקומו.</b> שאין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצות בכתף ישאו נוהגת בלוים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אז ועוד שיתחלל קדושת הארון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בירידתו לבבל: <b>פיטום שמן</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המשחה וכו'.</b> מדפריך עלה לקמן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהא דיאשיה גנזו מייתי ליה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכא ודלא כמהרא\"פ: <b>שהוא אלף</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ות\"ק מנים.</b> דמפרש קרא כדכתיב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקנמן בשם וקנה בשם כל אחד לא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה אלא ר\"ן מנה ודקשיא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחציתו דקנמון בשם למאי אתא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "י\"ל דגזירת הכתוב הוא שיביא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ת\"ק מנים וחוצהו ולוקח ממנו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ר\"ן מנים לשמן המשחה וכה\"ג",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמרינן במנחות מביא עשרון שלם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחוצהו ומקריב ומחצה אבד ודלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמהר\"א פולדא: <b>העיקרין.</b> הן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבשמים: <b>שולקן היה במים.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיבלעו המים וכשיציף עליהם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השמן לא יבלעו אותו העיקרין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דשמן המועט הזה היה נבלע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעיקרין המרובין: <b>וממנו</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דנמשחו אהרן וכו'.</b> דכתיב שבעת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימים ימלא את ידכם ואיתקש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משיחה לריבוי דכתיב למשחה בהם",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמלא את ידם: <b>טעונין משיחה.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכתיב והכהן המשיח תחתיו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מבניו לימא קרא והכהן שתחתיו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מבניו מאי המשיח אלא הא קמ\"ל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאפי' מבניו אי נמשח הוה כה\"ג",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם לאו לא הוה כה\"ג: <b>הה\"ד</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שמן משחת קדש יהיה זה לי</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לדורותיכם.</b> דזה בגימטריא י\"ב",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר אף לדורות יהיה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגימטריא זה: <b>אלא ע\"ג מעיין.</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שתמשוך מלכותו דסימנא מילתא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היא: <b>גיחון.</b> מעיין קטן סמוך",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לירושלים ולא זהו גיחון הגדול",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היוצא מגן עדן: <b>מפני מחלוקת</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>של אדוניהו.</b> דכתיב למען יאריך",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימים וגו' בקרב ישראל בזמן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ששלום בישראל המלכות ירושה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא בעי משיחה אבל אי איכא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחלוקת לאו ירושה היא ובעי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משיחה בתחילה: ופריך <b>לא כן</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כתיב וכו'.</b> ואין מלכי ישראל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעונין משיחה ויורם מלך ישראל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוה: <b>אלא יהואחז וכו'.</b> כלומר",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סמי מכאן יהוא מפני יורם ותני",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהואחז מפני יהויקים: ופריך",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ולא יאשיהו גנזו.</b> לשמן המשחה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדאמרי' לעיל ויהואחז",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויהויקים בני יאשיהו היו ואיך",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמרת דיהואחז נמשח בשמן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המשחה: <b>ומשני הדא אמרה.</b> זאת",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אומרת שיהואחז בשמן אפרסמון",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמשת ולא בשמן המשחה א\"נ ה\"ק",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון דעכ\"ל דבשמן אפרסמון",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמשח א\"כ אין צריך להגיה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הברייתא דאף יהוא בשמן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפרסמון נמשח: <b>אין מושחין</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כהנים מלכים.</b> ואע\"פ שאינו זר",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אצל שמן המשחה דהא כבר נמשח",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשנעשה כה\"ג אפ\"ה אין מושחין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו למלוכה כמלכי ישראל דאין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מושחין אלא מלכי בית דוד: <b>לא</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יסור שבט מיהודה.</b> וכל מלכות",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו לירושה לעולם אין נמשח",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשמן המשחה: <b>וכתיב בתריה לא</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יהיה לכהנים הלוים.</b> שאפילו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למלך אין ממנים כהן וכ\"ש",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינן נמשחים: <b>הוא יוחנן הוא</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יהואחז.</b> דבדברי הימים כתיב",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובני יאשיהו הבכור יוחנן השני",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהויקים השלישי צדקיהו הרביעי",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלום ויוחנן הוא יהואחז",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דיהויקים וצדקיהו מצינו שמלכו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאחר יהואחז ש\"מ דיהואחז הוא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוחנן: ופריך <b>והא כתיב הבכור</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יוחנן.</b> ולעיל אמרינן שיהויקים",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גדול מיהואחז שתי שנים: <b>ומשני</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בכור למלכות.</b> שמלך ראשון:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רביעי למלכות.</b> שמלך יהואחז",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואחריו יהויקים ואחריו יכניה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנו ואחריו צדקיהו: <b>שצידק</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עליו.</b> נבוכדנצר את הדין ואמר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו יה יצדיק עליך את הדין אם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמרוד בי ולכך קרא שמו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צדקיהו: <b>כל האמות.</b> אפילו של",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלים היו בינונית דהיינו באמה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בת ששה טפחים: <b>אמתא אשיתא.</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמה אחת היא ששה טפחים: <b>אשר</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שברת ושמתם בארון.</b> דאשר שברת",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיותר ללמדך דאף השבורות ישים",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בארון וכל לוח רחבו ג': <b>ה\"ג ורחבן שלשה.</b> כן הוא בסוטה: <b>תן מהם חצי טפח לכל כותל.</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהרי מבחוץ נמדד אמתיים וחצי ארכו: ה\"ג תן רחבן של לוחות לרחבו של ארון: <b>ה\"ג חצי</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>טפח מכאן וחצי טפח מכאן לכותל נשתיירו שני טפחים לשילוט.</b> וה\"פ לשילוט שתהא ס\"ת",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נכנסת ויוצאת בריוח לפי שהיתה מונחת אורכה לרוחב הארון דהיינו באותן שני טפחים",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שנשתיירו באורך הארון וס\"ת עביה שני טפחים וארכה ששה טפחים והיתה מונחת בדוחק",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "באותן שני טפחים שבאורך לכך היה הארון רוחב יותר ב\"ט לשילוט וליטלה כרצונו:",
      "gemara_segment_ids": [
        6
      ]
    }
  ],
