  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בעי משיזגה אסקופתיה בגו נהרא ואינשתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואזיל ליה חזר בעי מיסבינה אמר ליה רב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אסור לך דנא אמר ההיא שטף נהרא ואייתי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חורי דנבילה תחתוי חד בר נש הוה מהלך",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשוקא טעין קופד אתא דייתא וחטפתיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיניה וטלקתיה חזר בעי מיסבינא אמר ליה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב אסור לך דנא אמר בשר דנבילה הוות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טעינא וטלקתיה ונסבה ההוא אוחרנא גינאי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שטף זיקין אתא עובדא קומי רבי יצחק ברבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר ואמר יחכמון שפייא קיטרהון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נקוניקה אשתכח בכנישתא דבולי אתא עובדא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קומי רבי ירמיה אמר יתחכמון סקורייא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עבידתהון גדי צלי אשתכח באסרטי דגופתא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והתירוהו משום שני דברים משום מציאה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומשום רוב מהלכי דרכים משום מציאה דתני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המציל מיד הארי מיד הגייס משונת הים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומשונת הנהר ומאיסרטיא גדולה ומפלטיא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדולה הרי אלו שלו מפני שהבעלים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתייאשין מהן משום רוב מהלכי דרכים משום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שחיטת גוי ואישתכח מן דבית רבי עיגול",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דגובנא אישתכח בפונדקא דלוי והתירוהו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משום שני דברים משום מציאה ומשום רוב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מהלכי דרכים משום מציאה דתני המציל מיד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הגייס מיד הארי משונת הים ומשונת הנהר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאיסרטיא גדולה ומפלטיא גדולה הרי אלו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלו מפני שהבעלים מתייאשין מהן משום רוב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מהלכי דרכים משום גבינת גוי ואישתכח מן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבי אלעזר בר׳ יוסי אמר רבי מנא קומי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסי ואנן חמיין רבנן מכריזין אמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה את אין הוויתה משכח לא נסבת רבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יונה אבוך לא אמר כן אלא אמר הלואי כד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נשכח נשכח מן פיוסא ולגוא אפילו כן אשכח",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולא נסיב <b>הלכה ג <big>מתני׳</big></b> בהמה שנמצאת",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מירושלם ועד מגדל עדר, וכמדתה לכל רוח,",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זכרים – עולות, נקבות – זבחי שלמים. רבי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אומר: הראוי לפסחים לפסחים, קודם",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרגל שלשים יום. בראשונה היו ממשכנין את",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מוצאיה עד שהוא מביא (עמה) נסכיה חזרו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להיות מניחין אותה ובורחין התקינו בית",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דין שיהו נסכיה באין משל צבור אמר רבי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעון שבעה דברים התקינו בית דין וזה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד מהן גוי ששלח עולתו ממדינת הים ושלח",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עמה נסכים קריבין משלו ואם לאו קריבין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משל צבור וכן גר שמת והניח זבחים אם יש",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו נסכים קריבין משלו ואם לאו קריבין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משל צבור ותנאי בית דין הוא על כהן גדול",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמת שתהא מנחתו קריבה משל צבור רבי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה אומר משל יורשין ושלימה היתה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קריבה על המלח ועל העצים שיהו הכהנים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאותין בהן ועל הפרה שלא יהו מועלין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באפרה ועל הקינין הפסולות שיהו באות משל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "צבור רבי יוסי אומר המספק את הקינין הוא מספק את הפסולות <b>גמ׳</b> רבי הושעיא",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "רבה אמר לבא בדמיהן שנו אמר ליה רבי יוחנן אומרים לו לאדם צא ומעול",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בקדשים אלא הילכו בהן אחר הרוב אם רוב זכרים עולות אם רוב נקבות זבחי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שלמים ואין השלמים באין מן הזכרים ומן הנקבות כיצד הוא עושה מוציאן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לחולין וחוזר ועושה אותן",
      "segment_ids": [
        7
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רב ירד לבבל.</b> ראה אותן שהן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקילין באיסור בשר להניחו ביד",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עכו\"ם והחמיר עלייהו ואסר כל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר שנתעלם מן העין וכדמסיק:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חד בר נש.</b> אדם אחד הלך לרחוץ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר בנהר ונפל מידו והלך לו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חזר ורצה ללקחו מתוך הנהר א\"ל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רב אסור לך בשר זה שאני אומר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשון שטפו נהר והביא בשר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחר של נבילה במקומו: <b>חד בר</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נש.</b> אדם אחד הוה מהלך בשוק",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעון בשר בא עוף ששמו דיה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחטפו ממנו והשליכו במקום אחר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ורצה האדם ההוא לחזור ללקחו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א\"ל רב אסור לך הא שאני אומר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשר נבילה היתה נושאת וזרקתו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והאי שלקחו ממנו אכלה: <b>גינאי.</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נהר ששמו גינאי שטף נודות של",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יין של ישראל ומצאוהו אח\"כ:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יחכמון וכו'.</b> יראו שופכי יין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אם מכירין שזו היא קשריהן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקושרין הנודות יחד ויש להן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סימן בקשרים מותרים: <b>נוקניקה.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מין קנקן נמצא בבה\"כ של עיר",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ששמה בולי והיה מלא יין: <b>אמר</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יחכמון וכו'.</b> יראו רושמי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החביות בסיקרי אם יכירו שהוא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מרושם שלהם ה\"ל סימן ומותר:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>באסרטא דגופתא.</b> ברחוב של עיר",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ששמה גופתא: <b>משונת הים.</b> מקום",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהים מגיע לשם בשעה שהוא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סוער: <b>משום שחיטת העכו\"ם.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאזלינן בתר רוב מהלכי דרכים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובדרך ההוא היו הרוב ישראל:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואשתכח דבית ר'.</b> ונתברר אח\"כ",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיה הגדי משל בית ר' וכדין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התירוהו: <b>עיגול דגובנא.</b> עיגול",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של גבינה מצאו בפונדק של לוי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיו שם רוב ישראל: <b>ומשום רוב</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מהלכי דרכים.</b> ולא אסרו משום",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבינות העכו\"ם: <b>ואשתכח מן דר'</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אלעזר בר' יוסי.</b> ומצאו שהיה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגבינה של ראבר\"י וכדין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התירוהו (והר\"א פולדא לא דק):",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>א\"ר מנא.</b> לפני ר' יוסי ואנו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רואין שחכמים מכריזין אפילו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוצאין בפלטיא הגדולה ושאר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקומות כיוצא בהן: <b>א\"ל אתה.</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אם היית מוצא דבר לא היית",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נוטלו לעצמך ורבי יונה אביך",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא אמר כן אלא אמר הלואי",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאמצא מציאה לפני' מן פיוסריס",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוא מקום שרבים מצויין שם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא אכריזנה: <b>אפילו כן.</b> סתמא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דש\"ס קאמר אפ\"ה פעם אחת מצא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ר' יונה לפנים מן פיוסרוס",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והחמיר על עצמו והכריזו:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' <b>זכרים עולות.</b> שאנו",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תולין שיצאו מירושלים ורוב",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זכרים שבירושלים הן עולות",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ורוב נקבות זבחי שלמים: <b>הראוי</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לפסחים.</b> זכר בן שנה מן הכבשים",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או מן העזים פסחים והמוצאו",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מותר להקריבו לפסחו: <b>קודם</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לרגל שלשים יום.</b> משעה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמתחילין לדרוש בהל' פסח ואדם מפריש את פסחו: <b>ממשכנין את מוצאיה.</b> המוצא עולות או שלמים היו ממשכנין אותו עד שיביא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נסכיה משלו שלשה עשרוני' לפר ושני עשרונים לאיל ועשרון לכבש: <b>מניחין אותה ובורחין.</b> כדי שלא להתחייב בנסכיה: <b>שבעה</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דברים.</b> קחשיב להו ואזיל: <b>עכו\"ם ששלח עולתו.</b> דדרשינן איש איש שעכו\"ם נודרים נדרים ונדבות כישראל: <b>שתהא מנחתו עשירית</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>האיפה.</b> שכהן גדול מקריב בכל יום מחציתה בבוקר ומחציתה בערב: <b>קריבה משל ציבור.</b> בגמ' מפרש טעמייהו דר\"ש ור' יהודה:",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ושלימה היתה קריבה.</b> כשהיא באה משל ציבור לר\"ש או משל יורשים לר\"י עשרון שלם היתה קריבה ולא חצי עשרון ובגמרא מפרש",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מנ\"ל: <b>שיהיו הכהנים נאותים בהן.</b> דוקא לאכילת קרבנות אבל לאכילת חולין אפילו אותן הנאכלין בעזרה כדי שיאכלו הקרבנות",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על השובע אין ניאותין בהן: <b>שלא יהיו מועלין באפרה.</b> בגמ' מפרש לה: <b>ועל הקינין הפסולות.</b> המחוייבין קינין מביאין מעות",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ונותנין לשופר וב\"ד לוקחין המעות וקונין בהן קינין והבעלים הולכים להם וסומכין על הב\"ד שיקריבו קיניהן ואם פרחו",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הקינים או נמצאו פסולים תנאי ב\"ד הוא שיקחו אחרים מתרומת הלשכה ומקנים אותן לבעלי' ויוצאים בהן ידי חובתן: <b>המספק את</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הקינים.</b> אותן שפסקו עם הגזברים למכור להם כל הקינין הצריכין הוא חייב להחליף כל שימצא בו פסול: גמ' <b>לבא בדמיהן שנו.</b>",
      "gemara_segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כלומר איהי ודאי לא קרבה וה\"ק אם בא אדם זה המוצאה לעשות לה תקנה ובא לקבל על עצמו חוב כל דמים שהוא בספק ולהוציאה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לחולין ולהקדיש את דמיה אם זכר הוא נתחייב אף בדמי עולה דחיישינן שמא עולות הן: <b>אומרים לאדם וכו'.</b> דכל בהמות הקדש",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הראויה למזבח אסור לחללן דכתיב אם בהמה טמאה ופדה בערכך ואמר מר בבעלי מומין שיפדו הכתוב מדבר אבל תמימים לא וזה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שבא לימלך ולחוב בדמיה וכי נאמר לו עמוד וחטא לחללה מזיד בשביל שתזכה לתקן הקרבתה של בהמה זו: <b>אם רוב זכרים עולות.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "וה\"פ דמתני' אם רוב בהמות שנמצאו זכרים כולן עולות ואם רובן נקבות אף זכרים שבהן שלמים: ופריך <b>ואין השלמים באין מן</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הזכרים.</b> נמי וא\"כ אף זכרים ניחוש שמא שלמים הן: <b>ומשני כיצד הוא עושה מוציאן לחולן.</b> ע\"מ שחזרו להיות עולות ואין זה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חטא דהא עכ\"פ מקריבה ע\"ג המזבח ויותר נ\"ל דאף זה מן הקושיא אף לר\"י קשיא כיצד הוא עושה וכו' אלא שמוציאן לחולין א\"כ",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אף לר' הושעיא ל\"ק ומשני דתנאי ב\"ד הוא וכו' ול\"ק לר\"י: <b>כמה דאת אמר תמן.</b> בריש פרקין: <b>תנאי ב\"ד הוא על האובדות</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שיקריבו עולות.</b> הלכך לא חיישינן דלמא שלמים הן: <b>אין זה מזיד.</b> בתמיה וכי אין זה כמחלל מזיד שלמים על עולות: <b>מכיון</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שתנאי ב\"ד הוא.</b> עקרו לשם שלמים מיניה וכאלו לא נתקדש מעולם לשם שלמים ואין זה מחלל במזיד:",
      "gemara_segment_ids": [
        7
      ]
    }
  ],
