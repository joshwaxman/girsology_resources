  "gemara": [
    {
      "width": "655px",
      "right": "0px",
      "text": "אמר קדשו והכא את אמר לא קדשו אמר ליה תמן לכך אין מקדישין לכתחלה לפי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שמצוה להקריב מתרומה חדשה והיאך הוה לה ישנה והכא מאי אית לך למימר האי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ישנה היא לגבי הקדשות אחרים וקינו של גר אינו צריך חדשה ואם הקדיש קדוש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ויניחנה עד שיבנה בית המקדש שמא יבנה הבית כבראשונה ותתרם תרומת הלשכה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מן החדשה בזמנה באחד בניסן והכא מאי אית לך רב המנונא ורב אדא בר אהבה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בשם רב הלכה כרבי שמעון",
      "segment_ids": [
        0
      ]
    }
