  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ומנורה בצפון והא תני השלחן היה נתון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחצי הבית ולפנים משוך מן הכותל שתי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמות ומחצה כלפי הצפון ומנורה כנגדו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדרום מזבח הזהב היה נתון באמצע הבית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חולק את הבית מחציו ולפנים משוך קימעא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלפי חוץ וכולהן היה נתון משליש הבית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולפנים עשר מנורות עשה שלמה שנאמר ויעש",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את מנורת הזהב עשר כמשפטו ויתן בהיכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חמש מימין וחמש משמאל אין תימר חמש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בצפון וחמש בדרום והלא אין המנורה כשירה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא בדרום שנאמר ואת המנורה נוכח השלחן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על ירך המשכן תימנה מה תלמוד לומר חמש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מימין וחמש משמאל אלא חמש מימין מנורתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של משה וחמש משמאלה אף על פי כן לא היה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מבעיר אלא של משה בלבד שנאמר ומנורת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הזהב ונרותיה לבער בערב בערב רבי יוסה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בי רבי יהודה אומר על כולן היה מבעיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנאמר ואת המנורות ונרותיהם לבערם כמשפט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפני הדביר זהב סגור והפרח והנרות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והמלקחים זהב הוא מכלות זהב הן כילו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהבו של שלמה תני רב יהודה בשם אסי היה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלמה נוטל אלף ככרי זהב ומכניסן לכור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומוציאן עד שהוא מעמידן על אחד לקיים מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנאמר ככר זהב טהור עשה אותה וגו׳ תניא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יוסי בי רבי יהודה מעשה במנורת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב שעשה משה במדבר והיתה יתירה דינר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב והכניסוה לכור שמונים פעם ולא חסרה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום ויאות עד דלא יקום על ברריה הוה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסר סגין מן דו קיים על ברריה לא חסר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום <b>הלכה ד <big>מתני׳</big></b> שלשה עשר שופרות היו",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במקדש, וכתוב עליהן: תקלין חדתין,",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותקלין עתיקין, קנין, וגוזלי עולה,",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצים, לבונה, זהב לכפורת, ששה לנדבה.",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תקלין חדתין שבכל שנה ושנה ועתיקין מי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא הביא אשתקד שוקל לשנה הבאה קנין הן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורין וגוזלי עולה הן בני יונה כולן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עולות דברי רבי יהודה וחכמים אומרים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קנין אחד חטאת ואחד עולה גוזלי עולה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כולן עולות האומר הרי עלי עצים לא יפחות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משני גזירין לבונה לא יפחות מקומץ זהב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא יפחות מדינר זהב ששה לנדבה נדבה מה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו עושין בה לוקחים בה עולות הבשר לשם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ועורות לכהנים זה מדרש דרש יהוידע כהן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדול אשם הוא אשום אשם לה׳ זה הכלל כל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהוא בא משום חטאת ומשום אשמה ילקח בהן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עולות הבשר לשם והעורות לכהנים נמצאו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שני כתובין קיימין אשם לה׳ ואשם לכהן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואומר כסף אשם וכסף חטאת לא יובא בית ה׳ לכהנים יהיו <b>גמ׳</b> תניא אמר רבי",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יהודה לא היה שופר של קינין בירושלם מפני התערובות שמא תמות אחת ונמצאו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "text": "דמי חטאות מיתות מעורבות בהן והתניא האשה שאמרה הרי עלי קן מביאה דמי קן ונותנתו בשופר",
      "segment_ids": [
        3
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והוא מכלות הזהב.</b> פסוק הוא בד\"ה וקמפרש מהו מכלות הזהב וקאמר שהן כולו של זהב סגור שהיה לשלמה שהרי עשר מנורות עשה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ולכל אחת היה צריך אלף ככר כדמסיק: <b>לקיים מה שנאמר.</b> במנורת משה ככר זהב טהור וגו': ה\"ג מעשה במנורת המקדש שהיתה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יתירה על מנורה שעשה משה במדבר דינר זהב והכניסוהו לכור פ' פעמים ולא חסר האש ממשקלה: ופריך <b>ויאות.</b> בתמיה וכי כך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא והלא עינינו רואות כשנותנין זהב בכור באש הוא נחסר: <b>ומשני עד דלא יקום וכו'.</b> כשעדיין לא קם הזהב על ברירותיה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא נצרף כל צרכו נחסר ממנו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל בשכבר נצרף כל צרכו לא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נחסר ממנו כלום אפי' מכניסין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותה לאש כמה פעמים: מתני'",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תקלין חדתין.</b> שבו נותנין שקלי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנה זו וכשמגיע זמן התרומה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגזבר מוציא כל שקלים שבשופר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונותנן ללשכה כדי שיתרמו מהם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והשני כתוב עליו תקלין עתיקין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומי שלא הביא שקלו בשנה זו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מביא בשנה שאח\"כ ונותנו לשופר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והגזבר נוטלם ונותנם בשירי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלשכה והג' כתוב עליו קינין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והן תורין גדולים והד' גוזלי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עולה והן בני יונה הקטנים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכולן עולות אבל לקיני חובה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא היה שופר כדמפרש בגמ':",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עצים.</b> המתנדב עצים למערכה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותן דמיהן לתוכו: <b>לבונה.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המתנדב לבונה נותן דמיו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתוכו: <b>זהב.</b> המתנדב זהב נותנו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שם או דמי שויו והוא לכפורת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כלומר לכלי שרת שהמזרקות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נקראים כפורי זהב בעזרא ובד\"ה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפי שהכהן מקנח בהן אצבעו בין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הזאה להזאה שהשיריים שבאצבע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסולים: <b>ששה.</b> שופרות הנותרות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הן לנדבה ובגמרא מפרש: <b>האומר</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הרי עלי עצים.</b> סתם: <b>לא יפחות</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>משני גזירין.</b> כאותן שמסדרין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על המערכה ושיעורן מפורש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בגמ': <b>לא יפחות מן קומץ.</b> שזהו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיעור הלבונה הבאה עם המנחה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובגמרא מפרש מנ\"ל ודוקא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המתנדב סתם אבל אם רצה להביא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אפי' קורט של לבונה מביא:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>זהב.</b> המתנדב זהב סתם לא יפחות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדינר זהב: <b>אשם הוא אשום אשם</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לה'.</b> וקשיא רישא לסיפא דאשם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא משמע בהווייתו יהא כהלכתו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא נאכל לכהנים ואשם לה'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משמע שכולו לה' ודרש יהוידע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכהן כל שהוא מותר חטאת ואשם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ילקח באותו המותר עולות נמצא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ב' הכתובים קיימים אשם לה'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבשר ואשם לכהנים העורות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיכן מצינו מדרש זה ביהוידע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כסף אשם וכסף חטאת לא יובא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בית ה' לכהנים יהיו וא\"א לומר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכסף שקדש לשם חטאת ולשם אשם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהנו בו הכהנים אלא ה\"ק יעשו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנו דבר שיהנו בו הכהנים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו העולות שהעורות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכהנים:",
      "gemara_segment_ids": [
        2
      ]
    }
  ],
