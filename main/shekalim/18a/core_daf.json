      ],
      "printed_body_y": [
        97.0,
        817.4
      ],
      "note_he": "תוספת שלנו. פני משה אינו נדפס בדף זה כלל — במלבן הזה הדפיסו תקלין חדתין, שאינו מצוי במהדורה דיגיטלית. הטקסט מספריא (פיוטרקוב תרנ״ח–תר״ס), ואינו חלק מצורת הדף הנדפסת.",
      "note_en": "OUR ADDITION. Penei Moshe is not printed on this leaf at all — this rectangle is where the press set Tiklin Chadtin, which is in no digital edition. The text is Sefaria's (Piotrków, 1898-1900) and is not part of the printed page.",
      "printed_work_he": "תקלין חדתין",
      "printed_work_en": "Tiklin Chadtin",
      "source_ref": "Penei Moshe on Jerusalem Talmud Shekalim",
      "lines": [
        {
          "width": "216px",
          "text": "<b>עשר מנורות עשה שלמה</b>"
        },
        {
          "width": "216px",
          "text": "<b>וכו'.</b> ופלוגתא זו גריס"
        },
        {
          "width": "216px",
          "text": "נמי בתוספתא שם: <b>הוא</b>"
        },
        {
          "width": "216px",
          "text": "<b>מכלות זהב.</b> ודריש הן כילו"
        },
        {
          "width": "216px",
          "text": "זהבו של שלמה כרב יהודה"
        },
        {
          "width": "216px",
          "text": "דלקמיה: <b>ולא חסרה כלום.</b>"
        },
        {
          "width": "216px",
          "text": "והיאך אמרת שהיה מכניסן"
        },
        {
          "width": "216px",
          "text": "לכור (עד) ומוציאן עד"
        },
        {
          "width": "216px",
          "text": "שהוא מעמידן על אחד:"
        },
        {
          "width": "216px",
          "text": "<b>ויאות.</b> שפיר היא ול\"ק דעד"
        },
        {
          "width": "216px",
          "text": "דלא יקום על ברריה שעדיין"
        },
        {
          "width": "216px",
          "text": "לא נזדכך הרבה להיות עומד"
        },
        {
          "width": "216px",
          "text": "על זהב ברור וטהור אז הוה"
        },
        {
          "width": "216px",
          "text": "חסר סגיון כשמכניסו לכור"
        },
        {
          "width": "216px",
          "text": "ומוציאו אבל של משה שהיה"
        },
        {
          "width": "216px",
          "text": "כבר קם על ברריה לא חסר"
        },
        {
          "width": "216px",
          "text": "כלום והכי אמר נמי לעיל"
        },
        {
          "width": "216px",
          "text": "ביומא פ\"ד בהלכה ד':"
        },
        {
          "width": "216px",
          "text": "מתני' <b>שלשה עשר שופרות</b>"
        },
        {
          "width": "216px",
          "text": "<b>וכו' תקלין חדתין שבכל</b>"
        },
        {
          "width": "216px",
          "text": "<b>שנה ושנה.</b> שם היו נותנין"
        },
        {
          "width": "216px",
          "text": "שקלי שנה זו ומשם מוציאין"
        },
        {
          "width": "216px",
          "text": "הגזברים לקופות שהן"
        },
        {
          "width": "216px",
          "text": "נקראין תרומת הלשכה"
        },
        {
          "width": "216px",
          "text": "כדפרישית לעיל ריש פ\"ד:"
        },
        {
          "width": "216px",
          "text": "<b>והב' כתוב עליו תקלין</b>"
        },
        {
          "width": "216px",
          "text": "<b>עתיקין.</b> זה מי שלא שקל"
        },
        {
          "width": "216px",
          "text": "אשתקד בשנה שעברה מביא"
        },
        {
          "width": "216px",
          "text": "שקל לשנה הבאה ונותנו לשם"
        },
        {
          "width": "216px",
          "text": "ומוציא אותן הגזבר ונותנן"
        },
        {
          "width": "216px",
          "text": "לשירי הלשכה. והג' היה"
        },
        {
          "width": "216px",
          "text": "כתוב עליו קינין והן"
        },
        {
          "width": "216px",
          "text": "תורים גדולים. והד' שכתוב"
        },
        {
          "width": "216px",
          "text": "עליו גוזלי עולה ס\"ל לר'"
        },
        {
          "width": "216px",
          "text": "יהודה שהן בני יונה קטנים"
        },
        {
          "width": "216px",
          "text": "וכולן היו עולות אבל"
        },
        {
          "width": "216px",
          "text": "החטאות של קיני חובה לא"
        },
        {
          "width": "216px",
          "text": "היו נותנין המעות להשופר"
        },
        {
          "width": "216px",
          "text": "אלא נותנין המעות או"
        },
        {
          "width": "216px",
          "text": "העופות ליד הכהן וטעמא"
        },
        {
          "width": "216px",
          "text": "מפרש בגמרא מפני התערובות"
        },
        {
          "width": "216px",
          "text": "דחייש שמא ימות אחד מבעלי"
        },
        {
          "width": "216px",
          "text": "קינין ונמצא דמי חטאת"
        },
        {
          "width": "216px",
          "text": "שמתו בעליה מעורבת בהן"
        },
        {
          "width": "216px",
          "text": "ולא מצי למיקרב דלמיתה"
        },
        {
          "width": "216px",
          "text": "אזלא אבל חכמים לא חיישי"
        },
        {
          "width": "216px",
          "text": "להכי אלא אותו השופר"
        },
        {
          "width": "216px",
          "text": "שכתוב עליו קינין היו"
        },
        {
          "width": "216px",
          "text": "נותנין לתוכו דמי כל קיני"
        },
        {
          "width": "216px",
          "text": "חובה שהן אחד חטאת ואחד"
        },
        {
          "width": "216px",
          "text": "עולה ובין מן התורים ובין"
        },
        {
          "width": "216px",
          "text": "מן בני היונה והד' שכתוב"
        },
        {
          "width": "216px",
          "text": "עליו גוזלי עולה הן כולן"
        },
        {
          "width": "216px",
          "text": "עולות שהמתנדב עולת העוף"
        },
        {
          "width": "216px",
          "text": "נותן הדמים לתוכו ונדבה"
        },
        {
          "width": "216px",
          "text": "הכל קריבה עולה והלכה"
        },
        {
          "width": "216px",
          "text": "כחכמים. והה' כתוב עליו"
        },
        {
          "width": "216px",
          "text": "עצים מי שהתנדב עצים"
        },
        {
          "width": "216px",
          "text": "למערכה נותן דמיה לתוכו."
        },
        {
          "width": "216px",
          "text": "והו' מי שמתנדב ללבונה."
        },
        {
          "width": "216px",
          "text": "והז' מי שמתנדב זהב"
        },
        {
          "width": "216px",
          "text": "לכפורת. ועוד ששה לנדבה."
        },
        {
          "width": "216px",
          "text": "ומפרש בתוספתא פ\"ג ששה"
        },
        {
          "width": "216px",
          "text": "לנדבה ו' כנגד מותר חטאות"
        },
        {
          "width": "216px",
          "text": "ואשמות ומותר קיני זבים"
        },
        {
          "width": "216px",
          "text": "וזבות ויולדות ומותר קרבן"
        },
        {
          "width": "216px",
          "text": "נזיר וקרבן מצורע והאומר"
        },
        {
          "width": "216px",
          "text": "מנה זו לנדבה סלע זו"
        },
        {
          "width": "216px",
          "text": "לנדבה מביא ונותן לשופר"
        },
        {
          "width": "216px",
          "text": "של נדבה ולוקחין בהן"
        },
        {
          "width": "216px",
          "text": "עולות הבשר לשם והעורות"
        },
        {
          "width": "216px",
          "text": "לכהנים. וכלומר שאלו"
        },
        {
          "width": "216px",
          "text": "השמות שכתוב עליהן על הא'"
        },
        {
          "width": "216px",
          "text": "מותר חטאת ועל הב' מותר"
        },
        {
          "width": "216px",
          "text": "אשם ועל הג' מותר קיני"
        },
        {
          "width": "216px",
          "text": "חובה ועל הד' מותר קרבנית"
        },
        {
          "width": "216px",
          "text": "נזיר ועל הה' מותר קרבן"
        },
        {
          "width": "216px",
          "text": "אשם מצורע ועל הו' מותר"
        },
        {
          "width": "216px",
          "text": "נדבה סתם וזהו מי שהתנדב"
        },
        {
          "width": "216px",
          "text": "מעות לעולה וכולן אלו"
        },
        {
          "width": "216px",
          "text": "המותרות ילקחו בהן עולות"
        },
        {
          "width": "216px",
          "text": "הבשר לשם ועורות לכהנים"
        },
        {
          "width": "216px",
          "text": "וכדמפרש במתני' דלקמן מה"
        },
        {
          "width": "216px",
          "text": "היו עושין בה: מתני'"
        },
        {
          "width": "216px",
          "text": "<b>האומר הרי עלי עצים.</b>"
        },
        {
          "width": "216px",
          "text": "המתנדב עצים: <b>לא יפחות</b>"
        },
        {
          "width": "216px",
          "text": "<b>משני גזירין.</b> כאותן"
        },
        {
          "width": "216px",
          "text": "שמוסיפין על המערכה כדתנן"
        },
        {
          "width": "216px",
          "text": "ביומא פ\"ב ובתמיד וקאמר"
        },
        {
          "width": "216px",
          "text": "בגמרא דאם אמר הרי עלי עץ"
        },
        {
          "width": "216px",
          "text": "מביא גיזר אחד: <b>לבונה לא</b>"
        },
        {
          "width": "216px",
          "text": "<b>יפחות מקומץ.</b> כדמייתי"
        },
        {
          "width": "216px",
          "text": "בגמרא דרשא דת\"כ דיליף"
        },
        {
          "width": "216px",
          "text": "ג\"ש אזכרה אזכרה: <b>זהב.</b> אם"
        },
        {
          "width": "216px",
          "text": "אמר מטבע זהב עלי לא"
        },
        {
          "width": "216px",
          "text": "יפחות מדינר זהב ואם אמר"
        },
        {
          "width": "216px",
          "text": "סתם זהב עלי מביא אפי'"
        },
        {
          "width": "216px",
          "text": "חתיכה קטנה של זהב: <b>ששה</b>"
        },
        {
          "width": "216px",
          "text": "<b>לנדבה וכו' מה היו עושין</b>"
        },
        {
          "width": "216px",
          "text": "<b>בה.</b> כדפרישית במתני'"
        },
        {
          "width": "216px",
          "text": "דלעיל דששה היו שכתוב"
        },
        {
          "width": "216px",
          "text": "עליהן זה למותר חטאת וכו'"
        },
        {
          "width": "216px",
          "text": "וכולן ילקח בהן עולות"
        },
        {
          "width": "216px",
          "text": "וכו': <b>זה מדרש דריש יהודע</b>"
        },
        {
          "width": "216px",
          "text": "<b>כ\"ג.</b> כתיב אשם הוא דמשמע"
        },
        {
          "width": "216px",
          "text": "בהוויתו יהא כדין אשם"
        },
        {
          "width": "216px",
          "text": "שדמו נזרק והאימורין"
        },
        {
          "width": "216px",
          "text": "להקטרה והבשר לכהנים"
        },
        {
          "width": "216px",
          "text": "וכתיב אשם אשם לה' דמשמע"
        },
        {
          "width": "216px",
          "text": "כולו לגבוה הא כיצד אלא"
        },
        {
          "width": "216px",
          "text": "ללמד לזה הכלל כל שהוא בא"
        },
        {
          "width": "216px",
          "text": "משום חטא וכו' כלומר"
        },
        {
          "width": "216px",
          "text": "שהפריש מעות לחטאתו או"
        },
        {
          "width": "216px",
          "text": "לאשמו וניתותרו מהמעות"
        },
        {
          "width": "216px",
          "text": "ילקח באותן המותרות עולות"
        },
        {
          "width": "216px",
          "text": "הבשר לשם והעורות לכהנים"
        },
        {
          "width": "216px",
          "text": "ונמצאו שני כתובים קיימים"
        },
        {
          "width": "216px",
          "text": "אשם לה' ואשם לכהנים:"
        },
        {
          "width": "216px",
          "text": "<b>ואומר.</b> כלומר והיכן מצינו"
        },
        {
          "width": "216px",
          "text": "שיהוידע כ\"ג דרש זה דכתיב"
        },
        {
          "width": "216px",
          "text": "כסף אשם וגו' לכהנים יהיו"
        },
        {
          "width": "216px",
          "text": "וכי היאך אפשר דמה שהוקדש"
        },
        {
          "width": "216px",
          "text": "לקרבן חטאת ולאשם יהיה"
        },
        {
          "width": "216px",
          "text": "לכהנים אלא דה\"ק המותר של"
        },
        {
          "width": "216px",
          "text": "כסף חטאת ואשם יעשו בו"
        },
        {
          "width": "216px",
          "text": "שיהיה הנאה ג\"כ להכהנים"
        },
        {
          "width": "216px",
          "text": "וזהו עורות העולה שהן"
        },
        {
          "width": "216px",
          "text": "לכהנים:"
        }
      ],
