        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברירותיה שלא נצרף כל צרכו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נחסר ממנו אבל בשכבר נצרף כל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צרכו לא נחסר ממנו כלום אפי'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכניסין אותה לאש כמה פעמים:",
