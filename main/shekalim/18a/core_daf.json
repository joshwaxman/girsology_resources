  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ומנורה בצפון והא תני השלחן היה נתון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחצי הבית ולפנים משוך מן הכותל שתי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמות ומחצה כלפי הצפון ומנורה כנגדו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדרום מזבח הזהב היה נתון באמצע הבית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חולק את הבית מחציו ולפנים משוך קימעא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלפי חוץ וכולהן היה נתון משליש הבית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולפנים עשר מנורות עשה שלמה שנאמר ויעש",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את מנורת הזהב עשר כמשפטו ויתן בהיכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חמש מימין וחמש משמאל אין תימר חמש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בצפון וחמש בדרום והלא אין המנורה כשירה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא בדרום שנאמר ואת המנורה נוכח השלחן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על ירך המשכן תימנה מה תלמוד לומר חמש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מימין וחמש משמאל אלא חמש מימין מנורתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של משה וחמש משמאלה אף על פי כן לא היה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מבעיר אלא של משה בלבד שנאמר ומנורת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הזהב ונרותיה לבער בערב בערב רבי יוסה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בי רבי יהודה אומר על כולן היה מבעיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנאמר ואת המנורות ונרותיהם לבערם כמשפט",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפני הדביר זהב סגור והפרח והנרות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והמלקחים זהב הוא מכלות זהב הן כילו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהבו של שלמה תני רב יהודה בשם אסי היה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלמה נוטל אלף ככרי זהב ומכניסן לכור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומוציאן עד שהוא מעמידן על אחד לקיים מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנאמר ככר זהב טהור עשה אותה וגו׳ תניא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יוסי בי רבי יהודה מעשה במנורת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב שעשה משה במדבר והיתה יתירה דינר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זהב והכניסוה לכור שמונים פעם ולא חסרה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום ויאות עד דלא יקום על ברריה הוה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסר סגין מן דו קיים על ברריה לא חסר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום <b>הלכה ד <big>מתני׳</big></b> שלשה עשר שופרות היו",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במקדש, וכתוב עליהן: תקלין חדתין,",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותקלין עתיקין, קנין, וגוזלי עולה,",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "עצים, לבונה, זהב לכפורת, ששה לנדבה. תקלין חדתין שבכל שנה ושנה ועתיקין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מי שלא הביא אשתקד שוקל לשנה הבאה קנין הן תורין וגוזלי עולה הן בני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "יונה כולן עולות דברי רבי יהודה וחכמים אומרים קנין אחד חטאת ואחד עולה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "גוזלי עולה כולן עולות האומר הרי עלי עצים לא יפחות משני גזירין לבונה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לא יפחות מקומץ זהב לא יפחות מדינר זהב ששה לנדבה נדבה מה היו עושין בה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לוקחים בה עולות הבשר לשם ועורות לכהנים זה מדרש דרש יהוידע כהן גדול",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אשם הוא אשום אשם לה׳ זה הכלל כל שהוא בא משום חטאת ומשום אשמה ילקח בהן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "עולות הבשר לשם והעורות לכהנים נמצאו שני כתובין קיימין אשם לה׳ ואשם",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לכהן ואומר כסף אשם וכסף חטאת לא יובא בית ה׳ לכהנים יהיו <b>גמ׳</b> תניא אמר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "רבי יהודה לא היה שופר של קינין בירושלם מפני התערובות שמא תמות אחת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ונמצאו דמי חטאות מיתות מעורבות בהן והתניא האשה שאמרה הרי עלי קן מביאה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דמי קן ונותנתו בשופר",
      "segment_ids": [
        3
      ]
    }
  ],
