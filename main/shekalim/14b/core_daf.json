  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "מוסרין את המגילה הזאת אלו לאלו ועכשיו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאינן בית אבא נאמנים הילך את המגילה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והזהר בה וכשבאתי והרציתי הדברים לפני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי עקיבא זלגו עיניו דמעות ואמר מעתה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין אנו צריכין להזכירן לגנאי אלעזר על",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפרוכת שהיה ממונה על אורגי פרוכת פנחס",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המלביש שהיה מלביש בגדי כהונה גדולה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעשה בכהן אחד שהלביש לאיסטרטיות אחד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונתן לו שמונה זהובים ואית דאמרין תרי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשר יהב ליה <b>הלכה ב <big>מתני׳</big></b> אין פוחתין",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משבעה אמרכולין ושלשה גזברין. ואין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושין שררה על הצבור פחות משנים. חוץ",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מבן אחיה שעל חולי מעיים, ואלעזר שעל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפרוכת, שאותן קיבלו רוב הצבור עליהן.",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>גמ׳</b> אין פוחתין משלשה גזברין ומשבעה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרכולין תני משני כתליקין הדא הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכתיב ויחיאל ועזזיהו ונחת גזברין ועשאל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וירימות ויזבד ואליאל ויסמכיהו ומחת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובניהו אמרכולין פקידים מיד כונניהו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושמעי אחיו קתיליקין במפקד יחזקיהו המלך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ועזריהו נגיד בית אלהים המלך וכהן גדול",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשהוא חותם הגזבר חותם ונותנו לאמרכול",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרכל חותם ונותנו לקתליקון קתליקון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חותם ונותנו לכהן גדול כהן גדול חותם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונותנו למלך וכשהוא מתיר המלך רואה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חותמו ומתיר כהן גדול רואה חותמו ומתיר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קתליקין רואה חותמו ומתיר אמרכל רואה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חותמו ומתיר גזבר רואה חותמו ומתיר אין",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושין שררה על הצבור בממון פחות משנים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב נחמן בשם רבי מנא על שם והם יקחו את",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הזהב ואת התכלת ואת הארגמן אמר רבי חמא",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בי רבי חנינא מפסולת של לוחות העשיר משה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדא הוא דכתיב פסל לך שני לוחות אבנים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פסל לך שתהא הפסולת שלך אמר רבי חנין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחצב של אבנים טובות ומרגליות ברא לו",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקדוש ברוך הוא מתוך אהלו וממנו העשיר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משה כתיב והביטו אחרי משה עד בואו",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האוהלה תרין אמוראין חד אמר לגנאי וחד",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר לשבח מאן דאמר לגנאי חמון שקין חמון",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרעין חמון קופד אכיל מן דיהודאי ושתי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן דיהודאי כל מדליה מן דיהודאי ומאן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמר לשבח מחמי צדיקיא ומזכי טוביא דזכת",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למיחמי יתיה <b>הלכה ג <big>מתני׳</big></b> ארבעה חותמות",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו במקדש וכתוב עליהן: עגל, זכר, גדי,",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחוטא. בן עזאי אומר: חמשה היו, וארמית",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתוב עליהן: עגל, דכר, גדי, חוטא דל,",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וחוטא עשיר. עגל משמש עם נסכי בקר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גדולים וקטנים זכרים ונקבות גדי משמש עם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נסכי הצאן גדולים וקטנים זכרים ונקבות",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוץ משל אילים איל משמש עם נסכי אילים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בלבד חוטא משמש עם נסכי שלש בהמות של",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מצורע מי שהוא מבקש נסכים הולך לו אצל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוחנן שהוא ממונה על החותמות ונותן לו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעות ומקבל ממנו חותם בא לו אצל אחייה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהוא ממונה על הנסכים ונותן לו חותם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומקבל ממנו נסכים לערב באין זה אצל זה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואחייה מוציא את החותמות ומקבל כנגדן",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעות אם פחתו פחתו לו וישלם יוחנן מביתו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ואם הותירו הותירו להקדש שיד הקדש על העליונה מי שאבד חותמו ממתינין לו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עד הערב ואם מצאו לו כדי חותמו נותנין לו ואם לאו לא היו נותנין לו ושם",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היום כתוב עליהן מפני הרמאין <b>גמ׳</b> וכבן עזאי חוטא דל למה היה מביא לוגו",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עמו ברם כרבנן מביא גדי נסכי רחל מה מן מה דתנינן גדי משמש נסכי צאן",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "גדולים וקטנים זכרים ונקבות הדא אמרי נסכי רחל כנסכי גדי דכתיב ככה יעשה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לשור האחד או לאיל האחד או לשה בכבשים או בעזים לשור האחד למה נאמר מגיד",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שלא חלק בין נסכי עגל לנסכי שור שהיה בדין בן הצאן טעון נסכים ובן הבקר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "טעון נסכים אם מצאנו שחלק בין נסכי כבש לנסכי איל",
      "segment_ids": [
        9
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שהיה מלביש בגדי כ\"ג.</b> שיהיו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נאין ומהודרין: <b>לאיסטרטיאות.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שר משרי החיילות: מתני'",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>גזברים.</b> הם שממון הקדש תחת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ידם והם פודין ערכין וחרמין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכל מלאכת ההקדש נעשה על ידם:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אמרכלין.</b> למעלה מן הגזברים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוא נוטריקון אמר על כלו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ובגמ' יליף לה הממונים אלו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקרא: גמ' <b>כתילקין.</b> והיא שררה",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למעלה מן האמרכל: <b>גזברין.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג דבקרא לא כתיב גזברין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסברא ידעינן שהיו גזברין ג'",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהא פסקו שכר וצדקות ופדויית",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ערכין וחרמי' צריכין ג'",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהיינו דין וכיון דקרא ממטה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למעלה קחשיב ש\"מ שהראשונים מן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגזברין שהן למטה מהאמרכלין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והא דקחשיב בקרא כה\"ג לסוף",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג דהמלך גדול ממנו היינו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדי לסיים נגיד בית האלהים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיהיה השם בתר כולם שהוא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למעלה על כל: <b>כשהוא חותם.</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלשכה שהמעות בתוכו דהאי קרא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשמירת האוצרות איירי וילפינן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיניה דלכך כתיבי כולהו ללמד",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכולם חותמין האוצרות",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכדמסיק: <b>והם יקחו את הזהב.</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מיעוט רבים שנים: <b>שתהא הפסולת</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלך.</b> והלוחות של סנפירינון",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היו: <b>מחצב.</b> מקום שחוצבין",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנו: <b>חמון שקין וכו'.</b> ראו",
      "gemara_segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השוקים ראו הכרעיים ראו בשרו",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכל זה ממה שהוא אוכל ושותה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן היהודים וכל רכושו מן",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היהודים: <b>מיחמי צדיקא וכו'.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדי לזכות בראיית הצדיק הביטו",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחריו דזכות גדול הוא שזכה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לראותו: מתני' <b>ד' חותמו' היו</b>",
      "gemara_segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במקדש.</b> ג' לג' נסכים חלוקין",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של בהמות חותם ראשון לנסכי",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקר והן ג' עשרונים סולת בלול",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחצי הין שמן ויין לנסך חצי",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההין וחותמו עגל והב' זכר",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לנסכי איל שתרגום איל דכרא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונסכיו שתי עשרונים סולת בלול",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשמן שלישית ההין ויין לנסך",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלישית ההין והג' גדי לנסכי",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כבש בן שנתו והן עשרון סולת",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלול ברביעית ההין שמן ויין",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לנסך רביעית ההין והד' חוטא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והם נסכיו של מצורע עשיר",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמביא ג' בהמות וצריך עשרה",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לוגין שמן תשעה לשלשה כבשים",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואחד למתן תנוך ובהונות וקרי",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה חוטא משום דעל שבעה",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עבירות נגעים באין: <b>ה' היו.</b>",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ב' חותמות היו למצורע: <b>חוטא</b>",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דל וחוטא עשיר.</b> לפי שמצורע",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עני אינו מביא אלא בהמה אחת",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם לא היה למצורע אלא חותם",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א' היו נותנים למצורע עני עשר",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לוגין ות\"ק סבר למצורע עני",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותנין חותם גדי ולוג רביעית",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה מביא מביתו: <b>וארמית כתוב</b>",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עליהן.</b> שרוב דבורם היה בלשון",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ארמי: <b>זכרים ונקבות.</b> בין",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לנסכי עולות שאינן באות אלא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זכרים בין נסכי שלמים שבאין",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זכרים ונקבות ועולה ושלמים",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעונין נסכים דכתיב עולה או",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זבח: <b>נותן לו מעות.</b> כפי",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנסכים שהוא צריך: <b>בא לו אצל</b>",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אחיה.</b> שהיה ממונה לקנות יינות",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושמנים וסלתות שלא יהא כל",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מביא קרבן צריך לחזור אחר",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נסכים העשויין על טהרות הקדש: <b>ואם הותירו הותירו להקדש.</b> ולא אמרינן שמא מעותיו של יוחנן הם שנתערבו במעות של נסכים:",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ממתינים לו עד הערב.</b> שיזדווגו יחד יוחנן ואחיה אם נמצאו מעות יתירים ביד יוחנן כנגד החותם שאמר זה שנאבד ממנו",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נותנים לו: <b>ושם היום כתוב.</b> על החותם יום פלוני בשבת: <b>מפני הרמאין.</b> שמא מצא חותם שנפל מחבירו או מאחיה או מיוחנן ובא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עכשיו ליקח וביום שמוצאו אינו רשאי להוציאו שהאובד מחזר אחריו ועוד יש לחוש שמא לקח חותם בשער הזול והצניעו עד שער",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "היוקר:",
      "gemara_segment_ids": [
        8
      ]
    }
  ],
