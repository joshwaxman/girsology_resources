  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ואוכלת בקדשים ואינה חוששת שמא נתעצל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהן ואין הכהן חושש שמא דמי חטאות מיתות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעורבות בהן כי קאמרינן בחטאות שמתו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעליהן ודאי ואי אמרינן נברור ארבעה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זוזי ונישדי בנהרא ואידך לישתרו הא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרינן בעלמא רבי יהודה לית ליה ברירה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסה בי רבי בון אמר רבי בא בר ממל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעי דאמר הרי עלי עץ מביא גיזר אחד אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי לעזר מתניתא אמרה כן שזה קרבן בפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצמו וזה קרבן בפני עצמו כהאי דתנינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמן השנים בידם שני גזרי עצים וקרבן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרבות את העצים רבי יהושע בן לוי אמר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עוביין אמה באמה שוחקת וארכן באמה גדומה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חוני בשם רבי אמי כמין טורטני אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמואל בר רב יצחק לפי שלא היה מקום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המערכה אלא אמה על אמה לפיכך לא היה בו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא אמה גדומה ותני כן אמה היסוד אמה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סובב אמה כרכוב ואמה קרנות ואמה מערכה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבונה לא יפחות מקומץ נאמר כאן אזכרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונאמר להלן אזכרה מה אזכרה האמור להלן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלא קומץ אף אזכרה האמור כאן מלא קומץ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אי מה אזכרה האמורה להלן שני קומצין אף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אזכרה האמורה כאן שני קומצין אמר רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אילא כלום למדו לקומץ אלא ממנחת חוטא מה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להלן קומץ החסר פסול אף כאן קומץ החסר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פסול אמר רבי יוסה מילתא דרבי אילא אמרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המתנדב לבונה מביאה בקומצו של כהן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(גדול) רבי חזקיה בשם רבי ירמיה ואפילו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקומץ הבעלים זהב לא יפחות כו׳ אמר רבי",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר והוא שהזכיר צורה אבל אם לא הזכיר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורה מביא אפילו צינורה ששה לנדבה חזקיה",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר כנגד ששה בתי אבות בר פדיה אמר כנגד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שש בהמות פר ועגל ושעיר איל גדי וטלה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל אמר כנגד ששה קרבנות (קני זבים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וקני זבות קני יולדות) חטאות ואשמות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המנחות ועשירית האיפה אמר רבי יוחנן על",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידי שהנדבה מרובה ריבו לה שופרות הרבה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתיב וככלותם הביאו לפני המלך ויהוידע",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגו׳ רבי שמעון בר נחמן בשם רבי יונתן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר שתי נדבות עשה",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' <b>לא היה שופר של קיני.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חובה כגון זב וזבה ויולדת",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיתנו לתוכו מעות כשם שהיו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שופרות לקן נדבה כדתנן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתני': <b>מפני התערובות.</b> שמא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמות אחת מאותן שנתנו מעות",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשופר וה\"ל מעות חטאת שמתו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעליה מעורבין עם הכשרות והכל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסולין והולכין לים המלח: <b>ה\"ג</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והתני האשה שיש עליה לידה או</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>זיבה מביאה דמי קן וכו'.</b> כ\"ה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברמב\"ם פ\"ק מה' מחוסרי כפרה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל באומרת הרי עלי קן שניהם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עולות והרא\"פ לא הרגיש בזה:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ונותנתו בשופר.</b> שכתוב עליו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קינין ודמי הקינין קצובין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היו: <b>ואוכלת בקדשים.</b> לערב:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואינה חוששת שמא נתעצל בהן.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דחזקה על ב\"ד של כהנים שאין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עומדים משם עד שיכלו כל מעות",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של אותו שופר כדי שלא יאכלו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחוסרי כפרה בקדשי': <b>ואין</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הכהן חושש וכו'.</b> ולא פליג ר\"י",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משמע דכ\"ע מודים דלא חיישינן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמא מתה אחת מהן: <b>ומשני כי</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>קאמרינן.</b> לר\"י דחייש לתערובת",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו שיוודע לן שבוודאי מת",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד מהנותנין לתוך השופר נמצא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהן מעורבות: ופריך <b>ואי</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אמרינן כו'.</b> כלומר אמאי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונברור ד' זוזי דמי החטאת",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונאמר דאלו הן דמי החטאת שמתו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעליהן והשאר יקרבו ודקאמר ד'",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זוזי היינו זוזי פשיטי שח'",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהן הוא דינר צורי והן דמי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרידה אחת דתנן בו ביום עמדו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קינין ברבעתים פי' פרידה אחת",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והרובע הוא חצי דינר צורי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא ד' זוזי מדינה א\"נ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אורחיה דש\"ס למתני ד': <b>לית</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ליה ברירה.</b> לא סמכינן אברירה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למשרי איסורא: <b>בעי אם אמר הרי</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עלי עץ.</b> ולא אמר עצים שלא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נתכוין אלא לעץ אחד מהו שיביא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א' או שנים: <b>מתניתא אמרה כן.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאף גיזר אחד הוה קרבן ונדרו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נדר: <b>כהאי דתנינן תמן.</b> ביומא פ\"ב: <b>ושנים שני כהנים בידם שני גיזרי עצים.</b> ביד כל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "א' גיזר אחד ש\"מ שכל א' קרבן בפני עצמו: <b>ה\"ג קרבן לרבות את העצים.</b> וה\"פ כתיב כי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תקריב קרבן מנחה ומצינו לעצים שנקראו קרבן דכתיב והגורלות הפלנו על קרבן העצים:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>באמה שוחקת.</b> פי' באמה גדולה: <b>גדומה.</b> פחותה: <b>כמין טורטני.</b> קנה מאזנים ולי נראה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דאעוביו קאי שלא היתה עוביו אלא כטורטני והוא כמחק גודש סאה השנוי בבבלי: <b>אלא אמה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>על אמה.</b> ואמתא באמתא היכי יתיב וכתיב על העצים אשר על המזבח שלא יהו העצים יוצאין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מן המזבח לפיכך לא היו העצים אלא אמה גדומה: <b>ותני כן.</b> ותניא נמי הכי שמקום המערכה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לא היה אלא אמה על אמה: <b>נאמר כאן.</b> גבי לבונה דלחם הפנים אזכרה דכתיב ונתת על",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המערכה לבונה זכה והיתה ללחם לאזכרה: <b>ונאמר להלן.</b> גבי מנחה וקמץ משם מלא קומצו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מסלתה ומשמנה על כל לבונתה והקטיר הכהן את אזכרתה: <b>אף כאן קומץ.</b> לכל מערכה וכי",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היכי דסתם מנחה מלא קומץ אף סתם נדבת לבונה מלא קומץ: <b>ה\"ג אי מה להלן שני קומצין.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וה\"פ אי מה להלן בלחם הפנים ב' קומצין כדאמרינן לעיל על כל מערכה קומץ אף סתם",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נדבת לבונה ב' קומצין: <b>כלום למדו לקומץ.</b> לבונה אלא מלחם הפנים והתם בעינן שיהא כל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קומץ בפני עצמו מלא ואם חסר ממנה פסול ש\"מ אע\"ג דבהצטרפות יש שני קומצין כגון",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהשני יתר אפ\"ה פסול כדילפי' ממנחת חוטא ש\"מ דכל קומץ קרבן בפני עצמו: <b>מילתא דרבי</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אילא אמרה.</b> מדברי ר' אילא שמעינן: <b>ה\"ג המתנדב לבונה מביאה בקומצו של כה\"ג.</b> וה\"פ",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מדיליף לה מלחם הפנים ובפייס נעשה ולא ידעינן הי כהן דמתרמי וצריך שיהיה הרבה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיקמוץ ממנו גדול שבכהנים: <b>ואפי' בקומץ הבעלים.</b> ממנחה ילפינן ויכול ליתן אותם לכל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כהן שירצה שבאותו משמר: <b>והוא שהזכיר צורה.</b> דאמר מטבע: <b>צינורא.</b> שיעורו מזלג קטן:",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כנגד ששה בתי אבות.</b> הכהנים שתקנו להם חכמים שיהא כל משמר חלוק לששה בתי אבות כנגד",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ששת ימי השבוע שיעבוד כל אחד ביומו ובשבת כולן שוין שיהא שלום ביניהון שעורות של",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהמות הניקחות מן השופרות היו לכהנים שמקריבין העולות וכל זמן שאין המזבח בטל לא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היו לוקחין מן השופרות ואם לא היה להם אלא שופר אחד אתי לאנצויי דשמא באותו יום",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "של בית אב הראשון או השני יביאו נדרים ונדבות הרבה ולא יטול הבית אב מן השופר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כלום ובשאר ימות השבוע לא יביאו נדרים ונדבות הרבה נמצא אותן בתי אבות מקריבין מן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "השופר שלא יהא המזבח בטל והוו עורות שלהם ומנצו הנך קמאי בהדי הנך ואמרי יש לכם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עורות ואנו אין לנו כלום ואי משום הנך עולות שהביאו יחידים במשמרות שלנו מזלינו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "גרם א\"נ פעמים שמקריבין שלמים והעורות לבעלי' הלכך תקינו ששה שופרות שלא יטול זה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משופרו של זה וכשהמעות באות נותנין אותן לששה שופרות: <b>כנגד פר וכו'.</b> שהמתנדב פר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ועולה מביא ונותן לשופר שכתוב עליו פר מנה כדאמרי' יביא במנה והמתנדב עגל מביא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חמשה סלעים ונותן לשופר שכתוב עליו עגל וכן כולם והכהנים מקריבין מכל שופר קרבן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הכתוב עליו ומתני' רבי היא דאמר קטן והביא גדול לא יצא: <b>קיני זבים וקיני זבות.</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בחד ניתנו דשם זב אחד הוא: <b>וחטאת ואשמות.</b> בתרין הוו: <b>המנחות.</b> היינו מותר מנחת",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חוטא דלציבור אזיל דאילו מותר מנחת יחיד הוסיף משלו ומביא מנחה אחרת: <b>ועשירית</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>האיפה.</b> שכה\"ג מקריב בכל יום ואם הפריש לעשירית האיפה של יום וניתותרו שוב אין",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יכול לצרפו לשם מחר אלא תפול לנדבת ציבור וכדר\"א לעיל בפ\"ב דף ח' ורש\"י במנחות",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פרק האומר עלי יש לו גירסא אחרת ע\"ש: <b>ריבו לה שופרות הרבה.</b> כדי שלא יתעפשו המעות:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ה\"ג כתיב וככלותם וכו': <b>שתי נדבות עשה.</b> דבמלכים כתיב ויקח יהוידע הכהן ארון א'",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ויקוב חור בדלתו ויתן אותו אצל המזבח בימין וגו' ובד\"ה כתיב ויאמר המלך ויעשו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ארון ויתנהו בשער בית ה' החוצה משמע דב' ארונות עשה א' בפנים וא' בחוץ ומסתמא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לשני מינין נדבות עשה אותן: <b>מפני הטמאין.</b> לעולם נדבה א' היתה אלא שיהוידע נתנו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בפנים אבל המלך אמר שיתנהו בחוץ כדי שיוכלו גם הטמאים דהיינו טמאי מת ושרץ ליתן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לתוכו שהם מותרים לבא במחנה לויה: <b>על שם וכו'.</b> כלומר ע\"כ לומר דשני נדבות היו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבמלכים כתיב אך לא יעשה בית ה' ספות מזמרות וכו' מן הכסף המובא בית ה' ובד\"ה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כתיב וככלות' וכו' את שאר הכסף ויעשוהו כלי שרת אלא ודאי דשני נדבות היו ומן הכסף",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "המובא בית ה' והיינו הנדבה הכתובה במלכים לא נעשו כלי שרת אבל מנדבה הכתובה בד\"ה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והיא ניתנה חוץ לבית ה' ממנה עשו כלי שרת: ה\"ג ספות כסף וכו' מן כסף המובא בית",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ה': <small>הדרן עלך פרק שלשה עשר שופרות</small>",
      "gemara_segment_ids": [
        5
      ]
    }
  ],
