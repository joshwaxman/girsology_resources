  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ואוכלת בקדשים ואינה חוששת שמא נתעצל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהן ואין הכהן חושש שמא דמי חטאות מיתות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעורבות בהן כי קאמרינן בחטאות שמתו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעליהן ודאי ואי אמרינן נברור ארבעה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זוזי ונישדי בנהרא ואידך לישתרו הא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרינן בעלמא רבי יהודה לית ליה ברירה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסה בי רבי בון אמר רבי בא בר ממל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעי דאמר הרי עלי עץ מביא גיזר אחד אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי לעזר מתניתא אמרה כן שזה קרבן בפני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצמו וזה קרבן בפני עצמו כהאי דתנינן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמן השנים בידם שני גזרי עצים וקרבן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרבות את העצים רבי יהושע בן לוי אמר",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עוביין אמה באמה שוחקת וארכן באמה גדומה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חוני בשם רבי אמי כמין טורטני אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמואל בר רב יצחק לפי שלא היה מקום",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המערכה אלא אמה על אמה לפיכך לא היה בו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא אמה גדומה ותני כן אמה היסוד אמה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סובב אמה כרכוב ואמה קרנות ואמה מערכה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבונה לא יפחות מקומץ נאמר כאן אזכרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונאמר להלן אזכרה מה אזכרה האמור להלן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלא קומץ אף אזכרה האמור כאן מלא קומץ",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אי מה אזכרה האמורה להלן שני קומצין אף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אזכרה האמורה כאן שני קומצין אמר רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אילא כלום למדו לקומץ אלא ממנחת חוטא מה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להלן קומץ החסר פסול אף כאן קומץ החסר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פסול אמר רבי יוסה מילתא דרבי אילא אמרה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המתנדב לבונה מביאה בקומצו של כהן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(גדול) רבי חזקיה בשם רבי ירמיה ואפילו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקומץ הבעלים זהב לא יפחות כו׳ אמר רבי",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר והוא שהזכיר צורה אבל אם לא הזכיר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צורה מביא אפילו צינורה ששה לנדבה חזקיה",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר כנגד ששה בתי אבות בר פדיה אמר כנגד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שש בהמות פר ועגל ושעיר איל גדי וטלה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל אמר כנגד ששה קרבנות (קני זבים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וקני זבות קני יולדות) חטאות ואשמות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המנחות ועשירית האיפה אמר רבי יוחנן על",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידי שהנדבה מרובה ריבו לה שופרות הרבה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתיב וככלותם הביאו לפני המלך ויהוידע",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וגו׳ רבי שמעון בר נחמן בשם רבי יונתן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר שתי נדבות עשה",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גמ' <b>לא היה שופר של קיני.</b> חובה כגון זב וזבה ויולדת שיתנו לתוכו מעות כשם שהיו שופרות לקן נדבה כדתנן במתני': <b>מפני</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>התערובות.</b> שמא תמות אחת מאותן שנתנו מעות בשופר וה\"ל מעות חטאת שמתו בעליה מעורבין עם הכשרות והכל פסולין והולכין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לים המלח: <b>ה\"ג והתני האשה שיש עליה לידה או זיבה מביאה דמי קן וכו'.</b> כ\"ה ברמב\"ם פ\"ק מה' מחוסרי כפרה אבל באומרת הרי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עלי קן שניהם עולות והרא\"פ לא הרגיש בזה: <b>ונותנתו בשופר.</b> שכתוב עליו קינין ודמי הקינין קצובין היו: <b>ואוכלת בקדשים.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לערב: <b>ואינה חוששת שמא נתעצל</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בהן.</b> דחזקה על ב\"ד של כהנים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאין עומדים משם עד שיכלו כל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעות של אותו שופר כדי שלא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יאכלו מחוסרי כפרה בקדשי':",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואין הכהן חושש וכו'.</b> ולא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פליג ר\"י משמע דכ\"ע מודים דלא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חיישינן שמא מתה אחת מהן:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומשני כי קאמרינן.</b> לר\"י דחייש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתערובת היינו שיוודע לן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבוודאי מת אחד מהנותנין לתוך",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השופר נמצא שהן מעורבות:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופריך <b>ואי אמרינן כו'.</b> כלומר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמאי ונברור ד' זוזי דמי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החטאת ונאמר דאלו הן דמי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החטאת שמתו בעליהן והשאר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יקרבו ודקאמר ד' זוזי היינו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זוזי פשיטי שח' מהן הוא דינר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צורי והן דמי פרידה אחת דתנן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו ביום עמדו קינין ברבעתים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פי' פרידה אחת והרובע הוא חצי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דינר צורי שהוא ד' זוזי מדינה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א\"נ אורחיה דש\"ס למתני ד':",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לית ליה ברירה.</b> לא סמכינן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אברירה למשרי איסורא: <b>בעי אם</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אמר הרי עלי עץ.</b> ולא אמר עצים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא נתכוין אלא לעץ אחד מהו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיביא א' או שנים: <b>מתניתא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אמרה כן.</b> שאף גיזר אחד הוה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבן ונדרו נדר: <b>כהאי דתנינן</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תמן.</b> ביומא פ\"ב: <b>ושנים שני</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כהנים בידם שני גיזרי עצים.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביד כל א' גיזר אחד ש\"מ שכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "א' קרבן בפני עצמו: <b>ה\"ג קרבן</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לרבות את העצים.</b> וה\"פ כתיב כי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תקריב קרבן מנחה ומצינו לעצים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנקראו קרבן דכתיב והגורלות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפלנו על קרבן העצים: <b>באמה</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שוחקת.</b> פי' באמה גדולה:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>גדומה.</b> פחותה: <b>כמין טורטני.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קנה מאזנים ולי נראה דאעוביו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאי שלא היתה עוביו אלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כטורטני והוא כמחק גודש סאה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השנוי בבבלי: <b>אלא אמה על אמה.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואמתא באמתא היכי יתיב וכתיב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על העצים אשר על המזבח שלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יהו העצים יוצאין מן המזבח לפיכך לא היו העצים אלא אמה גדומה: <b>ותני כן.</b> ותניא נמי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הכי שמקום המערכה לא היה אלא אמה על אמה: <b>נאמר כאן.</b> גבי לבונה דלחם הפנים אזכרה",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכתיב ונתת על המערכה לבונה זכה והיתה ללחם לאזכרה: <b>ונאמר להלן.</b> גבי מנחה וקמץ",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משם מלא קומצו מסלתה ומשמנה על כל לבונתה והקטיר הכהן את אזכרתה: <b>אף כאן קומץ.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לכל מערכה וכי היכי דסתם מנחה מלא קומץ אף סתם נדבת לבונה מלא קומץ: <b>ה\"ג אי מה</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>להלן שני קומצין.</b> וה\"פ אי מה להלן בלחם הפנים ב' קומצין כדאמרינן לעיל על כל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מערכה קומץ אף סתם נדבת לבונה ב' קומצין: <b>כלום למדו לקומץ.</b> לבונה אלא מלחם הפנים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והתם בעינן שיהא כל קומץ בפני עצמו מלא ואם חסר ממנה פסול ש\"מ אע\"ג דבהצטרפות יש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שני קומצין כגון שהשני יתר אפ\"ה פסול כדילפי' ממנחת חוטא ש\"מ דכל קומץ קרבן בפני",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עצמו: <b>מילתא דרבי אילא אמרה.</b> מדברי ר' אילא שמעינן: <b>ה\"ג המתנדב לבונה מביאה</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בקומצו של כה\"ג.</b> וה\"פ מדיליף לה מלחם הפנים ובפייס נעשה ולא ידעינן הי כהן דמתרמי",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וצריך שיהיה הרבה שיקמוץ ממנו גדול שבכהנים: <b>ואפי' בקומץ הבעלים.</b> ממנחה ילפינן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ויכול ליתן אותם לכל כהן שירצה שבאותו משמר: <b>והוא שהזכיר צורה.</b> דאמר מטבע:",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>צינורא.</b> שיעורו מזלג קטן: <b>כנגד ששה בתי אבות.</b> הכהנים שתקנו להם חכמים שיהא כל",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משמר חלוק לששה בתי אבות כנגד ששת ימי השבוע שיעבוד כל אחד ביומו ובשבת כולן שוין",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיהא שלום ביניהון שעורות של בהמות הניקחות מן השופרות היו לכהנים שמקריבין",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "העולות וכל זמן שאין המזבח בטל לא היו לוקחין מן השופרות ואם לא היה להם אלא שופר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אחד אתי לאנצויי דשמא באותו יום של בית אב הראשון או השני יביאו נדרים ונדבות",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הרבה ולא יטול הבית אב מן השופר כלום ובשאר ימות השבוע לא יביאו נדרים ונדבות",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הרבה נמצא אותן בתי אבות מקריבין מן השופר שלא יהא המזבח בטל והוו עורות שלהם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומנצו הנך קמאי בהדי הנך ואמרי יש לכם עורות ואנו אין לנו כלום ואי משום הנך",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עולות שהביאו יחידים במשמרות שלנו מזלינו גרם א\"נ פעמים שמקריבין שלמים והעורות",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לבעלי' הלכך תקינו ששה שופרות שלא יטול זה משופרו של זה וכשהמעות באות נותנין",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אותן לששה שופרות: <b>כנגד פר וכו'.</b> שהמתנדב פר ועולה מביא ונותן לשופר שכתוב עליו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "פר מנה כדאמרי' יביא במנה והמתנדב עגל מביא חמשה סלעים ונותן לשופר שכתוב עליו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עגל וכן כולם והכהנים מקריבין מכל שופר קרבן הכתוב עליו ומתני' רבי היא דאמר קטן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והביא גדול לא יצא: <b>קיני זבים וקיני זבות.</b> בחד ניתנו דשם זב אחד הוא: <b>וחטאת</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואשמות.</b> בתרין הוו: <b>המנחות.</b> היינו מותר מנחת חוטא דלציבור אזיל דאילו מותר מנחת",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יחיד הוסיף משלו ומביא מנחה אחרת: <b>ועשירית האיפה.</b> שכה\"ג מקריב בכל יום ואם הפריש",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעשירית האיפה של יום וניתותרו שוב אין יכול לצרפו לשם מחר אלא תפול לנדבת ציבור",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכדר\"א לעיל בפ\"ב דף ח' ורש\"י במנחות פרק האומר עלי יש לו גירסא אחרת ע\"ש: <b>ריבו</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לה שופרות הרבה.</b> כדי שלא יתעפשו המעות: ה\"ג כתיב וככלותם וכו': <b>שתי נדבות עשה.</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דבמלכים כתיב ויקח יהוידע הכהן ארון א' ויקוב חור בדלתו ויתן אותו אצל המזבח",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בימין וגו' ובד\"ה כתיב ויאמר המלך ויעשו ארון ויתנהו בשער בית ה' החוצה משמע דב'",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ארונות עשה א' בפנים וא' בחוץ ומסתמא לשני מינין נדבות עשה אותן: <b>מפני הטמאין.</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעולם נדבה א' היתה אלא שיהוידע נתנו בפנים אבל המלך אמר שיתנהו בחוץ כדי שיוכלו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "גם הטמאים דהיינו טמאי מת ושרץ ליתן לתוכו שהם מותרים לבא במחנה לויה: <b>על שם</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וכו'.</b> כלומר ע\"כ לומר דשני נדבות היו דבמלכים כתיב אך לא יעשה בית ה' ספות מזמרות",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכו' מן הכסף המובא בית ה' ובד\"ה כתיב וככלות' וכו' את שאר הכסף ויעשוהו כלי שרת",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא ודאי דשני נדבות היו ומן הכסף המובא בית ה' והיינו הנדבה הכתובה במלכים לא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נעשו כלי שרת אבל מנדבה הכתובה בד\"ה והיא ניתנה חוץ לבית ה' ממנה עשו כלי שרת:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ה\"ג ספות כסף וכו' מן כסף המובא בית ה': <small>הדרן עלך פרק שלשה עשר שופרות</small>",
      "gemara_segment_ids": [
        5
      ]
    }
  ],
