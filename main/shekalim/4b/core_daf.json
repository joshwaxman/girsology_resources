  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ומאיליהן הן באין לבדק הבית מה עבד לה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמעון בן לקיש פתר לה לא לכם ולנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבנות בית לאלהינו רבי חזקיה אמר רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סימון שאל מעתה אין מקבלין מהן לאמת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המים ולחומות העיר ומגדלותיה על שם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(שנאמר) ולכם אין חלק וגו׳ מתניתא דרבי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאיר דאמר רבי מאיר כשם ששקלו תורה כך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קלבנו תורה קסבר רבי מאיר בנותן שקלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלם שהוא חייב בקלבון דאמר רבי מאיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמין מטבע של אש הוציא הקדוש ברוך הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתחת כסא כבודו והראהו למשה ואמר לו זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יתנו כזה יתנו נתן סלע ליטול שקל חייב",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שני קולבונות אמר רבי אלעזר דרבי מאיר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היא דתניא אלו חייבין בקלבון כו׳ קלבון אחד ורבי מאיר אמר שני קולבנות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ומר רב דברי הכל היא דאמר רבי מאיר אחד שקל שהוא נותן ואחד שקל שהוא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "נוטל ואחד לדברי תורה על דעתיה דרב שלשה קולבנות אינון אתא רבי ירמיה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "רבי שמואל בר רב יצחק בשם רב שלשה קולבנות אינון אחד שקל שהוא נותן ואחד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שקל שהוא נוטל ואחד לדבר תורה האחים והשותפין שחייבין בקלבון ופטורין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ממעשר בהמה בשחלקו וחזרו ונשתתפו שחייבין במעשר בהמה ופטורים מן הקלבון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "בשלא חלקו אמר רבי לעזר והן שחלקו גדיים כנגד תיישים ותיישים כנגד גדיים",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אבל אם חלקו גדיים כנגד גדיים ותיישים כנגד תיישים הוא חלקו משעה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הראשונה אמר רבי יוחנן אפילו חלקו גדיים נגד גדיים ותיישים נגד תיישים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כלקוחות הן ופטורין מן המעשר כההוא דתנינן תמן הלקוח ושניתן לו במתנה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "פטור ממעשר בהמה רבי חייא אמר רבי ירמיה בעי ולמה לית נן אמרין פעמים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שהן חייבין בזה ובזה",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני'. דתנן ואלו שחייבין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקלבון משמע דאין לך מי שחייב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשקל שלא יהא חייב בקלבון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אתיא כר\"מ: <b>ה\"ג דר\"מ אמר כשם</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ששקלו תורה כך קלבנו תורה סבר</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ר\"מ בנותן שקלו שלם שהוא חייב</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בקלבון.</b> וה\"פ דרמ\"א לעולם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חייב בקלבון מן התורה אפי'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותן מחצית שקלו: <b>כזה יתנו.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא נקי מכל סיג שהרי מאש",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה והלכך כל השקלים צריכין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קלבון שיהא הכסף הנקי שבהם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחצית השקל: <b>ה\"ג אחד שקל שהוא</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נותן ואחד שקל שהוא נוטל.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"פ הגזבר צריך ליקח ממנו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שני קלבונות אחד בשביל השקל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא מחזיר לו ואחד בשביל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השקל שהוא נוטל ממנו שהיה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך ליתן להשלחני: <b>דברי הכל</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היא.</b> אפילו לרבנן צריך ליתן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שתי קלבונות אם נתן סלע ונטל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקל קלבון אחד מפני שלא שקל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקל האמור בתורה ואחד מהחצי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקל שמקבל מהגזבר: <b>ה\"ג על</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דעתיה דרב ג' קולבונות אינון</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אחד שקל שהוא נותן וכו' ואחד</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לדבר תורה אתא ר' ירמיה וכו'.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"פ לרב אליבא דר\"מ בנתן סלע",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונטל שקל חייב ג' קלבונות אחד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לשקל שהוא נותן אלו היה נוטל מהשלחני ואחד לשקל שהוא נוטל שאם מחליפו נותנין לו חצי שקל וקלבון וא' לדבר תור' שהוא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צריך להוסיף על חצי שקל של תורה. והרא\"פ החליף הגרסאו' והאריך הדברי' ללא צורך והגי' שלפנינו עיקר:",
      "gemara_segment_ids": [
        2
      ]
    }
