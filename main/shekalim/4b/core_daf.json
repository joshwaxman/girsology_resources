  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "ומאיליהן הן באין לבדק הבית מה עבד לה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמעון בן לקיש פתר לה לא לכם ולנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבנות בית לאלהינו רבי חזקיה אמר רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סימון שאל מעתה אין מקבלין מהן לאמת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המים ולחומות העיר ומגדלותיה על שם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(שנאמר) ולכם אין חלק וגו׳ מתניתא דרבי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאיר דאמר רבי מאיר כשם ששקלו תורה כך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קלבנו תורה קסבר רבי מאיר בנותן שקלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלם שהוא חייב בקלבון דאמר רבי מאיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמין מטבע של אש הוציא הקדוש ברוך הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתחת כסא כבודו והראהו למשה ואמר לו זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יתנו כזה יתנו נתן סלע ליטול שקל חייב",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שני קולבונות אמר רבי אלעזר דרבי מאיר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היא דתניא אלו חייבין בקלבון כו׳ קלבון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד ורבי מאיר אמר שני קולבנות ומר רב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דברי הכל היא דאמר רבי מאיר אחד שקל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהוא נותן ואחד שקל שהוא נוטל ואחד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לדברי תורה על דעתיה דרב שלשה קולבנות",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אינון אתא רבי ירמיה רבי שמואל בר רב יצחק בשם רב שלשה קולבנות אינון",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אחד שקל שהוא נותן ואחד שקל שהוא נוטל ואחד לדבר תורה האחים והשותפין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שחייבין בקלבון ופטורין ממעשר בהמה בשחלקו וחזרו ונשתתפו שחייבין במעשר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בהמה ופטורים מן הקלבון בשלא חלקו אמר רבי לעזר והן שחלקו גדיים כנגד",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תיישים ותיישים כנגד גדיים אבל אם חלקו גדיים כנגד גדיים ותיישים כנגד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תיישים הוא חלקו משעה הראשונה אמר רבי יוחנן אפילו חלקו גדיים נגד גדיים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ותיישים נגד תיישים כלקוחות הן ופטורין מן המעשר כההוא דתנינן תמן הלקוח",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ושניתן לו במתנה פטור ממעשר בהמה רבי חייא אמר רבי ירמיה בעי ולמה לית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "נן אמרין פעמים שהן חייבין בזה ובזה",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מתני'. דתנן ואלו שחייבין בקלבון משמע דאין לך מי שחייב בשקל שלא יהא חייב בקלבון אתיא כר\"מ: <b>ה\"ג דר\"מ אמר כשם</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ששקלו תורה כך קלבנו תורה סבר ר\"מ בנותן שקלו שלם שהוא חייב בקלבון.</b> וה\"פ דרמ\"א לעולם חייב בקלבון מן התורה אפי'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נותן מחצית שקלו: <b>כזה יתנו.</b> שהוא נקי מכל סיג שהרי מאש היה והלכך כל השקלים צריכין קלבון שיהא הכסף הנקי שבהם מחצית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "השקל: <b>ה\"ג אחד שקל שהוא נותן ואחד שקל שהוא נוטל.</b> וה\"פ הגזבר צריך ליקח ממנו שני קלבונות אחד בשביל השקל שהוא מחזיר",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו ואחד בשביל השקל שהוא נוטל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנו שהיה צריך ליתן להשלחני:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דברי הכל היא.</b> אפילו לרבנן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריך ליתן שתי קלבונות אם נתן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סלע ונטל שקל קלבון אחד מפני",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא שקל שקל האמור בתורה ואחד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהחצי שקל שמקבל מהגזבר: <b>ה\"ג</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>על דעתיה דרב ג' קולבונות</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אינון אחד שקל שהוא נותן וכו'</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואחד לדבר תורה אתא ר' ירמיה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> וה\"פ לרב אליבא דר\"מ",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בנתן סלע ונטל שקל חייב ג'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קלבונות אחד לשקל שהוא נותן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלו היה נוטל מהשלחני ואחד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשקל שהוא נוטל שאם מחליפו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותנין לו חצי שקל וקלבון וא'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדבר תור' שהוא צריך להוסיף",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על חצי שקל של תורה. והרא\"פ",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החליף הגרסאו' והאריך הדברי'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ללא צורך והגי' שלפנינו עיקר:",
      "gemara_segment_ids": [
        2
      ]
    }
  ],
