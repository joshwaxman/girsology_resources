    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע יושב ודורש היה אומר כך אמר משה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא יהושע יושב ודורש ויודעין הכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהתורה של משה היא אף אתה אליעזר יושב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודורש והכל יודעין שהתורה שלך היא אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להן מפני מה אין אתן יודעין לרצות כבן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אידי חבירנו ורבי יוחנן מאי כולי האי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבעי דימרון שמעתא משמיה דאף דוד ביקש",
