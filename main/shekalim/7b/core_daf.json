  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אליעזר ורבי יוסי עד שקרעו ספר תורה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחמתן קרעו סלקא דעתך אלא שנקרע ספר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורה והיה שם זקן אחד ורבי יוסי בן קסמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמו אמר תמיהני אם לא הוה בית הכנסת זה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עבודה זרה וחזר ואמר הכדין מחבריה נכנס",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפניו רבי יעקב בר אידי אמר ליה כתיב",
