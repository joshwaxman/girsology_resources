  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אליעזר ורבי יוסי עד שקרעו ספר תורה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחמתן קרעו סלקא דעתך אלא שנקרע ספר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורה והיה שם זקן אחד ורבי יוסי בן קסמא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמו אמר תמיהני אם לא הוה בית הכנסת זה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עבודה זרה וחזר ואמר הכדין מחבריה נכנס",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפניו רבי יעקב בר אידי אמר ליה כתיב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאשר צוה ה׳ את משה עבדו כן צוה משה את",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע וגו׳ וכי כל דיבור ודיבור שהיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע יושב ודורש היה אומר כך אמר משה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלא יהושע יושב ודורש ויודעין הכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהתורה של משה היא אף אתה אליעזר יושב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודורש והכל יודעין שהתורה שלך היא אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להן מפני מה אין אתן יודעין לרצות כבן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אידי חבירנו ורבי יוחנן מאי כולי האי",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבעי דימרון שמעתא משמיה דאף דוד ביקש",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עליה רחמים שנאמר אגורה באהלך עולמים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחסה בסתר כנפיך סלה וכי עלתה על דעתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של דוד שיהא חי וקים לעולמים אלא כך אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דוד לפני הקדוש ברוך הוא רבונו של עולם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אזכה שיהו דברי נאמרין בבתי כנסיות",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובבתי מדרשות שמעון בן נזירא בשם רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצחק אמר כל תלמיד חכם שאומרים דבר הלכה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפיו בעולם הזה שפתיו רוחשות עמו בקבר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנאמר וחכך כיין הטוב וגו׳ דובב שפתי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישנים מה כומר של ענבים זה כיון שמניח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדם אצבעו עליו מיד דובב אף שפתותיהם של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צדיקים כיון שאומרין דבר הלכה מפיהם של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צדיקים שפתותיהן מרחשות עמהן בקבר מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הנאה לו בר נזירא אמר כהדין דשתי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קונדיטון רבי יצחק אמר כהדין דשתי חמיר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עתיק אף על גב דשתי ליה טעמא בפומא רב",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גידל אמר האומר שמועה בשם אומרה יראה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעל שמועה כאילו עומד לנגדו שנאמר אך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בצלם יתהלך איש כתיב רב אדם יקרא איש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסדו זה שאר כל אדם ואיש אמונים מי ימצא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זה רבי זעירא דאמר רבי זעירא ליתנן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צריכין חששין לשמעתיה דרב ששת דהוא גברא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפתחא אמר ליה רבי זעירא לרבי אסי חכים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי לבר פתייא דאת אמר שמעתא משמיה אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה רבי יוחנן אמרה משמיה אמר ליה רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זעירא לר׳ אסי חכים רבי לרב דאת אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמעתא משמיה אמר ליה רבי אדא בר אהבה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרה משמיה אין דור שאין בו ליצנין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדורו של דוד מה היו פרוצי הדור עושין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו הולכין אצל חלונותיו של דוד אומרין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו דוד דוד אימתי יבנה בית המקדש אימתי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית ה׳ נלך והיה דוד אומר אף על פי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמתכוונין להכעיסני יבא עלי אם לא הייתי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמח בדבריהם דכתיב שמחתי באומרים לי בית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ה׳ נלך והיה כי ימלאו ימיך ושכבת את",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבותיך אמר לו הקדוש ברוך הוא לדוד ימים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלמים אני מונה לך ולא ימים חסרים כלום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלמה בנך יבנה בית המקדש אלא להקריב",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרבנות ציבור וחביב עלי צדקה ומשפט שאתה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושה יותר מן הקרבן שנאמר עשה צדקה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומשפט נבחר לה׳ מזבח הדרן עלך מצרפין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקלים <b>הלכה א <big>מתני׳</big></b> בשלשה פרקים בשנה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורמין את הלשכה בפרוס הפסח בפרוס העצרת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפרוס החג והם גרנות של מעשר בהמה דברי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי עקיבא בן עזאי אומר בעשרים ותשעה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באדר ובאחד בסיון ובעשרים ותשעה באב רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעזר ורבי שמעון אומרים באחד בניסן באחד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בסיון בעשרים ותשעה באלול ולמה אמרו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעשרים ותשעה באלול ולא אמרו באחד בתשרי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני שהוא יום טוב ואי אפשר לעשר ביום",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טוב לפיכך הקדימוהו בעשרים ותשעה באלול",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>גמ׳</b> אמר רבי אבהו כל הן דתנינן פרס פלגא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פלגא דשלשים יום קודם למועד שדורשים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בהלכותיו והן גרנות וכו׳ אמר רבי יוחנן",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני שהן פירקי לידה רבי אחא ורבי תנחום",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר חייה בשם רבי יהושע בן לוי כדי שתהיה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבהמה מצויה לעולי רגלים אמר רבי יודן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלא יבא לידי בל תאחר אמר רבי יוסה כל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המשהה טבלו עובר בבל תאחר",
      "segment_ids": [
        6
      ]
    }
