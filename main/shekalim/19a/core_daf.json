  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "תני דבי רבי ישמעאל נדבה אחת דכתיב",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויאמר המלך ויעשו ארון אחד ויתנהו בהיכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית ה׳ ויקב חור בדלתו והא דכתיב ויאמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המלך ויעשו ארון אחד ויתנהו בשער בית ה׳",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חוצה אמר רב חונא מפני הטמאים רבי חנינא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי יוסף אך לא יעשה בית ה׳ ספות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כסף מזמרות וגו׳ הדרן עלך פרק שלשה עשר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שופרות <b>הלכה א <big>מתני׳</big></b> מעות שנמצאו בין",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השקלים לנדבה, קרוב לשקלים – יפלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשקלים, לנדבה – יפלו לנדבה, מחצה למחצה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "– יפלו לנדבה. בין עצים ללבונה קרוב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעצים יפלו לעצים ללבונה יפלו ללבונה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחצה למחצה יפלו ללבונה בין קינין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לגוזלי עולה קרוב לקנין יפלו לקינין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרוב לגוזלי עולה יפלו לגוזלי עולה מחצה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למחצה יפלו לגוזלי עולה בין חולין למעשר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שני קרוב לחולין יפלו לחולין למעשר שני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יפלו למעשר שני מחצה למחצה יפלו למעשר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שני זה הכלל הולכין אחר הקרוב להקל מחצה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למחצה להחמיר <b>גמ׳</b> לא הוצרכה דלא בין",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שקלים לקינים רבי אבון בשם רבי פנחס",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמין בוכלייאר היו עשוין מחצה למחצה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יפלו לנדבה (לא צורכה דלא מחצה למחצה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יפלו לשקלים) אית דבעי מימר שמא יפלו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשירי הלשכה אית דבעי מימר מחצה למחצה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמי שמת אמר רבי יסא עד דאנא תמן שמעית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קל רב יהודה שאל לשמואל הפריש שקלו ומת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר ליה יפלו לנדבה עשירית האיפה שלו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוחנן אמר יוליכם לים המלח רבי לעזר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר יפלו לנדבה וקשיא ויש חטאת קריבה",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עולה חזקיה בשם רבי שמעון בן לקיש תנאי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית דין הוא על המותרות שיקרבו עולות",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האשה הזאת במה היא מתכפרת אמר רבי יצחק",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תנאי בית דין הוא המספק את הקינין הוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מספק את הפסולות לא צורכה דלא בין קטורת לעצים ללבונה לזהב לכפורת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ותניתה בסופה זה הכלל הולכין אחר הקרוב מחצה למחצה להחמיר <b>הלכה ב <big>מתני׳</big></b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מעות שנמצאו לפני סוחרי בהמה – לעולם מעשר, ובהר הבית חולין ובירושלם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בשאר כל ימות השנה חולין ובשעת הרגל הכל מעשר בשר שנמצא בעזרה איברים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "עולות וחתיכות חטאות ובירושלם זבחי שלמים זה וזה תעובר צורתו ויצא לבית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "השריפה נמצא בגבולין איברים נבילות וחתיכות מותרות",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' <b>יפלו לשקלים.</b> דבתר קרוב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אזלינן כדכתיב והיתה העיר",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקרובה אל החלל: <b>מחצה על מחצה</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יפלו לנדבה.</b> בגמרא מפרש טעמא:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מחצה על מחצה יפלו ללבונה.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלבונה היא עצמה קרבן ועצים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכשירי קרבן: <b>מחצה על מחצה</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יפלו לגוזלי עולה.</b> מפרש בגמ':",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' ופריך <b>לא צורכא.</b> לא היה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו לתנא לשנות אלא מעות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנמצאו בין שקלים לקינים שהרי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שופר של שקלים היה סמוך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקינים כפי סדר השנוי בפ'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלעיל ולא לנדבה שהנדבה בסוף",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ושקלים בראש: <b>ומשני כמין</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כובליי'.</b> פי' בעיגול סביב היו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עומדין והיו השקלים סמוך",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לנדבה מצד א': ופריך <b>לא</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>צורכא.</b> לא הל\"ל אלא מחצה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למחצה יפלו לשקלים שמביאין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהן קרבנות ציבור הקבועים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משא\"כ נדבה שאינן אלא לקיץ",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המזבח: <b>ומשני אית דבעי וכו'.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יש שרצו לתרץ דהיינו טעמא דלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יפלו לשקלים דלפעמים יתותרו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השקלים ושירי שקלים לחומת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העיר ולא לקרבנות באין נמצא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהנדבה חמורה ממנה: <b>מחצה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>למחצה.</b> שקלים שנמצאו במחצה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למחצה ה\"ל כשקל שמתו בעליו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנופל לנדבה כדמסיק: <b>עד דאנא</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תמן.</b> כשהייתי בבבל שמעתי ששאל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ר\"י לשמואל הפריש שקלו ומת מה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יעשה בו: <b>מותר עשירית האיפה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלו.</b> של כה\"ג מה יעשה בו:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יוליכם לים המלח.</b> לא נהנין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא מועלין בו: <b>וקשיא ויש</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חטאת וכו'.</b> אמתני' פריך דתני",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין קינין וכו' מחצה למחצה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יפלו לגוזל עולה בשלמא קרוב",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לגוזלי עולה כיון דמדאורייתא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אזלינן בתר קורבה הוה כאילו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הן ודאי גוזלי עולה אלא מחצה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על מחצה דמספיקא שדינן להו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לגוזלי עולה קשיא וכי חטאת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יכול להקריב עולה מספק: <b>ומשני</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תנאי ב\"ד הוא על המותרות שיקרבו עולות.</b> אע\"ג דמותרות חטאת הן ה\"נ תנאי בית דין הוא שיקרבו עולות: ופריך <b>האשה הזאת.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהביאה המעות הללו במה תתכפר כלומר שמא מקיני חובה נפלו ובמה תתכפר שהרי לא הקריבה חטאתה: <b>ומשני תנאי ב\"ד הוא המספק</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>את הקינין מספק את הפסולות.</b> ואף זו מן הפסולות היא וצריך המספק קינין ליתן קינין כפי המעות הנמצאים ושוחטן חטאת על",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הספק דחטאת העוף באה על הספק ואינה נאכלת: ופריך <b>לא צורכא.</b> וכי לא היה צריך לתנא לשנות נמי בין קטורת לעצים ובין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לבונה לזהב לכפורת מה דינם: <b>ומשני ותניתה בסיפא.</b> כבר תנא בסיפא זה הכלל הולכין אחר הקרוב וכו' ומרבינן הכל בזה הכלל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומיהו הנך דתני איצטריך לאשמעי' שום חידוש כדשנינן: מתני' <b>לעולם מעשר.</b> אפי' כל השנה כולה לפי שעולי רגלים אינן",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מספיקין להוציא כל מעשר שני שלהם ברגלים ומניחין אותן לקרוביהם או לאהוביהן בטובת הנאה והן אוכלין אותן בקדושתן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ועיקר אכילת מעות מעשר שלמים היו מביאין מהן הלכך לוקחין מהן בהמות ואע\"ג דאיכא למימר שמא מן המוכרין נפלו ונתחללו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כבר כיון דלוקחין הוי רובא שהרי כמה אנשים לוקחים מתגר א' אמרי' דלוקחין הן ולא נתחללו והרי הן מעשר: <b>בהר הבית</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>חולין.</b> ואתיא ברגל שרוב מעות שביד בני אדם אז הן של מעשר אפ\"ה הוי חולין דאזלינן בתר רובא דשתא ואימור מקמי רגל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נפיל: <b>בירושלים.</b> שלא בשוק הבהמות: <b>בשעת הרגל הכל מעשר.</b> ולא אזלינן בתר רוב שתא לפי ששוקי ירושלים עשוי להתכבד בכל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "יום ואי נפל מקודם כבר נמצאו אבל הר הבית לא היה עשוי להתכבד לפי שהוא גבוה והרוח מכבד ומסיר כל האבק וגם אין אדם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רשאי ליכנס להר הבית באבק שברגליו לפיכך אין אבק מצוי שם: <b>אברים עולות.</b> כיון שמנותח כדרך הנתוח המפורש בעולות בידוע",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהן של עולות: <b>וחתיכות חטאות.</b> דאין אוכלין בעזרה אלא חטאות ואשמות: <b>בירושלים זבחי שלמים.</b> דרוב בשר הנאכל בירושלים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוי שלמים: <b>זה וזה.</b> בין שנמצא בעזרה בין שנמצא בירושלים תעובר צורתן לפי שנפסל בהיסח הדעת אסורין באכילה ואין לזלזל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בהן ולשרפן עד שיפסלו בודאי הלכך טעונין עיבור צורה והיינו שיפסלו בנותר ועבור צורה דשלמים עד יום השלישי: <b>נמצאו</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בגבולין.</b> בערי ישראל: <b>איברין נבילות.</b> שכן דרך שחותכין הנבילות לאיברים ומשליכין ברחובות שיאכלוהו הכלבים: <b>חתיכות</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מותרין.</b> שאין דרך לחתוך לחתיכות קטנות אלא הכשרות למכרן או לתת אותן לקדירה: <b>שהבשר מרובה.</b> ואין חותכין הבשר לחתיכות",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קטנות אלא מבשלים אותו איברים איברים:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
