  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אלעזר אומר שנטמא באב הטומאה בין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפנים בין בחוץ ישרף בחוץ שנטמא בולד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הטומאה בין בחוץ בין בפנים ישרף בפנים",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי עקיבא אומר מקום טומאתו שם שריפתו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>גמ׳</b> בר קפרא אמר אב הטומאה דבר תורה ולד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הטומאה מדבריהם רבי יוחנן אמר בין זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין זה דבר תורה וקשיא דרבי יוחנן על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבית שמאי דבית שמאי אומרים הכל ישרף",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפנים חוץ משנטמא באב הטומאה בחוץ מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין אב הטומאה בחוץ מה בין ולד הטומאה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחוץ זה וזה לא דבר תורה הוא ואפילו על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבית הלל לא מקשייא דבית הלל אמר הכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישרף בחוץ חוץ מה שנטמא בולד הטומאה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפנים מה בין ולד הטומאה בפנים מה בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אב הטומאה בפנים זה וזה לא דבר תורה הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא הוו בה רבנן אלא על דבר קפרא וקשיא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר קפרא על דבית שמאי דבית שמאי אומרים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכל ישרף בפנים חוץ משנטמא באב הטומאה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחוץ מה בין אב הטומאה בין בחוץ בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפנים זה וזה לא דבר תורה הוא בגין דרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עקיבא אמר מקום טומאתו שם תהא שריפתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואפילו על דבית הילל לא מקשייא דבית הלל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר הכל ישרף בחוץ חוץ משנטמא בולד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הטומאה בפנים מה בין ולד הטומאה בין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפנים בין בחוץ זה וזה לא מדבריהם הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בגין דרבי שמעון אמר מאכלו ומשקו של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מצורע משתלחין חוץ לשלש מחנות <b>הלכה ד</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני׳</big></b> איברי התמיד ניתנין מחצי כבש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולמטה. של מוספין – ניתנין מחצי כבש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולמטה במזרח. של ראשי חדשים ניתנין על",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרכוב המזבח מלמעלן. השקלים והביכורים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אינן נוהגין אלא בפני הבית אבל מעשר דגן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומעשר בהמה ובכורות נוהגין בין בפני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית ובין שלא בפני הבית המקדיש שקלים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וביכורים הרי זה קודש רבי שמעון אומר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "האומר ביכורים קודש אינן קודש <b>גמ׳</b> איזהו",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרכוב המזבח אמה בין קרן לקרן מקום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הילוך רגלי כהנים מוספי שבת מוספי ראש",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חודש מי קודם רבי ירמיה סבר מימר מוספי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שבת ומוספי ראש חודש מוספי ראש חודש קודמין חייליה דרבי ירמיה מן הדא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שירו של שבת ושירו של ראש חודש שירו של ראש חודש קודם אמר רבי יוסה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שנייא היא תמן דאמר רבי חייא בשם רבי יוחנן כדי לפרסמו ולהודיע שהוא ראש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "חודש כיצד היה עושה שוחט מוספי שבת ואומר עליהן שירו של ראש חודש ברם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הכא מוספי שבת ומוספי ראש חודש מוספי שבת קודמין על שם כל התדיר מחבירו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "קודם את חבירו שקלים וביכורים וכו׳ הא שקלים קדשו רבי שמעון בן יהודה",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "משום רבי שמעון בין אלו ובין אלו לא קדשו תני גר בזמן הזה צריך להביא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "קינו ריבעית כסף אמר רבי שמעון ביטלה רבי יוחנן בן זכאי מפני התקלה מהו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מפני התקלה כהדא דתני אין מקדישין ולא מעריכין ולא מחרימין ולא מגביהין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תרומות ומעשרות בזמן הזה ואם הקדיש או העריך או החרים או הגביה הכסות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תישרף הבהמה תיעקר כיצד נועל בפניה הדלת והיא מתה מאיליה והמעות ילכו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לים המלח עבר והקדיש מן מה דאמר רבי שמעון ביטלה רבן יוחנן בן זכאי מפני",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "התקלה הדא אמרה עבר והקדיש קדשו רבי יודה ענתודרייא בעי קומי רבי יוסי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הכא את",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' <b>הכל ישרף בפנים.</b> בבית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדשן הגדול שבעזרה ששם שורפין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסולי קדשי קדשים שכל שפסולו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקודש שורפין אותו בקודש: <b>חוץ</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>משנטמא בולד הטומאה בפנים.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאית ביה תרתי טומאתו בפנים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקילא טומאתו אבל נטמא באב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הטומאה אין להשהותו עד שתישרף",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא יוציאנה מיד וישרפנה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחוץ: <b>ישרף בפנים.</b> דכיון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דטהור מדאורייתא אפי' נטמא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בחוץ יש לקיים בו שריפתו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקדש: גמ' <b>וולד הטומאה.</b> היינו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנטמא בטומאה דרבנן: <b>זה וזה</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לא דבר תורה.</b> בתמיה וכיון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמדאורייתא טמא אין להכניסו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעזרה הואיל ולא היה פסולו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקודש: <b>לא הוו רבנן.</b> לא פלפלו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חכמים בדברי ר' יוחנן דלר'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יוחנן ל\"ק דאב הטומאה חמירא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל ולד הטומאה הקילו בה א\"נ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא פלפלו חכמים בדברי ר\"י",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דודאי קשיא אלא בדברי בר קפרא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקדקו: <b>ומשני בגין דר\"ע.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשביל טעמו של ר\"ע דקאמר מקום",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טומאתו שם שריפתו ה\"נ קאמרי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ב\"ש באב הטומאה ישרף בחוץ אבל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בולד הטומאה ישרף בפנים כיון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמדבריהם הוא ישרף בפנים",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ששריפתו בקדש: <b>בגין דר\"ש</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> בשביל הא דאמר ר' שמעון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמשלחין אפי' אוכלין טמאין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחוץ הלכך כל מה שנטמא בחוץ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין מביאין אותו לפנים: מתני'",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מחצי הכבש ולמטה במערב.</b> כהנים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הזוכים בפייס באברי התמיד",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להעלותם לא היו מעלים אותם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפעם אחד אלא נותנים אותם על",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכבש והולכים ללשכת הגזית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקרוא את שמע ואח\"כ חוזרין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומקריבין האיברים ע\"ג המזבח",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכבש ארוך ל\"ב אמה ומחציו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמטה נותנין אותן ורוחב הכבש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ט\"ז אמה ובחציו של צד מערב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היו נותנים אותן: <b>ושל ראש חדש</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>על כרכוב המזבח.</b> בגמרא מפרש:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אינן נוהגין אלא בפני הבית.</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקלים משום דצורך קרבן נינהו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכיון שאין קרבן אין שקלים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וביכורים דכתיב ראשית בכורי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדמתך תביא בית ה' אלהיך בזמן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיש בית יש ביכורים אין בית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אין ביכורים: <b>אבל מעשר דגן</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> נוהגין בפני הבית",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקדושת הארץ לא בטלה: <b>מעשר</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בהמה.</b> צריך להפריש העשירי:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המקדיש שקלים וביכורים.</b> בזמן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הזה: <b>ביכורים אינן קדש.</b> דכתיב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהו בהדיא תביא בית ה' אין שם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביכורים חל עליהן שלא בפני",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבית: גמ' <b>מי קודם.</b> בהקרבתן",
      "gemara_segment_ids": [
        2,
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אם שתיהן לפניו: <b>חייליה דרבי ירמיה.</b> כלומר כוחו וראייתו דר\"י מהא: <b>שירו של ר\"ח קודם.</b> וסבר ר\"י דה\"ה קרבן ר\"ח קודם:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>א\"ר יוסי.</b> שאני התם דלכך שיר של ר\"ח קודם כדי לפרסם שהוא ר\"ח אבל קרבן שבת קודם לר\"ח: <b>הא שקלים קדשי.</b> מודה ר\"ש אם",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אומר ביכורים קדש שהן קדש: <b>הגר בזמן הזה.</b> אע\"ג דליכא מקדש צריך שיפריש רובע דינר לקינו דלכשיבנה ב\"ה יביא קן דגר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צריך קרבן ובפחות מרובע לא מצי להפריש דאין מצוי קן בפחות מרובע: <b>מפני התקלה.</b> שמא יהנה ממנו: <b>ואין מחרימין.</b> דחרם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוא ק\"ק דכתיב כל חרם קדש וגו': <b>הבהמה תעקר.</b> דלא ליתי בה לידי תקלה: <b>והיא מתה מאיליה.</b> ברעב: <b>עבר והקדיש.</b> מהו שיהיה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קדש: <b>הכא.</b> גבי קן של גר את אמר אם עבר וקדשו קדש והכא גבי שקלים את אמר לא קדשו ולר\"ש בן יהודה דלעיל פריך: <b>א\"ל</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>תמן.</b> גבי שקלים אין מקדישין לכתחלה דהוה לה מתרומה ישינה שמא יעבור השנה ומתקנת חכמים דאפי' בדיעבד לא קדשי: <b>ה\"ג</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>האי ישנה היא לגבי הקדשות אחרים וקינו של גר ח\"צ שיהיה מן החדש.</b> הלכך אם הקדיש קדוש בדיעבד: ופריך <b>ויניח עד שיבנה</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ב\"ה.</b> גם בשקלים יניח עד בנין ב\"ה ותהיה חדשה: <b>ומשני שמא יבנה הבית כבראשונה.</b> בניסן ותתרום התרומה אז ומה שנדר כבר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ה\"ל ישנה: <b>והכא.</b> גבי קינו של גר מה אית לך למיחש הלכך קדוש: <small>הדרן עלך פרק כל הרוקין וסליקא לה מסכת שקלים</small>",
      "gemara_segment_ids": [
        5
      ]
    }
  ],
