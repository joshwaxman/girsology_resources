  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בחמשה עשר שוחט בה מיד נמצאה קשורה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לסכין הרי היא כסכין <b>גמ׳</b> רבי אבין בשם",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יהושע בן לוי קצרן של נכרים היה שם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי חנינה ערודות היו נוחרין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בירושלים והיו עולי רגלים משתקעין בדם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד ארכובותיהן ובאו לפני חכמים ולא אמרו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להן דבר (רבי שמעון בר אבא בשם רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנינה קצרן של נכרים היה שם) רבי סימון",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי יהושע בן לוי מעשה בפרדה משל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית רבי שמתה וטהרו את דמיה משום נבילה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אלעזר שאיל לרבי סימון עד כמה ולא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אגיביה שאיל לרבי יהושע בן לוי אמר ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד רביעית טהור יותר מיכן טמא ובאש לרבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעזר דלא חזר ליה רבי סימון שמועתא רב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביבי הוה יתיב מתני הדין עובדא אמר ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יצחק בר ביסנא עד כמה אמר ליה עד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רביעית טהור יותר מיכן טמא ובעט ביה אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה רבי זריקא בגין דהוה שאיל לך את",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעיט ביה אמר ליה בגין דלא הוות דעתי בי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמר רבי חנין והיו חייך תלואים לך מנגד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זה שהוא לוקח לו חטין לשנה ופחדת לילה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויומם זה שהוא לוקח מן הסדקי ולא תאמין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחייך זה שהוא לוקח מן הפלטור ואנא סמיך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפלטירא מאי כדון העיד רבי יהושע בן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פתורה על דם נבילות שהוא טהור מהו טהור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טהור מלהכשיר הא ליטמות מטמא תמן תנינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דם השרץ מטמא כבשרו מטמא ואינו מכשיר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואין לנו כיוצא בו ואין לנו כיוצא בו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשיעור טומאתו אבל דמו מטמא כבשרו אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסי פליגי בה תרין אמוראין חד אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טמא וחד אמר טהור מאן דאמר טמא כרבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה ומאן דאמר טהור כרבי יהושע בן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פתורה אמר ליה רב אבדומה דמן נחותה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויאות דרבי יהודה מוריינה דבי נשיאה הוה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל הרוקין וכו׳ לא כן אמר רבי אבהו בשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסי בן חנינה לא גזרו על הרוקין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבירושלים הא איתמר עליה רבי אבין בשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יהושע בן לוי קצרן של גוים היה שם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשאר ימות השנה הטמאין מהלכין שיבולת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והטהורין מהלכין מן הצד והטהורין מהלכין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סתם והטמאים אומרין להן פרושו בשעת הרגל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הטהורים מהלכין שיבולת והטמאין מהלכין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הצד הטמאין מהלכין סתם והטהורין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים להן פרושו וכל הכלים הנמצאים כו׳",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא כן אמר רבי אבהו בשם רבי יוחנן לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גזרו על הכלים שבירושלם מכיון שנמצאו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרך ירידה לבית הטבילה נעשו הוכיח אבא",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שאול היה קורא אותן ציפורין מאן דאמר ציפורין שהיה דומה לציפורין מאן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "דאמר מריצה שמריצה את האבן לבית הקברות קופיץ וכו׳ תני הסכין קשורה לה",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הרי זו כמותה <b>הלכה ב <big>מתני׳</big></b> פרוכת שנטמאת בולד הטומאה – מטבילין אותה",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בפנים, ומכניסין אותה מיד. ושנטמאת באב הטומאה מטבילין אותה בחוץ",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ושוטחין אותה בחיל מפני שהיא צריכה הערב שמש אם היתה חדשה שוטחין אותה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "על גג האיצטבא כדי שיראה העם את מלאכתה שהיא נאה רבן שמעון בן גמליאל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אומר משום רבי שמעון בן הסגן פרוכת עוביה טפח על שבעים ושתים נימים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "נארגת על כל נימה ונימה עשרים וארבעה חוטין ארכה ארבעים אמה ורחבה עשרים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ומשמונים ושתים רבוא היתה נעשית ושתים עושין בכל שנה ושלש מאות כהנים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מטבילין אותה <b>גמ׳</b> אילו אמר חוט אחד כפול לשנים שזור לשלשה משזר לששה",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ארבע מכאן הא עשרים וארבעה תני שלשים ושתים אילו אמר חוט אחד כפול לשנים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שזור לארבע משזר לשמונה ארבע מכאן הא תלתין ותרין תנא ארבעים ושמונה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אילו אמר חוט אחד כפול לשנים קליעה לשלשה שזור לששה משזר לשנים עשר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ארבעה מיכן הא ארבעים ותמניא כתוב אחד אומר מעשה רוקם וכתוב אחד אומר",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מעשה חושב מעשה רוקם פרצוף אחד מעשה חושב שני פרצופות רבי יהודה ורבי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "נחמיה חד אמר מעשה רוקם ארי מכאן וארי מכאן מעשה חושב ארי מכאן וחלק",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מכאן וחרנה אמר מעשה רוקם ארי מכאן וחלק מכאן מעשה חושב ארי מכאן ונשר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "מכאן בשמונים ושתים רבוא היתה נעשית וכו׳ רבי יצחק בר ביזנא בשם שמואל",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "גוזמא תמן תנינן פעמים היה עליה כשלש מאות כור רבי יוסי בי רבי בון בשם",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "שמואל גוזמא <b>הלכה ג <big>מתני׳</big></b> בשר קדשי קדשים שנטמא, בין באב הטומאה בין",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בולד הטומאה, בין בפנים בין בחוץ, בית שמאי אומרים: הכל ישרף בפנים, חוץ",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "משנטמא באב הטומאה בחוץ. בית הלל אומרים: הכל ישרף בחוץ, חוץ משנטמא",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בולד הטומאה בפנים.",
      "segment_ids": [
        11
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "גמ' <b>קצרן של עכו\"ם.</b> כובס של עכו\"ם היה שם בשוק העליון וחכמים גזרו על העכו\"ם שיהו כזבים לכל דבריהם ורוקו טמא:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ערודות.</b> ערודי היער היו נוחרין לצורך אריות של מלך: <b>ר\"ש בר אבא בשם ר\"ח קצרן של עכו\"ם היה שם.</b> ל\"ג ליה הכא: <b>וטהרו</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>את דמיה משום נבילה.</b> כל הסוגיא פירשתי לעיל דף י\"ב: <b>לא כך וכו'.</b> אמתני' פריך לא גזרו על הרוקין שבירושלים ולמה גזרו",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "על הרוקין שבשוק העליון: <b>שיבולת.</b> היינו באמצע: ופריך <b>לא כן וכו'.</b> ובמתני' תנן חוץ מדרך ירידתן לבית הטבילה: <b>ומשני</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מכיון וכו' נעשו הוכיח.</b> יש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוכחה שהן טמאין ודאי ולא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום גזרה: <b>שהוא דומה</b>",
      "gemara_segment_ids": [
        3,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לציפורן.</b> שעשויה כדמות צפורן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של אדם: <b>תני הסכין קשורה לו.</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אם נמצא הסכין קשור בקופיץ",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרי זה כקופיץ ובזה ובזה שונה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומטביל ופליג אמתני' ויותר",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נראה לי דברייתא לפרושי",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למתני' קאתי דהכי קאמר נמצאת",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סכין סתמא קשורה עם סכין אחרת",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ידועה הרי הוא כסכין ידועה אם",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טמאה טמאה ואם טהורה טהורה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכן פי' הרמב\"ם בפי' המשנה:",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' <b>פרוכת שנטמאת בולד</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הטומאה.</b> שנגעה במשקין טמאין",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחכמים גזרו על המשקין",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמטמאין כלים גזרה משום משקה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דזב וזבה: <b>מטבילין אותה</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בפנים.</b> ואינה טעונה שילוח חוץ",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למחנה שכינה כיון שלא נטמאת",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אלא בולד הטומאה ומכניסין",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותה מיד שאינה טעונה הערב",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמש: <b>מטבילין אותה בחוץ.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דטעונה שילוח: <b>ושוטחין אותה</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בחיל.</b> חוץ לעזרה: <b>נימין.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליצי\"ס בלע\"ז: <b>כ\"ד חוטין.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש בגמ': <b>ארכה ארבעים ורחבה</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עשרים.</b> כמידת פתח האולם שהיה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גובהו ארבעים ורחבו עשרים:",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>פ\"ב רבוא.</b> דינרי זהב נעשית:",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' <b>אילו אמר חוט.</b> גבי מלאכת",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפרכת הייתי אומר שיהא כל חוט",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כפול לשנים: <b>שזור.</b> אילו נאמר",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוט שזור הייתי אומר שיהא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוטין כפול לשלשה השתא דכתיב",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משזר ילפינן מיניה דבעינן",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוטין כפול ששה דהיינו כפל",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משזר: <b>ארבעה.</b> כלומר וארבעה",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מינין היו בו תכלת וארגמן",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותולעת שני ושש משזר כל אחד",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוטין כפול שש מכאן שהיה כפול",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כ\"ד: <b>מעשה רוקם.</b> גבי מסך הפתח",
      "gemara_segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב וגבי פרכת כתיב מעשה",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חושב מאי בינייהו: <b>ר\"י ור'</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נחמיה.</b> פליגי איך היו מעשה",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חושב ומעשה רוקם והאיך היו",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שני פרצופין: <b>גוזמא.</b> מילתא",
      "gemara_segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלמא ולאו דוקא: <b>תמן תנינן.</b>",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במסכת תמיד פ\"ב החלו מעלין",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באפר ע\"ג תפוח ותפוח היה",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באמצע המזבח ולפעמים עליו",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשלש מאות כור אפר:",
      "gemara_segment_ids": [
        10
      ]
    }
  ],
