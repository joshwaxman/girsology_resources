  "page_note": {
    "role": "yerushalmi",
    "height": 72,
    "he": "מסכת שקלים — תלמוד ירושלמי. אין לה גמרא בבלית.",
    "en": "Shekalim is Talmud YERUSHALMI. There is no Bavli on this tractate.",
    "detail_he": "הדף שלפניך הוא הירושלמי כפי שהוא נדפס בש״ס במקום הבבלי, עם קרבן העדה; מקום הריבב״ן שמור וריק.",
    "detail_en": "This page sets the Yerushalmi as the printed Shas sets it in the Bavli's place, with Korban HaEdah; the Rivevan's column is held open and empty.",
    "source_ref": "Jerusalem Talmud Shekalim"
  }
}
