  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "בחמשה עשר שוחט בה מיד נמצאה קשורה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לסכין הרי היא כסכין <b>גמ׳</b> רבי אבין בשם",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יהושע בן לוי קצרן של נכרים היה שם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי חנינה ערודות היו נוחרין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בירושלים והיו עולי רגלים משתקעין בדם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד ארכובותיהן ובאו לפני חכמים ולא אמרו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להן דבר (רבי שמעון בר אבא בשם רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנינה קצרן של נכרים היה שם) רבי סימון",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי יהושע בן לוי מעשה בפרדה משל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית רבי שמתה וטהרו את דמיה משום נבילה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אלעזר שאיל לרבי סימון עד כמה ולא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אגיביה שאיל לרבי יהושע בן לוי אמר ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד רביעית טהור יותר מיכן טמא ובאש לרבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעזר דלא חזר ליה רבי סימון שמועתא רב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביבי הוה יתיב מתני הדין עובדא אמר ליה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יצחק בר ביסנא עד כמה אמר ליה עד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רביעית טהור יותר מיכן טמא ובעט ביה אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה רבי זריקא בגין דהוה שאיל לך את",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעיט ביה אמר ליה בגין דלא הוות דעתי בי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמר רבי חנין והיו חייך תלואים לך מנגד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זה שהוא לוקח לו חטין לשנה ופחדת לילה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויומם זה שהוא לוקח מן הסדקי ולא תאמין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחייך זה שהוא לוקח מן הפלטור ואנא סמיך",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפלטירא מאי כדון העיד רבי יהושע בן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פתורה על דם נבילות שהוא טהור מהו טהור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טהור מלהכשיר הא ליטמות מטמא תמן תנינן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דם השרץ מטמא כבשרו מטמא ואינו מכשיר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואין לנו כיוצא בו ואין לנו כיוצא בו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כשיעור טומאתו אבל דמו מטמא כבשרו אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסי פליגי בה תרין אמוראין חד אמר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "טמא וחד אמר טהור מאן דאמר טמא כרבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה ומאן דאמר טהור כרבי יהושע בן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פתורה אמר ליה רב אבדומה דמן נחותה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויאות דרבי יהודה מוריינה דבי נשיאה הוה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל הרוקין וכו׳ לא כן אמר רבי אבהו בשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסי בן חנינה לא גזרו על הרוקין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבירושלים הא איתמר עליה רבי אבין בשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יהושע בן לוי קצרן של גוים היה שם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשאר ימות השנה הטמאין מהלכין שיבולת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והטהורין מהלכין מן הצד והטהורין מהלכין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סתם והטמאים אומרין להן פרושו בשעת הרגל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הטהורים מהלכין שיבולת והטמאין מהלכין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הצד הטמאין מהלכין סתם והטהורין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומרים להן פרושו וכל הכלים הנמצאים כו׳",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא כן אמר רבי אבהו בשם רבי יוחנן לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גזרו על הכלים שבירושלם מכיון שנמצאו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרך ירידה לבית הטבילה נעשו הוכיח אבא",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאול היה קורא אותן ציפורין מאן דאמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ציפורין שהיה דומה לציפורין מאן דאמר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מריצה שמריצה את האבן לבית הקברות קופיץ",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכו׳ תני הסכין קשורה לה הרי זו כמותה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>הלכה ב <big>מתני׳</big></b> פרוכת שנטמאת בולד הטומאה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "– מטבילין אותה בפנים, ומכניסין אותה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיד. ושנטמאת באב הטומאה מטבילין אותה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בחוץ ושוטחין אותה בחיל מפני שהיא צריכה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הערב שמש אם היתה חדשה שוטחין אותה על",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גג האיצטבא כדי שיראה העם את מלאכתה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיא נאה רבן שמעון בן גמליאל אומר משום",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמעון בן הסגן פרוכת עוביה טפח על",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבעים ושתים נימים נארגת על כל נימה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונימה עשרים וארבעה חוטין ארכה ארבעים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "אמה ורחבה עשרים ומשמונים ושתים רבוא היתה נעשית ושתים עושין בכל שנה",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ושלש מאות כהנים מטבילין אותה <b>גמ׳</b> אילו אמר חוט אחד כפול לשנים שזור",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "לשלשה משזר לששה ארבע מכאן הא עשרים וארבעה תני שלשים ושתים אילו אמר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "חוט אחד כפול לשנים שזור לארבע משזר לשמונה ארבע מכאן הא תלתין ותרין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "תנא ארבעים ושמונה אילו אמר חוט אחד כפול לשנים קליעה לשלשה שזור לששה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "משזר לשנים עשר ארבעה מיכן הא ארבעים ותמניא כתוב אחד אומר מעשה רוקם",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "וכתוב אחד אומר מעשה חושב מעשה רוקם פרצוף אחד מעשה חושב שני פרצופות",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "רבי יהודה ורבי נחמיה חד אמר מעשה רוקם ארי מכאן וארי מכאן מעשה חושב",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ארי מכאן וחלק מכאן וחרנה אמר מעשה רוקם ארי מכאן וחלק מכאן מעשה חושב",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ארי מכאן ונשר מכאן בשמונים ושתים רבוא היתה נעשית וכו׳ רבי יצחק בר",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "ביזנא בשם שמואל גוזמא תמן תנינן פעמים היה עליה כשלש מאות כור רבי יוסי",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בי רבי בון בשם שמואל גוזמא <b>הלכה ג <big>מתני׳</big></b> בשר קדשי קדשים שנטמא, בין באב",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "הטומאה בין בולד הטומאה, בין בפנים בין בחוץ, בית שמאי אומרים: הכל ישרף",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "בפנים, חוץ משנטמא באב הטומאה בחוץ. בית הלל אומרים: הכל ישרף בחוץ, חוץ",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "משנטמא בולד הטומאה בפנים.",
      "segment_ids": [
        11
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' <b>קצרן של עכו\"ם.</b> כובס של",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עכו\"ם היה שם בשוק העליון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וחכמים גזרו על העכו\"ם שיהו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כזבים לכל דבריהם ורוקו טמא:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ערודות.</b> ערודי היער היו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נוחרין לצורך אריות של מלך:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ר\"ש בר אבא בשם ר\"ח קצרן של</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עכו\"ם היה שם.</b> ל\"ג ליה הכא:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וטהרו את דמיה משום נבילה.</b> כל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הסוגיא פירשתי לעיל דף י\"ב:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לא כך וכו'.</b> אמתני' פריך לא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גזרו על הרוקין שבירושלים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמה גזרו על הרוקין שבשוק",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העליון: <b>שיבולת.</b> היינו באמצע:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופריך <b>לא כן וכו'.</b> ובמתני'",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תנן חוץ מדרך ירידתן לבית",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הטבילה: <b>ומשני מכיון וכו'</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נעשו הוכיח.</b> יש הוכחה שהן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טמאין ודאי ולא משום גזרה:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שהוא דומה לציפורן.</b> שעשויה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כדמות צפורן של אדם: <b>תני</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הסכין קשורה לו.</b> אם נמצא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הסכין קשור בקופיץ הרי זה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כקופיץ ובזה ובזה שונה ומטביל",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופליג אמתני' ויותר נראה לי",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דברייתא לפרושי למתני' קאתי",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהכי קאמר נמצאת סכין סתמא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קשורה עם סכין אחרת ידועה הרי",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא כסכין ידועה אם טמאה טמאה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואם טהורה טהורה וכן פי'",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרמב\"ם בפי' המשנה: מתני'",
      "gemara_segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>פרוכת שנטמאת בולד הטומאה.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנגעה במשקין טמאין שחכמים",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גזרו על המשקין שמטמאין כלים",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גזרה משום משקה דזב וזבה:",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מטבילין אותה בפנים.</b> ואינה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעונה שילוח חוץ למחנה שכינה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כיון שלא נטמאת אלא בולד",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הטומאה ומכניסין אותה מיד",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינה טעונה הערב שמש:",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מטבילין אותה בחוץ.</b> דטעונה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שילוח: <b>ושוטחין אותה בחיל.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוץ לעזרה: <b>נימין.</b> ליצי\"ס",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלע\"ז: <b>כ\"ד חוטין.</b> מפרש בגמ':",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ארכה ארבעים ורחבה עשרים.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כמידת פתח האולם שהיה גובהו",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ארבעים ורחבו עשרים: <b>פ\"ב</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רבוא.</b> דינרי זהב נעשית: גמ'",
      "gemara_segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אילו אמר חוט.</b> גבי מלאכת",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפרכת הייתי אומר שיהא כל חוט",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כפול לשנים: <b>שזור.</b> אילו נאמר",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוט שזור הייתי אומר שיהא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוטין כפול לשלשה השתא דכתיב",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משזר ילפינן מיניה דבעינן",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוטין כפול ששה דהיינו כפל",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משזר: <b>ארבעה.</b> כלומר וארבעה",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מינין היו בו תכלת וארגמן",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ותולעת שני ושש משזר כל אחד",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוטין כפול שש מכאן שהיה כפול",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כ\"ד: <b>מעשה רוקם.</b> גבי מסך הפתח",
      "gemara_segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כתיב וגבי פרכת כתיב מעשה",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חושב מאי בינייהו: <b>ר\"י ור'</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נחמיה.</b> פליגי איך היו מעשה",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חושב ומעשה רוקם והאיך היו",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שני פרצופין: <b>גוזמא.</b> מילתא",
      "gemara_segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעלמא ולאו דוקא: <b>תמן תנינן.</b>",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במסכת תמיד פ\"ב החלו מעלין",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באפר ע\"ג תפוח ותפוח היה",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באמצע המזבח ולפעמים עליו",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כשלש מאות כור אפר:",
      "gemara_segment_ids": [
        10
      ]
    }
  ],
