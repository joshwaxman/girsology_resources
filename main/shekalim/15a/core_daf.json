  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "לכך נחלוק בין נסכי עגל לנסכי שור תלמוד",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לומר ככה יעשה לשור האחד מגיד שלא חלק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בין נסכי עגל לנסכי שור או לאיל למה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאמר שהיה בדין אם מצאנו שחלק בין נסכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן שנה לנסכי בן שנתיים לכך נחלוק בין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נסכי שנתיים לנסכי שלש תלמוד לומר או",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאיל האחד או לשה בכבשים למה נאמר שהיה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדין אם מצאנו שחלק בין ניסכי כבש לנסכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "איל לכך נחלוק בין נסכי כשבה לנסכי רחל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלמוד לומר או לשה בכבשים או בעזים למה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נאמר שהיה בדין אם מצאנו שחלק בין ניסכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כבש לנסכי איל לכך נחלוק בין נסכי גדי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לנסכי תיש תלמוד לומר או בעזים הקיש קטן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבעזים לגדול שבתישים מה זה בשלשת לוגין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אף זה בשלשת לוגין ושם היום כתוב כו׳",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הגע בעצמך שזייג אותו היום שם משמר היה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כתוב עליו הגע בעצמך שזייג אותו המשמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שם היום שם שבת שם חודש היה כתוב עליהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו רוצה לזייג אין מצוי לזייג <b>הלכה ד</b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b><big>מתני׳</big></b> שתי לשכות היו במקדש, אחת לשכת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חשאין ואחת לשכת הכלים. לשכת חשאין –",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יראי חטא נותנין לתוכה בחשאי, ועניים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בני טובים מתפרנסין מתוכה בחשאי. לשכת",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכלים כל מי שהוא מתנדב כלי זורקו לתוכה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואחת לשלשים יום הגזברין פותחין אותה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכל כלי שמצאו בו צורך לבדק הבית מניחין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו והשאר נמכרין ודמיהן נופלין לבדק",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבית <b>גמ׳</b> רבי יעקב בר אידי ורבי יצחק בר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נחמן הוון פרנסים והוון יהבין לרבי חמא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבוי דרבי יהושעיה דינר והוא יהיב ליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לחורנין רבי זכריה חתניה דרבי לוי היו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכל מליזין עליו אמרין דלא צריך והוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נסב מן דדמך בדקין ואשכחין דהוה מפליג",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה לחורנין רבי חיננא בר פפא הוה מפליג",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מצוה בליליא חד זמן פגע ביה רבהון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרוחייא אמר ליה לא כן אלפן רבי לא תשיג",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גבול רעך אמר ליה ולא כן כתיב מתן בסתר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יכפה אף והוה מסתפי מיניה וערק מן קומוי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יונה אשרי נותן לדל אין כתיב",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאן אלא אשרי משכיל אל דל זה שהוא מסתכל",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במצוה היאך לעשותה כיצד היה רבי יונה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עושה כשהיה רואה עני בן טובים שירד",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנכסיו היה אומר לו בני בשביל ששמעתי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנפלה לך ירושה ממקום אחר טול ואת פורע",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן דהוה נסיב הוה אמר ליה מתנה היא לך",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייא בר אדא אית הוה סבין ביומינון מאן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דהוה יהיב להון מבין ריש שתא לצומא רבא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוון נסבין מן בתר כן לא הוון נסבין",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרין דשתן גבן נחמיה איש שיחין פגע בו",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ירושלמי אחד אמר ליה זכה עמי חדא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תרנגולתא אמר ליה הא לך טומיתיה דקופד",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וזבין קופד ואכיל ומית והיה צווח ואמר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בואו וספדו להרוגו של נחמיה נחום איש גם",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זו היה מוליך דורון לבית חמיו פגע בו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מוכה שחין אחד אמר ליה זכה עמי ממה דאית",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גבך אמר ליה מיחזור חזר ואשכחיה מית",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והוה אמר לקיבליה עינייא דחמינך ולא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יסבון לך יסתמיין ידיה דלא פשטן מיתן לך",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יתקטעון רגלייא דלא רהטן למיתן לך",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יתברון ומטתיה כן סליק לגביה רבי עקיבא",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר ליה אי לי שאני רואה אותך בכך אמר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה אי לי שאין אני רואה אותך בכך אמר",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה מה את מקללני אמר ליה ומה את מבעט",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביסורין רבי הושעיה רבה הוה רביה דבריה",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חד סגי נהורא והוה יליף אכול עימיה בכל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יום חד זמן הוה ליה אורחין ולא מטא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מיכול עימיה ברמשא סליק לגביה אמר ליה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לא יכעוס מרי עלי בגין דהוה לי אורחין",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יומא דין דאמרית דלא ליבזוי ביקרא דמרי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יומא דין בגין כן לא אכלית עם מרי יומא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דין אמר ליה אתה פייסתה למאן דמתחמי ולא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חמי דין דחמי ולא מתחמיים יקבל פיוסך",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר ליה הדא מנא לך אמר ליה מרבי אליעזר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן יעקב דרבי אליעזר בן יעקב עאל חד",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דסגי נהורא לקרתיה יתב ליה רבי אליעזר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן יעקב לרע מיניה דיימרון דאילולי דהוה",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר נשא רבא לא יתב ליה רבי אליעזר בן",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יעקב לרע מיניה עבדין ליה פרנסה דאיקר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר לון מהו הכין אמרון ליה רבי אליעזר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן יעקב יתב לרע מינך וצלוי עלוי הדא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צלותא אתה גמלתה חסד למאן דמתחמי ולא",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חמי דין דחמי ולא מתחמי יגמול יתך חסד",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חמא בר חנינה ורבי הושעיא הוו",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מטיילין באילין כנישתא דלוד אמר רבי חמא",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר חנינא לרבי הושעיא כמה ממון שיקעו",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבותי כאן אמר ליה כמה נפשות שיקעו",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אבותיך כאן לא הוה אית בני נש דילעון",
      "segment_ids": [
        10
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באורייתא רבי אבון עבד אילין תרעייה",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דסדרא רבא אתא רבי מנא לגביה",
      "segment_ids": [
        11
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' ופריך <b>ולבן עזאי חוטא דל</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>למה.</b> ליה חותם בפני עצמו היה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לו להביא חותם גדי. ומשני היה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מביא לוגו עמו. כדי שיביא גם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לוג שמן שצריך המצורע למתן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תנוך ובהונות והמותר נאכל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכהנים כדין קדשי הקדשים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וצריך שיהיה על טהרת הקדש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפיכך נתנו לו חותם בפני עצמו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא נסכי גדי וד' לוג שמן.",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברם כרבנן. אבל לרבנן לא היו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותנין לחוטא דל אלא חותם של",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גדי ולוג שמן למתן בהונותיו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה מביא מביתו קשיא א\"כ אף",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחוטא עשיר לא היו צריכין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתקן חותם בפני עצמו שיכולין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליתן לו ג' חותמות גדי: <b>נסכי</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>רחל.</b> בכמה שאינן נזכרים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתני': <b>ומשני מן מה דתני</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>במתני' גדי משמש וכו'.</b> שמעינן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דנסכי רחל כנסכי גדי: <b>שהיה</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בדין.</b> שיהא חילוק בין נסכי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עגל לנסכי שור: <b>בין נסכי כבש.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוא בן שנה לנסכי איל שהוא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בן שתי שנה: <b>תלמוד לומר ככה</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יעשה לשור האחד.</b> כל נסכי שור",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחד הן ושור בן יומו קרוי שור",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ורש\"י במנחות פי' דמיתורא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלשון קדריש שכבר כתיב והקריב",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על בן הבקר מנחה וכן דריש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכולן והראשון נ\"ל: <b>תלמוד</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לומר או לאיל הא'.</b> כיון שהוא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איל כל נסכיו אחד הן בין זקן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "או שהוא בן שלשה עשר חדש:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תלמוד לומר או לשה בכשבים.</b> כל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שה שבכשבים שוות הם בנסכיהם:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בין נסכי גדי.</b> קטן לתיש גדול:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ופריך <b>הגע עצמך.</b> שהצניעו עד",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיבא היום ההוא בשבת הבאה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומאי מהני שכתוב עליו שם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היום: <b>ומשני שם משמר.</b> של אותו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבת נמי היה כתוב עליו: ופריך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הגע עצמך.</b> שימתין חצי שנה עד",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיבוא זמן המשמר שנית: <b>ומשני</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שם היום.</b> כמה ימים בשבת: <b>שם</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>השבת.</b> כמה שבת בחדש: <b>שם החדש</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היה כתוב עליהן.</b> וגם שם המשמר",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו מצוי שיזדמן שיהיו כולם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביום א' מכוון אלא להרבה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנים: מתני' <b>לשכת חשאים.</b> על",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שם שהנותנין בתוכה נותנין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסתר והמתפרנסים ממנה נוטלין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסתר: <b>ללשכת בדק הבית.</b> ללשכה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנותנים בה כל קדשי בדק הבית:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' <b>הוון פרנסין.</b> היו גבאי",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צדקה: <b>והוה יתיב ליה.</b> לאחרים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיו העניים מתביישים לקבל",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהגבאי: <b>מליזין עליו.</b> מדברין",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו ואמרו שאינו צריך ליטול",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צדקה ונוטל: <b>מן דדמך.</b> כשמת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בדקו ומצאו שלא נהנה ממה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שקיבל אלא היה נותן לאחרים:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הוה מפליג וכו'.</b> היה מחלק",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צדקה בלילה ומוליכה אצל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העניים שלא לביישן: <b>חד זמן.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פעם אחת פגע בו שר של רוחות",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וא\"ל לא כן למדתנו רבינו לא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תסיג גבול רעך ולילה גבול של",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רוחות לילך ואין לבני אדם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לצאת אז: <b>מתן בסתר יכפה אף.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויציאתו זו כדי ליתן צדקה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסתר ראוי הוא שיסתיר עצמו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפניו: <b>והוה.</b> הרוח מתיירא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ממנו שלא יכפהו וברח מלפניו:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>זהו שמסתכל במצות.</b> הצדקה האיך",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעשותה שלא יתבייש העני: <b>טול</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואתה פורע.</b> כשתקבל ירושתך:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ה\"ג א\"ל יהא לך במתנה אר\"ח בר</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אדא וכו'.</b> וה\"פ והוה א\"ל אם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא יהיה לך לשלם הרי הוא לך",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתנה כי היה חושש אולי יתאמץ",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העני לפרוע לו כשיראה שלא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפלה לו ירושה או כדי שלא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהיה לעני כגזל לפי דעתו: <b>אית</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הוה סבין וכו'.</b> היו זקנים",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בימינו כל מה שהיו נותנין להם",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מר\"ה עד יה\"כ היו מקבלין ומשם",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואילך לא היו מקבלין: <b>אמרי</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דשתן גבן.</b> מה שאנו צריכין לכל",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השנה כבר הוא אצלינו שהיו",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותנין להם בימים אלו די",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרנסתן לכל השנה כך נ\"ל והיפה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מראה פי' בזה פירושים דחוקים:",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>זכה עמי.</b> עשה עמי צדקה ותן לי",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תרנגולא חדא: <b>ה\"ג א\"ל הא לך</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>טימיתא וזיל זבין קופר.</b> וה\"פ",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הא לך מטבע זו וקנה לך בשר:",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואכל.</b> בשר שור ומת: <b>להרוגו של</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נחמיה.</b> שאילו נתן לו בשר",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תרנגולת שהיה רגיל בו היה חי:",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>א\"ל מיחזור.</b> כשיחזור יתן לו",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאכול: <b>אמר.</b> לנגד המת עיניו",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שראו אותו ולא קבלוהו יהיו",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "סתומין: <b>ידים.</b> דלא פשטו עצמן ליתן לעני יתקטעון: <b>רגלים.</b> שלא רצו לקראתך ליתן לך",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ישברו: <b>ומטתיה כן.</b> ועלתה לו כך בעיניו וידיו ורגליו: <b>א\"ל.</b> רבי עקיבא מה אתה",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקללני: <b>א\"ל.</b> נחום ולמה אתה מבעט ביסורין דקאמרת אוי לי: <b>הוה רביה דבריה.</b> מלמד של",
      "gemara_segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בנו היה סגי נהור והיה רגיל לאכול עם רבי הושעיא בכל יום: <b>חד זמן וכו'.</b> פעם אחת",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היה לו לר\"ה אורחים ולא קרא לסגי נהור. שיאכל עמו: <b>ברמשא.</b> לערב: <b>א\"ל.</b> ר\"ה לא",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יכעוס אדוני עלי שלא זמנתיך שתאכל עמי היום לפי שהיו אורחין אצלי ואמרתי שלא",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לזלזל בכבודך שיביישוך הלכך לא אכלתי עמך יום הזה: <b>א\"ל אתה פייסת.</b> למי שנראה",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ואינו רואה אותו שרואה ואינו נראה והוא הקדוש ברוך הוא יקבל פיוסך ותפלתך: <b>א\"ל.</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מנ\"ל הא לברך כן: <b>מר\"א בן יעקב.</b> מעובדא דראב\"י: <b>דראב\"י.</b> נכנס סגי נהור לעירו ישב",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ראב\"י למטה ממנו שיאמרו הבריות אילו לא היה סגי נהור זה גברא רבא לא הוה ראב\"י",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יושב למטה ממנו ועשו לו פרנסה וצדקה יקרה: <b>אמר להון.</b> הסגי נהור מהו זה שנותנין לי",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כל כך: <b>וצלי עלוי.</b> והתפלל סגי נהור זה על ראב\"י האי תפילה: <b>דלמא.</b> מעשה: <b>הוון</b>",
      "gemara_segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מטיילין.</b> בבתי כנסיות שבלוד: <b>כמה ממון שיקעו אבותי בכאן.</b> שהם בנו בתי כנסיות אלה",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משלהם: <b>כמה נפשות שיקעו בבנין הזה.</b> וכי לא היו בני אדם שיעסקו בתורה והיה ראוי",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "להוציא ממון זה עליהם לפרנסתם ונראה שהיה ידוע לר' הושעיא שהיו עניים בני תורה",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בזמן ההוא שביטלו תורתם מדוחק הפרנסה והיה ראוי לאבותיו של ר' חמא לפרנסם ולא",
      "gemara_segment_ids": [
        10
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יקפידו על הציור של בנין בה\"כ:",
      "gemara_segment_ids": [
        10
      ]
    }
  ],
