  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר ליה חמי מאי עבדית אמר ליה וישכח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל את עושהו ויבן היכלות לא הוה בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נש דילעון באורייתא תני קדשי המזבח",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מוציאין את הראוי להן מקדשי בדק הבית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין קדשי בדק הבית מוציאין את הראוי להן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקדשי מזבח והא תנינן כלי שמצאו בו צורך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבדק הבית מניחין אותו והשאר נמכרין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודמיהן נופלין לבדק הבית אמר רבי חזקיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כיני מתניתא ללשכת בדק הבית הדרן עלך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרק אלו הן הממונין <b>הלכה א <big>מתני׳</big></b> שלשה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשר שופרות, שלשה עשר שולחנות, שלש עשרה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השתחוויות היו במקדש. של בית רבן גמליאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושל בית רבי חנניה סגן הכהנים היו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משתחוים בארבע עשרה והיכן היתה יתירה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כנגד דיר העצים שכן מסורת בידן מאבותיהן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ששם הארון נגנז מעשה בכהן אחד שהיה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתעסק וראה את הרצפה שהיא משונה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחברותיה בא ואמר לחבירו לא הספיק לגמור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הדבר עד שיצתה נשמתו וידעו בייחוד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ששם הארון גנוז <b>גמ׳</b> תני השופרות הללו",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עקומות היו צרות מלמעלן ורחבות מלמטן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני הרמאין תני בשם רבי אלעזר הארון",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גלה עמהן לבבל מאי טעמא לא יותר דבר אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ה׳ אין דבר אלא שהדיברות לתוכו וכן הוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר ולתשובת השנה שלח המלך נבוכדנצר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויביאהו בבלה עם כלי חמדת בית ה׳ איזהו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלי חמדת בית ה׳ זה הארון רבי שמעון בן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לקיש אומר במקומו היה הארון נגנז הדא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא דכתיב ויאריכו הבדים ויראו ראשי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבדים אל הקדש אל פני הדביר ולא יראו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "החוצה כתיב ויראו ואת אמרת ולא יראו אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נראין ולא נראין בולטין ויוצאין כשני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דדי האשה ורבנן אמרי בלשכת דיר העצים",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היה הארון גנוז מעשה בכהן אחד בעל מום",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיה עומד ומפצל עצים בלשכת דיר העצים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וראה את הרצפה שהיא משתנה מחברותיה בא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואמר לחבירו בא וראה את הרצפה הזאת שהיא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משתנה מחברותיה לא הספיק לגמור את הדבר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד שיצתה נשמתו וידעו בייחוד ששם הארון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גנוז תני רבי הושעיא הקיש עליה בקורנס",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויצאת אש ושרפתו תני רבי יהודה בן לקיש",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר שני ארונות היו מהלכין עם ישראל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במדבר אחד שהיתה התורה נתונה בתוכו ואחר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיו שברי לוחות נתונין בתוכו זה שהיתה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "התורה נתונה בתוכו היה מונח באהל מועד הדא הוא דכתיב וארון ברית ה׳ ומשה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לא משו מקרב המחנה זה שהיו שברי לוחות נתונין בתוכו היה נכנס ויוצא עמהן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ופעמים שהיה מתראה עמהן ורבנן אמרי ארון אחד היה ופעם אחת יצא בימי עלי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ונשבה קרייא מסייע להו לרבנן אוי לנו מי יצילנו מיד האלהים האדירים האלה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מילה דלא חמון מן יומיהון קרייא מסייע לרבי יודה בן לקיש ויאמר שאול",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לאחיה הגישה ארון האלהים והלא ארון בקרית יערים היה מה עבדון ליה רבנן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הגישה אלי הציץ קרייא מסייע לרבי יודא בן לקיש הארון וישראל ויהודה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "יושבין בסוכות",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עבד.</b> אלו הפתחים של בהמ\"ד",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגדול: <b>חמי מה דעבדית.</b> היה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משבח עצמו ראה מה שעשיתי:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וישכח ישראל וכו'.</b> טוב הוא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליתן לעניי תורה שעושין מצות",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בכל עת משיבנו בנינים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיכלות: <b>מוציאין את הראוי</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>להן מקדשי בדק הבית.</b> כגון אם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקדיש בהמה או אבנים לבדק",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבית. וצריכין אותן למזבח",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נוטלין אותן למזבח אבל הקדיש",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בהמה אפי' בעלי מומים או",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבנים למזבח אין מוציאין אותן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבדק הבית אלא ימכרו ודמיהן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נופלין לבדק הבית: <b>כלי שמצאו</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בו צורך לבד\"ה מניחין אותו.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הא ראוי למזבח מוכרין אותן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמעינן דקדשי בדק הבית אע\"פ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שראויין למזבח אין מוציאין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקדשי בדק הבית: <b>כיני מתניתא.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כן היא משנתינו כלי שמצאו בו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צורך והיינו לצורך המזבח או",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לבדק הבית ללשכת בדק הבית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מניחין אותו ומשם נוטלין אותו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למה שצריכין אותו: <small>הדרן עלך</small>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<small>פרק אלו הן הממונין</small> מתני'",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלשה עשר שופרות.</b> תיבות צרות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלמעלה ורחבות מלמטה עקומות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כעין שופר מפני הרמאים שלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יתנו ידן לתוכן להראות כאילו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותנין לתוכן ויטלו מתוכן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולקמן מפרש למה י\"ג שופרות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וי\"ג שולחנות ובאיזה מקום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מונחין: <b>י\"ג השתחוויות.</b> לקמן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש היכן היו: <b>כנגד דיר</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>העצים.</b> לשכה שבה היו נותנין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל עצי המערכה והיא היתה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקצוע מזרחית צפונית של עזרת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נשים: <b>ששם ארון נגנז.</b> ע\"י",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יאשיהו כדמפרש בגמ': <b>שהיה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתעסק.</b> במלאכתו מתליע את",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העצים שאין לבעלי מומין מלאכה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקדש כי אם להכין עצים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למערכה דכל עץ שנמצא בו תולעת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסול למזבח: <b>שהיא משונה.</b> שלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היתה האבן שוה לשאר אבני",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרצפה והבין שנסתלק משם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוחזרה: <b>ביחוד.</b> בבירור: גמ'",
      "gemara_segment_ids": [
        2,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ה\"ג אלא הדברות</b> <b>שבתוכו</b>: <b>ולא</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יראו החוצה.</b> סיפא דקרא ויהיו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שם עד היום הזה: כתיב ברישא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויראו וכתיב בסיפא ולא יראו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקשיא אהדדי: <b>בולטין.</b> ודוחקין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרוכת ונראין כשני דדי אשה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבולטין מתחת חלוקה: <b>ומפצע.</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומבקע: <b>ביחוד.</b> בבירור: <b>הקיש</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עליה בקורנס.</b> על המקום ההוא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויצא אש ושרפו: <b>התורה.</b> ולוחות",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שניות מונחים בתוכו: <b>לא משו</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> ואס\"ד דהארון ההוא הוא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהיה הולך לפניהם במלחמה מסתמא גם המעפילים היו נוטלים אותו עמהם במלחמה: <b>היה נכנס ויוצא עמהן.</b> כשנסעו במדבר נסע",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לפניהם כדכתיב וארון ברית ה' נוסע לפניהם: <b>ה\"ג ופעמים הוא מתראה עמהן במלחמה.</b> וי\"ס דל\"ג ליה והוא הנכון וכן הוא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "במס' סוטה: <b>מילה דלא חמון וכו'.</b> דבר שלא ראו מימיהם ואס\"ד שהיה יוצא עמהן תמיד במלחמה מאי יום מיומים שהיו מתייראין",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עתה: <b>והלא ארון בקרית יערים היה.</b> עד שבא דוד והעלוהו משם: <b>ומשני הגישה אלי הציץ.</b> והארון הזה לאו ארון ברית ה' אלא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הארון שהיה בו החשן והאפוד והאורים והתומים וזכר הציץ לפי שאסור לשאול באורים כי אם בלבישת השמונה בגדים והציץ הוא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "החשוב שבהן: <b>והלא הארון בציון היה.</b> בימי דוד ואיך קאמר והארון יושב בסוכות אלא ודאי דעל הארון השני שיוצא עמהם",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למלחמה קאמר: <b>סכך שהוא בקירוי.</b> שהיה יושב באוהל שעדיין לא נבנה בה\"מ ולכך קורא אותו סוכה לשון סכך בעלמא והואיל",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "והארון לא היה מיושב וישראל במלחמה החמיר אוריה על עצמו שלא לשמש המטה:",
      "gemara_segment_ids": [
        6
      ]
    }
  ],
