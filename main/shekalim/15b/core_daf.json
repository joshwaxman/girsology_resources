  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר ליה חמי מאי עבדית אמר ליה וישכח",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל את עושהו ויבן היכלות לא הוה בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נש דילעון באורייתא תני קדשי המזבח",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מוציאין את הראוי להן מקדשי בדק הבית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אין קדשי בדק הבית מוציאין את הראוי להן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מקדשי מזבח והא תנינן כלי שמצאו בו צורך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לבדק הבית מניחין אותו והשאר נמכרין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ודמיהן נופלין לבדק הבית אמר רבי חזקיה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כיני מתניתא ללשכת בדק הבית הדרן עלך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרק אלו הן הממונין <b>הלכה א <big>מתני׳</big></b> שלשה",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשר שופרות, שלשה עשר שולחנות, שלש עשרה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השתחוויות היו במקדש. של בית רבן גמליאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושל בית רבי חנניה סגן הכהנים היו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משתחוים בארבע עשרה והיכן היתה יתירה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כנגד דיר העצים שכן מסורת בידן מאבותיהן",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ששם הארון נגנז מעשה בכהן אחד שהיה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתעסק וראה את הרצפה שהיא משונה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחברותיה בא ואמר לחבירו לא הספיק לגמור",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הדבר עד שיצתה נשמתו וידעו בייחוד",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ששם הארון גנוז <b>גמ׳</b> תני השופרות הללו",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עקומות היו צרות מלמעלן ורחבות מלמטן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מפני הרמאין תני בשם רבי אלעזר הארון",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גלה עמהן לבבל מאי טעמא לא יותר דבר אמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ה׳ אין דבר אלא שהדיברות לתוכו וכן הוא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר ולתשובת השנה שלח המלך נבוכדנצר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויביאהו בבלה עם כלי חמדת בית ה׳ איזהו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלי חמדת בית ה׳ זה הארון רבי שמעון בן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לקיש אומר במקומו היה הארון נגנז הדא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוא דכתיב ויאריכו הבדים ויראו ראשי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הבדים אל הקדש אל פני הדביר ולא יראו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "החוצה כתיב ויראו ואת אמרת ולא יראו אלא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נראין ולא נראין בולטין ויוצאין כשני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דדי האשה ורבנן אמרי בלשכת דיר העצים",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היה הארון גנוז מעשה בכהן אחד בעל מום",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיה עומד ומפצל עצים בלשכת דיר העצים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וראה את הרצפה שהיא משתנה מחברותיה בא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואמר לחבירו בא וראה את הרצפה הזאת שהיא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משתנה מחברותיה לא הספיק לגמור את הדבר",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד שיצתה נשמתו וידעו בייחוד ששם הארון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גנוז תני רבי הושעיא הקיש עליה בקורנס",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויצאת אש ושרפתו תני רבי יהודה בן לקיש",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר שני ארונות היו מהלכין עם ישראל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במדבר אחד שהיתה התורה נתונה בתוכו ואחר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיו שברי לוחות נתונין בתוכו זה שהיתה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התורה נתונה בתוכו היה מונח באהל מועד",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדא הוא דכתיב וארון ברית ה׳ ומשה לא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משו מקרב המחנה זה שהיו שברי לוחות",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נתונין בתוכו היה נכנס ויוצא עמהן",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ופעמים שהיה מתראה עמהן ורבנן אמרי ארון",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אחד היה ופעם אחת יצא בימי עלי ונשבה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרייא מסייע להו לרבנן אוי לנו מי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יצילנו מיד האלהים האדירים האלה מילה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דלא חמון מן יומיהון קרייא מסייע לרבי",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יודה בן לקיש ויאמר שאול לאחיה הגישה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארון האלהים והלא ארון בקרית יערים היה",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מה עבדון ליה רבנן הגישה אלי הציץ קרייא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסייע לרבי יודא בן לקיש הארון וישראל",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויהודה יושבין בסוכות",
      "segment_ids": [
        6
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עבד.</b> אלו הפתחים של בהמ\"ד הגדול: <b>חמי מה דעבדית.</b> היה משבח עצמו ראה מה שעשיתי: <b>וישכח ישראל וכו'.</b> טוב הוא ליתן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לעניי תורה שעושין מצות בכל עת משיבנו בנינים והיכלות: <b>מוציאין את הראוי להן מקדשי בדק הבית.</b> כגון אם הקדיש בהמה או",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אבנים לבדק הבית. וצריכין אותן למזבח נוטלין אותן למזבח אבל הקדיש בהמה אפי' בעלי מומים או אבנים למזבח אין מוציאין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אותן לבדק הבית אלא ימכרו ודמיהן נופלין לבדק הבית: <b>כלי שמצאו בו צורך לבד\"ה מניחין אותו.</b> הא ראוי למזבח מוכרין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותן שמעינן דקדשי בדק הבית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"פ שראויין למזבח אין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוציאין מקדשי בדק הבית: <b>כיני</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתניתא.</b> כן היא משנתינו כלי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמצאו בו צורך והיינו לצורך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המזבח או לבדק הבית ללשכת בדק",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הבית מניחין אותו ומשם נוטלין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו למה שצריכין אותו: <small>הדרן</small>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<small>עלך פרק אלו הן הממונין</small> מתני'",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלשה עשר שופרות.</b> תיבות צרות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלמעלה ורחבות מלמטה עקומות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כעין שופר מפני הרמאים שלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יתנו ידן לתוכן להראות כאילו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותנין לתוכן ויטלו מתוכן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולקמן מפרש למה י\"ג שופרות",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וי\"ג שולחנות ובאיזה מקום",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מונחין: <b>י\"ג השתחוויות.</b> לקמן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש היכן היו: <b>כנגד דיר</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>העצים.</b> לשכה שבה היו נותנין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל עצי המערכה והיא היתה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקצוע מזרחית צפונית של עזרת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נשים: <b>ששם ארון נגנז.</b> ע\"י",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יאשיהו כדמפרש בגמ': <b>שהיה</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתעסק.</b> במלאכתו מתליע את",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "העצים שאין לבעלי מומין מלאכה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במקדש כי אם להכין עצים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למערכה דכל עץ שנמצא בו תולעת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסול למזבח: <b>שהיא משונה.</b> שלא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היתה האבן שוה לשאר אבני",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרצפה והבין שנסתלק משם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והוחזרה: <b>ביחוד.</b> בבירור: גמ'",
      "gemara_segment_ids": [
        2,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ה\"ג אלא הדברות</b> <b>שבתוכו</b>: <b>ולא</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יראו החוצה.</b> סיפא דקרא ויהיו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שם עד היום הזה: כתיב ברישא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויראו וכתיב בסיפא ולא יראו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקשיא אהדדי: <b>בולטין.</b> ודוחקין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרוכת ונראין כשני דדי אשה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבולטין מתחת חלוקה: <b>ומפצע.</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומבקע: <b>ביחוד.</b> בבירור: <b>הקיש</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עליה בקורנס.</b> על המקום ההוא",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויצא אש ושרפו: <b>התורה.</b> ולוחות",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שניות מונחים בתוכו: <b>לא משו</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> ואס\"ד דהארון ההוא הוא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיה הולך לפניהם במלחמה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מסתמא גם המעפילים היו נוטלים",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותו עמהם במלחמה: <b>היה נכנס</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ויוצא עמהן.</b> כשנסעו במדבר נסע",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפניהם כדכתיב וארון ברית ה'",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נוסע לפניהם: <b>ה\"ג ופעמים הוא</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתראה עמהן במלחמה.</b> וי\"ס דל\"ג",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ליה והוא הנכון וכן הוא במס'",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סוטה: <b>מילה דלא חמון וכו'.</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דבר שלא ראו מימיהם ואס\"ד",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיה יוצא עמהן תמיד במלחמה",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאי יום מיומים שהיו מתייראין",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עתה: <b>והלא ארון בקרית יערים</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היה.</b> עד שבא דוד והעלוהו משם:",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומשני הגישה אלי הציץ.</b> והארון",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הזה לאו ארון ברית ה' אלא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הארון שהיה בו החשן והאפוד",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והאורים והתומים וזכר הציץ",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפי שאסור לשאול באורים כי אם",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בלבישת השמונה בגדים והציץ",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא החשוב שבהן: <b>והלא הארון</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בציון היה.</b> בימי דוד ואיך",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמר והארון יושב בסוכות אלא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ודאי דעל הארון השני שיוצא",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "עמהם למלחמה קאמר: <b>סכך שהוא בקירוי.</b> שהיה יושב באוהל שעדיין לא נבנה בה\"מ ולכך",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קורא אותו סוכה לשון סכך בעלמא והואיל והארון לא היה מיושב וישראל במלחמה החמיר",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אוריה על עצמו שלא לשמש המטה:",
      "gemara_segment_ids": [
        6
      ]
    }
  ],
  "tosafot": [],
