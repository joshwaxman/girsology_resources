    {
      "role": "tiklin_chadtin",
      "state": "added",
      "label_he": "פני משה",
      "label_en": "Penei Moshe",
      "side": "left",
      "width": "245px",
      "right": "0px",
      "left": "0px",
      "top": 847,
      "height": 1109,
      "basis": "scan",
      "top_frac": 0.3581,
      "height_frac": 0.6419,
      "printed_y": [
        355.1,
        765.2
      ],
      "printed_body_y": [
        126.3,
        765.2
      ],
      "note_he": "תוספת שלנו. פני משה אינו נדפס בדף זה כלל — במלבן הזה הדפיסו תקלין חדתין, שאינו מצוי במהדורה דיגיטלית. הטקסט מספריא (פיוטרקוב תרנ״ח–תר״ס), ואינו חלק מצורת הדף הנדפסת.",
      "note_en": "OUR ADDITION. Penei Moshe is not printed on this leaf at all — this rectangle is where the press set Tiklin Chadtin, which is in no digital edition. The text is Sefaria's (Piotrków, 1898-1900) and is not part of the printed page.",
      "printed_work_he": "תקלין חדתין",
      "printed_work_en": "Tiklin Chadtin",
      "source_ref": "Penei Moshe on Jerusalem Talmud Shekalim",
      "lines": [
        {
          "width": "216px",
          "text": "<b>מה תלמוד לומר סופר.</b> וכי"
        },
        {
          "width": "216px",
          "text": "לא היה לו להכתוב לספר"
        },
        {
          "width": "216px",
          "text": "בשבחו אלא שהיה כותב"
        },
        {
          "width": "216px",
          "text": "כמשמעות סופר כפשטיה אלא"
        },
        {
          "width": "216px",
          "text": "ללמד כשם שהיה סופר וחושב"
        },
        {
          "width": "216px",
          "text": "בד\"ת להתיבות ולהאותיות"
        },
        {
          "width": "216px",
          "text": "כמו שנשנה במסכת סופרים"
        },
        {
          "width": "216px",
          "text": "כך היה סופר ומונה בדברי"
        },
        {
          "width": "216px",
          "text": "חכמים כדלעיל: <b>הראשונים</b>"
        },
        {
          "width": "216px",
          "text": "<b>חרשו וזרעו וכו' ואנו אין</b>"
        },
        {
          "width": "216px",
          "text": "<b>לנו פה לאכול.</b> כלומר הם"
        },
        {
          "width": "216px",
          "text": "יגעו הרבה בד\"ת והתקינו"
        },
        {
          "width": "216px",
          "text": "והזמינו להבין כל כללי"
        },
        {
          "width": "216px",
          "text": "התורה ופרטיה כאדם"
        },
        {
          "width": "216px",
          "text": "המתייגע בכל מלאכת התבואה"
        },
        {
          "width": "216px",
          "text": "עד אם גמר ואפה הפת"
        },
        {
          "width": "216px",
          "text": "ואעפ\"כ אין לנו לב להבין"
        },
        {
          "width": "216px",
          "text": "אותה וכמי שאין לו פה"
        },
        {
          "width": "216px",
          "text": "לאכול: <b>אין הוון קדמאי</b>"
        },
        {
          "width": "216px",
          "text": "<b>מלאכין וכו'.</b> זה כתוב"
        },
        {
          "width": "216px",
          "text": "לעיל בפ\"ק דדמאי בהלכה ג'"
        },
        {
          "width": "216px",
          "text": "ועל עובדא דמייתי התם"
        },
        {
          "width": "216px",
          "text": "לעיל ר' ירמיה שלח לרבי"
        },
        {
          "width": "216px",
          "text": "זעירא חדא מסאנא דתאנים"
        },
        {
          "width": "216px",
          "text": "דלא מתקנא. כלכלה אחת של"
        },
        {
          "width": "216px",
          "text": "תאנים ולא היו מתוקנים"
        },
        {
          "width": "216px",
          "text": "ממעשרות וסמכו זה על זה"
        },
        {
          "width": "216px",
          "text": "ר\"ז היה אומר איך ישלח לי"
        },
        {
          "width": "216px",
          "text": "רבי ירמיה דבר שאינו"
        },
        {
          "width": "216px",
          "text": "מתוקן ורבי ירמיה היה"
        },
        {
          "width": "216px",
          "text": "סבור איך יהיה ר\"ז אוכל"
        },
        {
          "width": "216px",
          "text": "דבר שספק לו אם מתוקן הוא"
        },
        {
          "width": "216px",
          "text": "או לא ובין דין לדין"
        },
        {
          "width": "216px",
          "text": "נתאכלו טבל וכשנודע לו"
        },
        {
          "width": "216px",
          "text": "אח\"כ שאכל דבר שאינו"
        },
        {
          "width": "216px",
          "text": "מתוקן אמר רבי זעירא אין"
        },
        {
          "width": "216px",
          "text": "הוון קדמאי מלאכין וכו'"
        },
        {
          "width": "216px",
          "text": "ובההיא שעתא כשאירע לו כך"
        },
        {
          "width": "216px",
          "text": "לר\"ז אמר ואפילו לחמרתיה"
        },
        {
          "width": "216px",
          "text": "דרבי פנחס בן יאיר לא"
        },
        {
          "width": "216px",
          "text": "אידמינן וכהאי עובדא"
        },
        {
          "width": "216px",
          "text": "דלקמן: <b>גנבתה.</b> נגנבה"
        },
        {
          "width": "216px",
          "text": "מליסטין בלילה ונעשית"
        },
        {
          "width": "216px",
          "text": "טמונה אצליהם במערה ג'"
        },
        {
          "width": "216px",
          "text": "ימים ולא טעמה כלום"
        },
        {
          "width": "216px",
          "text": "ולבסוף נמלכו להחזירה"
        },
        {
          "width": "216px",
          "text": "ואמרו הוציאוה מכאן שלא"
        },
        {
          "width": "216px",
          "text": "תמות ותסרח עלינו המערה"
        },
        {
          "width": "216px",
          "text": "והוציאו אותה והלכה ועמדה"
        },
        {
          "width": "216px",
          "text": "על השער של אדונה: <b>שריית.</b>"
        },
        {
          "width": "216px",
          "text": "התחיל' לצעוק ואמר להן"
        },
        {
          "width": "216px",
          "text": "רבי פנחס פתחו לה לעלובה"
        },
        {
          "width": "216px",
          "text": "זו שכבר יש ג' ימים שלא"
        },
        {
          "width": "216px",
          "text": "אכלה כלום: <b>יהבון לה</b>"
        },
        {
          "width": "216px",
          "text": "<b>תיכול.</b> תנו לה מה לאכול"
        },
        {
          "width": "216px",
          "text": "ונתנו לה שעורים ולא אכלה"
        },
        {
          "width": "216px",
          "text": "וכששאל אם השעורים"
        },
        {
          "width": "216px",
          "text": "מתוקנים היו והשיבו הן"
        },
        {
          "width": "216px",
          "text": "לפי הדין שהיה דמאי"
        },
        {
          "width": "216px",
          "text": "דהלוקח לבהמה פטור:"
        },
        {
          "width": "216px",
          "text": "<b>וארימיתון דמיין.</b> אם"
        },
        {
          "width": "216px",
          "text": "הרימותם בשביל דמאי וא\"ל"
        },
        {
          "width": "216px",
          "text": "לא כן למדתנו רבינו הלוקח"
        },
        {
          "width": "216px",
          "text": "וכו' והשיב ומה אעשה"
        },
        {
          "width": "216px",
          "text": "לעלובה זו והיא מחמרת"
        },
        {
          "width": "216px",
          "text": "הרבה על עצמה והרימו"
        },
        {
          "width": "216px",
          "text": "ותיקנו דמאי ואז אכלה:"
        },
        {
          "width": "216px",
          "text": "<b>בוא וראה מה גדול הוא</b>"
        },
        {
          "width": "216px",
          "text": "<b>וכו'.</b> שהיה יודע לדרוש"
        },
        {
          "width": "216px",
          "text": "ברמוזי הדברים ולחברן"
        },
        {
          "width": "216px",
          "text": "ולעשותן מלות כדי להבין"
        },
        {
          "width": "216px",
          "text": "וכדלקמן בהאי דרב חסדא:"
        },
        {
          "width": "216px",
          "text": "<b>תני.</b> בתוספתא דסנהדרין"
        },
        {
          "width": "216px",
          "text": "ריש פרק ח': <b>שנים שיודעין</b>"
        },
        {
          "width": "216px",
          "text": "<b>לדבר.</b> בשבעים לשון וכולן"
        },
        {
          "width": "216px",
          "text": "ראוין לשמוע להבין אף"
        },
        {
          "width": "216px",
          "text": "שאין יכולין לדבר ה\"ז"
        },
        {
          "width": "216px",
          "text": "ראויה לסנהדרין לפי"
        },
        {
          "width": "216px",
          "text": "שהסנהדרין היו צריכין"
        },
        {
          "width": "216px",
          "text": "שיהא בהן מדברים בכל"
        },
        {
          "width": "216px",
          "text": "הלשונות שאם יבא לפניהן"
        },
        {
          "width": "216px",
          "text": "אחד מאיזו אומה ולשון"
        },
        {
          "width": "216px",
          "text": "ואינו מדבר כ\"א בלשון עמו"
        },
        {
          "width": "216px",
          "text": "שיהו יכולין לדבר עמו"
        },
        {
          "width": "216px",
          "text": "ולהשיבו וכולן היו צריכין"
        },
        {
          "width": "216px",
          "text": "שיבינו מה שהן מדברין:"
        },
        {
          "width": "216px",
          "text": "<b>שלשה.</b> אם יש בהן שלשה"
        },
        {
          "width": "216px",
          "text": "מדברים ה\"ז בינונית ואם"
        },
        {
          "width": "216px",
          "text": "יש בהן ארבעה הרי זו חכמה"
        },
        {
          "width": "216px",
          "text": "מפני ששנים מהן מדברים עם"
        },
        {
          "width": "216px",
          "text": "זה ובתוך כך שנים האחרים"
        },
        {
          "width": "216px",
          "text": "נושאין ונותנין בהענין:"
        },
        {
          "width": "216px",
          "text": "<b>יבשה ארץ ישראל.</b> לא ירדו"
        },
        {
          "width": "216px",
          "text": "גשמים ולא גדלו הזרעים"
        },
        {
          "width": "216px",
          "text": "ולא ידעו מהיכן להביא"
        },
        {
          "width": "216px",
          "text": "העומר: <b>אייתוניה.</b> הביאו"
        },
        {
          "width": "216px",
          "text": "אותו לפני פתחיה שלא היו"
        },
        {
          "width": "216px",
          "text": "מבינים ברמיזותיו של אילם"
        },
        {
          "width": "216px",
          "text": "הזה ואמר להן פתחיה אם יש"
        },
        {
          "width": "216px",
          "text": "איזה מקום הנקרא גנות"
        },
        {
          "width": "216px",
          "text": "צריפין או להפך והלכו לשם"
        },
        {
          "width": "216px",
          "text": "ומצאו שדה זרועה ומליאה"
        },
        {
          "width": "216px",
          "text": "וקצרוה להביא העומר: <b>פעם</b>"
        },
        {
          "width": "216px",
          "text": "<b>אחת נשרף כל העולם כולו.</b>"
        },
        {
          "width": "216px",
          "text": "נשרפו הזרעים מחמת החום"
        },
        {
          "width": "216px",
          "text": "ולא היו יודעין וכו': <b>על</b>"
        },
        {
          "width": "216px",
          "text": "<b>סוכרא.</b> מקום סכר הנהר"
        },
        {
          "width": "216px",
          "text": "שסוכרין אותו כדי שיתפשט"
        },
        {
          "width": "216px",
          "text": "וישקה את השדות א\"נ סיכרא"
        },
        {
          "width": "216px",
          "text": "והוא חור שבמזוזת הדלת"
        },
        {
          "width": "216px",
          "text": "שתוחבין בו הבריח לנעול:"
        },
        {
          "width": "216px",
          "text": "<b>שלש נשים וכו'.</b> ועוד מעשה"
        },
        {
          "width": "216px",
          "text": "בג' נשים שהביאו קיניהן"
        },
        {
          "width": "216px",
          "text": "ואחת אומרת לעינתי וכו'"
        },
        {
          "width": "216px",
          "text": "והיו סבורין לומר לעינתי"
        },
        {
          "width": "216px",
          "text": "מלשון מעיין שהיתה שופעת"
        },
        {
          "width": "216px",
          "text": "זיבה כמעיין וכן האומרת"
        },
        {
          "width": "216px",
          "text": "לימתי שופעת כים היתה"
        },
        {
          "width": "216px",
          "text": "והאומרת לזיבתי זיבה ממש"
        },
        {
          "width": "216px",
          "text": "כסידרה ונמצאו שאלו השלש"
        },
        {
          "width": "216px",
          "text": "כולן קיני חובה מביאין הן"
        },
        {
          "width": "216px",
          "text": "אחד לחטאת ואחד לעולה כך"
        },
        {
          "width": "216px",
          "text": "היו סבורין ואמר להן"
        },
        {
          "width": "216px",
          "text": "פתחיה לא כך היא כוונתן"
        },
        {
          "width": "216px",
          "text": "אלא זו שאומרת לעינתי"
        },
        {
          "width": "216px",
          "text": "בעינה היתה מסוכנת"
        },
        {
          "width": "216px",
          "text": "ונתרפאה ומביאה קן א'"
        },
        {
          "width": "216px",
          "text": "לנדבה וכן האומרת לימתי"
        },
        {
          "width": "216px",
          "text": "בים סיכנה וניצולה"
        },
        {
          "width": "216px",
          "text": "והאומרת לזיבתי זאב בא"
        },
        {
          "width": "216px",
          "text": "ליטול את בנה וניצל ממנו"
        },
        {
          "width": "216px",
          "text": "ומביאה קן א' ונמצאו שאלו"
        },
        {
          "width": "216px",
          "text": "קיני נדבה הן וכולן"
        },
        {
          "width": "216px",
          "text": "עולות: <b>בן אחיה וכו'.</b>"
        },
        {
          "width": "216px",
          "text": "כדפרישית במתני' שאחיה"
        },
        {
          "width": "216px",
          "text": "היה יודע איזה יין טוב"
        },
        {
          "width": "216px",
          "text": "למעיים ואיזה יין הוא סמם"
        },
        {
          "width": "216px",
          "text": "ומרפא ביותר למעיים:"
        }
      ],
