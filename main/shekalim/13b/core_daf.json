  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר נאמרו בנבלת העוף הטהור ארבע אבות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נזיקין אבות מלאכות ארבעים חסר אחת אמר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אליעזר כתיב לעזרא הכהן הסופר מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלמוד לומר סופר אלא כשם שהיה סופר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדברי תורה כך היה סופר בדברי חכמים רבי",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חגי בשם רבי שמואל בר נחמן הראשונים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חרשו וזרעו ניכשו כיסחו עדרו קצרו עמרו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דשו זרו בררו טחנו הרקידו לשו קיטפו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואפו ואנו אין לנו מה לאכול רבי אבא בר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זמינא בשם רבי זעירא אין הוון קדמאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלאכין אנן בני אנש ואין הוון בני אנש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אנן חמרין אמר רבי מנא בההיא שעתא אמרין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו כחמרתיה דרבי פינחס בן יאיר לא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אידמינון חמרתיה דרבי פינחס בן יאיר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גנבתה ליסטאי בליליא עבדת טמירא גבון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלתא יומין ולא טעמה כלום בתר תלתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יומין אימלכון מחזרתה אמרי אפקינון מן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכא דלא תימות גבן אפקונה אזלת וקמת לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על תרעא דמרה שריית מנהקת אמר לון פתחון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להדא עלובתא דאית לה תלת יומין דלא טעמה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום פתחין לה ועלת לה אמר לון יהבו לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום תיכול יהבון קומה שעורין ולא בעית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למיכל אמרין ליה רבי לא בעית למיכל אמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לון מתקנין אינון אמרו ליה אין אמר לון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וארימתון דמיין אמרון ליה לא כן אלפון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי הלוקח זרע לבהמה קמח לעורות שמן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאור פטור מן הדמאי אמר לון מה נעבד לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להדא עלובתא דהיא מחמרה על גרמה סגין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וארימן דמיין ואכלת פתחיה על הקינין בא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וראה מה גדול הוא כחו של אותו האיש פותח",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דברים ודורשן יודע בשבעים לשון תני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סנהדרין שיש בה שנים שיכולין לדבר וכולן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראוין לשמוע הרי זו ראויה לסנהדרין שלשה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרי זו בינונית ארבעה הרי זו חכמה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וביבנה היו בה ארבעה בן עזאי ובן זומא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובן חכינאי ורבי אלעזר בן מתיה אמר רבי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסדא פעם אחת יבשה ארץ ישראל ולא ידעו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מהיכן להביא עומר והוה תמן חד אלם דהוה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהיב חד ידיה על גגות וחד ידיה על",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צריפים אייתוניה קמיה דפתחיה אמר להו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אית אתר דמתקריא גגות צריפין או צריפין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גגות אזלין לתמן ואשכחן אמר רבי יוסה בי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי בון פעם אחת נשדף כל העולם כולו ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו יודעין מהיכן להביא העומר והוה תמן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חד אילם דהוה יהיב ידיה על עיניה וידיה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על סוכרא אייתוניה לגבי פתחיה אמר לון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אית אתר דמיתקריא עין סוכר או סוכר עין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואזלון תמן ואשכחון שלש נשים הביאו",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קיניהן אחת אומרת לעינתי ואחת אומרת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לימתי ואחת אומרת לזיבתי זו שאומרת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעינתי סברין מימר שופעת כמעין אמר לון",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעיינא סכנת זו שאומרת לימתי סברין מימר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שופעת כים אמר לון בימה סכנת זו שאומרת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לזיבתי סברין מימר זבה ממש אמר לון זאב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בא ליטול את בנה בן אחייה וכו׳ על ידי",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיו הכהנים מהלכין יחפים על הרצפה והיו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אוכלין בשר ושותין מים היו באין לידי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חולי המעים והוה ידע האי דין חמר טב",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למעייא והאי דין חמר סמם למעייא נחוניא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חופר שיחין שהיה חופר שיחין ומערות והוה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידע",
      "segment_ids": [
        8
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מה תלמוד לומר סופר.</b> דכתיב לעזרא הכהן סופר סופר דברי מצות ה' וסופר בתרא למה לי: <b>אלא כשם שהיה סופר בדברי תורה.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שמנה כל האותיות שבתורה שבכתב ועשה המסורת: <b>כך היה סופר בדברי חכמים.</b> למנות ההלכות: <b>הראשונים חרשו כו'.</b> איידי",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דמייתי שהראשונים עשו ספורות להקל על המעיינים מייתי נמי הא דר' חגי: <b>ואנו אין לנו מה לאכול.</b> כלומר אף על פי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שהראשונים עשו כל הפעולות להקל עלינו עדיין קשה עלינו להבין ד\"ת על בוריין: <b>אין הוון וכו'.</b> אם היו הראשונים מלאכים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אנו בני אדם אבל אם היו הן",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בני אדם אנחנו כחמורים לרוב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פחיתותינו: <b>א\"ר מנא.</b> באותה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שעה אמרו אפי' לחמורו של ר\"פ",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בן יאיר לא דמיין: <b>חמרתא דר\"פ</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בן יאיר.</b> גנבוהו ליסטים בלילה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיתה טמונה אצלם שלשה ימים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא טעמה כלום: <b>בתר שלשה</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ימים.</b> נמלכו להחזירה אמרו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוציאוה מכאן שלא תמות אצלינו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויהיה ניכר הגניבה: <b>אפקונה.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוציאו אותה והלכה מעצמה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ועמדה על פתח ביתו של ר\"פ",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והתחילה לצעוק: <b>א\"ל ר' פנחס.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פתחו הדלת לענייה זו דהא שלשה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימים שלא אכלה כלום: <b>פתחן לה.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונכנסה: <b>אמר להן.</b> ר\"פ תנו לה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאכול ונתנו לפניה שעורים ולא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רצתה לאכול: <b>אמר לון.</b> ר\"פ וכי",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתוקנים הם השעורים שאין בהם",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסולת: <b>וארימתון דמיין.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפרשתן מהם דמאי: <b>אמרון ליה.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא כך למדתנו רבינו הלוקח",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירות מעם הארץ לזרע או",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להאכילן לבהמה פטורין מן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדמאי דכיון דרוב עמי הארץ",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשרין הן לא גזרו באלו כיון",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו אוכל מהן בעצמו: <b>קמח</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לעורות.</b> לעבדן ושמן לנר פטור",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הדמאי וזו נמי למה אינה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אוכלת: <b>אמר לון.</b> ר\"פ מה נעשה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לענייה זו שהיא מחמרת על עצמה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרבה והפרישו דמאי ואכלה:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שיודעין לדבר.</b> בשבעים לשון",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכו' ראויין לשמוע שהן מבינין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבעים לשון אע\"פ שאינן יודעין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להשיב: <b>ה\"ז ראויין לסנהדרין.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכשרה על צד הדוחק: <b>שלשה.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיודעין לדבר: <b>ארבעה.</b> שיודעין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדבר ה\"ז מעולה: <b>יבשה א\"י.</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא ירדו הגשמים ולא ידעו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאין להביא העומר: <b>והוה תמן</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חד אלם.</b> שאינו שומע ואינו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדבר: <b>צריפין.</b> הוא סוכה שאין",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה גג אלא חדה מלמעלה ועשויה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מערבה: <b>איתוני' וכו'.</b> הביאוהו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפני פתחיה להבין ממנו באיזה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקום הוא: <b>א\"ל.</b> מי איכא מקום",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בא\"י ששמו גגות צריפין או",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריפין גגות. והלכו לשם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומצאו: <b>נשדף.</b> נלקה בשדפון:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>סוכרא.</b> חורש במזוזת הדלת שבו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תוחבים הבריח לנעול: <b>שופעת</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דמים כמעיין.</b> ומביאה קן אחד",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חובה אחד חטאת ואחד עולה כדין",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זבה: <b>בעינה סיכנה.</b> וזו קן",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נדבה וכולן עולות: <b>בים סיכנה.</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעברה תוך הים היתה בסכנה וזו",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לנדרה ועולות הן: <b>זאב בא</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ליטול את בנה.</b> ונדרה קן אחד",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להצלת בנה: <b>ע\"י שהיו הכהנים</b>",
      "gemara_segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו' והיו באין לידי חולי</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מעיים.</b> לכך היו צריכין לרופא",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרפאותן והלכך אף הוא נחשב",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהממוני' שהיו במקדש שאף הוא",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נטל שכרו מתרומ' הלשכה דצרכי",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבן הוא שיאכלו הכהנים בשר",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבנות השמנים ולא יבוא לידי",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נותר: <b>ושותין מים.</b> שאסורים",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לשתות יין בעזרה: <b>והוה ידע.</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בן אחיה איזהו יין יפה למעיי'",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לעצרן ואיזה יין טוב לרפואתן שע\"י הצינה המעיים מתרפין או מתעצרי' יותר מדאי:",
      "gemara_segment_ids": [
        7
      ]
    }
  ],
  "tosafot": [],
