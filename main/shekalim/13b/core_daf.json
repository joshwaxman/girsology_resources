  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "דבר נאמרו בנבלת העוף הטהור ארבע אבות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נזיקין אבות מלאכות ארבעים חסר אחת אמר",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אליעזר כתיב לעזרא הכהן הסופר מה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלמוד לומר סופר אלא כשם שהיה סופר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדברי תורה כך היה סופר בדברי חכמים רבי",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חגי בשם רבי שמואל בר נחמן הראשונים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חרשו וזרעו ניכשו כיסחו עדרו קצרו עמרו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דשו זרו בררו טחנו הרקידו לשו קיטפו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואפו ואנו אין לנו מה לאכול רבי אבא בר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זמינא בשם רבי זעירא אין הוון קדמאין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלאכין אנן בני אנש ואין הוון בני אנש",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אנן חמרין אמר רבי מנא בההיא שעתא אמרין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו כחמרתיה דרבי פינחס בן יאיר לא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אידמינון חמרתיה דרבי פינחס בן יאיר",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גנבתה ליסטאי בליליא עבדת טמירא גבון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תלתא יומין ולא טעמה כלום בתר תלתא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יומין אימלכון מחזרתה אמרי אפקינון מן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הכא דלא תימות גבן אפקונה אזלת וקמת לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על תרעא דמרה שריית מנהקת אמר לון פתחון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להדא עלובתא דאית לה תלת יומין דלא טעמה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום פתחין לה ועלת לה אמר לון יהבו לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום תיכול יהבון קומה שעורין ולא בעית",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למיכל אמרין ליה רבי לא בעית למיכל אמר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לון מתקנין אינון אמרו ליה אין אמר לון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וארימתון דמיין אמרון ליה לא כן אלפון",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי הלוקח זרע לבהמה קמח לעורות שמן",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאור פטור מן הדמאי אמר לון מה נעבד לה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להדא עלובתא דהיא מחמרה על גרמה סגין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וארימן דמיין ואכלת פתחיה על הקינין בא",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וראה מה גדול הוא כחו של אותו האיש פותח",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דברים ודורשן יודע בשבעים לשון תני",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סנהדרין שיש בה שנים שיכולין לדבר וכולן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ראוין לשמוע הרי זו ראויה לסנהדרין שלשה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרי זו בינונית ארבעה הרי זו חכמה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וביבנה היו בה ארבעה בן עזאי ובן זומא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובן חכינאי ורבי אלעזר בן מתיה אמר רבי",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסדא פעם אחת יבשה ארץ ישראל ולא ידעו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מהיכן להביא עומר והוה תמן חד אלם דהוה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהיב חד ידיה על גגות וחד ידיה על",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "צריפים אייתוניה קמיה דפתחיה אמר להו",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אית אתר דמתקריא גגות צריפין או צריפין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "גגות אזלין לתמן ואשכחן אמר רבי יוסה בי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי בון פעם אחת נשדף כל העולם כולו ולא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו יודעין מהיכן להביא העומר והוה תמן",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חד אילם דהוה יהיב ידיה על עיניה וידיה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על סוכרא אייתוניה לגבי פתחיה אמר לון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אית אתר דמיתקריא עין סוכר או סוכר עין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואזלון תמן ואשכחון שלש נשים הביאו",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קיניהן אחת אומרת לעינתי ואחת אומרת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לימתי ואחת אומרת לזיבתי זו שאומרת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לעינתי סברין מימר שופעת כמעין אמר לון",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בעיינא סכנת זו שאומרת לימתי סברין מימר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שופעת כים אמר לון בימה סכנת זו שאומרת",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לזיבתי סברין מימר זבה ממש אמר לון זאב",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בא ליטול את בנה בן אחייה וכו׳ על ידי",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיו הכהנים מהלכין יחפים על הרצפה והיו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אוכלין בשר ושותין מים היו באין לידי",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חולי המעים והוה ידע האי דין חמר טב",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "למעייא והאי דין חמר סמם למעייא נחוניא",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חופר שיחין שהיה חופר שיחין ומערות והוה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידע",
      "segment_ids": [
        8
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מה תלמוד לומר סופר.</b> דכתיב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעזרא הכהן סופר סופר דברי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מצות ה' וסופר בתרא למה לי:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אלא כשם שהיה סופר בדברי</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תורה.</b> שמנה כל האותיות שבתורה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבכתב ועשה המסורת: <b>כך היה</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>סופר בדברי חכמים.</b> למנות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ההלכות: <b>הראשונים חרשו כו'.</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איידי דמייתי שהראשונים עשו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ספורות להקל על המעיינים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מייתי נמי הא דר' חגי: <b>ואנו</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אין לנו מה לאכול.</b> כלומר אף",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על פי שהראשונים עשו כל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפעולות להקל עלינו עדיין קשה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עלינו להבין ד\"ת על בוריין:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אין הוון וכו'.</b> אם היו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשונים מלאכים אנו בני אדם",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל אם היו הן בני אדם אנחנו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כחמורים לרוב פחיתותינו: <b>א\"ר</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מנא.</b> באותה שעה אמרו אפי'",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחמורו של ר\"פ בן יאיר לא",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמיין: <b>חמרתא דר\"פ בן יאיר.</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גנבוהו ליסטים בלילה והיתה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טמונה אצלם שלשה ימים ולא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טעמה כלום: <b>בתר שלשה ימים.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמלכו להחזירה אמרו הוציאוה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מכאן שלא תמות אצלינו ויהיה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניכר הגניבה: <b>אפקונה.</b> הוציאו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותה והלכה מעצמה ועמדה על",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פתח ביתו של ר\"פ והתחילה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לצעוק: <b>א\"ל ר' פנחס.</b> פתחו",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדלת לענייה זו דהא שלשה ימים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא אכלה כלום: <b>פתחן לה.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונכנסה: <b>אמר להן.</b> ר\"פ תנו לה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאכול ונתנו לפניה שעורים ולא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רצתה לאכול: <b>אמר לון.</b> ר\"פ וכי",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתוקנים הם השעורים שאין בהם",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פסולת: <b>וארימתון דמיין.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפרשתן מהם דמאי: <b>אמרון ליה.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא כך למדתנו רבינו הלוקח",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פירות מעם הארץ לזרע או",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להאכילן לבהמה פטורין מן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדמאי דכיון דרוב עמי הארץ",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעשרין הן לא גזרו באלו כיון",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו אוכל מהן בעצמו: <b>קמח</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לעורות.</b> לעבדן ושמן לנר פטור",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מן הדמאי וזו נמי למה אינה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אוכלת: <b>אמר לון.</b> ר\"פ מה נעשה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לענייה זו שהיא מחמרת על עצמה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הרבה והפרישו דמאי ואכלה:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שיודעין לדבר.</b> בשבעים לשון",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכו' ראויין לשמוע שהן מבינין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבעים לשון אע\"פ שאינן יודעין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להשיב: <b>ה\"ז ראויין לסנהדרין.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכשרה על צד הדוחק: <b>שלשה.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיודעין לדבר: <b>ארבעה.</b> שיודעין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדבר ה\"ז מעולה: <b>יבשה א\"י.</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלא ירדו הגשמים ולא ידעו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאין להביא העומר: <b>והוה תמן</b>",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חד אלם.</b> שאינו שומע ואינו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מדבר: <b>צריפין.</b> הוא סוכה שאין",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה גג אלא חדה מלמעלה ועשויה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מערבה: <b>איתוני' וכו'.</b> הביאוהו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לפני פתחיה להבין ממנו באיזה",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקום הוא: <b>א\"ל.</b> מי איכא מקום",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בא\"י ששמו גגות צריפין או",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צריפין גגות. והלכו לשם",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומצאו: <b>נשדף.</b> נלקה בשדפון:",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>סוכרא.</b> חורש במזוזת הדלת שבו",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תוחבים הבריח לנעול: <b>שופעת</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דמים כמעיין.</b> ומביאה קן אחד",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חובה אחד חטאת ואחד עולה כדין זבה: <b>בעינה סיכנה.</b> וזו קן נדבה וכולן עולות: <b>בים</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>סיכנה.</b> בעברה תוך הים היתה בסכנה וזו לנדרה ועולות הן: <b>זאב בא ליטול את בנה.</b>",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ונדרה קן אחד להצלת בנה: <b>ע\"י שהיו הכהנים וכו' והיו באין לידי חולי מעיים.</b> לכך",
      "gemara_segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היו צריכין לרופא לרפאותן והלכך אף הוא נחשב מהממוני' שהיו במקדש שאף הוא נטל",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שכרו מתרומ' הלשכה דצרכי קרבן הוא שיאכלו הכהנים בשר קרבנות השמנים ולא יבוא לידי",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נותר: <b>ושותין מים.</b> שאסורים לשתות יין בעזרה: <b>והוה ידע.</b> בן אחיה איזהו יין יפה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "למעיי' לעצרן ואיזה יין טוב לרפואתן שע\"י הצינה המעיים מתרפין או מתעצרי' יותר",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מדאי:",
      "gemara_segment_ids": [
        7
      ]
    }
  ],
