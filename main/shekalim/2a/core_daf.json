  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>הלכה א <big>מתני׳</big></b> באחד באדר משמיעין על",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השקלים ועל הכלאים. ובחמשה עשר בו קורין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את המגילה בכרכים ומתקנין את הדרכים ואת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרחובות ואת מקוות המים ועושין כל צרכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרבים ומציינין (על) [את] הקברות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויוצאין אף על הכלאים <b>גמ׳</b> ולמה באחד",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "באדר כדי שיביאו ישראל את שקליהן בעונתן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ותיתרם תרומת הלשכה מן החדשה בזמנה באחד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בניסן ומר רבי שמואל בר רב יצחק תרומת",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלשכה כתחלתה דכתיב ויהי בחדש הראשון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשנה השנית באחד לחדש הוקם המשכן ותני",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עלה ביום שהוקם המשכן בו ביום נתרמה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "התרומה רבי טבי רבי יאשיה בשם כהנא נאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאן חדשי ונאמר להלן חדשי מה חדשי שנאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להלן אין מונין אלא מניסן אף חדשי שנאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאן אין מונין אלא מניסן אמר רבי יונה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שבק רבי טבי ראשה דמתניתא ואמר סופה דל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כן כהדא דתני זאת עולת חדש בחדשו יכול",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהא תורם בכל חדש וחדש תלמוד לומר בחדשו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לחדשי (השנה) בחדש אחד הוא תורם לכל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חדשי השנה יכול באיזה חדש שירצה נאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאן חדשי ונאמר להלן חדשי מה חדשי שנאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להלן אין מונין אלא מניסן אף חדשי שנאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כאן אין מונין אלא מניסן מהו משמיעין רב",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הונא אמר מכריזין היך מה דאת אמר ויתנו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קול ביהודה ובירושלם תמן תנינן אין בין",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אדר הראשון לאדר השני אלא מקרא מגילה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומתנות לאביונים רבי סימון בשם רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהושע בן לוי אף שימוע שקלים וכלאים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביניהם רבי חלבו ורב הונא רב בשם רבי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חייא רבה הכל יוצאין בארבעה עשר שהוא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זמן קרייתה אמר רבי יוסי ויאות כלום",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרו משמיעין על השקלים לא כדי שיביאו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל את שקליהן בעונתן אם את אמר באדר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הראשון עד כדון אית בשתא שיתין יומין",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כלום אמרו יוצאין אף על הכלאים לא כדי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיהיו הצמחין ניכרין אם אומר את באדר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הראשון עד כדון אינון דקיקין רבי חזקיה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאל מעתה בני בבל משמיעין על השקלים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מראשו של (חודש) חורף לא כדי שיביאו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ישראל שקליהן בעונתן ותיתרם תרומת הלשכה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן החדשה בזמנה באחד בניסן התיב רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עולא קומי רבי מנא והא תנינן בשלשה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרקים בשנה תורמין את הלשכה בפרוס הפסח",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפרוס העצרת בפרוס החג אמר ליה (לא)",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נימר אילין דקריבין בפרוס הפסח אילין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרחוקין בפרוס העצרת ואילין דרחוקין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנהון בפרוס החג",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתני' <b>באחד באדר משמיעין על</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>השקלים.</b> ב\"ד שולחין בכל ערי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישראל ומכריזין שיביאו תקליהם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמה באחד באדר מפרש בגמ':",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ועל הכלאים.</b> מכריזין שימעטו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הזרע האחר עד שלא ישאר בו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רובע קב לסאה: <b>בט\"ו בו קורין</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>את המגילה בכרכים המוקפין</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חומה מימות יהושע בן נון.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איידי דבעי למתני דבט\"ו באדר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלחנות יושבים במדינות תני",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נמי כל מה שהיו עושין בו ביום",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולהכי לא תני שבי\"ד קורין את",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המגילה בשאר עיירות דלא חש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למתני מה שנעשה בכל החדש:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומתקנין את הדרכים ואת</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הרחובות.</b> והשווקים שנתקלקלו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בימות הגשמים בשביל עולי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רגלים א\"נ בשביל הרוצחים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשגגה כדכתיב תכין לך הדרך:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואת מקוות המים.</b> אם נתרבה בהם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טיט מנקין אותן ואם נחסר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיעורן ממשיכין להן מים",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וממלאין אותן: <b>כל צרכי רבים.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מפרש בגמרא: <b>ומציינין את</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הקברות.</b> שלא יאהילו עליהם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הכהנים ועושי טהרות והציון",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוא שממחים סיד ושופכין אותו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סביב הקבר ובימות הגשמים היה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הסיד נמוח וצריך לחזור",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולציינו: גמ' <b>בעונתן.</b> בזמנן",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קודם ר\"ח ניסן כדי שיכולין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתרום תרומת הלשכה שממנה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לוקחין קרבנות לצרכי השנה הבא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מניסן ואילך ולכך משמיעין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "באחד באדר שלשים יום קודם:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תרומת הלשכה.</b> היא התרומה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שתורמין מן הלשכה שנתנו בתוכה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כל השקלים כדתנן לקמן פ\"ג:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ואמר ר\"ש בר\"י.</b> דהיינו טעמא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתורמין הלשכה דוקא בר\"ח",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ניסן: <b>כתחלתה.</b> כמו שהיתה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תרומה ראשונה בשעה שהוקם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המשכן שהיתה בר\"ח ניסן כן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לדורות נמי מר\"ח ניסן מתחילין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לתרום מן החדש: <b>נאמר כאן</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חדשי.</b> זאת עולת חודש בחדשו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחדשי השנה: <b>ונאמר להלן חדשי.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ראשון הוא לכם לחדשי השנה:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שבק רבי טבי וכו'.</b> הניח ר'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טבי רישא דברייתא ואמר הסיפא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לחוד: <b>דל כן.</b> ולא נכון לעשות",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כן שקיצר במקום שהיה לו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להאריך דמסיפא לא שמעי'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דמדאורייתא צריך להביא מן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "החדש: <b>ת\"ל בחדשו לחדשי.</b> דה\"מ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "למכתב זאת עולת החדש: <b>בחדש אחד כו'.</b> וה\"פ זאת עולת החדש בחדשו שיחדש ויביא מתרומה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חדשה לכל חדשי השנה: <b>יכול באיזה חודש שירצה.</b> ויתרום לכל חדשי השנה: <b>ויתנו קול</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ביהודה ובירושל'.</b> להביא לה' משאת משה עבד ה' והיינו השקלים ש\"מ שמכריזין על",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "השקלים: <b>תמן תנינן.</b> מגילה פ\"ק: <b>אף שימוע שקלים וכלאים.</b> איכא בין אדר ראשון לשני",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאין משמיעין אלא בשני: <b>ר' חלבו וכו' עד זמן קרייתה.</b> ל\"ג: <b>ויאות.</b> שפיר קאמרת",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דשימוע שקלים וכלאים אינן אלא בשני: <b>עד כדון וכו'.</b> עדיין יש בשנה קודם ראש חודש",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ניסן ששים יום ולמה יקדמו כל כך: <b>עד כדון אינון דקיקין.</b> עדיין הצמחים דקים ואינן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ניכרין לידע אם הם כלאים: <b>מעתה.</b> דעיקר טעם הכרזה כדי שיביאו בעונתן דוקא א\"כ למה",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "משמיעין על שקליהם באדר הא אי אפשר להן להביאן קודם ר\"ח ניסן וי\"ג מראשו של חורף",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וה\"פ לפי דבריך צריכין בני בבל להשמיע בראשו של חורף כדי שיבואו לירושלים בראש",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "חודש ניסן: <b>והא תנינן.</b> לקמן פ\"ג: <b>בפרוס הפסח.</b> היינו ט\"ו יום דפרוס לשון מחצה הוא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ושלשים יום קודם החג שואלין ודורשין: <b>ה\"ג א\"כ.</b> לפי משמעות משנה זו נאמר דג' זמנים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלו קבעו לתרום משקלי הקרובים לירושלים בפסח והרחוקים קצת בעצרת והרחוקים ביותר",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בחג נמצא שדי אף לבני בבל בהכרזת אדר שעדיין יש פנאי שיביאו שקליהן קודם החג:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>כולה כאחת היתה באה.</b> לצורך כל השלשה תרומות היו תורמין בראש חודש ניסן ואף שלא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היו בה ממקומות הרחוקים לית לן בה שתורמין על הגבוי ועל העתיד לגבות: <b>כדי לעשות</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פומבי לדבר.</b> לפרסם ולהודיע כי בחג הפסח חובה להביא תרומת מקום הקרוב לירושלים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והרחוק במקצת בעצרת והרחוק ביותר בחג אבל לתוך הקופות לא בא משקלי הרחוקים:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
