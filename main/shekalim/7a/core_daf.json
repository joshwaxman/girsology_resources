        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> שלא מצינו שיהא לחם קרב",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפני עצמו: <b>שאין לך נזירות</b>",
