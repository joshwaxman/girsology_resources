  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר והוא שקרבה חטאתו בסוף אבל אי קרבו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלמים בסוף מותרן שלמים אמר רבי זעירא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אפילו קרבו שלמים לבסוף הלכה אחת היא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בנזיר שתהיה מותרה נדבה מתניתא מסייעא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לדין ומתניתא מסייעא לדין מתניתא מסייע",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לרבי זעירא אלו הן מעות סתומין כל שדמי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חטאת מיתות מעורבות בהן ואפילו הפריש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דמי חטאת מתוכה מעות סתומין הן מתניתא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מסייעא לרב חסדא אלו לחטאתי והשאר לשאר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נזירותי ומת מועלין בכולן ואין מועלין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במקצתן ולא אמר אם מת יפלו לנדבה רב",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חסדא אמר מותר לחמו של נזיר יורקב אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי יוסי ויאות להקריבו בפני עצמו אין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את יכול שאין לך לחם קרב לעצמו להקריבו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עם נזירות אחרת אין את יכול שאין לך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נזירות באה בלא לחם לפום כן צריך מימר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר לחמו של נזיר יורקב סברין מימר הוא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לחמו הוא מותר נסכיו אמר רבי יוסי בר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי בון מותר נסכיו קדשי קדשים אינון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויפלו לנדבה על דעתיה דרבי יוסי בר רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בון שמואל אליבא דרב חסדא במותר נסכים",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב חסדא ורבי אלעזר שלשתן אמרו דבר אחד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב חסדא אהן דאמרן שמואל דאמר רבי יוסי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עד דאנא תמן שמעית קל רבי יהודה שאיל",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשמואל הפריש שקלו ומת אמר ליה יפלו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לנדבה רבי אלעזר אומר מותר עשירית האיפה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלו רבי יוחנן אמר יוליכם לים המלח רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר אומר יפלו לנדבה <b>הלכה ה <big>מתני׳</big></b>",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר שבוים – לשבויים, מותר שבוי –",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לאותו שבוי. מותר עניים – לעניים, מותר",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עני – לאותו עני. מותר המתים – למתים,",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר המת – ליורשיו. רבי מאיר אומר:",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מותר המת יהא מונח עד שיבא אליהו. רבי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נתן אומר: מותר המת בונין לו נפש על",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קברו. <b>גמ׳</b> גבו לו בחזקת שאין לו ונמצא",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיש לו רבי ירמיה סבר מימר מותר המת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליורשיו אמר ליה רבי אידי דחוטרא הגע",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עצמך דלא כוונן אלא ליה אמר ליה אנא לא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמרית את מנן לך תני בשם רבי נתן מותר",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המת יבנה לו נפש על קברו ויעשה לו זילוף",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על גבי מטתו תני אין פודין שבוי בשבוי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואין גובין טלית בטלית ואין ממחין ביד",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרנסים לכך תני רבן שמעון בן גמליאל",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר אין עושין נפשות לצדיקים דבריהם הן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הן זכרונן רבי יוחנן הוה מסמיך ואזל עאל",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חייא בר אבא והיה רבי אליעזר חמי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה ומטמר ליה מקמיה ואמר הלין תרתי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלייהו הדין בבלאה עביד ביה חדא דלא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאיל בשלומיה וחדא מיטמר אמר ליה רבי",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יעקב בר אידי כך נהיגין גבהון דזעירא לא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שאיל בשלומיה דרבה דאינון נהגון",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומקיימין ראוני נערים ונחבאו וישישים",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קמו עמדו אמר ליה מהו למיעבר קמי דאדורא",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "צלמי אמר ליה מה את פליג ליה יקר עבור קמוהי וסמי עינוי אמר ליה יאות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "רבי אליעזר עביד דלא עבר קמך ועוד עביד הא בבלאה דלא אמר שמעתא משמיה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "נכנסו לפניו רבי אמי ורבי אסי אמרו לו רבי כך היה מעשה בבית הכנסת של",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "טרסיים בנגר שיש בראשו גלוסטרא שנחלקו",
      "segment_ids": [
        5
      ]
    }
  ],
