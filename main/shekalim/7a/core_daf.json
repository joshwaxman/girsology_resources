    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לחטאת והשאר לשאר נזירות ומת</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דמי חטאת ילכו לים המלח לא</b>",
      "gemara_segment_ids": [
