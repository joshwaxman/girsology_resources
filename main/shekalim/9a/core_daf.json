  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "הישנה אמר רבי יוחנן הדין דידן הוא ולמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרי ליה עתיקה מן בגין דהוה ביומי אית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמרי דהות זעירא ורבתיא ואית דאמרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאזעירא ולא אזעירא כמה דהות כמה הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיעור של כוס רבי יוסי בשם רבי יוסי בן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פזי ורבי יוסי בר ביבי בשם רבי שמואל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אצבעיים על אצבעיים על רום אצבע ומחצה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושליש אצבע (תני יבש כזית דברי רבי נתן)",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבנן דקיסרי ורבי יוסי בר ביבי בשם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל אתיא דרבי נתן כרבי שמעון כמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבי שמעון אמר ברביעית כן אמר רבי נתן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברביעית לכשיקרש ויהא בו כזית רבי סימון",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי יהושע בן לוי מעשה בפרדת רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמתה וטהרו את דמה משום נבילה ושאל רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אליעזר את רבי סימון עד כמה ולא אשגח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביה ושאל לרבי יהושע בן לוי ואמר ליה עד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רביעית טהור יותר מרביעית טמא ובאש לרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר על דלא חזר ליה רבי סימון שמועתא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב ביבי הוה יתיב מתני הדין עובדא אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה רבי יצחק בר כהנה עד רביעית טהור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יותר מכאן טמא ובעט ביה אמר ליה רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זריקא בגין דשאיל לך את בעט ביה אמר ליה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בגין דלא הות דעתי בי בעיטנא ביה דאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חנן והיו חייך תלואים לך מנגד זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלוקח חטים לשנה ופחדת לילה ויומם זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלוקח מן הסדקי ולא תאמין בחייך זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלוקח מן הפלטור ואנא סמיכנא אפלטור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומהו כדון העיד רבי יהושע בן פתורה על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דם נבילה שהוא טהור מהו טהור טהור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלהכשיר אבל לטמות מטמא תמן תנינן דם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השרץ כבשרו מטמא ואינו מכשיר ואין לנו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כיוצא בו ושיעור טומאתו שדמו מטמא כבשרו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יוסי פליגי בה תרין אמוראין חד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר טמא וחד אמר טהור מאן דאמר טמא כרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה ומאן דאמר טהור כרבי יהושע בן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פתורה אמר ליה רב אבדומה דמן נחותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויאות דרבי יהודה מוריינא דבי נשיאה הוה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמא יעני ויאמרו כו׳ תני רבי ישמעאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קווץ לא יתרום מפני החשד תני הגזברין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו מפספסין בקילקין תני מדברין היו עמו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משעה שהוא נכנס עד שעה שהוא יוצא וימלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פומיה מוי אמר רבי תנחומא מפני הברכה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמואל בר נחמן בשם רבי יונתן בתורה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובנביאים ובכתובים מצאנו שאדם צריך לצאת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידי הבריות כדרך שהוא צריך לצאת ידי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המקום בתורה מנין דכתיב והייתם נקיים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מה׳ ומישראל בנביאים מנין דכתיב אל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלהים ה׳ וגו׳ וישראל הוא ידע בכתובים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנין דכתיב ומצא חן ושכל טוב בעיני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלהים ואדם גמליאל זוגא שאל לרבי יוסי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר רבי בון איזהו המחוור שבכולם אמר ליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והייתם נקיים מה׳ ומישראל <b>הלכה ג <big>מתני׳</big></b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של בית רבן גמליאל היה נכנס ושקלו בין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אצבעותיו וזרקו לפני התורם, והתורם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתכוין ודחפו לתוך הקופה. אין התורם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורם עד שהוא אומר להם אתרום והן אומרין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו תרום תרום תרום שלש פעמים תרם את",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הראשונה וחיפה בקטבליאות השניה וחיפה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקטבליאות השלישית לא היה מחפה ולמה היה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחפה שמא ישכח ויתרום מן הדבר התרום תרם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הראשונה לשם ארץ ישראל והשניה לשם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרכים המוקפין לה והשלישית לשם בבל ולשם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מדי ולשם",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>לוג דאורייתא.</b> לוג הכתוב",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתורה: <b>תמונתא וכו'.</b> מדה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הישנה שמודדין בה המורייס",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בצפורי: <b>חכים אנא לה.</b> מכיר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אני המדה הזאת ודבית רבי ינאי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מודדין בה דבש. ה\"ג ודבית רבי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ינאי: <b>חצי שמינית.</b> מדת טבריה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הישנה היא רביעית של תורה:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הדא דידן הוות.</b> מדה שהיתה לנו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מקדמית: <b>ה\"ג ולמה לא קרי לה</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עתיקתא.</b> שהרי בזמן ההוא לא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היתה המדה ההיא וכבר עברה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והל\"ל הדא עתיקתא כדאמר ר\"ח",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאף ר\"י היה במקומו של ר\"ח:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומשני בגין דהוות ביומוי.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אע\"ג דכבר עברה מ\"מ אין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לקרותה ישנה כיון שהיתה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בימיו: <b>ה\"ג אית דאמרי דהוות</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>זעירא ורבת וזערת ולא זערת</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כמה דהוות.</b> וה\"פ בא לתרץ ולמה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אמר ר\"ח עתיקתא משום שנפחתה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מרביעית ואח\"כ הוסיפו עליה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואוקמוה ארביעית ואח\"כ פחתו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אותה ולא פחתו אותה כבראשונה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וזה היה בימי ר\"י הלכך לא מצי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למימר עתיקתא דס\"ד אמידה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפחותה קאמר ואי הוי הפחת",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפעם שני כמו בראשונה שפיר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "המ\"ל עתיקתא דאין לטעות",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמידה שנפחתה קאמר דא\"כ הל\"ל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הא דאית לן השתא היא מדה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רביעית וע\"כ היינו מפרשין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמידה גדולה קאמר אבל השתא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהמדה קטנה שבימיו לא היתה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשוה להמדה הקטנה שהיתה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בראשונה ודאי איכא למטעי דעל",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשונה הפחותה נאמר עתיקתא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לכך קאמר הדא דידן הוה כלומר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דהוות ביומוי קודם ולזו שהיה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להן עכשיו וליכא למיטעי: <b>ה\"ג</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תני יבש בכזית דברי רבי נתן.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וה\"פ אם הוציא לרה\"ר יין יבש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנקרש כזית חייב דמעיקרא הוי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רביעית והא דבעינן רביעית שלם",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בקרוש ולא סגי רביעית משום",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דקרוש לאו בר מזיגה הוא: <b>אתיא</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דר\"נ.</b> דאמר אף ביין רביעית",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעינן כר\"ש דמתניתין דאמר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כולן ברביעית ולית ליה לר\"י",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הא דאמרינן בסמוך דקרוש לאו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בר מזיגה הוא: <b>וטהרו דמה משום</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נבילה.</b> שלא היה בו רביעית וכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו רביעית לכשיקרש לא יהיה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו כזית ואין בו טומאת נבילה:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עד כמה.</b> דם היה בה שטהרו אותו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום נבילה: <b>ולא אשגח ביה.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא השיב לו ר' סימון דבר:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"ג ושאל לרבי יב\"ל וא\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכו': <b>ה\"ג ובאש לר\"א על דלא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> והרע לר\"א על ר' סימון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על שלא השיב לו על שאלתו:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתני הדין עובדא.</b> סיפר המעשה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(שחטו) [שמתה] הפרדות של בית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבי וטהר דמה משום נבילה: <b>א\"ל</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ר\"י בר ביסנא לר' סימון.</b> בדרך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאלה אם עד רביעית הוא דטיהרו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל יותר מכאן טמא או אפילו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יותר מרביעית טהור: <b>ובעט ביה.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבי סימון ודחף אותו בסנדלו.",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ל\"א גער בו: <b>א\"ל ר\"ז.</b> לר'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סימון משום דשאל לך דבר תורה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את מינזף ביה בתמיה: <b>א\"ל.</b> הא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלא השבתי לו כהוגן שלא היתה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דעתי מיושבת בעת ההיא: <b>זה שלוקח חטים לשנה.</b> שאין לו קרקע לזרוע והיינו חייו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תלואים שאינו יודע אם יהיו לו מעות לשנה הבאה: <b>ה\"ג סדקי.</b> מוכר תבואה למי שאין לו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וזה הלוקח אופה משבת לשבת ולילה ויומם רמז לשבת שהיום הולך אחר הלילה: <b>זה הלוקח</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מן הפלטר.</b> מן הנחתום שאולי לא יהא לו לנחתום למכור: <b>ואנא אפלטר סמיך.</b> ואין דעתי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מיושבת עלי להשיב לו: <b>ה\"ג ומאי כדון.</b> מאי הוי עלה אם יותר מרביעית טמא או טהור:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>העיד ריב\"ב.</b> מתניתין היא בפ\"ו דעדיות: <b>על דם נבלות שהוא טהור.</b> וקס\"ד טהור לגמרי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קאמר אפילו ביותר מרביעית: ופריך <b>מהו טהור.</b> שהוא טהור להכשיר הזרעים שאינו מכשיר",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אלא דם השותת בשעת שחיטה אבל לטמא מודה ריב\"ב שדם נבלות מטמא: <b>ומשני תמן תנינן.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "במכשירין פ\"ו: <b>ואין לנו כיוצא בו.</b> וקס\"ד שאין לנו דם כיוצא שאינו מכשיר ומטמא ש\"מ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דם נבלה אפילו טמויי לא מטמא: <b>ה\"ג ואין לנו כיוצא בו כשיעור טומאתו וכו'.</b> וה\"פ",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דקשיא ליה דלמא הא דאינו כיוצא בו היינו לענין שיטמא הדם כבשרו אלא השרץ שדמו נמי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מטמא בכעדשה ואפילו הדם צלול אבל דמו של נבלה מיהו מטמא כשהוא רביעית וטומאתו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מדרבנן דרביעית כשיקרוש יעמוד על כזית ומתחלף בנבלה ממש: <b>מ\"ד טמא.</b> והיינו ריב\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דלעיל כר\"י דאמר בפ\"ד דעדיות שב\"ה מטמאין דם נבלה: <b>ומ\"ד טהור.</b> דהיינו מתניתין",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמכשירין כר\"י בן בתירא: <b>ה\"ג א\"ל רב אבדומי דמן נחותה יאות.</b> ושפיר קאמרת דר\"י הוא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דמטמא דרבי יהודה מורה הוראות דבי נשיאה הוי שהרי פרדות של בית רבי היה ור\"י הורה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דיתר מרביעית טמא כשמעתתיה: <b>קווץ.</b> מי שהוא בעל שיער לא יתרום שמא יביא בשערו",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וקווץ הוא מלשון קווצותיו תלתלים ורמב\"ם פירש עני ונבהל להון מלשון קצתי בחיי:",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>היו מפספסין בקילקין.</b> היו משפשפין בשיער התורם אם היו שערותיו דבוקים מחמת זיעה",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וצואה. ל\"א קילקי הוא חלוק של צמר שיש לו נימין וכשהיה התורם לבוש בחלוק כזה היו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מפרידין אותן הנימין שלא יחשדנו שהטמין המעות בתוכו: <b>מדברין היו עם התורם.</b> כדי",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שלא יתן דבר בתוך פיו: ופריך <b>וימלא פומיה מוי.</b> היה לו למלאות פיו מים ולא היו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "צריכין לדבר עמו: <b>מפני הברכה.</b> שחייב התורם לברך על התרומה כדרך שמברכין על הפרשת",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תרומת הגורן: <b>איזהו המחוור שבכולן.</b> איזהו מהפסוקים מבורר ומפורש שבכולן שצריך",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לנקות עצמו לפני בני אדם: מתני' <b>וזורקו לפני התורם.</b> מתכוונים היו שיפלו שקליהם",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לתוך הקופה ויקנו מהם קרבנות ציבור ולא יהיו משירי הלשכה: <b>שלשה פעמים על כל פעם</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ופעם היה אומר אתרום והם אומרים תרום.</b> וכן דרך לשון חכמים להיות משולש: <b>תרם את</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הראשונה.</b> הקופות הגדולות של ט' סאין שתרם מן הלשכה היו מכוסות במטפחות ואחר כך",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כשתרם מהן בקופות הקטנות של ג' סאין היה תורם הקופה הקטנה שכתוב עליה א' מאחת",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מקופות הגדולות ומכסה אותה במטפחת ואח\"כ מגלה הקופה הגדולה השניה וממלא ממנה קופה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הקטנה שכתוב עליה ב' ומכסה אותה וכן בשלישית אלא שלא היה מכסה אותה לסימן שממנה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יתחיל בפרוס העצרת: <b>הראשונה לשם א\"י.</b> שהן שלחו שקליהם תחלה: <b>ושנייה לשום כרכים</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>המוקפין.</b> כגון עמון ומואב ומיהו בכל פעם היו תורמין על שם כל ישראל על הגבוי ועל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "העתיד לגבות ולא הזכיר התנא חלוקי מקומות הללו אלא להודיען שתקנו ג' פרקים אלו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "כדי שיתנו מקומות הרחוקות על לבן וישלחו שקניהן:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
