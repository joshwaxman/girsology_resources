      "printed_body_y": [
        127.8,
        793.1
      ],
      "note_he": "תוספת שלנו. פני משה אינו נדפס בדף זה כלל — במלבן הזה הדפיסו תקלין חדתין, שאינו מצוי במהדורה דיגיטלית. הטקסט מספריא (פיוטרקוב תרנ״ח–תר״ס), ואינו חלק מצורת הדף הנדפסת.",
      "note_en": "OUR ADDITION. Penei Moshe is not printed on this leaf at all — this rectangle is where the press set Tiklin Chadtin, which is in no digital edition. The text is Sefaria's (Piotrków, 1898-1900) and is not part of the printed page.",
      "printed_work_he": "תקלין חדתין",
      "printed_work_en": "Tiklin Chadtin",
      "source_ref": "Penei Moshe on Jerusalem Talmud Shekalim",
      "lines": [
        {
          "width": "216px",
          "text": "<b>שמא יעני וכו' תני ר'</b>"
        },
        {
          "width": "216px",
          "text": "<b>ישמעאל קיווץ לא יתרום.</b>"
        },
        {
          "width": "216px",
          "text": "מי ששערות ראשו כמו"
        },
        {
          "width": "216px",
          "text": "קווצות תלתלים לא יתרום"
        },
        {
          "width": "216px",
          "text": "מפני החשד שיאמרו זה יכול"
        },
        {
          "width": "216px",
          "text": "להטמין המעות בשערו: <b>היו</b>"
        },
        {
          "width": "216px",
          "text": "<b>מפספסין בקילקין.</b> קלקין"
        },
        {
          "width": "216px",
          "text": "הן השערות שמסתבכין יחד"
        },
        {
          "width": "216px",
          "text": "ונעשו כעין שרשרות וכמו"
        },
        {
          "width": "216px",
          "text": "שנשנה בפ\"ט דמקואות קלקי"
        },
        {
          "width": "216px",
          "text": "הלב והזקן קלקי הראש ובית"
        },
        {
          "width": "216px",
          "text": "השחי ואם היו כך בהתורם"
        },
        {
          "width": "216px",
          "text": "היו הגזברין מפספסין את"
        },
        {
          "width": "216px",
          "text": "הקילקין אלו קודם שיתרום:"
        },
        {
          "width": "216px",
          "text": "<b>תני.</b> בתוספתא פ\"ב נכנס"
        },
        {
          "width": "216px",
          "text": "לתרום את הלשכה היו"
        },
        {
          "width": "216px",
          "text": "מפשפשין בו בכניסה ויציאה"
        },
        {
          "width": "216px",
          "text": "ומדברין עמו משעה שנכנס"
        },
        {
          "width": "216px",
          "text": "וכו' לקיים מה שנאמר"
        },
        {
          "width": "216px",
          "text": "והייתם נקיים מה'"
        },
        {
          "width": "216px",
          "text": "ומישראל: <b>וימלא פומיה</b>"
        },
        {
          "width": "216px",
          "text": "<b>מוי.</b> הלא זה הטעם שמדברין"
        },
        {
          "width": "216px",
          "text": "עמו כדי שלא יאמרו מטמין"
        },
        {
          "width": "216px",
          "text": "הוא את המעות בפיו וימלא"
        },
        {
          "width": "216px",
          "text": "פיו מים קודם שיכנס לתרום"
        },
        {
          "width": "216px",
          "text": "ולא יהו צריכין לדבר עמו"
        },
        {
          "width": "216px",
          "text": "כל הזמן הזה שהרי מעתה"
        },
        {
          "width": "216px",
          "text": "אינו יכול להטמין בפיו"
        },
        {
          "width": "216px",
          "text": "כלום: <b>אמר ר' תנחומא מפני</b>"
        },
        {
          "width": "216px",
          "text": "<b>הברכה.</b> שהרי צריך הוא"
        },
        {
          "width": "216px",
          "text": "לברך קודם שיתרום וכמו"
        },
        {
          "width": "216px",
          "text": "ששנינו בתוספתא שלפני כל"
        },
        {
          "width": "216px",
          "text": "התרומות היו צריכין לברך"
        },
        {
          "width": "216px",
          "text": "והלכך אי אפשר שימלא פיו"
        },
        {
          "width": "216px",
          "text": "במים: <b>בתורה ובנביאים</b>"
        },
        {
          "width": "216px",
          "text": "<b>ובכתובים מצינו.</b> רמז לזה"
        },
        {
          "width": "216px",
          "text": "שאדם צריך לצאת ידי"
        },
        {
          "width": "216px",
          "text": "הבריות וכו': <b>איזהו</b>"
        },
        {
          "width": "216px",
          "text": "<b>המחוור שבכולן.</b> שממנו"
        },
        {
          "width": "216px",
          "text": "נלמד ביותר וא\"ל מן הכתוב"
        },
        {
          "width": "216px",
          "text": "שבתורה והייתם נקיים וגו'"
        },
        {
          "width": "216px",
          "text": "ומפני שבו נרמז שצריך"
        },
        {
          "width": "216px",
          "text": "לעשות שיהא נקי מכל צדדי"
        },
        {
          "width": "216px",
          "text": "החשד מן הבריות כשם שהוא"
        },
        {
          "width": "216px",
          "text": "נקי מה' אשר לו נגלו כל"
        },
        {
          "width": "216px",
          "text": "המצפונות והנסתרות וכך"
        },
        {
          "width": "216px",
          "text": "יהא נקי מן ידי הבריות"
        },
        {
          "width": "216px",
          "text": "שלא יוכלו לומר אפשר הוא"
        },
        {
          "width": "216px",
          "text": "עושה כך או כך וכשיראה"
        },
        {
          "width": "216px",
          "text": "להתנהג בכדי שלא יליזו"
        },
        {
          "width": "216px",
          "text": "עליו מכל ומכל אז הוא נקי"
        },
        {
          "width": "216px",
          "text": "מה' ומישראל מבלתי פינות"
        },
        {
          "width": "216px",
          "text": "החשד: מתני' <b>של בית רבן</b>"
        },
        {
          "width": "216px",
          "text": "<b>גמליאל.</b> היו נוהגין שהי'"
        },
        {
          "width": "216px",
          "text": "נכנס ושקלו בין אצבעותיו"
        },
        {
          "width": "216px",
          "text": "וזורקו לפני התורם וכדי"
        },
        {
          "width": "216px",
          "text": "שיהא התורם מתכוין ודוחקו"
        },
        {
          "width": "216px",
          "text": "לשקלו להקופה שתורמין"
        },
        {
          "width": "216px",
          "text": "ממנה באותו הזמן ולהסתפק"
        },
        {
          "width": "216px",
          "text": "לקנות קרבנות הציבור ונחת"
        },
        {
          "width": "216px",
          "text": "רוח היא להם כדי שיתקרב"
        },
        {
          "width": "216px",
          "text": "משלהן תחלה כדקאמר בגמרא:"
        },
        {
          "width": "216px",
          "text": "<b>אין התורם תורם.</b> עד שיטול"
        },
        {
          "width": "216px",
          "text": "רשות ויאמר להם להעומדים"
        },
        {
          "width": "216px",
          "text": "שם אתרום והן אומרים לו"
        },
        {
          "width": "216px",
          "text": "תרום וכו' שלשה פעמים שכן"
        },
        {
          "width": "216px",
          "text": "דרך לענות ג' פעמים"
        },
        {
          "width": "216px",
          "text": "כדמצינו בפרק רבי ישמעאל"
        },
        {
          "width": "216px",
          "text": "במנחות גבי העומר אקצור"
        },
        {
          "width": "216px",
          "text": "ואומרים לו קצור קצור"
        },
        {
          "width": "216px",
          "text": "קצור ג' פעמים: מתני' <b>תרם</b>"
        },
        {
          "width": "216px",
          "text": "<b>את הראשונה.</b> כשתורם בתחלה"
        },
        {
          "width": "216px",
          "text": "באלו שלשה קופות קטנות"
        },
        {
          "width": "216px",
          "text": "מאלו שלשה קופות גדולות"
        },
        {
          "width": "216px",
          "text": "כמו שאמרנו לעיל בהלכה ב'"
        },
        {
          "width": "216px",
          "text": "תורם הוא בקופה הראשונה"
        },
        {
          "width": "216px",
          "text": "מן הקופה הגדולה הראשונה"
        },
        {
          "width": "216px",
          "text": "וחופה את הגדולה בקטבליות"
        },
        {
          "width": "216px",
          "text": "והיא במטפחת של עור שלוק"
        },
        {
          "width": "216px",
          "text": "וכן השנייה שהוא תורם מן"
        },
        {
          "width": "216px",
          "text": "הקופה הגדולה השניה ומחפה"
        },
        {
          "width": "216px",
          "text": "את הגדולה השניה במטפחת"
        },
        {
          "width": "216px",
          "text": "ותורם השלישית מן הקופה"
        },
        {
          "width": "216px",
          "text": "הגדולה השלישית ואותה"
        },
        {
          "width": "216px",
          "text": "קופה גדולה השלישית לא"
        },
        {
          "width": "216px",
          "text": "היה מחפה אותה כדי שתהא"
        },
        {
          "width": "216px",
          "text": "ניכרת שבה הוא שסיים"
        },
        {
          "width": "216px",
          "text": "ויתחיל ממנה בתחלה בפרק"
        },
        {
          "width": "216px",
          "text": "השני של הג' פרקים שהוא"
        },
        {
          "width": "216px",
          "text": "פרס העצרת וכדמפרש התנא"
        },
        {
          "width": "216px",
          "text": "ואזיל: <b>ולמה היה מחפה.</b>"
        },
        {
          "width": "216px",
          "text": "אלו הראשונות וזאת"
        },
        {
          "width": "216px",
          "text": "השלישית לא היה מחפה שמא"
        },
        {
          "width": "216px",
          "text": "ישכח ויתרום אחר כך בפרס"
        },
        {
          "width": "216px",
          "text": "העצרת ויתרום מן הדבר"
        },
        {
          "width": "216px",
          "text": "התרום וכלומר שמא יתחיל"
        },
        {
          "width": "216px",
          "text": "לתרום כבראשונה בתחלה מן"
        },
        {
          "width": "216px",
          "text": "הראשונה אחר כך מהשניה"
        },
        {
          "width": "216px",
          "text": "ואח\"כ מהשלישית והוא צריך"
        },
        {
          "width": "216px",
          "text": "להתחיל עכשיו מהשלישית"
        },
        {
          "width": "216px",
          "text": "שסיים בה בתרומה הראשונה"
        },
        {
          "width": "216px",
          "text": "ולפיכך היה מחפה אותן"
        },
        {
          "width": "216px",
          "text": "השנים הראשונות והשלישית"
        },
        {
          "width": "216px",
          "text": "לא היה מחפה כדי שיהא לו"
        },
        {
          "width": "216px",
          "text": "לסימן אחר כך ולהתחיל"
        },
        {
          "width": "216px",
          "text": "ממנה בתחלה. וכיצד היה"
        },
        {
          "width": "216px",
          "text": "נוהג אח\"כ בתרומה השניה"
        },
        {
          "width": "216px",
          "text": "מפרשינן בגמ': <b>תרם את</b>"
        },
        {
          "width": "216px",
          "text": "<b>הראשונה.</b> מג' קופות האלו"
        },
        {
          "width": "216px",
          "text": "לשם ארץ ישראל ובשניה"
        },
        {
          "width": "216px",
          "text": "מוסיף לשם כרכים המוקפין"
        },
        {
          "width": "216px",
          "text": "וסמוכין לה ולשם כל א\"י"
        },
        {
          "width": "216px",
          "text": "ובשלישית לשם בבל וכו'"
        },
        {
          "width": "216px",
          "text": "ולשם כל א\"י וה\"ק בגמרא:"
        }
      ],
      "font_size": 16,
      "line_gap": 24.0,
      "rendered_lines": 114,
      "overshoot": 1.34,
