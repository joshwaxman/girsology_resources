  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "הישנה אמר רבי יוחנן הדין דידן הוא ולמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קרי ליה עתיקה מן בגין דהוה ביומי אית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאמרי דהות זעירא ורבתיא ואית דאמרי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דאזעירא ולא אזעירא כמה דהות כמה הוא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שיעור של כוס רבי יוסי בשם רבי יוסי בן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פזי ורבי יוסי בר ביבי בשם רבי שמואל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אצבעיים על אצבעיים על רום אצבע ומחצה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ושליש אצבע (תני יבש כזית דברי רבי נתן)",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבנן דקיסרי ורבי יוסי בר ביבי בשם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמואל אתיא דרבי נתן כרבי שמעון כמה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דרבי שמעון אמר ברביעית כן אמר רבי נתן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ברביעית לכשיקרש ויהא בו כזית רבי סימון",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשם רבי יהושע בן לוי מעשה בפרדת רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמתה וטהרו את דמה משום נבילה ושאל רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אליעזר את רבי סימון עד כמה ולא אשגח",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביה ושאל לרבי יהושע בן לוי ואמר ליה עד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רביעית טהור יותר מרביעית טמא ובאש לרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלעזר על דלא חזר ליה רבי סימון שמועתא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב ביבי הוה יתיב מתני הדין עובדא אמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ליה רבי יצחק בר כהנה עד רביעית טהור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יותר מכאן טמא ובעט ביה אמר ליה רבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זריקא בגין דשאיל לך את בעט ביה אמר ליה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בגין דלא הות דעתי בי בעיטנא ביה דאמר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי חנן והיו חייך תלואים לך מנגד זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלוקח חטים לשנה ופחדת לילה ויומם זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלוקח מן הסדקי ולא תאמין בחייך זה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הלוקח מן הפלטור ואנא סמיכנא אפלטור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומהו כדון העיד רבי יהושע בן פתורה על",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דם נבילה שהוא טהור מהו טהור טהור",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מלהכשיר אבל לטמות מטמא תמן תנינן דם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "השרץ כבשרו מטמא ואינו מכשיר ואין לנו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כיוצא בו ושיעור טומאתו שדמו מטמא כבשרו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי יוסי פליגי בה תרין אמוראין חד",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר טמא וחד אמר טהור מאן דאמר טמא כרבי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יהודה ומאן דאמר טהור כרבי יהושע בן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פתורה אמר ליה רב אבדומה דמן נחותה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ויאות דרבי יהודה מוריינא דבי נשיאה הוה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שמא יעני ויאמרו כו׳ תני רבי ישמעאל",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קווץ לא יתרום מפני החשד תני הגזברין",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היו מפספסין בקילקין תני מדברין היו עמו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "משעה שהוא נכנס עד שעה שהוא יוצא וימלא",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פומיה מוי אמר רבי תנחומא מפני הברכה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי שמואל בר נחמן בשם רבי יונתן בתורה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ובנביאים ובכתובים מצאנו שאדם צריך לצאת",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ידי הבריות כדרך שהוא צריך לצאת ידי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המקום בתורה מנין דכתיב והייתם נקיים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מה׳ ומישראל בנביאים מנין דכתיב אל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלהים ה׳ וגו׳ וישראל הוא ידע בכתובים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנין דכתיב ומצא חן ושכל טוב בעיני",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אלהים ואדם גמליאל זוגא שאל לרבי יוסי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בר רבי בון איזהו המחוור שבכולם אמר ליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והייתם נקיים מה׳ ומישראל <b>הלכה ג <big>מתני׳</big></b>",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של בית רבן גמליאל היה נכנס ושקלו בין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אצבעותיו וזרקו לפני התורם, והתורם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתכוין ודחפו לתוך הקופה. אין התורם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תורם עד שהוא אומר להם אתרום והן אומרין",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לו תרום תרום תרום שלש פעמים תרם את",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הראשונה וחיפה בקטבליאות השניה וחיפה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקטבליאות השלישית לא היה מחפה ולמה היה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מחפה שמא ישכח ויתרום מן הדבר התרום תרם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "את הראשונה לשם ארץ ישראל והשניה לשם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרכים המוקפין לה והשלישית לשם בבל ולשם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מדי ולשם",
      "segment_ids": [
        4
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לוג דאורייתא.</b> לוג הכתוב בתורה: <b>תמונתא וכו'.</b> מדה הישנה שמודדין בה המורייס בצפורי: <b>חכים אנא לה.</b> מכיר אני המדה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הזאת ודבית רבי ינאי מודדין בה דבש. ה\"ג ודבית רבי ינאי: <b>חצי שמינית.</b> מדת טבריה הישנה היא רביעית של תורה: <b>הדא דידן</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>הוות.</b> מדה שהיתה לנו מקדמית: <b>ה\"ג ולמה לא קרי לה עתיקתא.</b> שהרי בזמן ההוא לא היתה המדה ההיא וכבר עברה והל\"ל הדא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עתיקתא כדאמר ר\"ח דאף ר\"י היה במקומו של ר\"ח: <b>ומשני בגין דהוות ביומוי.</b> אע\"ג דכבר עברה מ\"מ אין לקרותה ישנה כיון",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהיתה בימיו: <b>ה\"ג אית דאמרי</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>דהוות זעירא ורבת וזערת ולא</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>זערת כמה דהוות.</b> וה\"פ בא לתרץ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולמה אמר ר\"ח עתיקתא משום",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנפחתה מרביעית ואח\"כ הוסיפו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליה ואוקמוה ארביעית ואח\"כ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פחתו אותה ולא פחתו אותה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כבראשונה וזה היה בימי ר\"י",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלכך לא מצי למימר עתיקתא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דס\"ד אמידה הפחותה קאמר ואי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הוי הפחת בפעם שני כמו",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בראשונה שפיר המ\"ל עתיקתא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאין לטעות דאמידה שנפחתה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמר דא\"כ הל\"ל הא דאית לן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השתא היא מדה רביעית וע\"כ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו מפרשין דאמידה גדולה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קאמר אבל השתא דהמדה קטנה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבימיו לא היתה בשוה להמדה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקטנה שהיתה בראשונה ודאי",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איכא למטעי דעל הראשונה",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הפחותה נאמר עתיקתא לכך קאמר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדא דידן הוה כלומר דהוות",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביומוי קודם ולזו שהיה להן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עכשיו וליכא למיטעי: <b>ה\"ג תני</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>יבש בכזית דברי רבי נתן.</b> וה\"פ",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אם הוציא לרה\"ר יין יבש שנקרש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כזית חייב דמעיקרא הוי רביעית",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והא דבעינן רביעית שלם בקרוש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא סגי רביעית משום דקרוש",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לאו בר מזיגה הוא: <b>אתיא דר\"נ.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמר אף ביין רביעית בעינן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כר\"ש דמתניתין דאמר כולן",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברביעית ולית ליה לר\"י הא",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמרינן בסמוך דקרוש לאו בר",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מזיגה הוא: <b>וטהרו דמה משום</b>",
      "gemara_segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נבילה.</b> שלא היה בו רביעית וכל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאינו רביעית לכשיקרש לא יהיה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בו כזית ואין בו טומאת נבילה:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>עד כמה.</b> דם היה בה שטהרו אותו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משום נבילה: <b>ולא אשגח ביה.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא השיב לו ר' סימון דבר:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"ג ושאל לרבי יב\"ל וא\"ל",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכו': <b>ה\"ג ובאש לר\"א על דלא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> והרע לר\"א על ר' סימון",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "על שלא השיב לו על שאלתו:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>מתני הדין עובדא.</b> סיפר המעשה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "(שחטו) [שמתה] הפרדות של בית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבי וטהר דמה משום נבילה: <b>א\"ל</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ר\"י בר ביסנא לר' סימון.</b> בדרך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שאלה אם עד רביעית הוא דטיהרו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אבל יותר מכאן טמא או אפילו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יותר מרביעית טהור: <b>ובעט ביה.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רבי סימון ודחף אותו בסנדלו.",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ל\"א גער בו: <b>א\"ל ר\"ז.</b> לר'",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "סימון משום דשאל לך דבר תורה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "את מינזף ביה בתמיה: <b>א\"ל.</b> הא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלא השבתי לו כהוגן שלא היתה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דעתי מיושבת בעת ההיא: <b>זה</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלוקח חטים לשנה.</b> שאין לו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרקע לזרוע והיינו חייו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תלואים שאינו יודע אם יהיו לו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעות לשנה הבאה: <b>ה\"ג סדקי.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מוכר תבואה למי שאין לו וזה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלוקח אופה משבת לשבת ולילה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויומם רמז לשבת שהיום הולך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אחר הלילה: <b>זה הלוקח מן</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הפלטר.</b> מן הנחתום שאולי לא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהא לו לנחתום למכור: <b>ואנא</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אפלטר סמיך.</b> ואין דעתי מיושבת",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עלי להשיב לו: <b>ה\"ג ומאי כדון.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מאי הוי עלה אם יותר מרביעית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "טמא או טהור: <b>העיד ריב\"ב.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מתניתין היא בפ\"ו דעדיות: <b>על</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>דם נבלות שהוא טהור.</b> וקס\"ד טהור לגמרי קאמר אפילו ביותר מרביעית: ופריך <b>מהו טהור.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהוא טהור להכשיר הזרעים שאינו מכשיר אלא דם השותת בשעת שחיטה אבל לטמא מודה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ריב\"ב שדם נבלות מטמא: <b>ומשני תמן תנינן.</b> במכשירין פ\"ו: <b>ואין לנו כיוצא בו.</b> וקס\"ד",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שאין לנו דם כיוצא שאינו מכשיר ומטמא ש\"מ דם נבלה אפילו טמויי לא מטמא: <b>ה\"ג ואין</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לנו כיוצא בו כשיעור טומאתו וכו'.</b> וה\"פ דקשיא ליה דלמא הא דאינו כיוצא בו היינו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לענין שיטמא הדם כבשרו אלא השרץ שדמו נמי מטמא בכעדשה ואפילו הדם צלול אבל דמו של",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נבלה מיהו מטמא כשהוא רביעית וטומאתו מדרבנן דרביעית כשיקרוש יעמוד על כזית",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ומתחלף בנבלה ממש: <b>מ\"ד טמא.</b> והיינו ריב\"ל דלעיל כר\"י דאמר בפ\"ד דעדיות שב\"ה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מטמאין דם נבלה: <b>ומ\"ד טהור.</b> דהיינו מתניתין דמכשירין כר\"י בן בתירא: <b>ה\"ג א\"ל רב</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>אבדומי דמן נחותה יאות.</b> ושפיר קאמרת דר\"י הוא דמטמא דרבי יהודה מורה הוראות דבי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נשיאה הוי שהרי פרדות של בית רבי היה ור\"י הורה דיתר מרביעית טמא כשמעתתיה: <b>קווץ.</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מי שהוא בעל שיער לא יתרום שמא יביא בשערו וקווץ הוא מלשון קווצותיו תלתלים",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ורמב\"ם פירש עני ונבהל להון מלשון קצתי בחיי: <b>היו מפספסין בקילקין.</b> היו משפשפין",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשיער התורם אם היו שערותיו דבוקים מחמת זיעה וצואה. ל\"א קילקי הוא חלוק של צמר",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שיש לו נימין וכשהיה התורם לבוש בחלוק כזה היו מפרידין אותן הנימין שלא יחשדנו",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהטמין המעות בתוכו: <b>מדברין היו עם התורם.</b> כדי שלא יתן דבר בתוך פיו: ופריך <b>וימלא</b>",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>פומיה מוי.</b> היה לו למלאות פיו מים ולא היו צריכין לדבר עמו: <b>מפני הברכה.</b> שחייב",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "התורם לברך על התרומה כדרך שמברכין על הפרשת תרומת הגורן: <b>איזהו המחוור שבכולן.</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "איזהו מהפסוקים מבורר ומפורש שבכולן שצריך לנקות עצמו לפני בני אדם: מתני' <b>וזורקו</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לפני התורם.</b> מתכוונים היו שיפלו שקליהם לתוך הקופה ויקנו מהם קרבנות ציבור ולא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "יהיו משירי הלשכה: <b>שלשה פעמים על כל פעם ופעם היה אומר אתרום והם אומרים תרום.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכן דרך לשון חכמים להיות משולש: <b>תרם את הראשונה.</b> הקופות הגדולות של ט' סאין שתרם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מן הלשכה היו מכוסות במטפחות ואחר כך כשתרם מהן בקופות הקטנות של ג' סאין היה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "תורם הקופה הקטנה שכתוב עליה א' מאחת מקופות הגדולות ומכסה אותה במטפחת ואח\"כ",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "מגלה הקופה הגדולה השניה וממלא ממנה קופה הקטנה שכתוב עליה ב' ומכסה אותה וכן",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בשלישית אלא שלא היה מכסה אותה לסימן שממנה יתחיל בפרוס העצרת: <b>הראשונה לשם א\"י.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שהן שלחו שקליהם תחלה: <b>ושנייה לשום כרכים המוקפין.</b> כגון עמון ומואב ומיהו בכל פעם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היו תורמין על שם כל ישראל על הגבוי ועל העתיד לגבות ולא הזכיר התנא חלוקי מקומות",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הללו אלא להודיען שתקנו ג' פרקים אלו כדי שיתנו מקומות הרחוקות על לבן וישלחו",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "שקניהן:",
      "gemara_segment_ids": [
        4
      ]
    }
  ],
