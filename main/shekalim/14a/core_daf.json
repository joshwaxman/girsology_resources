  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "האי דין כיף מקורר מיא והאי דין כיף אית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביה שרברובי ועד היכן שרברובותיה מטיא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי אליעזר ומת בנו בצמא אמר רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנינא מאן דאמר רחמנא וותרן יתוותרן בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעויי אלא מאריך רוחיה וגבי דידיה אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אחא כתיב וסביביו נשערה מאוד מדקדק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עמהן כחוט השערה אמר רבי יוסי לא מטעם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הזה אלא מן מה דכתיב ונורא הוא על כל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סביביו מוראו על הקרובים יותר מן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרחוקים רבי חגיי בשם רבי שמואל בר נחמן",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעשה בחסיד אחד שהיה חופר בורות שיחין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומערות לעוברים ושבים פעם אחת היתה בתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עוברת להנשא ושטפה נהר והוון כל עמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עללין לגבי בעון מנחמתיה ולא קיבל עלוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתנחמא עאל רבי פנחס בן יאיר לגביה בעי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנחמתיה ולא קיבל עלוי מתנחמא אמר לון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דין הוא חסידכון אמרו ליה רבי כך וכך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היה עושה וכך וכך אירע ליה אמר אפשר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיה מכבד את בוראו במים והוא מקפחו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במים מיד נפלה הברה בעיר באת בתו של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו האיש אית דאמרי בסוכתא איתערית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואית דאמרי מלאך ירד כדמות רבי פנחס בן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יאיר והצילה גביני כרוז שהיה מכריז בבית",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המקדש מה היה אומר עמדו הכהנים לעבודה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולויים לדוכנן וישראל למעמדן אגריפס",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המלך שמע קולו עד שמונה פרסאות ונתן לו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתנות הרבה בן גבר על נעילת שערים תירגם",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב קומי דבית רבי שילא קרא גברא אכריז",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרוזא אמר ליה אמור קרא תרנגולא אמר ליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והתנינן בן גבר אית לך למימר בר תרנגולא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן בבי על הפקיע שהיה מזייג פתילות רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי עאל לכופרה בעו ממנייא עלייהון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרנסים ולא קיבלון מינהן עאל ואמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קומיהון בן בבי על הפקיע ומה אם זה",
