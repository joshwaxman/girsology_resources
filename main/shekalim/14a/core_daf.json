    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יומם ועשן וגו' ועשן זה ע\"כ",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה כמעלה עשן דאל\"כ האיך",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ישבו בחופה מפני העשן אלא",
