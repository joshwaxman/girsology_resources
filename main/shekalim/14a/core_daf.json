      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכתובים בה סמני הקטורת איך",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להכירם וסדר פיטומו: <b>מעתה אין</b>",
      "gemara_segment_ids": [
        9
      ]
    },
