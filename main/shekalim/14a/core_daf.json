  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "האי דין כיף מקורר מיא והאי דין כיף אית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביה שרברובי ועד היכן שרברובותיה מטיא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמר רבי אליעזר ומת בנו בצמא אמר רבי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חנינא מאן דאמר רחמנא וותרן יתוותרן בני",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעויי אלא מאריך רוחיה וגבי דידיה אמר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי אחא כתיב וסביביו נשערה מאוד מדקדק",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עמהן כחוט השערה אמר רבי יוסי לא מטעם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הזה אלא מן מה דכתיב ונורא הוא על כל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סביביו מוראו על הקרובים יותר מן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרחוקים רבי חגיי בשם רבי שמואל בר נחמן",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעשה בחסיד אחד שהיה חופר בורות שיחין",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ומערות לעוברים ושבים פעם אחת היתה בתו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עוברת להנשא ושטפה נהר והוון כל עמא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עללין לגבי בעון מנחמתיה ולא קיבל עלוי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתנחמא עאל רבי פנחס בן יאיר לגביה בעי",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מנחמתיה ולא קיבל עלוי מתנחמא אמר לון",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דין הוא חסידכון אמרו ליה רבי כך וכך",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "היה עושה וכך וכך אירע ליה אמר אפשר",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שהיה מכבד את בוראו במים והוא מקפחו",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במים מיד נפלה הברה בעיר באת בתו של",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אותו האיש אית דאמרי בסוכתא איתערית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ואית דאמרי מלאך ירד כדמות רבי פנחס בן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יאיר והצילה גביני כרוז שהיה מכריז בבית",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המקדש מה היה אומר עמדו הכהנים לעבודה",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ולויים לדוכנן וישראל למעמדן אגריפס",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המלך שמע קולו עד שמונה פרסאות ונתן לו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מתנות הרבה בן גבר על נעילת שערים תירגם",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רב קומי דבית רבי שילא קרא גברא אכריז",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כרוזא אמר ליה אמור קרא תרנגולא אמר ליה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והתנינן בן גבר אית לך למימר בר תרנגולא",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בן בבי על הפקיע שהיה מזייג פתילות רבי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יוסי עאל לכופרה בעו ממנייא עלייהון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "פרנסים ולא קיבלון מינהן עאל ואמר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קומיהון בן בבי על הפקיע ומה אם זה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שנתמנה על הפתילות זכה להימנות עם גדולי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הדור אתם שאתם נתמנין על חיי נפשות לא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל שכן בן ארזה על הצלצל כי הא דתנינן",
      "segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תמן הניף הסגן בסודרין והקיש בן ארזה על",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הצלצל הוגרס בן לוי על השיר אמר רבי אחא",
      "segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נעימה יתירה היה יודע ואמרו עליו על",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הוגרס בן לוי שהיה מנעים את קולו בזמר",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכשהיה נועץ גודלו בתוך פיו היה מוציא",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כמה מיני זמר והיו כל אחיו הכהנים",
      "segment_ids": [
        6
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נזקרין לו בבת ראש בית גרמו על מעשה לחם",
      "segment_ids": [
        6,
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפנים בית גרמו היו בקיאין במעשה לחם",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הפנים וברדייתו ולא רצו ללמד שלחו חכמים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והביאו אומנים מאלכסנדריאה שהיו בקיאין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "במעשה לחם הפנים וברדייתו לא היו בקיאין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בית גרמו היו מסיקין מבפנים ורודין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מבחוץ ולא היתה מתעפשת ואלו היו מסיקין",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מבפנים ורודין מבפנים והיתה מתעפשת כיון",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שידעו חכמים בדבר הזה אמרו כל מה שברא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הקדוש ברוך הוא לכבודו ברא שנאמר כל פעל",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ה׳ למענהו שלחו אחריהם ולא רצו לבא עד",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכפלו להם שכרן שנים עשר מנה היו נוטלים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונתנו להם עשרים וארבעה רבי יהודה אומר",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עשרים וארבעה היו נוטלים ונתנו להן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ארבעים ושמונה אמרו להן מפני מה אין אתם",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רוצים ללמד אמרו להן מסורת היא בידינו",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאבותינו שהבית הזה עתיד ליחרב שלא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ילמדו אחרים ויעשו לפני עבודה זרה שלהן",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בדברים הללו מזכירין אותן לשבח שלא יצא",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ביד בניהם פת נקיה מעולם שלא יהו אומרים",
      "segment_ids": [
        7
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ממעשה לחם הפנים הן אוכלים בית אבטינס",
      "segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על מעשה הקטורת של בית אבטינס היו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בקיאין על מעשי פיטום הקטורת ובמעלה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העשן ולא רצו ללמד שלחו והביאו אומנין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מאלכסנדריאה של מצרים והיו בקיאין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בפיטום הקטורת ובמעלה עשן לא היו בקיאין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "של בית אבטינס היתה מתמרת ועולה כמקל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ופוסה ויורדת ושל אלו היתה פוסה מיד כיון שידעו חכמים בדבר אמרו כל מה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שברא הקדוש ברוך הוא לכבודו ברא שנאמר כל הנקרא בשמי לכבודי בראתיו וגו׳",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "שלחו אחריהם ולא רצו לבא עד שכפלו להן שכרן שנים עשר מנה היו נוטלין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "ונתנו להן עשרים וארבעה רבי יהודה אומר עשרים וארבעה היו נוטלין ונתנו",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "להן ארבעים ושמונה אמרו להן מפני מה אין אתם רוצין ללמד אמרו להן מסורת",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "היא בידינו מאבותינו שהבית הזה עתיד ליחרב שלא ילמדו אחרים ויהיו עושין",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כן לפני עבודה זרה שלהן בדברים הללו מזכירין אותן לשבח שלא יצאת אשה משל",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אחד מהן מבושמת מעולם ולא עוד אלא כשהיה אחד מהן נושא אשה ממקום אחר היה",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "פוסק עמה על מנת שלא תתבשם שלא יהו אומרים ממעשה פיטום הקטורת הן",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "מתבשמות לקיים מה שנאמר והייתם נקיים מה׳ ומישראל אמר רבי יוסי פעם אחת",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "הייתי עומד בירושלם ומצאתי תינוק אחד משל בית אבטינס אמרתי לו בני מאיזו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "משפחה את אמר לי ממשפחת פלוני אמרתי לו בני אבותיך לפי שנתכוונו לרבות",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "כבודן ולמעט כבוד שמים לפיכך כבודם נתמעט וכבוד שמים נתרבה אמר רבי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "עקיבא שח לי שמעון בן לוגא מלקט הייתי עשבים אני ותינוק אחד משל בית",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "אבטינס וראיתי אותו שבכה וראיתי אותו ששחק אמרתי לו בני למה בכיתה אמר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לי על כבוד של בית אבא שנתמעט ולמה שחקתה אמר לי על הכבוד המתוקן",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לצדיקים לעתיד לבא ומה ראית מעלה עשן לנגדי נומיתי לו בני הראהו לי אמר",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "655px",
      "right": "275px",
      "text": "לי רבי מסורת בידי מאבותי שלא להראותו לברייה אמר רבי יוחנן בן נורי",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "text": "(מלקט הייתי עשבים אני וזקן אחד) פגע בי זקן אחד משל בית אבטינס ומגילת סמנים בידו אמר לי רבי לשעבר היו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "text": "בית אבא צנועין והיו",
      "segment_ids": [
        9
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>והוה ידע.</b> איזה סלע מוציא מים צוננים ואיזהו מים חמים ועד היכן מגיע חמימותיה: <b>וותרן.</b> לעבור על כל פשעם: <b>יתוותרון</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>בני מעוי.</b> יוותרו קשרי בני מיעיו ויצאו בתחלואים. ל\"א יהיו לו בני מעים יתירים שהוא מורה לבריות לחטוא שסומכין",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שימחול להם המקום ואינו כן אלא כל דרכיו משפט: <b>אלא.</b> שמאריך אפו וגובה חובו אע\"ג שאינו גובה אותו מיד: <b>וסביביו.</b>",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "צדיקים הנדבקים בו: <b>נשערה מאוד.</b> לשון חוט השערה: <b>ונורא על כל סביביו.</b> מטיל אימת משפטיו עליהם יותר מן הרחוקים:",
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>והוון כל עמא.</b> והיה כל העם",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נכנסין אצל החסיד לנחמו ולא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "רצה לקבל תנחומין: <b>אמר.</b> להן",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "זהו חסידכם בתמיה הרי בועט",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במידת הדין: <b>והוא מקפחו במים.</b>",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתמיה וקיפוח הוא לשון תיתוך",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וקיצור: <b>מיד נפלה.</b> קול בעיר:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>בסוכה איתערית.</b> בענף אחד אחזה",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עצמה ועלתה: <b>קרא גברא.</b> הא",
      "gemara_segment_ids": [
        1,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דתנן בפ\"ק דיומא בכל יום",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תורמין את המזבח בקריאת הגבר",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מהו קריאת הגבר שהכריז הכרזה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו שקרא גביני כרוז:",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>אמרון ליה.</b> ד בית ר' שילא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיתרגם קרא התרנגול שהוא נקרא",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גבר: <b>אית לך מימר בר תרנגולא.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתמיה אלא שם אדם ששמו גבר",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ה\"נ קריאת הגבר אאדם קאי: <b>ה\"ג</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שהיה מזווג את הפתילות.</b> וכ\"ה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ביומא וה\"פ שגדלן וקלען: <b>בעי</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> רצה למנות עליהן פרנסים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ולא רצו לקבל על עצמן להיות",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "פרנסים על הציבור שאין זה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כבודן: <b>זכה להימנות עם גדולי</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הדור.</b> עם הממונין החשובין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שבישראל: <b>כהאי דתנינן תמן.</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תמיד פ' בתרא: <b>נזקרין לו בבת</b>",
      "gemara_segment_ids": [
        5,
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ראש.</b> נרתעין מהכרעת קול:",
      "gemara_segment_ids": [
        6
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וברדייתו.</b> ולרדותה מן התנור:",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היו מסיקין מבפנים.</b> בתוך",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "התנור ורודה מבחוץ לדפוס שהיה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתנור שכך שנינו במנחות ג'",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דפוסין היו שם נותנו לדפוס",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ועדיין היא בצק כמין דפוס היה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לה בתנור וכו' והיה הלחם דבוק",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מבחוץ לדפוס והיה נאפה יפה",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שחום התנור שולט בו: ואלו",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אנשי אלכסנדרי' לא היו בקיאין",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לרדותה מן התנור אם הוא דבוק",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חוץ לדפוס והיו דובקין אותן",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בתוך הדפוס ולא היה נאפה כל",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "צרכו מפני שעובי הדפוס מפסיק",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בין הבצק לתנור ונתעפש:",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>למענהו.</b> לכבודו שלא יהא לחם",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שולחנו מנוול בעיפוש: <b>י\"ב מנה</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היו נוטלים.</b> כל יום מתרומת",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הלשכה: <b>שלא יהיו אומרים ממעשה</b>",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>וכו'.</b> וכתיב והייתם נקיים מה'",
      "gemara_segment_ids": [
        7
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומישראל: <b>היתה מתמרת ועולה.</b>",
      "gemara_segment_ids": [
        7,
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היה העשן עולה זקוף כתמר",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ומתפשט בשמי קורה ואח\"כ יורד:",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>היתה.</b> מתפשטת מיד למטה בתחילת",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עליית העשן: <b>ממקום אחר.</b> שלא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ידעה מנהגם: <b>היה פוסח עמה שלא</b>",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>תתבשם.</b> דהמדיר את אשתו שלא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תתקשט בא' מכל המינין יוציא",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ויתן כתובה לכך התנו עמה קודם",
      "gemara_segment_ids": [
        8
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הנישואין: <b>לרבות כבודם.</b> שלא",
      "gemara_segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ימצאו בקיאין זולתם: <b>נתמעט</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>כבודם.</b> בחרבן הבית: <b>וכבוד</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שמים נתרבה.</b> שאמרו העשרת",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "השבטים הא אלקינו הא קשוט",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאפי' לביתיה לא נסיב אפי'",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וגם האומות אמרו כן: <b>על הכבוד</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>המתוקן לצדיקים.</b> בבנין",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דלעתיד: <b>הרי מעלה עשן לנגדי.</b>",
      "gemara_segment_ids": [
        9
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ונזכרתי ע\"י כן חורבן הבית",
