      "printed_y": [
        350.4,
        767.2
      ],
      "printed_body_y": [
        119.4,
        785.4
      ],
      "note_he": "תוספת שלנו. פני משה אינו נדפס בדף זה כלל — במלבן הזה הדפיסו תקלין חדתין, שאינו מצוי במהדורה דיגיטלית. הטקסט מספריא (פיוטרקוב תרנ״ח–תר״ס), ואינו חלק מצורת הדף הנדפסת.",
      "note_en": "OUR ADDITION. Penei Moshe is not printed on this leaf at all — this rectangle is where the press set Tiklin Chadtin, which is in no digital edition. The text is Sefaria's (Piotrków, 1898-1900) and is not part of the printed page.",
      "printed_work_he": "תקלין חדתין",
      "printed_work_en": "Tiklin Chadtin",
      "source_ref": "Penei Moshe on Jerusalem Talmud Shekalim",
      "lines": [
        {
          "width": "216px",
          "text": "גמ' <b>אלו שני כריים וכו'</b>"
        },
        {
          "width": "216px",
          "text": "<b>שמא לא פטר חבירו.</b> בתמיה"
        },
        {
          "width": "216px",
          "text": "אלו שני כרי תבואה לפניו"
        },
        {
          "width": "216px",
          "text": "ותרם מאחד מהן על חבירו"
        },
        {
          "width": "216px",
          "text": "וכי לא פטר את חבירו"
        },
        {
          "width": "216px",
          "text": "מתרומה והכא נמי מאי"
        },
        {
          "width": "216px",
          "text": "איכפת להן לבית ר\"ג לעשות"
        },
        {
          "width": "216px",
          "text": "כן הלא התרומה שתורם פוטר"
        },
        {
          "width": "216px",
          "text": "את הכל וכולן יצאו באותן"
        },
        {
          "width": "216px",
          "text": "קרבנות הציבור שיקנו"
        },
        {
          "width": "216px",
          "text": "מהתרומה ומשני מפני שהנחת"
        },
        {
          "width": "216px",
          "text": "רוח הוא להם שלא יהיו"
        },
        {
          "width": "216px",
          "text": "קרבן הצבור מתקרב אלא"
        },
        {
          "width": "216px",
          "text": "משלהן תחלה ולפיכך היו"
        },
        {
          "width": "216px",
          "text": "עושין כך: גמ' <b>תני.</b>"
        },
        {
          "width": "216px",
          "text": "בתוספתא פ\"ב: <b>שמט את</b>"
        },
        {
          "width": "216px",
          "text": "<b>הקטבליות.</b> אם שמט מהן:"
        },
        {
          "width": "216px",
          "text": "<b>נתערבו השיריים.</b> כלומר"
        },
        {
          "width": "216px",
          "text": "שנעשו כולן כשירי הלשכה:"
        },
        {
          "width": "216px",
          "text": "<b>תני.</b> שם שלישית היא היתה"
        },
        {
          "width": "216px",
          "text": "עשירה שבכולן שהיו בה"
        },
        {
          "width": "216px",
          "text": "אצטלי של זהב וכו'."
        },
        {
          "width": "216px",
          "text": "שמביאין ממדינות הרחוקות"
        },
        {
          "width": "216px",
          "text": "ופורסין עליה אצטליות של"
        },
        {
          "width": "216px",
          "text": "זהב ונותנין עליהן"
        },
        {
          "width": "216px",
          "text": "דרכונות של זהב: <b>תני.</b> שם:"
        },
        {
          "width": "216px",
          "text": "<b>תרם את הראשונה וכו'.</b>"
        },
        {
          "width": "216px",
          "text": "כדפרישית: <b>תני.</b> שם בראש"
        },
        {
          "width": "216px",
          "text": "הפרק: <b>מתחילין ומוציאין</b>"
        },
        {
          "width": "216px",
          "text": "<b>מן הראשונה וכו'.</b> כמו"
        },
        {
          "width": "216px",
          "text": "שהבאתי לעיל בהל' ב' והכי"
        },
        {
          "width": "216px",
          "text": "מפרש לה הש\"ס נטל מן"
        },
        {
          "width": "216px",
          "text": "הראשונה היא הקופה הגדולה"
        },
        {
          "width": "216px",
          "text": "הראשונה שמתחיל בה בתחלה"
        },
        {
          "width": "216px",
          "text": "לתרום בקופה הראשונה של"
        },
        {
          "width": "216px",
          "text": "ג' קופות הקטנות אע\"פ שיש"
        },
        {
          "width": "216px",
          "text": "עדיין באותה קופה הגדולה"
        },
        {
          "width": "216px",
          "text": "הראשונה נוטל ותורם בקופה"
        },
        {
          "width": "216px",
          "text": "השניה של הקטנות מן השניה"
        },
        {
          "width": "216px",
          "text": "של הגדולות נטל מן השניה"
        },
        {
          "width": "216px",
          "text": "וכו' נוטל מן הקופה"
        },
        {
          "width": "216px",
          "text": "הגדולה השלישית וזה הכל"
        },
        {
          "width": "216px",
          "text": "כמו שפירשנו לעיל בהלכה"
        },
        {
          "width": "216px",
          "text": "ב': <b>שלמה שלישית וכו'.</b> על"
        },
        {
          "width": "216px",
          "text": "כרחך דטעות דמוכח היא וכי"
        },
        {
          "width": "216px",
          "text": "היאך משכחת לה דשלמה"
        },
        {
          "width": "216px",
          "text": "השלישית ואכתי יש בשניה"
        },
        {
          "width": "216px",
          "text": "ובראשונה והלא אינו תורם"
        },
        {
          "width": "216px",
          "text": "משום קופה בזה אחר זה אלא"
        },
        {
          "width": "216px",
          "text": "הכל כסדר הראשון שהתחיל"
        },
        {
          "width": "216px",
          "text": "בתרומה הראשונה מהא'"
        },
        {
          "width": "216px",
          "text": "ואח\"כ מהב' ואח\"כ מהג'"
        },
        {
          "width": "216px",
          "text": "וא\"כ מהיכא תיתי לה"
        },
        {
          "width": "216px",
          "text": "דנשלמה השלישית בתחלה אלא"
        },
        {
          "width": "216px",
          "text": "כך צריך לגרוס כפי הגי'"
        },
        {
          "width": "216px",
          "text": "בתוספתא שהבאתי לעיל גבי"
        },
        {
          "width": "216px",
          "text": "אותן ג' קופות הקטנות"
        },
        {
          "width": "216px",
          "text": "שמסתפקין מהן כסדר שלמה"
        },
        {
          "width": "216px",
          "text": "הראשונה מוציאין מן"
        },
        {
          "width": "216px",
          "text": "השנייה וכו' וכך צריך"
        },
        {
          "width": "216px",
          "text": "להיות כאן שלמה הראשונה"
        },
        {
          "width": "216px",
          "text": "חוזר לשנייה שלמה שניה"
        },
        {
          "width": "216px",
          "text": "חוזר לשלישית שלמו שלשתן"
        },
        {
          "width": "216px",
          "text": "וכו' והכי פירושא שבהגיע"
        },
        {
          "width": "216px",
          "text": "פרס השני והיא העצרת"
        },
        {
          "width": "216px",
          "text": "ואמרנו אע\"פ שיש בראשונה"
        },
        {
          "width": "216px",
          "text": "וכו' אע\"פ שיש בשניה וכו'"
        },
        {
          "width": "216px",
          "text": "כדלעיל וזה הכל בתרומה"
        },
        {
          "width": "216px",
          "text": "הראשונה שלפרס הפסח והשתא"
        },
        {
          "width": "216px",
          "text": "מסיים כיצד היו תורמין"
        },
        {
          "width": "216px",
          "text": "בפרס השניה והיא קודם"
        },
        {
          "width": "216px",
          "text": "העצרת ואמרנו לעיל שלא"
        },
        {
          "width": "216px",
          "text": "היה מחפה את השלישית"
        },
        {
          "width": "216px",
          "text": "בתרומה הראשונה כדי שידע"
        },
        {
          "width": "216px",
          "text": "להתחיל ממנה בתרומה"
        },
        {
          "width": "216px",
          "text": "השנייה ואחר כך חוזר"
        },
        {
          "width": "216px",
          "text": "ותורם כסדר כמו בהראשונה"
        },
        {
          "width": "216px",
          "text": "שלאחר שתרם בקופה הראשונה"
        },
        {
          "width": "216px",
          "text": "מהקטנות מן קופה השלישית"
        },
        {
          "width": "216px",
          "text": "שבגדולות ולפי שבה היה"
        },
        {
          "width": "216px",
          "text": "מסיים בראשונה ואין"
        },
        {
          "width": "216px",
          "text": "מעבירין על המצות ומתחיל"
        },
        {
          "width": "216px",
          "text": "עכשיו ממנה בתחלה ותורם"
        },
        {
          "width": "216px",
          "text": "ומחפה אותה חוזר ותורם"
        },
        {
          "width": "216px",
          "text": "כסדר בהקופה השניה של"
        },
        {
          "width": "216px",
          "text": "הקטנות מהקופה הגדולה"
        },
        {
          "width": "216px",
          "text": "הראשונה ומחפה אותה וחוזר"
        },
        {
          "width": "216px",
          "text": "ותורם אח\"כ בקופה הג' של"
        },
        {
          "width": "216px",
          "text": "הקטנות מן הקופה הגדולה"
        },
        {
          "width": "216px",
          "text": "השנייה ואינו מחפה אותה"
        },
        {
          "width": "216px",
          "text": "לפי שעכשיו מסיים בה"
        },
        {
          "width": "216px",
          "text": "וממנה מתחיל בפרק הג'"
        },
        {
          "width": "216px",
          "text": "והיא פרס החג ותורם מאותה"
        },
        {
          "width": "216px",
          "text": "הקופה הגדולה השנייה"
        },
        {
          "width": "216px",
          "text": "בקופה הראשונה מהקטנות"
        },
        {
          "width": "216px",
          "text": "ואח\"כ חוזר ותורם בקופה"
        },
        {
          "width": "216px",
          "text": "שניה מהקטנות מן הקופה"
        },
        {
          "width": "216px",
          "text": "הגדולה הראשונה ונמצא"
        },
        {
          "width": "216px",
          "text": "שעכשיו שלמה הראשונה"
        },
        {
          "width": "216px",
          "text": "וחוזר הוא להשניה והיא"
        },
        {
          "width": "216px",
          "text": "ג\"כ שלמה עכשיו וחוזר"
        },
        {
          "width": "216px",
          "text": "לשלישית ושלמו שלשתן"
        },
        {
          "width": "216px",
          "text": "וחוזר ושוקל כלומר שלאחר"
        },
        {
          "width": "216px",
          "text": "ששלמו כולן בחזרת חלילה"
        },
        {
          "width": "216px",
          "text": "בשנה זו וכסדר שאמרנו"
        },
        {
          "width": "216px",
          "text": "חוזר ושוקל לתוכן מהתרומה"
        },
        {
          "width": "216px",
          "text": "חדשה בפרס הפסח וכן"
        },
        {
          "width": "216px",
          "text": "לעולם. זהו הביאור הכולל"
        },
        {
          "width": "216px",
          "text": "בענין הזה: <b>ר\"מ אומר.</b> אם"
        },
        {
          "width": "216px",
          "text": "שלמו שלשתן מהקופות עדיין"
        },
        {
          "width": "216px",
          "text": "יש שירי הלשכה כמו שאמרנו"
        },
        {
          "width": "216px",
          "text": "בריש הפרק שהיה ר\"מ אומר"
        },
        {
          "width": "216px",
          "text": "מטעם הזה שמועלין גם"
        },
        {
          "width": "216px",
          "text": "בשירים וכו' וכדמייתי להא"
        },
        {
          "width": "216px",
          "text": "דר\"מ לעיל בפ\"ב בהלכה ב':"
        },
        {
          "width": "216px",
          "text": "<b>וכן היה רפב\"י אומר וכו'.</b>"
        },
        {
          "width": "216px",
          "text": "הובא זה לעיל בפ\"ק דשבת"
        },
        {
          "width": "216px",
          "text": "בהלכה ג' והתם הוא דשייכא"
        },
        {
          "width": "216px",
          "text": "ואגב דלעיל דצריך אדם"
        },
        {
          "width": "216px",
          "text": "להיות נקי וכו' מייתי לה"
        },
        {
          "width": "216px",
          "text": "הכא: <small>הדרן עלך בשלשה</small>"
        },
        {
          "width": "216px",
          "text": "<small>פרקים</small> מתני' <b>התרומה מה</b>"
        },
        {
          "width": "216px",
          "text": "<b>היו עושין בה.</b> אותן"
        },
        {
          "width": "216px",
          "text": "השקלים הניתנין בהקופות"
        },
        {
          "width": "216px",
          "text": "שאמרנו בפרק דלעיל ונקראת"
        },
        {
          "width": "216px",
          "text": "תרומת הלשכה ומה היו"
        },
        {
          "width": "216px",
          "text": "עושין בה: <b>לוקחין בה</b>"
        },
        {
          "width": "216px",
          "text": "<b>תמידין וכו' וכל קרבנות</b>"
        },
        {
          "width": "216px",
          "text": "<b>צבור.</b> לאתויי קטרת ושכר"
        },
        {
          "width": "216px",
          "text": "עשיית הקטרת וכן המלח"
        },
        {
          "width": "216px",
          "text": "שמולחין בו כל הקרבנות"
        },
        {
          "width": "216px",
          "text": "וכן אם לא הביאו עצי"
        },
        {
          "width": "216px",
          "text": "המערכה כדתנן בפ\"ד"
        },
        {
          "width": "216px",
          "text": "דתעניות ולא נמצאו עצים"
        },
        {
          "width": "216px",
          "text": "אלא בדמים היו באין"
        },
        {
          "width": "216px",
          "text": "מתרומת הלשכה: <b>שומרי</b>"
        },
        {
          "width": "216px",
          "text": "<b>ספיחין בשביעית.</b> מפני"
        },
        {
          "width": "216px",
          "text": "שהעומר ושתי הלחם אינן"
        },
        {
          "width": "216px",
          "text": "באין אלא מן החדש"
        },
        {
          "width": "216px",
          "text": "ובשביעית שהיא הפקר לכל"
        },
        {
          "width": "216px",
          "text": "שוכרין ב\"ד שומרים שישמרו"
        },
        {
          "width": "216px",
          "text": "מקצת מהספיחים שצמחו כדי"
        },
        {
          "width": "216px",
          "text": "שיבואו מהן העומר ושתי"
        },
        {
          "width": "216px",
          "text": "הלחם ואותן השומרין תקנו"
        },
        {
          "width": "216px",
          "text": "להם חכמים שיהיו נוטלין"
        },
        {
          "width": "216px",
          "text": "שכרן מתרומת הלשכה ומפני"
        },
        {
          "width": "216px",
          "text": "שיש בעלי זרוע שלוקחין"
        },
        {
          "width": "216px",
          "text": "אותן בחזקה ולפיכך אפי'"
        },
        {
          "width": "216px",
          "text": "יש כאן מי שהתנדב עצמו"
        },
        {
          "width": "216px",
          "text": "להיות שומרן בחנם אין"
        },
        {
          "width": "216px",
          "text": "שומעין לו אלא נוטלין"
        },
        {
          "width": "216px",
          "text": "השכר משל הקדש כדי שישמעו"
        },
        {
          "width": "216px",
          "text": "בעלי הזרוע ויפרשו מאותו"
        },
        {
          "width": "216px",
          "text": "המקום שאלו שומרים שם: <b>ר'</b>"
        },
        {
          "width": "216px",
          "text": "<b>יוסי.</b> לא חייש להכי שיהיו"
        },
        {
          "width": "216px",
          "text": "בעלי זרועות לוקחין בחזקה"
        },
        {
          "width": "216px",
          "text": "וס\"ל דלא תקינו להו שכר"
        },
        {
          "width": "216px",
          "text": "בשביל כך אלא אף הרוצה"
        },
        {
          "width": "216px",
          "text": "מתנדב להיות שומר חנם:"
        },
        {
          "width": "216px",
          "text": "<b>אמרו לו אף אתה אומר</b>"
        },
        {
          "width": "216px",
          "text": "<b>וכו'.</b> כלומר לדבריך שאתה"
        },
        {
          "width": "216px",
          "text": "אומר יכולין להיות שומר"
        },
        {
          "width": "216px",
          "text": "חנם א\"כ לדברינו דס\"ל"
        },
        {
          "width": "216px",
          "text": "דתקינו להן חכמים שכר זה"
        },
        {
          "width": "216px",
          "text": "השומר חנם מוחל הוא על"
        },
        {
          "width": "216px",
          "text": "השכר ונמצא שיש לו בתרומת"
        },
        {
          "width": "216px",
          "text": "הלשכה כדי השכר ואין"
        },
        {
          "width": "216px",
          "text": "להציבור חלק בהן ואם"
        },
        {
          "width": "216px",
          "text": "קונין מזה תמידין ומוספין"
        },
        {
          "width": "216px",
          "text": "ושאר קרבנות הצבור הרי"
        },
        {
          "width": "216px",
          "text": "אינם באים משל צבור ואי"
        },
        {
          "width": "216px",
          "text": "אתה מודה שאין אלו באים"
        },
        {
          "width": "216px",
          "text": "אלא משל צבור והלכה"
        },
        {
          "width": "216px",
          "text": "כחכמים:"
        }
      ],
