  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "מדינות הרחוקות <b>גמ׳</b> של בית רבן גמליאל",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "וכו׳ אילו היו שני כריים ותרם מאחד מהן",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "על חבירו שמא לא פטר חבירו הנחת רוח היא",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "להם שלא יהא קרבן מתקרב אלא משלהן תחלה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תני שמט את הקטבליאות נעשו כולן שיריים",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תני שלישית היא היתה עשירה שבכולן שהיו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בה אסטריאות של זהוב ודרכונות של זהוב",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תני תרם את הראשונה לשם ארץ ישראל ולשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל ישראל שניה לשם כרכים המוקפים ולשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "כל ישראל והשלישית לשם בבל ומדי ולשם",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מדינות הרחוקות ולשם כל ישראל תני נטל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן הראשונה אף על פי שיש בראשונה נוטל",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מן השניה נטל מן השניה אף על פי שיש",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשניה נוטל מן השלישית שלמה שלישית חוזר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשניה שלמה שניה חוזר לראשונה שלמו",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שלשתן חוזר ושוקל רבי מאיר אומר חוזר",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לשיריים שהיה רבי מאיר אומר מועלים",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בשיריים שמא יצטרכו להן בסוף וכן היה",
      "segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי פנחס בן יאיר אומר זריזות מביאה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לידי נקיות נקיות מביאה לידי טהרה טהרה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מביאה לידי קדושה קדושה מביאה לידי ענוה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ענוה מביאה לידי יראת חטא יראת חטא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מביאה לידי חסידות חסידות מביאה לידי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רוח הקודש רוח הקודש מביאה לידי תחיית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המתים תחיית המתים מביאה לידי אליהו",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "זכור לטוב זריזות מביאה לידי נקיות",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכתיב וכלה מכפר נקיות מביאה לידי טהרה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכתיב וכפר עליה הכהן וטהרה טהרה מביאה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לידי קדושה דכתיב וטהרו וקדשו קדושה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מביאה לידי ענוה דכתיב כי כה אמר רם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ונשא שוכן עד וקדוש שמו מרום וקדוש",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אשכון ואת דכא ושפל רוח ענוה מביאה לידי",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "יראת חטא דכתיב עקב ענוה יראת ה׳ יראת",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "חטא מביאה לידי חסידות דכתיב וחסד ה׳",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "מעולם ועד עולם על יראיו חסידות מביאה",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לידי רוח הקדש דכתיב אז דברת בחזון",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לחסידיך רוח הקדש מביאה לידי תחיית",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "המתים דכתיב ונתתי רוחי בכם וחייתם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "תחיית המתים מביאה לידי אליהו זכור לטוב",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "דכתיב הנה אנכי שולח לכם את אליה הנביא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לפני בא יום ה׳ הגדול והנורא תנא בשם",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "רבי מאיר כל מי שקבוע בארץ ישראל ומדבר",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "בלשון הקודש ואוכל פירותיו בטהרה וקורא",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "קריאת שמע בבוקר ובערב יהא מבושר שבן",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "עולם הבא הוא הדרן עלך פרק בשלשה פרקים",
      "segment_ids": [
        4
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<b>הלכה א <big>מתני׳</big></b> התרומה מה היו עושין בה?",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "לוקחין בה תמידין ומוספין ונסכיהם,",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "העומר ושתי לחם ולחם הפנים, וכל קרבנות",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הציבור. שומרי ספיחין בשביעית נוטלין",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "שכרן מתרומת הלשכה רבי יוסי אומר אף",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרוצה מתנדב שומר חנם אמרו לו אף אתה",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אומר שאין באין אלא",
      "segment_ids": [
        5
      ]
    }
  ],
  "rashi": [
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גמ' ופריך <b>אילו.</b> מי שהיו",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מונחים לפניו שני כריים של",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תבואה ותרם מאחד על חבירו מי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לא פטר גם השני א\"כ ה\"נ מאי",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נפקא להו לדבית ר\"ג אם הוא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תורם של חצי שקלן שלהן או לא:",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ומשני הנחת רוח הוא להן.</b> שיהא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקרבן קרב מממונם ראשונה ולא",
      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהא לשירי הלשכה: <b>שמט את</b>",
      "gemara_segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>הקטבליות.</b> מכולן נעשה הכל",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שיריים: <b>איצטלא.</b> בגדים וחמש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "חליפות שמלות מתרגמין וחמש",
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "איצטלון: <b>אע\"פ שיש בראשונה</b>",
      "gemara_segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>נוטל מן השניה.</b> אקופות",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הגדולות קאי שאינו נוטל מן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הראשונה כל הג' קופות קטנות",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בפרוס הפסח אלא מכל אחת מהן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "נטל קופה אחת וכדפירשתי",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במתניתין: <b>שלמה שלישית.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שהוציאו כל המעות שבקופה",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלישית לצורך הקרבנות: <b>שלמו</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>שלשתן.</b> שאין בקופות גדולות",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעות צריכין כל ישראל לשקול",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מחדש שקלים אחרים שהמעות",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנשאר בלשכה ולא נכנס לתוך",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קופות הגדולות הוא שיריים",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ואינן כשרין שוב ליקח מהן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קרבנות: <b>מועלין בשיריים.</b>",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שנשארו בלשכה שמא יצטרכו להן",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בסוף כשיכלה כל המעות שבתוך",
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הקופות: <b>וכן היה ר\"פ וכו'.</b>",
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אהא דקאמר ר\"מ דמועלין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בשיריים שמא יצטרכו להן בסוף",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מייתי הא דר\"פ שצריך האדם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "להיות זהיר וזריז שלא יבא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לידי חטא: <b>זריזות.</b> הזריז",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "במצות לעשותן כהוגן ומרחיק",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מעצמו כל דבר שיכול לבא ע\"י",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "לעבירה מביא את האדם שהוא נקי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "בעשיותיו ומעבירות שבידו:",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>טהרה.</b> שאף עונותיו הראשונים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יתלבנו ויוטהר נשמתו: <b>קדושה.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קדושת הלב והמחשבה: <b>לידי</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>ענוה.</b> שכל מי שיש בו רוח",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קדושה חפץ להיות יותר קדוש גם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "כי יפלס מעגלי צדק של שאר בני",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "אדם ושאין דרכיו מבוררים כל",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הצורך וזה הוא עיקר ענוה",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שמכיר פחיתת ערכו: <b>לידי יראת</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "<b>חטא.</b> שאל יאמר אני אלך בשוק",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "של זונות ולא אחטא וכמו שאמר",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלמה המלך ע\"ה שכיון שהוא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "עניו ויאמר שהוא שפל אנשים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "יהיה ירא חטא: <b>לידי חסידות.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "והיינו שיעשה דברים שהם לפנים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "משורת הדין כדי שלא יבא לידי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שום חטא: <b>לידי רוח הקודש.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שכיון שהוא עושה לפנים משורת",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "הדין עושין עמו מן השמים",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דברים שהן חוץ מהטבע ומודיעין",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "לו רזי התורה: <b>לידי תחיית המתים.</b> שע\"י שישרה רוח קדושה על עצמות יחיו וכמפורש",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ביחזקאל: <b>לידי אליהו.</b> שקודם התחייה האחרונה יבא אליהו: <b>וכלה מכפר את הקדש.</b> ולשון",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "וכילה משמע זריזות מלשון כלוי ומשמע זהירות דהיינו זריזות וכתיב קרא אחרינא וכפר",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בעדו ובעד העם הוא הכפרה הכוללת לכולם אלמא ע\"י זריזות בא הנקיה הגמורה: <b>וכפר</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עליה הכהן וטהרה.</b> מן השבועה שנשבעה כשכרעה לילד ואף ששוגגת היא צריכה טהרה: <b>וטהרו</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>וקידשו.</b> לבתר טהרה אתיא קדושה: <b>כי כה אמר רם ונשא.</b> מדכתיב מרום וקדוש אשכון",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דהיינו שעם היותו מרום ישכון עם הקדוש והדר קאמר שישכון את דכא ושפל רוח שהוא",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "העניו משמע דמקדושה יבוא האיש להיות עניו ולהכי קאמר שיהיה ה' עם הקדוש ויהיה עם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "דכא ושפל רוח: <b>ה\"ג דכתיב עקב ענוה.</b> בעבור ובשכר ענוה יבא לידי יראת ה': <b>אז דברת.</b>",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אין הקב\"ה מדבר בחזון אלא לחסידיו: <b>רה\"ק מביא לידי תחיית המתים.</b> דכתיב ונתתי רוחי",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "והוא רה\"ק וחייתם אח\"כ: ה\"ג לידי אליהו זכור לטוב דכתיב הנה אנכי שולח לכם את",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אליה הנביא לפני בא יום ה' הגדול והנורא והשיב לב אבות על בנים ולב בנים על",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אבותם: <b>כל מי שהוא קבוע וכו'.</b> פי' שהוא דר בקביעות בא\"י שהיאמכפרת עון כדכתיב העם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "היושב בה נשוא עון: <b>ואוכל פירותיו בטהרה.</b> שגורם טהרת הגוף: <b>ומדבר בלה\"ק.</b> שגורם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "טהרת הנפש: <b>וקורא ק\"ש בבוקר ובערב.</b> שמקיים והגית בו יומם ולילה שהתורה עיקר טהרת",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "נשמה: <b>מובטח לו שהוא בן עה\"ב.</b> אפילו גופו יזדכך ויזכה לחיים נצחים והם חיי עולם",
      "gemara_segment_ids": [
        4
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הבא אי נמי בלא דין ויסורין יזכה לעולם הבא: <small>סליק פרק שלישי</small> מתני' <b>התרומה מה היו</b>",
      "gemara_segment_ids": [
        4,
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "<b>עושין בה.</b> מה שנתנו לתוך הקופות מה היו עושין בהן: <b>וכל קרבנות הציבור.</b> לאתויי",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "קטרת: <b>ספיחי'.</b> תבואה העולה מאליה ממה שנשר בקציר ונותנים שכר לשומרים שימנעו רגלי",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "בהמה משם ויודיעו לבני אדם שהם לצורך העומר ושתי הלחם שאינן באין אלא מן החדש ומן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "הארץ ונותנין שכרן מן התרומה דצורך קרבן כקרבן דמי: <b>שומר חנם.</b> ואף אם קנה אותן מן",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ההפקר כששמרן חנם סבר ר\"י דקרבן יחיד משתנה לקרבן ציבור: <b>אף אתה אומר וכו'.</b> כלומר",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "אי אתה מודה שאינן באין אלא משל ציבור ואם שמרן חנם וזכה בהם נמצא שאינן באין משל",
      "gemara_segment_ids": [
        5
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "left": "0px",
      "text": "ציבור ולשיטתם השיבו דסברי קרבן יחיד אינו משתנה לשל ציבור:",
      "gemara_segment_ids": [
        5
      ]
    }
  ],
