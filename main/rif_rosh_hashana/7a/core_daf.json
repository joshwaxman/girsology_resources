      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "תקיעה לא יצאו וב\"ה כתב שאפי' אם יש",
      "segment_ids": [
