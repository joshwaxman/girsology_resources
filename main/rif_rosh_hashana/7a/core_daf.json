      ],
      "gemara_segment_ids": [
        2
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "סופה בלי תחלתה ואין באותו מקצת שיעור",
      "segment_ids": [
