  "gemara": [
    {
      "width": "380px",
      "right": "275px",
      "text": "כדתנן שטרי חוב המוקדמין פסולין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "והמאוחרי' כשרים: <span class=\"bavli-ref\" data-bavli-ref=\"(דף ט:)\" data-bavli-daf=\"9b\" data-bavli-index=\"0\"></span><i data-commentator=\"Sefer Mitzvot Gadol\" data-label=\"⚬\"></i><i data-commentator=\"Tur\" data-label=\"⚬\"></i><i data-commentator=\"Mishneh Torah, Second Tithes and Fourth Year's Fruit\" data-label=\"⚬\"></i>ולנטיעה מנ\"ל דכתיב",
      "segment_ids": [
        0,
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(ויקרא י״ט:כ״ג-כ״ד) שלש שנים יהיה לכם",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "ערלים לא יאכל וכתיב (ויקרא) ובשנה",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "הרביעית וגמרינן שנה שנה מתשרי דכתיב",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "(דברים י״א:י״ב) מראשית השנה ועד אחרית",
      "segment_ids": [
        1
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "<i data-commentator=\"Hagahot MeAlfas Yashan\" data-label=\"א\" data-order=\"1\"></i>השנ': ת\"ר <i data-commentator=\"Shiltei HaGiborim\" data-label=\"א\" data-order=\"1\"></i>א' הנוטע וא' המבריך וא'",
      "segment_ids": [
        1,
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "המרכיב ערב שביעית ל' יום לפני ר\"ה עלתה לו שנה ומותר לקיימן בשביעית",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "655px",
      "right": "0px",
      "text": "פחות מל' יום לפני ר\"ה לא עלתה לו שנה ואסור לקיימן בשביעית",
      "segment_ids": [
        2
      ]
    }
  ],
  "rashi": [
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>לפיכך</b> נ\"ל דברים כפשטן דהכא למאי הלכתא קאמרינן ולא בעי טעמא אלא כי היכי דאמרי' גבי ר\"ה לרגלים דנפקא מינה לנודר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למיקם עליה בבל תאחר דנפקותא הוא דאמרינן וטעמא לא שיילינן ה\"נ אמרינן הכא בהאי ר\"ה למלכים למאי הלכתא ולמאי נפקא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לן מינה ומהדרינן דנפקא מינה לשטרות דתנן שטרי חוב המוקדמין פסולין הלכך מלך שעמד באדר וכתב לו סופר בניסן שלאחר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "י\"ב חדש ניסן של שנה שניה כיון דניסן ר\"ה למלכים הוה ליה האי שטר מוקדם ופסול משום דהוה ליה האי ניסן של שנה שלישית",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "האי הוא דנפקא מינה בהאי ר\"ה",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למלכים ובהכי עסקינן בגמ' וכי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "תימא מפ\"מ קבעו להם ניסן ולא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מנו מיום שעמד בו היינו מאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דאמר ר' יוחנן בגמ' מניין",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "למלכים שאין מונין להם אלא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מניסן ומהדרינן דמקיש מלכות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "שלמה ליציאת מצרים כלומר",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "דכיון דיציאת מצרים היתה תחלת",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "מלכותן של ישראל שאם לא כן",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "היינו משועבדים בדין הוא שכל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מלך ממלכי ישראל יעשה במלכותו זכר ליציאת מצרים וכי תימא תינח למלכי ישראל למלכי אומות העולם מפני מה קבעו להם",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חכמים ר\"ה תשרי ולא מנו מיום שעמד בו איכא למימר לפי שאפשר שיעמוד איזה מלך ממלכי אומות העולם בניסן וכשיראו שימנו",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לו מניסן יחשב שר\"ה שלהם ניסן כמלכי ישראל ולפיכך קבעו ר\"ה שלהם תשרי שהוא ר\"ה לשמיטין וליובלות כך נראה לי ויש לי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עוד בגמרא הוכחה לזה הפירוש והרב אלפסי ז\"ל לא חשש להזכיר בהלכות הא דאמרינן בגמרא כאן למלכי ישראל כאן למלכי אומות",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "העולם משום דאנן השתא לא מנינן למלכים אלא לבריאת עולם ומתשרי מנינן ולמניינא דידן נמי אי אקדים ספרא מניינא דשטרא",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הוה ליה מוקדם ופסול: <b>שטרי חוב המוקדמין.</b> למלוה: <b>פסולין.</b> לפי שנמצא טורף לקוחות שלקחו שדות מן הלוה בין זמן השטר",
      "segment_ids": [
        0,
        1,
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לזמן ההלואה שלא כדין שהרי קדמה המכירה להלואה ולפיכך קנסוהו לאבד גם מזמן ההלואה ואילך ולא גבי ממשעבדי ומיהו מבני",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "חרי מגבא גבי והכי מוכח בפרק איזהו נשך (דף עב.) וא\"ת והיכי גבי אפילו מבני חרי והרי העדים פסולין הן כיון שהקדימו",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הזמן איכא למימר כגון דהוי השטר מוקדם במידי דעבידי אינשי למטעי ביה וכגון שכתבו שטר ללוה אע\"פ שאין מלוה עמו בשטרי",
      "segment_ids": [
        2
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דלאו אקנייתא שאע\"פ שאין כותבין אלא בשטרי אקנייתא וכדרב אסי כל מאן דלא גמר לדרב אסי לאו רשע הוא: <b>וגרסי' בירושלמי</b>",
      "segment_ids": [
        2,
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>מי מודיע.</b> כלומר שהשטרות מוקדמין ר\"ש בר בא אמר בשם רבי יוחנן הן הן עדיו והא אמר ר\"ל עדים החתומים על השטר נעשה",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כמי שנחקרה עדותן בב\"ד תמן כשאומרים לא חתמנו ברם הכא יכלין למימר על זה חתמנו ועל זה לא חתמנו וכתב עליו הר\"ז הלוי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ז\"ל ומכאן אנו למדין שכל טעות שהעדים מצויין לטעות בו נאמנין הן בעצמן ואין בזה משום חוזר ומגיד וצריך בזה ב\"ד",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "הגדול ולהחמיץ הדין ובגמרא דילן מצינו כיוצא בדבר הזה בההוא תברא דהוה חתים עליה רב ירמיה וכדאיתא בגט פשוט [דף",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קסז:] עד כאן. נראה מדבריו שהעדים נאמנין בכך אפילו בשכתב ידן יוצא ממקום אחר אבל הרמב\"ן ז\"ל כתב בפרק איזהו נשך",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דהאי ירושלמי בשאין כתב ידן יוצא ממקום אחר קאי ומש\"ה נאמנין ואין כאן מקום להאריך בזה אבל ודאי כל טעותא דעבידי",
      "segment_ids": [
        3
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עדים למטעי ביה לית ביה משום חוזר ומגיד דהכי מוכחא ההיא דבפרק גט פשוט: <b>ולנטיעה מנ\"ל.</b> דר\"ה שלה תשרי: <b>וגמרי' שנה</b>",
      "segment_ids": [
        3,
        4,
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>שנה מתשרי דכתיב (דברים י״א:י״ב) מראשית השנה ועד אחרית שנה.</b> ובר\"ה משתעי כדדרשינן בגמ' מר\"ה נדון מה יהא בסופה:",
      "segment_ids": [
        5
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<b>ואחד המבריך.</b> כופף זמורה בארץ שקורין מורגין: <b>ואחד המרכיב.</b> אילן בחבירו: <b>שלשים יום לפני ר\"ה עלתה לו שנה.</b> למנין שני",
      "segment_ids": [
        6,
        7,
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ערלה לפי שבל' יום הנטיעה וההברכה וההרכבה נקלטות ואתיא כר\"מ דס\"ל דיום א' בשנה חשוב שנה כדאמרינן בסמוך ויום שלשים",
      "segment_ids": [
        8
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "עולה למנין שלשים יום של קליטה וליום אחד בשנה דחשוב שנה ומשום הכי עלתה לו שנה: <b>ומותר לקיימן בשביעית.</b> שהרי נקלטו",
      "segment_ids": [
        8,
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קודם שביעית וכי תימא אכתי היאך מותר לקיימן בשביעית דהא מ\"מ כבר נקלטו בשלשים יום של תוספת שביעית כבר פירש רבינו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "תם דקליטה ונטיעה בתוספת שביעית לא מיתסרא משום דאין תוספת שביעית אסורה אלא בחרישה כדאמרינן בגמרא [דף ט.] בחריש",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ובקציר תשבות אבל בנטיעה לא וטעמא מפרש בירושלמי משום דכל חורש ערב שביעית מועיל חרישתו אפי' בשביעית אבל נוטע כל",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שישריש לפני ר\"ה סגי דאי משום דהולך וגדל אף בשביעית כל האילנות נמי מגדל גדלי בשביעית וא\"כ לעולם יהא אסור ליטע",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אלא ודאי נטיעה בתוספת שביעית שריא והיינו נמי דמפלגינן בגמרא [דף יג:] גבי אורז ודוחן ופרגין ושומשמין בין השרישו",
      "segment_ids": [
        9
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לפני ראש השנה להשרישו לאחר ראש השנה לענין שביעית דאלמא השרשה בתוספת שביעית משרא שרינן: <b>ואסור לקיימן בשביעית.</b>",
      "segment_ids": [
        9,
        10
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דכיון דלא נגמרה קליטתן עד שנכנסה שביעית הוה ליה כנוטע בשביעית: <b>ופירות נטיעה זו אסורין וכו'.</b> אע\"פ שאמרנו עלתה לו",
      "segment_ids": [
        10,
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שנה אם חנטו בה פירות לאחר ר\"ה של שנה שלישית מיד אסורין הן עולמית משום ערלה שאע\"פ שתשרי ר\"ה לנטיעה ט\"ו בשבט ר\"ה",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "לאילן וזו כבר נעשית אילן לפיכך אין שנתה מתחדשת לצאת מידי ערלה עד ט\"ו בשבט אבל משם ולהלן אם חנטו בה פירות תורת",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "רבעי עליהן לאכול בירושלים ובט\"ו בשבט לשנה הבאה יצאו מידי רבעי פירות החונטין בה מכאן ואילך לכך הועילו לו השלשים",
      "segment_ids": [
        11
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלפני ר\"ה: <b>ואיכא</b> למידק אשמעתין דהכא משמע דנהגא ערלה בהברכה והרכבה ואילו בספרי תניא ונטעתם כל עץ מאכל פרט למבריך",
      "segment_ids": [
        11,
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומרכיב יש לומר דהברכה אהברכה לא קשיא דההיא דספרי בשלא נפסקה מן האב והיא יונקת ממנו והא דהכא בשנפסקה א\"נ לא",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "נפסקה אלא שאינה יונקת ממנו וכל כה\"ג נוהגת בה ערלה ומונין לה משעה שיונקת מעצמה ולא מן האב והכי מוכח בירושלמי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ואמרינן התם מאן מוכח ומהדרינן מאן דאכיל דלאו דיליה בהיל לאיסתכולי ביה כלומר שכשהיא יונקת מן האב היא הופכת עליה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלא יעמדו כנגד העלין של אב ומרכיב אמרכיב נמי ל\"ק דההיא במרכיב באילן הנטוע למאכל ומש\"ה לא נהגא ערלה בהרכבה דקי\"ל",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ילדה שסבכה בזקנה בטלה כדאיתא בפרק משוח מלחמה (דף מג:) ואפילו ילדה בילדה נמי לכי מטו שלש לילדה ראשונה שניה נמי",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שריא והכי מוכח התם והא דהכא בשנטעה לראשונה לסייג ולקורות לפי שאין בראשונה משום ערלה כלל ומש\"ה אין זו בטלה לגבה",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומשכחת לה נמי בשהרכיב בתוך אילן סרק ואע\"פ שאינו רשאי משום כלאים והכי איתא בירושלמי דתני נכרי שהרכיב אילן מאכל",
      "segment_ids": [
        12
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ע\"ג אילן סרק אע\"פ שאין ישראל רשאי לעשות כן יש בו משום ערלה מאימתי מונין לה משעת נטיעתה: <b>ואנן</b> לא נהיגינן השתא",
      "segment_ids": [
        12,
        13
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ערלה בהברכה ובהרכבה: <b>וכתב</b> הרמב\"ן ז\"ל דטעמא דמילתא מדאמרינן בפרק משוח מלחמה (שם) גבי הא דאמרינן התם ולא חללו פרט",
      "segment_ids": [
        13,
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "למבריך ומרכיב כלומר שאינו חוזר מעורכי המלחמה ואמרי' התם לאו מי אר\"א בן יעקב כרם כמשמעו ה\"נ נטע כמשמעו נטע אין",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "ומבריך ומרכיב לא הלכך נמי ונטעתם כמשמעו אבל לא מבריך ומרכיב ומשום הכי הוא שאינו חוזר עליה מעורכי המלחמה לרבי",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "אליעזר בן יעקב משום דלא נהגא בהו ערלה והכי ודאי מסתברא דאי הוה ס\"ל לרבי אליעזר בן יעקב דונטעתם לאו דוקא דאפילו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מבריך ומרכיב נמי אמאי לימא גבי עורכי המלחמה נטע דוקא אלא ודאי כדפרישנא וכיון דקי\"ל כל המיקל בארץ הלכה כמותו",
      "segment_ids": [
        14
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בחוצה לארץ לא נהגא ערלה בחו\"ל בהברכה והרכבה כלל זהו דעת הרמב\"ן ז\"ל: <b>ולענין</b> רבעי אינו נוהג בחוצה לארץ אלא בכרם",
      "segment_ids": [
        14,
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "<i data-commentator=\"Hagahot HaBach\" data-label=\"ב\" data-order=\"2\"></i>אבל בשאר אילנות לא דהא איכא (ברכות דף לה.) דתני נטע ואיכא דתני כרם וקי\"ל דכל המיקל בארץ הלכה כמותו בחו\"ל וכ\"כ",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "התוספות וכן דעת הר\"ז הלוי ז\"ל וכתב הגאון ר\"א משבחא ז\"ל דלמאן דתני כרם רבעי ומייתי ליה בגזירה שוה דתבואת הכרם",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "כדאיתא התם אין רבעי נוהג אלא בכרם שלם אבל בגפן יחידית לא והרמב\"ן ז\"ל הקשה עליו דהא גבי כלאים נמי לא בעינן כרם",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "שלם דכל שזרע חטה ושעורה וחרצן חייב אלא ודאי לא בא הכתוב אלא להוציא שאר אילנות אבל במין דכרם אפילו גפן יחידית",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בכלל דהא מאן דמייתי כרם רבעי מהלולים ודאי אפילו בגפן יחידית נוהג רבעי דהא לא כתיב ביה כרם וא\"כ ה\"ה נמי למאן",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "דנפקא ליה מג\"ש דתבואת הכרם דהא לא אשכחן דפליגי במידי ותרוייהו כרם רבעי תנו אבל הרמב\"ם ז\"ל כתב בפ\"י מהלכות",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "מאכלות אסורות שאין רבעי נוהגת בחו\"ל כלל ואפילו בכרם אלא אוכל פירות שנה רביעית בלא פדיון כלל ולמד הרב ז\"ל דבר זה",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "קל וחומר מסוריא שאף על פי שמעשר ושביעית נוהגין בה מדבריהם אין רבעי נוהג בה וכל שכן בחוצה לארץ וסוגית הירושלמי",
      "segment_ids": [
        15
      ]
    },
    {
      "width": "930px",
      "right": "0px",
      "left": "0px",
      "text": "בפרק ה' ממעשר שני מוכחת כדבריו:",
      "segment_ids": [
        15
      ]
    }
  ],
