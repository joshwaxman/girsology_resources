      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "ברכה <i data-commentator=\"Hagahot HaBach\" data-label=\"ה\" data-order=\"5\"></i>תפלה של יד וממשמש",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
