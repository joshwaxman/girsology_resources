    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "וכך נמצא בשאילתות דרב אחאי",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "גאון ז\"ל <i data-commentator=\"Chiddushei Anshei Shem\" data-label=\"א\" data-order=\"1\"></i>ובהלכות רב שמעון",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "245px",
      "right": "0px",
      "left": "",
      "text": "קיירא ז\"ל אלו דברי הר\"ז הלוי",
      "segment_ids": [
