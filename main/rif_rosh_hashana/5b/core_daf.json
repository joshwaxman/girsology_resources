    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "היו נוהגים הגליות לעשות יוה\"כ יום א'",
      "segment_ids": [
        0
      ],
      "gemara_segment_ids": [
        0
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
