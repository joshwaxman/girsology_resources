      "gemara_segment_ids": [
        1
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ולא נתקלקל הסדר והרמב\"ן כתב דבכולהו",
      "segment_ids": [
