    {
     "type": "challenge_answer",
     "object": "ans_ami_tannaei_hi",
     "gloss_en": "אמר לך רבי אמי: תנאי היא, דתניא: אין גוזרין יותר משלש עשרה תעניות... לפי שאין מטריחין את הצבור יותר מדאי, דברי רבי (the stam answering on R' Ami's behalf)",
     "answers": "chal_teyuvta_r_ami",
     "restores": "p_ami_ein_matrichin"
    },
    {
     "type": "proposition",
     "object": "p_ami_tannaei_hi",
     "gloss_en": "R' Ami would say to you: it is a tannaitic dispute"
    }
