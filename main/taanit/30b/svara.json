     "status": "live"
    },
    {
     "type": "proposition",
     "object": "p_chachamim_simchata",
     "gloss_en": "the Sages: whoever does labour on the Ninth of Av and does not mourn for Jerusalem does not see her joy"
    }
   ]
  },
  "0": {
