   "sugya": "taanit_30a_yayin_migito_tisha_beav",
   "marks": [
    {
     "type": "proposition",
     "object": "p_ry_bein_tanur",
     "gloss_en": "and he would sit between the oven and the stove and eat"
    }
   ]
  },
  "2": {
   "segId": "Taanit.30b.3",
   "sugya": "taanit_30a_yayin_migito_tisha_beav",
   "marks": [
    {
     "type": "proposition",
     "object": "p_rsbg_kilu_yk",
     "gloss_en": "RSBG: whoever eats and drinks on the Ninth of Av -- it is as though he eats and drinks on Yom Kippur"
    }
   ]
  },
