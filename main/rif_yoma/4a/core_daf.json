        1,
        2
      ],
      "gemara_segment_ids": [
        3,
        4
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ומדברי הרמב\"ם נראה שהולך אחר רוב דעות",
