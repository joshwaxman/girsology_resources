        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "שדרך החולה לומר כן מחמת פחד המיתה: <b>ג</b>",
