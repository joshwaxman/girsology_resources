      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ספרים שכתוב בהן מילתא דר' ינאי פשיטא",
      "segment_ids": [
        1
      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "ספק נפשות להקל מהו דתימא האי דקאמר",
      "segment_ids": [
