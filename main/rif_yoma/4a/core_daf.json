      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "במלאכה אין דבריו של אחד במקום שנים: <b>ב</b>",
      "segment_ids": [
