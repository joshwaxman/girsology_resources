      ],
      "gemara_segment_ids": [
        3
      ]
    },
    {
      "width": "246px",
      "right": "0px",
      "left": "0px",
      "text": "בספק [נפשות] דאין לך רופא שיאמר אם לא",
      "segment_ids": [
