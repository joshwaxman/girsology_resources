        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "נחמיה חתניה דבי נשיאה אנא חזיתינהו לר'",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "אמי ור' אסי דעברו' דרך מלבוש תינח מנעל",
      "segment_ids": [
        0
      ]
    },
    {
      "width": "380px",
      "right": "275px",
      "text": "סנדל מאי ואסיקנא סנדל לכתחלה לא תני רב",
