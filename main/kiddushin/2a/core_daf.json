    {
      "id": 2,
      "marker_letter": "ג",
      "line_number": 6,
      "content": {
        "html": "<p><big><b>ג</b></big> <cite id=\"fn_ג\" style=\"font-style:normal;\"><b><a href=\"#fn_ג_back\">ג</a></b> </cite> <a href=\"/wiki/%D7%A8%D7%9E%D7%91%22%D7%9D_%D7%94%D7%9C%D7%9B%D7%95%D7%AA_%D7%98%D7%95%D7%A2%D7%9F_%D7%95%D7%A0%D7%98%D7%A2%D7%9F_%D7%92\" title='רמב\"ם הלכות טוען ונטען ג'>מיי' פ\"ג מהל' טוען ונטען</a> <a href=\"/wiki/%D7%A8%D7%9E%D7%91%22%D7%9D_%D7%94%D7%9C%D7%9B%D7%95%D7%AA_%D7%98%D7%95%D7%A2%D7%9F_%D7%95%D7%A0%D7%98%D7%A2%D7%9F_%D7%92_%D7%90\" title='רמב\"ם הלכות טוען ונטען ג א'>הלכה א'</a>, <a href=\"/wiki/%D7%A1%D7%9E%22%D7%92_%D7%A2%D7%A9%D7%94_%D7%A6%D7%94\" title='סמ\"ג עשה צה'>סמ\"ג עשין צה</a>, <a href=\"/wiki/%D7%98%D7%95%D7%A8_%D7%90%D7%91%D7%9F_%D7%94%D7%A2%D7%96%D7%A8_%D7%9B%D7%96\" title=\"טור אבן העזר כז\">טור</a> ו<a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%90%D7%91%D7%9F_%D7%94%D7%A2%D7%96%D7%A8_%D7%9B%D7%96\" title=\"שולחן ערוך אבן העזר כז\">שו\"ע אה\"ע סי' כ\"ז</a><a href=\"/wiki/%D7%A9%D7%95%D7%9C%D7%97%D7%9F_%D7%A2%D7%A8%D7%95%D7%9A_%D7%90%D7%91%D7%9F_%D7%94%D7%A2%D7%96%D7%A8_%D7%9B%D7%96_%D7%99\" title=\"שולחן ערוך אבן העזר כז י\"> סעיף י'</a>:\n</p>",
